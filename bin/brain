#!/usr/bin/env bash
#
# brain — open (or focus) a project's brainer space.
#
#   brain <lane> | <alias>   a lane of projects.json, by name or by one of
#                            its brain_aliases
#   brain <name> --opencode  same brainer, opencode instead of claude
#   brain <name> --reset     replace the agent, keeping the space, tab and pane
#   brain <name> --reset --self   the brainer resetting ITSELF (see below)
#   brain                    list what exists
#
# A BRAINER RESETTING ITSELF is a different problem from resetting another one,
# and the difference is time, not permission. The process asking for the reset is
# the process the reset kills, so it can neither perform it nor report on it: by
# definition it is WORKING — that is what running the command means — and the
# refusal below is the correct answer to every OTHER caller. `--self` is the one
# path out, and it is DEFERRED AND DETACHED rather than immediate: brain measures
# everything it can measure while it is still alive (who you are, which executors
# would lose their reader), hands the reset to a process in its own session, and
# that process waits for this turn to end before replacing anything. Nothing
# about the refusal is loosened; the reset simply happens a moment later, from
# outside.
#
# A brainer space is long-lived: one per project, focused rather than rebuilt.
# Task spaces are the disposable ones — those are `hw`.
#
# EXIT CODES. 0 opened, focused or reset. 64 a usage error. 3 means "you are in
# front of the brainer, and it is in the WRONG LANE" — its cwd is not the
# brain root's <project> directory, so it loads another lane's CLAUDE.md and another
# lane's deny-guard entries, and `hw` refuses to dispatch from it. `--reset`
# repairs exactly that, and returns 3 itself when it could not. Everything else
# is 1, and every refusal says whether anything was sent. `--self` exits 0 when
# the reset has been ARMED, not performed — the detached arm writes what it did
# to a log this command names, because the conversation that asked will not be
# there to read it.
#
# The two agents read the SAME brainer: CLAUDE.md, decisions.md and the command
# bodies are one copy each. opencode reaches them through opencode.json
# (`instructions`) and .opencode/command/*.md symlinks, so nothing is duplicated
# and the two cannot drift apart.
#
# THE SHIM (go-060 S5): this file keeps the name (the interface, setup/release-standard.md «Versioning») and execs
# `hw-core brain` with the same argv, stdin and environment; the behaviour is core/brain*.go. hw-core is HW_CORE (a seam of the
# suite, never rebuilt), else beside this file, else core/dist/<os>-<arch>/. A hw-core not built dies naming setup/build-core
# --native; one older than core/'s sources is rebuilt (bin/core-rebuild) with a Go toolchain on PATH, else the old one runs
# with one line. HW_IMPL, HW_IMPL_BRAIN and the switch file name a bash twin that 0.6.0 removed: bin/impl-retired.sh says so
# once and Go runs.
set -euo pipefail
case "${OSTYPE:-}" in msys*|cygwin*) HW_MSYS_COMPAT="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/msys-compat.sh"; [ ! -f "$HW_MSYS_COMPAT" ] || . "$HW_MSYS_COMPAT" ;; esac

# Resolve through the ~/bin symlink, the same way the invokers do: ${BASH_SOURCE}
# is the LINK, and the shared table lives beside the TARGET.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
BRAIN_BIN="$(cd -P "$(dirname "$_src")" && pwd)"
# The brain root is the directory above the one this script lives in —
# ~/bin/brain is a link, resolved above — or HW_BRAIN_ROOT when set.
# THE SPELLING IS KEPT, not canonicalised: the old root was the literal
# home-relative path, so a root reached through a symlinked parent (or a
# $HOME with a `//` in it) must print exactly as it was reached. $_src is the
# script after every link was followed; only a relative one needs a `cd`.
case "$_src" in
  /*) _brain_root="${_src%/*/*}" ;;
  *)  _brain_root="$(cd "$(dirname "$_src")/.." && pwd)" ;;
esac
BRAIN="${HW_BRAIN_ROOT:-$_brain_root}"
[ ! -r "$BRAIN_BIN/impl-retired.sh" ] || { . "$BRAIN_BIN/impl-retired.sh"; impl_retired_warn brain; }
_brain_core=""
if [ -n "${HW_CORE:-}" ]; then
  [ ! -x "$HW_CORE" ] || _brain_core="$HW_CORE"
else
  _brain_os="$(uname -s | tr 'A-Z' 'a-z')"; _brain_arch="$(uname -m)"
  case "$_brain_os" in mingw*|msys*|cygwin*) _brain_os=windows ;; esac
  case "$_brain_arch" in x86_64) _brain_arch=amd64 ;; aarch64) _brain_arch=arm64 ;; esac
  for _c in "$BRAIN_BIN/hw-core" "$BRAIN_BIN/../core/dist/$_brain_os-$_brain_arch/hw-core"; do
    [ ! -x "$_c" ] || { _brain_core="$_c"; break; }
  done
  if [ -n "$_brain_core" ] && [ -d "$BRAIN_BIN/../core" ] \
     && [ -n "$(find "$BRAIN_BIN/../core" -path '*/dist' -prune -o \( -name '*.go' -o -name '*.txt' -o -name go.mod \) -newer "$_brain_core" -print -quit 2>/dev/null)" ]; then
    _brain_msg="$("$BRAIN_BIN/core-rebuild" "$BRAIN_BIN" "$_brain_core" brain 2>&1)" || :; [ -z "$_brain_msg" ] || echo "brain: $_brain_msg" >&2   # stale: rebuilt (bin/core-rebuild), or the old one runs with one line
  fi
fi
[ -n "$_brain_core" ] || { echo "brain: hw-core is not built: run setup/build-core --native (it needs Go 1.22 or newer, https://go.dev/dl)" >&2; exit 1; }
export HW_BRAIN_ROOT="$BRAIN" HW_CORE_BIN_DIR="$BRAIN_BIN" HW_CORE_ROOT="$_brain_root"
exec "$_brain_core" brain "$@"
