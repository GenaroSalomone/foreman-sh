#!/usr/bin/env bash
#
# browser-close — close an agent-browser session and PROVE it, or say what is
# still open and why.
#
#   browser-close                       # close every session, verify
#   browser-close --session <name>      # close one, verify
#   browser-close --profile <path>      # a profile path to verify is released
#
# With no --profile it checks $HW_BROWSER_PROFILE, which hw sets per task. Do
# NOT pass a bare profile NAME: a name resolves to
# ~/.agent-browser/profiles/<name>, which every task in the project shares.
#
# WHY THIS EXISTS.
#
# `agent-browser close` prints "✓ Browser closed" and that sentence is not
# evidence. Measured 2026-08-25 on a namespace with NO sessions at all:
#
#     $ agent-browser session list   → No active sessions
#     $ agent-browser close          → ✓ Browser closed
#     $ agent-browser session list   → Active sessions: → default
#
# The close SPAWNED the registration it claims to have removed. `close --all`
# does the same: it prints "Closed session: default" and the session is still
# listed the instant afterwards. The registration is a short-lived daemon, gone
# in under a second — so it is a RACE, not a leak, and it is invisible to
# anything that checks immediately.
#
# That race cost a real run. The browser QA subagent of a product-lane task
# closed, listed, saw a session, concluded the close had failed, and relaunched —
# three times (qa-grid-regression-22395, -24999, -run2-30473). Each relaunch was
# a HEADED Chrome against the shared user-data-dir, which restores the previous
# windows, so the third launch inherited two launches worth of them. The pile of
# empty windows was not a Chrome bug; it was a retry loop feeding on a false
# negative.
#
# So this script never reports from the close's own output. It settles, then
# reads the two signals that actually carry the fact: the session registry, and
# the Chrome processes holding the profile's user-data-dir.
set -euo pipefail

# ── the Go implementation: hw-core (core/wrappers_browser_close.go)
# 0.7.0 removed the bash body: this file keeps the name (the interface, setup/release-standard.md «Versioning») and execs
# `hw-core browser-close` with the same argv, stdin and environment. A HW_IMPL_BROWSER_CLOSE or `browser-close=bash` word is retired: bin/impl-retired.sh says so
# once and Go runs. hw-core is HW_CORE (a seam of the suite, never rebuilt), else beside this file, else core/dist/<os>-<arch>/
# (setup/build-core builds it); one not built or older than core/'s sources is rebuilt by bin/core-rebuild when a toolchain is on PATH.
set -euo pipefail
_t_src="${BASH_SOURCE[0]}"
while [ -L "$_t_src" ]; do
  _t_dir="$(cd -P "$(dirname "$_t_src")" && pwd)" || break
  _t_src="$(readlink "$_t_src")" || break
  case "$_t_src" in /*) ;; *) _t_src="$_t_dir/$_t_src" ;; esac
done
_t_bin="$(cd -P "$(dirname "$_t_src")" 2>/dev/null && pwd)"
[ ! -r "$_t_bin/impl-retired.sh" ] || { . "$_t_bin/impl-retired.sh"; impl_retired_warn browser-close; }
_t_core=""
if [ -n "${HW_CORE:-}" ]; then
  [ ! -x "$HW_CORE" ] || _t_core="$HW_CORE"
else
  _t_os="$(uname -s | tr 'A-Z' 'a-z')"; _t_arch="$(uname -m)"
  case "$_t_arch" in x86_64) _t_arch=amd64 ;; aarch64|arm64) _t_arch=arm64 ;; esac
  for _t_c in "$_t_bin/hw-core" "$_t_bin/../core/dist/$_t_os-$_t_arch/hw-core"; do
    if [ -x "$_t_c" ]; then _t_core="$_t_c"; break; fi
  done
  if [ -n "$_t_core" ] && [ -d "$_t_bin/../core" ] \
     && [ -n "$(find "$_t_bin/../core" -path '*/dist' -prune -o \( -name '*.go' -o -name '*.txt' -o -name go.mod \) -newer "$_t_core" -print -quit 2>/dev/null)" ]; then
    _t_msg="$("$_t_bin/core-rebuild" "$_t_bin" "$_t_core" browser-close 2>&1)" || :   # stale: rebuilt (bin/core-rebuild), or the old one runs with one line
    [ -z "$_t_msg" ] || printf 'browser-close: %s\n' "$_t_msg" >&2
  fi
fi
if [ -n "$_t_core" ]; then
  HW_WRAPPER_ARGV0="$0" HW_CORE_BIN_DIR="$_t_bin" exec "$_t_core" browser-close "$@"
fi
printf 'browser-close: hw-core is not built: run setup/build-core --native (it needs Go 1.22 or newer, https://go.dev/dl)\n' >&2
exit 1
