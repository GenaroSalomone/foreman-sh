# "<worktree root>:<lane>" per line, for each product-repo lane in table order —
# the roots `hw status` walks for worktrees outside $WORK.
_status_worktree_roots() {
  local p out=""
  for p in $HW_LANES; do
    _lane_is_product_repo "$p" || continue
    out="${out:+$out
}$(lane_path "$p" worktree_root):$p"
  done
  printf '%s' "$out"
}
# ── hw outbox ───────────────────────────────────────────────────────────────
#
# done-invoker writes each report to `<run state dir>/outbox/<envelope-id>.msg`
# BEFORE sending and removes it once the receiver admitted it (see
# invoker-common.sh, "the outbox"). What stays is a report the brainer never got:
# its pane was closed, or hw could not reach herdr. This is the reader and the
# redeliverer.
#
#   hw outbox [<project>]                    list what is waiting
#   hw outbox flush [<project>] --to <pane>  redeliver it to that brainer pane
#
# `brain <lane>` runs the flush itself on open. `hw status` only LISTS: a flush
# is a message into a pane, and status is a read-only command.
#
# STATE `uncertain` IS NEVER FLUSHED. channel-send exit 5 means the message MAY
# already be in the brainer's session; redelivering it is exactly the duplicate
# report the exit exists to prevent. A person reads the pane and deletes the
# entry. DEDUPLICATION IS BY ENVELOPE ID: one file per id (a retry overwrites),
# removed on admission, so a flushed id has nothing left to flush twice.
_outbox_roots() {  # $1=project (optional) — one directory per line
  local proj="${1:-}" line root lane
  if [ -n "$proj" ]; then
    [ ! -d "$WORK/$proj" ] || printf '%s\n' "$WORK/$proj"
  else
    printf '%s\n' "$WORK"
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    root="${line%:*}"; lane="${line##*:}"
    [ -z "$proj" ] || [ "$lane" = "$proj" ] || continue
    [ ! -d "$root" ] || printf '%s\n' "$root"
  done <<< "$(_status_worktree_roots)"
}
_outbox_metas() {  # $1=project (optional) — oldest first
  local r deep
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    # A run's `.hw` sits at <root>/<task>/.hw or <root>/<lane>/<task>/.hw, so no directory three
    # levels down that is not a `.hw` (or inside one) can lead to an outbox: prune it, or the walk
    # reads every task's whole source tree (about 17 of `hw status`'s 22 s on this machine).
    deep="$r/*/*/*"  # MUTATION-ANCHOR: 827-M01
    find "$r" -maxdepth 8 \( -name node_modules -o -name .git \) -prune -o \
      \( -type d -path "$deep" ! -name .hw ! -path '*/.hw/*' -prune \) -o \
      -type f -name '*.meta' -path '*/.hw/*/outbox/*' -print 2>/dev/null
  done <<< "$(_outbox_roots "${1:-}")" | sort -u | while IFS= read -r m; do
    # GNU stat first: its `-f` is filesystem status, which prints a block AND fails
    # on `%m`, so the BSD spelling tried first left that block in the sort key.
    printf '%s %s\n' "$(stat -c %Y "$m" 2>/dev/null || stat -f %m "$m" 2>/dev/null || echo 0)" "$m"
  done | sort -n | cut -d' ' -f2-
}
_outbox_field() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1; }
_outbox_count() {  # $1=project — "<pending> <uncertain>"
  local m st p=0 u=0
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    [ -f "${m%.meta}.msg" ] || continue
    st="$(_outbox_field "$m" state)"
    if [ "$st" = uncertain ]; then u=$((u + 1)); else p=$((p + 1)); fi
  done <<< "$(_outbox_metas "${1:-}")"
  printf '%s %s' "$p" "$u"
}
_outbox_quiet() {  # $1=project — one warned block when something is waiting
  local c p u
  c="$(_outbox_count "${1:-}")"; p="${c% *}"; u="${c#* }"
  [ "$p" -gt 0 ] 2>/dev/null || [ "$u" -gt 0 ] 2>/dev/null || return 0
  printf '\n'
  if [ "$p" -gt 0 ]; then
    warn "$p report(s) never reached a brainer and are waiting in an outbox — hw outbox${1:+ $1}   (\`brain <lane>\` redelivers them on open)"
  fi
  if [ "$u" -gt 0 ]; then
    warn "$u report(s) are UNCERTAIN (they may already be in a brainer's session) and are held back — hw outbox${1:+ $1}"
  fi
}
cmd_outbox() {
  local verb=list proj="" to="" m st key msg task p pid fails=0 n=0
  case "${1:-}" in list|flush) verb="$1"; shift ;; esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) _need_val "$@"; to="$2"; shift 2 ;;
      -*) die "unknown option: $1 (usage: hw outbox [list|flush] [<project>] [--to <brainer-pane>])" ;;
      *) proj="$(_canon_project "$1")"
         lane_known "$proj" || die "unknown project: $1 (expected: $(lane_names_hint))"
         shift ;;
    esac
  done
  if [ "$verb" = flush ] && [ -z "$to" ]; then
    die "hw outbox flush needs --to <brainer-pane>: a report is redelivered to a pane you name, never to a guessed one (brain <lane> passes its own)"
  fi
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    key="${m%.meta}"; [ -f "$key.msg" ] || continue
    st="$(_outbox_field "$m" state)"; p="$(_outbox_field "$m" project)"; task="$(_outbox_field "$m" task)"
    if [ "$st" = uncertain ]; then
      printf '  %s:%s  %s  uncertain — NOT redelivered: it may already be in the brainer'"'"'s session (channel-send exit 5); read that pane, then remove %s\n' \
        "$p" "$task" "$(_outbox_field "$m" status)" "$key.msg"
      continue
    fi
    # A LIVE done-invoker OWNS ITS ENTRY: it wrote the file before sending and is
    # still waiting on the brainer's idle gate. Flushing now would send the same
    # envelope twice (judges A and B). Its pid is in the meta.
    pid="$(_outbox_field "$m" pid)"
    if [ "$verb" = flush ] && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      printf '  %s:%s  still being sent by done-invoker (pid %s) — left alone\n' "$p" "$task" "$pid"
      continue
    fi
    if [ "$verb" = list ]; then
      printf '  %s:%s  %s  pending  envelope %s  (%s)\n' "$p" "$task" "$(_outbox_field "$m" status)" "$(_outbox_field "$m" envelope)" "$key.msg"
      n=$((n + 1)); continue
    fi
    msg="[redelivered from the outbox: the pane this report was first sent to was gone or unreachable]
$(cat "$key.msg")"
    local rc=0
    # outbox-report: a REDELIVERED REPORT, which is what --report is for (test 35 exempts this one line).
    "$HW_BIN_DIR/channel-send" --report herdr "$to" - "$msg" >/dev/null 2>&1 || rc=$?
    case "$rc" in
      0) rm -f "$key.msg" "$m"
         # THE REPORT REACHED THE BRAINER: say so where `hw done` and a re-run of
         # done-invoker look, or `hw done` keeps calling it STRANDED and a re-run
         # sends it a second time (judges A and B).
         : > "$(dirname "$(dirname "$key")")/done" 2>/dev/null || true
         rm -f "$(dirname "$(dirname "$key")")/reopened" 2>/dev/null || true   # as done-invoker does; a revived run counts done only without it
         n=$((n + 1)); printf '  redelivered %s:%s to %s\n' "$p" "$task" "$to" ;;
      5) printf 'envelope=%s\nproject=%s\ntask=%s\nrun=%s\nstatus=%s\nstate=uncertain\nat=%s\n' \
           "$(_outbox_field "$m" envelope)" "$p" "$task" "$(_outbox_field "$m" run)" "$(_outbox_field "$m" status)" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$m"
         warn "redelivering $p:$task to $to is UNCERTAIN (channel-send exit 5): it may already be there; held, not retried"; fails=$((fails + 1)) ;;
      *) warn "could not redeliver $p:$task to $to (channel-send exit $rc); it stays in the outbox"; fails=$((fails + 1)) ;;
    esac
  done <<< "$(_outbox_metas "$proj")"
  if [ "$verb" = list ]; then
    [ "$n" -gt 0 ] || info "no pending reports in any outbox${proj:+ for $proj}"
    return 0
  fi
  [ "$fails" = 0 ] || return 1
  return 0
}

# ONE LINE: the heavy-run slots in use and who waits (bin/suite-gate).
_gate_quiet() {
  declare -F sg_status_line >/dev/null 2>&1 || return 0
  SG_WORK="${WORK:-}"
  info "$(sg_status_line)"
}


# ── main ────────────────────────────────────────────────────────────────────
# AN EXECUTOR DOES NOT HAVE THE BRAINER'S VERBS. `hw` exports HW_TASK and HW_RUN
# into every executor, so their presence here is the caller's role — read NOW,
# before this process exports its own HW_RUN for a dispatch. What an executor
# runs: done on its OWN task (done-invoker), executor-turn-end, receipt, status,
# handle, suite, human-boundary, review-range/-delta, output, help. What it does
# not: another task's done, next, ruling, unstick, reap/sweep --apply, preview,
# revive, a dispatch, and
# the operator's HW_DONE_ALLOW_BRAIN_LEAK exit. The brain guard
# (setup/guards/deny_brain_writes.py, brain-guard-programs.txt) holds the same
# line for the calls it sees; this holds it for the ones it does not. An
# `env -u HW_TASK -u HW_RUN` gets past THIS check by design (not a sandbox); the
# guard still refuses that spelling. The brainer path sets neither variable.
_HW_CALLER_EXECUTOR=0
{ [ -z "${HW_TASK:-}" ] && [ -z "${HW_RUN:-}" ]; } || _HW_CALLER_EXECUTOR=1
_executor_refuse() {
  die "hw $1 is a brainer verb: this shell is executor $HW_PROJECT/$HW_TASK (HW_TASK/HW_RUN are set), and an executor $2. Report with done-invoker, or ask-invoker \"…\" if your brainer must act; do not work around it."
}
if [ "$_HW_CALLER_EXECUTOR" = 1 ]; then
  HW_PROJECT="${HW_PROJECT:-?}"; HW_TASK="${HW_TASK:-?}"
  case "${1:-}" in
    "")       _executor_refuse "with no arguments (the picker)" "does not dispatch" ;;
    next)     _executor_refuse next "is re-tasked by its brainer, not by itself" ;;
    ruling)   _executor_refuse ruling "does not rule on another run" ;;
    unstick)  _executor_refuse unstick "does not restart another pane" ;;
    reap)     case " $* " in *" --apply "*) _executor_refuse "reap --apply" "does not remove worktrees" ;; esac ;;
    sweep)    case " $* " in *" --apply "*) _executor_refuse "sweep --apply" "does not close other runs" ;; esac ;;
    briefs)   case "${2:-}" in archive|restore|unarchive) _executor_refuse "briefs $2" "does not move the brain's briefs" ;; esac ;;
    preview)  _executor_refuse preview "does not keep or release another run's preview" ;;
    revive)   _executor_refuse revive "does not reopen another run's pane" ;;
    train)    _executor_refuse train "does not merge other tasks' branches or advance main" ;;
    done)
      if [ $# -ge 3 ]; then   # shorter: the verb's own usage error follows
        [ "$(_canon_project "$2" 2>/dev/null || printf '%s' "$2")" = "$(_canon_project "$HW_PROJECT" 2>/dev/null || printf '%s' "$HW_PROJECT")" ] \
          && [ "$3" = "$HW_TASK" ] \
          || _executor_refuse "done $2 $3" "closes only its own task ($HW_PROJECT $HW_TASK)"
      fi
      [ "${HW_DONE_ALLOW_BRAIN_LEAK:-0}" != 1 ] \
        || _executor_refuse "done (HW_DONE_ALLOW_BRAIN_LEAK=1)" "does not use the operator's leak-check exit"
      ;;
    -*|help|status|receipt|handle|preflight|suite|human-boundary|review-range|review-delta|output|executor-turn-end|chaining-lease-start|chaining-lease-expire|reports|stage|worktrees|wait|wait-one|wait-monitor|gentle-home) ;;
    *)        # anything else is `hw <project> <task> …`, a dispatch
              _executor_refuse "$1 …" "does not dispatch executors" ;;
  esac
fi
if [ $# -eq 0 ]; then
  # The picker needs a person: without a terminal it waited 120 s for an answer
  # nobody could give. No terminal is a usage error. The usage text is defined
  # further down this file, so it is asked of a second run rather than called.
  if [ -t 0 ] && [ -t 1 ]; then _interactive; exit 0; fi
  "$0" --help >&2; exit 2
fi
# The worktree audit rides along: silent when everything is in place, and one
# warned block when a harness has put a worktree somewhere this setup cannot see.
# `hw status` was 186 lines to report ONE live task, 25 of them historical
# "no information" rows that visually dominate everything actionable. Scoped by
# project, and the dead history collapses to a count unless --all asks for it.
if [ "$1" = status ]; then
  shift
  HW_STATUS_PROJECT=""; HW_STATUS_ALL=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) HW_STATUS_ALL=1; shift ;;
      -*) die "unknown option: $1 (usage: hw status [<project>] [--all])" ;;
      *) HW_STATUS_PROJECT="$(_canon_project "$1")"
           # Silently showing nothing for a typo is the worst answer: it reads
           # as "that lane is quiet", which is a fact about the lane rather than
           # about the argument.
         lane_known "$HW_STATUS_PROJECT" || die "unknown project: $1 (expected: $(lane_names_hint))"
         shift ;;
    esac
  done
  export HW_STATUS_PROJECT HW_STATUS_ALL
  _orph_tmp=""
  if [ -z "${HW_STATUS_ORPHANS_JSON:-}" ]; then
    _orph_tmp="$(mktemp "${TMPDIR:-/tmp}/hw-orphans.XXXXXX")" && export HW_STATUS_ORPHANS_JSON="$_orph_tmp"
  fi
  # THE SECTIONS BELOW READ NOTHING THE TABLE WRITES, so they start now and run
  # while it is built; each is printed where it always was, in this order
  # (lib/hw/status.sh, "what `hw status` runs side by side"). Only the orphans
  # line needs the table's own output, so it stays in line.
  # hw-core warns ONCE when HW_IMPL asks for it and it cannot answer; the worktrees job below is a
  # subshell whose `_core_warned` this shell never sees, so the warning is given here, first, and
  # the job inherits the mark.
  _core_mode="$(_core_impl_for status)"; [ "$_core_mode" = bash ] || _core_usable status || true
  _status_par_init
  trap '_status_par_done' EXIT   # a section that dies, a closed pipe: the held output is not left in $TMPDIR
  _status_par_start release _release_quiet
  _status_par_start gate _gate_quiet
  _status_par_start outbox _outbox_quiet "$HW_STATUS_PROJECT"
  _status_par_start worktrees _core_inline worktrees cmd_worktrees --quiet
  if [ -z "$HW_STATUS_PROJECT" ]; then
    _status_par_start tabs _tabs_quiet
    _status_par_start hygiene _hygiene_quiet
    _status_par_start rules _rules_quiet
    _status_par_start decisions _decisions_quiet
  fi
  _core_inline status cmd_status
  _orphans_quiet "${HW_STATUS_ORPHANS_JSON:-}"
  [ -z "$_orph_tmp" ] || rm -f "$_orph_tmp"
  _status_par_replay release
  _status_par_replay gate
  _status_par_replay outbox
  if [ -z "$HW_STATUS_PROJECT" ]; then
    _status_par_replay worktrees; _status_par_replay tabs; _status_par_replay hygiene; _status_par_replay rules; _status_par_replay decisions  # MUTATION-ANCHOR: 827-M02
  else
    _status_par_replay worktrees
    info "scoped to $HW_STATUS_PROJECT — \`hw status\` with no project adds the cross-lane checks"
  fi
  _status_par_done
  # A NEW VERB NOBODY FINDS IS A VERB NOBODY READS. `hw status` answers whether a
  # task reported; it deliberately does not carry what the report SAID, because
  # its tick is derived from done_status alone. Point at the thing that does,
  # from the command a brainer already runs at the start of every session.
  info "what those runs actually REPORTED, from disk: hw reports ${HW_STATUS_PROJECT:-<project>}"
  exit 0
fi
if [ "${1:-}" = executor-turn-end ]; then
  shift; set +e; cmd_executor_turn_end "$@"; _rc=$?; set -e; exit "$_rc"
fi
if [ "${1:-}" = outbox ]; then shift; set +e; cmd_outbox "$@"; _rc=$?; set -e; exit "$_rc"; fi
# `hw cockpit-state [--once|--loop N]`: the writer of the cockpit's state file. The program is
# bin/cockpit-state (read its header); this is its verb, so a brainer can run it by hand.
if [ "${1:-}" = cockpit-state ]; then shift; exec "$HW_BIN_DIR/cockpit-state" "$@"; fi
if [ "${1:-}" = ruling ]; then shift; cmd_ruling "$@"; exit 0; fi
if [ "${1:-}" = preflight ]; then shift; cmd_preflight "$@"; exit 0; fi
if [ "${1:-}" = human-boundary ]; then shift; cmd_human_boundary "$@"; exit 0; fi
if [ "${1:-}" = sweep ]; then shift; cmd_sweep "$@"; exit 0; fi
if [ "${1:-}" = review-range ]; then shift; cmd_review_range "$@" || exit 1; exit 0; fi
if [ "${1:-}" = review-delta ]; then shift; set +e; cmd_review_delta "$@"; _rc=$?; set -e; exit "$_rc"; fi
if [ "${1:-}" = handle ]; then shift; cmd_handle "$@" || exit 1; exit 0; fi
if [ "${1:-}" = train ]; then shift; set +e; cmd_train "$@"; _rc=$?; set -e; exit "$_rc"; fi
if [ "${1:-}" = gentle-home ]; then shift; cmd_gentle_home "$@" || exit 1; exit 0; fi
if [ "${1:-}" = next ]; then
  # `next` is dispatched before the global help scan below. Its help is the
  # `commands` topic, where its syntax lives; cmd_next's own parser is unchanged.
  if [ "${2:-}" = -h ] || [ "${2:-}" = --help ]; then exec "$0" help commands; fi
  shift; cmd_next "$@"; exit 0
fi
if [ "${1:-}" = suite ]; then shift; set +e; cmd_suite "$@"; _rc=$?; set -e; exit "$_rc"; fi
if [ "${1:-}" = unstick ]; then shift; cmd_unstick "$@"; exit 0; fi
if [ "${1:-}" = wait-one ]; then shift; cmd_wait_one "$@"; exit $?; fi
if [ "${1:-}" = wait-monitor ]; then shift; cmd_wait_monitor "$@"; exit $?; fi
if [ "${1:-}" = wait ]; then shift; cmd_wait "$@"; exit $?; fi
if [ "${1:-}" = output ]; then shift; cmd_output "$@"; exit 0; fi
if [ "${1:-}" = stage ]; then shift; cmd_stage "$@"; exit 0; fi
if [ "${1:-}" = worktrees ]; then shift; cmd_worktrees "$@"; exit 0; fi
if [ "${1:-}" = reap ]; then shift; cmd_reap "$@"; exit 0; fi
if [ "${1:-}" = ledger ]; then shift; cmd_ledger "$@"; exit 0; fi
if [ "${1:-}" = briefs ]; then shift; cmd_briefs "$@"; exit 0; fi
if [ "${1:-}" = reports ]; then
  shift
  HW_REPORTS_REPAIR=1
  HW_REPORTS_FULL=0
  _rp_proj=""; _rp_task=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-repair) HW_REPORTS_REPAIR=0; shift ;;
      --full) HW_REPORTS_FULL=1; shift ;;
      -*) die "unknown option: $1 (usage: hw reports [<project>] [<task>] [--full] [--no-repair])" ;;
      *) if [ -z "$_rp_proj" ]; then _rp_proj="$(_canon_project "$1")"; else _rp_task="$1"; fi; shift ;;
    esac
  done
  cmd_reports "$_rp_proj" "$_rp_task"; exit 0
fi
if [ "${1:-}" = receipt ]; then
  shift
  [ $# -ge 2 ] || die "usage: hw receipt <project> <task>"
  cmd_receipt "$(_canon_project "$1")" "$2"; exit 0
fi
if [ "${1:-}" = log ]; then
  shift
  [ $# -eq 2 ] || die "usage: hw log <project> <task>"
  cmd_log "$(_canon_project "$1")" "$2"; exit 0
fi
_usage_revive() {
  cat <<'USAGE'
hw revive <project> <task> [--run <id>] [--dry-run]

  Repeat a run's recorded cwd, env and session resume in a new tab; refuses
  anything not recorded (cwd gone, no session, no env).

  --run <id>   revive that run (a directory name under the task's .hw/, e.g.
               20261006-153531-98770) instead of the task's latest one. Refused
               for an unknown id (the runs that exist are named) and for a run
               whose session is still live in a pane (the pane is named).
  --dry-run    print what would be repeated; the output says which run was
               chosen and whether --run chose it or it was defaulted to the latest.
USAGE
}
if [ "${1:-}" = revive ]; then
  shift
  _rv_dry=0; _rv_run=""; _rv_usage="usage: hw revive <project> <task> [--run <id>] [--dry-run]  (hw revive --help)"
  case "${1:-}" in -h|--help|help) _usage_revive; exit 0 ;; esac
  [ $# -ge 2 ] || die "$_rv_usage"
  _rv_proj="$1"; _rv_task="$2"; shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) _rv_dry=1 ;;
      --run) [ $# -ge 2 ] && [ -n "$2" ] || die "--run needs a run id. $_rv_usage"; _rv_run="$2"; shift ;;
      --run=*) _rv_run="${1#--run=}"; [ -n "$_rv_run" ] || die "--run needs a run id. $_rv_usage" ;;
      *) die "$_rv_usage" ;;
    esac
    shift
  done
  cmd_revive "$(_canon_project "$_rv_proj")" "$_rv_task" "$_rv_dry" "$_rv_run"; exit 0
fi
# One usage text, reachable. `hw <lane> --help` used to answer "<task> must not
# start with a dash" and print nothing else — which is exactly what a brainer
# hit on 2026-08-24 while looking for a way to opt out of the framework flow.
# It found no flag list, gave up, and dispatched into the flow it did not want.
# A flag nobody can discover is a flag that does not exist.
_usage_launch() {
  cat <<'USAGE'
hw — launch one executor per task, in its own tab, with its own worktree.

LAUNCH
    hw <project> <task> --brief <path> [flags]

  The lanes differ, so the copy-pasteable form differs. These are complete
  commands, not templates with parts left out — one per lane in projects.json,
  with each default that differs from claude and a `task/<task>` branch:

USAGE
  local l v m b k='{task}'
  for l in $HW_LANES; do
    printf '    hw %s <task> --brief brain/%s/briefs/<task>.md --sdd none\n' "$l" "$l"
    v="$(project_default_kind "$l")"; m="$(project_default_model "$l")"
    if [ "$v" != claude ] || [ -n "$m" ]; then printf '        vendor: %s%s — no flag needed.\n' "$v" "${m:+ + $m}"; fi
    if [ -n "$(lane_checkout "$l")" ]; then
      b="$(lane_get "$l" branch)"
      [ "$b" = "task/$k" ] || printf '        branch: %s\n' "${b//$k/<task>}"
    fi
  done
  cat <<'USAGE'

  Add --dry-run to any of them first. It builds nothing and prints the whole
  dispatch, each field marked (chosen) or (default).

  READ-ONLY WORK — a browser audit, a review, anything that only looks:
    hw <project> <task> --brief <path> --sdd none --worktree none --no-db
        Full tab, no branch, no dependency install, no database. A judgment task
        does not need a checkout.

USAGE
}

_usage_placement() {
  cat <<'USAGE'
PLACEMENT AND ISOLATION ARE TWO SEPARATE THINGS
    --placement project-tab | legacy-space | here      WHERE the agent sits
    --base <branch>                                    the branch the worktree is
                                                       built on. Defaults per
                                                       lane (below) and is
                                                       printed in the manifest
                                                       either way. A brief may
                                                       declare it as `base:`.
USAGE
  local l bases=""
  for l in $HW_LANES; do
    [ -n "$(lane_checkout "$l")" ] && bases="${bases:+$bases, }$l $(lane_get "$l" base)"
  done
  printf 'lane bases: %s\n' "$bases" | fold -s -w 72 | sed 's/ *$//; s/^/        /'
  cat <<'USAGE'
    --worktree  new | none                             whether it is ISOLATED

                    --worktree new        --worktree none
    project-tab     the default task      a browser audit / review
    here            side-by-side+isolated --here (splits your pane)

    --tab/--space/--here still work: --here IS --placement here --worktree none.

USAGE
}

_usage_flags() {
  cat <<'USAGE'
FLAGS
    --brief <path>     the file the executor is given. Without it, it gets a tab
                       and nothing to do.
    --sdd <mode>       speckit | none. REQUIRED where a framework is in play.
                       `none` = deliberately outside the flow.
    --agent <vendor>   claude | opencode | codex. Defaults per lane; see above.
    --model <m>        claude: an alias (opus, sonnet, haiku, fable) or claude-*.
                       opencode: provider/model, e.g. openai/<model>.
                       codex: a bare id, e.g. <model> (no provider/ prefix).
                       A sonnet or haiku ORCHESTRATOR is refused before anything
                       is built whenever an SDD mode is in force: the phase
                       agents pin their own models, so --model sets only the
                       judgment above them. Use --model opus, or --sdd none.
    --model-why <s>    name the OPEN DECISION this task has to work out. The
                       manifest suggests sonnet by default and opus only where
                       one is declared, and prints the model beside the
                       suggestion so a deviation is visible before you press
                       enter. It never changes the model and never refuses:
                       the axis is UNCERTAINTY, not importance, and `kind:
                       audit` alone does not buy opus. The same declaration
                       lives in a brief as `decision: <what is undecided>`;
                       this flag wins over it.
    --requested-by <s> the request this dispatch answers, in the asker's words.
                       Same as `requested_by:` in a brief, and wins over it.
                       Required or warned per lane (projects.json).
    --effort <e>       low|medium|high|xhigh|max. claude and codex only —
                       opencode's interactive command has no such flag.
USAGE
  local l db="" dev=""
  for l in $HW_LANES; do
    [ -n "$(lane_get "$l" db_provisioned)" ] && db="${db:+$db, }$l"
    [ "$(lane_get "$l" devserver)" = opt-in ] && dev="$dev$(printf '\n                         %-19s %s' "$l" "$(lane_get "$l" devserver_line)")"
  done
  printf '    --no-db            do not provision a database. Lanes that provision one:\n'
  printf '                       %s.\n' "${db:-none}"
  printf '    --dev-server       also start the dev server of a lane where it is opt-in,\n'
  printf '                       and allocate its HW_PORT_* ports:%s\n' "${dev:- none}"
  cat <<'USAGE'
    --no-report         deliberately launch fire-and-forget: no report channel is
                        resolved or provided; status still records and classifies it.
    --report-to <pane>  deliberately route reports to a live non-executor pane
                        other than this lane's brainer; recorded as chosen.
    --keep-pane [time]  retain the pane under a bounded lease for `hw next`
    --why <reason>      (default 4h, maximum 24h). Name who/what will re-task it.
                        Each proved done-invoker report creates one next-task authority.
                        A successful `hw next` consumes that authority; the next proved
                        report re-arms a fresh task-bound lease. Expiry closes the pane.
    --sandbox          run the executor inside a Seatbelt profile that confines
                       its writes and cuts its control sockets; it reports
                       through an outbox. Same as `sandbox: true` in a brief.
                       macOS and Claude Code only; TCP stays open
                       (THREAT-MODEL.md).
    --dry-run          print the dispatch, create nothing.
    --allow-stale-hooks launch even though the worktree's versioned hook settings
                       (.claude/settings*.json, .codex/hooks.json, opencode.json)
                       invoke a binary not on PATH — recorded in the receipt
    --fresh            build a fresh executor even when a reusable one is live
                       (contaminated context, another vendor/model, deliberate
                       concurrent work — recorded in the manifest)
    --no-reuse-check   legacy exact alias for --fresh

BRIEF KEYS (front-matter; BRIEF-TEMPLATE.md has the whole block)
    sandbox: true      same as --sandbox; `false` never turns a --sandbox off.
    requires-agents: [primary:|subagent:]<name>[, …]
                       agents the task cannot do without. hw refuses the
                       dispatch when the executor cannot reach one from its
                       work directory, instead of warning.
    boundary: <what must never cross>
                       a build is not accepted as done without
                       $HW_ARTIFACTS/design-judgment.md naming it and ending
                       JUDGMENT: APPROVED (Judgment Day's design mode).
    decision: <what is undecided>   as --model-why.

USAGE
}

_usage_commands() {
  cat <<'USAGE'
OTHER COMMANDS
    hw                              interactive brief picker
    hw status                       what is running, and what never closed
    hw receipt <project> <task>     what was MEASURED, next to what was dispatched
    hw log <project> <task>         what was asked, ruled and reported, from disk
    hw outbox [<project>]           reports that never reached a brainer, waiting on disk
    hw outbox flush [<project>] --to <pane>
                                    redeliver them to that brainer pane (`brain <lane>`
                                    does it on open; an uncertain one is never resent)
    hw reports [<project>]           one line per task: which reports are on disk
    hw reports <project> <task>      the report text for one task
    hw reports <project> --full      the report text for every task in the lane
    hw cockpit-state [--once|--loop N]
                                    write the file the brainer's cockpit panel reads
                                    (`brain` keeps it fresh; the invokers refresh it on events)
    hw output tree <path>...        executor declaration of repository-tree output
    hw output none | outside <ref>  executor declaration of no-tree / external output
    hw stage                        brainer check: which executor declared each staged path
    hw train add <project> <task>   merge the task's branch into train-<project>; only a
                                    setup/test-budgets.json conflict is resolved, any other
                                    is named with the task that should resolve it
    hw train status <project>       the tasks the train carries over the base
    hw train push <project>         full suite (setup/verify-for-push) on the train, then
                                    advance the base keeping uncommitted edits in the
                                    checkout; prints the remote pushes, does not run them
    hw done <project> <task> [--drop-db] [--force]
        Refuses a pane it cannot establish is free: a task that never reported,
        a pane WORKING right now, or turns that ended in it after its report
        and hw did not dispatch. --force is the only exit. A pane that only has
        not finished the turn that SENT its report is waited for (up to
        HW_DONE_TURN_WAIT seconds, default 60), then closed. The `hw revive`
        command prints BEFORE the close, not after it. After the close it reaps
        its own task exactly as `hw reap --apply` would: merged, clean and
        unoccupied, its outputs archived and its database dumped first.
    hw done <project> <task> --keep-preview [<duration>] --why "<who still reads it>"
        Releases the AGENT and keeps the preview: tab, dev server, ports and
        database survive, under a lease that expires (default 4h, max 24h).
        For the gap between "implementation finished" and "the audit or the
        human has looked at it" — the gap that otherwise costs a whole idle
        executor per preview.

    hw preview                          what is being held, by whom, until when
    hw preview release <project> <task> end a lease early
                                    close the tab, free the DB and ports.
                                    Removes no worktree and deletes no branch.
    hw ruling <pane> "<correction>" [--dry-run]
        Queue a correction for an executor that is STILL WORKING. Every
        queued one (up to 5 undelivered) is delivered at that executor's next
        turn end, in the order sent -- nothing is stopped, no
        session is killed, and you do not wait. This is the third exit
        `channel-send --ruling` refuses into; `hw done` is NOT one, and using it
        for a correction costs the executor its whole session context.
        For a receiver already idle or done, channel-send --ruling delivers now.
        An executor that reported --blocked is KEPT waiting: a ruling to it
        RESUMES that same task in the same session (sent now) and it reports
        again with its own done-invoker.

    hw next <pane> [--force] [--dry-run] [--sdd <mode>] [--run <id>] "<task>" | --brief <path>
        --run <id>: the run `hw revive` brought back, when it is not the newest
        under the pane's .hw. A revived run that reported takes task N+1 with its
        own done-invoker (no --retask); a reported run NOT revived is refused,
        naming `hw revive`. Without --run nothing changes.
        Flags may appear before or after the task text. Without --sdd the
        effective live worktree surface is measured and incompatible vendor/mode
        pairs are refused before task creation or delivery. The launch record is
        only a fallback when that measurement yields no mode, not authoritative.
        --dry-run checks compatibility too, without changing the surface.
                                     hand the NEXT task to an executor already alive
    hw wait <pane> [pane ...] [--timeout-ms <ms>] [--dry-run]
                                    launch concurrent witness-backed waits in a separate
                                    unfocused monitor tab, then return immediately so the
                                    brainer remains reachable. One target finishing never
                                    drops the others. --dry-run witnesses each target once
                                    and creates no tab.

USAGE
}

_usage_recovery() {
  cat <<'USAGE'
RECOVERY AND CLEANUP
    hw revive <project> <task> [--run <id>] [--dry-run]
                                    repeat a closed run's recorded cwd, env and
                                    session resume in a new tab; refuses anything
                                    not recorded (cwd gone, no session, no env)
    hw unstick <pane>                deliberate OpenCode-only recovery for exact
                                     blocked_reason=stuck + blocked_scope=root|child;
                                     refuses live questions/permissions, then restarts
                                     OpenCode in the same pane and verifies idle/working
    hw reap [<project>] [--apply]   merge-clean worktrees, merged task branches AND loose work dirs, only where
                                    provably safe; task outputs (.artifacts, qa-report) are archived to
                                    $HW_ARCHIVE_ROOT/<lane>/<task>/ (default: archive/ beside the work dir) and
                                    verified before removal, a provisioned DB is pg_dump'ed there, then dropped.
                                    A brainer's SessionStart runs it in the background for its own lane.
                                    Closes a --blocked executor left unanswered past
                                    HW_BLOCKED_WAIT_HOURS (default 24).
    hw sweep [--apply]              close tabs of runs that REPORTED, only hw's own
    hw worktrees [<project>] [--migrate]
                                    worktrees outside their repo's canonical root

USAGE
}

_usage_exits() {
  cat <<'USAGE'
EXIT STATUS
    0   the thing was done. For `hw next` that means the task was DELIVERED and
        the counter advanced; for a launch, that the launch request completed.
        Vendor runtime readiness may remain unestablished; read the receipt.
    1   every refusal, without exception. hw has exactly one failure code, and
        every refusal it prints comes from one `die`. So a caller may branch on the
        status alone: a gate that would not open, a container with no agent
        left in it, an agent that did not start and an unreachable pane are all
        1, and none of them is ever reported as success.
    Two usage exits are not refusals: `hw` alone with no terminal to draw its
    picker on prints the usage and exits 2; `hw <one word>` prints it and exits 64.

    `hw wait` additionally reports VERDICTS, which are not refusals — the wait
    ran, and these say what it found about the TARGET. 1 still means hw refused
    (bad argument, unknown pane, missing cross-check library) and never that the
    executor is in some state. The numbers match state-witness.sh's own, so the
    toolchain has one number space:
    2   the budget was spent and the pane never reached idle/done. The ordinary
        timeout, and what an `unknown` cross-check costs: nothing extra.
    5   SETTLED — proved unable to change. A larger budget buys nothing.
    6   AWAITING-HUMAN — its own endpoint confirms an outstanding prompt.
    7   ENDED AND NEVER REPORTED — turn_state=ended_unreported together with
        done_state=undelivered. No wait is started: the report exists, it did
        not arrive, and the turn that would have retried it is over.
    8   HAND-BACK REFUSED — the executor ended a turn with no report, no
        delivered ask/challenge outstanding, and no named one-shot human boundary.
    3/4 herdr-rpc transport: could not connect / rpc error. Facts about herdr,
        not about the executor.


USAGE
}

_usage_projects() {
  cat <<'USAGE'
PROJECTS
USAGE
  local l a names="" none=""
  for l in $HW_LANES; do
    a="$(lane_get "$l" hint_aliases)"
    names="${names:+$names    }$l${a:+ | ${a//|/ | }}"
    [ -n "$(lane_checkout "$l")" ] || none="${none:+$none, }$l"
  done
  printf '%s\n' "$names" | fold -s -w 76 | sed 's/ *$//; s/^ *//; s/^/    /'
  if [ -n "$none" ]; then
    printf '    no repository, so no worktree, no branch, no ports, no DB: %s\n\n' "$none"
  else
    printf '\n'
  fi
}

_usage_environment() {
  cat <<'USAGE'
ENVIRONMENT
    HW_INVOKER_PANE   the brainer's pane, where every executor reports. hw
                      resolves it; export it only when hw cannot — a brainer
                      whose pane is unlabelled and sitting outside its project
                      directory matches none of the heuristics. An exported id
                      is honoured FIRST and still checked: one that is not live,
                      or that names an executor pane, is refused rather than
                      handed to an executor as an address that goes nowhere.
USAGE
}

_usage_lanes() {
  cat <<'USAGE'
LANES (projects.json)
    One entry per lane under `lanes`; the file is read once per process and a
    wrong key or shape loads nothing. Full table, defaults and examples:
    "Customizing a lane (`projects.json`)" in the README.

    identity    space (required), engram, hw_aliases, brain_aliases, hint_aliases
    agent       vendor, model, model_floor, model_pins, account, artifacts,
                requested_by, sdd_modes, suite_lock, opencode_config_dir, brain_guard
    repository  checkout, checkout_var, base, base_ref_prefix, branch,
                worktree_root, worktree, build, repoless, product_repo, agents_from
    resources   deps, db, devserver, ports
    cleanup     reap, sweep
    prompt      brief_note

    brief_note  text hw appends to the preamble of every executor prompt of the
                lane, `hw next` included: one rule for the lane, such as a pull
                request template, instead of a line in every brief.
        "brief_note": "Open every pull request with .github/pull_request_template.md."
USAGE
}

_usage_advanced() {
  cat <<'USAGE'
ADVANCED
    Mechanisms a brain can opt into. A new install needs none of them.

  PERMISSIONS
    --permissions <ask|skip>
                       skip (recommended, and the default): Claude Code gets
                       --dangerously-skip-permissions, OpenCode --auto, Codex keeps
                       its own approval_policy. ask: none of those flags, so every
                       permission prompt stays on; an unattended executor then waits
                       on it and a person must answer in its pane. Order: the flag,
                       HW_PERMISSIONS, the machine file ~/.config/hw/permissions
                       (one word; install.sh --permissions writes it), the default.
                       The manifest's `permissions` line says which and from where.
                       A running pane keeps what it launched with.

  ACCOUNTS
    --account <name>   default | personal. Which Claude Code account the executor
                       runs under (CLAUDE_CONFIG_DIR). A lane's own default is
                       listed below; anywhere else `personal` is reached
                       only by typing it, and the manifest marks it chosen.
                       Claude Code only:
                       opencode and codex do not read it, and the manifest says
                       NOT APPLIED rather than claiming a redirect. A non-default
                       account is refused unless `claude-personal --check` proves
                       its skills and plugins match the default account.
    --below-floor-why <s>  the reason this dispatch runs below the lane's
                       model_floor (projects.json). Refused
                       without it; recorded in the manifest and the receipt.
USAGE
  local l a lines=""
  for l in $HW_LANES; do
    a="$(project_default_account "$l")"
    [ "$a" = default ] || lines="${lines:+$lines, }$l $a"
  done
  [ -z "$lines" ] || printf '    lanes whose own default account is not `default`: %s\n' "$lines"
  cat <<'USAGE'

  THE GENTLE FLOW
    --sdd gentle       gentle-ai's ODD, only in a lane whose sdd_modes lists it
                       and only with --agent claude; see hw gentle-home.
    hw gentle-home [--check|--path] provision gentle-ai's own HOME for --sdd gentle

  THE BRIEF AND THE LEDGER
    --no-brief         launch with no brief on purpose (without it a missing brief
                       dies, naming the path it looked for and the nearest names);
                       a brief that IS found is still used
    hw ledger [<lane>] [--brief <path>|--task <t>] [--state <s>] [--json]
                       each brief as never-dispatched, in-progress or done, from
                       $WORK/.hw-ledger/<lane>.jsonl plus the run's done marker
    hw briefs archive <lane> [--apply]
                       move the lane's finished briefs to briefs/archive/<yyyy-mm>/
                       (plan only without --apply); an archived task does not launch
    hw briefs restore <lane> <task> | unarchive <lane> --manifest <file>
                       the way back, one brief or a whole manifest

  KEYCHAIN HANDLES
    --no-handle-check  skip the keychain-handle preflight
    hw handle <handle>...           does a keychain handle resolve?

  THE ONE-SHOT ESCAPE
    hw human-boundary "<why>"       executor-only one-shot escape for a genuine
                                    money/third-party/irreversible/outward/priority
                                    decision; names why the ordinary exits do not apply

  SUITES
    hw suite <project> [--status|--dry-run] [--wait-ms N] -- <command...>
        Run one command at a time per lane, behind that lane's suite lock.
        Names the holder instead of waiting mutely, and breaks an
        ORPHANED lock on the first pass rather than waiting it out. NEVER kill a
        suite with `pkill -f`: that pattern matches every lane's run and every
        agent's, and it has already destroyed three complete runs. Kill by pid,
        or wait.

  CONSENT VERDICTS
    `hw consent` reports its own VERDICTS in the same one number space, which is
    why they are 9 and 10 rather than the 3/4 the first draft reached for:
    9   NOT ANSWERED. hw made no decision and executed nothing — the run
        declared `ask`, or the candidate is above the declared ceiling. The
        consent envelope is still open; relay it to your brainer. This is a
        decision, not a failure, and routing around it defeats the ceiling.
    10  the provider itself exited 9. The answer WAS submitted; 9 is reserved
        for "hw executed nothing", so the collision is remapped rather than
        left ambiguous. Every other provider status is relayed unchanged, and
        1 remains hw's own single refusal code.

USAGE
}

_usage_short() {
  cat <<'USAGE'
hw — launch one executor per task, in its own tab, with its own worktree.

SYNOPSIS
    hw <project> <task> --brief <path> --sdd none [flags]
    hw <command> [args]                hw help <topic>

COMMANDS
    brain <project>                    open the project's long-lived brainer
        brain demo
    hw <project> <task> --brief <path> --sdd none
        launch an executor on a brief; --dry-run prints the dispatch and
        builds nothing
        hw demo hello --brief ~/brain/demo/briefs/hello.md --sdd none
    hw <project> <task> --brief <path> --sdd none --worktree none --no-db
        read-only work (an audit, a review): a tab, no branch, no database
    hw status [<project>]              what is running, and what never closed
        hw status demo
    hw receipt <project> <task>        what was measured, next to what was dispatched
        hw receipt demo hello
    hw done <project> <task>           close the task's tab once its report is
        hw done demo hello             accepted; removes no worktree, no branch

HELP TOPICS                            hw help <topic>
    dispatch     the launch form per lane, placement and isolation
    flags        every launch flag
    commands     the other commands: reports, next, wait, preview, ruling, ...
    exit-codes   what each exit status means
    recovery     revive, unstick, reap, sweep, worktrees
    advanced     what only some brains use: accounts, model floors, secrets, suites
    lanes        the fields of a lane in projects.json, and `brief_note`
    all          every topic, in one page

    -h, --help      this page            -V, --version   print the version
    NO_COLOR=1 turns colour off; it is off too when the output is not a terminal.
USAGE
}

_usage_all() {
  _usage_launch
  _usage_placement
  _usage_flags
  _usage_commands
  _usage_recovery
  _usage_exits
  _usage_projects
  _usage_environment
  _usage_advanced
  _usage_lanes
}

# `hw help [<topic>]`: the short page, or one topic. Topics answer on stdout.
cmd_help() {
  case "${1:-}" in
    "")         _usage_short ;;
    dispatch)   _usage_launch; _usage_placement; _usage_projects; _usage_environment ;;
    flags)      _usage_flags ;;
    commands)   _usage_commands ;;
    exit-codes) _usage_exits ;;
    recovery)   _usage_recovery ;;
    advanced)   _usage_advanced ;;
    lanes)      _usage_lanes ;;
    all)        _usage_all ;;
    *) die "no help topic '$1' — hw help lists them: dispatch, flags, commands, exit-codes, recovery, advanced, lanes, all" ;;
  esac
}

# --help anywhere, before the positional guard: the question "what are my
# options" must not require already knowing the answer.
if [ "${1:-}" = help ]; then shift; cmd_help "$@"; exit 0; fi
for _a in "$@"; do
  case "$_a" in -h|--help) _usage_short; exit 0 ;; esac
done

# `hw preview` is complete on its own — listing every held preview needs no
# project and no task, and requiring two words to ask "what is being held" is
# how a listing stops being consulted.
if [ "${1:-}" = preview ] && [ $# -eq 1 ]; then shift; cmd_preview list; exit 0; fi
if [ "${1:-}" = chaining-lease-start ]; then shift; cmd_chaining_lease_start "$@"; exit 0; fi
if [ "${1:-}" = chaining-lease-expire ]; then shift; [ $# -eq 3 ] || die "internal chaining-lease-expire needs rundir token task"; cmd_chaining_lease_expire "$@"; exit 0; fi

[ $# -ge 2 ] || { _usage_short >&2; exit 64; }


DROP_DB=0
KEEP_PREVIEW=0; KEEP_FOR=""; KEEP_WHY=""
# The one exit from the in-use guard (`_done_in_use_guard`). Default off: a
# close that cannot establish who owns the pane should stop, not shrug.
DONE_FORCE=0
DONE_BLOCKED=0
if [ "$1" = preview ]; then shift; cmd_preview "$@"; exit 0; fi
if [ "$1" = done ]; then
  shift
  [ $# -ge 2 ] || die "usage: hw done <project> <task> [--drop-db] [--force] [--keep-preview [<duration>] --why <reason>]"
  _dp="$1"; _dt="$2"; shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --drop-db) DROP_DB=1; shift ;;
      --force) DONE_FORCE=1; shift ;;
      --blocked) DONE_BLOCKED=1; shift ;;
      --keep-preview)
        KEEP_PREVIEW=1; shift
        case "${1:-}" in ""|--*) ;; *) KEEP_FOR="$1"; shift ;; esac ;;
      --why) _need_val "$@"; KEEP_WHY="$2"; shift 2 ;;
      *) die "unknown option: $1 (hw done takes --drop-db, --force, --blocked, --keep-preview [<duration>], --why <reason>)" ;;
    esac
  done
  if [ "$KEEP_PREVIEW" = 1 ]; then
    [ "$DROP_DB" = 0 ] || die "--drop-db and --keep-preview contradict each other: the preview reads that database. Pick one."
    # A LEASE WITHOUT A REASON IS A LEAK WITH PAPERWORK. The whole point is that
    # somebody later can tell whether this preview is still wanted, and "it was
    # kept" does not answer that. It is one short sentence and it is required.
    [ -n "$KEEP_WHY" ] || die "--keep-preview needs --why \"<what is still going to look at this>\" — e.g. --why \"opus judge, then ${HW_OPERATOR:-the operator} approves the exact preview\". A retained preview with no stated reader is the thing this flag exists to stop."
  fi
  DONE_VERIFY_SKIP=""
  [ "$DONE_BLOCKED" = 1 ] && DONE_VERIFY_SKIP="blocked"
  [ "$DONE_FORCE" = 1 ] && DONE_VERIFY_SKIP="--force"
  cmd_done "$(_canon_project "$_dp")" "$_dt"; exit 0
fi

_need_val "$@"   # guarded above too, but state it where the shift happens
PROJ="$(_canon_project "$1")"; TASK="$2"; shift 2
# THE LANE'S OWN DEFAULT, NOT `claude` EVERYWHERE. project_default_kind() has
# said `<lane> -> opencode` since the tabs migration, and only bin/brain was
# reading it — hw hardcoded claude for all four lanes. So `hw <lane> <task>`
# with no --agent launched a Claude executor into a lane whose governing
# decision requires OpenCode direct Sol, and the manifest called it
# `(default)`, which was true and useless. That cost a worktree,
# a dependency install, a database, a workspace and a port before a human
# noticed. The table existed two files away.
AGENT="$(project_default_kind "$PROJ" 2>/dev/null || printf 'claude')" # MUTATION-ANCHOR: 136-M04b
MODEL="$(project_default_model "$PROJ" 2>/dev/null || printf '')"
MODEL_SRC=default; AGENT_EXPLICIT=0
[ -n "$MODEL" ] && MODEL_SRC="lane default for $PROJ"
# THE ACCOUNT IS A LANE FACT TOO. A product lane runs under the operator's personal
# Claude account by their decision; every other lane runs under the default.
# Same table, same shape, same manifest column as the vendor and the model —
# because the failure this replaces was a redirect that lived in a `.envrc`
# nobody read, applied by `direnv allow`, announced nowhere.
ACCOUNT="$(project_default_account "$PROJ" 2>/dev/null || printf 'default')"
ACCOUNT_SRC="lane default for $PROJ" # MUTATION-ANCHOR: 136-M10b
PERMISSIONS_FLAG=""
WANT_DB=1; BRIEF=""; HERE=0; EFFORT=""; AGENT_ARGS=""; SDD=""
# OFF BY DEFAULT, the inverse shape of --no-db: a product lane's QA moved to
# staging-after-merge (decision of 2026-09-22), so a dev server hw starts by
# default is an invitation to do exactly the local QA that was ruled out. Every
# other lane ignores this var entirely and keeps starting its dev server
# unconditionally.
WANT_DEVSERVER=0; DEVSERVER_SRC=default  # MUTATION-ANCHOR: 171-M01
WANT_REPORT=1; KEEP_PANE=0; KEEP_PANE_FOR=""; KEEP_PANE_SECONDS=""; KEEP_PANE_WHY=""  # MUTATION-ANCHOR: 67-M06
WANT_WT=1; WT_SRC=default; WT_EXPLICIT=0
# WHICH DEFAULTS WERE ACTUALLY CHOSEN. `--sdd` got a (chosen/inherited) column on
# 2026-08-21 and it is the reason the framework stopped being decided by accident.
# The same silence was still true of three others: omit `--agent` and you get
# claude, omit `--no-db` and a database is provisioned, omit `--here` and the task
# gets its own space. All three are usually right, and a brainer re-issuing an
# abbreviated command has no way to see that it re-chose them. On 2026-08-24 a
# brainer wrote itself a five-point prose checklist to compensate; a rule the tool
# could print is not a discipline problem.
AGENT_SRC="lane default for $PROJ"; DB_SRC=default; HERE_SRC=default
# TABS BY DEFAULT since 2026-08-24. One space per project, one tab per agent,
# and the brainer is a tab too (bin/brain). `--space` is the opt-out to the old
# workspace-per-task model; `--here` is unchanged and still means "split my pane,
# no worktree", which is a different decision from placement.
TAB=1; TAB_EXPLICIT=0; SPACE_EXPLICIT=0
DISPATCH_DRY=0
SANDBOX=0; SANDBOX_SRC=""; SANDBOX_LINE=""
CHECK_HANDLES=1
NO_BRIEF=0
ALLOW_STALE_HOOKS=0
CHECK_REUSE=1
FRESH_SOURCE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --agent)  _need_val "$@"; AGENT="$2"; AGENT_SRC=chosen; AGENT_EXPLICIT=1; shift 2 ;;
    --account) _need_val "$@"; ACCOUNT="$2"; ACCOUNT_SRC=chosen; shift 2 ;;
    --permissions) _need_val "$@"; PERMISSIONS_FLAG="$2"; shift 2 ;;
    --brief)  _need_val "$@"; BRIEF="$2";  shift 2 ;;
    # A launch with no brief is a refusal unless it is asked for (_briefless_gate).
    --no-brief) NO_BRIEF=1; shift ;;
    --model)  _need_val "$@"; MODEL="$2"; MODEL_SRC=chosen; shift 2 ;;
    # The same declaration `decision:` makes in a brief, for a dispatch that has
    # no brief or whose brief predates the decision. Typed at the dispatch that
    # is actually happening, so it wins over the brief.
    --model-why) _need_val "$@"; MODEL_WHY="$2"; MODEL_WHY_SRC=flag; shift 2 ;;
    # The request this dispatch answers, for a dispatch with no brief or whose
    # brief predates the field. Wins over the brief's, like --model-why.
    --requested-by) _need_val "$@"; REQUESTED_BY="$2"; REQUESTED_BY_SRC=flag; shift 2 ;;
    # The reason a dispatch runs below its lane's model_floor. Required there.
    --below-floor-why) _need_val "$@"; BELOW_FLOOR_WHY="$2"; shift 2 ;;
    --effort) _need_val "$@"; EFFORT="$2"; shift 2 ;;
    --sdd)    _need_val "$@"; SDD="$2";    shift 2 ;;
    # Print the dispatch and stop. The brainer that shipped a read-only task
    # into a framework flow had already SEEN the entry command in the
    # launch output — it just had no way to look BEFORE committing, so it looked
    # after, decided not to intervene, and left the executor to improvise.
    --dry-run) DISPATCH_DRY=1;             shift ;;
    # THE EXECUTOR RUNS IN A SEATBELT PROFILE (bin/hw-sandbox). Opt-in, macOS
    # only, claude only: the executor-isolation decision of 2026-09-30.
    --sandbox) SANDBOX=1; SANDBOX_SRC="--sandbox"; shift ;;
    --no-db) WANT_DB=0; DB_SRC=chosen; shift ;;
    --dev-server) WANT_DEVSERVER=1; DEVSERVER_SRC=chosen; shift ;;
    --no-report) WANT_REPORT=0; shift ;;
    --report-to) _need_val "$@"; HW_INVOKER_PANE="$2"; REPORT_TO_CHOSEN=1; shift 2 ;;
    --keep-pane)
      KEEP_PANE=1; shift
      case "${1:-}" in ""|--*) ;; *) KEEP_PANE_FOR="$1"; shift ;; esac ;;
    --why) _need_val "$@"; KEEP_PANE_WHY="$2"; shift 2 ;;
    --here)  HERE=1; HERE_SRC=chosen; shift ;;
    # THE AXES, SPELLED SEPARATELY. Placement, isolation and base are three
    # independent decisions that hw encoded in one or two flags, which is the
    # root of lane C2 and C5 in setup/plans/phase-b-friction-roots.md. The old
    # spellings below are kept and are exactly equivalent; these just let a
    # caller ask for a combination that had no name.
    --placement)
      _need_val "$@"
      case "$2" in
        project-tab)  TAB=1; TAB_EXPLICIT=1; HERE=0 ;;
        legacy-space) TAB=0; SPACE_EXPLICIT=1; HERE=0 ;;
        here)         HERE=1 ;;
        *) die "--placement must be project-tab, legacy-space or here (got: $2)" ;;
      esac
      HERE_SRC=chosen; shift 2 ;;
    # THE BASE IS A DISPATCH DECISION, so it is declarable and it is printed.
    # Before this existed the base lived in one constant nobody read and in
    # prose inside the brief, which is to say nowhere a check could reach.
    --base)
      _need_val "$@"
      case "$2" in
        -*|"") die "--base takes a branch name (got: $2)" ;;
      esac
      BASE_OVERRIDE="$2"; BASE_SRC=chosen; shift 2 ;;
    --worktree)
      _need_val "$@"
      case "$2" in
        new)     WANT_WT=1 ;;
        none)    WANT_WT=0 ;;
        reuse:*) die "--worktree reuse:<task> is not implemented. It is the one axis value that needs an ownership check first — reusing another task's worktree binds this task to that branch and database, which is how a remediation task once ended up on the wrong lineage. Launch on its own worktree, or say what you actually need." ;;
        *) die "--worktree must be new or none (got: $2)" ;;
      esac
      WT_SRC=chosen; WT_EXPLICIT=1; shift 2 ;;
    # PLACEMENT AND ISOLATION ARE TWO DECISIONS. --here conflated them: it puts
    # the executor beside its brainer AND takes away the worktree, branch, ports
    # and database. --tab is the missing combination — beside the brainer, fully
    # isolated. See setup/plans/agent-tabs.md for the measurements.
    --tab)   TAB=1; TAB_EXPLICIT=1; HERE_SRC=chosen; shift ;;
    --space) TAB=0; SPACE_EXPLICIT=1; HERE_SRC=chosen; shift ;;
    # The escape hatch, and the reason it exists: the preflight below refuses to
    # launch a task whose brief names a keychain handle that does not resolve.
    # That is right almost always — the alternative is an executor blocked five
    # minutes in — but "I am about to store it" and "that line is an example, not
    # a requirement" are both real, and neither should mean editing the brief.
    --no-handle-check) CHECK_HANDLES=0; shift ;;
    # THE ESCAPE HATCH FOR THE STALE-HOOKS REFUSAL (_refuse_if_stale_hooks). A
    # worktree whose versioned settings still invoke a removed hook binary
    # refuses to launch by default; this launches onto it anyway, loudly, and
    # records it in the run's receipt so `hw receipt <project> <task>` shows it
    # rather than a launch that silently carried a known-broken hook.
    --allow-stale-hooks) ALLOW_STALE_HOOKS=1; shift ;;
    # THE NAMED CHOICE FOR A NEW SESSION. Reuse is now the default operation;
    # contaminated context, a different vendor/model and deliberate concurrent
    # work are real reasons to pay for a fresh executor, but they are explicit
    # and visible. --no-reuse-check keeps its old exact behaviour as an alias:
    # skipping discovery necessarily chooses a fresh session.
    --fresh) CHECK_REUSE=0; FRESH_SOURCE="--fresh"; shift ;;  # MUTATION-ANCHOR: 71-M02
    --no-reuse-check) CHECK_REUSE=0; FRESH_SOURCE="--no-reuse-check (legacy alias for --fresh)"; shift ;;
    *) die "unknown option: $1" ;;
  esac
done
if [ "$KEEP_PANE" = 1 ]; then
  [ -n "$KEEP_PANE_WHY" ] || die "--keep-pane needs --why \"<who or what will re-task it>\". Retention without a named holder is an unbounded leak with nicer syntax." # MUTATION-ANCHOR: 37-M03
  [ "$WANT_REPORT" = 1 ] || die "--keep-pane and --no-report contradict each other: a chaining lease starts only after receiver-proved report delivery."
  case "$KEEP_PANE_WHY" in *$'\n'*) die "--why must be one line so the run env and lease records remain parseable" ;; esac
  KEEP_PANE_SECONDS="$(_lease_seconds "$KEEP_PANE_FOR")"
elif [ -n "$KEEP_PANE_WHY" ]; then
  die "--why is only valid with --keep-pane"
fi
# An explicit --brief wins; otherwise brain/<project>/briefs/<task>.md is used
# when it exists. No brief at all is REFUSED, naming the path looked for and the
# nearest names; `--no-brief` is the deliberate way through, with a one-line warning.
if [ -z "$BRIEF" ]; then
  BRIEF="$(_infer_brief "$PROJ" "$TASK")"
  # No flat brief: an ARCHIVED one ends the launch here, naming how to get it back.
  if [ -n "$BRIEF" ]; then info "brief inferred: $BRIEF"; else _archived_brief_gate "$PROJ" "$TASK"; fi
fi
_briefless_gate
if [ -n "$BRIEF" ]; then
  [ -f "$BRIEF" ] || die "brief not found: $BRIEF"
  # Read here, in hw's own process. The brief is handed to the agent as a
  # prompt over the herdr socket — it is never written into the worktree, so
  # `git status` there stays clean and nothing can be committed by accident.
  BRIEF_TEXT="$(cat "$BRIEF")"
  [ -n "$BRIEF_TEXT" ] || die "brief is empty: $BRIEF"
fi
# --here vs --tab: refuse only when BOTH were asked for. Since tabs became the
# default, `--here` alone arrives with TAB already 1, and erroring on that would
# refuse a legal flag. But silently resolving an EXPLICIT contradiction is worse
# than either — so --tab records that it was chosen, and only then is it a clash.
if [ "$HERE" = 1 ] && [ "$TAB_EXPLICIT" = 1 ]; then
  die "--here and --tab are two different placements: --here splits your pane and drops the worktree, --tab gives the task its own tab and keeps it. Pick one."
fi
[ "$HERE" != 1 ] || TAB=0
case "$AGENT" in claude|opencode|codex) ;; *) die "--agent must be claude, opencode or codex (got: $AGENT)" ;; esac
case "$SDD" in
  ""|speckit|none) ;;
  gentle) _validate_sdd_gentle ;;
  *) case " $(project_sdd_modes "$PROJ") " in
       *" gentle "*) die "--sdd must be speckit, none or gentle (got: $SDD)" ;;
       *)            die "--sdd must be speckit or none (got: $SDD)" ;;
     esac ;;
esac
# BEFORE the reuse discovery below and before anything is built: a posture the
# lane never delegated is a refusal, not a warning, and it must cost nothing.
# A requested vendor describes the fresh executor, not an executor already
# alive in the lane. Discover reuse first; cmd_next validates a selected pane
# against its measured vendor before changing its task state.
_check_reusable_executor "$PROJ"
# THE ROUTE IS DECIDED THE MOMENT DISCOVERY RETURNS, so the comparison against
# the dry run's forecast happens HERE — before the vendor gate, before the
# brief contract, before a worktree, a database or a port. A refusal that comes
# after any of those has already spent what it exists to save.
_ROUTE_NOW=fresh; [ -z "$_REUSE_PANE" ] || _ROUTE_NOW=reuse
if [ "$DISPATCH_DRY" != 1 ]; then
  if [ "${CHECK_REUSE:-1}" != 1 ]; then
    # --fresh on THIS command is the brainer deciding again, in the open. It
    # binds the route by itself, so an older forecast has nothing left to say;
    # it is dropped rather than left to refuse some later launch.
    _route_forecast_drop "$PROJ" "$TASK"
  else
    _route_forecast_check "$PROJ" "$TASK" "$_ROUTE_NOW" "$_REUSE_LINE"
  fi
fi
# ODD enters at launch, as a flag; a live session cannot be handed it.
[ "$SDD" != gentle ] || [ -z "$_REUSE_PANE" ] \
  || die "gentle-ai ODD dispatch REFUSED BEFORE BUILDING ANYTHING: a reusable executor is live in $PROJ ($_REUSE_PANE), and ODD enters Claude's system prompt only at launch. Nothing was built. Pass --fresh."
[ -n "$_REUSE_PANE" ] || { _validate_sdd_vendor_pair "$AGENT" "$SDD" "$(_codex_validation_surface)"; _validate_sdd_model_pair "$MODEL"; }
HW_EXECUTOR_VENDOR="$AGENT"; export HW_EXECUTOR_VENDOR
_resolve_invoker_context
# A LANE'S PINNED MODEL BELONGS TO ITS VENDOR. A product lane pins
# `openai/gpt-5.6-sol`, which is an opencode id; carrying it into an explicit
# `--agent claude` made hw refuse its own default with "that is a provider/model
# id, which is opencode's form". The override has to override the whole pin, not
# half of it — unless --model was given too, in which case the human said both.
if [ "$AGENT_EXPLICIT" = 1 ] && [ "$MODEL_SRC" != chosen ] \
   && [ "$AGENT" != "$(project_default_kind "$PROJ" 2>/dev/null || printf 'claude')" ]; then
  MODEL=""; MODEL_SRC=default
fi

# BEFORE the floor and _build_agent_args: both read MODEL.
_apply_model_default
# Before _build_agent_args, which carries a model it pins into the agent's flags.
_check_model_floor
# Before _build_agent_args: OpenCode argument construction allocates a port.
_check_brief_measured_evidence
hw_permissions_resolve "$PERMISSIONS_FLAG" || die "$PERMISSIONS_ERR"
_build_agent_args
_brain_guard_check
_brain_guard_args
_engram_proxy_args
_artifacts_args
# BEFORE _check_task and before anything is built. A contradiction between the
# brief and the flags must cost nothing to discover.
_check_brief_contract
_check_sandbox
_check_requested
_check_authorizes
_check_task "$TASK"
_check_agent_name_free "$TASK"
lane_known "$PROJ" || die "unknown project: $PROJ (expected: $(lane_names_bar))"

# `--here` MEANS WHAT IT SAYS NOW. The manifest has been printing "here (splits
# the brainer pane — no worktree, no branch, no database)" and CLAUDE.shared.md
# has said the same, while the two product lanes branches ran all of
# steps 1..5 — worktree, branch, dependency install, ports, database — and only
# then split the pane. So `--here` really did create a worktree, and the product-lane
# brainer that reported "--here was interpreted as 'work in this worktree'"
# (C2) was not confused: hw did exactly that, and said otherwise.
#
# Two ways to end a lie. Deleting the claim leaves a flag whose whole point was
# to be cheap; making it true costs nothing anyone wanted. So `--here` now
# implies `--worktree none`, which is what every brainer has been told it does.
# The old behaviour is still reachable, and now has a name: --here --worktree new.

if [ "$HERE" = 1 ] && [ "$WT_EXPLICIT" = 0 ]; then WANT_WT=0; WT_SRC="implied by --here"; fi
# the repo-less lanes have no repo, so the axis does not apply and pretending it does
# would be a second lie in the other direction. `setup` left this line on
# 2026-09-16 together with REPOLESS: it has a checkout (brain), so the axis is
# real there and `--worktree none` is now a choice a setup dispatch can make
# rather than a fact it is handed.
if _is_repoless "$PROJ"; then WANT_WT=0; WT_SRC="n/a (repo-less lane)"; fi

# ── the dispatch manifest ───────────────────────────────────────────────────
#
# WHY THIS EXISTS. A brainer once dispatched a task and reported
# everything about the WORK and nothing about the DISPATCH, and the operator
# had to ask whether it had been dispatched with sdd, and in which mode. They
# were right, and the honest answer was that nobody had chosen: without --sdd
# a task INHERITS whatever its directory already carries (see
# _sdd_live_mode). An inherited default is a decision nobody made and nobody
# announced, which is the worst kind.
#
# So the manifest does not ask the brainer to be forthcoming — measurement
# says instructions do not hold and enforced contracts do. hw states
# the dispatch itself, marks every value `chosen` or `inherited`, persists it to
# `.hw/<run>/dispatch`, and TOASTS THE OPERATOR DIRECTLY at launch. That last
# part is the point: it does not depend on the brainer relaying anything.

DISPATCH_TEXT=""
DISPATCH_FRAMEWORK=""
# WHICH OF THE TWO LAUNCH PATHS THIS DISPATCH WILL TAKE. `fresh` builds an
# executor; `reuse` hands the brief to a live one through cmd_next and builds
# nothing. Until 2026-09-09 the reuse path exited before the manifest was ever
# assembled, so `hw <lane> <task> --dry-run` that found a reusable pane printed
# NO manifest at all — no framework, no model, no worktree, no account — only
# the reuse warning. Measured twice the same day: once by the product-lane brainer and
# once while verifying --account, where the missing `account` line read as "the
# feature does not work" when it works.
#
# A dry run that prints no manifest is not a dry run, it is a warning. So the
# manifest is printed on BOTH paths, and it NAMES the path — a reuse manifest
# that still claimed a worktree and a database would be the same defect wearing
# the other hat.
DISPATCH_ROUTE=fresh
DISPATCH_IN_PLAY=0

_sdd_live_mode() {
  # The mode actually in force for a directory, read from disk rather than
  # echoed back from the flag — the flag is what was ASKED FOR, this is what is
  # TRUE. A machine-wide install is marked "(global)": it does not by itself put
  # a directory's work into the flow.
  local dir="$1"
  if _speckit_skills_in "$dir" >/dev/null; then printf 'speckit'
  elif _speckit_skills_in "$HOME" >/dev/null; then printf 'speckit (global)'
  fi
  return 0
}

_brief_verify_cmds() {
  # THE COMMANDS THE BRIEF SAYS PROVE THE WORK, extracted so hw can RUN them.
  #
  # This replaces `_brief_declares`, which answered a weaker question — does the
  # brief have a Testing heading? — and printed its answer, `declared`, in the
  # dispatch manifest beside the real fields, where it read like a
  # postcondition. It was not one. On 2026-08-25 three executors in a row
  # shipped correct code with a report claiming a verification nobody had run,
  # and every one of those briefs said `declared`. A heading is not a
  # measurement, and a field that looks like one is worse than no field.
  #
  # It also had a NAME COLLISION with the frontmatter parser of the same name
  # ~3300 lines above. Both were top-level, so the second definition won for
  # every call made after this point in the file; the frontmatter parser
  # survived only because its one call site is top-level code that runs before
  # this line is ever parsed. Nothing tested that ordering. It is gone now.
  #
  # ONLY MARKDOWN CODE COUNTS: a fenced block, or a 4-space-indented block,
  # inside the Testing/Verification section. Inline backticks are deliberately
  # NOT read. In this repo's own briefs a `path` and half a sentence of
  # `VAR=1 VAR=2` are both spelled with backticks, and nothing in the markup
  # separates either from a command — so reading them would mean hw executing
  # prose. A brief that wants its verification run puts it in a fence, which is
  # what a fence already means everywhere else.
  local brief="$1"
  [ -n "$brief" ] && [ -r "$brief" ] || return 0
  awk '
    /^#+[ \t]/ {
      # No \b in awk, and no trailing boundary either: a UTF-8 `o-acute` is
      # multibyte, so anchoring the end of `verificaci` would fail on
      # `Verificacion` accented — the exact heading the old English-only,
      # start-anchored pattern missed on 2026-08-24.
      if (tolower($0) ~ /(^|[^a-z])(testing|tests|verification|verificaci|verificar|pruebas|how to verify|qa)/) { insec=1; next }
      insec=0; fence=0; next
    }
    !insec { next }
    /^[ \t]*```/ { fence = !fence; next }
    {
      line=$0
      if (!fence && line !~ /^    /) next    # outside a fence, only indented code
      sub(/^[ \t]+/, "", line)
      sub(/^\$[ \t]+/, "", line)             # a shell prompt is not part of the command
      if (line == "" || line ~ /^#/) next    # blanks and comments are not commands
      print line
    }
  ' "$brief"
}

_intended_workdir() {
  # The directory the task WILL run in, resolved before the lane builds it, so
  # the manifest can name it. Mirrors the per-lane assignments further down;
  # keep the two in step.
  # Keyed on the ISOLATION axis, not on placement. It always claimed
  # $WORK/$PROJ/$TASK for --here while the two product lanes
  # branches ran in $MAIN/.worktrees/$TASK — the manifest named a directory the
  # task did not use. Now --here implies --worktree none, so the two agree.
  if [ "$WANT_WT" = 0 ]; then printf '%s/%s/%s' "$WORK" "$PROJ" "$TASK"; return 0; fi
  local _wt; _wt="$(_lane_wt_dir "$PROJ" "$TASK")"
  if [ -n "$_wt" ]; then printf '%s' "$_wt"
  else printf '%s/%s/%s' "$WORK" "$PROJ" "$TASK"; fi
}

# ── shared dependency contention ─────────────────────────────────────────────
#
# MEASURED 2026-09-11. A product lane's `local/wt.sh` deliberately LINKS
# (not copies) `backend/.venv` and `frontend/node_modules` across every
# worktree of the repo — its own comment says "sharing one venv and one
# node_modules across branches is the whole point" (~580M saved). SQLite
# fixtures ARE copied per worktree; these two are not, and nothing told a
# brainer that difference before it dispatched a second executor onto the same
# project. Another session's `pnpm install` — one that ignored the tracked
# lockfile — floated vitest to 4.1.11 against vite 5.4.21 and broke the
# frontend suite for the one executor that was actively writing code at the
# time, mid-task, with no warning anywhere it could have seen. `hw` already
# prints "venv + node_modules linked by wt.sh" at provisioning time (step 2/6);
# this is the same fact, said at DISPATCH time, as contention rather than
# decoration, and naming who else is live.
#
# THE OTHER LANE IS NOT THE SAME, and this was verified by reading
# scripts/new-worktree.sh rather than assumed from the other lane
# fact: it runs its own `pnpm install` per worktree and links nothing, so a
# product-lane worktree does not contend with another product-lane worktree on this axis.
#
# the repo-less lanes have no repo and therefore nothing to share.
#
# setup DOES share, since 2026-09-16, and it is named rather than folded in with
# the others: hw symlinks the `.opencode/node_modules` trees into each setup
# worktree instead of installing them. That is deliberate (one install, 122M
# saved per task), and it is NOT the pnpm-install contention this function
# reports, because nothing in the setup lane runs an install. Sharing without
# contention is a third state, so the field says none rather than inventing a
# risk an executor would act on.
_deps_contending_others() {
  # $1 = proj. Prints one "pane <id> (task <name>)" line per OTHER live
  # executor on this project whose run has NOT reported yet (no done marker —
  # still working, therefore a real install-time collision risk). Prints
  # nothing when none are found. Returns 1 when live state could not be read
  # at all, so the caller says "could not be established" rather than a false
  # "none".
  local proj="$1"
  local agents
  agents="$(herdr agent list 2>/dev/null)" || return 1
  [ -n "$agents" ] || return 0
  local candidates
  candidates="$(printf '%s' "$agents" | jq -r --arg proj "$proj" '
    (.result.agents // [])[]
    | select((.tokens.hw_project // "") == $proj)
    | [(.pane_id // empty), (.tokens.hw_task // empty)] | @tsv' 2>/dev/null)" || return 1
  [ -n "$candidates" ] || return 0
  local pane task
  while IFS=$'\t' read -r pane task; do
    [ -n "$pane" ] || continue
    local info cwd
    info="$(herdr agent get "$pane" 2>/dev/null || true)"
    [ -n "$info" ] || continue
    cwd="$(printf '%s' "$info" | jq -r '.result.agent.cwd // empty' 2>/dev/null || true)"
    [ -n "$cwd" ] || continue
    local rundir
    rundir="$(_next_run_dir "$cwd" 2>/dev/null || true)"
    [ -n "$rundir" ] || continue
    [ -f "$(_run_done_marker "$rundir")" ] && continue  # reported — no longer working  # MUTATION-ANCHOR: 134-M02
    [ -n "$task" ] || task="$(_run_env_value "$rundir" HW_TASK 2>/dev/null || true)"
    printf 'pane %s (task %s)\n' "$pane" "${task:-unknown}"
  done <<< "$candidates"
  return 0
}

# Builds the `dependencies` manifest line for `$1` = proj. Set as a global
# because a `local x; x="$(f)"` assignment masks f's own exit code under
# `set -e`, and this function's non-zero path (live state unreadable) is part
# of what it reports.
DEPS_LINE=""
# THE SENTENCE IS THE LANE'S, in projects.json (`deps.line`), because what a
# worktree shares is a fact about that repo's own worktree script. What stays
# here is the one live part: a lane whose dependencies are shared by symlink
# (`deps.contention`) is told who else is working on them right now.
_deps_line() {
  local proj="$1" base
  base="$(lane_get "$proj" deps_line)" || base=""
  if [ -z "$base" ]; then
    if _is_repoless "$proj"; then DEPS_LINE="none ($proj is repo-less)"
    else DEPS_LINE="not declared for $proj — bin/hw names no dependency sharing for this lane"; fi
    return 0
  fi
  if [ "$(lane_get "$proj" deps_contention)" != 1 ]; then
    DEPS_LINE="$base"
    return 0
  fi
  local others rc=0
  others="$(_deps_contending_others "$proj")" || rc=$?
  if [ "$rc" != 0 ]; then
    DEPS_LINE="$base Other live executors on this project could NOT be established (herdr/jq lookup failed) — check by hand before installing anything."
  elif [ -n "$others" ]; then
    DEPS_LINE="$base Currently working (not yet reported), so an install there breaks this task's suite too: $(printf '%s' "$others" | tr '\n' ';' | sed 's/;/, /g; s/, $//')"
  else
    DEPS_LINE="$base No other live executor found on this project right now."
  fi
}

_surface_dir() {
  # The directory whose framework mode the task will ACTUALLY run under, which
  # is not always the directory it runs in. A product-lane worktree lives
  # at <repo>/.worktrees/... and inherits the repo's
  # mode through the `.claude` symlinks its creation script lays down, not
  # through its path. Asking about the worktree path found nothing, which read
  # as "<undetermined>" when the true answer was "the repo's mode". So ask about the repo for the worktree lanes,
  # and about the work directory for the repoless ones.
  if _lane_is_product_repo "$PROJ"; then lane_checkout "$PROJ"
  else _intended_workdir; fi
}

_dispatch_manifest() {
  # $1 = the directory the task will run in (for the live SDD read)
  local dir="$1" live="" sdd_src="inherited" mark surface
  surface="$(_surface_dir)"
  # ON THE REUSE ROUTE THE SURFACE IS THE REUSED SESSION'S, not the work
  # directory this dispatch would have created. `_surface_dir` answers with
  # `_intended_workdir` for the repoless lanes, and on a reuse that directory
  # does not exist and is not where the task will run — so the framework mode
  # would be read from the wrong place and printed as `<undetermined>` or worse,
  # as some other task's mode. The worktree lanes already answer with their main
  # checkout, which is correct on both routes.
  if [ "$DISPATCH_ROUTE" = reuse ]; then
    _lane_is_product_repo "$PROJ" || surface="$dir"
  fi
  if [ -n "$SDD" ]; then
    # Do NOT print the live mode here: labelling what the directory carries
    # "chosen" says the opposite of the truth. Caught by testing --sdd with one mode and
    # reading back another as "chosen". Name what was asked for, and say
    # it has not been applied yet.
    live="$SDD"
    if [ "$SDD" = none ]; then
      # Not "applied": nothing is written to the surface. Saying "applied"
      # would claim a change that did not happen.
      sdd_src="chosen (--sdd none) — the directory keeps its own mode, hw forces no entry"
    elif [ "$SDD" = gentle ]; then
      sdd_src="chosen (--sdd gentle) — gentle-ai $GENTLE_VERSION ODD in Claude's system prompt from $(gentle_home_dir); $(_gentle_rdd_word), no gentle-ai hooks; delivery: $GENTLE_DELIVERY; deployed check: ${GENTLE_DEPLOYED_CHECK:-required}"
    else
      sdd_src="chosen (--sdd $SDD), checked on disk below"
    fi
  else
    live="$(_sdd_live_mode "$surface")"
    sdd_src="inherited"
  fi
  # WHAT WILL BE RUN AT CLOSE, named here so a human sees it before the launch.
  # This is also the review moment for it: hw executes these lines itself in
  # `hw done`, and the dispatch manifest is where that is stated in advance.
  local verify_cmds verify_line
  VERIFY_FULL_SUITE=0
  verify_cmds="$(_brief_verify_cmds "$BRIEF")"
  if [ -n "$verify_cmds" ]; then
    verify_line="$(printf '%s' "$verify_cmds" | head -1)"
    local _n; _n="$(printf '%s\n' "$verify_cmds" | grep -c '^' || true)"
    [ "${_n:-1}" -le 1 ] || verify_line="$verify_line  (+$((_n - 1)) more)"
    verify_line="$verify_line  (hw runs this at close; the exit code goes to the receipt)"
    # THE TIMEOUT MISMATCH, SAID HERE — where the brief can still be edited.
    #
    # hw already said this at `hw done`. Measured:
    # that is 900 seconds and a whole task too late, and `--dry-run` — the one
    # place a brainer reviews a dispatch before paying for it — printed the
    # verification block with nothing about the ceiling it was about to hit.
    # Every command in the pin is checked, not just the first: only the first
    # is NAMED on the line above, and a full-suite line sitting second would
    # otherwise reach the close unannounced.
    while IFS= read -r _vc; do
      [ -n "$_vc" ] || continue
      if _verify_names_full_suite "$_vc"; then VERIFY_FULL_SUITE=1; fi  # MUTATION-ANCHOR: 141-M01
    done <<VERIFY_CMDS_EOF
$verify_cmds
VERIFY_CMDS_EOF
    if [ "$VERIFY_FULL_SUITE" = 1 ]; then
      verify_line="$verify_line
              WILL TIME OUT AT CLOSE: this names the full suite (~1000s) without HW_TEST_GATE=fast, against hw done's ${_VERIFY_TIMEOUT}s timeout. Edit the brief now: HW_TEST_GATE=fast bash setup/test-hw"
    fi
  elif [ -z "$BRIEF" ]; then
    verify_line="none — no brief, so nothing to run and nothing measured at close"
  else
    verify_line="none — the brief has no runnable command in its Testing/Verification section"
  fi

  # Is the framework actually IN PLAY for this task? The global mode on this
  # machine is speckit, so keying on the mode alone would fire on every repo-less and
  # setup dispatch — operational work that never enters the flow. A mode is in
  # play when --sdd chose it, or when it comes from a project-specific target
  # rather than the bare global default (which _sdd_live_mode marks by appending
  # "(global)"). Computed HERE, before anything reads it: under `set -u` the
  # entry line below referenced it one block too early and killed the launch.
  local in_play=0
  case "$live" in
    *"(global)"|"") in_play=0 ;;
    *)              in_play=1 ;;
  esac
  # `--sdd none` is the one value that takes a framework OUT of play. It exists
  # because a brainer went looking for exactly this on 2026-08-24, ran
  # `hw <lane> --help`, found nothing, and shipped a read-only inventory into the
  # framework flow rather than intervene. A rule the tool gives you no way to obey
  # is not a discipline problem.
  if [ "$SDD" = none ]; then
    in_play=0
  elif [ -n "$SDD" ]; then
    in_play=1
  fi
  # Published for _send_brief, which prepends the framework's entry command to
  # the prompt. One source of truth for "is the flow running".
  DISPATCH_FRAMEWORK="${live%% *}"
  DISPATCH_IN_PLAY="$in_play"

  # `chosen` when a flag set it, `inherited` when a default did. The whole value
  # of this block is in that column.
  # PROVENANCE, not just presence. A lane-pinned model IS set, and calling that
  # `chosen` would say a human picked it — which is the one thing this column
  # exists to distinguish. MODEL_SRC carries where it came from.
  if [ -n "$MODEL" ];  then mark="${MODEL_SRC:-chosen}"; else mark="inherited"; fi
  local model_line="model=${MODEL:-<agent default>}  ($mark)$(_model_suggestion_note)"  # MUTATION-ANCHOR: 159-M01
  [ -z "${MODEL_PINNED:-}" ] || model_line="$model_line  — the lane pins the alias $MODEL to $MODEL_PINNED (projects.json model_pins), so the CLI gets --model $MODEL_PINNED"
  if [ -n "$EFFORT" ]; then mark="chosen"; else mark="inherited"; fi
  local effort_line="effort=${EFFORT:-<agent default>}  ($mark)"
  # HOW IT REACHES THE VENDOR, spelled out per vendor rather than left to be
  # inferred from AGENT_ARGS. claude and codex carry it as a CLI flag, already
  # visible in "agent args" below; opencode's interactive command has none, so
  # an accepted --effort that silently failed to reach the request would be the
  # worst outcome here — say exactly what will carry it and to which agent.
  #
  # AND IT SAYS "carried", NOT "applied". This line used to read `applied`, and
  # on 2026-09-28 it said so over an executor whose environment never held the
  # overlay. A manifest is written before the executor exists, so it can state
  # the route and nothing more; whether the effort ARRIVED is measured after
  # start by _verify_opencode_effort and lands in the receipt as effort_applied.
  if [ "$AGENT" = opencode ] && [ -n "$EFFORT" ]; then
    effort_line="$effort_line
  carried      via OPENCODE_CONFIG_CONTENT in the pane env (tab, --here, .hw/<run>/env) → agent \"${OPENCODE_PRIMARY_AGENT:-?}\".reasoningEffort
  verified     UNVERIFIED at dispatch — read back from the live executor's GET /config after start (receipt: effort_applied)
  overlay      $OPENCODE_EFFORT_OVERLAY"
  fi

  local placement db_line entry_line chaining_line devserver_line
  # What the executor is forced to run first. Named here so the dispatch says it
  # rather than leaving it to be discovered in the prompt.
  if [ "$in_play" = 1 ]; then
    entry_line="$(_framework_entry "${live%% *}")"
    [ -n "$entry_line" ] || entry_line="<none: '$live' has no single entry>"
    [ "$SDD" != gentle ] || entry_line="none — ODD runs from the system prompt; the protocol has no entry command"
  else
    entry_line="none (no framework flow for this task)"
  fi
  # PLACEMENT AND ISOLATION ARE PRINTED SEPARATELY, because they are separate
  # decisions and welding them into one sentence is what let the old line claim
  # "no worktree" for a run that built one.
  if [ "$HERE" = 1 ]; then placement="here (splits the brainer pane)"
  elif [ "$TAB" = 1 ]; then placement="own tab in space $(project_space_label "$PROJ")"
  else placement="own workspace (legacy model)"; fi
  placement="$placement  ($HERE_SRC)"
  # LANE-AWARE, because `yes` was not true everywhere: one lane provisions a
  # database per worktree, another copies fixtures, and the rest have none. The
  # words are the lane's (`db` in projects.json). A DATABASE IS PROVISIONED INTO
  # A WORKTREE, so with no worktree there is nothing to provision, and saying
  # "own, provisioned per worktree" would be a false field — that rule is hw's.
  local _db_text _db_nowt
  _db_text="$(lane_get "$PROJ" db_line)" || _db_text=""
  _db_nowt="$(lane_get "$PROJ" db_no_worktree)" || _db_nowt=""
  if [ "$(lane_get "$PROJ" db_provisioned)" = 1 ]; then
    if [ "$WANT_WT" = 0 ]; then db_line="$_db_nowt  ($WT_SRC)"
    elif [ "$WANT_DB" = 1 ]; then db_line="own, provisioned per worktree  ($DB_SRC)"
    else db_line="NO — shares the main checkout's database  ($DB_SRC)"; fi
  elif [ -n "$_db_text" ]; then
    if [ "$WANT_WT" = 0 ] && [ -n "$_db_nowt" ]; then db_line="$_db_nowt  ($WT_SRC)"
    else
      db_line="$_db_text"
      if [ "$WANT_DB" = 0 ] && [ "$(lane_get "$PROJ" db_no_db_inert)" = 1 ]; then db_line="$db_line (--no-db has no effect)"; fi
    fi
  elif _is_repoless "$PROJ"; then db_line="none ($PROJ is repo-less)"
  else db_line="none — bin/hw provisions no database for $PROJ"; fi
  # DEV SERVER, the lane's own axis (`devserver.start` in projects.json):
  # `always` starts one unconditionally, `opt-in` only under --dev-server, and a
  # lane that names neither has none.
  #
  # --here EXITS BEFORE ANY OF THEM START, on every lane that has one:
  # `_run_here` returns (and the launch site does `exit 0` right after it) BEFORE
  # the "space + layout" step that assigns HW_PORT_WEB/HW_PORT_API and runs the
  # dev pane's command. That is true whether or not a worktree was built for it
  # (bare `--here` forces WANT_WT=0 unless `--worktree new` was also explicit),
  # so this is checked before the worktree check can shadow it, and both are
  # checked before either lane's own answer — a manifest field that claims a
  # dev server "always started" on a placement that provably exits first is
  # exactly the false field this whole section exists to avoid printing.
  local _dev
  _dev="$(lane_get "$PROJ" devserver)" || _dev=""
  case "$_dev" in
    always|opt-in)
      if [ "$WANT_WT" = 0 ]; then devserver_line="none — no worktree to run one in  ($WT_SRC)"
      elif [ "$HERE" = 1 ]; then devserver_line="none — --here exits before a dev server would start  ($HERE_SRC)"  # MUTATION-ANCHOR: 171-M05  # MUTATION-ANCHOR: 171-M06
      elif [ "$_dev" = always ]; then devserver_line="always started (this lane has no opt-out)"
      elif [ "$WANT_DEVSERVER" = 1 ]; then devserver_line="$(lane_get "$PROJ" devserver_line)  ($DEVSERVER_SRC)"
      else devserver_line="$(lane_get "$PROJ" devserver_off)  ($DEVSERVER_SRC)"; fi
      ;;
    *) devserver_line="n/a ($PROJ has no dev server)" ;;
  esac
  # THE DEPENDENCY-CONTENTION LINE, computed the same way: a live read, safe on
  # a dry run, that says whether this task's dependencies are shared with
  # another worktree and, if so, who else is live on them right now.
  _deps_line "$PROJ"
  # BEFORE THE MANIFEST IS ASSEMBLED, because its verdict is one of the fields.
  # This is a read plus, at most, one `claude-personal --check` (three file
  # reads and a python one-liner), so it is safe on a dry run — and a dry run is
  # exactly where a brainer should learn that the account it is about to launch
  # under cannot be verified.
  _resolve_account
  local agent_line="$AGENT  ($AGENT_SRC)"
  if [ "$AGENT" = opencode ]; then
    if [ -n "${OPENCODE_PRIMARY_AGENT:-}" ]; then
      agent_line="$agent_line
  primary     $OPENCODE_PRIMARY_AGENT  (explicit --agent passed by hw)"
    else
      agent_line="$agent_line
  primary     <none passed — opencode default_agent applies>"
    fi
  fi
  if [ "$KEEP_PANE" = 1 ]; then
    # MUTATION-ANCHOR: 37-M02
    chaining_line="enabled — leased for ${KEEP_PANE_SECONDS}s  (chosen by --keep-pane ${KEEP_PANE_FOR:-4h}; expiry closes the pane)
  chaining why  $KEEP_PANE_WHY"
    # MUTATION-ANCHOR-END: 37-M02
  else
    chaining_line="disabled  (default; a done report closes the owned pane, a --blocked one keeps it waiting)"
    # THE FIELD NAMES THE IRREVERSIBILITY, not just the setting — but only where
    # it is true. A placement that owns a tab or a workspace loses that container
    # on the proved report, and `HW_CHAINING_ENABLED` is baked into the
    # executor's environment at spawn, so nothing can turn it on afterwards.
    # `--here` owns no container (it writes neither .hw/<run>/tab nor
    # .hw/<run>/workspace), so its pane survives either way and this clause
    # would be a claim hw cannot support.
    [ "$HERE" = 1 ] || chaining_line="$chaining_line — ONE-WAY FROM HERE: HW_CHAINING_ENABLED is baked into the executor's environment at spawn, so \`hw next\` cannot re-task this pane afterwards"  # MUTATION-ANCHOR: 67-M04
  fi

  # THE PROVIDER, SPELLED OUT. opencode already refuses a bare alias and takes
  # `provider/model`, so the routing was never ambiguous — it was just folded
  # into the model string, and a brainer verifying "direct provider, not a
  # gateway" had to parse it out of one field. State it.
  # WORKTREE: own, reused, or none. `workdir` already carried the path, but not
  # whether it is a git worktree nor whether it ALREADY EXISTS. A new task landing
  # in a previous task's worktree inherits its branch and its uncommitted state,
  # and nothing downstream notices. Named here because the manifest runs before
  # the lane builds anything, so this is the last point where it is still free.
  local wt_line
  case "$(_lane_has_repo "$PROJ" && printf repo)" in
    repo)
      if [ "$WANT_WT" = 0 ]; then
        wt_line="none — a plain work directory, no branch, no ports, no database  ($WT_SRC)"
      elif [ -d "$dir" ] && [ ! -d "$dir/.git" ] && [ ! -f "$dir/.git" ]; then
        # A DIRECTORY THAT IS NOT A WORKTREE IS NOT A WORKTREE, and on setup
        # that is a state with real history on disk: every setup task before
        # 2026-09-16 left a plain `mkdir -p`'d directory at exactly the path
        # this lane's worktree now uses. `git worktree add` refuses a non-empty
        # directory, so hw reuses it as it is — and must say so, rather than
        # print a worktree that the task will not get.
        wt_line="$dir  (REUSED as a PLAIN DIRECTORY — it exists and is not a git worktree, so this task gets no branch and no isolation; that is what a pre-worktree $PROJ task left behind)"
      elif [ -d "$dir/.git" ] || [ -f "$dir/.git" ]; then
        # A REUSED worktree was built on whatever base its own launch chose, and
        # this dispatch cannot change it. Printing the base that WOULD have been
        # used would be a false field, so name the branch actually checked out.
        wt_line="$dir  (REUSED — it already exists, with whatever branch and uncommitted state it holds; HEAD is $(git -C "$dir" symbolic-ref --short HEAD 2>/dev/null || echo detached), and --base cannot rebase it)"
      else
        # THE BASE, NAMED WHERE IT IS STILL FREE TO CHANGE. Two consecutive
        # product-lane executors found their worktree built on the wrong
        # branch and fixed it themselves; the manifest said `new, own branch`
        # both times and nothing said off what.
        wt_line="$dir  (new, own branch off $(_lane_base_ref_prefix "$PROJ")$(_task_base))"
      fi
      ;;
    *) wt_line="none ($PROJ is repo-less: no worktree, no branch, no ports)" ;;
  esac

  # ITS OWN FIELD, not a parenthetical, because the base decides what a green
  # suite MEANS. A task measured against the wrong base reports green on a tree
  # that is not the one receiving the merge, and nothing downstream notices.
  local base_line
  if [ -z "$(_lane_base "$PROJ")" ] && [ -z "$BASE_OVERRIDE" ]; then
    base_line="none ($PROJ is repo-less)"
  elif [ "$WANT_WT" = 0 ]; then
    base_line="$(_lane_base_ref_prefix "$PROJ")$(_task_base)  ($BASE_SRC) — no worktree is built, so nothing is checked out from it"
  else
    base_line="$(_lane_base_ref_prefix "$PROJ")$(_task_base)  ($BASE_SRC)"
  fi

  # THE POLICY AND WHAT IT COSTS, in the manifest, because under `ask` the pane
  # stops on a prompt and says nothing to the brainer.
  local PERMISSIONS_LINE
  case "$AGENT:$PERMISSIONS" in
    claude:skip)   PERMISSIONS_LINE="skip  ($PERMISSIONS_SRC) — --dangerously-skip-permissions" ;;
    opencode:skip) PERMISSIONS_LINE="skip  ($PERMISSIONS_SRC) — --auto (identical to \`opencode-auto\`)" ;;
    codex:skip)    PERMISSIONS_LINE="skip  ($PERMISSIONS_SRC) — codex's own approval_policy applies; hw sets none" ;;
    claude:ask)    PERMISSIONS_LINE="ask  ($PERMISSIONS_SRC) — no skip flag; the executor WAITS on every permission dialog, and nothing answers it in an unattended pane" ;;
    opencode:ask)  PERMISSIONS_LINE="ask  ($PERMISSIONS_SRC) — no --auto; a prompt is reported blocked reason=permission, and a person has to answer it" ;;
    codex:ask)     PERMISSIONS_LINE="ask  ($PERMISSIONS_SRC) — -a on-request; the executor WAITS on an approval nobody answers in an unattended pane" ;;
  esac
  local provider_line
  case "$AGENT" in
    opencode)
      if [ -n "$MODEL" ]; then
        if [ "${MODEL_SRC:-chosen}" = chosen ]; then provider_line="${MODEL%%/*}  (direct, from --model)"
        else provider_line="${MODEL%%/*}  (direct, ${MODEL_SRC})"; fi
      else provider_line="<opencode default — no --model given>"; fi
      provider_line="$provider_line
  background  OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true (as \`opencode-auto\` sets it)
  endpoint    ${OPENCODE_AGENT_PORT:+http://127.0.0.1:}${OPENCODE_AGENT_PORT:-<not allocated>}  (this executor's own; \$HW_AGENT_ENDPOINT in its env)"
      [ -z "${OPENCODE_EXECUTOR_CONFIG:-}" ] || provider_line="$provider_line
  guard       $OPENCODE_EXECUTOR_CONFIG/plugin/deny-repo-writes.js  (OPENCODE_CONFIG_DIR, lane table: refuses writes into $PROJ's checkout)"
      ;;
    *) provider_line="n/a ($AGENT resolves its own)" ;;
  esac

  # THE RETURN CHANNEL, BEFORE ANYTHING IS BUILT. Resolving the invoker pane was
  # the one thing the manifest could not tell you: `_invoker_pane_init` used to
  # run from `_export_hw_env`, which a dry run never reaches, so UNRESOLVED —
  # the warning that says every executor launched here will finish with nowhere
  # to report — arrived only after the worktree, the tab and the agent existed.
  # On 2026-08-26 three executors paid for that. Resolution is a READ (one
  # `herdr pane list` plus a python filter, ~7ms, nothing created), so it is safe
  # here; and this is the same `_invoker_pane_init` every launch path calls, not
  # a dry-run copy of it, so the refusals and the warning text cannot drift.
  # A real launch is unaffected apart from ORDER: init is cached, so the warning
  # now prints above the manifest instead of below it.
  _invoker_pane_init
  local invoker_line
  if [ "$WANT_REPORT" = 0 ]; then
    invoker_line="DISABLED by --no-report — deliberate fire-and-forget; status will classify an unreported finished task"
  elif [ -n "$(_invoker_pane)" ]; then
    if [ "${REPORT_TO_CHOSEN:-0}" = 1 ]; then
      invoker_line="$(_invoker_pane)  (chosen by --report-to; foreign routing deliberately permitted)"
    else
      invoker_line="$(_invoker_pane)  (resolved by $(_invoker_how); verified as label=brain cwd=$BRAIN/$PROJ)"
    fi
  else
    invoker_line="UNRESOLVED — ask-invoker and done-invoker will refuse, so this executor could not report back"
  fi

  # ── the route, and the fields it makes untrue ─────────────────────────────
  #
  # ONE BUILDER FOR BOTH PATHS. Printing a second, reuse-shaped manifest
  # somewhere else would be two computations of one fact, which is precisely how
  # a later fix lands on one of them — this file's most repeated bug. So the
  # route is a field, and the three fields that describe CONSTRUCTION are
  # rewritten when nothing is going to be constructed.
  # `${HW_RUN:-}`, NOT `$HW_RUN`. On the reuse route this function is called
  # BEFORE the fresh path assigns HW_RUN, and hw runs under `set -u`, so the
  # bare form killed the reuse dispatch outright with "HW_RUN: unbound
  # variable". It survived a hand-run because the shell doing the running was
  # itself an hw executor and had HW_RUN exported — the exact environment
  # dependence 54-the-suite-is-environment-independent.sh exists to catch, and
  # the suite caught it. The reuse branch below overwrites this label anyway.
  local route_line run_label="${HW_RUN:-}"
  if [ "$DISPATCH_ROUTE" = reuse ]; then
    run_label="$(basename "$_REUSE_RUNDIR") (the reused session's run, not a new one)"
    route_line="REUSE — the brief goes to the LIVE executor on pane $_REUSE_PANE (prior task: ${_REUSE_TASK:-unknown}; $_REUSE_WHY)
              NOTHING IS BUILT: no worktree, no branch, no database, no ports, no pane. Its prior context and worktree carry into this task.
              Launch fresh instead with --fresh."
    placement="n/a — reuse adds no pane; the work lands in $_REUSE_PANE where it already is"
    db_line="n/a — reuse provisions nothing; this task uses whatever database that session already has"
    devserver_line="n/a — reuse starts nothing; this task uses whatever dev server that session already has (or lacks)"
    DEPS_LINE="n/a — reuse builds nothing; this task runs in $_REUSE_PANE's existing worktree and inherits whatever dependency contention already applies to it"
    wt_line="n/a — reuse creates none; this task inherits the reused session's worktree and its uncommitted state"
    base_line="n/a — the reused session's worktree was built on its own base at ITS launch; --base cannot change it from here"
    # --keep-pane is a launch-time decision baked into an executor's environment
    # at spawn, so it cannot reach a session that already exists. Saying
    # "disabled (default)" here would invite exactly the wrong conclusion.
    chaining_line="governed by the REUSED pane's own lease, baked at ITS launch — --keep-pane cannot change it from here"
    # THE ACCOUNT OF A LIVE SESSION IS A FACT OF ITS RUN, NOT OF THIS COMMAND.
    # CLAUDE_CONFIG_DIR is read by Claude Code at startup and baked into the
    # pane's environment at spawn, so `--account` cannot reach a session that
    # already exists. Printing this dispatch's resolution here would tell a
    # brainer the executor is somewhere it is not — the exact belief-versus-
    # reality failure the account field was added to remove. So it is MEASURED
    # from the reused run's own persisted environment instead.
    # MEASURED as a PLAIN global, not a `local`, for the same reason
    # `REUSE_MODEL`/`REUSE_EFFORT`/`REUSE_VENDOR` below are: the --account
    # refusal after this function returns reads the SAME measurement, so the
    # manifest and the refusal cannot describe one pane's account two ways.
    #
    # AND THE ABSENCE BRANCH IS SPLIT IN TWO. Until 2026-09-14 this was one
    # `else` asserting "no CLAUDE_CONFIG_DIR in <run>/env, so it runs under the
    # default account" for a file it may never have opened — `_run_env_value`
    # returns 1 both when the env record is unreadable and when the key is
    # merely absent, and `$(… || true)` collapsed the two. Reachable, not
    # theoretical: a candidate selected by a live chaining lease with no env
    # file at all printed exactly that sentence. `_reuse_account_field_line`
    # keeps the measured cases verbatim and gives the unmeasurable one its own
    # honest clause, the same shape `_reuse_model_field_line` already has.
    _reuse_measure_account
    ACCOUNT_LINE="$(_reuse_account_field_line)"
    # Tools are fixed at the session's launch like its account: whatever this
    # command resolved cannot reach the live pane.
    ARTIFACTS_LINE="the REUSED session's own, fixed at ITS launch — hw next cannot add or remove a tool"
    PERMISSIONS_LINE="the REUSED session's own, fixed at ITS launch — --permissions cannot change a live session"
    # MODEL, EFFORT AND AGENT GET THE SAME TREATMENT, and for the same reason:
    # `model_line`/`effort_line`/`agent_line` above were built from `$MODEL`/
    # `$EFFORT`/`$AGENT` — what THIS command asked for — and on the reuse
    # route none of the three can reach the live pane. Printing them unchanged
    # would repeat exactly the belief-versus-reality failure the account field
    # was fixed for: a refused reuse (see the refusals below, after this
    # function returns) used to still print `model=opus  (chosen)` on its way
    # to dying. MEASURED, not assumed for every value: `$REUSE_MODEL`,
    # `$REUSE_EFFORT` and `$REUSE_VENDOR` are set here as PLAIN globals (not
    # `local`) so the refusal checks below reuse the exact same measurement —
    # one read of the pane's truth, not two that could disagree.
    REUSE_MODEL="$(_next_dispatch_model "$_REUSE_RUNDIR")"
    REUSE_EFFORT="$(_next_dispatch_effort "$_REUSE_RUNDIR")"
    REUSE_VENDOR="$(herdr agent get "$_REUSE_PANE" 2>/dev/null | jq -r '.result.agent.agent // empty' 2>/dev/null || true)"
    # `model=`/`effort=` STAY THE LITERAL PREFIX (test 123 checks for it as
    # the field's own spelling, since — unlike `agent`/`account`/`worktree` —
    # neither has a separate label word in the manifest heredoc). The VALUE
    # after it is now `n/a`, never the requested model/effort: that pairing
    # is exactly the false claim this fix removes. The measured fact still
    # appears, just no longer under a label that makes it look chosen.
    model_line="$(_reuse_model_field_line)" # MUTATION-ANCHOR: 136-M08
    effort_line="$(_reuse_effort_field_line)"
    agent_line="$(_reuse_agent_field_line)"
  else
    route_line="fresh executor — a new one is built ($_REUSE_LINE)"
    # THE VOLATILITY IS PART OF THE CLAIM, not a footnote. Reuse discovery is a
    # read of live state: a candidate can appear between this dry run and the
    # launch, and then what runs is not what was read. That happened on
    # 2026-09-09 — a brainer asked for a new executor and the brief was about to
    # be delivered as task 3 into a closed audit's pane.
    # NOT under --fresh: there the route is BOUND, and repeating the warning
    # would train a reader to ignore it where it is true.
    if [ "$DISPATCH_DRY" = 1 ] && [ "${CHECK_REUSE:-1}" = 1 ]; then
      route_line="$route_line
              FROZEN by this dry run: still a read of live state, but if a reusable pane appears before you launch, the launch REFUSES and names the change rather than taking the other route. --fresh binds it without a dry run."
    fi
  fi

  # Only when declared, so every brief without a boundary dispatches with a
  # byte-identical manifest (the lane goldens hold that).
  local DESIGN_LINE=""
  if _design_gate_applies; then
    DESIGN_LINE="judged before code — boundary: $(_brief_boundary | cut -c1-96)  (done-invoker refuses done without an APPROVED design-judgment.md)"
  fi

  # Off the setup lane only, so a setup dispatch reads exactly as it did.
  local guard_line=""
  if _brain_guard_applies && ! _brain_guard_present; then
    guard_line="
  brain guard MISSING under $(_brain_guard_dir) — a launch refuses"
  elif _brain_guard_applies; then
    local why="(a product executor does not write in brain, work from it, or commit a path into it)"
    case "$AGENT" in
      claude)   guard_line="--plugin-dir $(_brain_guard_claude_plugin)  $why" ;;
      opencode) guard_line="OPENCODE_CONFIG=$(_brain_guard_opencode_config)  $why" ;;
      *)        guard_line="NOT APPLIED — $AGENT loads none, so nothing stops this executor writing in brain" ;;
    esac
    guard_line="
  brain guard $guard_line"
  fi

  DISPATCH_TEXT="$(cat <<EOF
dispatch $PROJ:$TASK  run=$run_label
  route       $route_line
  framework   ${live:-<undetermined>}  ($sdd_src, from $surface)
  $model_line${MODEL_FLOOR_LINE:+
  floor       $MODEL_FLOOR_LINE}
  $effort_line
  agent       $agent_line
  account     $ACCOUNT_LINE
  permissions $PERMISSIONS_LINE
  artifacts   $ARTIFACTS_LINE$guard_line
  provider    $provider_line
  placement   $placement
  database    $db_line
  dev server  $devserver_line
  dependencies $DEPS_LINE
  worktree    $wt_line
  base        $base_line
  brief       ${BRIEF:-<none>}
  contract    ${BRIEF_DECLARED:-none}  (which dispatch fields the brief declared, and hw verified)
  requested   $(_requested_line)
  authorizes  $(_authorizes_line)${DESIGN_LINE:+
  design      $DESIGN_LINE}
  verify      $verify_line
  entry       $entry_line
  workdir     $dir
  invoker     $invoker_line${SANDBOX_LINE:+
  sandbox     $SANDBOX_LINE}
  engram      $(_engram_label "$PROJ")  (the label of the lane, not of the brainer: --report-to routes reports, never memory; held by bin/engram-label-proxy via ${ENGRAM_PROXY_LINE:-nothing})
  chaining    $chaining_line
  reuse check $(_reuse_check_field)
EOF
)"

  if [ "$DISPATCH_DRY" = 1 ]; then step "0/3  dispatch (dry run)"; else step "0/3  dispatch"; fi
  printf '%s\n' "$DISPATCH_TEXT" | while IFS= read -r _l; do printf '  %s%s%s\n' "$C_DIM" "$_l" "$C_0"; done
  # BEFORE THE REUSE RETURN BELOW, because this is a fact about the BRIEF, not
  # about building an executor, and a re-tasked pane runs the same pinned
  # commands at its own close. Warn rather than refuse — a human may have a
  # reason to eat the timeout — but say it at the moment the fix is free.
  if [ "${VERIFY_FULL_SUITE:-0}" = 1 ]; then
    warn "this brief's verification names the full suite without HW_TEST_GATE=fast"
    warn "hw runs it itself at close, bounded at ${_VERIFY_TIMEOUT}s; the full suite is ~1000s, so it will exit 124 and read as a FAILED verification, not a slow one"
    warn "full-suite coverage is already mandatory at push (setup/hooks/pre-push). Fix the brief now — it is free until this launches: HW_TEST_GATE=fast bash setup/test-hw"
  fi
  # THE REUSE ROUTE PRINTS AND RETURNS. Everything below this line is a gate or
  # a warning about BUILDING an executor — the framework-inheritance refusal, the
  # review gate, the account refusal, the inherited-model and --keep-pane
  # warnings, the launch toast — and the reuse route builds nothing. `cmd_next`
  # owns that path's own gates (idle, task counter, delivery), and it is called
  # by the block that invoked this function.
  #
  # WHAT THIS DELIBERATELY DOES NOT DO, said out loud rather than left to be
  # discovered: it does not extend those refusals to the reuse route. Doing so
  # would change what `hw <lane> <task>` accepts, on a path several live
  # executors are dispatched through, and that was not what was asked for. It is
  # named work, not an oversight — `--sdd` inheritance in particular is refused
  # on the fresh route and merely inherited on this one.
  if [ "$DISPATCH_ROUTE" = reuse ] && [ "${SANDBOX:-0}" = 1 ]; then
    die "--sandbox is a property of a LAUNCH, and this dispatch would re-task the executor that is already running for $PROJ:$TASK — whatever it was launched with. Add --fresh to launch a sandboxed one. NOTHING was built."
  fi
  if [ "$DISPATCH_ROUTE" = reuse ]; then return 0; fi
  # AN UNPINNED PROVIDER IS A DECISION NOBODY MADE. The manifest already said
  # `<opencode default — no --model given>`; it read as a field, not as a
  # problem, and a product lane's decision names a specific model for a reason.
  if [ "$AGENT" = opencode ] && [ -z "$MODEL" ]; then
    warn "no --model given and $PROJ pins no provider, so this opencode executor gets whatever opencode defaults to"
    warn "pin it if the work depends on which model runs: --model <provider>/<model>"
  fi
  if [ "$SPACE_EXPLICIT" = 1 ]; then
    warn "--space selects the LEGACY placement model"
    warn "this task consumes a whole workspace instead of a tab in the project's $(project_space_label "$PROJ") space"
    warn "prefer --tab unless this task specifically requires a separate workspace"
  fi
  # FAIL CLOSED ON AN INHERITED FRAMEWORK. This used to be two warnings, and
  # twice — 2026-08-21 and 2026-08-24 — a brainer read them, decided not to
  # intervene, and said nothing about it in the brief. The shared rule already
  # required naming the choice; a warning that can be scrolled past is not a
  # requirement. So the launch stops until someone says which flow this task is
  # in, and the answer lands in the manifest above whichever way it goes.
  #
  # Only when the framework is actually in play: a repo-less or `setup` dispatch
  # running on the bare global mode has nothing to declare, and asking there
  # would train the reflex of passing a flag to make hw quiet.
  if [ -z "$SDD" ] && [ "$in_play" = 1 ]; then
    warn "framework mode would be INHERITED from the directory, not chosen for this task"
    warn "the brief must name the flow and why — the executor cannot guess it"
    die "say which: --sdd speckit | none (none = outside the flow, for read-only or operational work; hw then forces no entry command)"
  fi

  # REFUSE A FLOW THAT IS NOT ON DISK, before the worktree, the database, the
  # ports and the pane exist. An executor whose first instruction is a skill
  # that is not installed is worse than one with no brief. Asked about the
  # surface the task runs under; `_apply_sdd` checks the built directory again.
  if [ "$SDD" = speckit ] && ! _speckit_on_disk "$surface" >/dev/null; then
    die "--sdd speckit REFUSED BEFORE BUILDING ANYTHING: no speckit-* skill is on disk under $surface/.claude/skills or $HOME/.claude/skills. Nothing was built. Install Spec Kit where it is used, or dispatch with --sdd none."
  fi

  # REFUSE AN ACCOUNT WHOSE PARITY COULD NOT BE ESTABLISHED. Measured before the
  # build, named, and unfixable by retrying. The alternative is the August failure in a new place — a redirect
  # into a config directory stripped of the skills and policies the brief will
  # order the executor to use, announced nowhere, visible only as an agent that
  # behaves worse.
  if [ "$ACCOUNT_VERDICT" = refused ]; then
    warn "$ACCOUNT_REFUSAL"
    die "account '$ACCOUNT' was selected ($ACCOUNT_SRC) and hw could not establish it. Nothing was built. Fix what the line above names, or dispatch under the default account with --account default."
  fi
  # A SELECTED ACCOUNT THAT CANNOT APPLY IS SAID OUT LOUD, not refused. A product lane's
  # lane default is opencode, so this is the ORDINARY product-lane dispatch — refusing
  # it would block the lane, and staying quiet would let the brief claim an
  # account the executor does not have.
  if [ "$ACCOUNT" != default ] && [ "$ACCOUNT_APPLIES" = 0 ] && [ "$AGENT" != claude ]; then
    warn "account '$ACCOUNT' does NOT apply to a $AGENT executor — only Claude Code reads CLAUDE_CONFIG_DIR"
    warn "this executor runs under whatever account $AGENT is signed into. If the account matters, launch it with --agent claude."
  fi
  # AN ACCOUNT WHOSE FIRST RUN IS NOT DONE IS SAID BEFORE ANYTHING IS BUILT. The
  # executor is unattended, so the welcome or the Bypass Permissions warning
  # would hold it until `_agent_start` gives up. Warned, not refused: the
  # dialog check at start is what stops the launch, and it reads the screen
  # rather than two config keys a future Claude Code may store elsewhere.
  if [ "$AGENT" = claude ] && [ "$ACCOUNT_VERDICT" != refused ]; then
    local first_run
    first_run="$(claude_first_run_pending "$ACCOUNT_CONFIG_DIR" | tr '\n' ' ')"
    if [ -n "$first_run" ]; then
      warn "Claude Code's first run is not finished in this account (${first_run% }) — this executor will stop on it, and finishing it is yours:"
      warn "  run once in a terminal: $(claude_first_run_command "$ACCOUNT_CONFIG_DIR")  — finish the welcome and login, accept the Bypass Permissions warning, /exit"
    fi
  fi

  # WHY A FRAMEWORK WANTS OPUS. Under speckit the session hw launches is not
  # the thing doing the work — it is the ORCHESTRATOR, and the phase agents pin
  # their own models regardless of --model (speckit-implementer and
  # speckit-verifier are sonnet). So --model buys
  # exactly one thing: the quality of the judgment that sequences phases,
  # partitions work and decides whether to believe a subagent's report.
  #
  # speckit says it outright in its own skill: "you run step 6 as an
  # orchestrator with delegated writers… you keep the judgment; cheaper
  # subagents do the typing", and "specify, plan and tasks are not delegated —
  # they are open-design work and belong to the orchestrating model". That is
  # the work a sonnet orchestrator does worst.
  #
  # A suggestion, not a default: changing the model silently would be the same
  # invisible decision this whole block exists to expose.
  # ONLY WHEN THE MODEL WAS NOT CHOSEN. This block exists to expose an INVISIBLE
  # decision; against a visible one it is just hw arguing with the user. A
  # brainer once listed "following hw model suggestions over an explicit
  # user choice" among the errors it had to rule out — the operator had named
  # an explicit model and hw suggested a different one anyway. A suggestion
  # that overrides an explicit flag is a defect, not advice.
  if [ "$in_play" = 1 ] && [ -z "$MODEL" ]; then
  case "${live%% *}" in
    speckit)
      if [ "$MODEL" != opus ]; then
        warn "framework is ${live%% *} — this session is the ORCHESTRATOR, not the worker"
        warn "the phase agents pin their own models; --model only sets the judgment that"
        warn "sequences them. opus is suggested here: --model opus --effort medium"
      elif [ -z "$EFFORT" ] || [ "$EFFORT" = low ]; then
        warn "opus with effort=${EFFORT:-<default>} for an orchestrating run — medium is suggested"
      fi
      ;;
  esac
  fi
  # AN INHERITED MODEL IS A DEFAULT NOBODY NAMED. A fresh claude launch now gets
  # sonnet/opus from _apply_model_default; what still inherits the account's
  # default is a launch under speckit (its orchestrator may not be sonnet), so
  # that is the only case this says anything about.
  if [ -z "$MODEL" ] && [ "$AGENT" = claude ] && [ -z "${_REUSE_PANE:-}" ]; then
    warn "no --model under --sdd ${SDD_EFFECTIVE_MODE:-?}: this inherits claude's account default,"
    warn "not sonnet — an orchestrator may not be sonnet. --model opus --effort medium names it."
  fi
  # CHAINING IS A DOOR THAT CLOSES AT THIS INSTANT, AND IT SAID SO AS A FIELD.
  #
  # `HW_CHAINING_ENABLED` is baked into the executor's environment at spawn and
  # read environment-first (invoker-common.sh), so it cannot be turned on later.
  # `hw next` is the only route that re-tasks an executor, and it needs the pane
  # that was launched to close to still be there. On 2026-09-02 three executors
  # were dispatched without --keep-pane; legitimate new scope appeared for one of
  # them and there was no route left. The cost is not tokens — it is everything
  # that session had already learned about the repo.
  #
  # SAME SHAPE AS THE INHERITED-MODEL WARNING ABOVE, and for the same stated
  # reason: a default nobody named is a decision nobody made. So this follows it
  # rather than inventing a mechanism — the manifest names the field, the warning
  # names what it costs, and the launch proceeds either way.
  #
  # NOT A REFUSAL AND NOT A NEW DEFAULT. Closing is still the right default: a
  # retained pane with no named holder is exactly the leak `--why` exists to
  # stop. What was missing is that the decision be VISIBLE while it is still
  # free, which is now, before anything is built.
  #
  # GATED ON AN OWNED CONTAINER, because that is the only place the claim is
  # true. `--here` writes neither `.hw/<run>/tab` nor `.hw/<run>/workspace`, so
  # nothing closes on its report and the pane survives regardless; warning there
  # would be a claim this tool cannot support. `--no-report` is already refused
  # in combination with --keep-pane, so chaining is not reachable there either.
  # MUTATION-ANCHOR: 67-M05
  if [ "$KEEP_PANE" = 0 ] && [ "$WANT_REPORT" = 1 ] && [ "$HERE" = 0 ]; then  # MUTATION-ANCHOR: 67-M01
    warn "no --keep-pane: this executor's pane CLOSES on its proved report, and that is IRREVERSIBLE"
  # MUTATION-ANCHOR-END: 67-M05
    warn "HW_CHAINING_ENABLED is baked in at spawn — it cannot be turned on afterwards, so"  # MUTATION-ANCHOR: 67-M02
    warn "\`hw next\` will have no pane to re-task and new scope means a fresh session that"
    warn "has learned nothing about this repo. Decide it NOW, while it is still free:"
    warn "  --keep-pane [4h] --why \"<who or what will re-task it>\""  # MUTATION-ANCHOR: 67-M03
  fi
  # THE BRIEF IS THE CONTRACT AND ITS NAME IS HOW YOU FIND IT AGAIN. An explicit
  # --brief pointing at another task's file is legal and occasionally right, but
  # it also happens by copy-paste, and then the executor works from one task's
  # contract under another task's name — the run directory, the worktree, the
  # branch and the engram label all say one thing and the brief says another.
  # Offered as a guard on 2026-08-22 and never wired; it costs one line.
  if [ -n "$BRIEF" ]; then
    local _bb; _bb="$(basename "$BRIEF" .md)"
    if [ "$_bb" != "$TASK" ]; then
      warn "the brief is named '$_bb' but the task is '$TASK' — deliberate, or a copy-paste?"
      warn "everything else (worktree, branch, engram, hw done) will say '$TASK'"
    fi
  fi
  # THE WARNING IS NOW ABOUT A COMMAND, NOT A HEADING. The old one fired on the
  # absence of a section and stayed quiet for a brief that had one full of
  # prose — which is every brief that then got a report claiming a green nobody
  # produced. A section hw cannot execute buys exactly as much as no section.
  if [ -z "$verify_cmds" ] && [ -n "$BRIEF" ]; then
    warn "nothing in this brief can be RUN to verify the work: hw will measure nothing at close"
    warn "put the command in a fenced block under Testing/Verification and hw runs it in hw done"
  fi

  if [ "$DISPATCH_DRY" = 1 ]; then
    # THE ROUTE THIS DRY RUN PRINTED IS NOW BINDING. It used to say the field
    # was volatile and leave it there, which told the reader their decision did
    # not hold and offered nothing to do about it.
    # NOT UNDER --fresh. Both blind judges caught this: with `--fresh`,
    # `_check_reusable_executor` returns before looking at anything, so "fresh"
    # here was FORCED, never resolved from live discovery. Recording it would let
    # a later ordinary launch be refused over a route nothing ever measured —
    # and this field's whole claim is that it reports what discovery resolved.
    # The stale record is DROPPED instead, which is what `--fresh` already means
    # on a real launch: the brainer decided again, in the open.
    if [ "${CHECK_REUSE:-1}" != 1 ]; then
      _route_forecast_drop "$PROJ" "$TASK"
      info "route BOUND as fresh by ${FRESH_SOURCE:---fresh} itself; nothing was recorded to bind a later launch, and any earlier forecast for $PROJ:$TASK was dropped"
    else
      _rf="$(_route_forecast_write "$PROJ" "$TASK" fresh "$_REUSE_LINE")"
      [ -z "$_rf" ] || info "route FROZEN as fresh for the next $HW_ROUTE_FORECAST_TTL s ($_rf). If a reusable pane appears before you launch, the launch REFUSES and names the change instead of switching routes."
    fi
    # THE PINNED PREFIX IS LOAD-BEARING: seven other subject files key on the
    # exact substring "dry run — nothing created" (49, 64, 67, 75, 124, 130,
    # 140). Rewording the head of this line to disclose the forecast broke all
    # of them for a cosmetic gain — a blast radius this change never needed.
    # The qualifier is appended instead, so the claim stays honest (the
    # forecast IS named, on its own line immediately above) and nothing
    # unrelated has to move.
    ok "dry run — nothing created, no agent started (except the route forecast named above)"
    exit 0
  fi

  # Straight to the operator, not through the brainer. Same reasoning as
  # done-invoker's toast: they learn the dispatch shape even if the brainer
  # never mentions it.
  herdr notification show "dispatch $PROJ:$TASK" \
    --body "framework ${live:-?} ($sdd_src) · model ${MODEL:-default} · verify ${verify_cmds:+$(printf '%s' "$verify_cmds" | head -1)}${verify_cmds:-none}" \
    >/dev/null 2>&1 || true
  return 0
}

# BEFORE anything is built — same discipline as _check_brief_contract above.
# A launch that reaches worktree/db/pane construction has already spent
# everything this check exists to save.
if [ -n "$_REUSE_PANE" ]; then
  # THE MANIFEST FIRST, ON THIS PATH TOO. This block used to run to `exit 0`
  # without the manifest ever being assembled, so a dry run that found a
  # reusable pane printed no framework, no model, no worktree and no account —
  # only the warning below. A reader cannot tell "hw did not print it" from "hw
  # would not do it", and on 2026-09-09 a brainer verifying --account read the
  # missing account line as the feature being broken.
  #
  # `_dispatch_manifest` is route-aware (see DISPATCH_ROUTE) and returns
  # immediately after printing on this path, so no fresh-launch gate fires here.
  # The workdir is the REUSED session's, derived from its run directory, because
  # that is where this task will actually run.
  DISPATCH_ROUTE=reuse
  _dispatch_manifest "$(dirname "$(dirname "$_REUSE_RUNDIR")")"  # MUTATION-ANCHOR: 123-M01

  # ── SESSION FLAGS THAT CANNOT REACH A LIVE PANE ARE REFUSED, NOT ECHOED ────
  #
  # MEASURED, relayed by a product-lane brainer: an `hw <lane> <task>
  # --sdd none --model opus --keep-pane 3h ...` dispatch took the reuse
  # route onto a pane spawned hours earlier with `--model sonnet`. The model is
  # fixed at spawn; `--model opus` was silently discarded and a pure-judgment
  # task — the worst place for the cheapest model — ran on sonnet. The brainer
  # reported opus to the operator; they caught the mismatch reading the
  # transcript, not from anything hw said.
  #
  # `_dispatch_manifest`'s reuse branch already gets this right for --account:
  # ACCOUNT_LINE says "cannot change a live session" instead of echoing the
  # requested account as fact — exactly the belief-versus-reality class that
  # field was added to remove (see its own comment). But it only ANNOTATES; it
  # never stops the launch. For a flag with NO equivalent on `cmd_next` — the
  # function this route hands the brief to — that is not enough: verified by
  # reading its option loop (--brief, --force, --dry-run, --wait-ms, --sdd,
  # nothing else), the flag is not merely ignored on THIS task, it
  # is unreachable on every task this pane will ever run until it closes.
  #
  # `--model`, `--agent` and `--effort` are all in this class, VERIFIED rather
  # than assumed: each becomes a CLI flag baked into the vendor process at
  # spawn (`AGENT_ARGS`), none has a `cmd_next` equivalent, and `_reuse_args`
  # below forwards neither of the three. `--sdd` is deliberately NOT in this
  # refusal: `cmd_next` DOES accept it, and it DOES reach the reused pane via
  # `_reuse_args`.
  #
  # THE MEASURED VALUE IS NAMED, NEVER ASSUMED. A launch record predating a
  # field, or one that recorded no explicit choice, says so honestly instead
  # of printing a value nobody chose or refusing on an absence of evidence
  # (the discipline `_validate_sdd_model_pair` already applies to legacy runs).
  #
  # NOT WHEN THIS IS THE CODEX SDD HANDOFF. `_validate_sdd_vendor_pair` refuses
  # a FRESH codex launch under `--sdd speckit` outright (codex has
  # no demonstrated native entry); the reuse route is the one door that lets a
  # codex-requested SDD flow succeed anyway, by handing the brief to a live
  # claude/opencode pane instead (75-codex-framework-refusal.sh owns this and
  # asserts the handoff succeeds). `--agent codex --model gpt-5.3-codex` never
  # meant "run this exact model on the destination pane" in that flow — codex
  # model names are not valid values for another vendor to begin with — so
  # refusing them here would break the one mechanism that makes the request
  # succeed at all, for a mismatch the caller never intended literally. An
  # ordinary reuse (no codex+SDD handoff in play) still refuses both below.
  # THE CARVE-OUT KEYS ON THE EFFECTIVE MODE, NOT THE TYPED --sdd. `$SDD` is
  # empty whenever the mode is INHERITED rather than typed on this command —
  # exactly the precedence 75-codex-framework-refusal.sh spends half its
  # length proving (measured live surface, launch record as fallback) — so a
  # handoff whose mode arrived by inheritance had `SDD=""`, never matched the
  # `case` below, and would have been refused anyway. `_resolve_effective_sdd_mode`
  # is the SAME resolver `_validate_sdd_vendor_pair` uses, called WITHOUT the
  # vendor gate that resolver also runs — that gate is what codex+speckit
  # dies on for a FRESH launch, and dying here would defeat the
  # very handoff this carve-out exists to let through.
  # RESOLVED ONLY WHEN IT CAN MATTER. `_resolve_effective_sdd_mode` falls
  # through to a read of the surface on disk (formerly a subprocess) whenever `--sdd` was not
  # typed (see its own comment), and running that unconditionally would pay a
  # process spawn on every reuse dispatch, including one naming none of the
  # three session flags — for a carve-out nothing on that path could ever
  # activate. MEASURED 2026-09-11 (third review), 20-run averages of a plain
  # `--no-report --dry-run` reuse dispatch with no `--sdd` typed: ~0.208s
  # guarded, ~0.231s unconditional — about 23ms per dispatch, one avoided
  # `python3` spawn. (This file's earlier claim of "2.1s to 5.3s" cited this
  # test's OWN budget classification, which had in fact gone the other way,
  # 5.32s to 7.72s, from the mutants added in the same commit — not from this
  # guard. Corrected here to a number actually measured against this change.)
  # None of `_reuse_codex_handoff`, `$SDD_EFFECTIVE_MODE`, or the surface it
  # is resolved against are read anywhere the three flag blocks below do not
  # already gate on `MODEL_SRC`/`AGENT_SRC`/`EFFORT` themselves.
  _reuse_codex_handoff=0
  if [ "${MODEL_SRC:-}" = chosen ] || [ "${AGENT_SRC:-}" = chosen ] || [ -n "$EFFORT" ]; then
    if _lane_is_product_repo "$PROJ"; then _reuse_handoff_surface="$(_surface_dir)"
    else _reuse_handoff_surface="$(dirname "$(dirname "$_REUSE_RUNDIR")")"; fi
    _resolve_effective_sdd_mode "$SDD" "$_reuse_handoff_surface" "$(_run_dispatch_framework "$_REUSE_RUNDIR")"
    # AND ON `AGENT_SRC`, NOT ON THE BARE VALUE OF `$AGENT`. A lane whose
    # DEFAULT vendor happens to be codex (none is, today — verified by
    # reading every `case "$PROJ" in ... AGENT=...` assignment) would
    # otherwise silence this refusal for --model on EVERY speckit
    # reuse dispatch in that lane, for nobody's request. Requiring `chosen`
    # means the carve-out only ever fires for an EXPLICIT `--agent codex`,
    # regardless of what any lane table does in the future.
    # MUTATION-ANCHOR: 136-M04
    if [ "${AGENT_SRC:-}" = chosen ]; then
      case "$AGENT:$SDD_EFFECTIVE_MODE" in # MUTATION-ANCHOR: 136-M03
        codex:speckit) _reuse_codex_handoff=1 ;;
      esac
    fi
    # MUTATION-ANCHOR-END: 136-M04
  fi
  if [ "${MODEL_SRC:-}" = chosen ] && [ "$_reuse_codex_handoff" = 0 ]; then # MUTATION-ANCHOR: 136-M01
    _reuse_flag_decision "$MODEL" "$REUSE_MODEL"
    case "$_REUSE_FLAG_VERDICT" in
      match) : ;; # already true on the live pane; nothing this flag would change
      unmeasurable)
        die "--model $MODEL REFUSED on the REUSE route: pane $_REUSE_PANE's current model could not be measured ($(_reuse_dispatch_absence_reason model)), and --model cannot reach a live session regardless. Nothing was sent. Launch a fresh executor with that model instead: add --fresh to this command."
        ;;
      mismatch)
        die "--model $MODEL REFUSED on the REUSE route: pane $_REUSE_PANE is already running with $(_reuse_measured_desc "$REUSE_MODEL" --model), fixed at ITS launch — --model cannot reach a live session. Nothing was sent. Launch a fresh executor with that model instead: add --fresh to this command."
        ;;
    esac
  fi
  if [ "${AGENT_SRC:-}" = chosen ] && [ "$_reuse_codex_handoff" = 0 ]; then # MUTATION-ANCHOR: 136-M05
    _reuse_flag_decision "$AGENT" "$REUSE_VENDOR"
    case "$_REUSE_FLAG_VERDICT" in
      match) : ;;
      unmeasurable)
        die "--agent $AGENT REFUSED on the REUSE route: pane $_REUSE_PANE's current vendor could not be measured (herdr reports no vendor for $_REUSE_PANE), and --agent cannot reach a live session regardless. Nothing was sent. Launch a fresh executor with that vendor instead: add --fresh to this command."
        ;;
      mismatch)
        die "--agent $AGENT REFUSED on the REUSE route: pane $_REUSE_PANE is already running $(_reuse_measured_desc "$REUSE_VENDOR" --agent), fixed at ITS launch — --agent selects which vendor process to start, and there is no live process left to select. Nothing was sent. Launch a fresh executor with that vendor instead: add --fresh to this command."
        ;;
    esac
  fi
  # THE CARVE-OUT COVERS ALL THREE, not just the two the handoff test happens
  # to pass. `--effort` is baked into the vendor process at spawn the same way
  # `--model` is, and the handoff succeeds for the SAME reason: the effort a
  # codex request named was never a claim about what the destination pane's
  # effort would be either.
  if [ -n "$EFFORT" ] && [ "$_reuse_codex_handoff" = 0 ]; then # MUTATION-ANCHOR: 136-M06
    _reuse_flag_decision "$EFFORT" "$REUSE_EFFORT"
    case "$_REUSE_FLAG_VERDICT" in
      match) : ;;
      unmeasurable)
        die "--effort $EFFORT REFUSED on the REUSE route: pane $_REUSE_PANE's current effort could not be measured ($(_reuse_dispatch_absence_reason effort)), and --effort cannot reach a live session regardless. Nothing was sent. Launch a fresh executor with that effort instead: add --fresh to this command."
        ;;
      mismatch)
        die "--effort $EFFORT REFUSED on the REUSE route: pane $_REUSE_PANE is already running with $(_reuse_measured_desc "$REUSE_EFFORT" --effort), fixed at ITS launch — --effort is baked into the vendor process at spawn the same way --model is. Nothing was sent. Launch a fresh executor with that effort instead: add --fresh to this command."
        ;;
    esac
  fi

  # ── AND THE FOURTH, --account, WHICH WAS LEFT OUT ──────────────────────────
  #
  # The three refusals above landed on 2026-09-11 and left `--account` behind:
  # the manifest reported it honestly ("cannot change a live session") and the
  # dispatch carried on, so the one flag that already KNEW it was inert was the
  # only one that did not stop. CLAUDE_CONFIG_DIR is read by Claude Code once at
  # startup and baked into the pane's environment at spawn, `cmd_next` has no
  # --account of its own (same option loop the comment above audited), and
  # `_reuse_args` does not forward it — so it is unreachable on every task that
  # pane will run until it closes, exactly like the other three.
  #
  # ONLY WHEN THE FLAG WAS CHOSEN. `$ACCOUNT` always holds a value — the lane
  # table's default when nothing was typed — so refusing on the value would
  # refuse the ordinary dispatch of every lane whose default is not `default`.
  # `ACCOUNT_SRC` is `chosen` only when `--account` was actually passed.
  #
  # NO CODEX CARVE-OUT, and this is a decision rather than an omission. The
  # carve-out above exists because `--agent codex --model gpt-5.3-codex` never
  # literally meant "run that model on the destination pane" — a codex model
  # name is not a valid value for another vendor, so refusing it would break the
  # one mechanism that lets a codex-requested SDD flow succeed. `--account` has
  # neither property. `default`/`personal` are vendor-neutral names, so the
  # request IS literal — a claim about the DESTINATION pane, whatever vendor
  # that turns out to be. And it is not known to be codex: `_check_reusable_executor`
  # selects on the lane token plus reportedness and applies NO vendor filter, so
  # the pane it picked may be claude, opencode or codex. (An earlier draft of
  # this comment asserted "never codex" and was wrong; both judges caught it.)
  # That is exactly why "codex does not read CLAUDE_CONFIG_DIR" cannot settle
  # this: it is a fact about the REQUESTED vendor, and the vendor that matters
  # is the measured one — which the vendor clause below names from
  # `$REUSE_VENDOR`, codex included. Nor is the flag load-bearing for the
  # handoff: dropping `--account`
  # costs one token and the handoff still succeeds, where dropping `--model` or
  # `--agent` changes what was requested. So a codex SDD handoff that ALSO types
  # `--account` is refused, and the exit it is given is the cheap one.
  #
  # `_reuse_flag_decision` IS DELIBERATELY NOT REUSED. It classifies an empty
  # measured value as `unmeasurable`, and for this flag an empty value is the
  # opposite — a positive measurement that the pane runs under the default
  # account (see `_reuse_measure_account`). Feeding it here would invert both
  # branches at once.
  if [ "${ACCOUNT_SRC:-}" = chosen ]; then # MUTATION-ANCHOR: 136-M09 # MUTATION-ANCHOR: 136-M10 # MUTATION-ANCHOR: 136-M13
    # THE VENDOR FACT AND THE ROUTE FACT ARE TWO DIFFERENT THINGS, and a reader
    # of a refusal needs to know which one stopped them. The route makes the
    # flag unreachable on THIS pane; a non-claude vendor makes it inapplicable
    # even on a fresh launch under that vendor, which changes what the exit is
    # worth. An unmeasured vendor asserts neither.
    _reuse_account_vendor_clause=""
    case "$REUSE_VENDOR" in
      ''|claude) : ;;
      *) _reuse_account_vendor_clause=" AND SEPARATELY, BY VENDOR: that pane is running $REUSE_VENDOR, which does not read CLAUDE_CONFIG_DIR at all, so no account would reach it even on a fresh launch under that vendor — a fresh launch under this account needs --agent claude as well." ;;
    esac
    # An unknown name has nothing to compare against, and on this route the
    # fresh-launch gate that would have caught it (`ACCOUNT_VERDICT`) never
    # runs — `_dispatch_manifest` returns before it. Caught here instead of
    # silently resolving to the empty config dir, which would read as a match
    # against a default-account pane.
    if ! _reuse_account_want="$(account_config_dir "$ACCOUNT" 2>/dev/null)"; then
      die "--account $ACCOUNT REFUSED on the REUSE route: '$ACCOUNT' is not an account hw knows (known: default, personal), so there is nothing to compare against pane $_REUSE_PANE. Nothing was sent. Name a known account, or drop --account to hand this task to the pane as it already is."
    fi
    if [ "$REUSE_ACCOUNT_MEASURED" = 0 ]; then
      die "--account $ACCOUNT REFUSED on the REUSE route: pane $_REUSE_PANE's current account could not be measured ($(_reuse_account_absence_reason)), and --account cannot reach a live session regardless.$_reuse_account_vendor_clause Nothing was sent. Drop --account to hand this task to the pane as it already is, or launch a fresh executor under that account: add --fresh to this command."
    elif [ "$_reuse_account_want" != "$REUSE_ACCOUNT_CFG" ]; then
      die "--account $ACCOUNT REFUSED on the REUSE route: pane $_REUSE_PANE is already running under $(_reuse_account_desc "$REUSE_ACCOUNT_CFG"), baked into its environment at ITS launch — Claude Code reads CLAUDE_CONFIG_DIR once at startup, so --account cannot reach a live session.$_reuse_account_vendor_clause Nothing was sent. Drop --account to hand this task to the pane as it already is, or launch a fresh executor under that account: add --fresh to this command."
    fi
  fi

  _reuse_args=("$_REUSE_PANE")
  if [ -n "$BRIEF" ]; then _reuse_args+=(--brief "$BRIEF"); else _reuse_args+=("$TASK"); fi
  [ -z "$SDD" ] || _reuse_args+=(--sdd "$SDD")
  # The automatic reuse route below IS cmd_next (see the call a few lines
  # down), so an override given to the outer launch has to be forwarded here
  # explicitly — cmd_next parses its own argv and never sees the outer one —
  # or _refuse_if_stale_hooks refuses on a live pane the brainer explicitly
  # said to launch onto anyway.
  [ "${ALLOW_STALE_HOOKS:-0}" != 1 ] || _reuse_args+=(--allow-stale-hooks)
  [ "$DISPATCH_DRY" != 1 ] || _reuse_args+=(--dry-run)
  warn "REUSE WARNING: automatic launch-time reuse selected pane $_REUSE_PANE; its prior task is ${_REUSE_TASK:-unknown}."  # MUTATION-ANCHOR: 71-M04
  warn "That pane's prior context and worktree carry into this task. Use --fresh to launch without them."
  if [ "$_REUSE_WHY" = "reported, chaining lease live" ]; then
    warn "Its persisted chaining lease reason: ${_REUSE_LEASE_REASON:-<not recorded>}"
  fi
  if [ "$DISPATCH_DRY" = 1 ]; then
    _rf="$(_route_forecast_write "$PROJ" "$TASK" reuse "$_REUSE_LINE")"
    [ -z "$_rf" ] || info "route FROZEN as REUSE of $_REUSE_PANE for the next $HW_ROUTE_FORECAST_TTL s ($_rf). If that lease expires or the pane goes before you launch, the launch REFUSES and names the change instead of quietly building a fresh executor."
  fi
  cmd_next "${_reuse_args[@]}"
  _reuse_seq="$(tr -dc '0-9' < "$_REUSE_RUNDIR/task" 2>/dev/null || true)"
  case "$_reuse_seq" in ''|0) _reuse_seq=1 ;; esac
  if [ "$DISPATCH_DRY" = 1 ]; then
    _reuse_seq=$((_reuse_seq + 1))
    ok "would reuse pane $_REUSE_PANE as task $_reuse_seq; no new executor would be built, and this session keeps its prior $PROJ lane context ($_REUSE_WHY)"
  else
    ok "reused pane $_REUSE_PANE as task $_reuse_seq; no new executor was built, and this session keeps its prior $PROJ lane context ($_REUSE_WHY)"
  fi
  exit 0
fi

# ── credential preflight ────────────────────────────────────────────────────
#
# Before the worktree, the ports, the install and the space: a task whose brief
# names a handle that does not resolve is a task with a human step inside it,
# and the cheapest moment to learn that is now rather than five minutes in, from
# a blocked executor. Only presence is checked; no value is ever read.
if [ -n "$BRIEF" ] && [ "$CHECK_HANDLES" = 1 ] && ! _keychain_available; then
  # Nothing to ask: skip the check rather than refuse every brief that names a handle.
  if [ -n "$(_brief_handles "$BRIEF")" ]; then
    _no_keychain_message
    warn "the brief's handles were NOT checked; the executor may block on one"
  fi
elif [ -n "$BRIEF" ] && [ "$CHECK_HANDLES" = 1 ]; then
  HANDLES_MISSING=""
  HANDLES_SEEN=0
  while IFS= read -r _h; do
    [ -n "$_h" ] || continue
    HANDLES_SEEN=$((HANDLES_SEEN + 1))
    _handle_exists "$_h" || HANDLES_MISSING="$HANDLES_MISSING $_h"
  done < <(_brief_handles "$BRIEF")
  if [ -n "$HANDLES_MISSING" ]; then
    warn "the brief names credential handles that do not resolve:$HANDLES_MISSING"
    warn "store each one:  security add-generic-password -s <handle> -a ${USER:-$(id -un)} -w '<value>'"
    warn "then re-run. Check a handle any time with: hw handle <handle>"
    die "not launching $PROJ:$TASK — the executor would be blocked on this. Override with --no-handle-check if the handle is about to exist or that line is an example."
  fi
  # if/else, not `[ … ] && info …`: this is the last command in the block, so a
  # false test would be the block's exit status and `set -e` would kill hw here
  # with no message — the sixth instance of the bug class this repo keeps
  # writing, avoided by writing it the other way round.
  if [ "$HANDLES_SEEN" -gt 0 ]; then
    info "credential handles in the brief: $HANDLES_SEEN, all present (presence only, no value read)"
  fi
fi

LABEL="$PROJ:$TASK"
BRANCH="$(_lane_branch "$PROJ" "$TASK")"

# One id per launch. ask-invoker's cap and done-invoker's once-only marker hang
# off this, not off the directory: a repo-less work directory is deliberately
# kept by `hw done` and reused by the next run, so directory-keyed state made a
# fresh executor start at the ask cap and unable to report done at all.
HW_RUN="$(date +%Y%m%d-%H%M%S)-$$"

# The manifest goes here and not earlier: it names the run id, and HW_RUN is
# assigned on the line above. Still before any lane creates a directory, a
# worktree or a space, so what gets announced is what was asked for.
_dispatch_manifest "$(_intended_workdir)"
export HW_RUN

# ── --here: one pane beside this one, instead of a space ────────────────────
# The default is a space per task, because that is what keeps tasks separable:
# `hw done` closes a space, and a space carries its own dev-server panes.
# --here trades that away for immediacy — the agent appears next to you, in the
# space you are already looking at.
#
# What you give up, stated once so it is not a surprise later:
#   · no dev servers — there is no layout to put them in
#   · `hw done` cannot clean this up. `pane rename` sets a DISPLAY label only
#     (pane list still reports title:null), so there is no way to find this pane
#     again by name. hw prints its id; closing it is yours.
_rightmost_pane_in_tab() {
  # The pane with the largest x in the brainer's tab. Splitting THAT instead of
  # the brainer's own pane is the whole fix for a shrinking brainer.
  #
  # `--here` used to split $HERDR_PANE_ID every time, so the brainer paid for
  # every executor: 1 → 50/50, 2 → brainer 25 / e2 25 / e1 50, 3 → brainer 12.5,
  # measured. The pane being squeezed was the one the human reads. Splitting
  # rightmost keeps the brainer's width no matter how many executors are added,
  # because its pane is never split again.
  #
  # Through the CLI, which is where the `.result` wrapper below comes from.
  #
  # CORRECTED 2026-08-24. This comment used to say the same `pane.layout` request
  # sent raw over the socket "came back with an EMPTY panes list". It does not:
  # the socket returns the full tree and honours pane_id (wB:p1 → 2, wC:p1 → 1).
  # The empty array was OUR jq path — a raw reply is `{"type":…,"layout":…}` with
  # no `.result` wrapper, so `.result.layout.panes` reads nothing and reports it
  # as an empty list rather than an error. See README §6.
  #
  # The CLI is still the right call here, for the ordinary reason: one envelope,
  # already parsed, and this file should not be a second place that knows the
  # wire format. `pane.split` stays CLI-only for a stronger reason — a raw split
  # once produced stray panes in a live session, and since the layout half of
  # that conclusion was our own bug, the cause is UNCONFIRMED and not something
  # to re-test on a session somebody is using.
  local out
  out="$(herdr pane layout --pane "$1" 2>/dev/null || true)"
  [ -n "$out" ] || return 0
  # SPLIT THE BIGGEST PANE, tie-broken by rightmost — not the rightmost outright.
  #
  # `max_by(.rect.x, .rect.width)` compares x FIRST, so in a tab whose panes are
  # stacked vertically every pane has the same x and the comparison collapses to
  # a tie that jq breaks by document order. On 2026-08-24 that put an executor in
  # a 124x35 box: the tab was dev on top (248x35) and a shell below (248x35),
  # the tie picked the shell, and the agent got half of half. Area first fixes
  # both cases — with a brainer beside an executor the brainer IS the widest pane
  # and still gets split, which is what the original rule was protecting.
  printf '%s' "$out" \
    | jq -r '[.result.layout.panes[]?]
             | max_by(.rect.width * .rect.height, .rect.x)
             | .pane_id // empty' \
      2>/dev/null || true
}

# EQUALIZING THE EXECUTOR PANES: TRIED, MEASURED, REMOVED.
#
# Splitting rightmost (below) keeps the brainer's width but leaves the executors
# halving each other — 50 / 25 / 12 / 12 for three. An equalizer that read the
# layout, picked the worst-deviating pane and nudged it with `pane resize` was
# written and tested, and it made things WORSE: the brainer went to 23 cells of
# 233 (10%), from the 117 (50%) the split-rightmost fix had just secured.
#
# The cause is the resize API. `--direction left|right` does not name a split;
# it selects whichever split lies in that geometric direction from the pane, and
# when the pane has no split on that side it falls back to its only bordering
# split KEEPING THE SIGN. So "grow p2 rightward" can move the p1|p2 boundary and
# take the space out of the brainer. Correct equalization needs per-split
# targeting the CLI does not expose, plus a verified read after every single
# call (a blind chain measured 58/88/44/43 where 58/58/58/58 was wanted).
#
# Not worth it. Unequal executors are cosmetic; a brainer at 10% is the bug this
# whole change set out to fix. If the API ever grows a way to address a split
# directly, this is the note to come back to.


_run_here() {
  local cwd="$1" pane
  [ -n "${HERDR_PANE_ID:-}" ] || die "--here needs to run inside a herdr pane (HERDR_PANE_ID is unset)"

  _export_hw_env "$cwd"
  case "$(_artifacts_dir_for "$PROJ" "$cwd")" in "$cwd") ;; *) _ensure_artifacts_dir "$cwd" ;; esac
  _trust_dir "$cwd"
  _apply_sdd "$cwd" "$SDD" || true

  # Before the split, so the file is already there when the pane's shell starts:
  # a --here pane is the one shape that carries HW_INVOKER_PANE, and that is the
  # single value a restored executor cannot obtain any other way —
  # `agent_name` is not persisted for a brainer-shaped pane, so the pane id is
  # the only handle, and only a file can carry it).
  _write_run_env "$cwd" '{}' "$(_invoker_pane)"

  step "space"
  local raw target
  # Split the RIGHTMOST pane, not the brainer's. See _rightmost_pane_in_tab.
  # Falls back to the brainer's own pane when the layout cannot be read, which
  # is the old behaviour — degraded, but never a failed launch.
  target="$(_rightmost_pane_in_tab "$HERDR_PANE_ID")"
  if [ -z "$target" ]; then
    target="$HERDR_PANE_ID"
    warn "could not read the tab layout — splitting the brainer's own pane, so it will shrink"
  fi
  raw="$(_capture herdr pane split "$target" --direction right --ratio 0.5 --cwd "$cwd" $(_hw_env "$cwd") --no-focus)" \
    || die "herdr pane split failed: $(printf '%s' "$raw" | head -3)"
  pane="$(printf '%s' "$raw" | jq -r '.result.pane.pane_id // .result.pane_id' 2>/dev/null || true)"
  [ -n "$pane" ] && [ "$pane" != null ] || die "herdr pane split returned no id: $(printf '%s' "$raw" | head -3)"
  herdr pane rename "$pane" "$TASK" >/dev/null
  if [ "$target" = "$HERDR_PANE_ID" ]; then
    ok "pane $pane, split right of $HERDR_PANE_ID"
  else
    ok "pane $pane, split right of $target (the brainer at $HERDR_PANE_ID keeps its width)"

  fi

  step "agent"
  if _agent_start "$pane" "$TASK" "$AGENT"; then
    info "$AGENT registered in $pane; vendor runtime readiness is unestablished"
    _dispatch_publish "$pane"
    _send_brief "$pane"
    _verify_opencode_effort
  else
    # Same as the three build paths: no agent means no task. See the comment
    # there for why the `[ -n "$BRIEF" ] && warn` form had to go.
    warn "$AGENT did NOT start in $pane — the pane is a plain shell; start it by hand"
    if [ -n "$BRIEF" ]; then warn "brief NOT delivered (no agent to receive it)"; fi
    herdr pane focus "$pane" >/dev/null 2>&1 || true
    die "$AGENT did NOT start in $pane, so this task is NOT running: no agent, no brief delivered, and nothing to report back. Close that pane with \`herdr pane close $pane\` and dispatch again."
  fi
  herdr pane focus "$pane" >/dev/null 2>&1 || true

  printf "\n  ${C_B}%s${C_0}  %s\n  pane %s — no dev servers; close it with: herdr pane close %s\n\n" \
    "$LABEL" "$cwd" "$pane" "$pane"
}

# ── 9. Idempotent: an existing space is focused, not rebuilt ────────────────
EXISTING=""
if [ "$TAB" = 1 ]; then
  EXISTING="$(_tab_id_by_label "$LABEL")"
  if [ -n "$EXISTING" ]; then
    # EXISTENCE OF THE TAB IS NOT EXISTENCE OF THE AGENT. See
    # _live_agent_panes_in_tab: a tab whose agent pane was closed used to be
    # reported as a successful reuse, with nothing running inside it.
    #
    # REFUSE, DO NOT REBUILD. Rebuilding would mean re-deriving this task's
    # layout, ports, database and brief into a container that already holds
    # somebody's shell panes and possibly a dev server on a port hw no longer
    # owns — a half-built tab is the thing that produced this bug, and a second
    # guess at it is not a fix. `hw done` releases the tab and its ports in one
    # call and the ordinary launch then builds a clean one, so the recovery is
    # two commands and both of them are already tested.
    if [ "$(_live_agent_panes_in_tab "$EXISTING")" = 0 ]; then
      herdr tab focus "$EXISTING" >/dev/null 2>&1 || true
      die "tab $LABEL exists ($EXISTING) but holds NO agent pane — herdr reports no agent in any of its panes, so there is nothing to reuse and nothing was started. This is not a running task. Close it and dispatch again:  hw done $PROJ $TASK  &&  <this same hw command>"
    fi
    herdr tab focus "$EXISTING" >/dev/null 2>&1 || true
    ok "tab $LABEL already exists ($EXISTING) — focused, nothing rebuilt (an agent is live in it)"
    exit 0
  fi
elif [ "$HERE" = 0 ]; then
  EXISTING="$(_ws_id_by_label "$LABEL")"
  if [ -n "$EXISTING" ]; then
    # Same fact, same refusal, one container up. A legacy space whose agent
    # pane died is the identical silent success and was never measured only
    # because tabs are the default now.
    if [ "$(_live_agent_panes_in_workspace "$EXISTING")" = 0 ]; then
      herdr workspace focus "$EXISTING" >/dev/null
      die "space $LABEL exists ($EXISTING) but holds NO agent pane — herdr reports no agent in any of its panes, so there is nothing to reuse and nothing was started. Close it and dispatch again:  hw done $PROJ $TASK --space  &&  <this same hw command>"
    fi
    herdr workspace focus "$EXISTING" >/dev/null
    ok "space $LABEL already exists ($EXISTING) — focused, nothing rebuilt (an agent is live in it)"
    exit 0
  fi
fi

OFF="$(_offset "$TASK")"

# DID --effort ARRIVE? Asked of the live executor, after start, because that is
# the only place the answer exists. The manifest names the route; this reads the
# merged config back from the executor's own server (GET /config on the --port
# hw gave it) and receipts one of three values:
#   yes         the agent's reasoningEffort (top-level or options) is $EFFORT
#   no …        the server answered and the effort is not there — the
#               2026-09-28 state, which used to be printed as `applied`
#   unverified  the server never answered; nothing is claimed either way
# It warns on the last two and never dies: the executor is running and holds
# its brief, and closing it would cost more than the missing effort does.
_verify_opencode_effort() {
  [ "${AGENT:-}" = opencode ] && [ -n "${EFFORT:-}" ] || return 0
  local src="GET ${HW_AGENT_ENDPOINT:-<no endpoint>}/config (the executor's own server)"
  if [ -z "${HW_AGENT_ENDPOINT:-}" ]; then
    _receipt effort_applied "unverified — no executor endpoint to read /config from" "$src"
    warn "effort=$EFFORT UNVERIFIED: this executor has no endpoint to read its config back from"
    return 0
  fi
  local tries="${HW_EFFORT_VERIFY_TRIES:-10}" i=0 body="" got=""
  while [ "$i" -lt "$tries" ]; do
    body="$(curl -fsS -m 3 "$HW_AGENT_ENDPOINT/config" 2>/dev/null || true)"
    [ -n "$body" ] && break
    i=$((i + 1)); sleep 1
  done
  if [ -z "$body" ]; then
    _receipt effort_applied "unverified — $HW_AGENT_ENDPOINT/config did not answer in ${tries} tries" "$src"
    warn "effort=$EFFORT UNVERIFIED: $HW_AGENT_ENDPOINT/config never answered, so nothing says it arrived"
    return 0
  fi
  got="$(printf '%s' "$body" | jq -r --arg a "$OPENCODE_PRIMARY_AGENT" \
          '.agent[$a] | (.reasoningEffort // .options.reasoningEffort // "null")' 2>/dev/null || echo unreadable)"
  if [ "$got" = "$EFFORT" ]; then
    _receipt effort_applied "yes — agent \"$OPENCODE_PRIMARY_AGENT\".reasoningEffort=$got" "$src"
    ok "effort=$EFFORT verified on the live executor (agent $OPENCODE_PRIMARY_AGENT)"
  else
    _receipt effort_applied "no — agent \"$OPENCODE_PRIMARY_AGENT\".reasoningEffort=$got, wanted $EFFORT" "$src"
    warn "effort=$EFFORT NOT APPLIED: the live executor's config says reasoningEffort=$got for $OPENCODE_PRIMARY_AGENT"
  fi
  return 0
}

# THE AGENT STEP EVERY BUILD PATH ENDS WITH, one copy of it: start the agent
# in $P_AGENT, record what herdr measured, deliver the brief — or, when no
# agent started, record that and refuse. The lane hooks in lanes/ and the
# repoless arm below call it after their own `step "N/N  agent"` line.
_agent_step() {
  if _agent_start "$P_AGENT" "$TASK" "$AGENT"; then
    info "$AGENT registered in $P_AGENT; vendor runtime readiness is unestablished"
    # MEASURED AFTERWARDS, not inferred from the call returning 0. `agent start`
    # returns once herdr recognises the agent in the pane, which is not the same
    # as the agent being able to work: on 2026-08-24 `--model terra` produced a
    # claude that started, printed "there is an issue with the selected model"
    # and sat idle at an empty prompt with the brief delivered into it. herdr saw
    # an agent. There was nothing behind it.
    _receipt agent_ready "$(_agent_ready_state "$P_AGENT")" "herdr agent get $P_AGENT"
    _receipt pane "$P_AGENT" "layout.apply output"
    [ -z "$MODEL_FLOOR_LINE" ] || _receipt model_floor "$MODEL_FLOOR_LINE" "_check_model_floor against projects.json model_floor of $PROJ"
    [ -z "$BELOW_FLOOR_WHY" ] || _receipt below_floor_why "$BELOW_FLOOR_WHY" "--below-floor-why"
    _receipt requested_by "$(_requested_line)" "_check_requested: ${REQUESTED_BY_SRC:-no citation}"
    [ -z "${HW_AGENT_ENDPOINT:-}" ] || _receipt endpoint "$HW_AGENT_ENDPOINT" "--port passed to opencode in _build_agent_args"
    _dispatch_publish "$P_AGENT"
    _send_brief "$P_AGENT"
    _verify_opencode_effort
  else
    # A LAUNCH WITH NO AGENT IS A FAILED LAUNCH, and until 2026-08-26 it exited
    # 0 — hw printed two warnings, the success banner underneath them, and
    # returned success to whatever ran it. Same family as the dead tab reused
    # above: the container is there, the agent is not, and the caller is told
    # everything went fine.
    #
    # The receipt and its verdict are still written first: what hw measured is
    # worth keeping precisely when the launch failed. The die comes after.
    #
    # `if`, not `[ -n "$BRIEF" ] && warn …`. That form is an && LIST whose exit
    # status is the test's, so under `set -e` a launch with NO brief died right
    # here — before the agent_ready receipt was written — while a launch WITH
    # one sailed on to exit 0. Two different bugs from one line.
    warn "$AGENT did NOT start in $P_AGENT — the pane is a plain shell; start it by hand"
    if [ -n "$BRIEF" ]; then warn "brief NOT delivered (no agent to receive it)"; fi
    _receipt agent_ready "no — _agent_start failed" "hw _agent_start exit status"
    _receipt_verdict
    die "$AGENT did NOT start in $P_AGENT, so this task is NOT running: no agent, no brief delivered, and nothing to report back. The pane and its worktree are intact — read the receipt with \`hw receipt $PROJ $TASK\`, then close it with \`hw done $PROJ $TASK\` and dispatch again."
  fi
  _receipt_verdict
  herdr workspace focus "$WS" >/dev/null
}

# ONE BUILD PATH PER ISOLATION MODE, not per project. the repo-less lanes and `setup` already
# had the shape a no-worktree task needs — a work directory, no ports, no
# database, then space, layout and agent — and lane C5 asked for exactly that
# for the repo lanes: a browser audit that visits two URLs was creating a
# branch, a worktree, a 953-package install and an unused dev server, and every
# one of those worktrees came back `irreplaceable` at reap time because hw had
# copied an ignored .env.local into it. `--worktree none` sends any lane down
# the path that already existed.
_LANE="$PROJ"
[ "$WANT_WT" = 0 ] && _LANE=repoless

case "$_LANE" in
repoless)
  # No repo, so no worktree, no branch, no ports, no database. Three of hw's
  # seven steps do not exist here, and inventing them would be theatre.
  #
  # `setup` USED TO BE SERVED BY THIS ARM. It has its own above since
  # 2026-09-16: it does have a checkout, and "somewhere to stand that is not
  # brain/" is exactly what a worktree gives — with isolation on top. A setup
  # dispatch still lands here when it asks for `--worktree none` or `--here`,
  # and there the old reasoning holds unchanged.
  WT="$WORK/$PROJ/$TASK"

  step "1/3  work directory"
  if [ -d "$WT" ]; then
    ok "reusing $WT ($(find "$WT" -type f | wc -l | tr -d ' ') files already there)"
  else
    mkdir -p "$WT"
    ok "created $WT"
  fi
  # Artifacts are the output of these tasks — audio, exports, captures. They do
  # not belong in brain/, which holds decisions and briefs, and there is no repo
  # to hold them either. This is that third place.
  info "artifacts belong here, not in brain/ and not in any repo"

  if [ "$HERE" = 1 ]; then _run_here "$WT"; exit 0; fi

  _trust_dir "$WT"
  _apply_sdd "$WT" "$SDD" || true

  step "2/3  space + layout"
  _export_hw_env "$WT"
  case "$(_artifacts_dir_for "$PROJ" "$WT")" in "$WT") ;; *) _ensure_artifacts_dir "$WT" ;; esac
  # Two panes, not three: there is no dev server to watch. That is the whole
  # difference from the other lanes, and it lives in repoless.json, not here.
  _build_space "$LAYOUT_DIR/repoless.json"
  P_AGENT="$(_pane_by_label "$LAYOUT_OUT" agent)"
  P_SHELL="$(_pane_by_label "$LAYOUT_OUT" shell)"
  [ -n "$P_AGENT" ] && [ -n "$P_SHELL" ] \
    || die "layout applied but a labelled pane is missing (agent=$P_AGENT shell=$P_SHELL) — check $LAYOUT_DIR/repoless.json"
  ok "agent=$P_AGENT  shell=$P_SHELL"

  step "3/3  agent"
  _agent_step

  printf "\n  ${C_B}%s${C_0}  %s\n  no repo, no branch, no ports, no database\n\n" "$LABEL" "$WT"
  ;;

# EVERY LANE WITH A WORKTREE BUILDS IT THROUGH ITS OWN HOOK, named by `build`
# in projects.json and sourced here, at top level, so it runs exactly as the
# `case` arm it replaced did: same variables, and its `exit` and `die` end hw.
# The hook calls that repo's own worktree script with its own arguments,
# which is code, not data; everything it shares with the others — the steps
# of a launch, _agent_step — stays here.
#
# A LANE projects.json DECLARES WITH NO HOOK has a complete dry run — every
# manifest field comes from the table — and nothing else. Refuse before
# anything is created rather than fall through.
*)
  _build_hook="$(lane_build_hook "$PROJ")"
  if [ -z "$_build_hook" ]; then
    die "$PROJ has a worktree in projects.json but no build path in bin/hw yet — its dry run is all this version can do. Nothing was created. Dispatch with --worktree none for a plain work directory."
  fi
  [ -r "$_build_hook" ] || die "$PROJ builds through $_build_hook (its \`build\` in projects.json), and that file is not readable. Nothing was created."
  # shellcheck disable=SC1090
  . "$_build_hook"
  ;;
esac
