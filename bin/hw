#!/usr/bin/env bash
#
# hw — one herdr space per task, each on its own git worktree. This file is the SHIM: it finds hw-core, the Go binary
# (core/), and execs it. Every verb lives there; the contract is setup/contracts/hw.md. The name and this entry point
# are the interface (setup/release-standard.md «Versioning»): hooks, invokers and people call `hw`.
#
# What the shim decides, and nothing else:
#   · where the brain is (the link ~/bin/hw is followed to the real bin/), and that herdr, git and jq exist;
#   · which hw-core to run: HW_CORE (a seam of the suite, never rebuilt), else bin/hw-core or core/dist/<os>-<arch>/hw-core.
#     Missing: it dies naming setup/build-core --native. Older than core/'s sources with a Go toolchain on PATH: rebuilt by
#     bin/core-rebuild and the fresh one runs; with none, or a build that failed, the old one runs and ONE line says so;
#   · the three variables hw-core reads (HW_BRAIN_ROOT, HW_CORE_BIN_DIR, HW_CORE_ROOT), and the verb the argv names:
#     the routes below only spell the user's words the way hw-core names them (`status` is its `status-full`, `outbox flush`
#     its `outbox-flush`, anything that is not a verb a dispatch, `hw` alone on a terminal the picker).
# HW_IMPL, HW_IMPL_<VERB> and the switch file name a bash twin that 0.6.0 removed: bin/impl-retired.sh says so once and Go runs.
# `hw shadow` is gone too. An executor (HW_TASK or HW_RUN set) meets hw-core's executor-gate first, with the argv as typed.
set -euo pipefail
case "${OSTYPE:-}" in msys*|cygwin*) HW_MSYS_COMPAT="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/msys-compat.sh"; [ ! -f "$HW_MSYS_COMPAT" ] || . "$HW_MSYS_COMPAT" ;; esac

# colour is for a person looking: off under NO_COLOR, TERM=dumb, and whenever stdout or stderr is not a terminal
_c_err=""; _c_warn=""; _c_0=""
if [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ] && [ -t 1 ] && [ -t 2 ]; then _c_err=$'\033[31m'; _c_warn=$'\033[33m'; _c_0=$'\033[0m'; fi
warn() { printf '  %s!%s %s\n' "$_c_warn" "$_c_0" "$*" >&2; }
die()  { printf '  %s✗%s %s\n' "$_c_err" "$_c_0" "$*" >&2; exit 1; }
for _t in herdr git jq; do command -v "$_t" >/dev/null 2>&1 || die "missing required command: $_t"; done

# locate the real brain/bin through the ~/bin symlink: hop by hop (`readlink -f` reached macOS only in 12.3); a relative link is
# relative to the directory of the link itself
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
HW_BIN_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
# THE SPELLING IS KEPT, not canonicalised: a root reached through a symlinked parent (or a $HOME with a `//` in it) must print
# exactly as it was reached. $_src is the script after every link was followed; only a relative one needs a `cd`.
case "$_src" in
  /*) _brain_root="${_src%/*/*}" ;;
  *)  _brain_root="$(cd "$(dirname "$_src")/.." && pwd)" ;;
esac
BRAIN="${HW_BRAIN_ROOT:-$_brain_root}"

[ "${1:-}" != shadow ] || { printf 'hw: shadow was removed in 0.6.0 — hw-core is the only implementation, so there is nothing to compare; delete a `shadow` line from %s\n' "${HW_IMPL_FILE:-~/.config/hw/impl}" >&2; exit 64; }  # MUTATION-ANCHOR: 1127-M03
[ ! -r "$HW_BIN_DIR/impl-retired.sh" ] || { . "$HW_BIN_DIR/impl-retired.sh"; impl_retired_warn hw; }

_core=""
if [ -n "${HW_CORE:-}" ]; then
  [ ! -x "$HW_CORE" ] || _core="$HW_CORE"
else
  _os="$(uname -s | tr 'A-Z' 'a-z')"; _arch="$(uname -m)"; _ext=""
  case "$_os" in mingw*|msys*|cygwin*) _os=windows; _ext=.exe ;; esac
  case "$_arch" in x86_64) _arch=amd64 ;; aarch64) _arch=arm64 ;; esac
  for _c in "$HW_BIN_DIR/hw-core$_ext" "$HW_BIN_DIR/../core/dist/$_os-$_arch/hw-core$_ext"; do
    [ ! -x "$_c" ] || { _core="$_c"; break; }
  done
  # stale: a source in core/ is newer than the binary (the test contract_core_bin makes too)
  if [ -n "$_core" ] && [ -d "$HW_BIN_DIR/../core" ] \
     && [ -n "$(find "$HW_BIN_DIR/../core" -path '*/dist' -prune -o \( -name '*.go' -o -name '*.txt' -o -name go.mod \) -newer "$_core" -print -quit 2>/dev/null)" ]; then
    _rc=0; _msg="$("$HW_BIN_DIR/core-rebuild" "$HW_BIN_DIR" "$_core" hw 2>&1)" || _rc=$?   # 0: fresh now and silent; else one line, once per state
    [ "$_rc" != 0 ] || _core="$(for _c in "$HW_BIN_DIR/hw-core$_ext" "$HW_BIN_DIR/../core/dist/$_os-$_arch/hw-core$_ext"; do [ ! -x "$_c" ] || { printf '%s' "$_c"; break; }; done)"
    [ -z "$_msg" ] || warn "$_msg"
  fi
fi
[ -n "$_core" ] || die "hw-core is not built: run setup/build-core --native (it needs Go 1.22 or newer, https://go.dev/dl)"
export HW_BRAIN_ROOT="$BRAIN" HW_CORE_BIN_DIR="$HW_BIN_DIR" HW_CORE_ROOT="$_brain_root"

# an executor does not have the brainer's verbs: hw-core says so, with the argv as typed
if [ -n "${HW_TASK:-}${HW_RUN:-}" ]; then "$_core" executor-gate "$@" || exit $?; fi

# the user's words, spelled the way hw-core names them
if [ $# -eq 0 ]; then
  if [ -t 0 ] && [ -t 1 ]; then exec "$_core" picker; fi
  "$_core" help >&2; exit 2
fi
case "$1" in
  -V|--version) ;;
  status) shift; set -- status-full "$@" ;;
  outbox) if [ "${2:-}" = flush ]; then shift 2; set -- outbox-flush "$@"; fi ;;
  receipt|log|handle|help|worktrees|ruling|human-boundary|executor-turn-end|chaining-lease-start|chaining-lease-expire|output|stage) ;;
  review-range|review-delta|preflight|reports|sweep|reap|wait|wait-one|wait-monitor|train|suite|unstick|ledger|briefs|cockpit-state|secret) ;;
  done|next|revive|preview) ;;
  *)  # not a verb: `hw <project> <task> …` is a dispatch, and -h/--help anywhere in it asks for the help instead
      for _a in "$@"; do case "$_a" in -h|--help) exec "$_core" help ;; esac; done
      set -- dispatch "$@" ;;
esac
exec "$_core" "$@"
