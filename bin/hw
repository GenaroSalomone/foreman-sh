#!/usr/bin/env bash
#
# hw — one herdr space per task, each on its own git worktree.
#
#   hw <project> <task> [--agent claude|opencode|codex]
#   hw done <project> <task>
#
# DESIGN: hw WRAPS each repo's existing worktree tooling, it does not replace it.
# Both repos already solved "a worktree only carries what git tracks", and each
# pins where its worktrees live:
#
#   lane A             scripts/new-worktree.sh  → <repo>/.worktrees/<task>
#   lane B             local/wt.sh              → <repo>/.worktrees/<task>
#
# Duplicating their asset lists here would rot silently: the day route-opt adds
# an asset to wt.sh, hw keeps producing worktrees that boot against code
# defaults instead of real config — the exact "bare-worktree trap" wt.sh's own
# header documents. So hw adds only the missing layer: herdr space, ports, panes.
#
# NOT EVERY PROJECT HAS A REPO. a voice lane (formerly named for its customer, until 2026-09-24)
# is decisions about voice — the carrier, the PBX, the chat desk — and its executable work
# is operational: recording announcements, fencing a proxy, rebuilding a PBX.
# It gets the same brief-driven space with the three repo-shaped steps removed:
# no worktree, no branch, no ports, no database. Its artifacts land in $WORK/<project>/<task>/,
# which is neither brain/ (decisions and briefs only) nor anyone's repo.
#
# TWO THINGS HW NO LONGER DOES ITSELF, both because herdr already does them:
#   · the pane tree is a JSON document in brain/layouts/, sent as ONE
#     `layout.apply`, instead of a sequence of splits that could half-finish.
#     See _build_space for where that stops and why the agent pane and the dev
#     servers are still started separately.
#   · `hw status` asks herdr what is alive — the replayed `pane_exited` backlog
#     plus `agent list` — instead of inferring it from directories. See
#     cmd_status for the two limits that answer shapes around.
# Both go through bin/herdr-rpc: layout.apply and events.subscribe have no CLI.
#
set -euo pipefail
# NATIVE WINDOWS (Git Bash): bin/msys-compat.sh makes the native programs this
# file runs (Python, jq, fd, git) answer in bash's path spelling and with LF,
# and asks msys for real symlinks. Elsewhere OSTYPE never matches. A copy of this
# file with no msys-compat.sh beside it (a test fixture) runs on the layer its parent exported.
case "${OSTYPE:-}" in msys*|cygwin*) HW_MSYS_COMPAT="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/msys-compat.sh"; [ ! -f "$HW_MSYS_COMPAT" ] || . "$HW_MSYS_COMPAT" ;; esac
# Git for Windows ships sha256sum/sha1sum and no shasum; this file calls
# `shasum -a 256`. On msys only, and only when shasum is absent, the name falls
# back to the coreutils tool of the same algorithm — same output shape.
case "${OSTYPE:-}" in msys*|cygwin*)
  command -v shasum >/dev/null 2>&1 || shasum() { local a=1; case "${1:-}" in -a) a="${2:-1}"; set -- "${@:3}" ;; esac; "sha${a}sum" "$@"; } ;;
esac

# ── Projects ────────────────────────────────────────────────────────────────
# BRAIN IS SET BELOW, where HW_BIN_DIR is resolved: it is the directory above
# the one this script physically lives in, or HW_BRAIN_ROOT when that is set.
# Every per-lane value comes from $BRAIN/projects.json through
# bin/project-spaces.sh; the comments in this section say why the values there
# are what they are, beside the code that reads them.
PORT_LOCKS="${TMPDIR:-/tmp}/hw-ports"

# WORK AND THE LANES' CHECKOUT VARIABLES ARE NOT SET HERE ANY MORE. They are set by
# bin/project-spaces.sh, sourced below, because `bin/brain` needs the same three
# roots since 2026-09-14 and two literal copies of one mapping is the drift that
# file exists to stop — raised by Judgment Day the day the second reader landed.
# Nothing between this line and that `source` refers to them.

# Projects with no git repository. Everything repo-shaped is skipped for these.
#
# a fourth product lane WAS here, for a reason that has now expired, and the expiry is the
# whole subject of this change. The old comment said: its repository does not
# exist yet, so the lane is repo-less IN FACT, and when that repo lands that lane
# leaves this list and gains the same entries another lane has. The repo landed and
# nobody updated this line, so for a day hw kept handing the lane a bare work
# directory: every executor wrote straight onto the main checkout, with no
# worktree to isolate it, and the brainer had to serialise independent tasks
# by hand so they would not overwrite each other.
#
# A COMMENT THAT ANNOUNCED ITS OWN EXPIRY AND SURVIVED THE EVENT is half of that
# bug, which is why the expiry is recorded here rather than the paragraph simply
# deleted. The three lanes left are repo-less as a property, not as a phase.
# `setup` LEFT THIS LIST ON 2026-09-16, and it is the second expiry this
# paragraph has recorded. It was never repo-less in fact: the brain root IS
# a git repository, and the lane was listed here because an agent auditing the
# setup "needs somewhere to stand that is not brain/" — which a worktree also
# gives, and gives with isolation on top.
#
# WHAT IT COST WHILE IT STOOD. `hw` on PATH is a symlink to `brain/bin/hw`, so
# the file an executor edits in place is the one running every dispatch on the
# machine, for every lane, while it is being edited. One tree, one index, and no
# branch — so the lane could only ever run ONE executor at a time on `bin/hw`,
# and it commits through `git commit-tree` (setup/CLAUDE.md) because the
# pre-commit hook opens a ~7-minute window in which another agent's commit is
# silently reverted. Measured the same day: two setup executors reported with no
# full-suite number at all, because the tree was never quiescent under five
# parallel suites.
#
# the repo-less lanes remain repo-less as a PROPERTY, not as a phase: neither has a
# checkout anywhere.
# The property is `repoless: true` in projects.json.
_is_repoless() {
  [ "$(lane_get "$1" repoless)" = 1 ]
}

# Base branch per repo. A product lane's remote HEAD says `main`, but the repo actually
# works off `develop` (new-worktree.sh bases there, test:changed diffs against
# origin/develop). Following the remote symref here would branch off the wrong
# tree, so the real working base is pinned explicitly.
# MEASURED 2026-09-11, AND IT HAD BEEN WRONG SINCE THIS LINE WAS WRITTEN.
# one lane works off `staging`, not `main`. Its remote HEAD symref
# says `main` — the exact trap the product-lane comment above describes — and this
# constant followed it, so `hw <lane> <task>` handed wt.sh `origin/main` and every
# worktree came out 98 commits BEHIND the branch the work would merge into.
# An executor that does not notice measures its suite and its QA against a tree
# that is not the one receiving the merge, and reports green on the wrong base.
# Two executors caught and fast-forwarded it themselves on
# consecutive tasks; nothing in hw declared it or failed on it.
# It also fed `hw reap`, which counted a branch ahead of the wrong base.
# THE SAME TRAP, ARMED TWICE. A product lane's checkout works off `develop` —
# established three independent ways: 11 of its 15 most recent merges target
# it, the deploy platform serves staging from it, and the checkout itself sits
# there. Its `origin/HEAD` symref
# says `main`, AND the repo's own scripts/worktree.sh defaults its base to
# `origin/main`, so hw must pass the base EXPLICITLY at the delegation site
# below; inheriting that default would reproduce the product-lane defect
# above on a lane that has never had it.
# one lane, VERIFIED 2026-09-15 RATHER THAN COPIED FROM THE BRIEF THAT ASKED FOR
# IT — which is the discipline the two paragraphs above were written by. The
# repo has exactly one branch, `main`; `origin/HEAD` carries no symref at all,
# so there is not even a wrong signal to follow here; the checkout sits on
# `main` and every commit in its history landed there. The trap those comments
# describe cannot arm on this lane today, and the constant is pinned anyway so
# that the day a second branch appears the answer is already stated.
#
# AND IT IS PASSED AS A LOCAL REF, NOT AS `origin/main`. That is the one place
# this lane departs from the three above, it is deliberate, and it was measured
# rather than reasoned: on 2026-09-15 local `main` was 9 commits AHEAD of
# `origin/main` and 0 behind — the wt.sh commit itself among them — because this
# is a solo repo on one machine where the push trails the work. Handing the
# script `origin/main`, the way another lane is handed `origin/develop`, would build
# every worktree 9 commits behind the tree the work actually merges into: the
# defect of 2026-09-11 with its sign flipped, reproduced by
# copying the remedy for it.
#
# The rule underneath is the one this file's header already states: hw WRAPS
# each repo's tooling. `local/wt.sh <nombre> [base-ref]` defaults to `main`
# (read at commit a7c181a: `local base="${2:-main}"`) because its author chose
# the local branch on purpose. hw passes it EXPLICITLY anyway — inheriting a
# default and agreeing with it look identical until the day they diverge, and
# `--base` has to reach the script either way.
# brain has exactly one local branch, `main`, and NO `origin` — its remotes are
# `backup` (a local bare repo) and `github` (the sanitized export). So there is
# no wrong symref to follow here, and, more to the point, the `origin/` prefix
# every other lane except one lane passes would name a ref that does not exist and
# kill the worktree creation outright. See _lane_base_ref_prefix.

# THE BASE A TASK IS BUILT ON, in one place, so the manifest, the frontmatter
# check, `hw reap` and the launch sites cannot disagree about it. A repoless
# lane has none and prints nothing.
_lane_base() {
  lane_get "$1" base || true
}

# THE WORKTREE DIRECTORY A TASK GETS, in ONE place, for the same reason
# _lane_main_checkout is in one place: eight call sites used to carry their own
# copy of `<main>/.worktrees/<task>`, and that lane cannot use that spelling.
#
# A product lane's own scripts/worktree.sh names the directory after the BRANCH, run
# through its `slug()` (`tr '/' '-'`) — not after the task. hw's branch is
# `task/<task>`, so a product lane's leaf is `task-<task>` and every other lane's is
# `<task>`. That difference belongs here once, not at each site that has to
# resolve a path.
#
# Prints nothing for a repo-less lane, which is the signal to fall back to the
# plain work directory; callers must handle the empty string rather than
# treating it as a path.
# A product lane's own local/wt.sh names the directory after the NAME it is given,
# and hw gives it the task — so the leaf is `<task>`, the other lanes' spelling,
# not `task-<task>`. That other leaf
# is what it is because its script slugs the BRANCH; this one's does not, so
# copying that spelling here would name a directory nothing creates.
# setup IS THE ONE LANE WHOSE WORKTREE MUST NOT LIVE UNDER ITS CHECKOUT,
# and the reason is measured rather than stylistic. `setup/test-hw` re-execs
# itself against a private byte-for-byte copy of the checkout made by
# `setup/test-hw-snapshot.py`, whose `inventory()` walks EVERY entry under
# the root — ignored and untracked files included, excluding only `.git`. A
# worktree at `$BRAIN/.worktrees/<task>` is under that root, so every suite
# run from the main checkout would copy every live worktree, and a second
# executor writing in its own worktree would trip the snapshot's own
# "source changed while reading" drift check. The suite would start failing
# for a reason that has nothing to do with the code under test.
#
# `$WORK/setup/<task>` is where a setup task has ALWAYS run, so nothing else
# moves: `lane_work_bases setup` already names it, the invoker return
# channel already covers `$WORK`, and `hw status`, `hw reports` and
# `hw reap` already scan it. What changes is that the directory is now a git
# worktree of brain instead of a bare `mkdir -p`.
_lane_wt_dir() {  # <project> <task>
  lane_path "$1" worktree "$2"
}

# THE BRANCH A TASK'S WORKTREE IS ON, in ONE place, for the same reason
# _lane_wt_dir is: `task/<task>` was a literal at the launch site AND at the
# close site, and that lane does not use it.
#
# A product lane's `local/wt.sh` names the branch after the worktree NAME it is given
# (read at commit a7c181a: `git worktree add -b "$nombre"`), and hw gives it the
# task — so the branch is `<task>`, not `task/<task>`. That is a fact about the
# repo's own script, not a choice hw is free to make.
#
# WHY IT IS WORTH A HELPER RATHER THAN A SECOND LITERAL: `hw done` computes the
# merge recipe from this name. With `task/<task>` hardcoded there, closing a
# that lane's task would look for a branch that does not exist, find nothing, and
# print "nothing to merge" over real work sitting on `<task>` — the same shape
# as the 2026-08-25 defect that comment block already documents, arriving
# through a different door.
# THE REF PREFIX A LANE'S BASE IS PASSED WITH. Three lanes hand their script
# `origin/<base>`; that lane hands it the local branch — its base_ref_prefix is empty, since
# local main led origin/main by 9 commits when that was measured, so the prefix
# every other lane needs would name a tree BEHIND the work.
#
# A FUNCTION RATHER THAN A LOCAL, and that is not style. The manifest reads this
# in two places that sit on either side of where a local would naturally be
# declared, and the first draft put the declaration below the first reader: hw
# died on `base_ref_prefix: unbound variable` under `set -u`. A helper has no
# order to get wrong.
# one lane: local main led origin/main by 9 commits when that was measured.
# setup: brain HAS no `origin`. Its remotes are `backup` and `github`, and
# `origin/main` resolves to nothing at all — so this is not a preference
# here, it is the only ref that exists.
_lane_base_ref_prefix() {  # <project>
  local v
  v="$(lane_get "$1" base_ref_prefix)" || v='origin/'
  printf '%s' "$v"
}

# THE REF A LANE'S NEXT WORKTREE IS BUILT FROM, as the agent checks read it:
# the lane's own base (not --base) behind its ref prefix — `origin/develop`.
_lane_agents_ref() {  # <project>
  printf '%s%s' "$(_lane_base_ref_prefix "$1")" "$(_lane_base "$1")"
}

_lane_branch() {  # <project> <task>
  lane_known "$1" || { printf 'task/%s' "$2"; return 0; }
  lane_path "$1" branch "$2"
}

# The base THIS task will use: an explicit --base wins, the lane default
# otherwise. BASE_SRC says which, because a field that cannot say whether it
# was chosen or defaulted is the field this manifest exists to replace.
BASE_OVERRIDE=""
BASE_SRC="lane default"
_task_base() {
  if [ -n "$BASE_OVERRIDE" ]; then printf '%s' "$BASE_OVERRIDE"
  else _lane_base "${PROJ:-}"; fi
}

# THE BRANCH POINT THE WORK STARTS AT — the base a Judgment Day target is
# built against, and the one fact hw has known since the dispatch.
#
# WHY IT IS HANDED OVER, MEASURED 2026-09-22 BY TWO LANES INDEPENDENTLY. A review
# scoped by a RECORDED boundary instead of the branch point takes, on a fresh
# branch, an old commit with no relation to the work. A product lane's `task/guardar-la-historia-del-expected` is 7 files
# / 983 lines off `origin/staging`; the cycle reviewed 27 files / 3027 lines
# from base `3d13a3f`, a commit on the main side, and its single CRITICAL
# finding was code that was already in `origin/staging` before the branch
# existed. Re-measured here from the repo: merge-base..branch is 7 files /
# 983(+)/10(-), and 3d13a3f..branch is 27 / 3027(+)/18(-) — the brief's figures
# exactly. A product lane hit the same stale boundary (`7f705a9`) five times that day.
# There is no error signal anywhere: the review closes cleanly, and the verdict
# is about somebody else's code. The review that measured it has since been
# retired (setup/decisions.md, 2026-09-22); the base stays, because a Judgment
# Day target has exactly the same need.
#
# MERGE-BASE, NOT THE BASE TIP — AND THE FIRST LANE'S CASE DOES NOT PROVE
# IT. Measured: `origin/staging` was 0 commits ahead of that branch point, so
# `merge-base..HEAD` and `origin/staging..HEAD` gave the SAME 7 files. That case
# proves the defect, not the choice. What discriminates the two is a base that
# MOVED, and that was measured on a constructed repo the same day: one commit on
# the branch, five files committed on the base afterwards, `merge-base..HEAD` =
# 1 file, `base..HEAD` = 6 — the five extra being the base's own advance, shown
# from the branch as deletions it never made. The tip answer fails in the same
# direction as the defect above, just more slowly and only after the base moves.
# So the branch point is what hw hands over.
#
# IT PRINTS NOTHING RATHER THAN GUESSING, in every case it cannot answer: a lane
# with no repo, a `--worktree none` dispatch, a work directory that is not a git
# worktree (every pre-2026-09-16 setup task left one at exactly the path this
# lane now uses — see _artifacts_dir_for, which discriminates the same way), a
# base ref that does not resolve locally, or a reused worktree whose HEAD shares
# no history with the base. Silence is the correct output there. An empty
# variable somebody interpolates into `git diff ""..HEAD`, or a plausible wrong
# SHA, IS the defect this exists to fix, arriving through hw — and a wrong answer
# from hw would carry more authority than no answer.
_review_base_ref() {  # <workdir>  → the merge-base SHA, or nothing
  local wd="${1:-}" base ref
  # `-e`, not `-d`: a linked worktree's `.git` is a FILE, a main checkout's is a
  # directory, and a plain `mkdir -p`'d work directory has neither. Cheaper than
  # `rev-parse --is-inside-work-tree`, and it cannot answer about a PARENT repo
  # the way that would for a plain directory sitting inside a checkout.
  [ -n "$wd" ] && [ -e "$wd/.git" ] || return 0
  base="$(_task_base)"
  [ -n "$base" ] || return 0
  ref="$(_lane_base_ref_prefix "${PROJ:-}")$base"
  git -C "$wd" rev-parse --verify --quiet "$ref^{commit}" >/dev/null 2>&1 || return 0
  git -C "$wd" merge-base HEAD "$ref" 2>/dev/null || true
}

# Port bases, chosen clear of the repos' own defaults (lane A 3000/3001/3002,
# route-opt 8000 + 3000) so a task never collides with a plain `pnpm dev`.
# one lane is Astro, one dev server, no API. 3400 is clear of every base above and
# of the repo's own `astro dev` default (4321).

# Project aliases. The full names keep working; these are just shorthands.
_canon_project() {
  local a
  a="$(lane_alias hw "$1")" || a=""
  printf '%s' "${a:-$1}"
}

# A flag that takes a value, given last, used to kill hw in silence: `shift 2`
# with one argument left returns 1, and `set -e` does the rest. Say so instead.
_need_val() { [ $# -ge 2 ] || die "$1 needs a value"; }

# Only `*/*` was rejected, so `hw setup ""` resolved the work directory to the
# SHARED parent of every task and marked it trusted, `hw setup --` created a
# directory called `--`, and a name with a space was split into stray argv by
# the unquoted env expansion. One character class closes all three.
_check_task() {
  case "$1" in
    "") die "<task> is empty" ;;
    -*) die "<task> must not start with a dash: $1" ;;
  esac
  case "$1" in
    *[!A-Za-z0-9._-]*) die "<task> may only contain letters, digits, dot, underscore and dash: $1" ;;
  esac
  case "$1" in
    .|..) die "<task> must not be . or .." ;;
  esac
  # The task name IS the herdr agent name, and herdr's rule is narrower than the
  # class above: 1-32 chars, must start with a lowercase letter, and only
  # lowercase letters, digits, '-' and '_'. Checked HERE because herdr checks it
  # LAST: on 2026-08-24 a 36-character task built the worktree, copied fixtures,
  # allocated two ports and opened three panes, and only then died with
  # `invalid_agent_name` — leaving a space to close by hand and nothing running.
  # Failing on argv costs nothing; failing at step 6 of 6 costs a teardown.
  # Enumerated, NOT `[a-z]`: under a UTF-8 locale a range uses collation order,
  # so `[!a-z]*` happily accepts "Mala-Mayuscula" because M sorts inside a-z.
  # The bug passed its own test silently. Ranges are not portable here.
  _lc='abcdefghijklmnopqrstuvwxyz'
  _ok="${_lc}0123456789_-"
  case "$1" in
    [!$_lc]*) die "<task> must start with a lowercase letter (herdr agent-name rule): $1" ;;
    *[!$_ok]*) die "<task> may only contain lowercase letters, digits, underscore and dash (herdr agent-name rule): $1" ;;
  esac
  unset _lc _ok
  if [ "${#1}" -gt 32 ]; then
    die "<task> is ${#1} characters; herdr agent names cap at 32. Shorten it: $1"
  fi
}

# Brief inferred from the task name, unless --brief pointed somewhere else.
# Absent brief is not an error: hw stays usable without brain/ entirely.
#
# Must return 0 even when there is no brief. It is called as
# `BRIEF="$(_infer_brief ...)"`, and an assignment inherits the substitution's
# exit status — so returning 1 here made `set -e` kill hw silently, with no
# message and exit 1, for every task that had no brief. Exactly the case the
# line above says is supported.
_infer_brief() {
  local proj="$1" task="$2" candidate="$BRAIN/$1/briefs/$2.md"
  [ -f "$candidate" ] && printf '%s' "$candidate"
  return 0
}

# ── credential handles ──────────────────────────────────────────────────────
#
# A brief passes a credential as a RESOLVER, never as a value:
#
#     security find-generic-password -s <handle> -w
#
# That is right and it is not changing (CLAUDE.shared.md, "A secret travels as a
# resolver"). What it lacked was a way to answer "does this handle exist?"
# BEFORE the brief is written. Without one, the handle is discovered at the
# moment the executor is blocked by it: a brainer tried eight names in the
# keychain, none existed, and the task was born with a human step inside it.
#
# THE SECRET IS NEVER TOUCHED, and that is a property of the command, not of our
# discipline about its output. `-w` and `-g` are what decrypt and print the
# value; WITHOUT them `security find-generic-password` returns only the item's
# attributes and never decrypts anything — which is also exactly the line
# ~/.claude/hooks/block-keychain-secret-read.py draws, so a brainer running this
# is not fighting its own guard rail. stdout and stderr are discarded regardless
# and only the exit status is read, so there is nothing to leak into a log even
# if a future `security` printed more.
_handle_exists() { security find-generic-password -s "$1" >/dev/null 2>&1; }

# The keychain is macOS's. Linux (and WSL2) has no backend this toolchain can
# ask, so a handle there is UNVERIFIABLE — which is neither present nor absent,
# and must not be reported as either. `HW_NO_KEYCHAIN=1` forces that state so the
# degraded path is testable on a machine that does have `security`.
_keychain_available() { [ "${HW_NO_KEYCHAIN:-0}" != 1 ] && command -v security >/dev/null 2>&1; }
_no_keychain_message() {
  warn "no keychain backend on $(uname -s): hw cannot tell whether a handle exists"
  warn "the macOS Keychain is the only store hw checks. Here, keep a credential in a file or an env var"
  warn "only its consumer can read (chmod 600, outside every repo) and name that in the brief instead of a handle"
}

# The handles a brief NAMES, from the one documented resolver shape and nothing
# else. THE BOUNDARY IS DELIBERATE: this matches `security find-generic-password
# … -s <handle>` on a single line and stops there. It is not a brief parser and
# must not become one — a brief is prose for an agent, and inferring "this
# sentence implies a credential" would produce false blockers on a document
# whose whole point is that a human wrote it freely. A handle that is not
# written in the resolver form is simply not checked, and the executor's
# report-blocked path still covers it, exactly as before.
#
# `<handle>`-style placeholders are skipped: BRIEF-TEMPLATE.md and the brief
# conventions are full of them, and a template is not a missing credential.
_brief_handles() {
  python3 - "$1" <<'EOF' 2>/dev/null || true
import re, sys

try:
    with open(sys.argv[1]) as fh:
        text = fh.read()
except OSError:
    raise SystemExit(0)

# -s may come before or after other flags, and the handle may be quoted.
pattern = re.compile(
    r"security\s+find-generic-password\b[^\n]*?-s\s+"
    r"""(?:"([^"\n]+)"|'([^'\n]+)'|([^\s`'"]+))""")
seen = []
for match in pattern.finditer(text):
    handle = next(g for g in match.groups() if g is not None)
    handle = handle.strip().rstrip("`,.;")
    if not handle or "<" in handle or ">" in handle or "{" in handle:
        continue          # a placeholder in a template, not a handle
    if handle not in seen:
        seen.append(handle)
for handle in seen:
    print(handle)
EOF
}

# `hw review-range` — the base a Judgment Day target is built against, computed
# NOW. HW_REVIEW_BASE_REF is frozen when hw launches the executor; once the
# brainer has the executor rebase onto the lane base, `ref..HEAD` also holds
# every PR that landed in between, and the judges read code that is not the
# task's. So the range is `merge-base(HEAD, <the task base>)..HEAD`, asked at
# judging time. The base is HW_REVIEW_BASE_BRANCH, which already carries the
# lane's ref prefix (`origin/develop` where the lane works against a remote, the
# local branch where it does not). It never fetches: the ref is whatever the
# checkout holds, which is what the executor rebased onto.
#
# stdout is the SHA and nothing else, so `"$(hw review-range)"..HEAD` cannot
# interpolate a blank. Any case it cannot answer exits 1 naming the ref.
cmd_review_range() {
  local wd="${HW_WORKDIR:-$PWD}" ref="${HW_REVIEW_BASE_BRANCH:-}" sha
  if [ -z "$ref" ]; then
    printf 'hw review-range: HW_REVIEW_BASE_BRANCH is not set, so there is no base to judge from (no worktree or no base was resolved at dispatch)\n' >&2
    return 1
  fi
  if ! git -C "$wd" rev-parse --verify --quiet "$ref^{commit}" >/dev/null 2>&1; then
    printf 'hw review-range: base ref %s does not resolve in %s\n' "$ref" "$wd" >&2
    return 1
  fi
  sha="$(git -C "$wd" merge-base HEAD "$ref" 2>/dev/null || true)"
  if [ -z "$sha" ]; then
    printf 'hw review-range: HEAD and %s share no history in %s, so there is no merge-base\n' "$ref" "$wd" >&2
    return 1
  fi
  printf '%s\n' "$sha"
}

# `hw review-delta <judged-base> <judged-head>` — what a rebase after Judgment
# Day left to re-judge. In the salón release a rebase sent a whole 100+ file
# target back to both judges when the task's own diff had barely moved; the
# same run's next rebase, judged over the changed part only, cost an eighth.
# This compares the task's own diff as judged (<judged-base>..<judged-head>)
# with the one it has now (`hw review-range`..HEAD), file by file, by
# `git patch-id --stable`: a hunk that only moved lines is the same judgment; a
# conflict resolution, a new commit or a file the task stopped touching is not.
#
# exit 0, stdout empty: nothing changed, the verdict stands. exit 3: stdout is
# one path per line, the scope of a scoped re-judgment. exit 1: it cannot
# answer, naming why. What it cannot see is a base change that breaks the
# task's code without touching the task's diff — no re-judgment of the diff
# sees that either; the suite does.
cmd_review_delta() {
  local wd="${HW_WORKDIR:-$PWD}" jb="${1:-}" jh="${2:-}" nb f a b changed="" top names
  if [ -z "$jb" ] || [ -z "$jh" ] || [ $# -ne 2 ]; then
    printf 'usage: hw review-delta <judged-base> <judged-head>  (the range the last Judgment Day judged)\n' >&2
    return 1
  fi
  for f in "$jb" "$jh"; do
    git -C "$wd" rev-parse --verify --quiet "$f^{commit}" >/dev/null 2>&1 || {
      printf 'hw review-delta: judged ref %s does not resolve in %s\n' "$f" "$wd" >&2
      return 1
    }
  done
  nb="$(cmd_review_range)" || return 1
  # Every git call below runs from the repo top level with literal pathspecs, so
  # the answer does not depend on the caller's cwd; names are read NUL-separated
  # (-z) because git C-quotes non-ASCII paths otherwise and the quoted string
  # matches nothing. An empty id must never stand for "unchanged": a diff git
  # cannot patch-id falls back to a hash of the diff itself, and any git failure
  # is "cannot tell".
  top="$(git -C "$wd" rev-parse --show-toplevel 2>/dev/null)" || top=""
  if [ -z "$top" ]; then
    printf 'hw review-delta: %s is not inside a git work tree\n' "$wd" >&2
    return 1
  fi
  _file_pid() {
    local d id
    d="$(git -C "$top" diff --no-color --no-renames "$1" "$2" -- ":(top,literal)$3" && printf x)" || return 1
    d="${d%x}"
    [ -n "$d" ] || { printf '\n'; return 0; }
    id="$(printf '%s' "$d" | git -C "$top" patch-id --stable)" || return 1
    id="${id%% *}"
    if [ -z "$id" ]; then
      id="h:$(printf '%s' "$d" | git -C "$top" hash-object --stdin)" || return 1
    fi
    printf '%s\n' "$id"
  }
  names="$(mktemp "${TMPDIR:-/tmp}/hw-review-delta.XXXXXX")" || return 1
  if ! { git -C "$top" diff --no-renames --name-only -z "$jb" "$jh" \
         && git -C "$top" diff --no-renames --name-only -z "$nb" HEAD; } > "$names.raw" 2>/dev/null \
     || ! sort -zu "$names.raw" > "$names"; then
    rm -f "$names" "$names.raw"
    printf 'hw review-delta: git could not list the changed files in %s\n' "$top" >&2
    return 1
  fi
  while IFS= read -r -d '' f; do
    [ -n "$f" ] || continue
    if ! a="$(_file_pid "$jb" "$jh" "$f")" || ! b="$(_file_pid "$nb" HEAD "$f")"; then
      rm -f "$names" "$names.raw"
      printf 'hw review-delta: git could not diff %s, so it cannot tell whether it changed\n' "$f" >&2
      return 1
    fi
    [ "$a" = "$b" ] || changed="$changed$f"$'\n'
  done < "$names"
  rm -f "$names" "$names.raw"
  if [ -z "$changed" ]; then
    printf 'hw review-delta: unchanged — the own diff %s..HEAD is the one judged as %s..%s; the verdict stands\n' \
      "${nb:0:12}" "${jb:0:12}" "${jh:0:12}" >&2
    return 0
  fi
  printf '%s' "$changed"
  return 3
}

# `hw handle <name>...` — present or absent, for each name, and nothing else.
# This is the preflight a brainer runs WHILE writing the brief, which is the
# whole point: the answer has to be available before the task exists.
cmd_handle() {
  local h rc=0
  [ $# -ge 1 ] || die "usage: hw handle <keychain-handle> [<handle>...]"
  if ! _keychain_available; then
    _no_keychain_message
    exit 2
  fi
  step "keychain handles"
  for h in "$@"; do
    if _handle_exists "$h"; then
      ok "$h — present"
    else
      warn "$h — ABSENT (nothing in the keychain has that service name)"
      rc=1
    fi
  done
  if [ "$rc" -ne 0 ]; then
    printf '\n  %sstore one with:%s security add-generic-password -s <handle> -a %s -w \x27<value>\x27\n' \
      "$C_DIM" "$C_0" "${USER:-$(id -un)}"
    printf '  %sonly presence is checked here — hw never reads a value, and neither should a brainer.%s\n\n' \
      "$C_DIM" "$C_0"
  else
    printf '\n  %sonly presence was checked — no value was read, printed or logged.%s\n\n' "$C_DIM" "$C_0"
  fi
  return "$rc"
}

# COLOUR IS FOR A PERSON LOOKING. Off under NO_COLOR (any non-empty value, the
# convention), TERM=dumb, and whenever stdout or stderr is not a terminal: a pipe
# to `tee` or a log file must not carry escape codes.
C_OK=""; C_WARN=""; C_ERR=""; C_DIM=""; C_B=""; C_0=""
if [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ] && [ -t 1 ] && [ -t 2 ]; then
  C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_ERR=$'\033[31m'; C_DIM=$'\033[2m'; C_B=$'\033[1m'; C_0=$'\033[0m'
fi
ok()   { printf "  ${C_OK}✓${C_0} %s\n" "$*"; }
info() { printf "  ${C_DIM}·${C_0} %s\n" "$*"; }
warn() { printf "  ${C_WARN}!${C_0} %s\n" "$*" >&2; }
# ONE FAILURE-GLYPH SITE, and the suite audits that by grepping for the glyph —
# so do not write it in a comment either. The glyph means "this command is over
# and it is not a success" — a refusal that could print it and then return 0
# would make every caller's branch a lie, which is why the count is pinned.
# `die_rc` exists so `hw wait` can end on a VERDICT code without hand-rolling a
# second printf beside this one: the exit status varies, the "not a success"
# guarantee does not, because 0 is never reachable through here.
die_rc() { local _rc="$1"; shift; printf "  ${C_ERR}✗${C_0} %s\n" "$*" >&2; exit "$_rc"; }
die()  { die_rc 1 "$@"; }
step() { printf "\n${C_B}%s${C_0}\n" "$*"; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }
need herdr; need git; need jq

# ── locate the real brain/bin, through the ~/bin symlink ────────────────────
#
# hw is symlinked into ~/bin individually, so ${BASH_SOURCE[0]} is the LINK
# while herdr-rpc and layouts/ live beside the TARGET. Same hop-by-hop
# resolution as ask-invoker: `readlink -f` is a GNU-ism that only reached macOS
# in 12.3, and a relative link is relative to the directory of the link itself.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
HW_BIN_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
# The project -> workspace-label table, shared with bin/brain so the two cannot
# name the same space differently. See bin/project-spaces.sh.
# shellcheck source=project-spaces.sh
. "$HW_BIN_DIR/project-spaces.sh"
# THE SPELLING IS KEPT, not canonicalised: the old root was the literal
# home-relative path, so a root reached through a symlinked parent (or a
# $HOME with a `//` in it) must print exactly as it was reached. $_src is the
# script after every link was followed; only a relative one needs a `cd`.
case "$_src" in
  /*) _brain_root="${_src%/*/*}" ;;
  *)  _brain_root="$(cd "$(dirname "$_src")/.." && pwd)" ;;
esac
BRAIN="${HW_BRAIN_ROOT:-$_brain_root}"
# --version needs no lane table: it must answer from a brain whose table is broken.
case "${1:-}" in -V|--version) printf 'hw %s\n' "$(cli_version "$BRAIN")"; exit 0 ;; esac
lane_config_load "$BRAIN" || die "the lane table did not load, so no lane is known — fix $BRAIN/projects.json (the reason is above)"

# herdr-rpc reaches the API-only RPCs the CLI does not expose: `layout.apply`
# (P5, one round trip for a whole task space) and `events.subscribe` (P3, the
# pane_exited backlog `hw status` reads instead of guessing). Both are required
# for a launch and for status respectively, so hw refuses rather than silently
# falling back to the guessing it just stopped doing.
HERDR_RPC="$HW_BIN_DIR/herdr-rpc"
LAYOUT_DIR="$HW_BIN_DIR/../layouts"

# ── executor turn-end legality ───────────────────────────────────────────────
# OpenCode's event plugin cannot veto session.idle: a live plugin that logged
# the event and threw still produced the complete assistant response and Herdr
# reported done. The predicate therefore lives here, not in one vendor hook.
_executor_state_dir() {
  [ -n "${HW_WORKDIR:-}" ] && [ -n "${HW_RUN:-}" ] || return 1
  printf '%s/.hw/%s' "$HW_WORKDIR" "$HW_RUN"
}

_executor_reply_facts_valid() {
  local file="$1"
  HOLD_FILE="$file" HOLD_RUN="${HW_RUN:-}" HOLD_PANE="${HERDR_PANE_ID:-}" \
    HOLD_VENDOR="${HW_EXECUTOR_VENDOR:-}" python3 - <<'PY'
import os
import re
from pathlib import Path

path = Path(os.environ["HOLD_FILE"])
try:
    rows = path.read_text(encoding="utf-8").splitlines()
except OSError:
    raise SystemExit(1)

facts = {}
for row in rows:
    if "=" not in row:
        raise SystemExit(1)
    key, value = row.split("=", 1)
    if not key or key in facts:
        raise SystemExit(1)
    facts[key] = value

required = {"version", "state", "intent", "route", "target", "logical_id", "pane", "run"}
if set(facts) != required:
    raise SystemExit(1)

run = os.environ["HOLD_RUN"]
pane = os.environ["HOLD_PANE"]
vendor = os.environ["HOLD_VENDOR"]
if not run or not pane:
    raise SystemExit(1)
if facts["version"] != "1" or facts["state"] != "delivered":
    raise SystemExit(1)
if facts["run"] != run or facts["pane"] != pane:
    raise SystemExit(1)

intent = facts["intent"]
kind = {"answer": "ask", "ruling": "challenge"}.get(intent)
if kind is None:
    raise SystemExit(1)
prefix = re.escape(run) + r"(?::t(?:[2-9]|[1-9][0-9]+))?"
if not re.fullmatch(prefix + rf":{kind}:[1-9][0-9]*:reply", facts["logical_id"]):
    raise SystemExit(1)

route = facts["route"]
target = facts["target"]
if route == "herdr":
    if target != pane:
        raise SystemExit(1)
elif route in {"opencode", "codex"}:
    if route != vendor or not target:
        raise SystemExit(1)
else:
    raise SystemExit(1)
PY
}

_executor_pending_reply() {
  local state_dir="$1" file intent
  for file in "$state_dir"/pending-reply-*; do
    [ -f "$file" ] || continue
    if ! _executor_reply_facts_valid "$file"; then
      continue
    fi
    intent="$(awk -F= '$1=="intent" {print substr($0, index($0,"=")+1); exit}' "$file" 2>/dev/null || true)"
    case "$intent" in answer|ruling) printf '%s\t%s' "$intent" "$file"; return 0 ;; esac
  done
  return 1
}

# A TURN WAITING ON A BACKGROUND CHILD IS NOT A HANDBACK, and it is the fourth
# legal way for a turn to end. The other three are disk facts; this one is not,
# because no disk fact carries it. MEASURED on Claude Code 2.1.258
# (2026-09-02): every background child writes `<session>/tasks/<id>.output` —
# a file for a shell task, a symlink into `subagents/agent-<id>.jsonl` for a
# subagent — but those files SURVIVE completion, and the sibling
# `agent-<id>.meta.json` carries no status at all, so nothing on disk tells a
# live child from a finished one.
#
# What does carry it is the vendor's own turn-end payload, which names each
# child with a status:
#
#   "background_tasks":[{"id":"a0f05…","type":"subagent","status":"running",
#                        "agent_type":"general-purpose"}]
#
# `type` is `subagent` for an Agent-tool child (a background explore task is
# the measured case) and `shell` for a backgrounded Bash task; both report
# `status:running` while alive and are gone from the array once collected.
#
# ONLY THE LITERAL `running` COUNTS. The full set of statuses this field can
# take is UNESTABLISHED, so an unmeasured value refuses rather than excusing a
# silent turn — the asymmetry is deliberate: a false refusal costs one message,
# a false pass loses the task.
#
# This is not a loosening. A live child re-invokes the executor when it
# finishes, so the work is still in motion and nobody has to go looking for
# it — which is exactly what the refusal exists to prevent, and exactly what
# is not happening here. The excuse lasts only as long as a child is genuinely
# alive: the notification opens a turn, that turn ends with the array empty,
# and the ordinary refusal applies again.
_executor_live_children() {
  [ -n "${HW_TURN_END_PAYLOAD:-}" ] || return 0
  printf '%s' "$HW_TURN_END_PAYLOAD" | jq -r '
    [(.background_tasks // [])[] | select((.status? // "") == "running")]
    | if length == 0 then empty
      else (length | tostring) + " " + ([.[] | (.type? // "task")] | unique | join(","))
      end' 2>/dev/null || true
}

_executor_turn_publish() {
  local state="$1" turns="$2" extra_name="${3:-}" extra_value="${4:-}" params
  [ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || return 0
  params="$(jq -nc \
    --arg pane "$HERDR_PANE_ID" --arg project "${HW_PROJECT:-unknown}" \
    --arg task "${HW_TASK:-unknown}" --arg run "${HW_RUN:-unknown}" \
    --arg state "$state" --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    --arg turns "$turns" --arg extra_name "$extra_name" --arg extra_value "$extra_value" '
      {pane_id:$pane,source:"hw:executor-turn-end",ttl_ms:86400000,
       tokens:{hw_project:$project,hw_task:$task,hw_run:$run,
               turn_state:$state,turn_ended_at:$at,turns:$turns}}
      | if $extra_name != "" then .tokens[$extra_name]=$extra_value else . end')" || return 0
  "$HERDR_RPC" call pane.report_metadata "$params" >/dev/null 2>&1 || true
}

_executor_turn_reason() {
  printf '%s' 'This executor turn has no legal handoff fact on disk — going quiet hands reversible work back. Continue working now, report with `done-invoker`, or report the blocker with `done-invoker --blocked "<question and what would unblock it>"`. If the next action crosses a genuine human boundary, record it first with `hw human-boundary "<the boundary, and why only '"${HW_OPERATOR:-the operator}"' can decide>"`.'
}

cmd_human_boundary() {
  local reason="$*" state_dir file
  [ -n "${HW_TASK:-}" ] && state_dir="$(_executor_state_dir)" \
    || die "hw human-boundary is executor-only: HW_TASK, HW_RUN and HW_WORKDIR must identify the run"
  [ -n "$reason" ] || die "usage: hw human-boundary \"<specific boundary and why only ${HW_OPERATOR:-the operator} can decide>\""
  [ "${#reason}" -le 600 ] || die "human boundary is ${#reason} characters; limit 600. Name the boundary and why it needs ${HW_OPERATOR:-the operator}, not the transcript."
  case "$reason" in *$'\n'*) die "human boundary must be one line" ;; esac
  mkdir -p "$state_dir"
  file="$state_dir/human-boundary"
  umask 077
  printf '%s\n' "$reason" > "$file" || die "could not record the human boundary at $file"
  ok "one-shot human boundary recorded for the next turn end: $reason"
}

# QUEUE A CORRECTION FOR AN EXECUTOR THAT IS STILL WORKING.
#
# The measured cost of not having this, 2026-09-11: `channel-send --ruling`
# refuses a working receiver and names two exits -- finish, or "deliberately
# stop the current work". A brainer read the second as `hw done`, ran it, and
# lost an executor with its whole session context over a three-line correction.
# It did the same thing twice in one day.
#
# The gate itself is right and is not loosened here. What was missing is a third
# exit: this writes the ruling into the executor's own run directory, and
# `hw executor-turn-end` -- which already runs inside that executor at every
# turn end -- delivers it at the next clean boundary. Nobody waits, nobody dies.
#
# WHAT THIS IS NOT. It is not faster than the executor's next turn end, and a
# turn can be long. If the correction cannot wait for that, the honest answers
# are still the old ones, and killing the session is still the expensive one.
cmd_ruling() {
  local pane="" text="" dry=0 stdin_dash=0 saw_word=0
  if [ $# -gt 0 ]; then pane="$1"; shift; fi
  [ -n "$pane" ] || die "usage: hw ruling <executor-pane> \"<the correction>\" [--dry-run] | hw ruling <executor-pane> - [--dry-run] (a lone '-' reads the correction from stdin — the way for text with backticks, \$, quotes or newlines that argv would mangle; MEASURED 2026-09-11: a ruling with backticked identifiers reached its receiver with every one of them missing, because the SENDER's own shell expanded them before hw ever ran). Queues a correction, delivered at its next turn end in the order sent (up to 5 undelivered per executor). For a receiver that is already idle or done, use channel-send --ruling, which delivers now."
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --) shift; [ $# -eq 0 ] || { saw_word=1; if [ -n "$text" ]; then text="$text $*"; else text="$*"; fi; }; break ;;
      -) stdin_dash=1; shift ;;
      -*) die "unknown option: $1" ;;
      *) saw_word=1; if [ -n "$text" ]; then text="$text $1"; else text="$1"; fi; shift ;;
    esac
  done
  # THREE DISTINCT REFUSALS for three distinct mistakes: text given both ways,
  # a failed stdin read, and stdin that read but was empty. An empty ruling
  # delivered would be worse than any of these refusals.
  if [ "$stdin_dash" = 1 ]; then
    [ "$saw_word" = 0 ] || die "the ruling was given on argv AND as '-' for stdin — pass it ONE way, not both"
    [ ! -t 0 ] || die "'-' reads the ruling from stdin, but stdin is a terminal — pipe or redirect the text in"
    text="$(cat -)" || die "could not read the ruling from stdin"
    [ -n "$text" ] || die "stdin for '-' produced no bytes — an empty ruling delivered would be worse than this refusal"
  fi
  [ -n "$text" ] || die "the ruling is empty — there is nothing to deliver"

  # ONE CLASSIFIER, SHARED WITH channel-send --ruling (state-witness.sh
  # `witness_executor_state`). This used to read `agent_status` itself, once,
  # and task 1's done marker; channel-send read `agent_status` itself, once, at
  # another instant. On a pane awaiting a child that field flaps, so the two
  # disagreed and each named the other as the exit — and after `hw next` this
  # one refused task 2 as "already reported" off task 1's marker. MEASURED
  # 2026-09-28, both; see setup/decisions.md.
  _load_state_witness
  local line verdict status rundir seq cwd
  line="$(witness_executor_state "$pane")"
  IFS=$'\037' read -r verdict status _ _ rundir seq cwd <<< "$line" || true
  [ "$verdict" != absent ] || die "herdr knows no pane $pane, so there is nothing to queue a ruling for. Nothing was written."
  [ -n "$cwd" ] || die "herdr reports no cwd for $pane, so hw cannot find its run directory. Nothing was written."
  [ -n "$rundir" ] \
    || die "no hw run directory at or above the cwd herdr reports for $pane — that pane was not launched by hw, so it has no turn-end hook to deliver a ruling from. Nothing was written."

  case "$verdict" in
    # A REPORTED TASK HAS NO TURN LEFT TO DELIVER INTO. Queueing here would
    # write a file nothing ever reads, and the brainer would believe a
    # correction landed. The CURRENT task's marker — task N after `hw next`.
    reported)
      die "$pane has already reported task $seq, so there is no turn end left to deliver into. Nothing was written. A correction for its NEXT task belongs in the brief you hand it with hw next." ;;
    # REPORTING RIGHT NOW: its done-invoker has already looked for a queued
    # ruling and is delivering the report. Accepting one here is exactly the
    # correction that "was queued and never arrived".
    reporting)
      die "$pane is reporting task $seq right now — its done-invoker is running and has already checked for rulings. Nothing was written. A correction for its NEXT task belongs in the brief you hand it with hw next." ;;
    # AN IDLE RECEIVER DOES NOT NEED A QUEUE. channel-send delivers to it now,
    # and queueing would wait for a turn end that only happens once the
    # executor starts working again.
    idle)
      die "$pane is idle (herdr agent_status=$status, no child running): channel-send --ruling delivers to it NOW and its gate will not refuse. Nothing was queued — queueing would wait for a turn end that has not started." ;;
    working|awaiting_child) ;;
    *) die "internal: unknown executor state '$verdict' for $pane. Nothing was written." ;;
  esac

  if [ "$dry" = 1 ]; then
    local waiting; waiting="$(ruling_queue_pending "$rundir" | wc -l | tr -d ' ')"
    printf '  would queue a ruling for %s (%s, task %s) in %s, behind %s undelivered (cap %s)\n  delivered at its next turn end, or by its done-invoker if it reports first; nothing is queued by this dry run\n' \
      "$pane" "$verdict" "$seq" "$rundir" "$waiting" "$RULING_QUEUE_CAP"
    return 0
  fi

  # A QUEUE, NOT A SLOT. The old single slot existed so that two corrections
  # could not become one blob or overwrite each other; each queued ruling is
  # its own file, numbered in arrival order, delivered oldest first with its
  # place named (state-witness.sh, THE RULING QUEUE).
  local tmp="$rundir/.pending-ruling.$$" queued rc=0 entry pos
  printf '%s\n' "$text" > "$tmp" || die "could not write the ruling beside $rundir"
  queued="$(ruling_queue_add "$rundir" "$tmp")" || rc=$?
  case "$rc" in
    0) ;;
    3) die "$pane already has $RULING_QUEUE_CAP undelivered rulings queued in $rundir (pending-ruling.*), the cap. Nothing was written. An executor that has not reached a turn end for that many corrections is stuck or deep in one long turn: read what is queued, and if the brief itself has changed, it belongs in a new brief, not in a sixth correction." ;;
    *) die "could not queue the ruling in $rundir. Nothing was written." ;;
  esac
  entry="${queued%%$'\t'*}"; pos="${queued##*$'\t'}"

  # WRITE, THEN LOOK. done-invoker writes its `reporting` marker and THEN
  # claims any pending ruling; this writes the ruling and THEN looks for that
  # marker (and the done it leads to). Whichever order the two land in, one of
  # them sees the other — so a ruling is either delivered by done-invoker or
  # retracted here and refused, never accepted and lost. The retraction is a
  # claim like any other (`mv` of one name is atomic): if it fails, someone
  # already took the ruling, and that someone delivers it.
  local taskdir
  taskdir="$(witness_task_dir "$rundir")"
  if witness_reporting_live "$taskdir/reporting" \
     || { [ -f "$taskdir/done" ] && [ ! -f "$taskdir/reopened" ]; }; then
    if mv "$entry" "$rundir/.pending-ruling.retracted.$$" 2>/dev/null; then
      rm -f "$rundir/.pending-ruling.retracted.$$"
      die "$pane began reporting task $seq while this ruling was being queued, so it was taken back rather than left where nothing reads it. Nothing is queued. A correction for its NEXT task belongs in the brief you hand it with hw next."
    fi
    ok "ruling for $pane was claimed at once by its reporting done-invoker, which shows it to the executor and refuses to report until it is addressed."
    return 0
  fi
  transcript_append "$rundir" "RULING-QUEUED" "ruling:${entry##*.} task=$seq" "$text"
  ok "ruling queued for $pane ($verdict, task $seq), number $pos in its queue — delivered at its next turn end, or by its done-invoker if it reports first; either way before the task can close, and after every ruling queued ahead of it. It is NOT delivered yet; $rundir/ruling-delivered.${entry##*.} records it once it lands."
}

# KEEP THE EXECUTOR'S ENGRAM SESSION SELECTABLE, at every turn end.
#
# A `mem_save` that names no session is routed by engram to the ONE active
# runtime session registered for its project and worktree
# (internal/mcp/mcp.go resolveFallbackSessionID -> store.ActiveRuntimeSessions).
# A session with a lease counts only while the lease is live, and
# `POST /sessions` writes a 30-minute lease (engram DOCS.md, "Sessions"). So the
# registration hw makes at launch stops being chosen half an hour later, and
# from then on an unlabelled save falls into manual-save-<label> — for three
# product lanes a row owned by `brain` that refuses it. Measured against a
# private serve on 2026-09-28: the same save lands before the lease expires and
# is refused after.
#
# This runs in the executor at every turn end, for every vendor (the claude and
# codex Stop hook, the opencode `hw-turn-ended` plugin), so the lease is renewed
# without the model doing anything. It renews ONLY the session the receipt
# names, ONLY on a serve proven to be this machine's store, and never fails or
# prints: the turn-end protocol owns stdout.
#
# WHAT IT DOES NOT COVER: one turn longer than 30 minutes whose save omits
# session_id. done-invoker's observation check is what catches that.
_engram_renew_session() {
  local state_dir="$1" id project dir url
  [ -r "$state_dir/receipt.jsonl" ] || return 0
  id="$(jq -r 'select(.key=="engram_session") | .value' "$state_dir/receipt.jsonl" 2>/dev/null | tail -1 || true)"
  case "$id" in hw-*) ;; *) return 0 ;; esac
  project="${ENGRAM_PROJECT:-}"; dir="${HW_WORKDIR:-}"
  [ -n "$project" ] && [ -n "$dir" ] || return 0
  [ -r "$HW_BIN_DIR/engram-serve.sh" ] || return 0
  # shellcheck source=engram-serve.sh
  . "$HW_BIN_DIR/engram-serve.sh"
  url="$(engram_serve_url)"
  engram_serve_verdict "$url" >/dev/null 2>&1 || return 0
  engram_session_post "$id" "$project" "$dir" "$url" >/dev/null 2>&1 || true
  return 0
}

cmd_executor_turn_end() {
  local hook_json=0 state_dir turns=0 hold="" hold_intent="" boundary="" reason marker children=""
  [ "${1:-}" != --hook-json ] || { hook_json=1; shift; }
  [ $# -eq 0 ] || die "usage: hw executor-turn-end [--hook-json]"
  [ -n "${HW_TASK:-}" ] && state_dir="$(_executor_state_dir)" || return 0
  mkdir -p "$state_dir" 2>/dev/null || return 0
  _engram_renew_session "$state_dir"
  # `done` beside `reopened` is a run `hw revive` brought back: its old report
  # stands, and this session owes a new one, so the turn is judged like any
  # unreported run's.
  # THE CURRENT TASK'S MARKER, not task 1's. Keyed on `$state_dir/done` this
  # branch took EVERY turn end of a chained task 2+ once task 1 had reported,
  # and returned before the queued-ruling delivery below: a ruling for task N
  # could never land. MEASURED 2026-09-28 (setup/decisions.md).
  if [ -f "$(_run_done_marker "$state_dir")" ] && [ ! -f "$(_run_reopened_marker "$state_dir")" ]; then
    rm -f "$state_dir/handback-refused" 2>/dev/null || true
    # COUNT WHAT HAPPENS AFTER THE REPORT — hw was blind in exactly the window
    # where the damage is done. This branch used to return here and publish
    # nothing, so the moment a task reported, `turns` FROZE and the pane
    # stopped saying anything about itself. That window is not quiet: it is
    # where a reported pane stays open and a human starts using it, and `hw
    # done` closing that pane closes a live session out from under them.
    #
    # A SEPARATE COUNTER, AND `turns` IS REPUBLISHED UNCHANGED. `turns` counts
    # turn-ENDS (see the increment below) and several things read it with that
    # meaning; folding post-report turns into it would change what every one of
    # them is looking at. So this counts beside it, in its own file and its own
    # token, and the `turns` token carries its frozen value verbatim — read,
    # never incremented, on this path.
    #
    # WHY THIS ONE IS THE FACT hw done CAN ACT ON: after a report, hw dispatches
    # nothing into this pane. `hw next` is the only re-task route and it
    # ADVANCES THE TASK COUNTER FIRST, which opens a new task with no marker and
    # takes this branch out of play. So a turn ending here was given to the pane
    # by somebody who is not hw.
    #
    # AND IT IS SCOPED TO THE CURRENT TASK, which the first version of this was
    # NOT. MEASURED 2026-09-16 (blind judge B, reproduced here): the condition
    # above keys on `$state_dir/done`, TASK 1's marker, and `hw next` never
    # touches it — it advances `$rundir/task` and creates `t<N>/`. So once task 1
    # reports, EVERY later chained task takes this branch for its ORDINARY turn
    # ends. An unscoped counter therefore counted task 2's own dispatched work as
    # post-report turns, and `hw done` would then refuse a chained task's
    # ordinary close with "N turn(s) ended AFTER its report, and hw dispatched
    # none of them" — about turns hw dispatched itself. That is precisely the
    # --force-everywhere guard this design refuses to be.
    #
    # An earlier comment here claimed a chained task "never reaches this branch".
    # That was wrong, and it was wrong in the direction that hides the bug.
    #
    # THE RECORD CARRIES ITS SEQ, so a new task starts its own count instead of
    # inheriting the last one's, and `hw done` can tell whether the number it is
    # reading belongs to the task it is closing. The branch's control flow is
    # untouched: this still returns 0 and a reported executor still goes quiet.
    local post=0 post_seq="" cur_seq recorded
    cur_seq="$(_chaining_current_task "$state_dir")"
    # Counted only once the CURRENT task has reported — which the branch
    # condition now guarantees. It used to be checked here, inside a branch
    # keyed on task 1's marker, and a chained task that had not reported
    # returned 0 from this point: publishing nothing (the first version
    # published a false `ended_after_report`, caught in re-judgment), and also
    # judging nothing and delivering no queued ruling. Such a turn now takes the
    # ordinary path below, like task 1's.
    if [ -r "$state_dir/turns-post-report" ]; then
      recorded="$(cat "$state_dir/turns-post-report" 2>/dev/null || true)"
      post_seq="${recorded%% *}"
      post="${recorded##* }"
    fi
    case "$post" in ''|*[!0-9]*) post=0 ;; esac
    [ "$post_seq" = "$cur_seq" ] || post=0
    post=$((post + 1))
    printf '%s %s\n' "$cur_seq" "$post" > "$state_dir/turns-post-report" 2>/dev/null || true
    [ ! -r "$state_dir/turns" ] || turns="$(tr -dc '0-9' < "$state_dir/turns" 2>/dev/null || true)"
    case "$turns" in ''|*[!0-9]*) turns=0 ;; esac
    # `ended_after_report`, not a new word outside the family: channel-send's
    # `_turn_has_ended` matches `ended*` and a turn HAS ended here. Every other
    # consumer matches a specific state exactly (`ended_unreported`,
    # `handback_refused`), so this adds a state without shadowing one.
    # THE TOKEN CARRIES THE SAME `<seq> <count>` RECORD AS THE FILE, in one
    # value. The seq has to travel with the count — a token has a 24h TTL and
    # outlives the task it describes, so a reader that cannot tell which task it
    # belongs to would do exactly what the on-disk seq exists to prevent. One
    # value rather than two tokens because `_executor_turn_publish` carries one
    # extra pair per call, and two calls would be two records that can disagree.
    _executor_turn_publish ended_after_report "$turns" turns_post_report "$cur_seq $post"
    return 0
  fi

  [ ! -r "$state_dir/turns" ] || turns="$(tr -dc '0-9' < "$state_dir/turns" 2>/dev/null || true)"
  case "$turns" in ''|*[!0-9]*) turns=0 ;; esac
  turns=$((turns + 1))
  printf '%s\n' "$turns" > "$state_dir/turns" 2>/dev/null || true

  # A QUEUED RULING LANDS HERE, AND THIS IS THE ONLY CLEAN BOUNDARY THERE IS.
  # `channel-send --ruling` refuses a WORKING receiver for a good reason: a
  # ruling changes the premise of the work, and injected mid-turn it lands
  # wherever the current loop happens to be -- possibly after the work it was
  # meant to correct. The two exits it named were "let it finish" and "stop it
  # and use hw next", and on 2026-09-11 a brainer read the second as `hw done`
  # and destroyed an executor's whole session over a three-line correction.
  #
  # A turn end IS a clean boundary, it belongs to the executor, and this hook
  # already runs inside it. So a third exit exists now: `hw ruling` queues, and
  # the correction is delivered here -- before the executor decides whether its
  # turn is over, and without anyone killing a session or holding a wait open.
  #
  # DELIVERED EXACTLY ONCE: the file is consumed before it is handed over, so a
  # crash between the two loses the ruling rather than repeating it. A repeated
  # ruling is worse -- the brainer cannot tell a re-delivery from a second
  # correction, and this is the class of bug `channel-send` exit 5 exists for.
  # CLAIMED WITH `mv`, not read-then-remove: done-invoker and `hw ruling`'s
  # retraction claim the same name, and exactly one `mv` of it succeeds.
  # Every queued ruling lands at this ONE boundary, oldest first and each
  # labelled with its place: holding the later ones for later turn ends would
  # let the executor act on a correction its brainer has already corrected.
  _load_state_witness
  local ruling
  if ruling="$(ruling_queue_claim_all "$state_dir" turn-end)"; then
    if [ -n "$ruling" ]; then
      _executor_turn_publish ended_with_ruling "$turns" ruling "${ruling:0:80}"
      if [ "$hook_json" = 1 ]; then
        REASON="RULING FROM YOUR BRAINER, delivered at this turn end because it changes the premise of your work. Read it before doing anything else, and if it contradicts what you have already done, say so rather than quietly redoing it.

$ruling" python3 - <<'PY'
import json
import os
print(json.dumps({"decision": "block", "reason": os.environ["REASON"]}, separators=(",", ":")))
PY
      fi
      return 8
    fi
  fi


  # ask-invoker writes its hold into the CURRENT task's dir (invoker_state_dir:
  # the run root for task 1, t<N>/ after `hw next`). Read there: since chained
  # task turn ends reach this path, a root-only read refused a legal wait.
  local task_dir; task_dir="$(_run_done_marker "$state_dir")"; task_dir="${task_dir%/done}"
  hold="$(_executor_pending_reply "$task_dir" || true)"
  if [ -n "$hold" ]; then
    hold_intent="${hold%%$'\t'*}"
    rm -f "$state_dir/handback-refused" 2>/dev/null || true
    _executor_turn_publish ended_holding "$turns" hold_kind "$hold_intent"
    return 0
  fi

  if [ -r "$state_dir/human-boundary" ]; then
    boundary="$(tr '\n' ' ' < "$state_dir/human-boundary" 2>/dev/null || true)"
    rm -f "$state_dir/human-boundary" "$state_dir/handback-refused" 2>/dev/null || true
    _executor_turn_publish ended_human_boundary "$turns" human_boundary "${boundary:0:80}"
    return 0
  fi

  children="$(_executor_live_children || true)"
  if [ -n "$children" ]; then
    rm -f "$state_dir/handback-refused" 2>/dev/null || true
    _executor_turn_publish ended_awaiting_child "$turns" children_running "$children"
    return 0
  fi

  reason="$(_executor_turn_reason)"
  marker="$state_dir/handback-refused"
  printf 'at=%s\nturns=%s\nreason=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$turns" "$reason" > "$marker" 2>/dev/null || true
  _executor_turn_publish handback_refused "$turns"
  if [ "$hook_json" = 1 ]; then
    REASON="$reason" python3 - <<'PY'
import json
import os
print(json.dumps({"decision": "block", "reason": os.environ["REASON"]}, separators=(",", ":")))
PY
  fi
  return 8
}

# ── Port allocation ─────────────────────────────────────────────────────────
# Deterministic offset from the task name: the same task always asks for the
# same ports across re-runs, so bookmarks and OAuth callbacks keep working.
_offset() { printf '%s' "$1" | cksum | awk '{print $1 % 40}'; }

# lsof is not installed by default on many Linux images; ss (iproute2) is. Try what exists.
_port_free() {
  if command -v lsof >/dev/null 2>&1; then ! lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
  elif command -v ss >/dev/null 2>&1; then
    local listeners
    listeners="$(ss -Hltn "sport = :$1")" || return 0  # ss failed: no answer, not "busy"
    [ -z "$listeners" ]
  else return 0; fi
}

# Deterministic first choice, then the next free port upward. Determinism is a
# preference, not a guarantee — a busy port must yield or the server won't boot.
# Claim the port with a lock directory before returning it. Checking a port and
# then handing it back reserves nothing: three concurrent launches all picked
# 3150, and the losers either failed to boot (vite --strictPort) or silently
# drifted off the URL hw printed (Next.js auto-increment).
_pick_port() {
  local p="$1" tries=0 lockdir
  mkdir -p "$PORT_LOCKS"
  while :; do
    lockdir="$PORT_LOCKS/$p"
    if _port_free "$p" && mkdir "$lockdir" 2>/dev/null; then
      # A lock from a launch that died is not a reservation. 10 minutes is far
      # longer than any hw run and far shorter than a working day.
      printf '%s' "$$" > "$lockdir/pid"
      printf '%s' "$p"; return 0
    fi
    # A FAILED `find` IS NOT A STALE LOCK, and this branch DELETES the lock and
    # hands the port to a second launcher. `find … 2>/dev/null` printed nothing
    # when it failed exactly as when the lock was fresh, and `-z` read both as
    # "stale". Found 2026-09-07 by a Judgment Day judge, which also found that
    # the `unmeasured` lint rule could not see it: `[ -d "$lockdir" ]` on the
    # same line tripped the existence exclusion, and that guard answers a
    # DIFFERENT question — an existing directory is precisely the case where
    # `find` can still fail.
    #
    # Structurally this is `channel-send:1448`, which was allowlisted as safe by
    # direction. Here the direction is the unsafe one: there, a failed read
    # keeps the lock and someone waits; here it reaps the lock and two launchers
    # get the same port.
    if [ -d "$lockdir" ]; then
      _fresh="$(find "$lockdir" -mmin -10 2>/dev/null)" && _find_rc=0 || _find_rc=$?
      if [ "$_find_rc" -eq 0 ] && [ -z "$_fresh" ]; then
        rm -rf "$lockdir" 2>/dev/null || true
        continue
      fi
    fi
    p=$((p + 1)); tries=$((tries + 1))
    [ "$tries" -gt 60 ] && die "no free port near $1"
  done
}

# ── herdr helpers ───────────────────────────────────────────────────────────
# Panes are addressable ONLY by id (herdr 0.8.0: every pane subcommand takes
# <PANE_ID> like w1:p2; `pane rename` sets a display label, and `pane focus` is
# directional). So ids are captured from each command's JSON and threaded on.
_ws_id_by_label() {
  herdr workspace list 2>/dev/null \
    | jq -r --arg l "$1" '.result.workspaces[] | select(.label == $l) | .workspace_id' 2>/dev/null \
    | head -1 || true
}

# A TAB LABEL IS A REAL HANDLE, unlike a pane's. `pane rename` sets a display
# label that `pane list` does not return, so a pane can never be found by name
# again. `tab rename` sets `.label` and `tab list` returns it — verified — which
# is what lets `hw done` find the tab it created without trusting a variable that
# died with the launching shell.
_tab_id_by_label() {
  herdr tab list 2>/dev/null \
    | jq -r --arg l "$1" '.result.tabs[] | select(.label == $l) | .tab_id' 2>/dev/null \
    | head -1 || true
}

# A TAB IS NOT AN AGENT, AND `hw` USED TO TREAT THEM AS THE SAME FACT.
# Measured 2026-08-26: with `setup:dead-receiver-preflight`'s tab alive and its
# agent pane closed, a relaunch printed `✓ tab … already exists (w4C:t21) —
# focused, nothing rebuilt` and exited 0 having started nothing and delivered
# nothing. The brainer believed a task was running; the tab held a shell and no
# agent, and it had to be closed by hand. "Nothing rebuilt" was true and
# useless — the question is whether there is anything left to reuse.
#
# So: count the panes herdr reports an `agent` for inside the container. Not
# `pane_count` (a lone shell counts), and not the tab's `agent_status` (herdr
# reports `-` for both "no agent" and "agent hasn't been classified yet") —
# the pane list carries the vendor per pane, which is the fact being asked for.
_live_agent_panes_in_tab() {
  herdr pane list 2>/dev/null \
    | jq -r --arg t "$1" '[.result.panes[] | select(.tab_id == $t and .agent != null)] | length' \
      2>/dev/null || printf '0'
}

_live_agent_panes_in_workspace() {
  herdr pane list 2>/dev/null \
    | jq -r --arg w "$1" '[.result.panes[] | select(.workspace_id == $w and .agent != null)] | length' \
      2>/dev/null || printf '0'
}

# The project's workspace, created on demand and NEVER closed by hw. Other tabs
# may be live, and closing the last tab takes the workspace with it (measured),
# so hw has no business deciding a project is finished. The creation reply is
# retained because its forced first tab belongs to the first task.
PROJECT_WORKSPACE=""
PROJECT_WORKSPACE_CREATE_REPLY=""
_project_workspace() {
  local label ws raw
  PROJECT_WORKSPACE=""
  PROJECT_WORKSPACE_CREATE_REPLY=""
  label="$(project_space_label "$1")" \
    || { warn "no workspace label for project '$1'"; return 1; }
  ws="$(_ws_id_by_label "$label")"
  if [ -n "$ws" ]; then PROJECT_WORKSPACE="$ws"; return 0; fi
  raw="$(_capture herdr workspace create --cwd "$HW_WORKDIR" --label "$label" --no-focus)" \
    || { warn "herdr workspace create failed for $label: $(printf '%s' "$raw" | head -1)"; return 1; }
  ws="$(printf '%s' "$raw" | jq -r '.result.workspace.workspace_id // .result.workspace_id' 2>/dev/null || true)"
  [ -n "$ws" ] && [ "$ws" != null ] || { warn "herdr workspace create returned no id for $label"; return 1; }
  PROJECT_WORKSPACE="$ws"
  PROJECT_WORKSPACE_CREATE_REPLY="$raw"
}

# `_first_pane_of_ws` used to live here: `workspace create` gave hw one pane and
# hw then split off the rest. Gone with the incremental build — `layout.apply`
# replaces the workspace's first tab wholesale, so that pane never survives long
# enough to be worth looking up, and `workspace create` already returns both
# `tab.tab_id` and `root_pane.pane_id` in its own reply anyway.

# Run a herdr command and capture its output without letting `set -e` win.
#
# `X="$(herdr … | jq …)"` looks guarded by the `|| die` on the next line, but it
# is not: under `pipefail` a herdr failure makes the assignment non-zero and
# set -e kills the script first, so every one of those die messages was
# unreachable and herdr being down produced exit 1 with no diagnosis at all.
_capture() {
  local __out __rc=0
  __out="$("$@" 2>&1)" || __rc=$?
  printf '%s' "$__out"
  return $__rc
}

# A FAILED CLOSE IS NOT EVIDENCE OF ABSENCE. `hw done` used to translate every
# non-zero close into "already gone", including a live target refusing to close
# and an unreachable herdr server. Ask herdr's corresponding list after a
# failure. Only a successful, parseable list that omits the exact id licenses
# "already gone"; every other shape is a real cleanup failure.
_HERDR_CLOSE_REASON=""
_herdr_object_exists() {  # $1 = pane|tab|workspace, $2 = exact id
  local kind="$1" id="$2" out rc=0 array field
  case "$kind" in
    pane)      array=panes;      field=pane_id ;;
    tab)       array=tabs;       field=tab_id ;;
    workspace) array=workspaces; field=workspace_id ;;
    *) _HERDR_CLOSE_REASON="unknown herdr object kind: $kind"; return 2 ;;
  esac
  out="$(_capture herdr "$kind" list)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    _HERDR_CLOSE_REASON="list exited $rc: $(printf '%s' "$out" | head -3 | tr '\n' ' ')"
    return 2
  fi
  if ! printf '%s' "$out" | jq -e --arg a "$array" '.result[$a] | type == "array"' >/dev/null 2>&1; then
    _HERDR_CLOSE_REASON="list returned no parseable .result.$array array"
    return 2
  fi
  printf '%s' "$out" | jq -e --arg a "$array" --arg f "$field" --arg id "$id" \
    'any(.result[$a][]; .[$f] == $id)' >/dev/null 2>&1
}

# WHAT THE LAST CALL DID, as a fact a caller can name: `closed` (herdr closed it),
# `absent` (the close failed and herdr's own list proves the object is gone) or
# `failed` (it may still be running). The return code cannot say it — 0 covers
# both `closed` and `absent`, and `hw done` used to print the same reassuring
# line for the two.
_HERDR_CLOSE_RESULT=""
_close_herdr_object() {  # $1 = kind, $2 = id, $3 = success text, $4 = absent text
  local kind="$1" id="$2" success="$3" absent="$4" out rc=0 probe_rc=0 reason
  _HERDR_CLOSE_RESULT=failed
  out="$(_capture herdr "$kind" close "$id")" || rc=$?
  if [ "$rc" = 0 ]; then
    _HERDR_CLOSE_RESULT=closed
    ok "$success"
    return 0
  fi
  reason="$(printf '%s' "$out" | head -3 | tr '\n' ' ')"
  : "${reason:=no reason returned}"
  _HERDR_CLOSE_REASON=""
  _herdr_object_exists "$kind" "$id" || probe_rc=$?
  case "$probe_rc" in
    0)
      warn "CLOSE FAILED: $kind $id still exists (close exit $rc: $reason)"
      return 1 ;;
    1)
      _HERDR_CLOSE_RESULT=absent
      info "$absent"
      return 0 ;;
    *)
      warn "CLOSE FAILED: $kind $id could not be closed (exit $rc: $reason)"
      warn "absence could not be verified: $_HERDR_CLOSE_REASON"
      return 1 ;;
  esac
}

# ── One space, one call: layout.apply ───────────────────────────────────────
#
# The old build was `pane split` → `pane rename` → `pane split` → `pane rename`
# → `pane run`, five to seven round trips, and any one of them failing left a
# space half built that `hw done` then had to clean. `layout.apply` takes the
# whole tree — splits, ratios, per-pane cwd, env and label — in ONE request, so
# the structure is either there or it never existed. There is no `herdr layout`
# CLI at all; this is API-only, hence herdr-rpc.
#
# WHAT layout.apply DOES NOT COVER, so nobody tries to push it further:
#   · the agent pane must still be started by `herdr agent start`. That is what
#     writes `managed_agent_kind` into session.json and what puts the
#     pane in `agent list`, which every other piece of this setup keys on. A
#     `command: ["claude", …]` would be an anonymous pane to herdr.
#   · dev servers are still started with `pane run`. A pane whose process IS the
#     command dies with the command — verified: send-keys C-c on a `command:`
#     pane left `pane_not_found` — so Ctrl-C on `pnpm dev` would take the pane
#     and its stack trace with it.
#   · `--here` does not use this at all. layout.apply replaces a whole TAB, and
#     --here's whole point is to split the pane you are sitting in, inside a tab
#     that already holds someone else's work. Rebuilding that tab to add one
#     pane would destroy panes hw did not create. `pane split` is the right
#     primitive there and stays.
#
# Substitution happens AFTER the document is parsed, so a value containing a
# quote or a backslash cannot break the JSON. An unset placeholder is an error.
_render_layout() {
  local tpl="$1"
  [ -r "$tpl" ] || { warn "layout document not readable: $tpl"; return 1; }
  HW_LAYOUT_TPL="$tpl" python3 - <<'EOF'
import json, os, string, sys
tpl = os.environ["HW_LAYOUT_TPL"]
try:
    with open(tpl) as fh:
        doc = json.load(fh)
except Exception as e:
    print(f"{tpl}: {e}", file=sys.stderr); sys.exit(1)

# The executor environment, merged into every pane. Kept here and NOT in the
# documents so that the day hw adds a variable, no lane silently misses it.
base_env = {k: os.environ[k] for k in
            ("HW_PROJECT", "HW_TASK", "HW_WORKDIR", "HW_RUN", "HW_ARTIFACTS",
             "ENGRAM_PROJECT",
             "HW_EXECUTOR_VENDOR", "HW_INVOKER_VENDOR", "HW_INVOKER_SESSION",
              "HW_INVOKER_ENDPOINT", "HW_INVOKER_PANE", "HW_NO_REPORT",
              "HW_CHAINING_ENABLED", "HW_LAUNCH_MODE", "HW_NEXT_WAIT_MS",
             "HW_AGENT_PORT", "HW_AGENT_ENDPOINT",
             "HW_PORT_WEB", "HW_PORT_API",
             "HW_REVIEW_BASE_REF", "HW_REVIEW_BASE_BRANCH",
             "AGENT_BROWSER_NAMESPACE", "HW_BROWSER_PROFILE",
             "CLAUDE_CONFIG_DIR",
             "OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS",
             # --effort for opencode. hw exports these only when THIS dispatch
             # built an overlay, and unsets them otherwise — see
             # _export_opencode_overlay — so a brainer's own value never rides in.
             "OPENCODE_CONFIG_CONTENT",
             "HW_OPENCODE_EFFORT", "HW_OPENCODE_EFFORT_AGENT",
             "OPENCODE_CONFIG")
            if os.environ.get(k)}
# Keyed on the lane's own declaration, not on OPENCODE_CONFIG_DIR: an inherited
# one must not reach a pane whose lane never named it.
if os.environ.get("OPENCODE_EXECUTOR_CONFIG"):
    base_env["OPENCODE_CONFIG_DIR"] = os.environ["OPENCODE_EXECUTOR_CONFIG"]

missing = set()

def subst(s):
    try:
        return string.Template(s).substitute(os.environ)
    except KeyError as e:
        missing.add(e.args[0]); return s

def walk(node):
    if isinstance(node, dict):
        # `_`-prefixed keys are this format's comments; JSON has none of its own.
        out = {k: walk(v) for k, v in node.items() if not k.startswith("_")}
        if out.get("type") == "pane":
            env = dict(base_env)
            env.update(out.get("env") or {})
            out["env"] = env
        return out
    if isinstance(node, list):
        return [walk(v) for v in node]
    if isinstance(node, str):
        return subst(node)
    return node

rendered = walk(doc)
if missing:
    print(f"{tpl}: unset placeholders: {', '.join(sorted(missing))}", file=sys.stderr)
    sys.exit(1)
json.dump(rendered, sys.stdout)
EOF
}

# Apply a lane's document and hand back the result, which carries the pane ids.
# LAYOUT_DOC is the RENDERED document, kept because it is the only place the
# complete per-pane environment exists — `layout.apply`'s reply does not echo
# `env` back. _build_space writes the restore env file from it.
LAYOUT_DOC=""
_layout_apply() {
  local tpl="$1" doc
  doc="$(_render_layout "$tpl")" || return 1
  LAYOUT_DOC="$doc"
  printf '%s' "$doc" | "$HERDR_RPC" layout-apply - 2>&1
}

# Pane ids come back BY LABEL, so hw never has to know the shape of the tree it
# just sent — a document can be re-nested without touching this file.
_pane_by_label() {
  printf '%s' "$1" \
    | jq -r --arg l "$2" 'first(.. | objects | select(.type == "pane" and .label == $l) | .pane_id) // empty' \
      2>/dev/null || true
}

# What to close after a failed layout — ONLY what this task created.
#
# MEASURED 2026-09-24, first dispatch on a new macOS user: the layout failed in
# tab mode and the advice was `herdr workspace close w2`. In tab mode $WS is the
# LANE's workspace, found by label, and the lane's brainer lives in it — so the
# advice, followed, kills the brainer and every other task's tab. The object this
# task made is the tab — even on the lane's first dispatch, when hw created the
# workspace too, because `brain <lane>` opens its brainer in that same workspace
# and the advice outlives the moment it was printed. Only in space mode is the
# workspace this task's and nobody else's.
_layout_failed_advice() {
  if [ "${TAB:-0}" = 1 ]; then
    printf 'tab %s was created in %s but has no layout — close that tab with: herdr tab close %s  (NOT the workspace: %s is the lane'"'"'s, and its brainer lives there)' \
      "$HW_TAB" "$WS" "$HW_TAB" "$WS"
  else
    printf 'space %s was created but has no layout — close it with: herdr workspace close %s  (hw created it for this task; nothing else lives there)' "$WS" "$WS"
  fi
}

# Build the space: workspace, then the whole tab in one call.
#
# NOTE ON THE WORKSPACE'S FIRST PANE: `layout.apply` with a tab_id REPLACES that
# tab — verified, the request named wJ:t1 and the result came back as a brand
# new wJ:t2 with three fresh panes and no leftovers, and the `pane_id` field a
# pane node accepts did NOT preserve the old pane. So `workspace create` gets no
# --env: whatever it puts on that first pane is discarded a moment later, and
# passing it would only suggest otherwise. --cwd stays, because that is the
# workspace's identity_cwd, which outlives the tab.
#
# Sets: WS, and one P_<LABEL> style id per pane via _pane_by_label on LAYOUT_OUT.
_build_space() {
  local tpl="$1" ws_raw tab

  if [ "${TAB:-0}" = 1 ]; then
    # ONE TAB PER AGENT, one workspace per project. See setup/plans/agent-tabs.md.
    _project_workspace "$PROJ" || die "could not find or create the workspace for $PROJ"
    WS="$PROJECT_WORKSPACE"
    if [ -n "$PROJECT_WORKSPACE_CREATE_REPLY" ]; then
      # `workspace create` forces a first tab. Use it for the first task, exactly
      # as bin/brain uses it for the first brainer, rather than leaving a shell
      # behind and creating a redundant second tab.
      ws_raw="$PROJECT_WORKSPACE_CREATE_REPLY"
    else
      # No --label here even though tab create accepts one: layout.apply replaces
      # this tab and DESTROYS its label (measured — w3G:t2 came back as w3G:t3 with
      # an empty label). The name is set after the layout, below.
      ws_raw="$(_capture herdr tab create --workspace "$WS" --cwd "$HW_WORKDIR" --no-focus)" \
        || die "herdr tab create failed in $WS: $(printf '%s' "$ws_raw" | head -3)"
    fi
  else
    ws_raw="$(_capture herdr workspace create --cwd "$HW_WORKDIR" --label "$LABEL" --no-focus)" \
      || die "herdr workspace create failed: $(printf '%s' "$ws_raw" | head -3)"
    WS="$(printf '%s' "$ws_raw" | jq -r '.result.workspace.workspace_id // .result.workspace_id' 2>/dev/null || true)"
    [ -n "$WS" ] && [ "$WS" != null ] || die "herdr workspace create returned no id: $(printf '%s' "$ws_raw" | head -3)"
  fi
  # RECORD WHAT WE OWN. Without this the only way to clean up after a test run
  # is by exclusion — "close everything that is not w1/wB/wC" — and that loop
  # has killed a live brainer's own executors, minutes after each launch,
  # while looking exactly like a multiplexer bug.
  # An id in a variable dies with the process; an id on disk can be verified
  # against before anything is closed. Ownership is the only safe basis for a
  # close, and it has to outlive the shell that created the space.
  # Only in space mode. In tab mode hw does NOT own the workspace — it may hold
  # other agents' tabs — and a `workspace` record is exactly what would license a
  # `workspace close` on it. The tab record is written after the layout, because
  # layout.apply hands back a DIFFERENT tab id than the one it was given.
  if [ "${TAB:-0}" != 1 ] && [ -n "${HW_WORKDIR:-}" ] && [ -n "${HW_RUN:-}" ]; then
    mkdir -p "$HW_WORKDIR/.hw/$HW_RUN" 2>/dev/null || true
    printf '%s\n' "$WS" > "$HW_WORKDIR/.hw/$HW_RUN/workspace" 2>/dev/null || true
  fi
  tab="$(printf '%s' "$ws_raw" | jq -r '.result.tab.tab_id // .result.root_pane.tab_id // .result.tab_id' 2>/dev/null || true)"
  [ -n "$tab" ] && [ "$tab" != null ] || die "no tab id in the create reply: $(printf '%s' "$ws_raw" | head -3)"

  HW_TAB="$tab"; export HW_TAB
  LAYOUT_OUT="$(_layout_apply "$tpl")" || {
    # The space exists but has no layout. Say so with its id: an empty space is
    # recoverable by hand, and silently leaving one behind is how orphans happen.
    warn "layout.apply failed for $tpl:"
    printf '%s\n' "$LAYOUT_OUT" | head -3 >&2
    die "$(_layout_failed_advice)"
  }

  # THE TAB ID CHANGED. layout.apply replaces the tab it is given and returns a
  # new id, so the id to name and to record is the one in the REPLY, never the one
  # we asked for. Recording the pre-layout id would point `hw done` at a tab that
  # no longer exists, which reads as "already gone" and silently leaves the real
  # one open.
  if [ "${TAB:-0}" = 1 ]; then
    local live_tab
    live_tab="$(printf '%s' "$LAYOUT_OUT" | jq -r '.layout.tab_id // .result.layout.tab_id // empty' 2>/dev/null || true)"
    [ -n "$live_tab" ] || live_tab="$HW_TAB"
    HW_TAB="$live_tab"; export HW_TAB
    herdr tab rename "$HW_TAB" "$LABEL" >/dev/null 2>&1 \
      || warn "could not name tab $HW_TAB — \`hw done\` will fall back to the run record"
    if [ -n "${HW_WORKDIR:-}" ] && [ -n "${HW_RUN:-}" ]; then
      mkdir -p "$HW_WORKDIR/.hw/$HW_RUN" 2>/dev/null || true
      printf '%s\n' "$HW_TAB" > "$HW_WORKDIR/.hw/$HW_RUN/tab" 2>/dev/null || true
    fi
  fi

  # After the layout, not before: the file records what the panes were actually
  # given, and its own union comes from the same rendered document.
  _write_run_env "$HW_WORKDIR" "$(_layout_env_union "$LAYOUT_DOC")" "$(_invoker_pane)"
  if [ "${TAB:-0}" = 1 ]; then
    ok "layout applied in one call ($(basename "$tpl")) — tab $HW_TAB in $WS ($LABEL)"
  else
    ok "layout applied in one call ($(basename "$tpl"))"
  fi
}

# Codex-specific final readiness check. Herdr 0.8.2 can report idle from its
# known-agent fallback while one of these dialogs still owns stdin.
_codex_startup_ready() {
  local name="$1" screen
  screen="$(herdr agent read "$name" --source detection --lines 80 2>/dev/null || true)"
  case "$screen" in
    *"Do you trust the contents of this directory"*)
      herdr agent send-keys "$name" enter >/dev/null 2>&1 || return 1
      sleep 2
      ;;
    *"Hooks need review"*)
      printf '%s\n' "codex is waiting for hook trust; review that dialog before delivering a brief" >&2
      return 1
      ;;
    *"Choose how you'd like Codex to proceed"*)
      printf '%s\n' "codex is waiting on a model migration dialog; choose a supported model before delivering a brief" >&2
      return 1
      ;;
  esac
  return 0
}

# Claude Code's first-run screens, read off the pane before it is called ready
# or given up on. MEASURED 2026-09-24 on a new macOS user: "Try the new
# fullscreen renderer?" held the executor's stdin, herdr never reported
# interactive_ready, and `_agent_start` failed with nothing on screen named.
#
# ONE screen is answered here, and only with the option that changes nothing:
# the renderer offer, with "Not now" (Esc), which keeps the renderer the account
# already has. Every other first-run screen is the person's or is a setup
# defect, so it is NAMED and the start fails — the Bypass Permissions warning
# above all, which nothing in this toolchain accepts on anyone's behalf.
# Returns 0 when nothing is in the way (or the offer was dismissed).
_claude_startup_ready() {
  local target="$1" screen dialog
  screen="$(herdr agent read "$target" --source detection --lines 80 2>/dev/null || true)"
  dialog="$(printf '%s' "$screen" | claude_startup_dialog)"
  case "$dialog" in
    "") return 0 ;;
    fullscreen-offer)
      info "claude opened on its fullscreen-renderer offer — answering \"Not now\" (Esc), which keeps the renderer as it is"
      herdr agent send-keys "$target" esc >/dev/null 2>&1 || return 1
      sleep 2
      return 0 ;;
    *)
      printf 'claude is waiting on a first-run screen (%s): %s\n' "$dialog" "$(claude_dialog_advice "$dialog" "${ACCOUNT_CONFIG_DIR:-}")" >&2
      return 1 ;;
  esac
}

# When a Claude start is given up on, say what the pane was SHOWING. An unknown
# dialog is still a dialog; its last lines name it better than "did not start".
_claude_start_failure_screen() {
  local target="$1" screen
  screen="$(herdr agent read "$target" --source detection --lines 80 2>/dev/null || true)"
  [ -n "$screen" ] || return 0
  printf 'what the pane was showing when hw gave up (last lines):\n' >&2
  printf '%s\n' "$screen" | sed '/^[[:space:]]*$/d' | tail -8 | sed 's/^/    /' >&2
}

# ── the sandbox (--sandbox, or `sandbox: true` in the brief) ────────────────
#
# The executor-isolation decision (2026-09-30), on executor-isolation-arch's
# measurements: Seatbelt, opt-in per dispatch, the
# HARD profile, macOS only. bin/hw-sandbox holds the profile, the broker that
# carries done-invoker/ask-invoker out of it, and why each piece is shaped the
# way it is. What hw owns is the refusal and the arming.
#
# CLAUDE ONLY, because it is the only vendor measured under the profile
# (executor-isolation-arch and setup/e2e-sandbox). OpenCode and Codex keep state in
# places the profile would have to open — ~/.cache/opencode holds the plugins
# other sessions execute — and nobody has measured what they break.
_check_sandbox() {
  SANDBOX_LINE=""
  [ "${SANDBOX:-0}" = 1 ] || return 0
  local why
  why="$("$HW_BIN_DIR/hw-sandbox" supported 2>&1)" || die "--sandbox refused: $why NOTHING was built."
  [ "$AGENT" = claude ] || die "--sandbox refused: it is measured for claude only, and this dispatch runs $AGENT. Dispatch with --agent claude, or without --sandbox. NOTHING was built."
  SANDBOX_LINE="on ($SANDBOX_SRC) — Seatbelt hard profile: writes only in the workdir, artifacts, TMPDIR and the agent's own state; no unix sockets (herdr, docker, ssh-agent); ~/.ssh, ~/.config/gh, ~/.docker unreadable. Reports leave through the outbox broker. TCP is NOT confined."
}

# herdr starts an agent by typing its executable into the pane's shell, and a
# pane's --env PATH does not survive the user's rc files (both measured). So
# the shim hw-sandbox writes is put in front of PATH IN THAT SHELL, just before
# `agent start` types the command.
_sandbox_arm_pane() {  # $1=pane $2=kind $3=rundir
  local pane="$1" kind="$2" rundir="$3" shimdir
  case "$rundir" in /*/.hw/?*) ;; *) warn "sandbox: no run directory to arm ($rundir)"; return 1 ;; esac
  shimdir="$(HW_WORKDIR="${HW_WORKDIR:-}" HW_ARTIFACTS="${HW_ARTIFACTS:-}" "$HW_BIN_DIR/hw-sandbox" arm "$rundir" "$kind" "$PROJ" "$TASK")" \
    || { warn "sandbox: could not arm $rundir — the agent is NOT started unconfined"; return 1; }
  herdr pane run "$pane" "export PATH=$(printf '%q' "$shimdir"):\$PATH; hash -r 2>/dev/null; clear" >/dev/null 2>&1 \
    || { warn "sandbox: could not put the shim on $pane's PATH — the agent is NOT started unconfined"; return 1; }
  _receipt_into "$rundir" sandbox "$(dirname "$shimdir")/profile.sb" "hw-sandbox arm ($kind); shim $shimdir exported in $pane"
}

# Start an agent, retrying while the pane is still coming up. A freshly split
# pane is not at its shell prompt yet, and `agent start` rejects it with
# agent_pane_busy — a race that showed up on the very first route-opt run.
# The sandboxed launch: arm, start through the ordinary path, then PROVE it.
_agent_start_sandboxed() {
  local rundir="${_SANDBOX_RUNDIR:-${HW_WORKDIR:-}/.hw/${HW_RUN:-}}" n=0 st
  _sandbox_arm_pane "$1" "$3" "$rundir" || return 1
  st="$("$HW_BIN_DIR/hw-sandbox" statedir "$rundir")"
  _SANDBOX_ARMED="$1" _agent_start "$@" || return 1
  # AN AGENT THAT STARTED IS NOT PROOF IT STARTED IN THE SANDBOX. The broker
  # is the launch wrapper's own child, so its heartbeat is what says the shim
  # ran and not the bare executable. No heartbeat: refuse, loudly.
  while [ "$n" -lt 20 ]; do
    [ -f "$st/broker.alive" ] && return 0
    sleep 0.5; n=$((n + 1))
  done
  warn "sandbox: $3 started in $1 but the broker never came up ($st/broker.alive) — it may be running UNCONFINED. Close it: hw done $PROJ $TASK"
  return 1
}

_agent_start() {
  local pane="$1" name="$2" kind="$3" out probe tries=0 registered=0
  if [ "${SANDBOX:-0}" = 1 ] && [ "${_SANDBOX_ARMED:-}" != "$pane" ]; then
    _agent_start_sandboxed "$@"; return
  fi
  while [ "$tries" -lt 15 ]; do
    if [ "$registered" = 1 ]; then
      # agent_not_ready keeps the registration. Poll that exact agent; a
      # second creation would collide with our own retained name.
      probe="$(herdr agent get "$pane" 2>/dev/null || true)"
      if ! printf '%s' "$probe" | jq -e --arg pane "$pane" --arg name "$name" --arg kind "$kind" '
           .result.agent | .pane_id == $pane and .name == $name and .agent == $kind
         ' >/dev/null 2>&1; then
        printf '%s\n' "$probe" >&2
        return 1
      fi
      [ "$kind" != codex ] || _codex_startup_ready "$pane" || return 1
      [ "$kind" != claude ] || _claude_startup_ready "$pane" || return 1
      if printf '%s' "$probe" | jq -e '
           .result.agent as $a | $a.interactive_ready == true and
           (["idle", "done"] | index($a.agent_status) != null)
         ' >/dev/null 2>&1; then return 0; fi
      sleep 2; tries=$((tries + 1))
      continue
    fi
    # --timeout is explicit rather than inherited: herdr's own default is
    # 30000ms, measured too short for a real hw worktree's cold start (MCP
    # servers, SessionStart hooks) — two live probes on dead transcripts came up
    # in 4s regardless of transcript size, so the ~50s a real case took is the
    # session's own startup cost, not something a bigger timeout budget can grow
    # past a point. 60000ms covers that measured case within one herdr call
    # while staying far under herdr's 300000ms ceiling.
    if out="$(herdr agent start "$name" --kind "$kind" --pane "$pane" --timeout 60000 ${AGENT_ARGS:+-- $AGENT_ARGS} 2>&1)" \
       && printf '%s' "$out" | jq -e '.result.agent.interactive_ready == true' >/dev/null 2>&1; then
      # Codex 0.149.0 can sit on an interactive startup dialog while Herdr's
      # built-in fallback still reports idle + interactive_ready=true. The
      # first prompt then lands in the dialog and `agent prompt` stalls after
      # five seconds. Read the actual detection buffer before calling it ready.
      [ "$kind" != codex ] || _codex_startup_ready "$name" || return 1
      # Same for Claude: ready can be reported with the renderer offer still
      # on screen, and the brief would land in the dialog.
      [ "$kind" != claude ] || _claude_startup_ready "$pane" || return 1
      return 0
    fi
    case "$out" in
      *agent_pane_busy*) ;;
      *agent_not_ready*)
        registered=1
        ;;
      # A startup timeout is a busted BUDGET, not a busted agent: herdr's own
      # --help says an unfinished start "keeps the name available for `agent
      # read` and `agent send-keys`" — the same guarantee agent_not_ready gives.
      # Treating it as terminal killed a pane that came up alive ~20s later
      # (measured 2026-09-18, w7H:pMZ): hw revive reported REFUSED and named the
      # tab to close while the agent was still starting normally underneath.
      *"timed out waiting for agent startup"*)
        registered=1
        ;;
      *) printf '%s\n' "$out" >&2; return 1 ;;
    esac
    sleep 2; tries=$((tries + 1))
  done
  [ "$kind" != claude ] || _claude_start_failure_screen "$pane"
  return 1
}

# Mark a directory trusted in ~/.claude.json before an agent starts there.
#
# An untrusted workspace makes Claude Code SILENTLY ignore permissions.allow and
# additionalDirectories — no warning, the rules simply do not apply. Every
# directory hw creates was landing untrusted, so every executor ran with its
# allowlist quietly discarded. The user is the one asking for this directory to
# exist, one command earlier; withholding trust from it protects nobody.
#
# Backs up before writing, and never lowers an existing decision to false.
_trust_dir() {
  # THE TRUST GOES IN THE ACCOUNT THE EXECUTOR WILL ACTUALLY RUN UNDER.
  #
  # MEASURED 2026-09-09, on the first real launch of an account-redirected
  # executor. This function hardcoded `$HOME/.claude.json` — the DEFAULT
  # account's file — while the pane came up with CLAUDE_CONFIG_DIR pointing at
  # `~/.claude-personal`, whose own `.claude.json` had no record for that
  # directory. Claude Code opened on its folder-trust dialog ("Is this a project
  # you created or one you trust?"), never reached interactive_ready, and hw
  # reported `claude did NOT start`. Both files were read afterwards: the
  # default's said `hasTrustDialogAccepted: true` for that path and the
  # personal's had no entry for it at all.
  #
  # A redirect that leaves the trust behind does not fail loudly enough to be
  # obvious — it looks like an agent that would not start.
  local dir="$1" cfg="$HOME/.claude.json"
  # `$CFG_DIR/.claude.json` under a redirect; the unredirected default keeps the
  # legacy `~/.claude.json`, which is the file Claude Code reads when
  # CLAUDE_CONFIG_DIR is unset.
  [ -z "${ACCOUNT_CONFIG_DIR:-}" ] || cfg="$ACCOUNT_CONFIG_DIR/.claude.json"
  [ -f "$cfg" ] || return 0
  cp "$cfg" "$cfg.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || { warn "could not back up $cfg; leaving trust alone"; return 0; }
  if DIR="$dir" CFG="$cfg" python3 - <<'EOF'
import json, os, sys
cfg, d = os.environ["CFG"], os.environ["DIR"]
try:
    with open(cfg) as fh: data = json.load(fh)
except Exception:
    sys.exit(1)
p = data.setdefault("projects", {}).setdefault(d, {})
if p.get("hasTrustDialogAccepted") is True:
    sys.exit(2)          # already trusted, nothing written
p["hasTrustDialogAccepted"] = True
tmp = cfg + ".hw-tmp"
with open(tmp, "w") as fh: json.dump(data, fh, indent=2)
os.replace(tmp, cfg)
EOF
  then ok "workspace trusted in $cfg (without this, permissions.allow is silently ignored and Claude Code opens on its folder-trust dialog)"
  else
    case $? in
      2) info "workspace already trusted in $cfg" ;;
      *) warn "could not mark $dir trusted in $cfg — the agent's allowlist may be ignored there, and it may open on the folder-trust dialog instead of starting" ;;
    esac
  fi
  # Prune our own backups so they do not accumulate one per launch.
  ls -t "$cfg".bak-* 2>/dev/null | tail -n +6 | xargs rm -f 2>/dev/null || true
  return 0
}

# Environment every executor pane gets, so `ask-invoker` knows who launched it
# and where its cap file lives. HW_INVOKER_PANE is set in EVERY placement, from
# whatever `_invoker_pane_resolve` could prove — an operator's explicit export
# first, then the inherited HERDR_PANE_ID, then the two heuristics. It used to
# be --here only, on the theory that a stale id is worse than none; that trade
# was measured backwards (see _invoker_pane_resolve) and the resolver now
# refuses a bad explicit id rather than passing it on.
# The same set, exported instead of formatted as flags, because the layout
# documents reference them as ${HW_...} placeholders and `_render_layout` reads
# them from the environment. One definition of "the executor environment" would
# be better than two; there is not one, because --here still needs the flag form
# for `pane split`. Keep the two lists in step — the reason `_render_layout`
# merges the base env itself rather than letting each document list it.
# THE --effort OVERLAY FOR OPENCODE, into hw's own process — which is only
# where base_env (_render_layout) and _write_run_env read it from. Exporting it
# here used to be the WHOLE mechanism, and it reached no pane: measured
# 2026-09-28, the manifest said `applied` and the live executor's `ps -Eww` had
# no OPENCODE_CONFIG_CONTENT, its GET /config `reasoningEffort: null`. A pane
# takes its environment from base_env, _hw_env's flags and the run env file,
# and none of them named it. They do now; this decides WHAT they carry.
#
# THE UNSET IS AS LOAD-BEARING AS THE EXPORT, for the CLAUDE_CONFIG_DIR reason:
# base_env copies this process, so an OPENCODE_CONFIG_CONTENT the brainer
# happens to carry would reach every executor it launches. No overlay built by
# THIS dispatch means none at all.
#
# HW_OPENCODE_EFFORT / HW_OPENCODE_EFFORT_AGENT travel beside it because the
# crash restore (shell/hw-restore-env.zsh) applies only HW_*/ENGRAM_* and must
# never copy a whole config layer out of a file; it rebuilds the overlay from
# these two, each validated, instead.
_export_opencode_overlay() {
  unset OPENCODE_CONFIG_CONTENT HW_OPENCODE_EFFORT HW_OPENCODE_EFFORT_AGENT
  [ "${AGENT:-}" = opencode ] || return 0
  # The engram proxy rides the same layer (_engram_proxy_args); the effort
  # pair still travels only when there is an effort to rebuild.
  OPENCODE_CONFIG_CONTENT="$(_opencode_config_content)"
  if [ -n "$OPENCODE_CONFIG_CONTENT" ]; then export OPENCODE_CONFIG_CONTENT; else unset OPENCODE_CONFIG_CONTENT; fi
  if [ -n "${OPENCODE_EFFORT_OVERLAY:-}" ]; then
    HW_OPENCODE_EFFORT="$EFFORT"
    HW_OPENCODE_EFFORT_AGENT="$OPENCODE_PRIMARY_AGENT"
    export HW_OPENCODE_EFFORT HW_OPENCODE_EFFORT_AGENT
  fi
}

_export_hw_env() {
  # Here because every launch path calls it before its first consumer of the
  # invoker pane, and because a statement can fill the cache while a `$(...)`
  # cannot. Costs one `herdr pane list` per dispatch instead of three.
  _invoker_pane_init
  HW_PROJECT="$PROJ"; HW_TASK="$TASK"; HW_WORKDIR="$1"
  HW_EXECUTOR_VENDOR="$AGENT"
  # THE ACCOUNT, AND THE UNSET IS AS LOAD-BEARING AS THE EXPORT.
  #
  # base_env in _render_layout reads this process's environment, so a brainer
  # that is ITSELF redirected — a product-lane brainer under the personal account —
  # would otherwise hand its own CLAUDE_CONFIG_DIR to every executor it launches,
  # including one in a lane whose account is `default`. That is the same silent
  # inheritance the direnv block below refuses, arriving through the back door.
  # An account of `default` therefore means "no redirect", not "whatever I have".
  if [ "${ACCOUNT_APPLIES:-0}" = 1 ] && [ -n "${ACCOUNT_CONFIG_DIR:-}" ]; then
    CLAUDE_CONFIG_DIR="$ACCOUNT_CONFIG_DIR"; export CLAUDE_CONFIG_DIR
  else
    unset CLAUDE_CONFIG_DIR
  fi
  # THE BRAIN GUARD'S OPENCODE HALF, and the unset is load-bearing for the
  # same reason as the account's: base_env reads this process, so only a
  # product lane's opencode executor may carry it. See _brain_guard_applies.
  if [ "$AGENT" = opencode ] && _brain_guard_on; then
    OPENCODE_CONFIG="$(_brain_guard_opencode_config)"; export OPENCODE_CONFIG
  else
    unset OPENCODE_CONFIG
  fi
  ENGRAM_PROJECT="$(_engram_label "$PROJ")"
  # WHY THIS EXISTS. "Artifacts go in the work directory, never inside the
  # working tree" was self-contradictory on the repo lanes, because there
  # HW_WORKDIR *is* the worktree root. An executor hit it on 2026-08-21, was
  # told both things by the same brief, and solved it at runtime with
  # `git check-ignore` — a better answer than the instruction it was given.
  #
  # So the rule gets a place instead of a caveat: HW_ARTIFACTS is a directory
  # that is always safe to write and never shows up in `git status`. On a
  # repoless lane there is no tree to pollute, so it is the work directory
  # itself and nothing changes.
  HW_ARTIFACTS="$(_artifacts_dir_for "$PROJ" "$HW_WORKDIR")"
  export HW_PROJECT HW_TASK HW_WORKDIR HW_RUN HW_ARTIFACTS ENGRAM_PROJECT
  export HW_EXECUTOR_VENDOR HW_INVOKER_VENDOR HW_INVOKER_SESSION HW_INVOKER_ENDPOINT
  # THE BASE A JUDGMENT DAY TARGET IS BUILT AGAINST, computed ONCE here and read
  # by every other writer — the --env flags, the persisted run env, the layout allowlist and
  # the preamble. Same shape as HW_ARTIFACTS and HW_PORT_WEB above, and for the
  # same reason: two computations of one fact is how a fix lands on one of them.
  # This is also why it runs AFTER the worktree exists — _review_base_ref reads
  # `$wd/.git` and asks git for a merge-base, and every launch path calls this
  # function with the worktree already built.
  #
  # UNSET, NOT EMPTY, when it could not be computed. See _review_base_ref: the
  # thing being prevented is somebody interpolating a blank into a diff range.
  HW_REVIEW_BASE_REF="$(_review_base_ref "$HW_WORKDIR")"
  if [ -n "$HW_REVIEW_BASE_REF" ]; then
    # The SHA is what gets passed; the branch is what makes it readable, in the
    # preamble, in `hw receipt` and in a transcript somebody reads next month.
    HW_REVIEW_BASE_BRANCH="$(_lane_base_ref_prefix "$PROJ")$(_task_base)"
    export HW_REVIEW_BASE_REF HW_REVIEW_BASE_BRANCH
  else
    unset HW_REVIEW_BASE_REF HW_REVIEW_BASE_BRANCH
  fi
  if [ "${WANT_REPORT:-1}" = 0 ]; then
    HW_NO_REPORT=1; export HW_NO_REPORT
  else
    unset HW_NO_REPORT
  fi
  HW_CHAINING_ENABLED="${KEEP_PANE:-0}"
  HW_CHAINING_LEASE_SECONDS="${KEEP_PANE_SECONDS:-}"
  HW_CHAINING_LEASE_REASON="${KEEP_PANE_WHY:-}"
  HW_CHAINING_LEASE_HOLDER="$(_invoker_pane)"
  export HW_CHAINING_ENABLED HW_CHAINING_LEASE_SECONDS HW_CHAINING_LEASE_REASON HW_CHAINING_LEASE_HOLDER
  if [ "$AGENT" = opencode ]; then
    OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
    export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS
    # Only when the lane names one (see _build_agent_args): a lane that does not
    # keeps whatever it had, so no current lane changes.
    if [ -n "${OPENCODE_EXECUTOR_CONFIG:-}" ]; then
      OPENCODE_CONFIG_DIR="$OPENCODE_EXECUTOR_CONFIG"
      export OPENCODE_CONFIG_DIR OPENCODE_EXECUTOR_CONFIG
    fi
  fi
  _export_opencode_overlay
  # BROWSER ISOLATION, per run, for the same reason as the ports: hw knows and
  # the executor should not have to ask.
  #
  # MEASURED 2026-08-25, because the diagnosis in circulation was half right.
  # agent-browser has three axes — --session (logical state), --namespace
  # (daemon socket) and --profile (Chrome user-data-dir) — and the claim was
  # that varying only --session made every task share
  # ~/.agent-browser/profiles/<lane>. It does not. With NO --profile, each
  # launch gets its own ephemeral user-data-dir under $TMPDIR; two sessions in
  # ONE namespace still got two separate dirs. The sharing came from passing
  # `--profile <lane>` at all: a bare profile NAME is a shared singleton by
  # definition, Chrome locks it, and the second launch loses — verified across
  # two namespaces, where only one browser survived.
  #
  # So the default needs no help. What hw fixes here is the OTHER half: every
  # task shared one daemon namespace, so `agent-browser session list` showed
  # every other task's sessions. bar-stage-impl spent its last ask asking the
  # orchestrator to "confirm when session list is empty long enough" — a promise
  # nobody can make while any sibling may launch. With a namespace per run the
  # question stops existing: a task can only see its own.
  #
  # HW_BROWSER_PROFILE is a PATH, not a name, and it is offered rather than
  # applied: persistence is opt-in, and a path under the task's own artifacts
  # can never be the singleton two tasks fight over.
  AGENT_BROWSER_NAMESPACE="hw-${HW_RUN:-norun}"
  HW_BROWSER_PROFILE="$HW_ARTIFACTS/browser-profile"
  export AGENT_BROWSER_NAMESPACE HW_BROWSER_PROFILE

  # THE EXECUTOR'S OWN ADDRESS, which hw has known since _build_agent_args and
  # until 2026-08-25 told nobody. `--port` is chosen by _free_channel_port and
  # written only into argv, so the one process that could not read it was the
  # executor itself: a product-lane task spent its single ask on
  # "provide the assigned unique local runtime port, if one was preallocated"
  # (w41:pZ, 12:22:36Z) — a fact hw held the whole time. It is also the address
  # a sibling or a brainer replies to, so it belongs in the env file that
  # survives a restart, not only in a process listing.
  if [ "$AGENT" = opencode ] && [ -n "${OPENCODE_AGENT_PORT:-}" ]; then
    HW_AGENT_PORT="$OPENCODE_AGENT_PORT"
    HW_AGENT_ENDPOINT="http://127.0.0.1:$OPENCODE_AGENT_PORT"
    export HW_AGENT_PORT HW_AGENT_ENDPOINT
  fi
}

_ensure_artifacts_dir() {
  # The exclude file, not .gitignore: .gitignore is versioned and this setup
  # commits nothing to either repo. For a linked worktree `--git-path` resolves
  # to the COMMON dir, so one write covers every worktree and the main checkout,
  # which is what we want — `.hw` is hw's own control directory and showed up as
  # untracked in an executor's `git status` all day.
  local wt="$1" ex=""
  mkdir -p "$wt/.artifacts" 2>/dev/null || true
  ex="$(git -C "$wt" rev-parse --git-path info/exclude 2>/dev/null || true)"
  [ -n "$ex" ] || return 0
  case "$ex" in /*) ;; *) ex="$wt/$ex" ;; esac
  mkdir -p "$(dirname "$ex")" 2>/dev/null || true
  local line
  for line in '.artifacts/' '.hw/'; do
    if ! rg -qxF "$line" "$ex" 2>/dev/null; then
      printf '%s\n' "$line" >> "$ex" 2>/dev/null || true
    fi
  done
  info "artifacts → $wt/.artifacts (excluded, so it never shows in git status)"
  return 0
}

# THE BRAINER'S PANE ID IS RESOLVED ONCE, HERE, AND NOWHERE ELSE.
#
# `HERDR_PANE_ID` is baked into a pane's environment at spawn and never
# refreshed, so a long-lived brainer that gets moved keeps exporting the pane id
# it had in a workspace that no longer exists — which is exactly what 6dd5dda
# ("the brainer is a tab in its project's space") did to every brainer already
# running. Measured 2026-08-25: this brainer's env said `wB:p1` while `herdr
# pane list` put it at `w30:p2`; deploy-check-350's done-invoker died with
# `agent_not_found` and its report reached the brainer only because a human
# pasted it in.
#
# There are TWO consumers — the `--env` flags and the run's `env` file — and the
# first fix touched only the flags, so the next dispatch still shipped the stale
# id in the file. Hence one resolver, cached, with both consumers reading it.
# THE CACHE ONLY WORKS IF IT IS FILLED IN THE PARENT SHELL. Every consumer
# reads this through `$(_invoker_pane)`, and command substitution runs in a
# SUBSHELL — so an assignment made inside it is discarded the moment it returns.
# Measured: three call sites, three full resolutions, `_HW_INVOKER_RESOLVED`
# still empty afterwards, and any warning printed three times. The resolution
# costs 7ms, so the cost was never the point; a warning repeated three times
# reads as three separate problems, and a cache that looks like it works is
# worse than none because the next person budgets for it.
#
# So `_invoker_pane_init` does the work as a STATEMENT (not a substitution),
# once, from `_export_hw_env` — which every launch path calls before its first
# consumer. `_invoker_pane` then just prints what it found.
_HW_INVOKER_RESOLVED=
# HOW it resolved — explicit / env / cwd / label / unverified, empty when
# nothing resolved. Carried beside the pane because the dispatch manifest has to
# name the METHOD: `w4C:pT` alone does not say whether a human named it or hw
# guessed it from a cwd, and those two are not equally trustworthy. The resolver
# already computed it and threw it away.
_HW_INVOKER_HOW=
_HW_INVOKER_DONE=0
REPORT_TO_CHOSEN=${REPORT_TO_CHOSEN:-0}
# THE REFUSAL HAS TO HAPPEN HERE, NOT IN THE RESOLVER. `_invoker_pane_resolve`
# is read through `$( )`, and `die`'s `exit 1` inside a command substitution
# kills the SUBSHELL and nothing else: hw would print the refusal and carry on
# building a worktree, a tab and an agent whose reports have nowhere to go —
# the same silent-exit shape this file keeps having to fix. So the resolver
# hands back a `!refuse <message>` sentinel and this function, which every
# launch path calls as a STATEMENT, is the one that dies on it.
_invoker_pane_init() {
  [ "$_HW_INVOKER_DONE" = 1 ] && return 0
  _HW_INVOKER_DONE=1
  # Fire-and-forget is an explicit operator choice. Do not resolve (and possibly
  # reject) an address that this dispatch deliberately will not use.
  if [ "${WANT_REPORT:-1}" = 0 ]; then
    _HW_INVOKER_RESOLVED=
    _HW_INVOKER_HOW=no-report
    return 0
  fi
  local r
  r="$(_invoker_pane_resolve)"
  case "$r" in
    '!refuse '*) die "${r#'!refuse '}" ;;
  esac
  if [ -z "$r" ]; then
    die "HW_INVOKER_PANE is UNRESOLVED — every executor launched here would have nowhere to report. Export the id \`herdr pane list\` actually shows for your brainer, or pass --no-report for a deliberate fire-and-forget dispatch."
  fi
  # The resolver hands back `<pane><TAB><how>`. The tab below is a LITERAL tab,
  # not a variable holding one, and deliberately: 08-invoker-pane.sh extracts
  # these three functions out of this file and drives them with a stub resolver,
  # so anything they close over that is defined elsewhere is unset there — and
  # `${r%%""*}` would strip the whole pane id and pass the test-suite a green.
  # Split only when the tab is present, so a stub that prints a bare pane id
  # still yields the pane and simply no method.
  case "$r" in
    *"	"*) _HW_INVOKER_RESOLVED="${r%%"	"*}"; _HW_INVOKER_HOW="${r#*"	"}" ;;
    *)       _HW_INVOKER_RESOLVED="$r"; _HW_INVOKER_HOW= ;;
  esac
  # The PROJ guard keeps the three-function unit harness independent; every
  # real launch has already canonicalized PROJ before it resolves an invoker.
  [ -z "${PROJ:-}" ] || _validate_invoker_lane
  return 0
}

_invoker_pane() {
  [ "$_HW_INVOKER_DONE" = 1 ] || _invoker_pane_init
  printf '%s' "$_HW_INVOKER_RESOLVED"
}

# The method, for the dispatch manifest. Empty when nothing resolved.
_invoker_how() {
  [ "$_HW_INVOKER_DONE" = 1 ] || _invoker_pane_init
  printf '%s' "$_HW_INVOKER_HOW"
}

_invoker_pane_resolve() {
  local panes resolved
  # STDOUT ONLY, deliberately NOT `_capture`. `_capture` runs its command with
  # `2>&1`, so one byte on stderr — a reconnect notice, a deprecation warning —
  # is prepended to the JSON, `json.load` raises, the resolver prints nothing,
  # and the branch below reports UNRESOLVED and STRIPS the return channel. That
  # is the exact opposite of what the unreachable-herdr branch is for. Measured
  # 2026-08-25: herdr writes 13252 bytes to stdout and 0 to stderr today, so
  # nothing was broken — but "today it happens to be silent" is not a contract,
  # and the failure it would cause is silent too.
  panes="$(herdr pane list 2>/dev/null)" || panes=''
  if [ -z "$panes" ]; then
    # herdr unreachable — fall back to whatever address we were given rather
    # than stripping a channel that may well be fine. Unverified, and said so.
    # The EXPLICIT one outranks the inherited one here too: it is the value
    # somebody chose, and this branch cannot check either of them.
    local unverified="${HW_INVOKER_PANE:-${HERDR_PANE_ID:-}}"
    if [ -n "$unverified" ]; then
      warn "HW_INVOKER_PANE unverified (herdr pane list unreachable): ${unverified}"
      printf '%s\tunverified' "$unverified"
    fi
    return 0
  fi
  resolved="$(printf '%s' "$panes" \
    | HW_BRAINER_CWD="$BRAIN/$PROJ" python3 -c '
import json, os, sys
try:
    panes = json.load(sys.stdin)["result"]["panes"]
except Exception:
    sys.exit(0)
env_id = os.environ.get("HERDR_PANE_ID", "")
by_id = {p.get("pane_id"): p for p in panes if p.get("pane_id")}
live = set(by_id)

# (0) AN OPERATOR WHO NAMES THE PANE OUTRANKS EVERY HEURISTIC BELOW.
#     Measured 2026-08-26 on a brainer: HERDR_PANE_ID said
#     `w1:p1` (dead), the real pane was `w4C:pT` with NO label and cwd
#     ~/ , and hw was invoked from the brain root — so (env) missed on
#     liveness, (a) missed on cwd and (b) missed on both label and cwd. Every
#     dispatch printed UNRESOLVED, both invokers refused, and executors
#     finished with nowhere to report. The heuristics are not wrong; they
#     simply cannot describe a brainer that is not shaped like the convention.
#     A human who exports the id can.
#
#     It is still CHECKED, because an address nobody verified is the failure
#     this whole resolver exists to stop. Two refusals, both loud:
#       dead      — the id is not in the live pane list at all
#       executor  — the id is a pane hw itself labelled `agent`, i.e. another
#                   executor. Delivering one executor report to another is
#                   worse than delivering none: it cannot act on it and will
#                   not say so (already in the lineage), which is why this is
#                   a refusal and not a downgrade to the heuristics.
want_id = os.environ.get("HW_INVOKER_PANE", "").strip()
if want_id:
    if want_id not in live:
        print("!refuse\tHW_INVOKER_PANE=%s was named explicitly but is not a live pane "
              "(herdr pane list does not know it), so every executor launched here would "
              "have nowhere to report. Export the id `herdr pane list` actually shows for "
              "your brainer, or unset HW_INVOKER_PANE and let hw resolve it." % want_id)
        sys.exit(0)
    if by_id[want_id].get("label") == "agent":
        print("!refuse\tHW_INVOKER_PANE=%s is an EXECUTOR pane (hw labels every executor "
              "it builds `agent`), not a brainer. Reports delivered there land on an agent "
              "that cannot act on them and will not say so. Name the brainer pane, or unset "
              "HW_INVOKER_PANE." % want_id)
        sys.exit(0)
    print(want_id + "\texplicit")
    sys.exit(0)

if env_id and env_id in live:
    print(env_id + "\tenv")
    sys.exit(0)

# The env var is stale. Two fallbacks, in order of how much they assume.
agents = [p for p in panes if p.get("agent") and p.get("pane_id")]

# (a) A pane sitting in the shell cwd. Cheap and exact WHEN it holds, but it
#     often does not: hw runs from wherever the brainer shell happens to be,
#     which is not necessarily the cwd herdr registered for the pane. This
#     fallback is why the first version of this fix reported UNRESOLVED for a
#     brainer that was sitting right there (2026-08-25).
#     It also must not match an EXECUTOR. hw labels every executor pane it
#     builds "agent" and every brainer pane "brain" (verified against the live
#     list), so running hw from inside a worktree would otherwise resolve the
#     invoker to the executor living there — and the reports of that executor
#     would be delivered to another executor, which cannot act on them and
#     will not say so.
# One directory, one key. On native Windows herdr reports a pane cwd as
# a backslash drive path and bash spells it /c/... or /tmp/..., so the strings
# never agree; the layer realpath answers one spelling for all of them.
# Elsewhere the string is the key, exactly as before.
def same(a, b):
    if os.name != "nt":
        return a == b
    if not a or not b:
        return False
    k = lambda x: os.path.realpath(x).rstrip("/").casefold()
    return k(a) == k(b)
here = os.environ.get("PWD", "")
cands = [p["pane_id"] for p in agents
         if same(p.get("cwd"), here) and p.get("label") != "agent"]
if len(cands) == 1:
    print(cands[0] + "\tcwd")
    sys.exit(0)

# (b) The deterministic one: THIS project brainer is the agent pane labelled
#     "brain" whose cwd is $BRAIN/<project>. That is hw own
#     convention for a brainer pane, it does not depend on the shell cwd, and
#     it is per-project so two brainers never collide.
want = os.environ.get("HW_BRAINER_CWD", "")
cands = [p["pane_id"] for p in agents
         if p.get("label") == "brain" and same(p.get("cwd"), want)]
if len(cands) == 1:
    print(cands[0] + "\tlabel")
' 2>/dev/null)"
  local pane="${resolved%%	*}" how="${resolved##*	}"
  # The sentinel, not a pane. `_invoker_pane_init` is the statement that dies
  # on it — see the comment there for why this cannot die in here.
  if [ "$pane" = '!refuse' ]; then
    printf '!refuse %s' "$how"
    return 0
  fi
  if [ -z "$pane" ]; then
    warn "HW_INVOKER_PANE UNRESOLVED — ask-invoker and done-invoker will refuse, so the executor cannot report back. Inherited HERDR_PANE_ID=${HERDR_PANE_ID:-unset} is not a live pane."
    warn "if you know your own pane id, export it and re-run: HW_INVOKER_PANE=\$(herdr pane list | jq -r ...) hw …  — an explicit id is honoured first, and still checked for liveness."
    return 0
  fi
  # `>&2` IS LOAD-BEARING. This whole function is read through `$( )`, and
  # `info`/`ok` print to STDOUT — an announcement made the ordinary way would
  # be captured as part of the pane id and handed to every executor as its
  # return address. warn/die already redirect; this one has to say so itself.
  if [ "$how" = explicit ]; then
    info "invoker pane taken from HW_INVOKER_PANE=${pane} (named explicitly; verified live and not an executor pane)" >&2
  fi
  if [ "$how" = cwd ]; then
    warn "invoker pane resolved by ${how} to ${pane}; inherited HERDR_PANE_ID=${HERDR_PANE_ID:-unset} is STALE (this pane was moved)"
  fi
  printf '%s\t%s' "$pane" "$how"
}

# THE PANE-IDENTITY PREDICATE LIVES IN bin/project-spaces.sh.
#
# Three readers ask it now — this launch guard, `hw reports`, and `bin/brain`'s
# reset — and the comment above its definition says why it is one copy. It was
# private to hw until 2026-09-14, which is precisely how `brain` came to focus a
# brainer standing in a directory hw refuses to dispatch from.

# Resolution says which pane wins the existing precedence rules. Validation is
# the separate postcondition: that pane must be THIS lane's brainer. Keeping the
# two questions separate preserves every established resolver fallback while
# refusing the cross-lane result that 79 historical runs silently accepted.
_validate_invoker_lane() {
  [ "${WANT_REPORT:-1}" = 1 ] || return 0
  local pane="$_HW_INVOKER_RESOLVED" panes verdict expected="$BRAIN/$PROJ"
  [ -n "$pane" ] || return 0
  panes="$(herdr pane list 2>/dev/null || true)"
  if [ -z "$panes" ]; then
    [ "${REPORT_TO_CHOSEN:-0}" = 1 ] && return 0
    die "invoker resolved to $pane by ${_HW_INVOKER_HOW:-unknown}, but herdr pane list is unreachable, so hw cannot prove it is the $PROJ brainer (label brain, cwd $expected). Run \`brain $PROJ\` and launch from that pane, or deliberately route elsewhere with \`--report-to $pane\`. NOTHING was built."
  fi
  verdict="$(printf '%s' "$panes" | lane_brainer_verdict "$pane" "$expected")"
  [ "$verdict" = ok ] && return 0
  if [ "${REPORT_TO_CHOSEN:-0}" = 1 ]; then
    warn "--report-to deliberately routes $PROJ reports to $pane despite lane mismatch (${verdict#*$'\t'})"
    return 0
  fi
  die "invoker resolved to $pane by ${_HW_INVOKER_HOW:-unknown}, but it is not the $PROJ brainer: ${verdict#*$'\t'}; expected label=brain cwd=$expected. Run \`brain $PROJ\` and re-run the launch there. If a human deliberately wants this foreign target, add \`--report-to $pane\`; that choice is recorded in the manifest and receipt. NOTHING was built."
}

# The flag form, for the `--env` list. Empty when unresolvable, so the executor
# gets no address rather than a wrong one.
_resolve_invoker_pane_flag() {
  local p
  p="$(_invoker_pane)"
  [ -n "$p" ] && printf -- ' --env HW_INVOKER_PANE=%s' "$p"
  return 0
}

_hw_env() {
  printf -- '--env HW_PROJECT=%s --env HW_TASK=%s --env HW_WORKDIR=%s --env HW_RUN=%s' "$PROJ" "$TASK" "$1" "$HW_RUN"
  [ -n "${HW_ARTIFACTS:-}" ] && printf -- ' --env HW_ARTIFACTS=%s' "$HW_ARTIFACTS"
  printf -- ' --env HW_EXECUTOR_VENDOR=%s' "$AGENT"
  # The account, in the `--here` (pane split) form. Same rule as _export_hw_env:
  # emitted only when the redirect actually applies, so a pane never carries a
  # config dir its vendor will not read — and never carries the brainer's own by
  # accident, because a flag list is built, not inherited.
  if [ "${ACCOUNT_APPLIES:-0}" = 1 ] && [ -n "${ACCOUNT_CONFIG_DIR:-}" ]; then
    printf -- ' --env CLAUDE_CONFIG_DIR=%s' "$ACCOUNT_CONFIG_DIR"
  fi
  # THIS IS THE `opencode-auto` PARITY, and it is the whole of it.
  # bin/opencode-auto (versioned here; install.sh links it onto PATH) is
  # `export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true; exec opencode --auto "$@"`.
  # hw passes `--auto` in _build_agent_args and the variable here, so launching
  # through hw IS the wrapper — plus `--port`, which the wrapper has no reason
  # to set. Written down because on 2026-08-24 a brainer had to read the wrapper
  # to find out, and an equivalence that lives implicitly in two files is one
  # nobody can rely on. `hw dispatch` states it in the manifest now.
  [ "$AGENT" != opencode ] || printf -- ' --env OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true'
  if [ "$AGENT" = opencode ] && [ -n "${OPENCODE_EXECUTOR_CONFIG:-}" ]; then
    printf -- ' --env OPENCODE_CONFIG_DIR=%s' "$OPENCODE_EXECUTOR_CONFIG"
  fi
  # --effort, in the --here form; see _export_opencode_overlay. Word-split by
  # the caller, which is safe only because the overlay is compact jq output and
  # the agent name was checked against [A-Za-z0-9._-] when it was built.
  if [ "$AGENT" = opencode ] && [ -n "$(_opencode_config_content)" ]; then
    printf -- ' --env OPENCODE_CONFIG_CONTENT=%s' "$(_opencode_config_content)"
  fi
  if [ "$AGENT" = opencode ] && [ -n "${OPENCODE_EFFORT_OVERLAY:-}" ]; then
    printf -- ' --env HW_OPENCODE_EFFORT=%s --env HW_OPENCODE_EFFORT_AGENT=%s' "$EFFORT" "$OPENCODE_PRIMARY_AGENT"
  fi
  if [ "$AGENT" = opencode ] && _brain_guard_on; then
    printf -- ' --env OPENCODE_CONFIG=%s' "$(_brain_guard_opencode_config)"
  fi
  # Without this, engram derives its label from the working directory and every
  # single task invents a new one: `leadgogo-inventory` (4 obs) and
  # `optivon-announcement-audio` (2) were both created that way, in labels the
  # brainer will never think to search. ENGRAM_PROJECT overrides detection
  # (`project_source: process_override`) with no file written anywhere, which is
  # what makes it usable inside the repos too.
  printf -- ' --env ENGRAM_PROJECT=%s' "$(_engram_label "$PROJ")"
  # The brainer's pane, in BOTH modes. This used to be --here only, on the
  # theory that a stale pane id is worse than none. Measured, that trade was
  # backwards: the invokers already treat an unreachable pane as "not
  # delivered, no ask spent" and say so, while the variable's ABSENCE makes
  # ask-invoker and done-invoker refuse outright — so the return channel was
  # inert in the mode the README documents as primary. A space-mode probe
  # (setup:channel-probe) ended its turn in 29s having written the refusal to
  # a file, with nothing to report and nobody to report it to.
  # ...but the id must be RESOLVED, not inherited. HERDR_PANE_ID is baked into a
  # pane's environment at spawn and is never refreshed, so a long-lived brainer
  # that gets moved — which is exactly what "the brainer is a tab in its
  # project's space" (6dd5dda) did to every existing one — keeps exporting the
  # pane id it had in a workspace that no longer exists. Measured: a brainer's
  # env said `wB:p1` while `herdr pane list` put it at `w30:p2`, hw passed the
  # stale value faithfully, and that task's done-invoker died with
  # `agent_not_found`. The report reached the brainer only because a human
  # pasted it in by hand.
  #
  # So: trust the env var only if the live pane list still knows it, else find
  # the agent pane sitting in this same cwd, else say plainly that the return
  # channel will be inert rather than handing over an address that is not one.
  printf -- '%s' "$(_resolve_invoker_pane_flag)"
  [ "${WANT_REPORT:-1}" != 0 ] || printf -- ' --env HW_NO_REPORT=1'
  printf -- ' --env HW_CHAINING_ENABLED=%s' "${KEEP_PANE:-0}"
  [ -n "${KEEP_PANE_SECONDS:-}" ] && printf -- ' --env HW_CHAINING_LEASE_SECONDS=%s' "$KEEP_PANE_SECONDS"
  # The reason may contain spaces. Do not flatten it into this shell-word flag
  # string; it is persisted in the run env file and recovered by the invoker.
  [ -n "$(_invoker_pane)" ] && printf -- ' --env HW_CHAINING_LEASE_HOLDER=%s' "$(_invoker_pane)"
  # THE INVOKER WAIT BUDGET IS SET BY THE SIDE THAT KNOWS. The invokers default to 90s,
  # and a brainer mid-turn was measured at 215s on 2026-08-24, with that
  # session's turns running longer repeatedly — so the first ask of a task
  # usually timed out against a brainer that was simply working. CLAUDE.shared.md
  # answers this by telling executors to pass HW_INVOKER_WAIT_MS=540000 from the
  # start, which is advice to the party who cannot know how busy its brainer
  # is. hw is launching the executor FROM that brainer's pane, so it
  # sets the budget instead of asking the executor to remember an idiom.
  #
  # 90s stays the library default, because it is right for an idle brainer
  # (~0.14s) and this variable is also read outside a dispatch. Overridable in
  # the environment as before; a timeout still costs nothing but the wait — no
  # ask spent, no marker written, and the question recorded on the executor's
  # own pane.
  printf -- ' --env HW_INVOKER_WAIT_MS=%s' "${HW_INVOKER_WAIT_MS:-540000}"
  # `hw next` waits in the opposite direction (brainer -> executor), so it has
  # its own knob and its own measurement. A real executor was `working` for
  # more than 13 minutes while it waited on a subagent; 540s would therefore be
  # a made-up symmetry with the 215s brainer measurement above. Pin 15 minutes
  # into this run so a later `hw next` can recover the dispatch contract even
  # though it runs in the brainer's environment, not this executor's.
  printf -- ' --env HW_NEXT_WAIT_MS=%s' "${HW_NEXT_WAIT_MS:-900000}"
  [ -n "${HW_INVOKER_VENDOR:-}" ] && printf -- ' --env HW_INVOKER_VENDOR=%s' "$HW_INVOKER_VENDOR"
  [ -n "${HW_INVOKER_SESSION:-}" ] && printf -- ' --env HW_INVOKER_SESSION=%s' "$HW_INVOKER_SESSION"
  [ -n "${HW_INVOKER_ENDPOINT:-}" ] && printf -- ' --env HW_INVOKER_ENDPOINT=%s' "$HW_INVOKER_ENDPOINT"
  # See _export_hw_env: the executor's own port, which it otherwise has to ask for.
  [ -n "${HW_AGENT_PORT:-}" ] && printf -- ' --env HW_AGENT_PORT=%s --env HW_AGENT_ENDPOINT=%s' \
    "$HW_AGENT_PORT" "$HW_AGENT_ENDPOINT"
  # The SERVICE ports hw started for this task. Same reason: an executor that
  # does not know them re-provisions them and collides with itself.
  [ -n "${HW_PORT_WEB:-}" ] && printf -- ' --env HW_PORT_WEB=%s' "$HW_PORT_WEB"
  [ -n "${HW_PORT_API:-}" ] && printf -- ' --env HW_PORT_API=%s' "$HW_PORT_API"
  # See _export_hw_env: one browser namespace per run, so a task can only ever
  # see its own sessions.
  [ -n "${AGENT_BROWSER_NAMESPACE:-}" ] && printf -- ' --env AGENT_BROWSER_NAMESPACE=%s --env HW_BROWSER_PROFILE=%s' \
    "$AGENT_BROWSER_NAMESPACE" "$HW_BROWSER_PROFILE"
  # See _review_base_ref: the branch point a Judgment Day target is built from.
  # Read from the environment _export_hw_env just built rather than recomputed,
  # and emitted only when it resolved — a lane with no worktree hands over no
  # base at all, which is the honest answer and not a degraded one.
  [ -n "${HW_REVIEW_BASE_REF:-}" ] && printf -- ' --env HW_REVIEW_BASE_REF=%s --env HW_REVIEW_BASE_BRANCH=%s' \
    "$HW_REVIEW_BASE_REF" "${HW_REVIEW_BASE_BRANCH:-}"
  # The launch shape, stated rather than inferred. run_is_here() used to read
  # the presence of HW_INVOKER_PANE as the discriminator, which stops
  # discriminating the moment both modes carry it.
  # THREE MODES, THREE VALUES. This field was written when there were two, and
  # tab mode became the DEFAULT afterwards (2469cb2) without it gaining a value —
  # so every task tab has been recording itself as `space`. `hw status` then read
  # "not here, and no workspace of its own" and printed `--here`, which is how a
  # tab in w44 came to be described as a split pane. A two-valued field asked a
  # three-valued question, and the answer it gave was not merely imprecise, it
  # was the wrong one of the two it could give.
  if   [ "$HERE" = 1 ];    then printf -- ' --env HW_LAUNCH_MODE=here'
  elif [ "${TAB:-0}" = 1 ]; then printf -- ' --env HW_LAUNCH_MODE=tab'
  else                          printf -- ' --env HW_LAUNCH_MODE=space'; fi
  return 0
}

# ── the restore env file ────────────────────────────────────────────────────
#
# WHY THIS FILE EXISTS. herdr does not persist environment, and it does not
# replay a launch command either: on restore it SYNTHESIZES
# `claude --resume <agent_session.value>` and types it into a fresh interactive
# login zsh in the pane's cwd. So the `--env` values below are
# gone after a crash or a reboot, and there is no argv seam to rebuild them
# through — which is why the earlier `bash -lc 'set -a; . env; set +a; exec …'`
# wrapper proposal is dead. The surviving path is: write the environment to a
# file keyed on the WORK DIRECTORY, and have shell startup put it back.
# See brain/shell/hw-restore-env.zsh, which is the other half of this.
#
# FOR A DELIBERATE RESTART THIS FILE IS NOT THE ANSWER: `herdr update --handoff`
# restarts the server with pane processes ALIVE, so environment, dev servers and
# the `--model` flag all survive untouched. This file is for crashes and reboots.
#
# THE FILE'S GRAMMAR IS AN INTERFACE, so it is fixed and narrow:
#
#     KEY='value'                one per line, always single-quoted,
#                                inner ' written as '\''  — nothing else
#
# That is exactly what `set -a; . env; set +a` reads, and it is also parseable
# without eval by ~15 lines of zsh, which is what the startup snippet does
# (it must never execute a file found by walking up the filesystem). Values
# containing a NEWLINE would break the one-line-per-variable rule the parsers
# rely on, so they are dropped with a warning rather than written.
#
# Mode 0600, because the snippet and the invokers both refuse a file that is
# group- or world-writable — a writable env file is an injection point.
_write_run_env() {
  local workdir="$1" invoker="${3:-}" extra dir mode
  # if/else, not `$( [ … ] && … )`: that shape is the bug this repo keeps
  # writing, and bin/lint-shell flags it on sight.
  # SECOND WRITER OF THE SAME FACT, and it is the one that PERSISTS. `_hw_env`
  # emits --env flags for the live panes; this writes `.hw/<run>/env`, which is
  # what `run_is_here` and `run_mode_of` read afterwards and what every later
  # `hw status` is judged against. Both were two-valued for a three-mode world;
  # fixing only the first left every fresh task tab still recording itself as
  # `space` — verified on a product-lane task, launched 52 minutes after
  # that half-fix with an explicit --placement project-tab. Two computations of
  # one fact is how a fix lands on one of them.
  if   [ "${HERE:-0}" = 1 ]; then mode=here
  elif [ "${TAB:-0}" = 1 ];  then mode=tab
  else                            mode=space; fi
  # `${2:-{}}` cannot be written literally — the first `}` closes the expansion.
  extra="${2:-}"
  [ -n "$extra" ] || extra='{}'
  dir="$workdir/.hw/$HW_RUN"
  if ! mkdir -p "$dir" 2>/dev/null; then
    warn "could not create $dir — this run has no restore env file, so a pane that"
    warn "comes back after a herdr crash will have no HW_* environment"
    return 0
  fi
  # Every value is passed through the environment, never interpolated into the
  # python source: a task name with a quote in it would otherwise be a syntax
  # error at best. HW_ENV_EXTRA is the union of the per-pane `env` objects in the
  # rendered layout document, so a lane that adds a variable to its document
  # gets it in the file with no change here.
  # The manifest goes beside the env file: same run directory, same lifetime, so
  # "how was this dispatched" stays answerable after the task is closed.
  if [ -n "${DISPATCH_TEXT:-}" ]; then
    printf '%s\n' "$DISPATCH_TEXT" > "$dir/dispatch" 2>/dev/null || true
  fi
  # ONLY WHEN IT RESOLVED, because a receipt is a fact on disk and a blank one
  # would answer "what base was this judged against" with silence dressed as
  # an answer. A run with no review_base receipt is a run hw could not compute
  # one for, and `hw receipt` reads exactly that.
  if [ -n "${HW_REVIEW_BASE_REF:-}" ]; then
    _receipt_into "$dir" review_base "$HW_REVIEW_BASE_REF" \
      "git merge-base HEAD ${HW_REVIEW_BASE_BRANCH:-<base>} in $workdir at dispatch — the base a Judgment Day target is built against"
  fi
  # THE BOUNDARY done-invoker HOLDS TASK 1 TO. Keyed by task, because a
  # chained executor shares this receipt with every later task, and `hw next`
  # writes its own key for a re-task that declares one.
  if _design_gate_applies; then
    _receipt_into "$dir" design_boundary_t1 "$(_brief_boundary)" \
      "brief frontmatter boundary: in $BRIEF at dispatch — done-invoker requires an APPROVED design judgment"
  fi
  # THE DEPLOYED CHECK done-invoker HOLDS AN ODD RUN TO. Task 1 only: gentle
  # refuses --keep-pane, so there is no re-task to key. _validate_sdd_gentle
  # already refused an unreadable value; if one gets here anyway it records
  # nothing rather than a guess.
  if [ "${SDD:-}" = gentle ]; then
    local deployed_check
    if deployed_check="$(_gentle_deployed_check)"; then
      _receipt_into "$dir" deployed_check_t1 "$deployed_check" \
        "brief frontmatter deployed_check: in ${BRIEF:-<no brief>} at dispatch (required when absent) — done-invoker holds a done to it"
    fi
  fi
  if [ "${REPORT_TO_CHOSEN:-0}" = 1 ]; then
    _receipt_into "$dir" report_route \
      "$invoker — chosen by --report-to (lane postcondition deliberately overridden)" \
      "--report-to $invoker launch flag"
  fi
  # THE VERIFICATION IS PINNED HERE, AT DISPATCH, AND NOT READ AGAIN.
  #
  # `hw done` could re-read the brief instead — and then the task's own executor
  # could edit the brief it was handed and choose what gets run against it. The
  # file the brief named at LAUNCH is the contract, so it is frozen beside the
  # manifest, with the same lifetime: what runs at close is what a human saw in
  # the dispatch before the agent existed.
  if [ -n "${BRIEF:-}" ]; then
    _brief_verify_cmds "$BRIEF" > "$dir/verify" 2>/dev/null || true
  fi
  if HW_ENV_OUT="$dir/env" \
     HW_ENV_EXTRA="$extra" \
     HW_ENV_PROJECT="$PROJ" \
     HW_ENV_TASK="$TASK" \
     HW_ENV_WORKDIR="$workdir" \
     HW_ENV_RUN="$HW_RUN" \
     HW_ENV_ARTIFACTS="${HW_ARTIFACTS:-}" \
     HW_ENV_ENGRAM="$(_engram_label "$PROJ")" \
     HW_ENV_INVOKER="$invoker" \
     HW_ENV_NO_REPORT="${HW_NO_REPORT:-}" \
       HW_ENV_CHAINING="${HW_CHAINING_ENABLED:-${KEEP_PANE:-0}}" \
       HW_ENV_CHAINING_SECONDS="${HW_CHAINING_LEASE_SECONDS:-${KEEP_PANE_SECONDS:-}}" \
       HW_ENV_CHAINING_REASON="${HW_CHAINING_LEASE_REASON:-${KEEP_PANE_WHY:-}}" \
       HW_ENV_CHAINING_HOLDER="${HW_CHAINING_LEASE_HOLDER:-}" \
      HW_ENV_NEXT_WAIT="${HW_NEXT_WAIT_MS:-900000}" \
      HW_ENV_MODE="$mode" \
     python3 - <<'EOF'
import json, os, sys

out = os.environ["HW_ENV_OUT"]

# The lane extras first, then hw's own five, so hw always wins a name clash.
try:
    values = dict(json.loads(os.environ.get("HW_ENV_EXTRA") or "{}"))
except ValueError as e:
    print("HW_ENV_EXTRA is not a JSON object (%s)" % e, file=sys.stderr)
    values = {}

values.update({
    "HW_PROJECT":     os.environ.get("HW_ENV_PROJECT", ""),
    "HW_TASK":        os.environ.get("HW_ENV_TASK", ""),
    "HW_WORKDIR":     os.environ.get("HW_ENV_WORKDIR", ""),
    "HW_RUN":         os.environ.get("HW_ENV_RUN", ""),
    "HW_ARTIFACTS":   os.environ.get("HW_ENV_ARTIFACTS", ""),
    "ENGRAM_PROJECT": os.environ.get("HW_ENV_ENGRAM", ""),
    "HW_EXECUTOR_VENDOR": os.environ.get("HW_EXECUTOR_VENDOR", ""),
    "HW_INVOKER_VENDOR": os.environ.get("HW_INVOKER_VENDOR", ""),
    "HW_INVOKER_SESSION": os.environ.get("HW_INVOKER_SESSION", ""),
    "HW_INVOKER_ENDPOINT": os.environ.get("HW_INVOKER_ENDPOINT", ""),
    "HW_AGENT_PORT":     os.environ.get("HW_AGENT_PORT", ""),
    "HW_AGENT_ENDPOINT": os.environ.get("HW_AGENT_ENDPOINT", ""),
    "HW_PORT_WEB":       os.environ.get("HW_PORT_WEB", ""),
    "HW_PORT_API":       os.environ.get("HW_PORT_API", ""),
    "AGENT_BROWSER_NAMESPACE": os.environ.get("AGENT_BROWSER_NAMESPACE", ""),
    "HW_BROWSER_PROFILE":      os.environ.get("HW_BROWSER_PROFILE", ""),
    # The branch point a Judgment Day target is built from — see _review_base_ref. Empty
    # values are dropped below, so a dispatch that could not compute one leaves
    # the name ABSENT rather than present-and-blank, which is exactly the
    # distinction `hw next` reads back when it rebuilds the preamble.
    "HW_REVIEW_BASE_REF":      os.environ.get("HW_REVIEW_BASE_REF", ""),
    "HW_REVIEW_BASE_BRANCH":   os.environ.get("HW_REVIEW_BASE_BRANCH", ""),
    # Empty values are dropped below, so `default` persists as an ABSENT name
    # rather than as an empty one — which is what a restored pane needs to see.
    "CLAUDE_CONFIG_DIR":       os.environ.get("CLAUDE_CONFIG_DIR", ""),
    "OPENCODE_CONFIG_DIR":     os.environ.get("OPENCODE_EXECUTOR_CONFIG", ""),
    # The opencode half of the brain guard; absent off a product lane.
    "OPENCODE_CONFIG":         os.environ.get("OPENCODE_CONFIG", ""),
    "HW_NEXT_WAIT_MS":         os.environ.get("HW_ENV_NEXT_WAIT", ""),
    # --effort for opencode: the overlay for `hw revive` (which replays every
    # key), the two fields for the crash restore (which rebuilds it from them).
    # Absent unless this dispatch built one — _export_opencode_overlay.
    "OPENCODE_CONFIG_CONTENT":  os.environ.get("OPENCODE_CONFIG_CONTENT", ""),
    "HW_OPENCODE_EFFORT":       os.environ.get("HW_OPENCODE_EFFORT", ""),
    "HW_OPENCODE_EFFORT_AGENT": os.environ.get("HW_OPENCODE_EFFORT_AGENT", ""),
})
# In both modes now, and empty when hw is not running inside a pane at all —
# which is the only case that genuinely has no brainer to name. See _hw_env.
if os.environ.get("HW_ENV_INVOKER"):
    values["HW_INVOKER_PANE"] = os.environ["HW_ENV_INVOKER"]
if os.environ.get("HW_ENV_NO_REPORT"):
    values["HW_NO_REPORT"] = os.environ["HW_ENV_NO_REPORT"]
values["HW_CHAINING_ENABLED"] = os.environ.get("HW_ENV_CHAINING", "0")
if os.environ.get("HW_ENV_CHAINING_SECONDS"):
    values["HW_CHAINING_LEASE_SECONDS"] = os.environ["HW_ENV_CHAINING_SECONDS"]
if os.environ.get("HW_ENV_CHAINING_REASON"):
    values["HW_CHAINING_LEASE_REASON"] = os.environ["HW_ENV_CHAINING_REASON"]
if os.environ.get("HW_ENV_CHAINING_HOLDER"):
    values["HW_CHAINING_LEASE_HOLDER"] = os.environ["HW_ENV_CHAINING_HOLDER"]
# The discriminator run_is_here() reads. Written unconditionally, because a
# missing value has to mean "legacy run" and nothing else.
if os.environ.get("HW_ENV_MODE"):
    values["HW_LAUNCH_MODE"] = os.environ["HW_ENV_MODE"]

lines = ["# written by hw — the environment of run %s.\n" % values["HW_RUN"],
         "# Reconstruct it with:  set -a; . env; set +a\n",
         "# Grammar is fixed: one KEY='value' per line, inner ' as '\\''.\n"]
for key in sorted(values):
    value = values[key]
    if value == "":
        continue
    if not key.replace("_", "").isalnum():
        print("skipping env name %r: not [A-Za-z0-9_]" % key, file=sys.stderr)
        continue
    if "\n" in value:
        print("skipping %s: its value contains a newline, which the one-line "
              "grammar cannot carry" % key, file=sys.stderr)
        continue
    lines.append("%s='%s'\n" % (key, value.replace("'", "'\\''")))

fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fh:
    fh.writelines(lines)
os.chmod(out, 0o600)
EOF
  then
    info "restore env → $dir/env (read back by shell startup after a herdr crash)"
  else
    warn "could not write $dir/env — a pane that comes back after a herdr crash"
    warn "will have no HW_* environment. Use 'herdr update --handoff' to restart."
  fi
  return 0
}

# The union of every pane's `env` in a RENDERED layout document. Names do not
# collide across panes in any lane, and the executor is the pane that matters,
# so one file per run is enough — a dev-server pane comes back dead anyway
# (non-agent panes restore as a bare login shell).
_layout_env_union() {
  printf '%s' "$1" \
    | jq -c '[ .. | objects | select(.type == "pane") | (.env // {}) ] | add // {}' \
      2>/dev/null || true
}

# Where each project's memory actually lives. A product lane's history sits
# under `brain`, not under its own name — see the shared rules, CLAUDE.shared.md.
_engram_label() {
  # Everything lands in `brain`. That is not laziness: it is where the history
  # is, for every project that has any. A per-project label was tried and the
  # 2026-08-20 audit found one lane holding 2 observations against brain's 2375.
  #
  # the repo-less lane is the exception, not a second data point for the rule above: it is a
  # brand-new lane with no history sitting under `brain` to prefer, and its own
  # brief (2026-09-09) asks for its memory to be its own label, not folded into `brain`
  # for that lane's historical reason.
  #
  # one lane is the OTHER exception, and it is the opposite kind: it is not a
  # new lane at all. Real history has been accumulating under that
  # label since well before this table existed, and `brain/<lane>/.mcp.json`
  # pins the brainer there. Without this arm the brainer would write under
  # that lane and its
  # executors under `brain` — a split label, which is the failure this table
  # exists to prevent and the one nobody notices until a search comes back
  # empty. that lane follows the repo-less one: a brand-new lane whose own `.mcp.json` pins
  # `--project <lane>`.
  # The label itself is `engram` in projects.json; `brain` when unset.
  local v
  v="$(lane_get "$1" engram)" || v=""
  printf '%s' "${v:-brain}"
}

_free_channel_port() {
  python3 - <<'PY'
import socket
sock = socket.socket()
sock.bind(("127.0.0.1", 0))
print(sock.getsockname()[1])
sock.close()
PY
}

# Resolve the brainer's typed receiver address from the pane that invoked hw.
# Missing data keeps the legacy gated Herdr route; it never guesses an endpoint.
_resolve_invoker_context() {
  local info process port=""
  HW_INVOKER_VENDOR=""
  HW_INVOKER_SESSION=""
  HW_INVOKER_ENDPOINT=""
  [ -n "${HERDR_PANE_ID:-}" ] || return 0

  info="$(herdr agent get "$HERDR_PANE_ID" 2>/dev/null || true)"
  [ -n "$info" ] || return 0
  HW_INVOKER_VENDOR="$(printf '%s' "$info" | jq -r '.result.agent.agent // empty' 2>/dev/null || true)"
  HW_INVOKER_SESSION="$(printf '%s' "$info" | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true)"

  case "$HW_INVOKER_VENDOR" in
    opencode)
      process="$(herdr pane process-info --pane "$HERDR_PANE_ID" 2>/dev/null || true)"
      port="$(printf '%s' "$process" | jq -r '
        first(.result.process_info.foreground_processes[]?
          | select(any(.argv[]?; . == "opencode")) | .argv) as $argv
        | ($argv | index("--port")) as $i
        | if $i == null then empty else $argv[$i + 1] // empty end
      ' 2>/dev/null || true)"
      [ -n "$port" ] && HW_INVOKER_ENDPOINT="http://127.0.0.1:$port"
      ;;
    codex)
      if [ -z "$HW_INVOKER_SESSION" ]; then
        HW_INVOKER_SESSION="$(printf '%s' "$info" | jq -r '.result.agent.cwd // empty | split("/")[-1]' 2>/dev/null || true)"
      fi
      HW_INVOKER_ENDPOINT="$HOME/.codex/app-server-control/app-server-control.sock"
      ;;
    claude)
      HW_INVOKER_ENDPOINT="-"
      ;;
  esac
  export HW_INVOKER_VENDOR HW_INVOKER_SESSION HW_INVOKER_ENDPOINT
  return 0
}

# Translate --model/--effort into the flags the chosen CLI actually has.
# `herdr agent start ... -- <args>` passes them through to the executable.
#
#   claude    --model <alias|full>   --effort low|medium|high|xhigh|max
#   opencode  --model provider/model  (no effort: --variant exists on
#             `opencode run` only, not on the interactive command; set
#             `variant` on the agent in opencode.json instead)
#   codex     --model <catalog slug>  -c model_reasoning_effort=<level>
#
# Anything hw cannot express, it refuses rather than dropping silently.
# ── the brief's own dispatch declaration ────────────────────────────────────
#
# THE LAST FALSE-SUCCESS SURFACE, and the one that cost the most on 2026-08-24:
# a brief said "OpenCode direct openai/gpt-5.6-sol, explicit product-lane project tab,
# fresh worktree, isolated DB" in PROSE, and hw launched whatever the flags
# happened to say. Claude was launched where OpenCode belonged; --space was used
# where a tab was meant. Nothing compared the two, because nothing could: the
# requirement was a paragraph and the dispatch was a flag list.
#
# So a brief MAY declare its dispatch in YAML frontmatter:
#
#     ---
#     agent: opencode
#     model: openai/gpt-5.6-sol
#     sdd: none
#     placement: project-tab
#     worktree: new
#     database: own
#     base: staging
#     ---
#
# ADDITIVE, DELIBERATELY. A brief without frontmatter dispatches exactly as it
# does today — 84 of 84 briefs have none, and breaking every one of them to gain
# a check nobody has written yet would be the wrong trade. What changes for
# those is one manifest line saying the brief declared nothing, so the gap is
# visible instead of assumed.
#
# Only keys that are PRESENT are checked. A declaration that disagrees with the
# resolved dispatch stops the launch BEFORE anything is built — no worktree, no
# database, no pane — because the whole point is to fail while failing is free.
# THE FRONTMATTER IS PARSED ONCE PER DISPATCH, and both consumers read the same
# answer. Two of them exist now — the contract check and the SDD model gate,
# which runs earlier — and a second call would be a second `python3` spawn for
# one key, plus a second place for the two to disagree about what the brief said.
#
# Assigns a global rather than printing, deliberately: a `$(...)` memo runs in a
# subshell and the cached value dies with it, so the "memoised" version would
# have parsed every time while claiming not to.
BRIEF_DECLS=""
BRIEF_DECLS_READ=0
_load_brief_decls() {
  [ "${BRIEF_DECLS_READ:-0}" = 1 ] && return 0
  BRIEF_DECLS="$(_brief_declares "${BRIEF:-}")" || BRIEF_DECLS=""
  BRIEF_DECLS_READ=1
  return 0
}

_brief_declares() {  # $1 = brief path; prints "key<TAB>value" per line
  [ -f "${1:-}" ] || return 0
  python3 - "$1" <<'PYEOF'
import sys
lines = open(sys.argv[1], encoding="utf-8", errors="replace").read().split("\n")
if not lines or lines[0].strip() != "---":
    raise SystemExit(0)
try:
    end = lines.index("---", 1)
except ValueError:
    # An opening fence with no close is a malformed brief, not a brief with no
    # frontmatter. Say so rather than silently dispatching unchecked.
    print("__malformed__\tunterminated frontmatter: no closing --- found")
    raise SystemExit(0)
known = {"agent", "model", "sdd", "placement", "worktree", "database", "invoker",
         "requires", "requires-agents", "kind", "base", "decision", "delivery",
         "boundary", "deployed_check", "sandbox"}
# What was asked for, read by _check_requested rather than compared.
known |= {"requested_by", "asked"}
for raw in lines[1:end]:
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if ":" not in line:
        print("__malformed__\tnot a key: value pair: %s" % line)
        continue
    key, _, value = line.partition(":")
    key = key.strip().lower()
    value = value.strip().strip("\"'")
    if not value:
        continue
    if key not in known:
        print("__unknown__\t%s" % key)
        continue
    print("%s\t%s" % (key, value))
PYEOF
}

# The resolved value for one declared key, in the brief's vocabulary.
_dispatch_actual() {
  case "$1" in
    agent)     printf '%s' "$AGENT" ;;
    model)     printf '%s' "${MODEL:-<agent default>}" ;;
    # THE EFFECTIVE MODE, NOT THE ONE THAT WAS ASKED FOR. Measured: this
    # printed `"${SDD:-none}"`, which is the value of
    # `--sdd` — so a brief declaring `sdd: none` and dispatched WITHOUT `--sdd`
    # compared `none` against `none`, matched, and was recorded in the manifest
    # as a contract field hw had VERIFIED. The dispatch then resolved the
    # directory's live framework mode, which differed per lane, and that is what
    # actually applied. The
    # declaration was compared against a placeholder.
    #
    # Same family as the reuse manifest printing `model=opus (chosen)` over a
    # pane running something else, closed in fafe525: a field that reports what
    # was REQUESTED where the reader needs what will HAPPEN.
    #
    # `${SDD_EFFECTIVE_MODE+set}`, not `-n`: the resolver legitimately sets it
    # to the EMPTY string when no framework is in force, and that means `none`,
    # not "unresolved". Falling back on emptiness would reintroduce the bug for
    # exactly the dispatches that have no mode.
    sdd)       if [ -n "${SDD_EFFECTIVE_MODE+set}" ]; then printf '%s' "${SDD_EFFECTIVE_MODE:-none}"
               else printf '%s' "${SDD:-none}"; fi ;;
    placement) if   [ "$HERE" = 1 ];       then printf 'here'
               elif [ "${TAB:-0}" = 1 ];   then printf 'project-tab'
               else                             printf 'legacy-space'; fi ;;
    worktree)  if [ "${WANT_WT:-1}" = 0 ]; then printf 'none'; else printf 'new'; fi ;;
    database)  if [ "${WANT_DB:-1}" = 0 ]; then printf 'main'; else printf 'own'; fi ;;
    invoker)   printf '%s' "$(_invoker_pane)" ;;
    # A repoless lane has no base at all, and printing an empty string would
    # let `base: staging` in a brief compare equal to nothing and pass.
    base)      printf '%s' "$(_task_base)" ;;
  esac
}

# THE VENDOR FILES A LAUNCH OR A RE-TASK IS ABOUT TO HAND AN AGENT, checked
# BEFORE the brief reaches it. MEASURED 2026-09-22: gentle-ai was removed from
# this machine, but a product-lane task ran in a worktree
# whose branch predates `dade6b7` (the commit that dropped it from the lane's
# settings), so its VERSIONED `.claude/settings.json` still registered
# `gentle-ai sdd-preflight-hook` on PreToolUse, `gentle-ai review stop-hook` /
# `gentle-ai telemetry runtime` on SessionStart/Stop/SubagentStop, and
# `gentle-ai skill-registry refresh` on UserPromptSubmit — and the executor's
# first hook fired straight into `/bin/sh: gentle-ai: command not found`, with
# nobody told before it happened. ~150 worktrees across product lanes and
# `$WORK/setup` share the same branch-point problem.
_worktree_hook_files() {  # $1 = worktree dir; prints candidate hook-config files that exist, one per line
  local wt="$1" f
  for f in "$wt/.claude/settings.json" "$wt/.claude/settings.local.json" \
           "$wt/.codex/hooks.json" "$wt/opencode.json"; do
    [ -f "$f" ] && printf '%s\n' "$f"
  done
}

# file<TAB>command<TAB>missing-binary, one line per hook whose invoked binary
# hw cannot find. GENERIC, not hardcoded to `gentle-ai`: it walks every
# `{"type": "command", "command": "..."}` node regardless of which event key
# holds it, because Claude's settings.json and Codex's hooks.json nest hooks
# identically — `hooks.<Event>[].hooks[].{command,type}` — so one walk covers
# both files, and an OpenCode config that ever adopts the same shape is
# covered without a second implementation. A command hw cannot even parse
# (malformed quoting) is skipped rather than guessed at — silence there, not a
# false refusal.
_stale_hook_report() {  # $1 = worktree dir
  local wt="$1"
  local -a files=()
  while IFS= read -r f; do files+=("$f"); done < <(_worktree_hook_files "$wt")
  [ "${#files[@]}" -gt 0 ] || return 0
  python3 - "$wt" "${files[@]}" <<'PY'
import json, os, re, shlex, shutil, sys

wt = sys.argv[1]

def find_commands(obj):
    out = []
    if isinstance(obj, dict):
        if obj.get("type") == "command" and isinstance(obj.get("command"), str):
            out.append(obj["command"])
        for v in obj.values():
            out.extend(find_commands(v))
    elif isinstance(obj, list):
        for v in obj:
            out.extend(find_commands(v))
    return out

# $CLAUDE_PROJECT_DIR and $PWD are the two env vars this repo's own hooks are
# written against (setup/.claude/settings.json), and BOTH are measured to
# equal the worktree root at hook-run time — Claude Code sets the former to
# the project root and a hook always runs from it. Substituting them here is
# not a guess, it is the one substitution this call site can prove. shlex has
# no shell semantics at all otherwise: `$CLAUDE_PROJECT_DIR/hooks/x.py`,
# unexpanded, is a path that never exists, and the FIRST version of this
# function reported EVERY worktree's own real deny-repo-writes.py hook as
# missing — a false refusal on every single healthy worktree, caught by
# running this against this very checkout before it shipped.
def expand_known(cmd):
    for name in ("CLAUDE_PROJECT_DIR", "PWD"):
        cmd = cmd.replace("${" + name + "}", wt).replace("$" + name, wt)
    return cmd

def missing_binary(cmd):
    cmd = expand_known(cmd)
    try:
        tokens = shlex.split(cmd)
    except ValueError:
        return None
    while tokens and re.match(r'^[A-Za-z_][A-Za-z0-9_]*=', tokens[0]):
        tokens = tokens[1:]
    if not tokens:
        return None
    b = tokens[0]
    # An env var this call site cannot prove the value of. Guessing it is
    # unset/wrong would be the same false-refusal shape as the bug above;
    # skipped as unverifiable, same as a command shlex cannot even parse.
    if "$" in b:
        return None
    if b.startswith("/"):
        ok = os.path.isfile(b) and os.access(b, os.X_OK)
    elif "/" in b:
        # A worktree-relative path with no $CLAUDE_PROJECT_DIR/$PWD prefix —
        # legitimate, since a hook always runs with CWD already at the
        # project root (".claude/hooks/foo.py", "scripts/hook.sh"). Resolving
        # it against hw's OWN cwd instead of `wt` is the exact false-positive
        # class this function already had to fix once for the prefixed case;
        # this is that same class for the unprefixed one, caught in review
        # before it shipped rather than after.
        p = os.path.join(wt, b)
        ok = os.path.isfile(p) and os.access(p, os.X_OK)
    else:
        ok = shutil.which(b) is not None
    return None if ok else b

for path in sys.argv[2:]:
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError):
        continue
    seen = set()
    for cmd in find_commands(data):
        if cmd in seen:
            continue
        seen.add(cmd)
        binname = missing_binary(cmd)
        if binname:
            print(f"{path}\t{cmd}\t{binname}")
PY
}

# THE REFUSAL ITSELF. Called where a worktree is about to be handed to a live
# agent — new, reused as a directory, or reused as a pane via `hw next` — so
# every route a brief can reach an executor through is covered by the same
# check. `--allow-stale-hooks` is the named override: it launches anyway, but
# says so loudly and is recorded in the receipt (`STALE_HOOKS_ALLOWED_FILES`,
# read by each call site — see below), NOT in `_dispatch_manifest`: that
# manifest is printed before any of the five lane worktree steps or `cmd_next`
# run, so a fact set here could never reach it. The receipt is what hw actually
# has open at this point, and `hw receipt <project> <task>` is how it is read
# back.
#
# THE REMEDY IS STATED, NOT GUESSED. `git merge <base>` is measured to work:
# the base branch already dropped the dead hook, so merging it in replaces the
# stale settings.json with the current one. `--fresh` is NOT offered as a
# remedy here even though an earlier draft of this task named it — measured
# against this file, `--fresh` only skips PANE reuse (`_reuse_flag_decision`);
# it does not touch worktree provisioning and would not rebuild anything from
# base. Naming it would be a wrong prescription resting on an unchecked claim,
# so the remedy given instead is the one hw can actually perform: remove the
# stale worktree and dispatch again, so `_lane_wt_dir` finds nothing there and
# builds a fresh one from base.
_refuse_if_stale_hooks() {  # $1 = worktree dir, $2 = main checkout (for the remedy text), $3 = base ref or "" if unknown
  local wt="$1" main="${2:-}" base="${3:-}" report files
  STALE_HOOKS_ALLOWED_FILES=""
  report="$(_stale_hook_report "$wt")"
  [ -n "$report" ] || return 0
  files="$(printf '%s\n' "$report" | cut -f1 | sort -u | paste -sd' ' -)"
  if [ "${ALLOW_STALE_HOOKS:-0}" = 1 ]; then
    warn "STALE HOOKS in $wt — launching anyway (--allow-stale-hooks): $files"
    printf '%s\n' "$report" | while IFS="$(printf '\t')" read -r f cmd bin; do
      warn "  $f: '$cmd' -> '$bin' not found"
    done
    # Set for the CALLER to persist: this function runs before $WT/$HW_RUN
    # exist on the fresh-launch route and after they are gone on the `hw next`
    # route, so it cannot write a receipt itself in every shape it is called
    # from. `_receipt` below covers the one shape where it CAN (a fresh or
    # reused-directory launch, where $WT/$HW_RUN are already set); `cmd_next`'s
    # own call site reads this global and writes into its own $rundir instead.
    STALE_HOOKS_ALLOWED_FILES="$files"
    _receipt stale_hooks_allowed "$files" "--allow-stale-hooks"
    return 0
  fi
  warn "this worktree's VERSIONED hook settings invoke a binary hw cannot find on this machine:"
  printf '%s\n' "$report" | while IFS="$(printf '\t')" read -r f cmd bin; do
    warn "  $f: '$cmd' -> '$bin' not found"
  done
  # NOT A GIT WORKTREE AT ALL — the setup lane's pre-2026-09-16 plain
  # directories (see its own case block). `git -C '$wt' merge`/`worktree
  # remove` both fail outright there: there is no branch to merge into and no
  # worktree registration to remove. Judge A, Judgment Day round for this
  # change: the two git remedies below were stated unconditionally and did
  # not hold for exactly the case the surrounding call site says this check
  # deliberately still runs for.
  if [ ! -e "$wt/.git" ]; then
    die "refusing to hand a brief to $wt: its versioned hook settings ($files) invoke a binary that is not on PATH — see above. $wt is not a git worktree (no .git), so there is no branch to merge and nothing to remove with \`git worktree remove\`. Fix the file(s) directly, or dispatch under a task name with no existing directory so hw builds a real worktree. Override with --allow-stale-hooks if you must launch onto it anyway (recorded in the receipt)."
  fi
  local branch
  branch="$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null || true)"
  # WHETHER ROLLBACK IS ABOUT TO DELETE $wt, DECIDED BEFORE ANY MESSAGE IS
  # BUILT — both judges' round-2 re-judgment on this same fix, independently:
  # the remedy text named `$wt` unconditionally, but `_launch_rollback` (added
  # in that same round) can remove `$wt` from disk before the message is ever
  # printed, whenever THIS launch is the one that created it. A `git -C '$wt'
  # merge` naming a path that is already gone is not a fix, it is a second
  # bug shaped like the first. `$LAUNCH_WT` is compared, not just
  # `$LAUNCH_WT_CREATED`, because on the `hw next` route those globals belong
  # to whatever the LAST fresh launch in this process created, if anything —
  # never THIS worktree — and must not be misread as "this one was just
  # rolled back".
  local rolled_back=0
  if [ -n "$main" ] && [ "${LAUNCH_WT_CREATED:-0}" = 1 ] && [ "${LAUNCH_WT:-}" = "$wt" ]; then
    rolled_back=1
  fi
  if [ "$rolled_back" = 1 ]; then
    _launch_rollback "$main"
    if [ "${LAUNCH_BRANCH_CREATED:-0}" = 1 ]; then
      die "refusing to hand a brief to $wt: its versioned hook settings ($files) invoke a binary that is not on PATH — see above. This worktree and its branch were both created by THIS launch and have just been rolled back — there is nothing left to clean up. Dispatch again: hw builds a fresh worktree off the base, since none exists at that path any more. Override with --allow-stale-hooks if you must launch onto it anyway (recorded in the receipt)."
    elif [ -n "$branch" ]; then
      die "refusing to hand a brief to $wt: its versioned hook settings ($files) invoke a binary that is not on PATH — see above. This launch's worktree has just been rolled back, but its branch ($branch) existed BEFORE this launch and was left alone — the next dispatch will re-add a worktree on that same stale branch and hit this same refusal again. Delete it first: git -C '$main' branch -D '$branch' — then dispatch again for a fresh worktree off the base. Or keep that branch's work: check it out somewhere else and merge the base into it before you delete anything here. Override with --allow-stale-hooks if you must launch onto it anyway (recorded in the receipt)."
    else
      die "refusing to hand a brief to $wt: its versioned hook settings ($files) invoke a binary that is not on PATH — see above. This launch's worktree has just been rolled back; its branch name could not be read. Dispatch again, or inspect $main's branches by hand if one was left behind. Override with --allow-stale-hooks if you must launch onto it anyway (recorded in the receipt)."
    fi
  fi
  # THE ORDINARY CASE: $wt is an OLD worktree, on disk from a previous
  # session, that THIS launch only found and reused — the exact shape the
  # brief for this whole guard measured (a product-lane task-
  # gastronomico). Nothing was just deleted, so `$wt` and `$branch` are both
  # still real paths a command can act on.
  local fix_merge fix_fresh
  if [ -n "$base" ]; then
    fix_merge="git -C '$wt' merge '$base'"
  else
    fix_merge="git -C '$wt' merge <this lane's base branch>"
  fi
  # BOTH STEPS, NOT ONE — Judge B, round 1: worded as "delete the branch IF
  # it is being abandoned" made deletion read as optional, and it is not.
  # `git worktree add <path> <branch>` on an EXISTING branch (see the "branch
  # already existed" arm every lane block has) reuses it as-is — same stale
  # settings.json, same refusal, forever — so a "start fresh" that keeps the
  # branch does not do what it says.
  if [ -n "$main" ] && [ -n "$branch" ]; then
    fix_fresh="git -C '$main' worktree remove '$wt' && git -C '$main' branch -D '$branch'  (BOTH — keeping the branch means the next dispatch reuses it and hits this same refusal again), then dispatch again so hw builds a fresh worktree off the base"
  elif [ -n "$main" ]; then
    fix_fresh="git -C '$main' worktree remove '$wt', then delete this worktree's branch too (both, or the next dispatch reuses it and hits this same refusal again), then dispatch again so hw builds a fresh worktree off the base"
  else
    fix_fresh="remove the worktree AND its branch — both, or the next dispatch reuses the branch and hits this same refusal again — then dispatch again so hw builds a fresh worktree off the base"
  fi
  die "refusing to hand a brief to $wt: its versioned hook settings ($files) invoke a binary that is not on PATH — see above. This branch predates the cleanup that dropped it. Fix: $fix_merge — brings the base's current settings into this branch. Or start over: $fix_fresh. Override with --allow-stale-hooks if you must launch onto it anyway (recorded in the receipt)."
}

# WHAT THE TARGET CAN DO, checked at dispatch instead of discovered at minute 40.
#
# A brainer cannot see what its delegate will have. `<lane>:<task>-
# requirements` needed to read JS-only pages and had only WebFetch, while the
# brainer own session had claude-in-chrome and could have rendered them — the
# task shipped three lower-confidence citations and nobody knew why until
# afterwards. A whole class of task is structurally undelegatable and nothing
# said so at dispatch.
#
# A WARNING, NOT A REFUSAL, and the distinction is deliberate: hw knows which
# vendor it is launching, not what that session will actually be able to reach.
# Refusing on a guess would block work that would have succeeded. Saying it out
# loud, before the launch, costs nothing and is the part that was missing.
_check_capabilities() {
  local want rest="$1" bad=""
  while [ -n "$rest" ]; do
    want="${rest%%,*}"
    case "$rest" in *,*) rest="${rest#*,}" ;; *) rest="" ;; esac
    want="$(printf '%s' "$want" | tr -d ' ')"
    [ -n "$want" ] || continue
    case "$want" in
      browser|claude-in-chrome)
        [ "$AGENT" = claude ] || bad="$bad $want(needs claude; $AGENT reaches a browser only through agent-browser, which is a CLI and not the same instrument)" ;;
      subagents)
        [ "$AGENT" = opencode ] || bad="$bad $want(hw enables OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS only for opencode)" ;;
      repo)
        [ "${WANT_WT:-1}" = 1 ] || bad="$bad $want(this dispatch has --worktree none, so there is no checkout)" ;;
      database)
        [ "${WANT_DB:-1}" = 1 ] || bad="$bad $want(this dispatch has --no-db, so it shares the main checkout database)" ;;
      *) warn "brief requires '"'"'$want'"'"', which hw cannot check. Known: browser subagents repo database" ;;
    esac
  done
  if [ -n "$bad" ]; then
    warn "the brief requires capabilities this target may not have:$bad"
    warn "this is a WARNING, not a refusal — hw knows the vendor, not what the session can reach. If it matters, change --agent or the brief before the work reaches minute 40."
  else
    BRIEF_DECLARED="${BRIEF_DECLARED}${BRIEF_DECLARED:+ }requires"
  fi
  return 0
}

# A NAMED MECHANISM IS A HARD CONTRACT, not a capability hint.
#
# `requires:` remains a warning because hw cannot prove whether a browser,
# database or other runtime surface will be reachable. A named agent is
# different: its registry is local and vendor-specific, so dispatch can prove
# the exact identity before it builds anything. Keep this as a separate key so
# the warning semantics of existing `requires:` briefs cannot silently weaken a
# required-agent refusal.
#
# A name alone preserves the original contract: the agent may exist in either
# role. A role-aware requirement is written `primary:<name>` or
# `subagent:<name>`. The prefix keeps comma-separated declarations compact and,
# unlike a second parallel list, makes each role inseparable from the identity
# it qualifies. That matters when one brief needs more than one mechanism.
# OpenCode's `mode: all` satisfies either role. Claude project agent files are
# Task-only subagents, so they can never satisfy `primary:`.
_agent_markdown_mode() {  # $1 = agent markdown path; prints primary|subagent|all
  python3 - "$1" <<'PY' 2>/dev/null
import re, sys

try:
    text = sys.stdin.read() if sys.argv[1] == "-" else open(
        sys.argv[1], encoding="utf-8", errors="replace").read()
    lines = text.splitlines()
except OSError:
    raise SystemExit(1)
mode = "all"
if lines and lines[0].strip() == "---":
    for line in lines[1:]:
        if line.strip() == "---":
            break
        match = re.match(r"^\s*mode\s*:\s*['\"]?([^'\"\s#]+)", line, re.I)
        if match:
            mode = match.group(1).lower()
            break
if mode not in {"primary", "subagent", "all"}:
    raise SystemExit(1)
print(mode)
PY
}

_agent_mode_matches() {  # $1 = required role, $2 = declared mode
  [ "$1" = any ] || [ "$2" = all ] || [ "$1" = "$2" ]
}

# A CLAUDE AGENT IS ITS `name:`, NOT ITS FILE NAME. Claude Code resolves a
# subagent by the `name:` in the frontmatter and falls back to the file name
# only when `name:` is absent, so `repo-auditor.md` declaring `name: or-explorer`
# is reachable as `or-explorer` and NOT as `repo-auditor`. Building the path
# `agents/$name.md` refused exactly that agent. Prints `name<TAB>source` per
# definition in one directory: `dir <path>` for a tree on disk, or
# `git <repo> <ref> <subdir>` for the committed tree a new worktree will receive.
_claude_agent_index() {
  python3 - "$@" <<'PY' 2>/dev/null
import os, re, subprocess, sys

def declared(text):
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return ""
    for line in lines[1:]:
        if line.strip() == "---":
            break
        m = re.match(r"^name\s*:\s*(.*?)\s*$", line)
        if m:
            return m.group(1).strip().strip("'\"").strip()
    return ""

entries = []
if sys.argv[1] == "dir":
    root = sys.argv[2]
    for f in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        path = os.path.join(root, f)
        if f.endswith(".md") and os.path.isfile(path):
            try:
                text = open(path, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            entries.append((declared(text) or f[:-3], path))
else:
    repo, ref, sub = sys.argv[2:5]
    ls = subprocess.run(["git", "-C", repo, "ls-tree", "--name-only", "%s:%s" % (ref, sub)],
                        capture_output=True, text=True)
    for f in sorted(ls.stdout.split("\n")) if ls.returncode == 0 else []:
        if not f.endswith(".md"):
            continue
        spec = "%s:%s/%s" % (ref, sub, f)
        show = subprocess.run(["git", "-C", repo, "show", spec],
                              capture_output=True, text=True, errors="replace")
        if show.returncode == 0:
            entries.append((declared(show.stdout) or f[:-3], spec))
for name, source in entries:
    print("%s\t%s" % (name, source))
PY
}

_claude_agent_source() {  # $1 = name, $2 = lane checkout ("" for none); prints source
  local name="$1" project_dir="$2" task_dir="$WORK/$PROJ/$TASK" hit
  _claude_agent_lookup() {
    _claude_agent_index "$@" | awk -F '\t' -v n="$name" '$1 == n { print $2; exit }'
  }
  hit="$(_claude_agent_lookup dir "$task_dir/.claude/agents")"
  # One lane's worktree script links this local config directory from the
  # main checkout, so its source file proves the future worktree. The other
  # checks out from the remote base and does not overlay .claude/agents, so
  # the tree it will actually receive is the one to read.
  if [ -z "$hit" ] && [ -n "$project_dir" ] && [ "${WANT_WT:-1}" = 1 ]; then
    case "$(lane_get "$PROJ" agents_from)" in
      checkout) hit="$(_claude_agent_lookup dir "$project_dir/.claude/agents")" ;;
      base) hit="$(_claude_agent_lookup git "$project_dir" "$(_lane_agents_ref "$PROJ")" .claude/agents)" ;;
    esac
  fi
  [ -n "$hit" ] || hit="$(_claude_agent_lookup dir "$HOME/.claude/agents")"
  [ -n "$hit" ] || return 1
  printf '%s' "$hit"
}

# OpenCode merges the project's opencode.json over the user's, so an agent
# registered only under the project's `.agent` key is as reachable as a file.
# Prints `mode<TAB>source` like _opencode_project_agent; returns 2 on an
# invalid mode and 1 when no project config defines the name.
_opencode_project_config_agent() {  # $1 = name, $2 = config path or ref:path, $3 = repo for a ref
  local name="$1" conf="$2" repo="${3:-}" json mode
  if [ -n "$repo" ]; then
    json="$(git -C "$repo" show "$conf" 2>/dev/null)" || return 1
  else
    [ -f "$conf" ] || return 1
    json="$(cat "$conf")"
  fi
  # An entry with no `mode` only overrides a built-in or user agent (route-
  # optimization's `build`/`plan` set just a model), so its mode is not this
  # file's to state: fall through to the definitions hw read before.
  printf '%s' "$json" | jq -e --arg a "$name" '.agent[$a] | type == "object" and has("mode")' >/dev/null 2>&1 || return 1
  mode="$(printf '%s' "$json" | jq -r --arg a "$name" '.agent[$a].mode' 2>/dev/null)" || return 2
  case "$mode" in primary|subagent|all) ;; *) return 2 ;; esac
  printf '%s\t%s' "$mode" "$conf"
}

_opencode_project_agent() {  # $1 = name; prints "mode<TAB>source"
  local name="$1" task_dir="$WORK/$PROJ/$TASK" oc_project_dir="" path mode
  if _lane_is_product_repo "$PROJ"; then oc_project_dir="$(lane_checkout "$PROJ")"; fi
  for path in \
    "$task_dir/.opencode/agent/$name.md" \
    "$task_dir/.opencode/agents/$name.md"; do
    [ -f "$path" ] || continue
    mode="$(_agent_markdown_mode "$path")" || return 2
    printf '%s\t%s' "$mode" "$path"
    return 0
  done
  # A lane whose worktree script links the complete local .opencode directory
  # into every new worktree (`agents_from: checkout`): the source file proves
  # what the future worktree can invoke before hw builds it.
  local agents_from agents_ref
  agents_from="$(lane_get "$PROJ" agents_from)" || agents_from=""
  agents_ref="$(_lane_agents_ref "$PROJ")"
  if [ "$agents_from" = checkout ] && [ "${WANT_WT:-1}" = 1 ]; then
    for path in \
      "$oc_project_dir/.opencode/agent/$name.md" \
      "$oc_project_dir/.opencode/agents/$name.md"; do
      [ -f "$path" ] || continue
      mode="$(_agent_markdown_mode "$path")" || return 2
      printf '%s\t%s' "$mode" "$path"
      return 0
    done
  fi
  # A lane that builds a new worktree from its remote base (`agents_from:
  # base`): inspect that immutable source rather than accepting a file present
  # only on the main checkout's current branch.
  if [ "$agents_from" = base ] && [ "${WANT_WT:-1}" = 1 ]; then
    local rel
    for rel in ".opencode/agent/$name.md" ".opencode/agents/$name.md"; do
      if git -C "$oc_project_dir" cat-file -e "$agents_ref:$rel" 2>/dev/null; then
        mode="$(git -C "$oc_project_dir" show "$agents_ref:$rel" 2>/dev/null | _agent_markdown_mode -)" || return 2
        printf '%s\t%s' "$mode" "$agents_ref:$rel"
        return 0
      fi
    done
  fi
  # The project's opencode.json registers agents under `.agent` with no file at
  # all. One lane's worktree script COPIES the main checkout's opencode.json
  # into each new worktree; the other's comes from the remote base's tree.
  local status
  _opencode_project_config_agent "$name" "$task_dir/opencode.json"; status=$?
  [ "$status" = 1 ] || return "$status"
  if [ "$agents_from" = checkout ] && [ "${WANT_WT:-1}" = 1 ] && [ -n "$oc_project_dir" ]; then
    _opencode_project_config_agent "$name" "$oc_project_dir/opencode.json"; status=$?
    [ "$status" = 1 ] || return "$status"
  fi
  if [ "$agents_from" = base ] && [ "${WANT_WT:-1}" = 1 ] && [ -n "$oc_project_dir" ]; then
    _opencode_project_config_agent "$name" "$agents_ref:opencode.json" "$oc_project_dir"; status=$?
    [ "$status" = 1 ] || return "$status"
  fi
  # User-level markdown definitions are the final file-based fallback. Project
  # definitions come first because OpenCode merges the nearer config over them.
  for path in \
    "$HOME/.config/opencode/agent/$name.md" \
    "$HOME/.config/opencode/agents/$name.md"; do
    [ -f "$path" ] || continue
    mode="$(_agent_markdown_mode "$path")" || return 2
    printf '%s\t%s' "$mode" "$path"
    return 0
  done
  return 1
}

_check_required_agents() {  # $1 = comma-separated names
  local spec required role rest="$1" bad=0 oc_conf="$HOME/.config/opencode/opencode.json"
  local project_agent project_mode project_source config_mode
  while [ -n "$rest" ]; do
    spec="${rest%%,*}"
    case "$rest" in *,*) rest="${rest#*,}" ;; *) rest="" ;; esac
    spec="$(printf '%s' "$spec" | tr -d ' ')"
    [ -n "$spec" ] || continue
    role=any
    case "$spec" in
      primary:*)   role=primary; required="${spec#primary:}" ;;
      subagent:*)  role=subagent; required="${spec#subagent:}" ;;
      *)           required="$spec" ;;
    esac
    case "$required" in
      ""|*[!A-Za-z0-9._-]*|.|..)
        warn "brief requires agent '$spec', but the accepted shape is [primary:|subagent:]name and names may only contain letters, digits, dot, underscore and dash"
        bad=1
        continue
        ;;
    esac
    case "$AGENT" in
      opencode)
        project_agent="$(_opencode_project_agent "$required")" || {
          case "$?" in
            2)
              warn "brief requires agent '$spec', but its project definition has no valid mode (primary, subagent or all)"
              bad=1
              continue
              ;;
          esac
          project_agent=""
        }
        if [ -n "$project_agent" ]; then
          project_mode="${project_agent%%$(printf '\t')*}"
          project_source="${project_agent#*$(printf '\t')}"
          if ! _agent_mode_matches "$role" "$project_mode"; then
            warn "brief requires agent '$required' as $role, but $project_source declares mode: $project_mode"
            bad=1
          fi
        elif [ ! -r "$oc_conf" ] || ! jq -e '.agent | type == "object"' "$oc_conf" >/dev/null 2>&1; then
          warn "brief requires agent '$spec' for opencode, but hw cannot read a valid .agent registry from $oc_conf and found no reachable project agent definition"
          bad=1
        elif ! jq -e --arg a "$required" '.agent[$a]' "$oc_conf" >/dev/null 2>&1; then
          warn "brief requires agent '$spec', but opencode has no .agent[$required] in $oc_conf and no reachable .opencode/agent(s)/$required.md"
          bad=1
        elif [ "$role" != any ]; then
          config_mode="$(jq -r --arg a "$required" '.agent[$a].mode // "all"' "$oc_conf" 2>/dev/null)"
          case "$config_mode" in primary|subagent|all) ;; *) config_mode=invalid ;; esac
          if ! _agent_mode_matches "$role" "$config_mode"; then
            warn "brief requires agent '$required' as $role, but $oc_conf declares mode: $config_mode"
            bad=1
          fi
        fi
        ;;
      claude)
        local project_dir="" found=""
        if _lane_is_product_repo "$PROJ"; then project_dir="$(lane_checkout "$PROJ")"; fi
        found="$(_claude_agent_source "$required" "$project_dir")" || found=""
        if [ -z "$found" ]; then
          warn "brief requires agent '$spec', but claude cannot reach an agent named '$required' (frontmatter name:, or the file name when name: is absent) in .claude/agents from the intended workdir"
          bad=1
        elif [ "$role" = primary ]; then
          warn "brief requires agent '$required' as primary, but Claude .claude/agents/*.md definitions are Task-only subagents"
          bad=1
        fi
        ;;
      *)
        warn "brief requires agent '$required', but hw cannot verify named agents for vendor $AGENT"
        bad=1
        ;;
    esac
  done
  if [ "$bad" = 1 ]; then
    return 1
  fi
  BRIEF_DECLARED="${BRIEF_DECLARED}${BRIEF_DECLARED:+ }requires-agents"
  return 0
}

# THE LANE'S MAIN CHECKOUT, in one place. Repeating the case block reads as
# harmless and is not: tests/49 pins the product-lane assignment inside
# _check_required_agents as a mutation anchor that must appear EXACTLY ONCE, so
# a second copy silently disarms that mutant instead of adding a reader — which
# is why this helper exists rather than a third copy. Prints nothing for a
# repoless lane, which is the correct answer there rather than an error.
# `${X:-}`, NOT `$X`, AND THAT IS NOT DEFENSIVENESS — it is this file's own
# most expensive failure mode, arriving through a new door.
#
# hw always has these five set: project-spaces.sh assigns them at load and hw
# dies if it cannot source it, so the guard never changes an answer hw gives.
# What it changes is what happens when ONE FUNCTION IS LIFTED OUT of this file,
# which is how four subject files drive `_verify_at_close` — and since
# 2026-09-16 that function reaches this table through `_artifacts_dir_for`.
# Measured the same day: extracted without the globals, `set -u` killed the
# close on `BRAIN: unbound variable`, and tests/142 reported it as
# "the verification did not run on a FREE lane" — a harness dependency wearing
# the costume of the lock that subject exists to test. That subject exists
# because an unbound variable killed a REAL close once (`$WORK`, same shape).
_lane_main_checkout() {  # $1 = project
  # setup's checkout is `{brain}` in projects.json, not a SETUP_MAIN constant:
  # a second name for one path is the drift bin/project-spaces.sh exists to stop.
  lane_checkout "$1" || true
}

# A lane whose checkout is a PRODUCT repository (`product_repo: true`): its
# worktree is built by the repo's own script and inherits the repo's surface,
# so questions about framework mode and agents are asked of the checkout.
_lane_is_product_repo() {  # $1 = project
  [ "$(lane_get "$1" product_repo)" = 1 ]
}

# WHETHER A LANE HAS A CHECKOUT AT ALL, derived from the table above rather
# than hand-typed. `<the four product lanes>` was written out as
# a literal at TWELVE sites, which is eleven chances for a lane to be added to
# some of them and not the rest — and adding `setup` is exactly the edit that
# would have hit that. An unknown project name still answers "no repo", because
# _lane_main_checkout prints nothing for it, so nothing but setup changes here.
#
# NOT the inverse of _is_repoless, deliberately. That list says which lanes have
# no checkout ANYWHERE; this says which have one hw knows the path of. They
# agree today and would still be two different questions if they stopped to.
_lane_has_repo() {  # $1 = project
  [ -n "$(_lane_main_checkout "$1")" ]
}

# WHERE A TASK'S ARTIFACTS GO, resolved from the lane AND the directory, in one
# place because two call sites read it — `_export_hw_env` at dispatch and
# `_verify_at_close` at close — and a disagreement between them is a task told
# one location and audited at another.
#
# WHY THE DIRECTORY MATTERS, and it only started mattering on 2026-09-16.
# `.artifacts` exists so a task's output never shows in `git status`; on a lane
# with no tree to pollute it was always the work directory itself. Keying that
# on the LANE was unambiguous while a lane's worktree path and its repo-less
# work-directory path were different strings — `<main>/.worktrees/<task>` versus
# `$WORK/<proj>/<task>`. For `setup` they are the SAME string (see _lane_wt_dir),
# so the lane alone cannot tell a real worktree from one of the plain
# directories every pre-2026-09-16 setup task left at exactly that path.
#
# WHAT THAT COSTS IF IT IS WRONG: `done-invoker` counts only files under
# $HW_ARTIFACTS, and everything else in the directory reads as a product change
# or a contract violation. A reused plain setup directory whose artifacts sit at
# its root would have them counted as neither — invisible to the report, and
# named as unsaved work by the close. Raised by both judges of the Judgment Day
# run on this change, independently, and confirmed against the source.
#
# THE FOUR OLDER LANES ARE UNTOUCHED BY THE EXTRA TEST, deliberately: a product-lane
# `--worktree none` task has had `.artifacts` inside its plain work directory
# since long before this, executors are handed that path, and changing it here
# would move the ground under every in-flight repo-less dispatch for a tidiness
# nobody asked for.
_artifacts_dir_for() {  # $1 = project, $2 = work directory
  local proj="$1" wd="$2"
  if ! _lane_has_repo "$proj"; then printf '%s' "$wd"; return 0; fi
  if lane_worktree_is_workdir "$proj" && [ ! -e "$wd/.git" ]; then printf '%s' "$wd"; return 0; fi
  printf '%s/.artifacts' "$wd"
}

# EVERY LANE WITH A CHECKOUT, one per line, in ALL_KNOWN_PROJECTS order.
#
# `for proj in <the four product lanes>` was written out twice —
# in `hw reap` and in `hw worktrees` — and adding `setup` to neither is exactly
# what happened on the first pass: reap surveyed the lane it had just been given
# worktrees for and printed "0 safe to remove, 0 kept" over two real ones.
# A survey that cannot see its subject reports the same words as a clean survey.
_repo_lanes() {
  local proj
  while IFS= read -r proj; do
    [ -n "$proj" ] || continue
    _lane_has_repo "$proj" && printf '%s\n' "$proj"
  done <<EOF
$ALL_KNOWN_PROJECTS
EOF
}

# ── the agents a brief names IN PROSE ───────────────────────────────────────
#
# `requires-agents:` in the frontmatter is checked above, refuses on mismatch,
# and catches none of the real failures — because it is opt-in and brainers do
# not use it. Measured on this repo: 52 briefs name `ops-investigator`,
# `repo-auditor` or `qa-tester` in their TEXT, and on 2026-08-31 the same
# mistake landed three times, in briefs from two different brainers. Each time
# the brief named `ops-investigator`, the executor was OpenCode, the agent is
# declared `mode: subagent` in `.opencode/agent/`, and `opencode run --agent`
# selects a PRIMARY — so the runtime rejected it and the executor was left with
# no mechanism and no fallback. A brainer wrote it down itself:
# "es la tercera vez hoy que ese mismo agente aparece en un brief mío y no
# existe del otro lado; el error es mío y se repite". Nothing reminded it.
#
# SO THIS WARNS AND NEVER REFUSES, and that restraint is the design.
#
# Prose carries no ROLE. "Use ops-investigator" does not say whether the brief
# means primary or subagent, so hw cannot PROVE the destination vendor fails to
# reach it in the role the brief intends — and the rule for that case is: say it
# loudly, then dispatch. A wrong refusal blocks good work, which already
# happened once today when an over-strict check stopped a valid brief. The
# frontmatter key stays the place where a brainer asks to be refused.
#
# The candidate set is ENUMERATED FROM DEFINITIONS, never guessed from the
# prose: only a name that some agent registry actually defines can match, so an
# ordinary English word in a brief can never trigger this.
_known_agent_names() {
  local task_dir="$WORK/$PROJ/$TASK" project_dir d f
  project_dir="$(_lane_main_checkout "$PROJ")"
  {
    # OpenCode names a markdown agent after its file; Claude after its `name:`.
    for d in \
      "$task_dir/.opencode/agent" "$task_dir/.opencode/agents" \
      "$project_dir/.opencode/agent" "$project_dir/.opencode/agents" \
      "$HOME/.config/opencode/agent" "$HOME/.config/opencode/agents"; do
      [ -n "$d" ] && [ -d "$d" ] || continue
      for f in "$d"/*.md; do
        [ -f "$f" ] || continue
        basename "$f" .md
      done
    done
    for d in "$task_dir/.claude/agents" "$project_dir/.claude/agents" "$HOME/.claude/agents"; do
      [ -n "$d" ] && [ -d "$d" ] || continue
      _claude_agent_index dir "$d" | cut -f1
    done
    # A lane that builds its worktree from its remote base (`agents_from:
    # base`): the branch that will actually exist decides what the executor
    # can invoke.
    if [ "$(lane_get "$PROJ" agents_from)" = base ] && [ -n "$project_dir" ]; then
      _claude_agent_index git "$project_dir" "$(_lane_agents_ref "$PROJ")" .claude/agents | cut -f1 || true
      git -C "$project_dir" ls-tree --name-only "$(_lane_agents_ref "$PROJ")"":.opencode/agent" 2>/dev/null | sed 's/\.md$//' || true
    fi
    jq -r '.agent // {} | keys[]' "$HOME/.config/opencode/opencode.json" 2>/dev/null || true
  } 2>/dev/null | sed '/^$/d' | sort -u
}

_warn_brief_body_agents() {
  [ -n "${BRIEF:-}" ] && [ -r "${BRIEF:-}" ] || return 0
  local body name names hit mode source conf="$HOME/.config/opencode/opencode.json"
  # The frontmatter is checked by _check_required_agents; scanning it again here
  # would report the same agent twice with two different verdicts.
  body="$(python3 - "$BRIEF" <<'PY' 2>/dev/null || true
import sys
lines = open(sys.argv[1], encoding="utf-8", errors="replace").read().splitlines()
if lines and lines[0].strip() == "---":
    for i, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            lines = lines[i + 1:]
            break
print("\n".join(lines))
PY
)"
  [ -n "$body" ] || return 0
  names="$(_known_agent_names)"
  [ -n "$names" ] || return 0
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    printf '%s' "$body" | rg -qF -- "$name" 2>/dev/null || continue
    hit=""
    case "$AGENT" in
      opencode)
        source="$(_opencode_project_agent "$name" 2>/dev/null || true)"
        if [ -n "$source" ]; then
          mode="${source%%$(printf '\t')*}"
          source="${source#*$(printf '\t')}"
        else
          mode="$(jq -r --arg a "$name" '.agent[$a].mode // empty' "$conf" 2>/dev/null || true)"
          [ -n "$mode" ] && source="$conf" || { mode=""; source=""; }
        fi
        [ -n "$mode" ] || continue
        [ "$mode" = subagent ] || continue
        hit="$source declares mode: subagent, so it is reachable ONLY as a subagent — \`opencode run --agent $name\` selects a PRIMARY and the runtime will reject it"
        ;;
      claude)
        # Claude's .claude/agents/*.md are Task-only subagents by construction.
        # Naming one is fine; naming one this workdir cannot reach is the risk.
        _claude_agent_reachable "$name" && continue
        hit="claude cannot reach .claude/agents/$name.md from the intended workdir, so the Task tool will not find it"
        ;;
      *) continue ;;
    esac
    [ -n "$hit" ] || continue
    warn "the brief's TEXT names the agent '$name': $hit"
    warn "hw is NOT refusing this launch — prose carries no role, so it cannot prove the brief uses '$name' the way that fails."
    warn "say the ROLE and the FALLBACK in the brief, or declare 'requires-agents: subagent:$name' to be refused instead of warned."
  done <<EOF
$names
EOF
  return 0
}

_claude_agent_reachable() {  # $1 = name
  _claude_agent_source "$1" "$(_lane_main_checkout "$PROJ")" >/dev/null
}

# A BUILD MODEL MUST NOT BE SENT TO DECIDE WHAT TO BUILD.
#
# The product lane pins openai/gpt-5.6-sol, correctly, for the work it mostly
# does. On 2026-08-25 that pin also carried it into ten tasks that were not
# builds: seven browser diagnoses and audits among them. Nothing asked whether
# the task was the kind the pin was for, because the pin is per-LANE and the
# question is per-TASK.
#
# Two strengths, deliberately:
#   · a brief that DECLARES `kind: explore` (or audit/review) is refused on a
#     build-only model. The brainer said what the task is; hw does not argue
#     with it and does not need a heuristic.
#   · a task whose NAME says diagnosis/audit/explore/research/review, with no
#     declaration, is WARNED. A name is evidence, not a statement, and refusing
#     on it would block `fix-the-audit-script` for having "audit" in it.
_task_kind_from_name() {
  case "$1" in
    *diagnosis*|*diagnose*|*-diag|*-diag-*|*audit*|*explore*|*research*|*review*|*investigation*)
      printf 'explore' ;;
    *) printf '' ;;
  esac
}

# THE AGENT NAME IS GLOBAL, THE TASK NAME IS NOT. hw names the executor's herdr
# agent after the task, and herdr refuses a name any live agent holds, in ANY
# lane. MEASURED 2026-09-22: four tasks of the same name dispatched from four
# lanes; the first started and the other three died at `agent start` with
# `agent_name_taken` — after their worktrees, branches and tabs were built.
#
# REFUSED HERE, BEFORE ANYTHING IS BUILT, and by the dry run too, which runs
# this same line. Qualifying the name with the lane was the other option and
# was not taken: the agent name is read back as the task name by revive and by
# the codex startup check, so a second naming scheme would be a second thing to
# keep in agreement. A refusal costs one rename and changes nothing else.
#
# The reuse route is skipped entirely: it starts no agent. An unreadable registry is UNESTABLISHED, said
# as a warning — herdr itself still refuses at `agent start` if it is taken.
_check_agent_name_free() {
  local name="$1" agents holder
  # THE REUSE ROUTE STARTS NO AGENT: it re-tasks a live pane through hw next, so
  # no name is taken and a coincidence elsewhere must not refuse it.
  [ -z "${_REUSE_PANE:-}" ] || return 0
  agents="$(herdr agent list 2>/dev/null || true)"
  if ! printf '%s' "$agents" | jq -e '.result.agents | type == "array"' >/dev/null 2>&1; then
    warn "UNESTABLISHED  agent name: herdr's agent registry could not be read, so whether '$name' is free in every lane was not checked"
    return 0
  fi
  holder="$(printf '%s' "$agents" | jq -r --arg n "$name" '
    first(.result.agents[]? | select(.name == $n)
      | "\(.pane_id) (cwd \(.cwd // "unknown"))") // empty' 2>/dev/null || true)"
  [ -z "$holder" ] || die "herdr agent name '$name' is already held by $holder, and herdr requires agent names to be unique across EVERY lane — this launch would build its worktree and tab and then die at agent start with agent_name_taken. Rename the task (for example $PROJ-$name), or close that executor first. NOTHING was built."
  return 0
}

_check_task_kind() {  # $1 = kind, $2 = declared|inferred
  local kind="$1" how="$2"
  case "$kind" in
    build|explore|audit|review) ;;
    *) warn "brief declares kind=$kind, which hw does not know. Known: build explore audit review"; return 0 ;;
  esac
  # PUBLISHED FOR THE MANIFEST. The model-suggestion line below names the kind
  # in its reason, and this is the only place that has resolved one. Set for
  # `build` too: the reason reads the same either way, and a suggestion note
  # that silently omitted the kind on builds would be the harder bug to see.
  TASK_KIND="$kind"; TASK_KIND_SRC="$how"
  case "$kind" in build) [ "$how" != declared ] || BRIEF_DECLARED="${BRIEF_DECLARED}${BRIEF_DECLARED:+ }kind"; return 0 ;; esac
  if [ -n "$MODEL" ] && model_is_build_only "$MODEL"; then
    if [ "$how" = declared ]; then
      die "this task is declared kind=$kind and $MODEL is a build model — its own runner labels every turn \"Build\". Exploration decides WHAT to build; handing it to the model meant for building the decision is how ten browser diagnoses ran on it on 2026-08-24/25 while the same lane ran the same class of task on opus. Nothing was built. Relaunch with a model that reasons: --agent claude --model opus, or --model opus if you keep this vendor."
    fi
    warn "task name suggests this is exploration ($kind) but the model is $MODEL, which is a build model (${MODEL_SRC:-lane default})."
    warn "the lane pin is right for building and wrong for deciding what to build. If this really is exploration: --agent claude --model opus."
    warn "if it is not, say so in the brief (kind: build) and this stops asking."
  else
    [ "$how" != declared ] || BRIEF_DECLARED="${BRIEF_DECLARED}${BRIEF_DECLARED:+ }kind"
  fi
  return 0
}

# THE OTHER DIRECTION OF THE SAME QUESTION, AND NOBODY WAS LOOKING AT IT.
#
# `_check_task_kind` above refuses in ONE direction: a build-only model handed
# a task the brief declared as explore/audit/review. The opposite — a model that
# REASONS handed a task with nothing to reason about — had no surface at all,
# and a product-lane brainer once dispatched four executors and got two
# of them wrong in exactly that direction: two mechanical, one-command-and-a-
# checklist tasks against production infrastructure both went out on opus.
# Its own diagnosis, and it is the right one: it chose by IMPORTANCE
# (both touch production) instead of by
# UNCERTAINTY, which is what the rule says.
#
# SO THIS PRINTS, IT DOES NOT REFUSE. A model choice is the brainer's and it is
# reversible for the price of a relaunch; what it was missing is something to
# compare against at the moment it presses enter. The refusal above earns its
# `die` from a DECLARATION ("this is an audit") contradicting a model whose own
# runner labels every turn "Build" — two statements, flatly opposed. Here there
# is only one statement and an absence, and refusing on an absence would make
# `decision:` a tax every brief pays to keep dispatching as it does today.
#
# THE AXIS IS UNCERTAINTY, NOT IMPORTANCE:
#   * sonnet is the suggestion by default. The global rule is "empezar por el
#     modelo mas barato que pueda hacer el trabajo" and "ante la duda entre dos
#     tiers, el menor".
#   * opus is suggested only when the brief DECLARES an open decision. Nothing
#     else promotes it — not `kind: audit`, which is precisely where the
#     brainer went wrong: an audit of one command and three checks is sonnet.
#
# WHAT IT REFUSES TO CLAIM, and this is deliberate: an unnamed model. Claude's
# inherited default is widely believed to be opus, and bin/hw says so in the
# sonnet-orchestrator gate, but that is a property of the ACCOUNT the pane runs
# under — which --account can move — and nothing here measured it. An unrankable
# model (fable, openai/gpt-5.6-sol) is the same case. Both print nothing:
# model_tier returns empty and this makes no claim. UNESTABLISHED, named rather
# than guessed.
MODEL_WHY=""; MODEL_WHY_SRC=""
TASK_KIND=""; TASK_KIND_SRC=""

_model_suggested() {  # the model this task's DECLARATIONS argue for
  # NEVER BELOW THE LANE'S FLOOR. The suggestion printed `sonnet suggested`
  # beside 23 dispatches on opus (measured in that lane's dispatch
  # records, 2026-09-28) — in the one lane where the operator had rejected sonnet
  # three times. A note that argues against a declared floor is the push the
  # floor exists to remove.
  local floor; floor="$(project_model_floor "${PROJ:-}")"
  if [ -n "$MODEL_WHY" ] || [ "$floor" = opus ]; then printf 'opus'; else printf 'sonnet'; fi
}

# The manifest annotation for the model field: empty when there is nothing to
# say, which is the common case and the point.
_model_suggestion_note() {
  local suggested chosen_tier suggested_tier kind_part
  suggested="$(_model_suggested)"
  [ -n "$MODEL" ] || return 0
  chosen_tier="$(model_tier "$MODEL")"
  [ -n "$chosen_tier" ] || return 0
  suggested_tier="$(model_tier "$suggested")"
  if [ "$chosen_tier" -le "$suggested_tier" ]; then
    # Not a deviation. Say WHY it is not, when a declaration is what bought it:
    # otherwise the one dispatch that legitimately reaches for opus looks
    # identical to the two that should not have.
    [ -n "$MODEL_WHY" ] || return 0
    printf ' / %s suggested — open decision (%s): %s' \
      "$suggested" "$MODEL_WHY_SRC" "$(_model_why_short)"
    return 0
  fi
  kind_part=""
  case "$TASK_KIND_SRC" in
    declared) kind_part="kind: $TASK_KIND, " ;;
    inferred) kind_part="kind: $TASK_KIND (inferred from the task name), " ;;
  esac
  printf ' / %s suggested — %sno open decision declared' "$suggested" "$kind_part"
}

# One manifest line, so a paragraph pasted into `decision:` does not push the
# fields that follow it off the reader'"'"'s screen.
_model_why_short() {
  printf '%s' "$MODEL_WHY" | tr '\n' ' ' | cut -c1-72
}

BRIEF_DECLARED=""
# RESOLVED BEFORE THE COMPARISON, AND ON BOTH ROUTES, because only one of them
# had resolved it by the time the contract is checked.
#
# The launch route runs `_validate_sdd_vendor_pair` (which resolves as a side
# effect) immediately before `_check_brief_contract`. The REUSE route skips that
# call entirely and resolves far below, inside the manifest — so `sdd:` in a
# brief on a reused pane was compared against an unset variable. That is the
# route the 2026-09-14 reproduction ran on.
#
# It mirrors the reuse block's own inputs rather than inventing new ones: the
# same surface (the repo for a worktree lane, the run directory's grandparent
# otherwise) and the same inherited launch record. A second way of asking one
# question is how two gates end up disagreeing about what is in force.
#
# CALLED ONLY WHEN A BRIEF ACTUALLY DECLARES `sdd:`, so a key most briefs do not
# declare costs nothing on the dispatches that do not.
_ensure_sdd_effective_for_contract() {
  [ -z "${SDD_EFFECTIVE_MODE+set}" ] || return 0
  local surface inherited=""
  if [ -n "${_REUSE_PANE:-}" ]; then
    if _lane_is_product_repo "$PROJ"; then surface="$(_surface_dir)"
    else surface="$(dirname "$(dirname "$_REUSE_RUNDIR")")"; fi
    inherited="$(_run_dispatch_framework "$_REUSE_RUNDIR")"
  else
    surface="$(_codex_validation_surface)"
  fi
  _resolve_effective_sdd_mode "$SDD" "$surface" "$inherited"
}

_check_brief_contract() {
  local decls key val actual bad=0 required_agent_bad=0
  _load_brief_decls; decls="$BRIEF_DECLS"
  local inferred; inferred="$(_task_kind_from_name "$TASK")"
  if [ -z "$decls" ]; then
    BRIEF_DECLARED="none"
    [ -z "$inferred" ] || _check_task_kind "$inferred" inferred
    # THE NO-FRONTMATTER PATH IS THE COMMON ONE. Every brief written before the
    # contract existed leaves here, and all three measured ops-investigator
    # failures were briefs shaped exactly like this.
    _warn_brief_body_agents
    return 0
  fi
  case "$decls" in *"kind"*) ;; *) [ -z "$inferred" ] || _check_task_kind "$inferred" inferred ;; esac
  while IFS="$(printf '\t')" read -r key val; do
    [ -n "$key" ] || continue
    case "$key" in
      __malformed__) die "the brief's frontmatter is malformed ($val). Fix it or remove the fence entirely — a half-parsed contract is worse than none." ;;
      __unknown__)   warn "brief declares '$val', which hw does not check. Known keys: agent model sdd placement worktree database invoker requires requires-agents kind base decision delivery boundary deployed_check sandbox requested_by asked" ; continue ;;
    esac
    if [ "$key" = requires ]; then _check_capabilities "$val"; continue; fi
    if [ "$key" = requires-agents ]; then
      _check_required_agents "$val" || { bad=1; required_agent_bad=1; }
      continue
    fi
    if [ "$key" = kind ];     then _check_task_kind "$val" declared; continue; fi
    # `sandbox: true` IS A SOURCE, NOT ONLY A CHECK: a brief that must not run
    # unconfined turns the sandbox on rather than trusting the dispatcher to
    # remember --sandbox. `false` never turns a --sandbox off — the stricter
    # side wins.
    if [ "$key" = sandbox ]; then
      case "$val" in
        true|yes) SANDBOX=1; SANDBOX_SRC="${SANDBOX_SRC:-brief frontmatter}" ;;
        false|no) ;;
        *) die "the brief declares sandbox: $val — it takes true or false. NOTHING was built." ;;
      esac
      BRIEF_DECLARED="${BRIEF_DECLARED}${BRIEF_DECLARED:+ }sandbox"
      continue
    fi
    # NOT DISPATCH FIELDS: they say what the operator asked for, and
    # _check_requested reads them after this loop. Comparing them against a
    # resolved value would refuse every brief that cites its request.
    case "$key" in requested_by|asked) continue ;; esac
    # `delivery:` is read by the gentle gate, which refuses a bad value before
    # anything is built; under any other mode it fixes nothing and is ignored.
    if [ "$key" = delivery ]; then
      [ "$SDD" != gentle ] || BRIEF_DECLARED="${BRIEF_DECLARED}${BRIEF_DECLARED:+ }delivery"
      continue
    fi
    # `deployed_check:` likewise: the gentle gate reads and validates it, and
    # _write_run_env records it for done-invoker. Outside gentle, nothing.
    if [ "$key" = deployed_check ]; then
      if [ "$SDD" = gentle ]; then
        BRIEF_DECLARED="${BRIEF_DECLARED}${BRIEF_DECLARED:+ }deployed_check"
      else
        warn "brief declares deployed_check: on a --sdd ${SDD:-<lane default>} dispatch. Only --sdd gentle holds a report to it, so it is NOT recorded here"
      fi
      continue
    fi
    # `decision:` IS NOT A DISPATCH FIELD, so it is not compared against
    # anything — there is no resolved value for "what is undecided". It is the
    # brief STATING what the task has to work out, which is the only input the
    # model suggestion below takes. Falling through to _dispatch_actual would
    # compare it against an empty string and refuse every brief that declared it.
    #
    # A flag WINS over the brief: --model-why is typed at the dispatch that is
    # actually happening, and the brief may be older than it.
    # `boundary:` IS NOT A DISPATCH FIELD either. It names the security
    # boundary the task's DESIGN must be judged against before its code is
    # written (_design_judgment_note); _write_run_env records it and
    # done-invoker holds the report to it. Read back through _brief_boundary,
    # the one reader of that value, so the launch, the re-task and the gate
    # cannot disagree about what the brief said.
    if [ "$key" = boundary ]; then
      if _design_gate_applies; then
        BRIEF_DECLARED="${BRIEF_DECLARED}${BRIEF_DECLARED:+ }boundary"
      else
        warn "brief declares boundary: on a kind: $(_brief_kind_for_close) task. A design judgment gates code, and this task writes none, so it is NOT recorded and done-invoker will not ask for one"
      fi
      continue
    fi
    if [ "$key" = decision ]; then
      if [ -z "$MODEL_WHY" ]; then MODEL_WHY="$val"; MODEL_WHY_SRC=brief; fi
      BRIEF_DECLARED="${BRIEF_DECLARED}${BRIEF_DECLARED:+ }decision"
      continue
    fi
    # A REPOLESS LANE HAS NO BASE. Comparing `base: staging` against an empty
    # string would report "resolves base=" and read as a mismatch whose fix is
    # unclear; saying there is no base at all names the actual error.
    if [ "$key" = base ] && [ -z "$(_lane_base "${PROJ:-}")" ] && [ -z "$BASE_OVERRIDE" ]; then
      warn "brief declares base=$val but $PROJ has no repository, so there is no base branch to build on"
      bad=1; continue
    fi
    [ "$key" != sdd ] || _ensure_sdd_effective_for_contract
    actual="$(_dispatch_actual "$key")"
    if [ "$val" != "$actual" ]; then
      warn "brief declares $key=$val but this dispatch resolves $key=$actual"
      bad=1
    else
      BRIEF_DECLARED="${BRIEF_DECLARED}${BRIEF_DECLARED:+ }$key"
    fi
  done <<EOF
$decls
EOF
  if [ "$bad" = 1 ]; then
    if [ "$required_agent_bad" = 1 ]; then
      die "the brief requires a named agent this $AGENT runtime cannot invoke (see above). NOTHING was built — no worktree, no database, no pane. Choose a vendor that defines that agent, or change the brief if the mechanism requirement is wrong."
    fi
    die "the brief and the flags disagree (see above). NOTHING was built — no worktree, no database, no pane. Either fix the flags, or change the brief if the brief is what is wrong. This check exists because on 2026-08-24 a brief asking for OpenCode in a project tab was dispatched as Claude in a legacy space, and nothing compared the two."
  fi
  _warn_brief_body_agents
  [ -n "$BRIEF_DECLARED" ] || BRIEF_DECLARED="none"
  return 0
}

# ── what the operator asked for, and where a brainer's own initiative stops
#
# MEASURED 2026-09-28 in one lane (setup/briefs/, the friction report of that
# day, points 5 and 6): an audit finding became a fix nobody asked for, launched and
# committed (`687f3f1`), and the same day a brief authorized implementing where
# the operator had asked to INVESTIGATE. "Decide, then act" and the handback refusal
# both push toward launching; nothing said where launching ends.
#
# So a dispatch CITES the request it answers:
#
#     requested_by: <who> 2026-09-28: «investigá por qué falla X»
#     asked: investigate          # or build
#
# `requested_by:` (or --requested-by for a briefless dispatch) is the citation;
# hw cannot judge a quotation and does not try. `asked: investigate` is the part
# it CAN hold: such a task is exploration, so `kind: build` beside it is refused
# and an undeclared kind is checked as a declared explore.
#
# REQUIRED OR WARNED PER LANE, from projects.json. Measured the same day: 0 of
# 1,226 briefs in seven lanes cite a request, so "required" refuses every
# relaunch of an old brief in its lane. It is required only in the lane where
# the incidents happened, and a warning everywhere else.
#
# NOT COVERED: `hw next --brief` re-tasks a live pane without the lane in hand,
# so a re-task is not checked. Named here rather than implied.
REQUESTED_BY=""; REQUESTED_BY_SRC=""; ASKED=""
_check_requested() {
  local mode decls key val kind_declared=""
  mode="$(project_requested_by_mode "$PROJ")"
  _load_brief_decls; decls="$BRIEF_DECLS"
  while IFS="$(printf '\t')" read -r key val; do
    case "$key" in
      requested_by) [ -n "$REQUESTED_BY" ] || { REQUESTED_BY="$val"; REQUESTED_BY_SRC=brief; } ;;
      asked)        ASKED="$val" ;;
      kind)         kind_declared="$val" ;;
    esac
  done <<EOF
$decls
EOF
  case "$ASKED" in
    ""|build) ;;
    investigate)
      [ "$kind_declared" != build ] || die "the brief says ${HW_OPERATOR:-the operator} asked to INVESTIGATE (asked: investigate) and declares kind: build. An investigation that implements is the failure of 2026-09-28 this check exists for (setup/decisions.md). NOTHING was built. Make the brief investigate, or cite the request that authorized building (asked: build)."
      [ -n "$kind_declared" ] || _check_task_kind explore declared ;;
    *) die "the brief declares asked=$ASKED; hw knows investigate and build. NOTHING was built — a gate field hw cannot read is not one it can hold." ;;
  esac
  if [ -z "$REQUESTED_BY" ]; then
    case "$mode" in
      required) die "$PROJ requires every dispatch to cite the request it answers, and this one cites none. NOTHING was built. Add \`requested_by: <who, when, and the request in their words>\` to the brief's frontmatter (or pass --requested-by \"...\"). If nobody asked for this work, it is a proposal: say it to ${HW_OPERATOR:-the operator} and do not launch it. Fiscal, legal and billing work is a proposal until it is asked for, too." ;;
      warn) warn "this dispatch cites no request (requested_by:). Work ${HW_OPERATOR:-the operator} did not ask for is proposed, not launched — see brain/CLAUDE.md, \"Decide, then act\"." ;;
    esac
    return 0
  fi
  case "$REQUESTED_BY" in *$'\n'*) die "--requested-by must be one line so the manifest and the receipt stay parseable" ;; esac
  if [ "$REQUESTED_BY_SRC" = brief ]; then
    [ "$BRIEF_DECLARED" != none ] || BRIEF_DECLARED=""
    BRIEF_DECLARED="${BRIEF_DECLARED}${BRIEF_DECLARED:+ }requested_by"
    [ -z "$ASKED" ] || BRIEF_DECLARED="$BRIEF_DECLARED asked"
  fi
  return 0
}

# The manifest's `requested` field: the citation, or why there is none.
_requested_line() {
  if [ -n "$REQUESTED_BY" ]; then
    printf '%s  (%s%s)' "$(printf '%s' "$REQUESTED_BY" | cut -c1-96)" "$REQUESTED_BY_SRC" "${ASKED:+, asked: $ASKED}"
  else
    case "$(project_requested_by_mode "$PROJ")" in
      required) printf 'none — REQUIRED in %s' "$PROJ" ;;
      warn)     printf 'none — warned (%s does not require it)' "$PROJ" ;;
      *)        printf 'none — not checked in %s' "$PROJ" ;;
    esac
  fi
}

# ── the lane's model floor ─────────────────────────────────────────────────
#
# hw let one lane launch sonnet after the operator rejected it there on 2026-09-22,
# 09-24 and 09-28; the model note only ever informed. A lane may now declare
# `model_floor` in projects.json, and hw holds it:
#
#   * a model the Claude ladder ranks (model_tier: haiku < sonnet < opus, on
#     the LAST path segment, so opencode's `anthropic/claude-sonnet-5` is
#     sonnet) below the floor is REFUSED without --below-floor-why.
#   * a model the ladder cannot rank passes only when the lane's `accepts`
#     names it. The first floor accepts `openai/gpt-5.6-sol` — its lane's pin,
#     its own recorded decision — and codex's bare `gpt-5.6-sol`. What "at
#     least opus" means for a model that is not a Claude is not measurable
#     here, so an unranked model outside `accepts` is WARNED as
#     UNESTABLISHED, not refused:
#     that lane's dispatch records show 27 astra, 14 fable and 7 terra launches,
#     and nothing the operator said rules them out.
#   * no model at all under claude inherits the account's default, which
#     nothing here measured, so the floor model is PINNED instead — on a fresh
#     launch only: a reused pane runs what it already runs, and a manifest
#     naming a model the pane is not running is the defect fafe525 closed.
#
# --below-floor-why and not --why: `--why` is the --keep-pane lease reason, and
# sharing it would record one reason as the answer to two questions.
MODEL_FLOOR_LINE=""; BELOW_FLOOR_WHY=""
_check_model_floor() {
  local floor accepts tier floor_tier m
  floor="$(project_model_floor "$PROJ")"
  [ -n "$floor" ] || return 0
  accepts="$(project_model_floor_accepts "$PROJ")"
  floor_tier="$(model_tier "$floor")"
  if [ -z "$MODEL" ]; then
    if [ "$AGENT" = claude ] && [ -z "${_REUSE_PANE:-}" ]; then
      MODEL="$floor"; MODEL_SRC="floor of $PROJ"
      MODEL_FLOOR_LINE="$floor — met (pinned: no model was named, and claude's inherited default is unmeasured)"
    else
      MODEL_FLOOR_LINE="$floor — UNESTABLISHED: $AGENT's inherited default is not a model hw can rank"
      warn "model floor: $PROJ requires at least $floor, and this $AGENT dispatch names no model, so what it runs was not checked"
    fi
    return 0
  fi
  tier="$(model_tier "$MODEL")"
  if [ -n "$tier" ]; then
    if [ "$tier" -ge "$floor_tier" ]; then MODEL_FLOOR_LINE="$floor — met"; return 0; fi
    if [ -z "$BELOW_FLOOR_WHY" ]; then
      die "$MODEL is below $PROJ's model floor ($floor), declared in projects.json. NOTHING was built. The floor is the lane's own decision (setup/decisions.md). Launch with --model $floor, or, if this dispatch really must run lower, say why with --below-floor-why \"<reason>\" — it is written to the manifest and the receipt."
    fi
    case "$BELOW_FLOOR_WHY" in *$'\n'*) die "--below-floor-why must be one line so the manifest and the receipt stay parseable" ;; esac
    MODEL_FLOOR_LINE="$floor — BELOW, by --below-floor-why: $BELOW_FLOOR_WHY"
    warn "model floor: $MODEL is below $PROJ's floor ($floor); launching on the stated reason: $BELOW_FLOOR_WHY"
    return 0
  fi
  for m in $accepts; do
    [ "$m" != "$MODEL" ] || { MODEL_FLOOR_LINE="$floor — met ($MODEL is accepted by $PROJ's own decisions)"; return 0; }
  done
  MODEL_FLOOR_LINE="$floor — UNESTABLISHED: $MODEL is not on the Claude ladder and $PROJ's floor does not list it"
  warn "model floor: $PROJ requires at least $floor, and whether $MODEL meets it is UNESTABLISHED — it is not a Claude tier and projects.json does not accept it"
  return 0
}

# Validate auditable SHAPE only, never evidence truth or semantic support.
_check_brief_measured_evidence() {
  [ -n "${BRIEF:-}" ] || return 0
  HW_MEASURED_BRIEF="$BRIEF" python3 - <<'PY' || die "brief $BRIEF has an invalid ## MEASURED block. Accepted: Claim: ... then exactly one of Evidence-Command: ... plus an immediate fenced transcript with a \$ command and literal output; Evidence-Report: engram #<numeric-id>; Evidence-Receipt: <project>:<task> key=<named-key>; Evidence-File: <path>:<line-or-range> plus an immediate fenced quote. This lint checks shape, adjacency, and auditable identity only — not authenticity, freshness, semantic support, causality, completeness, or omitted contradictions."
import os, re, sys
path = os.environ["HW_MEASURED_BRIEF"]
lines = open(path, encoding="utf-8").read().splitlines()
def fail(n, msg):
    print(f"hw: {path}:{n}: {msg}", file=sys.stderr); raise SystemExit(1)
i = 0
while i < len(lines):
    if lines[i].strip() != "## MEASURED": i += 1; continue
    section_line = i + 1; i += 1; body = []
    while i < len(lines) and not re.match(r"^##(?:\s|$)", lines[i]):
        body.append((i + 1, lines[i])); i += 1
    while body and not body[0][1].strip(): body.pop(0)
    while body and not body[-1][1].strip(): body.pop()
    if not body: fail(section_line, "empty ## MEASURED section")
    p = 0
    while p < len(body):
        while p < len(body) and not body[p][1].strip(): p += 1
        if p >= len(body): break
        n, claim = body[p]
        if not re.match(r"^Claim:\s+\S", claim): fail(n, "expected Claim: ...; prose, headings, citations, bare commands, and bare paths do not count")
        p += 1
        if p >= len(body) or not body[p][1].strip(): fail(n, "Claim needs an immediately adjacent Evidence-* carrier")
        en, ev = body[p]; p += 1
        if re.fullmatch(r"Evidence-Report:\s+engram\s+#[0-9]+", ev): continue
        if re.fullmatch(r"Evidence-Receipt:\s+[^\s:]+:[^\s:]+\s+key=[A-Za-z0-9_.-]+", ev): continue
        kind = None
        if re.fullmatch(r"Evidence-Command:\s+\S.*", ev): kind = "command"
        elif re.fullmatch(r"Evidence-File:\s+.+:[0-9]+(?:-[0-9]+)?", ev): kind = "file"
        elif ev.startswith("Evidence-"): fail(en, "unknown Evidence-* carrier")
        else: fail(en, "Claim needs an immediately adjacent recognized Evidence-* carrier")
        if p >= len(body) or not re.match(r"^```[^`]*$", body[p][1]): fail(en, f"Evidence-{kind.title()} needs an immediately attached fenced block")
        fn = body[p][0]; p += 1; quoted = []
        while p < len(body) and body[p][1] != "```": quoted.append(body[p]); p += 1
        if p >= len(body): fail(fn, "unterminated evidence fence")
        p += 1
        if kind == "command":
            if not any(re.match(r"^\$\s+\S", t) for _, t in quoted): fail(fn, "transcript needs a `$ command` line")
            if not any(t.strip() and not re.match(r"^\$\s+", t) for _, t in quoted): fail(fn, "transcript needs at least one literal output line")
        elif not any(t.strip() for _, t in quoted): fail(fn, "file quote is empty")
PY
}

# The id a lane pins for a Claude alias, or nothing (a full id, an alias the
# lane does not pin, a lane with no pins). Read from projects.json's
# `model_pins`, which lane_config_load flattens to "alias=id alias=id".
_model_pin_for() {  # $1 = lane, $2 = --model as typed
  local pins pair
  case "$2" in fable|opus|sonnet|haiku) : ;; *) return 0 ;; esac
  pins="$(lane_get "$1" model_pins 2>/dev/null || true)"
  for pair in $pins; do
    [ "${pair%%=*}" = "$2" ] && { printf '%s' "${pair#*=}"; return 0; }
  done
  return 0
}

# ── the brain guard ──────────────────────────────────────────────────────────
# A PRODUCT executor — every lane whose table entry does not say
# `brain_guard: false` — does not write in brain, work from it, or commit a
# path into it. The decision is setup/guards/
# deny_brain_writes.py; hw only decides WHO loads it, and loading it is the
# whole scope: no directory carries it, so a brainer, a setup executor and
# the operator never meet it. Claude takes it as a plugin dir, opencode as an
# OPENCODE_CONFIG layer (measured: merged with the global config, and its
# relative plugin path resolved against the file). Codex is not covered.
_brain_guard_applies() { [ "$(lane_get "${PROJ:-}" brain_guard)" != 0 ]; }
# FROM THE CHECKOUT THIS hw RUNS FROM, not from BRAIN: the guard is part of
# the toolchain that launches, and HW_BRAIN_ROOT may name a tree that is only
# lane data.
_brain_guard_dir() { printf '%s/setup/guards' "$_brain_root"; }
_brain_guard_claude_plugin() { printf '%s/brain-guard' "$(_brain_guard_dir)"; }
_brain_guard_opencode_config() { printf '%s/brain-guard.opencode.json' "$(_brain_guard_dir)"; }
# What `hw done` asks of a product worktree: what the task can carry out —
# HEAD and its branch, --not --remotes, messages included — scanned for a
# brain path by the guard's own scanner. Another task's ref does not count.
# HW_DONE_ALLOW_BRAIN_LEAK=1 is the operator's exit, never an executor's.
_brain_leak_at_close() {  # $1=project $2=worktree [$3=task branch]
  _brain_guard_applies || return 0
  [ -d "$2" ] && git -C "$2" rev-parse --git-dir >/dev/null 2>&1 || return 0
  # A launch without the guard is refused, so a task reaching here without it
  # was launched before it existed; say so rather than strand the close.
  _brain_guard_present || { warn "brain leak check skipped: no brain guard under $(_brain_guard_dir)"; return 0; }
  local out rc=0
  out="$(HW_BRAIN_GUARD_ROOT="$BRAIN" python3 "$(_brain_guard_dir)/deny_brain_writes.py" --scan "$2" "${3:-}" 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] && return 0
  if [ "${HW_DONE_ALLOW_BRAIN_LEAK:-0}" = 1 ]; then
    warn "brain leak check: $out — closing anyway (HW_DONE_ALLOW_BRAIN_LEAK=1)"
    return 0
  fi
  if [ "$rc" -eq 1 ]; then
    die "brain leak: $2 carries a commit no remote has that names brain ($out). Rewrite it, or close with HW_DONE_ALLOW_BRAIN_LEAK=1 hw done $1 …"
  fi
  die "brain leak check could not finish on $2 ($out); nothing was closed. HW_DONE_ALLOW_BRAIN_LEAK=1 closes anyway"
}
_brain_guard_present() {
  local d; d="$(_brain_guard_dir)"
  [ -f "$d/brain-guard/hooks/hooks.json" ] && [ -f "$d/brain-guard.opencode.json" ] \
    && [ -f "$d/deny-brain-writes.js" ] && [ -f "$d/deny_brain_writes.py" ]
}
# Applies AND is on disk: the only state in which hw hands it over.
_brain_guard_on() { _brain_guard_applies && _brain_guard_present; }
# The paths travel as single shell words, so a checkout with whitespace, or a
# guard that is not on disk, refuses the LAUNCH instead of dropping the guard.
# A dry run says so and goes on: it builds nothing.
_brain_guard_check() {
  _brain_guard_applies || return 0
  # The guard refuses every command of a process whose cwd is inside brain, and
  # a product executor's cwd is its worktree: a `work` root under brain is a
  # lane whose executor can run nothing (install.sh lays it out beside brain).
  local _bg_work _bg_brain
  _bg_work="$(cd -P "${WORK:-/nonexistent}" 2>/dev/null && pwd)" || _bg_work="${WORK:-}"
  _bg_brain="$(cd -P "$BRAIN" 2>/dev/null && pwd)" || _bg_brain="$BRAIN"
  case "$_bg_work/" in
    "$_bg_brain/"*)
      if [ "${DISPATCH_DRY:-0}" = 1 ]; then
        warn "work root $WORK is inside the brain $BRAIN: this dry run goes on, and a launch would refuse — the brain guard denies every command a product executor runs in its own worktree there. Set \"work\" in projects.json outside the brain"
      else
        die "work root $WORK is inside the brain $BRAIN: the brain guard denies every command a product executor runs in its own worktree there, so it could execute nothing. Set \"work\" in projects.json to a directory outside the brain (install.sh puts it beside it), or declare the lane \"brain_guard\": false"
      fi ;;
  esac
  case "$_brain_root" in *[[:space:]]*) die "the brain guard cannot be passed as one word: the checkout path has whitespace ($_brain_root)" ;; esac
  _brain_guard_present && return 0
  [ "${DISPATCH_DRY:-0}" = 1 ] \
    || die "the brain guard is not on disk under $(_brain_guard_dir), and a product executor is not launched without it"
  warn "the brain guard is not on disk under $(_brain_guard_dir): this dry run shows no guard, and a launch would refuse"
}

# _brain_guard_args — the Claude half onto AGENT_ARGS, after _build_agent_args.
# `--plugin-dir` is repeatable, so it composes with gentle's.
_brain_guard_args() {
  if [ "$AGENT" = claude ] && _brain_guard_on; then
    AGENT_ARGS="${AGENT_ARGS:+$AGENT_ARGS }--plugin-dir $(_brain_guard_claude_plugin)"
  fi
  return 0
}

# ── the engram label proxy ───────────────────────────────────────────────────
# Every executor's `engram` MCP server is bin/engram-label-proxy around
# `engram mcp`, whatever the vendor: it refuses a `project` other than the
# lane's label and forces `all_projects` on every search (judgment amendment 1,
# setup/briefs/refs/memoria-engram-judgment.md). Each vendor takes it where a
# launch can already replace one named server, MEASURED 2026-09-30:
#   claude    --mcp-config <file> replaces the user-scope `engram` AND a project
#             .mcp.json `engram` (claude -p, mem_current_project -> the proxy's label)
#   opencode  OPENCODE_CONFIG_CONTENT {"mcp":{"engram":…}} replaces the command
#             (opencode debug config)
#   codex     -c mcp_servers.engram.command/args (codex mcp get engram)
# A crash-restored opencode shell does not get it back: the restore never
# copies a config layer (_export_opencode_overlay), and ENGRAM_PROJECT's
# process override is what remains there.
_engram_proxy_bin() { printf '%s/bin/engram-label-proxy' "$_brain_root"; }
_engram_mcp_bin() { command -v engram 2>/dev/null || printf 'engram'; }
# The claude file: one per label, rewritten at every launch (never by a dry run).
_engram_mcp_claude_file() { printf '%s/hw/engram-mcp-%s.json' "${XDG_CACHE_HOME:-$HOME/.cache}" "$1"; }
OPENCODE_ENGRAM_OVERLAY=""; ENGRAM_PROXY_LINE=""
_engram_proxy_args() {
  local label proxy eng f
  OPENCODE_ENGRAM_OVERLAY=""; ENGRAM_PROXY_LINE=""
  label="$(_engram_label "$PROJ")"; proxy="$(_engram_proxy_bin)"; eng="$(_engram_mcp_bin)"
  case "$label" in *[!A-Za-z0-9._-]*|"") die "engram label '$label' cannot travel as one word to the engram proxy" ;; esac
  case "$proxy$eng$(_engram_mcp_claude_file "$label")" in
    *[[:space:]]*) die "the engram proxy cannot be passed as one word: a path has whitespace ($proxy, $eng, $(_engram_mcp_claude_file "$label"))" ;;
  esac
  if [ ! -x "$proxy" ]; then
    # Same shape as the brain guard: a dry run builds nothing, so it says so and goes on.
    [ "${DISPATCH_DRY:-0}" = 1 ] \
      || die "the engram label proxy is not on disk at $proxy, and an executor is not launched with an unguarded engram"
    warn "the engram label proxy is not on disk at $proxy: this dry run shows no proxy, and a launch would refuse"
    return 0
  fi
  case "$AGENT" in
    claude)
      f="$(_engram_mcp_claude_file "$label")"
      if [ "${DISPATCH_DRY:-0}" != 1 ]; then
        mkdir -p "${f%/*}" \
          && jq -n --arg p "$proxy" --arg l "$label" --arg e "$eng" \
               '{mcpServers: {engram: {command: $p, args: ["--label", $l, "--", $e, "mcp", "--tools=agent"]}}}' > "$f.$$" \
          && mv "$f.$$" "$f" \
          || die "could not write the engram proxy's --mcp-config at $f"
      fi
      AGENT_ARGS="${AGENT_ARGS:+$AGENT_ARGS }--mcp-config $f"
      ENGRAM_PROXY_LINE="--mcp-config $f" ;;
    opencode)
      OPENCODE_ENGRAM_OVERLAY="$(jq -nc --arg p "$proxy" --arg l "$label" --arg e "$eng" \
        '{mcp: {engram: {type: "local", command: [$p, "--label", $l, "--", $e, "mcp", "--tools=agent"]}}}')" \
        || die "could not build the engram proxy's OPENCODE_CONFIG_CONTENT overlay (jq failed)"
      ENGRAM_PROXY_LINE="OPENCODE_CONFIG_CONTENT mcp.engram" ;;
    codex)
      AGENT_ARGS="${AGENT_ARGS:+$AGENT_ARGS }-c mcp_servers.engram.command=\"$proxy\" -c mcp_servers.engram.args=[\"--label\",\"$label\",\"--\",\"$eng\",\"mcp\",\"--tools=agent\"]"
      ENGRAM_PROXY_LINE="-c mcp_servers.engram.*" ;;
  esac
  return 0
}
# The one OPENCODE_CONFIG_CONTENT an opencode executor gets: the --effort
# overlay and the engram proxy, deep-merged. Empty when neither applies.
_opencode_config_content() {
  [ -n "${OPENCODE_EFFORT_OVERLAY:-}${OPENCODE_ENGRAM_OVERLAY:-}" ] || return 0
  local a="${OPENCODE_EFFORT_OVERLAY:-}" b="${OPENCODE_ENGRAM_OVERLAY:-}"
  jq -nc --argjson a "${a:-null}" --argjson b "${b:-null}" '($a // {}) * ($b // {})'
}

# ── where an executor's claude.ai artifacts may land ────────────────────────
#
# MEASURED 2026-09-29, two real Claude Code 2.1.284 sessions asked only for
# `Artifact list`: under ~/.claude it listed the Teams gallery, under
# ~/.claude-personal the personal one. The account of a published artifact is
# the login CLAUDE_CONFIG_DIR names, nothing else — so it follows `--account`,
# and a product executor dispatched with `--account default` published into
# Teams. The lane declares `artifacts` (deny, or the one account allowed); on
# any other account the three tools are REMOVED with --disallowedTools, which
# was measured to hold under --dangerously-skip-permissions (ToolSearch could
# not load them either). A deny in a brief is a line someone forgets; this is
# the lane's.
HW_ARTIFACT_TOOLS="Artifact,ArtifactComments,ArtifactData"

# _artifacts_verdict <lane> <account> — prints `allow` or the reason for deny.
_artifacts_verdict() {
  local want; want="$(project_artifacts "$1")"
  if [ "$want" = deny ]; then
    printf 'the lane declares artifacts: deny'
  elif [ "$want" != "$2" ]; then
    printf "the lane publishes only to '%s', and this executor runs under '%s'" "$want" "$2"
  else
    printf 'allow'
  fi
}

ARTIFACTS_LINE=""
_artifacts_args() {
  if [ "$AGENT" != claude ]; then
    ARTIFACTS_LINE="not governed — hw removes the claude.ai Artifact tools from Claude Code only; this executor is $AGENT"
    return 0
  fi
  local v; v="$(_artifacts_verdict "$PROJ" "$ACCOUNT")"
  if [ "$v" = allow ]; then
    ARTIFACTS_LINE="publish to '$ACCOUNT' only (the account this executor runs under is the lane's)"
  else
    AGENT_ARGS="$AGENT_ARGS --disallowedTools $HW_ARTIFACT_TOOLS"
    ARTIFACTS_LINE="DENIED — --disallowedTools $HW_ARTIFACT_TOOLS ($v)"
  fi
}

_build_agent_args() {
  AGENT_ARGS=""
  MODEL_PINNED=""
  OPENCODE_EXECUTOR_CONFIG=""
  OPENCODE_EFFORT_OVERLAY=""
  OPENCODE_PRIMARY_AGENT=""
  case "$AGENT" in
    claude)
      # PERMISSIONS TRAVEL ON THE COMMAND LINE, NOT IN A FILE THE SESSION READ
      # ONCE. `permissions.defaultMode: bypassPermissions` in settings.json is
      # read at STARTUP, is silently ignored without the top-level
      # `allowDangerouslySkipPermissions: true`, and is silently ignored again
      # if the cwd's `hasTrustDialogAccepted` is false in ~/.claude.json — three
      # separate places, all off-screen, none of which reports having declined.
      # Measured: an executor sat `blocked` on a
      # static permission modal, and every long-lived session on the machine was
      # still in manual mode hours after the settings were fixed, because a
      # running session never re-reads them. The flag has no such gates: it is
      # the same decision, stated where the launch can be verified.
      AGENT_ARGS="--dangerously-skip-permissions"
      # Validate known vendor syntax, not a frozen model catalog. The observed
      # rejection of terra does not prove every future unfamiliar alias invalid.
      # Unknown aliases warn and reach the vendor; acceptance here is not proof
      # of availability or account entitlement.
      if [ -n "$MODEL" ]; then
        # AGENT_ARGS is a shell word list. This transport guard applies to
        # full names too; a claude-* prefix must not bypass argv safety.
        case "$MODEL" in
          -*|*' '*|*$'\t'*|*$'\r'*|*$'\n'*|*'*'*|*'?'*|*'['*)
            die "hw cannot safely pass this Claude model as one literal argument (got: $MODEL)" ;;
        esac
        case "$MODEL" in
          fable|opus|sonnet|haiku) : ;;
          claude-*)                : ;;
          */*) die "that is a provider/model id, which is opencode's form, not claude's (got: $MODEL). Use an alias (opus, sonnet, haiku, fable) or a full claude-* name — or launch it with --agent opencode." ;;
          *)
            warn "claude model '$MODEL' is not recognized by hw; availability is unverified, passing it to the vendor unchanged." ;;
        esac
        # AN ALIAS IS NOT A CONTRACT. `sonnet` is resolved by the vendor, per
        # release and per account: on 2026-09-28 three identical launches ran
        # claude-sonnet-5 and claude-sonnet-5-5. A lane that names the id in
        # `model_pins` gets THAT id passed to the CLI, so what runs does not
        # depend on a resolution nobody here controls. A full id is never
        # rewritten, and an alias the lane does not pin is passed as typed.
        MODEL_PINNED="$(_model_pin_for "$PROJ" "$MODEL")"
        AGENT_ARGS="$AGENT_ARGS --model ${MODEL_PINNED:-$MODEL}"
      fi
      if [ -n "$EFFORT" ]; then
        case "$EFFORT" in
          low|medium|high|xhigh|max) AGENT_ARGS="$AGENT_ARGS --effort $EFFORT" ;;
          *) die "--effort must be one of: low medium high xhigh max (got: $EFFORT)" ;;
        esac
      fi
      # --sdd gentle: ODD, its two skills and the guard, for THIS session only.
      # The gate already proved the home complete and its path one word.
      if [ "$SDD" = gentle ]; then
        local gh; gh="$(gentle_home_dir)"
        AGENT_ARGS="$AGENT_ARGS --append-system-prompt-file $gh/home/.claude/CLAUDE.md --plugin-dir $gh/plugin/gentle-odd --settings $gh/guard-settings.json"
      fi
      ;;
    opencode)
      if [ -n "$MODEL" ]; then
        case "$MODEL" in
          */*) AGENT_ARGS="$AGENT_ARGS --model $MODEL" ;;
          *)   die "opencode needs provider/model, not a bare alias (got: $MODEL). Try: opencode models" ;;
        esac
      fi
      # THE EXECUTOR'S OWN CONFIG DIRECTORY, when the lane table names one.
      # install.sh writes it for an opencode lane: a plugin that refuses writes
      # into the lane's checkout, with a policy of its own. opencode loads a
      # directory named by OPENCODE_CONFIG_DIR like a project `.opencode/`, so
      # nothing is written into ~/.config/opencode or the worktree. A lane that
      # declares it and does not have the plugin REFUSES: it would launch an
      # executor unguarded while the table says it is guarded.
      OPENCODE_EXECUTOR_CONFIG="$(lane_get "${PROJ:-}" opencode_config_dir 2>/dev/null || true)"
      if [ -n "$OPENCODE_EXECUTOR_CONFIG" ] && [ ! -f "$OPENCODE_EXECUTOR_CONFIG/plugin/deny-repo-writes.js" ]; then
        die "lane $PROJ names opencode_config_dir $OPENCODE_EXECUTOR_CONFIG, but it has no plugin/deny-repo-writes.js — the executor would run unguarded. Re-run install.sh for this lane, or remove the field from projects.json"
      fi
      OPENCODE_AGENT_PORT="$(_free_channel_port)"
      AGENT_ARGS="$AGENT_ARGS --auto --port $OPENCODE_AGENT_PORT"
      # OPENCODE ALWAYS GETS AN EXPLICIT PRIMARY, unless the override opts out.
      #
      # Outside a framework, a Sol primary is valuable for judgment and
      # decomposition, not for spending its own context on every read and edit.
      # `sol-orchestrator` owns that role and delegates to pinned Luna/Terra
      # workers. Lower-tier primaries stay `direct-worker`, whose name and prompt
      # deliberately preserve inline execution.
      #
      # Framework modes are NOT changed here: their phases have their own
      # foreground-only lifecycle. HW_OPENCODE_AGENT still overrides every default; explicitly
      # empty still means pass no --agent.
      local default_oc_agent oc_agent oc_role
      if [ "$SDD" = none ] && [[ "$MODEL" = */gpt-5.6-sol || "$MODEL" = */gpt-5.6-sol-* ]]; then
        default_oc_agent="sol-orchestrator"
        oc_role="Sol orchestration primary; delegates economical work"
      elif [ "$SDD" = none ] && [[ "$MODEL" = */gpt-6-astra || "$MODEL" = */gpt-6-astra-* ]]; then
        default_oc_agent="astra-orchestrator"
        oc_role="Astra orchestration primary; delegates economical work"
      else
        default_oc_agent="direct-worker"
        oc_role="direct worker; no orchestration"
      fi
      if [ "${HW_OPENCODE_AGENT+x}" = x ]; then
        oc_agent="$HW_OPENCODE_AGENT"
        oc_role="explicit HW_OPENCODE_AGENT override"
      else
        oc_agent="$default_oc_agent"
      fi
      if [ -n "$oc_agent" ]; then
        # Confirm it exists before passing it. `--agent <unknown>` is the kind
        # of failure that shows up as an agent that came up "normally" and
        # behaves like a different session — the exact thing this flag exists
        # to prevent. If the config cannot be read, say so and continue without
        # --agent rather than making hw unlaunchable because config moved.
        local oc_conf="$HOME/.config/opencode/opencode.json"
        if jq -e --arg a "$oc_agent" '.agent[$a]' "$oc_conf" >/dev/null 2>&1; then
          AGENT_ARGS="$AGENT_ARGS --agent $oc_agent"
          OPENCODE_PRIMARY_AGENT="$oc_agent"
          info "opencode → --agent $oc_agent ($oc_role)"
        else
          warn "opencode wanted --agent $oc_agent ($oc_role), but it is not defined in $oc_conf"
          warn "continuing without --agent — opencode will use its configured default_agent"
        fi
      else
        info "opencode → no --agent (HW_OPENCODE_AGENT is explicitly empty)"
      fi
      # THE INTERACTIVE COMMAND HAS NO --effort FLAG (--variant exists on
      # `opencode run` only), so this cannot be a CLI arg. It travels instead as
      # a per-dispatch OPENCODE_CONFIG_CONTENT overlay: verified that
      # Config.loadInstanceState merges that env var's JSON
      # LAST, with local precedence, through the same merge function every other
      # config layer uses — so it reaches the live agent for this session only,
      # and never touches the shared ~/.config/opencode/opencode.json.
      #
      # The overlay is keyed by AGENT NAME (top-level `reasoningEffort`, passed
      # raw to the provider — the same shape astra-orchestrator already carries
      # in opencode.json). With no named primary there is nothing to key it to:
      # refuse rather than accept --effort and silently drop it. An effort that
      # is accepted and not applied is the one outcome worse than refusing it.
      #
      # Keyed on OPENCODE_PRIMARY_AGENT, NOT $oc_agent. They differ exactly
      # when the jq existence check above failed: $oc_agent still holds the
      # NAME THAT WAS WANTED, but --agent was never passed and opencode falls
      # back to its own default_agent. Keying on oc_agent there would build an
      # overlay for an agent that is not the one running — accepted, silently
      # inert, the exact failure this whole mechanism exists to refuse instead.
      OPENCODE_EFFORT_OVERLAY=""
      if [ -n "$EFFORT" ]; then
        case "$EFFORT" in
          low|medium|high|xhigh|max) : ;;
          *) die "--effort must be one of: low medium high xhigh max (got: $EFFORT)" ;;
        esac
        [ -n "$OPENCODE_PRIMARY_AGENT" ] || die "--effort needs a named, resolved primary to attach it to, but none is being passed to opencode (either HW_OPENCODE_AGENT is explicitly empty, or '$oc_agent' is not defined in $HOME/.config/opencode/opencode.json — see the warning above). Fix the agent name, unset the override, or drop --effort."
        # The name rides unquoted through `$(_hw_env …)` and is rebuilt into JSON
        # by the crash restore, so it must survive both intact.
        case "$OPENCODE_PRIMARY_AGENT" in
          *[!A-Za-z0-9._-]*) die "--effort cannot carry agent name '$OPENCODE_PRIMARY_AGENT': the overlay needs a name of [A-Za-z0-9._-] only, to survive the --here flag list and the crash restore. Rename the agent or drop --effort." ;;
        esac
        OPENCODE_EFFORT_OVERLAY="$(jq -nc --arg a "$OPENCODE_PRIMARY_AGENT" --arg e "$EFFORT" '{agent: {($a): {reasoningEffort: $e}}}')" \
          || die "could not build the OPENCODE_CONFIG_CONTENT overlay for --effort $EFFORT (jq failed)"
      fi
      ;;
    codex)
      if [ -n "$MODEL" ]; then
        case "$MODEL" in
          */*) die "codex needs a bare model id, not opencode's provider/model form (got: $MODEL). Use --model ${MODEL##*/} with --agent codex." ;;
        esac
        AGENT_ARGS="$AGENT_ARGS --model $MODEL"
      fi
      if [ -n "$EFFORT" ]; then
        case "$EFFORT" in
          low|medium|high|xhigh|max|ultra)
            AGENT_ARGS="$AGENT_ARGS -c model_reasoning_effort=$EFFORT"
            ;;
          *) die "codex --effort must be one of: low medium high xhigh max ultra (got: $EFFORT)" ;;
        esac
      fi
      ;;
  esac
  AGENT_ARGS="${AGENT_ARGS# }"
  [ -n "$AGENT_ARGS" ] && info "agent args: $AGENT_ARGS"
  return 0
}

# ── SDD mode, per task ───────────────────────────────────────────────────────
# One framework is left, so there is no contradiction to arbitrate and nothing
# to park: Spec Kit is installed where it is used, `--sdd speckit` enters its
# flow, `--sdd none` does not. hw writes nothing to any surface; what it does is
# CHECK that the flow it is about to point an executor at is on disk.
#
# Spec Kit ships its entry as SKILLS (`speckit-*`), no commands. Present means a
# `speckit-*` directory under `<dir>/.claude/skills`, or under
# `~/.claude/skills` for a machine-wide install.

# _speckit_skills_in <dir> — prints the skills dir holding speckit-*, or fails.
_speckit_skills_in() {
  local d="$1/.claude/skills" s
  [ -d "$d" ] || return 1
  for s in "$d"/speckit-*; do
    [ -e "$s" ] || continue
    printf '%s' "$d"; return 0
  done
  return 1
}

# _speckit_on_disk <dir> — the project's install, else the machine's. Prints
# where it was found; fails when neither has one.
_speckit_on_disk() {
  _speckit_skills_in "$1" || _speckit_skills_in "$HOME"
}

# THE DIRECTORY THE MODE WAS CHECKED FOR, recorded rather than re-derived: `$WT`
# on the lane paths, `$cwd` on `--here`, where WT is never set.
SDD_APPLIED_DIR=""
_apply_sdd() {
  local dir="$1" mode="$2"
  SDD_APPLIED_DIR="$dir"
  # `none` touches nothing: it cannot remove skills already on disk, it only
  # stops hw forcing an entry command. Said plainly in the prompt, see
  # _send_brief, so the executor does not have to infer it.
  # `gentle` writes one untracked file: ODD's feature documents land in odd/
  # at the worktree root, and odd/.gitignore keeps them out of every commit
  # of this worktree alone (see _exclude_odd).
  if [ "$mode" = gentle ]; then _exclude_odd "$dir"; return 0; fi
  [ "$mode" = speckit ] || return 0
  local where
  if where="$(_speckit_on_disk "$dir")"; then
    ok "SDD mode: speckit (skills in $where)"
    return 0
  fi
  warn "--sdd speckit, but no speckit-* skill is on disk under $dir/.claude/skills or $HOME/.claude/skills"
  return 1
}

# ── --sdd gentle: gentle-ai's ODD, for one lane, on Claude, from its own HOME
#
# A NEW MODE, NOT THE ONE RETIRED EARLIER. That one installed gentle-ai
# into the machine's agent configs, entered SDD, gated on RDD consent and hid
# odd/ for every lane. This one is the operator's decision, recorded in
# setup/decisions.md:
#
#   · gentle-ai lives in ONE directory of its own, GENTLE_HOME, outside every
#     repository and every agent config. `hw gentle-home` provisions it: the
#     pinned release, its checksum, `install --preset custom` for Claude Code
#     only, run with HOME pointed at GENTLE_HOME/home. Nothing else on the
#     machine has gentle-ai on its PATH.
#   · The executor gets ODD as a flag, not as a file it finds: Claude's
#     `--append-system-prompt-file GENTLE_HOME/home/.claude/CLAUDE.md`, the two
#     skills ODD resolves by name through `--plugin-dir`, and a guard hook
#     through `--settings`. A session hw did not start with those flags loads
#     nothing of gentle-ai — that is the whole isolation, and it is why only
#     Claude can run it: opencode has no per-launch system-prompt file here.
#   · No RDD and no gentle-ai hooks. `--preset custom` installs no hook, the
#     home's review mode is switched off, and the prompt says RDD is off.
#     Review stays Judgment Day.
#   · Only the lanes whose `sdd_modes` lists it (projects.json).
#
# REVERSIBLE: `rm -rf "$(hw gentle-home --path)"` leaves the machine as it was;
# the mode then refuses to launch, naming the provisioning command.
GENTLE_VERSION="3.7.0"
GENTLE_REPO="Gentleman-Programming/gentle-ai"

# The checksums published with the release (checksums.txt), pinned here so a
# download that does not match them never runs.
_gentle_pinned_sha256() {
  case "$1" in
    darwin_arm64) printf '66eb5740c4506cb2cfd1cc5207439c61cfe07678854f4ac7c83027a95a0e666a' ;;
    darwin_amd64) printf 'e55ff3ee06258a90e9195c0e3a593b85f6d79cc439e9e6c04b2596725120a610' ;;
    linux_arm64)  printf 'a3a3d3a974f3d9b67d935fe9e306ae83c305da4ec1baed4a5319c10b044cd0eb' ;;
    linux_amd64)  printf 'a730a61a43758f04cc9a4ac644945cc0e8652a1e33d6997a0a3d3f0044d2fff5' ;;
    *) return 1 ;;
  esac
}

_gentle_platform() {
  local os arch
  os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  arch="$(uname -m)"
  case "$arch" in x86_64|amd64) arch=amd64 ;; arm64|aarch64) arch=arm64 ;; esac
  printf '%s_%s' "$os" "$arch"
}

# XDG data, not config: nothing an agent reads by default lives under it.
gentle_home_dir() {
  printf '%s' "${HW_GENTLE_HOME:-$HOME/.local/share/hw/gentle-home}"
}

# THE DESTINATION IS CHECKED, because the one thing this mode must never do is
# write where another session reads. Prints why, and fails, for a directory that
# is not absolute, has whitespace (AGENT_ARGS is a word list), is HOME itself,
# sits inside an agent config, or sits inside a git work tree.
_gentle_home_refusal() {
  local d="$1" p cfg
  case "$d" in /*) ;; *) printf 'not an absolute path: %s' "$d"; return 0 ;; esac
  case "$d" in *[[:space:]]*) printf 'the path has whitespace, and hw passes it as one word: %s' "$d"; return 0 ;; esac
  d="${d%/}"
  [ "$d" != "${HOME%/}" ] || { printf 'it is HOME itself'; return 0; }
  for cfg in .claude .claude-personal .claude.json .config/opencode .codex .gentle-ai; do
    case "$d/" in "${HOME%/}/$cfg/"*) printf 'it is inside ~/%s, which another session reads' "$cfg"; return 0 ;; esac
  done
  p="$d"
  while [ ! -d "$p" ] && [ "$p" != / ]; do p="$(dirname "$p")"; done
  # An IGNORED directory inside a work tree is fine — git never offers it for a
  # commit; that is what $HW_ARTIFACTS is, and where a test home lives.
  if git -C "$p" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
     && ! git -C "$p" check-ignore -q "$d" 2>/dev/null; then
    printf 'it is inside a git work tree (%s) and not ignored there' "$(git -C "$p" rev-parse --show-toplevel 2>/dev/null)"
    return 0
  fi
  return 1
}

# _gentle_home_ready <dir> — succeeds when <dir> is a complete home of the
# pinned version; otherwise prints what is missing and fails. Read by the
# launch gate, so it reads files only: it never runs gentle-ai.
_gentle_home_ready() {
  local d="$1" why m f
  if why="$(_gentle_home_refusal "$d")"; then printf '%s' "$why"; return 1; fi
  m="$d/manifest.json"
  [ -f "$m" ] || { printf 'no %s' "$m"; return 1; }
  local v n
  v="$(jq -r '.version // empty' "$m")" || { printf '%s is not readable JSON' "$m"; return 1; }
  [ "$v" = "$GENTLE_VERSION" ] || { printf '%s is not version %s' "$m" "$GENTLE_VERSION"; return 1; }
  f="$d/home/.claude/CLAUDE.md"
  [ -s "$f" ] || { printf 'no ODD block at %s' "$f"; return 1; }
  grep -q '<!-- gentle-ai:agent-routing -->' "$f" \
    || { printf '%s carries no gentle-ai agent-routing block' "$f"; return 1; }
  [ "$(shasum -a 256 "$f" | cut -d' ' -f1)" = "$(jq -r '.odd_block_sha256 // empty' "$m")" ] \
    || { printf '%s changed after provisioning' "$f"; return 1; }
  [ -f "$d/plugin/gentle-odd/.claude-plugin/plugin.json" ] \
    || { printf 'no plugin at %s/plugin/gentle-odd' "$d"; return 1; }
  [ -f "$d/guard-settings.json" ] || { printf 'no %s/guard-settings.json' "$d"; return 1; }
  # THE GUARD IS NAMED BY ABSOLUTE PATH, the brain checkout that provisioned
  # the home. If that checkout is gone, `python3 <missing>` exits 2 and Claude
  # reads a PreToolUse exit 2 as "block": every Bash call of the executor would
  # be refused, by a home this check had called complete.
  local guard
  guard="$(jq -r '.hooks.PreToolUse[0].hooks[0].command // empty' "$d/guard-settings.json")" \
    || { printf '%s/guard-settings.json is not readable JSON' "$d"; return 1; }
  guard="${guard##* }"
  [ -n "$guard" ] && [ -f "$guard" ] \
    || { printf 'the guard %s/guard-settings.json names does not exist: %s (re-provision from the brain checkout: rm -rf %s && hw gentle-home)' "$d" "${guard:-<none>}" "$d"; return 1; }
  if [ -f "$d/home/.claude/settings.json" ]; then
    n="$(jq -r '.hooks // {} | length' "$d/home/.claude/settings.json")" \
      || { printf '%s/home/.claude/settings.json is not readable JSON' "$d"; return 1; }
    [ "$n" = 0 ] || { printf '%s/home/.claude/settings.json carries hooks, and this mode runs none of gentle-ai'"'"'s' "$d"; return 1; }
  fi
  return 0
}

# The wrapper is the ONLY gentle-ai anything runs, hw included: it fixes HOME
# to the home's own, strips the caller's environment, and turns telemetry off.
# Whatever it is asked, it cannot reach the real ~/.claude.
_gentle_write_wrapper() {
  local d="$1"
  mkdir -p "$d/bin" "$d/tmp" || return 1
  cat > "$d/bin/gentle-ai" <<WRAP || return 1
#!/bin/sh
# Written by \`hw gentle-home\`. gentle-ai only ever runs against its own HOME.
exec env -i HOME='$d/home' PATH='/usr/bin:/bin:/usr/sbin:/sbin' TMPDIR='$d/tmp' TERM=dumb \\
  DO_NOT_TRACK=1 GENTLE_AI_TELEMETRY=0 GENTLE_AI_INSTALL_SCOPE=global \\
  '$d/libexec/gentle-ai' "\$@"
WRAP
  chmod 755 "$d/bin/gentle-ai" || return 1
  # An empty wrapper exits 0 and installs nothing, so "it ran" proves nothing.
  grep -q "libexec/gentle-ai" "$d/bin/gentle-ai"
}

cmd_gentle_home() {
  local d mode=provision
  d="$(gentle_home_dir)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir)   _need_val "$@"; d="$2"; shift 2 ;;
      --check) mode=check; shift ;;
      --path)  mode=path; shift ;;
      -h|--help)
        cat <<'HELP'
hw gentle-home [--dir <dir>] [--check | --path]

Provisions gentle-ai's own HOME for `--sdd gentle`: the pinned release,
checksum-verified, installed with --preset custom for Claude Code only, with
HOME pointed inside <dir>. Idempotent. Default <dir>:
$HW_GENTLE_HOME, else ~/.local/share/hw/gentle-home.

  --check   say whether <dir> is a complete home; exit 1 if not
  --path    print <dir>

Undo: rm -rf <dir>. Nothing outside it is written.
HELP
        return 0 ;;
      *) die "hw gentle-home: unknown option: $1" ;;
    esac
  done
  local why
  if why="$(_gentle_home_refusal "$d")"; then die "hw gentle-home REFUSED: $d — $why"; fi
  case "$mode" in
    path)  printf '%s\n' "$d"; return 0 ;;
    check)
      if why="$(_gentle_home_ready "$d")"; then ok "gentle-ai $GENTLE_VERSION home is complete: $d"; return 0; fi
      warn "gentle-ai home is not ready: $why"; return 1 ;;
  esac
  if _gentle_home_ready "$d" >/dev/null; then
    ok "gentle-ai $GENTLE_VERSION home already provisioned: $d (nothing changed)"
    info "undo: rm -rf $d"
    return 0
  fi

  local plat name want tarball got
  plat="$(_gentle_platform)"
  want="${HW_GENTLE_SHA256:-$(_gentle_pinned_sha256 "$plat" || true)}"
  [ -n "$want" ] || die "hw gentle-home: gentle-ai $GENTLE_VERSION has no pinned checksum for $plat"
  name="gentle-ai_${GENTLE_VERSION}_${plat}.tar.gz"
  mkdir -p "$d/cache" "$d/libexec" "$d/home" || die "hw gentle-home: cannot create $d"
  tarball="${HW_GENTLE_TARBALL:-$d/cache/$name}"
  if [ -z "${HW_GENTLE_TARBALL:-}" ] && [ ! -f "$tarball" ]; then
    step "gentle-home  download $name"
    curl -fsSL -o "$tarball.part" "https://github.com/$GENTLE_REPO/releases/download/v$GENTLE_VERSION/$name" \
      || { rm -f "$tarball.part"; die "hw gentle-home: download failed: $name"; }
    mv "$tarball.part" "$tarball"
  fi
  got="$(shasum -a 256 "$tarball" | cut -d' ' -f1)"
  if [ "$got" != "$want" ]; then
    [ -n "${HW_GENTLE_TARBALL:-}" ] || rm -f "$tarball"
    die "hw gentle-home REFUSED: $name has sha256 $got, and the pinned checksum is $want. Nothing was installed."
  fi
  ok "checksum verified: $name ($got)"
  tar -xzf "$tarball" -C "$d/libexec" gentle-ai || die "hw gentle-home: $name holds no gentle-ai binary"
  chmod 755 "$d/libexec/gentle-ai"
  _gentle_write_wrapper "$d" || die "hw gentle-home: could not write the wrapper $d/bin/gentle-ai"

  step "gentle-home  install into $d/home (Claude Code only, --preset custom)"
  ( cd "$d/home" && "$d/bin/gentle-ai" install --agent claude-code --preset custom ) >"$d/install.log" 2>&1 \
    || die "hw gentle-home: gentle-ai install failed — see $d/install.log"
  grep -q '<!-- gentle-ai:agent-routing -->' "$d/home/.claude/CLAUDE.md" 2>/dev/null \
    || die "hw gentle-home: gentle-ai install exited 0 but wrote no ODD block at $d/home/.claude/CLAUDE.md — see $d/install.log"
  # The two skills ODD resolves by name. `--components skills` does not touch
  # the block the preset wrote; the check below proves it.
  local block_sha
  block_sha="$(shasum -a 256 "$d/home/.claude/CLAUDE.md" 2>/dev/null | cut -d' ' -f1)"
  ( cd "$d/home" && "$d/bin/gentle-ai" install --agent claude-code --components skills ) >>"$d/install.log" 2>&1 \
    || die "hw gentle-home: gentle-ai skills install failed — see $d/install.log"
  [ "$(shasum -a 256 "$d/home/.claude/CLAUDE.md" | cut -d' ' -f1)" = "$block_sha" ] \
    || die "hw gentle-home: installing the skills rewrote the ODD block; refusing a home whose block is not the preset's"
  ( cd "$d/home" && "$d/bin/gentle-ai" review mode disable --scope global --cwd "$d/home" \
      && "$d/bin/gentle-ai" telemetry disable ) >>"$d/install.log" 2>&1 \
    || warn "gentle-ai could not record RDD or telemetry as off in its own home (see $d/install.log); the prompt still says RDD is off, and gentle-ai is not on the executor's PATH"

  local s
  rm -rf "$d/plugin"
  mkdir -p "$d/plugin/gentle-odd/.claude-plugin" "$d/plugin/gentle-odd/skills"
  for s in work-unit-commits chained-pr; do
    [ -f "$d/home/.claude/skills/$s/SKILL.md" ] || die "hw gentle-home: gentle-ai installed no $s skill"
    cp -R "$d/home/.claude/skills/$s" "$d/plugin/gentle-odd/skills/$s"
  done
  printf '{"name":"gentle-odd","version":"%s","description":"The two skills gentle-ai ODD resolves by name, for hw --sdd gentle"}\n' \
    "$GENTLE_VERSION" > "$d/plugin/gentle-odd/.claude-plugin/plugin.json"
  jq -n --arg guard "$BRAIN/setup/guards/deny-gentle-real-home.py" --arg home "$d" \
    '{hooks: {PreToolUse: [{matcher: "Bash", hooks: [{type: "command", command: ("HW_GENTLE_HOME=" + $home + " python3 " + $guard)}]}]}}' \
    > "$d/guard-settings.json"
  jq -n --arg v "$GENTLE_VERSION" --arg t "$got" --arg p "$plat" \
    --arg b "$(shasum -a 256 "$d/home/.claude/CLAUDE.md" | cut -d' ' -f1)" \
    --arg pinned "$([ -n "${HW_GENTLE_SHA256:-}" ] && echo override || echo pinned)" \
    '{version: $v, platform: $p, tarball_sha256: $t, checksum: $pinned, odd_block_sha256: $b}' > "$d/manifest.json"
  if why="$(_gentle_home_ready "$d")"; then
    ok "gentle-ai $GENTLE_VERSION home provisioned: $d ($(wc -c < "$d/home/.claude/CLAUDE.md" | tr -d ' ') bytes of ODD block)"
    info "undo: rm -rf $d"
    return 0
  fi
  die "hw gentle-home: provisioned, but the home is not complete: $why"
}

# _exclude_odd <worktree> — odd/ ignored in THIS worktree and nowhere else.
#
# NOT the exclude file: for a linked worktree `--git-path info/exclude` is the
# COMMON one, so a line there hides odd/ in every worktree of the repo and in
# its main checkout, for good. A per-worktree `$GIT_DIR/info/exclude` is not
# read (measured, git 2.50.1), and a per-worktree core.excludesFile needs
# `extensions.worktreeConfig`, which is shared config. What is left, and what
# this writes: an UNTRACKED odd/.gitignore holding `*`, which ignores the
# directory's contents and itself — one worktree, no config, nothing versioned.
_exclude_odd() {
  local wt="$1"
  git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  mkdir -p "$wt/odd" || { warn "cannot create $wt/odd; ODD's feature documents may show in git status"; return 0; }
  [ -e "$wt/odd/.gitignore" ] || printf '*\n' > "$wt/odd/.gitignore" \
    || { warn "cannot write $wt/odd/.gitignore; ODD's feature documents may show in git status"; return 0; }
  info "odd/ ignored in this worktree only (untracked odd/.gitignore), so ODD's feature documents never reach a commit"
  return 0
}

GENTLE_DELIVERY=""
GENTLE_DEPLOYED_CHECK=""

# ── the deployed check: an ODD run that did not verify what is deployed ─────
#
# MEASURED 2026-09-28/29, the 8 runs of the salón release: the empirical
# check against staging never ran (no staging QA account,
# session_reauth_failed, tenant_seed_missing), ODD recorded it as pending, as
# its close step allows, and every run reported done (fase 4's feature
# document; setup/decisions.md, 2026-09-29). So under gentle a done is held to it:
#
#   deployed_check: required               the DEFAULT, also when absent
#   deployed_check: out-of-scope <reason>  the brief takes it out, and the
#                                          report says so in its first line
#
# `required` is closed by $HW_ARTIFACTS/deployed-check.md (target, evidence,
# RESULT: PASSED), HELD on an ask-invoker naming what is missing, or reported
# --blocked. done-invoker enforces it; this is the one reader.
_brief_deployed_check() {  # $1 = brief path (default: $BRIEF)
  local f="${1:-${BRIEF:-}}"
  [ -f "$f" ] || return 0
  awk 'NR==1 { if ($0 != "---") exit; next }
       $0 == "---" { exit }
       /^[[:space:]]*deployed_check[[:space:]]*:/ { sub(/^[^:]*:[[:space:]]*/, ""); sub(/[[:space:]]+$/, "");
         if ($0 ~ /^".*"$/ || $0 ~ /^'"'"'.*'"'"'$/) $0 = substr($0, 2, length($0) - 2);
         print; exit }' "$f" 2>/dev/null || true
}

# Prints `required` or `out-of-scope: <reason>`; returns 1, printing the raw
# value, when it is neither.
_gentle_deployed_check() {
  local v reason
  v="$(_brief_deployed_check)"
  case "$v" in
    ""|required) printf 'required'; return 0 ;;
    out-of-scope*)
      reason="$(printf '%s' "${v#out-of-scope}" | sed -E 's/^[[:space:]]*(:|—|–|-)?[[:space:]]*//')"
      [ -n "$reason" ] || { printf '%s' "$v"; return 1; }
      printf 'out-of-scope: %s' "$reason"; return 0 ;;
    *) printf '%s' "$v"; return 1 ;;
  esac
}

# THE LAUNCH GATE, run right after the mode is parsed and before reuse
# discovery, the worktree, the database or a port. A lane that does not list
# the mode answers exactly what it answered before the mode existed.
_validate_sdd_gentle() {
  case " $(project_sdd_modes "$PROJ") " in
    *" gentle "*) ;;
    *) die "--sdd must be speckit or none (got: gentle)" ;;
  esac
  [ "$AGENT" = claude ] \
    || die "gentle-ai ODD dispatch REFUSED BEFORE BUILDING ANYTHING: --sdd gentle runs only on Claude Code, because ODD enters the executor's system prompt through Claude's --append-system-prompt-file and $AGENT has no per-launch equivalent here. Nothing was built. Add --agent claude."
  [ "$HERE" != 1 ] \
    || die "gentle-ai ODD dispatch REFUSED BEFORE BUILDING ANYTHING: --here runs in your own directory, and ODD writes odd/ where it runs. Nothing was built. Give it its own worktree (drop --here)."
  [ "$KEEP_PANE" != 1 ] \
    || die "gentle-ai ODD dispatch REFUSED BEFORE BUILDING ANYTHING: --keep-pane makes the pane re-taskable, and hw next cannot carry this mode's instructions into a live session. Nothing was built. Drop --keep-pane; the next gentle task is a fresh launch."
  [ -n "$BRIEF" ] \
    || die "gentle-ai ODD dispatch REFUSED BEFORE BUILDING ANYTHING: it needs a brief, and the brief must fix the delivery strategy ODD would otherwise stop to ask for. Nothing was built."
  _load_brief_decls
  GENTLE_DELIVERY="$(printf '%s\n' "$BRIEF_DECLS" | awk -F'\t' '$1 == "delivery" { print $2; exit }')"
  case "$GENTLE_DELIVERY" in
    single-pr|stacked-to-main|feature-branch-chain) ;;
    "") die "gentle-ai ODD dispatch REFUSED BEFORE BUILDING ANYTHING: the brief does not declare \`delivery:\` in its frontmatter. ODD asks for the delivery strategy before it slices work, and nobody answers in an executor's pane. Declare one: delivery: single-pr | stacked-to-main | feature-branch-chain. Nothing was built." ;;
    *) die "gentle-ai ODD dispatch REFUSED BEFORE BUILDING ANYTHING: delivery: $GENTLE_DELIVERY is not one of single-pr, stacked-to-main, feature-branch-chain. Nothing was built." ;;
  esac
  GENTLE_DEPLOYED_CHECK="$(_gentle_deployed_check)" \
    || die "gentle-ai ODD dispatch REFUSED BEFORE BUILDING ANYTHING: deployed_check: $GENTLE_DEPLOYED_CHECK is not a value hw can hold a report to. Declare nothing (the default is required), 'deployed_check: required', or 'deployed_check: out-of-scope — <why this task does not verify what is deployed>'. Nothing was built."
  local d why
  d="$(gentle_home_dir)"
  why="$(_gentle_home_ready "$d")" \
    || die "gentle-ai ODD dispatch REFUSED BEFORE BUILDING ANYTHING: gentle-ai's own home is not ready ($why). Nothing was built. Provision it with: hw gentle-home"
  return 0
}

# What the prompt says in this mode, ahead of the brief. Every line answers a
# measured failure: without the ask-invoker line an executor ended its turn
# asking in the pane and wrote nothing.
_gentle_preamble() {
  local delivery_text
  case "$GENTLE_DELIVERY" in
    single-pr)            delivery_text="single-pr — one pull request; do not slice it into a chain" ;;
    stacked-to-main)      delivery_text="a chain of pull requests, stacked-to-main" ;;
    feature-branch-chain) delivery_text="a chain of pull requests, feature-branch-chain" ;;
  esac
  cat <<EOF
THIS TASK RUNS IN GENTLE-AI ODD MODE (--sdd gentle) — chosen by your brainer.
The Organic Driven Development (ODD) protocol is in your system prompt: follow
it, in its order, for this task. What this mode fixes for you:

- Receipt-driven development (RDD) is OFF for this task. gentle-ai is NOT
  installed for you and must not be run: no \`gentle-ai review ...\`, no
  \`gentle-ai install\`, no \`gentle-ai sync\`. Where ODD says "when RDD is
  enabled", it is not. Review is Judgment Day, as this dispatch says below.
- SDD is not selected. Do not enter SDD phases or create SDD artifacts.
- The feature document is \`odd/tasks/<feature-name>.md\`, as ODD says. \`odd/\`
  is ignored in this worktree by an untracked odd/.gitignore: never commit it,
  never force-add it, never delete that file. Mirror it to engram as ODD says,
  passing project explicitly.
- NOBODY ANSWERS IN THIS PANE. Every question ODD tells you to ask the user —
  an ambiguous authorization, a real product decision, a delivery or chain
  strategy — goes through \`ask-invoker "<one question>"\`, and you act on its
  reply. Never end your turn waiting for an answer here.
- Delivery strategy is fixed by the brief: $delivery_text. Do not ask for it.
EOF
  case "${GENTLE_DEPLOYED_CHECK:-required}" in
    out-of-scope:*)
      cat <<EOF
- DEPLOYED CHECK OUT OF SCOPE, declared by the brief (${GENTLE_DEPLOYED_CHECK#out-of-scope: }).
  done-invoker opens your report with that line; do not claim a check against
  what is deployed that you did not run.
EOF
      ;;
    *)
      cat <<'EOF'
- THE CHECK AGAINST WHAT IS DEPLOYED IS PART OF DONE, not a pending line in
  the feature document. done-invoker refuses a done until
  $HW_ARTIFACTS/deployed-check.md holds three lines: `target: <the deployed
  https URL you verified>` (never localhost), `evidence: <a file under
  $HW_ARTIFACTS with the run's result>`, and `RESULT: PASSED`.
  If it cannot run — no QA account, no seed, no session — that is a HOLD:
  `ask-invoker` naming exactly what is missing, then wait for the reply. If it
  ran and failed, or the hold cannot be lifted, report `done-invoker --blocked`.
EOF
      ;;
  esac
}

# ── the account the executor will actually run under ────────────────────────
#
# Resolves three things and writes them where the manifest, the gate and the
# executor environment all read the SAME answer:
#
#   ACCOUNT_CONFIG_DIR   the CLAUDE_CONFIG_DIR to bake in, or empty
#   ACCOUNT_APPLIES      1 only when a redirect will actually take effect
#   ACCOUNT_LINE         what the manifest prints, including WHY it does not
#   ACCOUNT_VERDICT      ok | refused | n/a, read by the gate after the manifest
#
# APPLIES IS NOT THE SAME QUESTION AS SELECTED, and conflating them is the whole
# defect. CLAUDE_CONFIG_DIR is read by Claude Code and by nothing else: an
# opencode or codex executor in a lane whose account is `personal` runs under
# whatever account its own vendor is signed into, and hw cannot change that. So
# a selected-but-inapplicable account is stated as NOT APPLIED rather than
# printed as a fact — an executor that believes it is somewhere it is not is the
# failure mode this whole mechanism was asked to remove.
#
# THE PARITY CHECK IS DELEGATED, never re-implemented: `claude-personal --check`
# owns it (see bin/project-spaces.sh). hw refuses a redirect it could not verify.
ACCOUNT_CONFIG_DIR=""
ACCOUNT_APPLIES=0
ACCOUNT_LINE=""
ACCOUNT_VERDICT="n/a"
ACCOUNT_REFUSAL=""
_resolve_account() {
  ACCOUNT_CONFIG_DIR=""; ACCOUNT_APPLIES=0; ACCOUNT_VERDICT="n/a"; ACCOUNT_REFUSAL=""
  local dir
  if ! dir="$(account_config_dir "$ACCOUNT" 2>/dev/null)"; then
    ACCOUNT_VERDICT=refused
    ACCOUNT_REFUSAL="unknown account '$ACCOUNT' (known: default, personal)"
    ACCOUNT_LINE="$ACCOUNT  ($ACCOUNT_SRC) — REFUSED: $ACCOUNT_REFUSAL"
    return 0
  fi
  if [ -z "$dir" ]; then
    ACCOUNT_LINE="default  ($ACCOUNT_SRC) — no CLAUDE_CONFIG_DIR is set, and an inherited one is cleared"
    return 0
  fi
  if [ "$AGENT" != claude ]; then
    ACCOUNT_LINE="$ACCOUNT  ($ACCOUNT_SRC) — NOT APPLIED: this executor is $AGENT, and only Claude Code reads CLAUDE_CONFIG_DIR. Its account is whatever $AGENT is signed into."
    return 0
  fi
  local out rc=0
  out="$(account_verify "$ACCOUNT" 2>&1)" || rc=$?
  if [ "$rc" != 0 ]; then
    ACCOUNT_VERDICT=refused
    ACCOUNT_REFUSAL="$(printf '%s' "$out" | tail -3 | tr '\n' ' ')"
    ACCOUNT_LINE="$ACCOUNT → $dir  ($ACCOUNT_SRC) — REFUSED: capability parity is not established"
    return 0
  fi
  ACCOUNT_CONFIG_DIR="$dir"
  ACCOUNT_APPLIES=1
  ACCOUNT_VERDICT=ok
  ACCOUNT_LINE="$ACCOUNT → CLAUDE_CONFIG_DIR=$dir  ($ACCOUNT_SRC; parity verified by \`$(account_verifier "$ACCOUNT") --check\`)"
  return 0
}

_resolve_effective_sdd_mode() {
  # SPLIT OUT of _validate_sdd_vendor_pair so the RESOLUTION (measured live
  # surface, falling back to an inherited launch record) can be asked WITHOUT
  # also running the vendor gate below — the reuse-route codex-handoff
  # carve-out needs exactly this resolved mode and MUST NOT trigger that gate
  # itself: `_validate_sdd_vendor_pair codex speckit ...` dies outright, and
  # dying there is precisely the launch this carve-out exists to let through
  # (see the reuse branch of _dispatch_manifest below).
  local requested="$1" surface="$2" inherited="${3:-}" mode
  mode="$requested"
  if [ -z "$mode" ]; then
    # A re-task may inherit a root dispatch record from before an explicit
    # re-task changed this pane's surface. Prefer what is on disk for THIS
    # directory — a machine-wide install alone does not put a directory in
    # play; the recorded value is only the fallback when the disk says nothing.
    _speckit_skills_in "$surface" >/dev/null && mode=speckit
    [ -n "$mode" ] || mode="$inherited"
  fi
  # Published for _validate_sdd_model_pair and for the reuse-route
  # codex-handoff carve-out, which both ask a different question about the
  # SAME resolved mode. Resolving it twice would let two gates disagree about
  # what is in force, which is the one failure neither could report.
  SDD_EFFECTIVE_MODE="$mode"
}

# Codex can list framework skill files, but its native transport has not yet
# demonstrated that it can invoke an SDD entry and complete its flow. Do not
# build an executor around an entry prompt that is only a claim.
_validate_sdd_vendor_pair() {
  local vendor requested surface inherited
  vendor="$1"; requested="$2"; surface="$3"; inherited="${4:-}"
  _resolve_effective_sdd_mode "$requested" "$surface" "$inherited"
  case "$vendor:$SDD_EFFECTIVE_MODE" in
    codex:""|codex:none|opencode:""|opencode:none|claude:*) return 0 ;;
    codex:speckit)
      die "Codex framework dispatch REFUSED BEFORE BUILDING ANYTHING: --sdd $SDD_EFFECTIVE_MODE requires a demonstrated native entry and completed flow, but that capability is unverified. Nothing was built. Use --sdd none for direct delivery, or validate Codex framework execution before re-dispatching."
      ;;
    opencode:gentle|codex:gentle)
      die "gentle-ai ODD dispatch REFUSED BEFORE BUILDING ANYTHING: --sdd gentle runs only on Claude Code. Nothing was built."
      ;;
    opencode:speckit)
      die "OpenCode framework dispatch REFUSED BEFORE BUILDING ANYTHING: --sdd $SDD_EFFECTIVE_MODE is Spec Kit, but this machine exposes Spec Kit only as Claude Code skills. Nothing was built. Use --agent claude for Spec Kit, or --sdd none for direct delivery."
      ;;
  esac
}

# THE ORCHESTRATOR IS NOT THE WORKER, AND THE CHEAP SEAT IS THE WRONG ONE.
#
# Under speckit the session hw launches reads the brief, decides what
# the change IS, partitions it, sequences the phases and rules on the product
# questions the brief deliberately leaves open. The phase agents pin their own
# models regardless of --model, so the orchestrating model is the ONE model --model actually sets --
# and it is the one doing the open-design work.
#
# hw has said so since the framework advisory below was written, but only as a
# warning, and only when --model was NOT given: a suggestion that argues with an
# explicit flag is a defect, not advice. That exemption is exactly the hole.
# `--model sonnet --sdd speckit` is the one spelling of this the advisory can
# never reach, and it is also the spelling a brainer actually types.
#
# The operator's ruling, relayed by the product-lane brainer:
# "nunca podes poner un sonnet a orquestar un flujo sdd. deberia ser ilegal
# eso." Illegal is a refusal, not a warning -- so this is a gate with the same
# shape and the same timing as _validate_sdd_vendor_pair: measured, named, and
# dead before a worktree, a database, a port or a pane exists.
#
# NO OVERRIDE FLAG, deliberately. The codex refusal it is modelled on has none
# either. If a legitimate case for a cheap orchestrator appears, it arrives as a
# contract challenge with evidence and this gate loosens -- which is cheaper than
# an escape hatch that gets typed once and then always.
#
# THE CLASS, NOT THE INSTANCE. The ruling names sonnet; haiku orchestrating the
# same flow is strictly worse, and refusing one while passing the other would be
# a gate that names an example. Matched on the model's LAST path segment so an
# opencode `anthropic/claude-sonnet-5` is the same refusal as claude's `sonnet`.
# Model names hw cannot rank (openai/gpt-5.6-sol, fable)
# pass: this gate knows the claude tier ladder and claims nothing else.
_sdd_model_is_below_orchestrator() {
  case "${1##*/}" in
    sonnet|haiku|sonnet-*|haiku-*|*sonnet*|*haiku*) return 0 ;;
  esac
  return 1
}

_validate_sdd_model_pair() {
  local model="$1" mode="${SDD_EFFECTIVE_MODE:-}" where="${2:-}"
  case "$mode" in speckit) ;; *) return 0 ;; esac
  # An empty model is claude's inherited default, which is opus. Refusing on
  # absence of evidence would block every legacy pane and every ordinary
  # framework launch, and it would be refusing the RIGHT model.
  [ -n "$model" ] || return 0
  _sdd_model_is_below_orchestrator "$model" || return 0
  # THE ORDER OF THE EXITS IS PART OF THE MESSAGE, and it was wrong for the one
  # caller who had already said what they wanted. Measured: two
  # product-lane briefs declaring `sdd: none` were dispatched
  # without `--sdd`, resolved to the directory's live framework, and died here —
  # and this line sent the reader to `--model opus --effort medium` FIRST, which
  # is paying for an opus orchestrator on a task that explicitly asked not to
  # enter the flow at all. The exit that honours the declaration goes first, and
  # the message says the declaration exists, because the symptom this gate
  # reports (the model) is not the cause the reader needs to see.
  local declared_sdd=""
  if [ -n "${BRIEF:-}" ]; then
    _load_brief_decls
    declared_sdd="$(printf '%s\n' "$BRIEF_DECLS" | awk -F"$(printf '\t')" '$1=="sdd"{print $2; exit}')" || declared_sdd=""
  fi
  local exits="Relaunch with --model opus --effort medium, or dispatch outside the flow with --sdd none."
  if [ "$declared_sdd" = none ]; then
    exits="The brief already declared \`sdd: none\`, and this dispatch did not carry it: relaunch with --sdd none, which is what the brief asked for. Only if the brief is what is wrong, relaunch with --model opus --effort medium instead."
  fi
  die "SDD orchestrator model REFUSED BEFORE BUILDING ANYTHING: --model $model with --sdd $mode${where:+ ($where)}. Under $mode this session is the ORCHESTRATOR -- it decides what the change is, partitions it and sequences the phases, and the phase agents pin their own models regardless of --model. A sonnet or haiku orchestrator over opus phase agents is inverted. Nothing was built. $exits"
}

_next_dispatch_model() {
  # The pane's SESSION model, read from the launch manifest the same way
  # _run_dispatch_framework reads its framework. Task records do not carry one:
  # the model is fixed at spawn and `hw next` cannot change it, which is exactly
  # why a cheap pane handed an SDD flow is worth refusing here.
  #
  # CAPTURES THE WHOLE VALUE, not just its first word, and DOES NOT REQUIRE the
  # trailing `  (mark)` annotation to be present. Two bugs lived here in
  # sequence, both real, neither theoretical-only but neither found live
  # either (searched every `dispatch` file under the work roots and the product checkouts,
  # 2026-09-11: 684+ `model=` lines, all end in `  (mark)`; `git log -p` on
  # `model_line`'s own format shows one introduction, never changed since).
  #   1. `[^ ]*` stopped at the first space, so `model=<agent default>
  #      (inherited)` returned the truncated `<agent` instead of `<agent
  #      default>`. Harmless for the ORIGINAL caller
  #      (`_sdd_model_is_below_orchestrator` matches neither string against
  #      sonnet/haiku) but not for the reuse-route refusal added after it,
  #      which needs to tell "inherited default" apart from "no evidence".
  #   2. Fixed for bug 1 by requiring the literal suffix `  (.*)$` — which
  #      then returns EMPTY for any `dispatch` line that lacks it, and empty
  #      reads as "no evidence" to every consumer. `_validate_sdd_model_pair`
  #      explicitly treats empty as "nothing to refuse" (its own comment:
  #      "refusing on absence of evidence would block every legacy pane"), so
  #      a `dispatch` written in a format this line does not recognise would
  #      silently turn the sonnet-orchestrator gate off rather than refuse —
  #      the opposite of a defensive parse.
  # The fix extracts the value AFTER `model=` unconditionally, then strips a
  # trailing `  (mark)` ONLY when one is actually anchored at the end of the
  # line — via awk's `$`-anchored match, not a greedy `.*`, so a value that
  # itself contains "  (" is not truncated at the wrong occurrence.
  local rundir="$1"
  [ -r "$rundir/dispatch" ] || return 0
  awk '
    /^[[:space:]]*model=/ {
      line = $0
      sub(/^[[:space:]]*model=/, "", line)
      if (match(line, /  \([^()]*\)$/)) line = substr(line, 1, RSTART - 1)
      print line
      exit
    }
  ' "$rundir/dispatch" 2>/dev/null || true
}

_next_dispatch_effort() {
  # Same shape and the same fix as _next_dispatch_model, for the reuse-route
  # effort refusal below. `effort_line` follows the identical `key=value
  # (mark)` format, and for opencode may continue onto further indented lines
  # (`applied ...`, `overlay ...`) that this intentionally does not capture —
  # only the session's own resolved value matters here, not how it reached
  # the vendor.
  local rundir="$1"
  [ -r "$rundir/dispatch" ] || return 0
  awk '
    /^[[:space:]]*effort=/ {
      line = $0
      sub(/^[[:space:]]*effort=/, "", line)
      if (match(line, /  \([^()]*\)$/)) line = substr(line, 1, RSTART - 1)
      print line
      exit
    }
  ' "$rundir/dispatch" 2>/dev/null || true
}

# Decides what a reuse-route session flag refusal should DO, given what was
# requested and what was measured on the live pane. Sets _REUSE_FLAG_VERDICT:
#   match        the live pane already runs exactly the requested value —
#                nothing this flag would change, so the caller does not die.
#   unmeasurable the raw value could not be read at all ("").
#   mismatch     a real, different value (including the `<agent default>`
#                placeholder, which by construction never equals anything a
#                caller would type for --model/--effort).
# Compares the RAW value, never the friendly description `_reuse_measured_desc`
# produces — the placeholder text and the "could not be measured" sentence
# would otherwise accidentally collide with something a caller actually typed.
_reuse_flag_decision() {
  local requested="$1" measured="$2"
  if [ -z "$measured" ]; then _REUSE_FLAG_VERDICT=unmeasurable; return 0; fi
  if [ "$measured" = "$requested" ]; then _REUSE_FLAG_VERDICT=match; return 0; fi
  _REUSE_FLAG_VERDICT=mismatch
}

# Turns a raw measured value (from _next_dispatch_model/_next_dispatch_effort/
# a live herdr vendor read) into the sentence fragment the manifest and the
# reuse-route refusals both use, so the two can never describe the same fact
# two different ways. $1 = the raw value ("" = unmeasurable), $2 = the flag
# spelling (e.g. "--model") named only in the placeholder sentence.
_reuse_measured_desc() {
  case "$1" in
    '') printf 'could not be measured' ;;
    '<agent default>') printf "its agent's own default (that launch recorded no explicit %s)" "$2" ;;
    *) printf '%s' "$1" ;;
  esac
}

# WHAT'S ACTUALLY TRUE ABOUT THE DISPATCH FILE, not an inference about why.
# MEASURED 2026-09-11 (third review), by running both shapes and diffing
# bytes: a candidate with a `dispatch` file that has no `model=` line at all,
# and one with NO `dispatch` file whatsoever, printed IDENTICAL text — "has no
# model= line" was asserted about a file the second candidate never opened.
# The refusal messages compounded it with "a run from before this field
# existed" — an unverified CAUSE (a missing file explains itself; a present
# file with the line absent could be truncated, corrupted, or simply old, and
# nothing here can tell which). This distinguishes the three states a caller
# can actually be shown evidence for, and asserts no more than that.
_reuse_dispatch_absence_reason() {  # $1 = key, e.g. "model" or "effort"
  if [ ! -e "$_REUSE_RUNDIR/dispatch" ]; then
    printf 'no dispatch record exists at %s/dispatch' "$(basename "$_REUSE_RUNDIR")"
  elif [ ! -r "$_REUSE_RUNDIR/dispatch" ]; then
    printf '%s/dispatch could not be read' "$(basename "$_REUSE_RUNDIR")"
  else
    printf '%s/dispatch has no %s= line' "$(basename "$_REUSE_RUNDIR")" "$1"
  fi
}

# Builds the manifest's `model`/`effort`/`agent` field text for the REUSE
# route. MEASURED 2026-09-11 (second review): calling `_reuse_measured_desc`
# directly here, the way the mismatch branch of a refusal does, reproduced
# the exact broken sentence the refusal messages were fixed NOT to say —
# "the REUSED session's own is could not be measured, read from
# <rundir>/dispatch" claims a read that never happened AND asserts a value in
# the same breath it says none exists. These three give the unmeasurable case
# its own honest clause, the same discipline the refusal messages already
# have, so the manifest and the refusal can never diverge on which is true.
_reuse_model_field_line() {
  case "$REUSE_MODEL" in
    '') printf "model=n/a  (--model cannot change a live session; the REUSED session's own model could not be measured — %s)" "$(_reuse_dispatch_absence_reason model)" ;;
    *)  printf "model=n/a  (--model cannot change a live session; the REUSED session's own is %s, read from %s/dispatch)" "$(_reuse_measured_desc "$REUSE_MODEL" --model)" "$(basename "$_REUSE_RUNDIR")" ;;
  esac
}
_reuse_effort_field_line() {
  case "$REUSE_EFFORT" in
    '') printf "effort=n/a  (--effort cannot change a live session; the REUSED session's own effort could not be measured — %s)" "$(_reuse_dispatch_absence_reason effort)" ;;
    *)  printf "effort=n/a  (--effort cannot change a live session; the REUSED session's own is %s, read from %s/dispatch)" "$(_reuse_measured_desc "$REUSE_EFFORT" --effort)" "$(basename "$_REUSE_RUNDIR")" ;;
  esac
}
_reuse_agent_field_line() {
  case "$REUSE_VENDOR" in
    '') printf "the REUSED session's own vendor could not be measured — herdr reports no vendor for %s — --agent cannot change a live session" "$_REUSE_PANE" ;;
    *)  printf "the REUSED session's own: %s  (measured live via herdr) — --agent cannot change a live session" "$REUSE_VENDOR" ;;
  esac
}

# ── the account a reuse candidate's LIVE session is running under ────────────
#
# Measured from that run's own persisted environment, never from what this
# command asked for — the same decision `_dispatch_manifest`'s reuse branch
# already made for this field, and the reason is in its comment there.
#
# THE THREE STATES ARE NOT THE THREE `_reuse_dispatch_absence_reason`
# DISTINGUISHES, and the difference is why this gets its own helper. Two match
# exactly: the env record is not there, or it is there and unreadable.
# `_run_env_value` returns 1 down BOTH of those paths AND down a third — the
# key simply not being present — and every caller collapses all three with
# `$(… || true)`, so an empty result on its own proves nothing.
#
# THE THIRD STATE IS A POSITIVE MEASUREMENT, NOT AN ABSENCE — for the launch
# path hw controls, and that qualifier is not decoration. A READ env record with
# no CLAUDE_CONFIG_DIR line says the pane hw built launched with no redirect,
# i.e. the default account, and it takes TWO facts to say that rather than the
# one this comment claimed until its first adversarial review:
#
#   · For an account-era run: `_export_hw_env` exports that variable only when a
#     redirect applies and explicitly `unset`s it otherwise — its own comment
#     calls that unset as load-bearing as the export, precisely so a redirected
#     brainer cannot leak its account into a `default` lane.
#   · For a run OLDER than the feature: MEASURED 2026-09-14 against d33fad1~1,
#     the commit before `--account` existed — CLAUDE_CONFIG_DIR appears nowhere
#     in that hw except inside a comment. It was not in `_render_layout`'s
#     `base_env` allowlist, and a pane receives exactly what that allowlist
#     carries, so no pane hw built back then could hold a redirect to record.
#     This matters because `.hw/<run>/env` has no version marker and
#     `_check_reusable_executor` puts no age limit on a live lease: a candidate
#     whose record predates the feature is reachable, and "old" alone would
#     otherwise have to mean "unmeasurable".
#
# AND THE BOUND, STATED RATHER THAN LEFT TO BE FOUND: this reads what hw ITSELF
# baked. A redirect that reached the pane by a route hw did not write lands in
# the pane and NOT in this record: a product lane's `.envrc` is one line exporting
# CLAUDE_CONFIG_DIR, so a hand-allowed direnv would do it; so would a manual
# export before a `--here` split; and so would a plain `export` in the shell rc
# every pane herdr opens, which is the most ordinary of the three and the one
# worth naming first. Such a redirect is in the pane and
# NOT in this record, and nothing on disk distinguishes that from a pane that
# never had one. Refusing on the possibility is the wrong trade: it would refuse
# `--account default` against every ordinary pane in the tree, for a shape hw
# does not create (14a46e1 reverted the direnv allow for its own reasons). So
# the inference stands, with its limit named here rather than implied.
#
# Absence-of-line is therefore evidence, within that bound; absence-of-file is
# not evidence of anything.
#
# Collapsing them either way gives a wrong answer, and both are reachable.
# Calling a read file's missing line "unmeasurable" would refuse
# `--account default` against a pane already running exactly that. Calling an
# UNREAD file "default" asserts an account from a file nobody opened — MEASURED
# 2026-09-14: a candidate selected by a live chaining lease with NO env file at
# all is reachable (the lease is its own file, and `_next_run_dir` only requires
# `.hw/<run>/`), and before this split the manifest printed "so it runs under
# the default account" for exactly that candidate.
REUSE_ACCOUNT_CFG=""
REUSE_ACCOUNT_MEASURED=0
_reuse_measure_account() {
  REUSE_ACCOUNT_CFG=""
  REUSE_ACCOUNT_MEASURED=0
  [ -r "$_REUSE_RUNDIR/env" ] || return 0
  REUSE_ACCOUNT_MEASURED=1
  REUSE_ACCOUNT_CFG="$(_run_env_value "$_REUSE_RUNDIR" CLAUDE_CONFIG_DIR || true)"
}

# Only the two states that are genuinely absent. The read-but-lineless case is
# a measurement, and is stated by the callers rather than by an absence reason.
_reuse_account_absence_reason() {
  if [ ! -e "$_REUSE_RUNDIR/env" ]; then
    printf 'no run environment record exists at %s/env' "$(basename "$_REUSE_RUNDIR")"
  else
    printf '%s/env could not be read' "$(basename "$_REUSE_RUNDIR")"
  fi
}

# The measured account as a sentence fragment, shared by the manifest field and
# the refusal below so the two can never describe one pane two ways — the same
# discipline `_reuse_measured_desc` gives model/effort/agent.
_reuse_account_desc() {  # $1 = measured CLAUDE_CONFIG_DIR ("" = the default account)
  case "$1" in
    '') printf 'the default account (its run environment records no CLAUDE_CONFIG_DIR)' ;;
    *)  printf 'CLAUDE_CONFIG_DIR=%s' "$1" ;;
  esac
}

_reuse_account_field_line() {
  if [ "$REUSE_ACCOUNT_MEASURED" = 0 ]; then
    printf "the REUSED session's own account could not be measured — %s — --account cannot change a live session" "$(_reuse_account_absence_reason)"
  elif [ -n "$REUSE_ACCOUNT_CFG" ]; then
    printf "the REUSED session's own: CLAUDE_CONFIG_DIR=%s (read from %s/env) — --account cannot change a live session" "$REUSE_ACCOUNT_CFG" "$(basename "$_REUSE_RUNDIR")"
  else
    printf "the REUSED session's own: no CLAUDE_CONFIG_DIR in %s/env, so it runs under the default account — --account cannot change a live session" "$(basename "$_REUSE_RUNDIR")"
  fi
}

_codex_validation_surface() {
  if _lane_is_product_repo "$PROJ"; then lane_checkout "$PROJ"
  else printf '%s/%s/%s' "$WORK" "$PROJ" "$TASK"; fi
}

_run_dispatch_framework() {
  local rundir="$1"
  [ -r "$rundir/dispatch" ] || return 0
  awk '/^  framework[[:space:]]/{ print $2; exit }' "$rundir/dispatch" 2>/dev/null || true
}

# ── Local config replication ────────────────────────────────────────────────
# Only used for a lane with no worktree script; a product lane's wt.sh already does this, better.
#
# symlink vs copy, decided per file:
#   symlink — shared truth. A credential rotated in the main checkout must
#             reach every live task at once; a copy would go stale silently.
#   copy    — the task may need to diverge. .env.local carries the per-worktree
#             repo's per-worktree managed block (its own database), so it MUST
#             be a private file; symlinking it would make every task rewrite
#             every other task's database URL.
_link_or_copy() {
  local main="$1" wt="$2" rel="$3" mode="$4"
  local src="$main/$rel" dst="$wt/$rel"
  if [ ! -e "$src" ]; then
    warn "$rel — NOT PRESENT in $main; the dev server may boot against code defaults"
    return 0
  fi
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then info "$rel — already linked"; return 0; fi
  if [ -e "$dst" ] && [ ! -L "$dst" ] && [ "$mode" = copy ]; then info "$rel — already present, kept"; return 0; fi
  if [ -e "$dst" ] || [ -L "$dst" ]; then rm -f "$dst"; fi
  case "$mode" in
    link) ln -s "$src" "$dst"; ok "$rel — symlink (shared)" ;;
    copy) cp -p "$src" "$dst"; ok "$rel — copy (task-private)" ;;
  esac
}

# Deliver the brief as the agent's first prompt, over the herdr socket.
# Deliberately NOT written into the worktree: no file, no untracked entry,
# nothing that could end up in a commit.
#
# _framework_entry <mode> — the command that starts that mode's flow, or nothing.
_framework_entry() {
  # What STARTS the framework's flow. Spec Kit's entry is a SKILL, reachable as
  # `/<name>` from a prompt: speckit ships no commands at all. specify is the
  # entry for new work; speckit-constitution is one-time project setup. Any
  # other mode has no entry, and the empty answer says so.
  case "$1" in
    speckit) printf '/speckit-specify' ;;
    *)       printf '' ;;
  esac
}

# The specialist subagents available in the executor's work directory, minus the
# framework's own phase agents and review panel — those are the flow's business,
# not a choice the executor makes. Read from disk, because "which agents exist
# here" is a fact about the worktree and has been wrong in a brief twice.
_specialist_agents() {
  local dir="$1"
  [ -d "$dir/.claude/agents" ] || return 0
  fd -t f -t l -e md . "$dir/.claude/agents" 2>/dev/null \
    | sd '.*/' '' | sd '\.md$' '' \
    | rg -v '^(sdd-|speckit-|review-|jd-)' \
    | sort | tr '\n' ' ' | sd ' $' '' || true
}

# ── what closes a CODE task: Judgment Day over the branch, then the report ──
#
# THE FLOW IS brainer → executor → Spec Kit (optional) →
# Judgment Day, and until 2026-09-22 hw carried only the first two. The base
# paragraph below told an executor WHICH range a review would target and never
# that a review was owed, so whether one ran was left to the brief.
#
# WHICH KIND CARRIES IT, decided from what the kinds mean in this file, not from
# taste: `_check_task_kind` defines explore/audit/review as tasks that decide
# WHAT to build — their output is a report, and a report has no diff for two
# judges to read. `build` is the kind whose output IS a diff. An undeclared kind
# is treated as build, because that is how every undeclared brief is already
# dispatched (the lane pin is a build model); a kind INFERRED from the name
# (`*audit*`, `*review*`…) counts as what it was inferred to be.
#
# AND ONLY WITH A BASE. No HW_REVIEW_BASE_REF means no worktree or no branch
# point — nothing to diff — and the paragraph would prescribe a range that does
# not exist.
#
# READS GLOBALS: TASK_KIND (set on launch by _check_task_kind), BRIEF (read on
# `hw next`, where no contract check ran for the new brief), HW_REVIEW_BASE_REF.
_brief_kind_for_close() {
  if [ -n "${TASK_KIND:-}" ]; then printf '%s' "$TASK_KIND"; return 0; fi
  [ -f "${BRIEF:-}" ] || return 0
  # The frontmatter's own `kind:`, and nothing else: self-contained on purpose,
  # so the extracted preamble fragment the tests drive needs no parser from
  # elsewhere in this file. An unterminated fence yields nothing, i.e. build.
  awk 'NR==1 { if ($0 != "---") exit; next }
       $0 == "---" { exit }
       /^[[:space:]]*kind[[:space:]]*:/ { sub(/^[^:]*:[[:space:]]*/, ""); sub(/[[:space:]]*#.*$/, ""); gsub(/["'"'"'[:space:]]/, ""); print; exit }' \
    "$BRIEF" 2>/dev/null || true
}

_judgment_day_applies() {
  [ -n "${HW_REVIEW_BASE_REF:-}" ] || return 1
  case "$(_brief_kind_for_close)" in
    ""|build) return 0 ;;
    *)        return 1 ;;
  esac
}

_judgment_day_note() {
  printf 'CLOSING THIS CODE TASK: JUDGMENT DAY, THEN done-invoker. In this order:

1. Commit per work unit as you go, on this branch, with Conventional Commit
   messages — not one commit at the end. The review target is what you
   COMMITTED; uncommitted work is not judged and is not delivered.
2. Before done-invoker, run the judgment-day skill over
   "$(hw review-range)"..HEAD — the branch point computed NOW, so a rebase
   onto the base since dispatch does not pull other people'"'"'s commits into the
   target. If that range is empty there is nothing to judge: say so in the
   report instead. Record the judged range (base SHA..head SHA).
   JUDGMENT DAY IS OPTIONAL. If the judgment-day skill is not among your
   available skills, it is not installed: there is nothing to judge with and
   nothing ESCALATED. Say "Judgment Day: not installed (optional)" in the
   report and close normally. ESCALATED means judges ran and could not converge.
   REBASED AFTER JUDGING? Do not re-judge the whole range. Run
   hw review-delta <judged-base> <judged-head>
   Exit 0: your own diff is the one judged, only moved — the verdict stands.
   Exit 3: it prints the files whose own diff changed; re-judge ONLY those, as
   a scoped re-judgment (it does not reset the fix-round budget). Exit 1: it
   cannot tell — judge the full range again.
3. The skill asks before its first fix round. Nobody answers here, and nobody
   has to: the brief that authorized this implementation IS that
   authorization. Apply the fixes both judges confirmed without asking. Judges
   that contradict each other, or anything left after round two, is ESCALATED —
   report it, do not ask and do not wait.
4. The done-invoker report carries the verdict, APPROVED or ESCALATED (or
   "not installed (optional)", above), and,
   separately, every severe finding only ONE judge raised (unconfirmed, so not
   fixed), each with its file:line.'
}

# ── the design is judged before the code, where the brief declares a boundary ──
#
# MEASURED 2026-09-28 (setup/decisions.md, "Judgment Day juzga el diseño"): the
# brain guard and the export's home-path gate each spent Judgment Day's whole
# round budget, and neither failure was a bug. The approach — parse Bash, excuse
# home paths by URL and placeholder — sat over an open input space, so every
# correct fix opened a neighbour. Code-mode JD saw it only after the code
# existed. A brief whose mistake would be the approach says so with
#
#     boundary: <what must never cross, in one sentence>
#
# and the executor judges its design first (judgment-day, design mode). The
# value is read here, by one self-contained reader, for the same reason
# _brief_kind_for_close is: the preamble fragment the tests drive needs no
# parser from elsewhere in this file, and the launch, `hw next` and the
# receipt all read one answer. Only surrounding whitespace and quotes are
# stripped, like _brief_declares; a `#` is part of the sentence.
_brief_boundary() {  # $1 = brief path (default: $BRIEF)
  local f="${1:-${BRIEF:-}}"
  [ -f "$f" ] || return 0
  awk 'NR==1 { if ($0 != "---") exit; next }
       $0 == "---" { exit }
       /^[[:space:]]*boundary[[:space:]]*:/ { sub(/^[^:]*:[[:space:]]*/, ""); sub(/[[:space:]]+$/, "");
         if ($0 ~ /^".*"$/ || $0 ~ /^'"'"'.*'"'"'$/) $0 = substr($0, 2, length($0) - 2);
         print; exit }' "$f" 2>/dev/null || true
}

# A boundary gates CODE, so only a build carries it — the same kinds that
# carry the code-mode closing. Unlike that closing it needs no computed base:
# a design is judged before there is any diff.
_design_gate_applies() {
  [ -n "$(_brief_boundary)" ] || return 1
  case "$(_brief_kind_for_close)" in
    ""|build) return 0 ;;
    *)        return 1 ;;
  esac
}

_design_judgment_note() {  # $1 = the declared boundary
  printf 'JUDGE THE DESIGN BEFORE THE CODE. This brief declares a boundary:

    boundary: %s

Before your first code commit, write your design to one file under
$HW_ARTIFACTS — the boundary, the mechanism, the input space it decides over,
and what an input nobody anticipated gets — and run the judgment-day skill in
DESIGN MODE over it (references/design-mode.md). Then write
$HW_ARTIFACTS/design-judgment.md with these lines:

    boundary: <the line above, exactly>
    design: <the design file>
    design_sha256: <its sha256>
    JUDGMENT: APPROVED            (or ESCALATED)

An APPROVED verdict lists, one amendment: line each, the bypass classes both
judges confirmed and the approach can close; your code closes them, and the
code-mode Judgment Day at the end is where that is checked. done-invoker
refuses a done report without an APPROVED verdict whose design still hashes to
design_sha256. An ESCALATED design is a blocker, not a
prompt to code anyway: report it with done-invoker --blocked, naming the
bypass classes the judges found. Two rejected designs mean the approach is
your brainer'"'"'s call.' "$1"
}

# ── a Spec Kit phase is not the task ──
#
# MEASURED 2026-09-22: an executor dispatched `--sdd speckit` closed the task
# with done-invoker the moment `/speckit-specify` finished. The entry line told
# it where to START and nothing told it where the task ENDS, so the end of the
# first phase read as the end of the work. Carried on both routes — the launch
# prompt and a `hw next --sdd speckit` re-task — because the second one is the
# same flow starting over.
#
# THE FRESH ANALYZE IS ON TRIAL, not established. Approved 2026-09-24 as the
# equivalent of gentle's fresh design gate; the defect it would catch was never
# measured. The ruling that admits it, and what removes it, is in
# setup/decisions.md under "The fresh analyze gate".
_speckit_phase_note() {
  printf 'A SPEC KIT PHASE IS NOT THE TASK. Finishing /speckit-specify — or plan, tasks,
or any other speckit-* phase — is not finishing this task: go straight on to the
next phase, through implementation, and close with done-invoker only when the
flow and the brief are both done. A [NEEDS CLARIFICATION] marker is yours to
resolve from the brief and the code: decide, write the decision and its reason
into the spec, and continue. Do not wait for a human for it. Only a decision
that is genuinely '"${HW_OPERATOR:-the operator}'s"' — money, a third party, an irreversible or outward
action — goes through ask-invoker, and the task stays open while it waits.

BETWEEN /speckit-tasks AND /speckit-implement, A FRESH /speckit-analyze. Run it
in a new subagent that sees only spec.md, plan.md, tasks.md and the project
constitution — not this conversation, not your reasoning. Its report is
read-only. A CRITICAL finding is corrected once, in the artifact it names, and
then you go on to /speckit-implement without re-running it. Anything below
CRITICAL does not stop the flow.'
}

# ── the preamble every brief-backed prompt carries, on BOTH delivery routes ──
#
# EXTRACTED SO `hw next` CAN CARRY IT TOO. Until 2026-09-21 this text existed
# only inside _send_brief, so a re-tasked executor received the task counter and
# the brief and nothing else. RE-MEASURED 2026-09-21, and the selector is named
# because the number depends on it: user messages OPENING with `NEXT TASK (task`
# across ~/.claude/projects and ~/.claude-personal/projects give 158 deliveries
# in 89 session files, 0 of them carrying one byte of this text, and 8 arriving
# after a compaction boundary in their own transcript. Loosen it to any user
# message merely CONTAINING that header and it is 177 in 102 — still 0. An
# inherited note said 170/95 with the same 0 and the same 8; that selector was
# not recoverable, so the figures above are this one's. One copy, two callers.
#
# READS GLOBALS, not arguments, because `cmd_next` rebuilds them from the RUN
# env rather than the brainer's: BRIEF, HW_BIN_DIR, HW_WORKDIR, ENGRAM_PROJECT,
# HW_REVIEW_BASE_REF, HW_REVIEW_BASE_BRANCH.
_brief_preamble() {
  # ── two things hw states on every dispatch, because both were forgotten ──
  #
  # THE ENGRAM LABEL. On 2026-08-24 two executors filed seven observations
  # under `<lane>` while their env said `brain`. engram 2.1.0 honours
  # ENGRAM_PROJECT (process_override, measured 2026-09-30), and what remained
  # open — an explicit `project` naming another existing label — is refused
  # by bin/engram-label-proxy (_engram_proxy_args). The line below tells the
  # executor so, instead of asking it to remember a parameter.
  #
  # THE SPECIALISTS. A brief once asked an executor to ssh into prod and time
  # queries against a third party's database by hand, with
  # `ops-investigator` — read-only ops investigation, exactly that job — sitting
  # unmentioned in its own .claude/agents. The brainer has to remember; hw can
  # just look.
  # THE CLOSING, ON EVERY DISPATCH. hw stated the OPENING on every launch — the
  # framework entry command, or "outside the flow" — and the closing in exactly
  # one branch, `--sdd none`. So the one instruction with several recorded
  # failures was left to whatever the brief happened to say. One brainer's
  # brief did not say it, and the operator had to type "reporta al invoker por
  # favor" after a short audit had already finished. A contract that hw
  # enforces at one end and hopes for at the other is not a contract.
  # THE PANE IS UNATTENDED. An interactive question tool is not a human channel
  # in an executor pane: nobody watches it, and a missing runtime capability was
  # already mistaken for permission to stop before reporting. ask-invoker is the
  # channel hw actually owns, so every dispatch says that and names the blocked
  # report as the exit when a tool or runtime limitation prevents the work.
  local specialists preamble
  specialists="$(_specialist_agents "$HW_WORKDIR")"
  preamble="$(printf 'CLOSE WITH done-invoker. Finishing the work is not reporting it, and neither is
answering in your own pane — your brainer cannot see this pane and will not poll
it. Until done-invoker runs, this task reads as open to everyone else.

This pane is unattended: no human reads it, and an interactive question tool has
no answerer here — where such a tool exists at all, its answer never arrives.
ask-invoker is the only human channel. A missing tool or runtime limitation is a
fact to report with done-invoker --blocked, never a reason to end the turn silently.

done-invoker AND ask-invoker ARE SHELL COMMANDS, in your PATH, run in a terminal.
They are not tools, and no tool of those names exists. Run them the way you run
any other command:

    done-invoker "<one paragraph: what you established, and the engram ids>"
    done-invoker --blocked "<what stopped you, and what would unblock it>"
    ask-invoker  "<one question>"       # your brainer answers; the budget is small
    ask-invoker --challenge "<what the brief forbids> :: <what you observed>"

If the brief forbids something you have EVIDENCE is wrong, challenge it instead
of stopping — obey-or-stop are not your only two moves.
A challenge does NOT spend an ask; it has its own budget. It needs the evidence,
not the opinion. Until your brainer rules, hold.

If your shell cannot find them, they are at %s/done-invoker and
%s/ask-invoker — run them by absolute path rather than concluding they do not
exist.

Your brief is also on disk at %s. If anything above arrived truncated or you
lost it, read that file rather than asking for it again.

If it ever answers "already notified the brainer for this task" and you were
re-tasked after that report, the task counter did not move — add --retask and
report anyway. A finished task that cannot be reported is the failure; a report
your brainer has to arbitrate is not.

Save to engram with project: %s — your engram server is the label proxy hw
launched: omit `project` or pass exactly that; any other value is refused, and
every mem_search already reads all labels (all_projects is forced).' "$HW_BIN_DIR" "$HW_BIN_DIR" "${BRIEF:-<no brief file>}" "${ENGRAM_PROJECT:-brain}")"
  # THE SESSION hw REGISTERED, when it did (_engram_register_session). Naming it
  # makes the save explicit instead of relying on engram selecting it.
  if [ -n "${HW_ENGRAM_SESSION:-}" ]; then
    preamble="$(printf '%s\n\nYour engram session is %s, registered by hw under %s for this work\ndirectory. Pass session_id: %s with project: %s on every mem_save; without\nit, engram may file the save into manual-save-%s, which it can refuse.\ndone-invoker checks it: a done report must name at least one observation as\n#<id>, and that id must exist under %s, or the report is refused.' \
      "$preamble" "$HW_ENGRAM_SESSION" "${ENGRAM_PROJECT:-brain}" "$HW_ENGRAM_SESSION" "${ENGRAM_PROJECT:-brain}" "${ENGRAM_PROJECT:-brain}" "${ENGRAM_PROJECT:-brain}")"
  fi
  if [ -n "$specialists" ]; then
    preamble="$(printf '%s\n\nSpecialist subagents available here: %s. If one of them is the job, delegate\nrather than doing it inline — they carry the access and the conventions for it,\nand reconstructing those in your own session is how a mechanism gets improvised.' "$preamble" "$specialists")"
  fi
  # CODEX LOADS NO CLAUDE.md, so the executor rules of CLAUDE.shared.md that it
  # cannot see are stated here, one line each; the project on every mem_save and
  # the closing are already in the preamble above. Gated on the executor's
  # vendor (HW_EXECUTOR_VENDOR, persisted for a re-task; AGENT at launch) because
  # Claude Code and OpenCode read those rules from the file and would pay twice.
  # Held by setup/tests/220-codex-recibe-las-reglas-de-executor.sh.
  case "${HW_EXECUTOR_VENDOR:-${AGENT:-}}" in
    codex)
      preamble="$(printf '%s\n\n%s' "$preamble" "RULES CODEX DOES NOT LOAD (shared rules, one line each):
- Secrets: never print, copy into a new file, paste or commit .env, *.db, *.credentials or secrets/; report key names, never values.
- A brief names a Keychain handle for a credential; no handle is a gap, report it with done-invoker --blocked.
- Browser: close it with $HW_BIN_DIR/browser-close, and never retry a failed launch (a failed launch is a blocked report).
- Artifacts (audio, exports, captures, generated files) go to \$HW_ARTIFACTS, never into git status.")" ;;
  esac
  # THE POLICY A LANE'S DEV-SERVER DEFAULT EXISTS TO ENFORCE, STATED ONCE, ON
  # EVERY DISPATCH OF THAT LANE (`brief_note` in projects.json) — not just the
  # ones with no dev server, so an executor launched with --dev-server does not
  # read its own ports as license to do the QA that decision moved to staging.
  # ${PROJ:-}, NOT $PROJ: _next_message calls this from a subshell that
  # deliberately does not carry the BRAINER's own PROJ (using it there would
  # name the wrong lane on a re-task routed through --report-to) — it sets its
  # own PROJ, read back from the run's persisted HW_PROJECT, right before this
  # call. Bare $PROJ died here under set -u the one time that subshell had not
  # been given a value at all (setup/tests/12-hw-next.sh, measured 2026-09-22).
  local brief_note=""
  [ -z "${PROJ:-}" ] || brief_note="$(lane_get "$PROJ" brief_note)" || brief_note=""
  if [ -n "$brief_note" ]; then
    preamble="$(printf '%s\n\n%s' "$preamble" "$brief_note")"
  fi
  # THE BASE A JUDGMENT DAY TARGET IS BUILT AGAINST, ON EVERY DISPATCH THAT HAS ONE.
  #
  # GATED ON THE FACT: a base was computed, or it was not. A lane with no
  # worktree, a `--worktree none` dispatch and an unresolvable base all print
  # nothing here, which is also just the truth.
  #
  # IT SAYS THE VARIABLE, THE COMMAND AND THE COUNT, and nothing else. A number
  # the executor can compare is worth more than a paragraph asking it to be
  # careful.
  # GATED BY KIND TOO, like the closing below: an audit has no diff to judge, so
  # a paragraph about the range a judge would read is noise to it.
  if _judgment_day_applies; then
    local base_note
    base_note="$(printf 'THE BASE A JUDGMENT DAY TARGET IS BUILT AGAINST, computed by hw at dispatch:

    HW_REVIEW_BASE_REF=%s
    HW_REVIEW_BASE_BRANCH=%s   (the branch POINT off it — git merge-base, not its tip)

That value is frozen at dispatch. If you have rebased onto the base since, it
now includes commits that are not yours. A Judgment Day target is the branch
point computed at judging time, to HEAD:

    git diff "$(hw review-range)"..HEAD

Check the count before you trust any verdict. The frozen target must hold the
same number of files as

    git diff --name-only "$(hw review-range)"..HEAD | wc -l

`hw review-range` exits 1 naming the ref when it cannot compute the branch
point; then report that with done-invoker instead of judging a guessed range.

If the two numbers differ, the target is not your work: report that with
done-invoker instead of judging it.' \
      "$HW_REVIEW_BASE_REF" "${HW_REVIEW_BASE_BRANCH:-<unnamed>}")"
    preamble="$(printf '%s\n\n%s' "$preamble" "$base_note")"
  fi
  # A BEHAVIOUR FIX PROVES ITS RED. Gated by kind alone, not by a base: the rule
  # is about the test the diff carries, and a build with no computed base still
  # carries one. Here and not in CLAUDE.shared.md because that file is a fixed
  # cost in every session of every lane, while this paragraph only means
  # something to the one kind whose output is a diff.
  case "$(_brief_kind_for_close)" in
    ""|build)
      preamble="$(printf '%s\n\n%s' "$preamble" 'A BEHAVIOUR FIX SHIPS THE TEST THAT FAILS ON THE OLD CODE. Prove it: revert
the fix, watch that test go red, restore it, watch it go green, and say so in
the commit. An existing expectation that asserts the old behaviour is the
defect written a second time: change it. The one exception is a refactor — it
changes no expectation, and a refactor that does has broken something.')" ;;
  esac
  # THE DESIGN BEFORE THE CODE, where the brief declares a boundary. Before the
  # closing, because it happens first.
  if _design_gate_applies; then
    preamble="$(printf '%s\n\n%s' "$preamble" "$(_design_judgment_note "$(_brief_boundary)")")"
  fi
  # THE CLOSING OF A CODE TASK, gated by _judgment_day_applies above.
  if _judgment_day_applies; then
    preamble="$(printf '%s\n\n%s' "$preamble" "$(_judgment_day_note)")"
  fi
  printf '%s' "$preamble"
}

# The safeguard, extracted for the same reason as _brief_preamble above: a
# re-task delivers a NEW brief, and this text says in its own first line that
# it applies "before acting on the brief".
_brief_epistemic() {
  local epistemic_safeguard
  # A brief is evidence for an executor, not a parser input for hw. Whether a
  # claim is actually measured is epistemic judgement: a heading can be copied,
  # while its source can still be wrong. Refusing on headings would create empty
  # compliance and reject legitimate, evidence-backed prescriptions. State the
  # distinction in the one prompt every brief-backed executor receives instead.
  epistemic_safeguard="$(printf 'BRIEF EPISTEMIC SAFEGUARD — apply this before acting on the brief:\n\nMEASURED: a heading or citation alone is not proof; treat a claim as established\nonly when its named evidence/source supports the exact claim being prescribed. A reader need not independently re-derive already measured work merely because it is prescribed.\n\nUNESTABLISHED: keep open causal or design questions visibly open; do not turn\nthem into facts.\n\nCONSTRAINTS: preserve the stated boundaries, non-regressions and verification\nrequirements.\n\nA prescribed solution is valid only when it rests on MEASURED evidence. If a\nproposed remedy rests on an UNESTABLISHED cause, surface that contradiction and\ndo not ratify the remedy. Legitimate measured prescriptions remain permitted:\npreserve and execute them when their evidence supports them.')"
  printf '%s' "$epistemic_safeguard"
}

# ── the executor's own engram session, registered before it says a word ──
#
# MEASURED 2026-09-22: an executor's `mem_save` with no session of its own is
# routed by engram to `manual-save-<project>`, and for the product lanes
# that row is owned by `brain` (first writer wins, and it was written under
# `brain` long ago). The save is refused: "session project ownership is
# ambiguous: session \"manual-save-<lane>\" has unclassified ownership for
# \"brain\" and cannot accept \"<lane>\"". Reproduced verbatim on 2026-09-22.
# `rescue-ownership` does not fix that row (owned_by_other_project, 0 changes).
#
# THE MECHANISM ENGRAM SUPPORTS: `POST /sessions {id, project, directory}` on the
# running `engram serve` — the same call engram's own Claude Code SessionStart
# hook makes — which the MCP server then selects for a save that names no
# session, by matching the directory against the agent's worktree. Measured the
# same day: after this registration, the same save landed in the registered
# session. Nothing here touches engram.db; `engram serve` is the authority.
#
# WHY hw AND NOT THE VENDOR HOOK: that hook registers the vendor's session under
# the project IT detects from the cwd (git remote or directory name), which is
# not the lane label hw assigns. So the row is hw's, labelled by hw.
#
# BEST EFFORT, AND SAID SO. engram down is a receipt line and a warning, never a
# failed launch: memory is bookkeeping, the brief is the work.
#
# BUT NEVER INTO A STORE THAT IS NOT THE EXECUTOR'S. Measured 2026-09-28: the
# port was held by a serve started under a sandbox HOME, every registration
# answered "created" into that sandbox, and the executors' MCP — which opens
# ~/.engram directly — answered `unknown_session` to the id the preamble gave
# them. So the serve is identified before anything is posted
# (bin/engram-serve.sh), and a foreign one is named, not written to. The
# engram-serve.sh header carries the mechanism and the evidence.
HW_ENGRAM_SESSION=""
_engram_register_session() {
  local id project dir url out verdict lib rc=0
  [ -n "${WT:-}" ] && [ -n "${HW_RUN:-}" ] || return 0
  project="${ENGRAM_PROJECT:-}"; dir="${HW_WORKDIR:-$WT}"
  [ -n "$project" ] || return 0
  id="hw-$HW_RUN"
  lib="${HW_BIN_DIR:-$(dirname "${BASH_SOURCE[0]}")}/engram-serve.sh"
  # A `[ -r ]` and not `. … || return`: bash exits outright on a `.` whose file
  # is missing, whatever guards the statement (measured 2026-09-28).
  if [ ! -r "$lib" ]; then
    _receipt engram_session "none — $lib is missing, so the serve could not be identified" "[ -r $lib ]"
    warn "engram session NOT registered: $lib is missing (incomplete bin/)"
    return 0
  fi
  # shellcheck source=engram-serve.sh
  . "$lib"
  url="$(engram_serve_url)"
  verdict="$(engram_serve_verdict "$url")" || rc=$?
  if [ "$rc" = 2 ]; then
    _receipt engram_session "none — $verdict" "GET $url/health vs $(engram_store_dir)/.instance-id"
    warn "engram session NOT registered: $verdict. Nothing was written to it. Stop that serve and start the real one (HOME=$HOME engram serve); until then an executor's mem_save has no session of its own and may fall into manual-save-$project"
    return 0
  fi
  if [ "$rc" = 0 ] && out="$(engram_session_post "$id" "$project" "$dir" "$url")"; then
    HW_ENGRAM_SESSION="$id"
    _receipt engram_session "$id" "POST $url/sessions project=$project directory=$dir"
    info "engram session $id registered under $project for $dir"
  else
    [ "$rc" = 0 ] || out="$verdict"
    _receipt engram_session "none — POST $url/sessions failed: ${out:-no answer}" "curl -sf -m 5 POST $url/sessions"
    warn "engram session NOT registered ($url unreachable or refused): an unlabelled mem_save may still fall into manual-save-$project"
  fi
  return 0
}

_send_brief() {
  local pane="$1" entry=""
  # Before the brief guard: a brief-less run saves to engram too.
  _engram_register_session
  [ -n "$BRIEF" ] || return 0

  local preamble epistemic_safeguard
  preamble="$(_brief_preamble)"
  BRIEF_TEXT="$(printf '%s\n\n---\n\n%s' "$preamble" "$BRIEF_TEXT")"

  epistemic_safeguard="$(_brief_epistemic)"

  # THE FRAMEWORK ENTRY GOES IN THE PROMPT, not in a reminder to the brainer.
  # An executor handed a brief under speckit that starts editing files
  # has skipped the flow entirely — exploration, proposal, spec — and nothing
  # downstream notices, because the artifacts it produces look like work. So hw
  # prepends the entry command, in the same single submission as the brief: a
  # second `herdr agent prompt` would race the first, and a mid-turn prompt is
  # silently lost (setup/decisions.md, 2026-08-21).
  # DELIBERATELY OUTSIDE THE FLOW. The directory still carries its framework —
  # `--sdd none` cannot park a surface, only stop hw forcing an entry — so the
  # executor lands with the framework's skills loaded and would otherwise
  # have to guess whether it is supposed to run them. On 2026-08-24 one guessed
  # right and it still read, from outside, like a flow abandoned after explore.
  # So the prompt says it outright.
  if [ "$SDD" = none ]; then
    if [ -n "$DISPATCH_FRAMEWORK" ] \
       && [ "$DISPATCH_FRAMEWORK" != "<undetermined>" ]; then
      BRIEF_TEXT="$(printf 'THIS TASK RUNS OUTSIDE THE FRAMEWORK FLOW — chosen, not overlooked.\nThe directory is in %s mode, so its skills are loaded, but this task does not\nenter any part of that framework surface: do NOT run a phase command, review or\nverify flow, or orchestrator preflight. If a loaded skill demands a blocking\npreflight, it does not apply to this task: do not answer it and do not STOP on\nit. There is no change to specify or apply here. Do the work directly and close\nwith done-invoker.\n\n---\n\n%s' \
        "$DISPATCH_FRAMEWORK" "$BRIEF_TEXT")"
    else
      BRIEF_TEXT="$(printf 'THIS TASK RUNS OUTSIDE THE FRAMEWORK FLOW — chosen, not overlooked.\nThe directory framework mode could not be determined, and framework skills may\nstill be loaded, but this task does not enter any part of that surface: do NOT\nrun a phase command, review or verify flow, or orchestrator preflight. If a\nloaded skill demands a blocking preflight, it does not apply to this task: do\nnot answer it and do not STOP on it. There is no change to specify or apply\nhere. Do the work directly and close with done-invoker.\n\n---\n\n%s' \
        "$BRIEF_TEXT")"
    fi
    info "prompt states the flow is deliberately not entered ($DISPATCH_FRAMEWORK mode, --sdd none)"
  fi

  if [ "$SDD" = gentle ]; then
    BRIEF_TEXT="$(printf '%s\n\n---\n\n%s' "$(_gentle_preamble)" "$BRIEF_TEXT")"
    info "prompt states the gentle-ai ODD mode: RDD off, questions through ask-invoker, delivery $GENTLE_DELIVERY"
  elif [ "$DISPATCH_IN_PLAY" = 1 ]; then
    entry="$(_framework_entry "$DISPATCH_FRAMEWORK")"
    if [ -n "$entry" ]; then
      # The phase note goes AFTER the entry line, inside the same block: the
      # entry says where the flow starts, the note says where the task ends.
      local phase_note=""
      [ "$DISPATCH_FRAMEWORK" != speckit ] || phase_note="$(printf '\n\n%s' "$(_speckit_phase_note)")"
      BRIEF_TEXT="$(printf 'FIRST ACTION, before anything else: run %s for this task.\nThe framework mode here is %s and this brief is its input, not a licence to\nstart editing. Do not read code, write files or run tests until %s has run.%s\n\n---\n\n%s' \
        "$entry" "$DISPATCH_FRAMEWORK" "$entry" "$phase_note" "$BRIEF_TEXT")"
      info "prompt prefixed with $entry (framework $DISPATCH_FRAMEWORK is in play)"
    else
      warn "framework is '$DISPATCH_FRAMEWORK' — no single entry command, so the prompt names none"
    fi
  fi

  # This is deliberately last among prompt construction, so it stays before the
  # original brief in every mode and, under Spec Kit, before the FIRST ACTION
  # boundary. A later framework prefix must not let a pre-answered brief
  # cross the flow's entry point before the reader receives this instruction.
  BRIEF_TEXT="$(printf '%s\n\n---\n\n%s' "$epistemic_safeguard" "$BRIEF_TEXT")"

  # THE SESSION ID IS RECORDED ON BOTH PATHS, and the delivery status is passed
  # through untouched.
  #
  # `local drc=0; … || drc=$?` rather than a bare call: the session becomes
  # knowable only after delivery for opencode and codex, so the recording has to
  # come after — and appending a command after `_deliver_brief` would make ITS
  # status the function's, turning a failed delivery into a successful
  # `_send_brief` under `set -euo pipefail`. That is the same class of bug this
  # file already carries two comments about (`&&` lists whose exit status is the
  # test's). A failed delivery still gets a receipt, because "no session, and
  # here is why" is exactly the fact worth keeping when a launch went wrong.
  local drc=0
  _deliver_brief "$pane" || drc=$?
  _receipt_session "$pane" "$drc"
  _receipt_model "$pane" "$drc" || true
  return "$drc"
}

# ONE DELIVERY PATH FOR BRIEFS AND RE-TASKS. This used to be a bare
# `herdr agent prompt`, and on 2026-08-24 an opencode executor (Sol) got the
# brief DRAWN into its input buffer with no Enter pressed. The brief never
# entered the conversation. The brainer then sent a generic "start the brief"
# which opened a turn against an empty context — so the executor was asked to
# begin work it had never been given, and `done-invoker` is a shell command, not
# a tool, so it had no way to even name the problem.
#
# `hw next` had already solved this: it resolves the executor's NATIVE address
# and requires a receipt. The launch path was the asymmetry — the one place still
# trusting a keystroke. Now both use the same channel:
#
#   opencode  → channel-send --require processed. `processed` means a completed
#               assistant response parented to that message: proof the brief
#               entered the conversation, not proof it was typed.
#   otherwise → herdr agent prompt --wait --until working. WITH the wait, because
#               herdr itself returns `agent_prompt_stalled` when a submission is
#               accepted and no state change follows within 5s. hw was calling it
#               without --wait and therefore could not be told.
# Re-ask until the executor's own transport is resolvable, or the budget runs
# out. Returns either way: an unresolved sender is a real state (claude has no
# endpoint at all), so this waits, it does not require.
# WHICH VENDORS HAVE A NATIVE TRANSPORT hw CAN ADDRESS, and the answer is not
# "every vendor channel-send has a branch for".
#
# claude has never had one here: `invoker_resolve_sender` sets its endpoint to
# `-`, and channel-send's claude route refuses any target that is not already in
# a herdr pane. It has always fallen through to herdr, which is why FIVE
# route-selection sites each hand-coded `!= claude` — three on the launch path
# (`_resolve_strong_sender`, `_deliver_brief`, and its replay arm) and two more
# in `cmd_next`, which is a SEPARATE delivery path: `hw next` never calls
# `_deliver_brief`. All five now ask this helper. Converting only the launch
# three would have fixed a codex dispatch and left every codex RE-TASK failing
# on the same dead socket — the shape of a fix that looks complete because the
# path it misses has no test.
#
# CODEX IS THE SECOND, MEASURED 2026-09-06 and never written down before.
# `invoker_resolve_sender` hands every codex pane an endpoint —
# ~/.codex/app-server-control/app-server-control.sock — and, while herdr has
# published no agent_session yet, a session GUESSED from the work directory's
# basename. Neither survives contact:
#
#   · THE SOCKET DOES NOT EXIST. `codex queue --remote unix://` resolves to
#     exactly that path and answers "failed to connect to remote app server at
#     `unix://$HOME/.codex/app-server-control/app-server-control.sock`:
#     No such file or directory". It is created by `codex remote-control start`,
#     an experimental daemon that is not running here and whose own status reads
#     "Remote control is enabled … but the connection is errored".
#   · THE GUESSED NAME DOES NOT RESOLVE EITHER. `codex queue --thread
#     codex-probe-before` against a LIVE codex TUI (pane w7G:p40, holding that
#     exact work directory) answered "No active session found matching
#     'codex-probe-before'". `queue` sees only sessions hosted on the shared
#     app-server daemon, and a TUI started by `herdr agent start` is a plain
#     `codex` process that registers with nothing.
#
# So hw was addressing a route that does not exist. It never got that far:
# channel-send refused the `--id` and `--require processed` hw sends with every
# brief, which is the "codex refused to process the brief (exit 1)" that ended
# every codex dispatch. Fixing only those flags would have swapped an honest
# refusal for a connection error — the brief would still not be delivered.
#
# THE HERDR ROUTE WORKS ON CODEX, and that is measured too: the same brief
# prompted into w7G:p40 with `herdr agent prompt --wait --until working` opened
# a turn and Codex answered with the brief's own word, ALFA-BEFORE.
#
# Restoring a native codex route is real work — a daemon-hosted TUI
# (`codex --remote unix://`) plus `codex remote-control start` — and it is a
# posture decision about an experimental remote-control surface that pairs
# devices, not a transport detail. Deliberately NOT taken here.
_vendor_has_native_transport() {
  case "${1:-}" in
    ""|claude|codex) return 1 ;;
    *) return 0 ;;
  esac
}

_resolve_strong_sender() {
  local pane="$1" waited=0 budget="${HW_SENDER_WAIT_MS:-12000}"
  while :; do
    invoker_resolve_sender "$pane"
    _vendor_has_native_transport "${INVOKER_SENDER_VENDOR:-}" || return 0
    [ -n "${INVOKER_SENDER_SESSION:-}" ] && [ -n "${INVOKER_SENDER_ENDPOINT:-}" ] && {
      [ "$waited" -gt 0 ] && info "$INVOKER_SENDER_VENDOR transport resolved after ${waited}ms — using its causal route, not the terminal buffer"
      return 0
    }
    [ "$waited" -ge "$budget" ] && {
      warn "$INVOKER_SENDER_VENDOR has no resolvable session/endpoint after $((budget / 1000))s"
      # WHAT THIS IS, MEASURED 2026-08-25 — and it is NOT a defect in the
      # executor. OpenCode creates a pane's session LAZILY, on its first turn:
      # a fresh pane launched with `--auto --port N` had an endpoint from its
      # own argv immediately and `agent_session` ABSENT for 40s of polling,
      # then produced one ~4s after the first prompt. `invoker_resolve_sender`
      # needs both, so for the FIRST delivery the causal route cannot exist
      # yet — no budget reaches it, because the message being delivered is
      # what creates the thing being waited for.
      #
      # The message this replaces claimed the opposite and sent brainers
      # hunting a token bug that is not there: "$pane won't publish state
      # tokens, so `hw next` will refuse to re-task it while it reads
      # `blocked`". Measured false. A pane prompted through the terminal
      # buffer published `turns=1` and `turn_state=ended_unreported` exactly
      # like any other; token publication is driven by `session.idle` and does
      # not care which route the prompt arrived on. Re-tasking such an
      # executor needs no special wait.
      warn "falling back to the terminal buffer for this FIRST delivery: OpenCode has no session until a turn opens, so the causal route cannot resolve yet — expected, not a fault. State tokens are unaffected. If the buffer stalls, hw replays the same bytes once over the causal route, which resolves from the first turn on."
      return 0
    }
    sleep 1; waited=$((waited + 1000))
  done
}

_deliver_brief() {
  local pane="$1" bytes route target endpoint rc=0 out
  local codex_before="" codex_proof=0 codex_unproven_reason=""
  bytes="$(printf '%s' "$BRIEF_TEXT" | wc -c | tr -d ' ')"
  # THE EXACT BYTES, hashed before delivery. The field report asks for this by
  # name (C3): a run receipt should be able to answer "was the brief this
  # executor received the brief that was written", and "hw said delivered" has
  # already been shown not to answer it. Hashed here, not at the call site,
  # because the preamble, the framework prefix and the preflight block are all
  # appended above and every one of them changes what actually arrives.
  _receipt brief_sha256 "$(printf '%s' "$BRIEF_TEXT" | shasum -a 256 | cut -d" " -f1)" \
    "shasum -a 256 of the $bytes bytes passed to the delivery route"
  _receipt brief_bytes "$bytes" "wc -c of BRIEF_TEXT at delivery"

  # ── CODEX: READ THE SCREEN AGAIN, BECAUSE READINESS IS NOT A PROPERTY ──────
  #
  # `_agent_start` already calls `_codex_startup_ready`, and that check is
  # correct — it caught the hook-trust dialog on a dispatch measured minutes
  # after this one. It is also a SINGLE READ at one instant, and the dialogs it
  # looks for can render AFTER it: on 2026-09-06 the same binary printed
  # "codex ready in w7G:p40" and the "Hooks need review" dialog was owning stdin
  # by the time the brief was sent. The brief was typed into the dialog and lost
  # without a word.
  #
  # So it is asked once more, immediately before anything is typed, and a
  # blocking dialog REFUSES the delivery instead of feeding it. Nothing is sent,
  # which is the honest outcome: these dialogs wait for a person, and no route,
  # budget or retry answers them. hw does not answer them either — dismissing
  # the hook-review dialog would leave the executor running with an untrusted,
  # INACTIVE repo-write guard, and that is a posture decision, not a delivery
  # detail.
  # The PANE's measured vendor, not $AGENT. $AGENT is what this invocation
  # asked for, and the two are not the same claim: a re-task delivers into a
  # pane somebody else launched, and `hw` has already been bitten once by
  # trusting a requested vendor over a measured one (see the reuse guard in
  # 75-codex-framework-refusal.sh). Ask herdr what is actually there.
  local pane_vendor
  pane_vendor="$(herdr agent get "$pane" 2>/dev/null \
    | jq -r '.result.agent.agent // empty' 2>/dev/null || true)"
  if [ -z "$pane_vendor" ]; then
    # Falling back to what this invocation ASKED for is better than nothing,
    # but it is a different claim and it can be empty too — and an empty vendor
    # silently skips every codex guard below. Say so rather than let a codex
    # pane be delivered to as if it were any other.
    pane_vendor="${AGENT:-}"
    [ -n "$pane_vendor" ] \
      || warn "could not measure $pane's vendor and none was requested — vendor-specific delivery checks are SKIPPED for this delivery"
  fi
  if [ "$pane_vendor" = codex ]; then
    codex_before="$(_codex_thread_id "$pane")"
    [ -n "$codex_before" ] || codex_proof=1
    local codex_dialog=""
    if codex_dialog="$(_codex_dialog_blocking "$pane")"; then
      warn "codex is holding a startup dialog on $pane: $codex_dialog"
      warn "NOTHING was typed — the brief would have landed in that dialog and been lost"
      _receipt brief_admitted "no — codex was holding $codex_dialog at delivery time, nothing typed" \
        "herdr agent read $pane --source detection, read immediately before delivery"
      warn "THE BRIEF IS NOT IN $pane's CONTEXT, and re-sending it is NOT the fix."
      warn "these dialogs wait for a PERSON: no route, no budget and no retry answers them,"
      warn "and channel-send would only push the brief into the same dialog. Clear it on that"
      warn "pane first, then re-deliver:"
      printf '  %s%s%s\n' "$C_DIM" \
        "  $HW_BIN_DIR/channel-send herdr $pane - \"\$(cat $BRIEF)\"" "$C_0"
      return 1
    fi
  fi

  _next_load_invoker_lib
  # WAIT FOR THE STRONG ROUTE BEFORE USING THE WEAK ONE.
  #
  # This is the whole of the 4/4 stall the product-lane orchestrator measured. An
  # opencode executor is reachable over its own HTTP endpoint — a route that
  # returns a causal `processed` receipt — but `invoker_resolve_sender` needs
  # BOTH the agent's session id and a `--port` in its argv, and neither is
  # registered in the instant after `agent start` returns. So the resolve came
  # back empty, delivery fell back to herdr's terminal buffer, and the buffer
  # took the text without an Enter: `agent_prompt_stalled`, every single time.
  #
  # hw was not choosing the weak route. It was asking one moment too early and
  # then treating the answer as final. Bounded, and it costs nothing when the
  # answer is already there — a claude executor has no endpoint to wait for and
  # falls through on the first pass.
  _resolve_strong_sender "$pane"
  if _vendor_has_native_transport "${INVOKER_SENDER_VENDOR:-}" \
     && [ -n "$INVOKER_SENDER_SESSION" ] \
     && [ -n "$INVOKER_SENDER_ENDPOINT" ]; then
    route="$INVOKER_SENDER_VENDOR"
    target="$INVOKER_SENDER_SESSION"
    endpoint="$INVOKER_SENDER_ENDPOINT"
  else
    route=herdr; target="$pane"; endpoint=-
  fi

  # ── OPENCODE'S FIRST DELIVERY DOES NOT HAVE TO GO THROUGH THE BUFFER ────────
  #
  # `_resolve_strong_sender` explains why the causal route cannot exist yet: the
  # message being delivered is what creates the session it would address. What
  # it then did was fall back to herdr's terminal buffer, and the buffer is the
  # route that types without pressing Enter. Measured 4/4 on a product lane, and again
  # on 2026-09-03: `opencode ready`, then `agent_prompt_stalled`, `THE BRIEF IS
  # NOT IN CONTEXT`, `NO SESSION ID` — a pane holding a worktree, a database and
  # a dev server, and no work. The prescribed single re-delivery could not fix
  # it either, because it resolves the same absent session and lands on the same
  # buffer.
  #
  # There is a third route and it was simply not being used. OpenCode's server
  # exposes the TUI's own prompt over HTTP, so hw can put the brief in and
  # submit it WITHOUT a session — submission is the TUI's, not a keystroke, so
  # there is no Enter to lose — and then read back the session the turn created.
  # That last part is also the answer to NO SESSION ID.
  #
  # It is tried BEFORE the buffer and never instead of the causal route: if
  # INVOKER_SENDER_SESSION resolved, the branch above already returned.
  if [ "$route" = herdr ] \
     && [ "${INVOKER_SENDER_VENDOR:-}" = opencode ] \
     && [ -n "${INVOKER_SENDER_ENDPOINT:-}" ]; then
    local tui_cwd tui_rc=0 tui_out tui_sid
    tui_cwd="$(herdr agent get "$pane" 2>/dev/null | jq -r '.result.agent.cwd // empty' 2>/dev/null || true)"
    [ -n "$tui_cwd" ] || tui_cwd="${WT:-}"
    if [ -n "$tui_cwd" ]; then
      info "opencode has no session yet, so the causal route cannot exist — delivering through its own TUI prompt endpoint instead of herdr's buffer"
      tui_out="$("$HW_BIN_DIR/channel-send" --require processed \
                   opencode-tui "$tui_cwd" "$INVOKER_SENDER_ENDPOINT" "$BRIEF_TEXT" 2>&1)" || tui_rc=$?
      tui_sid="$(printf '%s\n' "$tui_out" | sed -n 's/^CHANNEL_SESSION_ID=//p' | tail -1)"
      if [ -n "$tui_sid" ]; then
        HW_TUI_SESSION_ID="$tui_sid"
        _receipt session_id_tui "$tui_sid" \
          "the session the brief's own turn created, read back from $INVOKER_SENDER_ENDPOINT/session?directory=$tui_cwd"
      fi
      if [ "$tui_rc" = 0 ]; then
        _receipt brief_admitted "yes — opencode-tui, turn completed" \
          "channel-send --require processed opencode-tui"
        ok "brief IN THE CONVERSATION on $pane ($bytes bytes, from $BRIEF) — opencode-tui receipt: processed${tui_sid:+, session $tui_sid}"
        return 0
      fi
      # 4 and 5 mean the brief IS in the receiver's session. Falling through to
      # the buffer would deliver it a SECOND time, which is worse than the
      # failure being reported, so those stop here.
      # A HUNG RECEIVER IS NOT A REASON TO TRY THE BUFFER — it is the reason not
      # to. Measured 2026-09-03 on a product-lane task: the executor's
      # endpoint was listening and answering nothing, the TUI route failed, hw
      # fell back to herdr's buffer, and the buffer produced
      # `agent_prompt_stalled` and an executor holding no brief. The SAME
      # opencode process serves the HTTP endpoint and the TUI, so an endpoint
      # that cannot answer is a process that cannot take a prompt either. The
      # fallback did not rescue that delivery, it disguised it.
      if [ "$tui_rc" = 6 ]; then
        warn "opencode-tui: the receiver is UNUSABLE (exit 6) — NOT falling back to the buffer, the same process serves both and the buffer would only hide this as agent_prompt_stalled"
        printf '%s\n' "$tui_out" | head -4 >&2
        _receipt brief_admitted "no — receiver unusable, nothing typed on any route" \
          "channel-send opencode-tui exit 6 (endpoint liveness)"
        _brief_undelivered "$pane" opencode-tui "$tui_cwd" "$INVOKER_SENDER_ENDPOINT"
        return 1
      fi
      case "$tui_rc" in
        4|5)
          warn "opencode-tui: the brief reached the receiver and the turn did not complete (exit $tui_rc) — NOT retrying on the buffer, that would deliver it twice"
          printf '%s\n' "$tui_out" | head -3 >&2
          _receipt brief_admitted "yes — opencode-tui exit $tui_rc: present in the session, turn unconfirmed" \
            "channel-send --require processed opencode-tui"
          _brief_undelivered "$pane" opencode-tui "$tui_cwd" "$INVOKER_SENDER_ENDPOINT"
          return 1 ;;
      esac
      warn "opencode-tui refused or could not deliver (exit $tui_rc) — nothing was typed, falling back to herdr's buffer"
      printf '%s\n' "$tui_out" | head -3 >&2
    fi
  fi

  if [ "$route" != herdr ]; then
    out="$("$HW_BIN_DIR/channel-send" --require processed \
             --id "${HW_RUN:-norun}:brief" \
             "$route" "$target" "$endpoint" "$BRIEF_TEXT" 2>&1)" || rc=$?
    if [ "$rc" = 0 ]; then
      ok "brief IN THE CONVERSATION on $pane ($bytes bytes, from $BRIEF) — $route receipt: processed"
      return 0
    fi
    warn "$route refused to process the brief (exit $rc)"
    printf '%s\n' "$out" | head -3 >&2
    _brief_undelivered "$pane" "$route" "$target" "$endpoint"
    return 1
  fi

  # herdr route. --wait --until working turns "the text was typed" into "a turn
  # opened", which is the only claim worth printing.
  if out="$(herdr agent prompt "$pane" "$BRIEF_TEXT" \
              --wait --until working --timeout "${HW_TURN_WAIT_MS:-45000}" 2>&1)"; then
    if [ "$pane_vendor" = codex ]; then
      _codex_admit "$pane" "a turn opened" "$bytes" && return 0
      _codex_unproven "$pane"
      return 1
    fi
    ok "brief IN THE CONVERSATION on $pane ($bytes bytes, from $BRIEF) — a turn opened"
    return 0
  fi
  case "$out" in
    *agent_prompt_stalled*)
      if [ "$pane_vendor" = codex ]; then
        # The first submission may have landed somewhere Herdr cannot see.
        # Re-read immediately before replay; never type into a newly opened
        # startup dialog or turn a failed replay into proof of non-delivery.
        if codex_dialog="$(_codex_dialog_blocking "$pane")"; then
          _codex_unproven "$pane" "Codex dialog appeared after submission ($codex_dialog); replay was not attempted"
          return 1
        fi
      fi
      warn "herdr did not observe a turn after submission (agent_prompt_stalled)"
      warn "submission is not proof of admission; replay remains subject to the delivery checks below"
      # ONE EXACT REPLAY, AUTOMATICALLY. hw already knew the recovery command and
      # printed it for a human to paste; that ran four times out of four in one
      # product-lane session. Exactly once, and exactly the same bytes — never a
      # generic nudge, which opens a turn against an empty context and is what
      # turned this delivery bug into a wasted session on 2026-08-24.
      _resolve_strong_sender "$pane"
      local r_route r_target r_endpoint r_rc=0 r_out
      if _vendor_has_native_transport "${INVOKER_SENDER_VENDOR:-}" \
         && [ -n "${INVOKER_SENDER_SESSION:-}" ] && [ -n "${INVOKER_SENDER_ENDPOINT:-}" ]; then
        r_route="$INVOKER_SENDER_VENDOR"; r_target="$INVOKER_SENDER_SESSION"
        r_endpoint="$INVOKER_SENDER_ENDPOINT"
        warn "replaying the exact brief once over $r_route (a causal route, unlike the buffer)"
        r_out="$("$HW_BIN_DIR/channel-send" --require processed --id "${HW_RUN:-norun}:brief:replay" \
                 "$r_route" "$r_target" "$r_endpoint" "$BRIEF_TEXT" 2>&1)" || r_rc=$?
      else
        warn "replaying the exact brief once over herdr"
        r_out="$("$HW_BIN_DIR/channel-send" herdr "$pane" - "$BRIEF_TEXT" 2>&1)" || r_rc=$?
        r_route=herdr; r_target="$pane"; r_endpoint=-
      fi
      if [ "$pane_vendor" = codex ]; then
        _codex_admit "$pane" "replay over $r_route returned exit $r_rc" "$bytes" && return 0
        _codex_unproven "$pane" "${codex_unproven_reason:-replay outcome could not be established}"
        return 1
      fi
      if [ "$r_rc" = 0 ] && _turn_opened "$pane"; then
        # Codex was handled above using its own receipt, not this status check.
        _receipt brief_admitted "yes — replayed once over $r_route" \
          "channel-send $r_route + herdr agent get $pane showed a turn"
        ok "brief IN THE CONVERSATION on $pane ($bytes bytes, from $BRIEF) — replayed once over $r_route, turn confirmed"
        return 0
      fi
      warn "the replay did not produce a turn either (exit $r_rc)"
      [ -n "$r_out" ] && printf '%s\n' "$r_out" | head -3 >&2
      _receipt brief_admitted "no — first attempt stalled, replay over $r_route also failed" \
        "herdr agent prompt --until working, then channel-send $r_route"
      ;;
    *agent_blocked*)
      warn "$pane is blocked and refused the submission before any input was sent" ;;
    *)
      if [ "$pane_vendor" = codex ]; then
        # A timeout is not a negative receipt. Codex may already have taken
        # the prompt while herdr was still waiting for its status transition.
        # _codex_admit's unavailable-proof fallback needs a measured turn;
        # on this path only a fresh, wired thread publication can admit it.
        if [ "$codex_proof" = 1 ] && _codex_thread_publisher_wired; then
          _codex_admit "$pane" "herdr prompt failed or timed out" "$bytes" && return 0
        fi
        _codex_unproven "$pane" "herdr prompt failed or timed out; no usable fresh thread proof"
        return 1
      fi
      warn "herdr could not put the brief into $pane: $(printf '%s' "$out" | head -1)" ;;
  esac
  _brief_undelivered "$pane" herdr "$pane" -
  return 1
}

# CODEX'S DELIVERY PROOF IS THE THREAD ID ITSELF.
#
# `--until working` is not enough on codex, MEASURED 2026-09-06. With the
# "Hooks need review" dialog owning stdin, `herdr agent prompt --wait --until
# working` returned agent_status=working, moved on to done — and the brief was
# NOT in the conversation: the input line was empty, no turn had run, and Codex
# never saw a word of it. A dialog eats the keystrokes and herdr's state machine
# cannot tell the difference. That is `_turn_opened`'s blind spot too, so a
# second signal is needed and it must not come from herdr's state.
#
# What cannot be faked is codex's own UserPromptSubmit hook. It fires when a
# prompt is actually SUBMITTED, and bin/codex-channel-session-hook.sh (wired in
# ~/.codex/hooks.json) publishes the thread id to herdr as agent_session. So a
# thread id appearing after delivery is proof that a prompt entered the
# conversation — and it is the SAME field claude and opencode already publish,
# the one `_receipt_session`, `hw receipt` and `hw revive` already read. No
# third convention: the identity codex records is the identity every other
# vendor records.
#
# THE LIMIT, STATED RATHER THAN GLOSSED: this proves A prompt was submitted,
# not WHICH one. It is causal only while the field starts ABSENT, which is the
# first delivery into a fresh pane. Dispatch into a REUSED pane starts with an
# id already published, and codex publishes the same id for every prompt, so a
# non-empty field there proves nothing about this brief. `_codex_admit` writes
# `brief_admitted=unproven — …` and prints the reason for exactly that case: an
# unavailable receipt is recorded as unavailable, not omitted and not upgraded
# to a pass by silence. `hw next` is a different function and never reaches
# here at all — it has its own delivery path, and its route selection is the
# other pair of sites `_vendor_has_native_transport` now owns.
_codex_thread_id() {
  herdr agent get "$1" 2>/dev/null \
    | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true
}

# IS THE PUBLISHER EVEN WIRED? Asked, because the whole proof rests on a hook
# this repository installs and a person can decline.
#
# `bin/codex-channel-session-hook.sh` publishes the thread id from codex's
# UserPromptSubmit. If it is not registered — a fresh machine, an edited
# hooks.json, a CODEX_HOME pointing somewhere else — then no id will EVER
# appear, and a delivery that landed perfectly would be reported as lost. That
# is the same class of false claim as the one this proof exists to prevent,
# pointing the other way, and it is worse: it tells a brainer to re-deliver a
# brief the executor already holds.
#
# So absence of the id is only evidence when the thing that would have produced
# it is present. When it is not, hw says the proof was unavailable and does not
# convert that into a verdict either way.
_codex_thread_publisher_wired() {
  local hooks="${CODEX_HOME:-$HOME/.codex}/hooks.json"
  [ -f "$hooks" ] || return 1
  jq -e '[.hooks.UserPromptSubmit[]?.hooks[]?.command // empty]
         | map(select(test("codex-channel-session-hook"))) | length > 0' \
    "$hooks" >/dev/null 2>&1
}

_codex_prompt_landed() {
  local pane="$1" waited=0 budget="${HW_CODEX_PROMPT_WAIT_MS:-40000}" now
  # A BUDGET THAT IS NOT A NUMBER IS NOT A BUDGET. Left as it arrives, the
  # bound below exits 2, `&&` short-circuits, `return 1` never runs and the loop
  # spins forever inside a delivery — a hang, which this file treats as a
  # first-class defect rather than an operator's own fault.
  case "$budget" in ''|*[!0-9]*) budget=40000 ;; esac
  while :; do
    now="$(_codex_thread_id "$pane")"
    [ -n "$now" ] && { HW_CODEX_THREAD_ID="$now"; return 0; }
    [ "$waited" -ge "$budget" ] && return 1
    sleep 1; waited=$((waited + 1000))
  done
}

# READ-ONLY. `_codex_startup_ready` is the STARTUP check and it deliberately
# answers the directory-trust dialog with an Enter — right at `agent start`,
# wrong at delivery time. Calling it here would make hw answer a dialog and
# then claim, in the same breath, that it typed nothing into the pane. This one
# only looks, so the claim and the code agree.
_codex_dialog_blocking() {
  local screen
  screen="$(herdr agent read "$1" --source detection --lines 80 2>/dev/null || true)"
  case "$screen" in
    *"Hooks need review"*) printf 'hook trust ("Hooks need review")' ; return 0 ;;
    *"Choose how you'd like Codex to proceed"*) printf 'a model migration choice' ; return 0 ;;
    *"Do you trust the contents of this directory"*) printf 'directory trust' ; return 0 ;;
  esac
  return 1
}

# ONE ADMISSION DECISION, SHARED BY EVERY CODEX SUCCESS BRANCH.
#
# It is a function rather than an `if` next to the first `ok` because the first
# version of this change put the proof on the first branch only and left the
# stall-and-replay branch admitting a codex brief on `_turn_opened` — herdr's
# own state, the exact signal documented three paragraphs up as blind to a
# swallowed codex prompt. A proof one branch can walk around is not a proof, so
# there is now one door and both branches go through it.
#
# THREE OUTCOMES, and the middle one is the point:
#   proven      codex published a thread id. Delivered, and addressable.
#   unavailable the proof could not exist here — the publisher is not wired, or
#               this pane already had an id so a new one proves nothing. hw
#               reports the delivery herdr measured and SAYS the receipt is
#               weaker. It does not upgrade it by silence.
#   unproven    the publisher is wired, the field is empty, and hw does not
#               know. NOT reported as delivered and NOT reported as lost:
#               re-sending may duplicate a brief that landed, so the operator is
#               told to look at the pane rather than to retry blindly.
# Reads `codex_proof` and `codex_before` from `_deliver_brief`'s scope, which
# is the one caller, so the "is a proof even possible here" decision is made
# once, before delivery, instead of twice from two branches that could drift.
_codex_admit() {
  local pane="$1" how="$2" bytes="$3" reason=""
  codex_unproven_reason=""
  if [ "${codex_proof:-0}" != 1 ]; then
    reason="this pane had already published thread ${codex_before:-<none recorded>} before delivery, so a thread id proves nothing about THIS brief"
  elif ! _codex_thread_publisher_wired; then
    reason="${CODEX_HOME:-$HOME/.codex}/hooks.json registers no codex-channel-session-hook on UserPromptSubmit, so no thread id can be published for any prompt"
  else
    if _codex_prompt_landed "$pane"; then
      _receipt brief_admitted "yes — codex published thread $HW_CODEX_THREAD_ID after delivery" \
        "$how, then ~/.codex/hooks.json UserPromptSubmit -> bin/codex-channel-session-hook.sh"
      ok "brief IN THE CONVERSATION on $pane ($bytes bytes, from $BRIEF) — $how, and codex published thread $HW_CODEX_THREAD_ID"
      return 0
    fi
    return 1
  fi
  # The caller records one final unproven outcome. In particular, a failed
  # replay supplies no measured turn, so this helper must not invent one.
  codex_unproven_reason="$reason"
  warn "codex's own delivery proof was UNAVAILABLE here: $reason"
  return 1
}

# NOT DELIVERED IS A CLAIM TOO, and hw is not entitled to it here.
#
# `_brief_undelivered` says "the brief is NOT in this executor's context" and
# tells the operator to send it again. That is correct when nothing was typed.
# It is WRONG here: submission may have happened without a usable receipt,
# so the bytes may be in the conversation — and a second delivery would
# then put the brief in twice. Both readings are live and hw cannot separate
# them, so it says so and hands the question to the one instrument that can
# settle it, which is looking at the pane.
_codex_unproven() {
  local pane="$1" reason="${2:-${codex_unproven_reason:-}}"
  if [ -n "$reason" ]; then
    _receipt brief_admitted "unproven — $reason" "thread-id admission not established"
    warn "DELIVERY UNPROVEN on $pane. $reason."
  else
  _receipt brief_admitted "unproven — herdr reported a turn and codex published no thread id within $(( ${HW_CODEX_PROMPT_WAIT_MS:-40000} / 1000 ))s" \
    "herdr agent prompt (turn claimed) vs agent_session still absent, publisher wired"
  warn "DELIVERY UNPROVEN on $pane. herdr reported a turn; codex published no thread id."
  fi
  warn "codex fires UserPromptSubmit on SUBMISSION, so a missing id usually means the bytes"
  warn "went somewhere that is not the conversation — a dialog, or an input line with no Enter."
  warn "It can also mean the id was simply slow. hw cannot tell those apart, so it claims NEITHER."
  warn "DO NOT re-send blindly: if the brief did land, a second delivery duplicates it."
  warn "Read the pane. If it holds no brief, re-deliver it:"
  printf '  %s%s%s\n' "$C_DIM" \
    "  $HW_BIN_DIR/channel-send herdr $pane - \"\$(cat $BRIEF)\"" "$C_0"
  warn "if it is sitting on a dialog, clear that first — no route answers a dialog"
}

# Did a turn actually open? Asked of herdr after the replay, because
# `channel-send` proving admission is not the same fact and this file exists
# because those two were conflated.
_turn_opened() {
  local st
  st="$(herdr agent get "$1" 2>/dev/null | jq -r '.result.agent.agent_status // empty' 2>/dev/null || true)"
  case "$st" in working|done) return 0 ;; *) return 1 ;; esac
}

# WHAT NOT TO DO NEXT, because getting this wrong is what turned a delivery bug
# into a wasted session. The brief is NOT in the executor's context. Telling it
# to "start" opens a turn against nothing — that is exactly what happened on
# 2026-08-24. The only correct next step is to deliver the brief again.
_brief_undelivered() {
  local pane="$1" route="$2" target="$3" endpoint="$4"
  warn "THE BRIEF IS NOT IN $pane's CONTEXT. Nothing was given to this executor."
  warn "do NOT tell it to start, and do NOT send a generic nudge — it has nothing"
  warn "to read, and no way to tell you so. Re-deliver the brief itself:"
  if [ "$route" = herdr ]; then
    printf '  %s%s%s\n' "$C_DIM" \
      "  $HW_BIN_DIR/channel-send herdr $pane - \"\$(cat $BRIEF)\"" "$C_0"
  else
    printf '  %s%s%s\n' "$C_DIM" \
      "  $HW_BIN_DIR/channel-send --require processed --id ${HW_RUN:-norun}:brief:retry $route $target $endpoint \"\$(cat $BRIEF)\"" "$C_0"
  fi
  warn "if that fails too, close the run with \`hw done\` and dispatch again —"
  warn "an executor holding no brief is not behind, it is empty"
}


# The worktree and branch as GIT sees them, not as hw meant them. `hw` has told
# three lanes it created a worktree at a path it did not use, and told all of
# them `--here` created none while it created one.
_receipt_worktree() {
  local wt="$1" top br
  top="$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$top" ] || return 0
  _receipt worktree "$top" "git -C $wt rev-parse --show-toplevel"
  br="$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [ -n "$br" ] && _receipt branch "$br" "git -C $wt rev-parse --abbrev-ref HEAD"
  return 0
}

# Herdr reports terminal recognition, not vendor runtime readiness. Even the
# combination true:idle has been observed with a rejected model. Preserve that
# observation without promoting it into proof that the runtime can work.
_agent_ready_state() {
  local j ready st
  j="$(herdr agent get "$1" 2>/dev/null || true)"
  ready="$(printf '%s' "$j" | jq -r '.result.agent.interactive_ready // empty' 2>/dev/null || true)"
  st="$(printf '%s' "$j" | jq -r '.result.agent.agent_status // empty' 2>/dev/null || true)"
  [ -n "$ready$st" ] || { printf 'unknown — herdr state unreadable; runtime readiness unestablished'; return 0; }
  case "$ready:$st" in
    true:idle|true:working|true:done) printf 'unknown — runtime readiness unestablished; herdr interactive_ready=%s agent_status=%s' "$ready" "$st" ;;
    *) printf 'no — interactive_ready=%s agent_status=%s' "${ready:-?}" "${st:-?}" ;;
  esac
}

# ── Run receipts ────────────────────────────────────────────────────────────
#
# THE MANIFEST STATES INTENT. THIS STATES WHAT HAPPENED.
#
# Every friction reported on 2026-08-24, across three lanes, was one shape: a
# claim derived from a signal that does not carry it. Transport exit status ->
# "it executed". `git status` clean -> "the worktree is disposable". An observed
# `idle` -> "the message arrived". `--model terra` parsed -> "model=terra
# (chosen)". `$HERE` -> "no worktree", in three fields at once, while the lane
# built one.
#
# They share a cause: hw reports what it was ASKED for. The dispatch manifest is
# excellent at that and all three lanes named it as the thing to keep — but an
# intended value is not a postcondition, and nothing was writing down what was
# actually observed. So each fact here carries the COMMAND THAT PRODUCED IT, and
# a fact with no source does not get written.
#
#   .hw/<run>/receipt.jsonl   one JSON object per line, append-only
#     {"key","value","source","at"}
#
# Read it with `hw receipt <project> <task>`. `_receipt_verdict` compares the
# measured values against what the manifest intended and names any divergence,
# which is the whole point: the two can now disagree out loud.
# The writer, addressed by run directory. `_receipt` is the launch-time caller
# that knows the directory from $WT/$HW_RUN; `hw done` runs long after those
# globals are gone and passes the directory it resolved, so both write the same
# file through the same refusal.
_receipt_into() {
  local dir="$1" key="$2" val="$3" src="${4:-}"
  [ -n "$dir" ] || return 0
  # A fact with no stated source is an assertion, and assertions are what this
  # file exists to replace. Refuse it rather than record it.
  [ -n "$src" ] || { warn "internal: receipt '$key' has no source; not recorded"; return 0; }
  mkdir -p "$dir" 2>/dev/null || return 0
  jq -nc --arg k "$key" --arg v "$val" --arg s "$src" \
     --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
     '{key:$k, value:$v, source:$s, at:$t}' >> "$dir/receipt.jsonl" 2>/dev/null || true
}

_receipt() {
  local key="$1" val="$2" src="${3:-}"
  [ -n "${WT:-}" ] && [ -n "${HW_RUN:-}" ] || return 0
  _receipt_into "$WT/.hw/$HW_RUN" "$key" "$val" "$src"
}

# Read one measured value back out of the current run's receipt.
_receipt_get() {
  local key="$1" dir="$WT/.hw/$HW_RUN"
  [ -r "$dir/receipt.jsonl" ] || return 1
  jq -r --arg k "$key" 'select(.key==$k) | .value' "$dir/receipt.jsonl" 2>/dev/null | tail -1
}

# A tree diff can establish that bytes differ, never who wrote them. Output is
# executor testimony, explicitly labelled as such; hw stores it durably and
# compares it with the brainer's index. `none` and `outside` are truthful,
# distinct negatives, not empty success values.
_output_run_dir() {
  [ -n "${HW_WORKDIR:-}" ] && [ -n "${HW_RUN:-}" ] && [ -n "${HW_PROJECT:-}" ] && [ -n "${HW_TASK:-}" ] \
    || die "hw output needs HW_WORKDIR, HW_RUN, HW_PROJECT and HW_TASK from an hw executor; it will not guess a run"
  [ -d "$HW_WORKDIR/.hw/$HW_RUN" ] \
    || die "hw output found no run directory at $HW_WORKDIR/.hw/$HW_RUN; it will not invent an attribution record"
  printf '%s' "$HW_WORKDIR/.hw/$HW_RUN"
}

cmd_output() {
  local kind="${1:-}" rundir top p writer
  shift || true
  rundir="$(_output_run_dir)"
  writer="$HW_PROJECT:$HW_TASK run $HW_RUN"
  case "$kind" in
    tree)
      [ $# -gt 0 ] || die "usage: hw output tree <relative-path>... | hw output none | hw output outside <locator>"
      top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
      [ -n "$top" ] || die "hw output tree must run from the repository it edited; use 'cd <tree> && hw output tree <relative-path>...'"
      top="$(cd -P "$top" && pwd)"
      _receipt_into "$rundir" output_writer "$writer" "executor declaration via hw output"
      _receipt_into "$rundir" output_tree_root "$top" "git rev-parse --show-toplevel at executor declaration"
      for p in "$@"; do
        case "$p" in
          ""|/*|../*|*/../*|.|..|.hw|.hw/*|*$'\n'*) die "hw output tree path must be a non-.hw relative path without '..' or newlines: $p" ;;
        esac
        _receipt_into "$rundir" output_tree_path "$p" "executor declaration via hw output (not tree-derived)"
      done
      ok "recorded executor-declared tree output for $writer; a brainer checks it with hw stage"
      ;;
    none)
      [ $# -eq 0 ] || die "usage: hw output none"
      _receipt_into "$rundir" output_writer "$writer" "executor declaration via hw output"
      _receipt_into "$rundir" output_tree "none — executor declared no repository-tree output" "executor declaration via hw output"
      ok "recorded no repository-tree output for $writer"
      ;;
    outside)
      [ $# -gt 0 ] || die "usage: hw output outside <locator>"
      _receipt_into "$rundir" output_writer "$writer" "executor declaration via hw output"
      _receipt_into "$rundir" output_external "outside-tree — $*" "executor declaration via hw output"
      ok "recorded outside-tree output for $writer; it cannot attribute staged files"
      ;;
    *) die "usage: hw output tree <relative-path>... | hw output none | hw output outside <locator>" ;;
  esac
}

# Commit-time surface: it reads the index and declarations only. It never
# derives authorship from a tree snapshot. Zero or several writers fail closed.
cmd_stage() {
  local top path receipt writer matches result=0 any=0
  local -a receipts=()
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$top" ] || die "hw stage must run inside the repository whose index is being reviewed"
  top="$(cd -P "$top" && pwd)"
  shopt -s nullglob
  receipts=("$WORK"/*/*/.hw/*/receipt.jsonl "$top"/.hw/*/receipt.jsonl)
  shopt -u nullglob
  printf 'staged work in %s (executor declarations, not tree-derived authorship)\n' "$top"
  while IFS= read -r -d '' path; do
    any=1; matches=""
    for receipt in "${receipts[@]}"; do
      [ -r "$receipt" ] || continue
      if jq -esr --arg root "$top" --arg path "$path" '
          (any(.[]; .key == "output_tree_root" and .value == $root)) and
          (any(.[]; .key == "output_tree_path" and .value == $path))
        ' "$receipt" >/dev/null 2>&1; then
        writer="$(jq -sr '[.[] | select(.key == "output_writer")][-1].value // "unknown executor"' "$receipt" 2>/dev/null || true)"
        case $'\n'$matches$'\n' in *$'\n'$writer$'\n'*) ;; *) matches="${matches}${matches:+$'\n'}$writer" ;; esac
      fi
    done
    case "$matches" in
      "") printf '  UNATTRIBUTED  %s\n' "$path"; result=1 ;;
      *$'\n'*) printf '  AMBIGUOUS    %s\n%s\n' "$path" "$(printf '%s\n' "$matches" | sed 's/^/    claimed by: /')"; result=1 ;;
      *) printf '  claimed by %s  %s\n' "$matches" "$path" ;;
    esac
  done < <(git diff --cached --name-only -z)
  [ "$any" = 1 ] || printf '  no staged paths\n'
  [ "$result" = 0 ] || {
    warn "do not commit attribution guesses: declare each executor's tree paths with hw output, or separate the overlapping work"
    return 1
  }
}

# ── the session id: what makes a conversation addressable afterwards ────────
#
# MEASURED 2026-08-26: the conversations `hw unstick` replaces were never lost.
# `opencode session list` in the work directory of two "lost" runs showed both,
# and `opencode export ses_fc0bac363ffeHqKj657cIJEair` returned the full
# transcript of a session whose pane had been restarted hours earlier. What was
# missing was the ID: `rg 'ses_'` over all 94 runs' receipt.jsonl and .hw/*/env
# returned NOTHING. The brainer recovered those two by matching TITLES, which is
# guessing, and the reason anybody wanted an `hw resume` verb.
#
# So this is the whole fix, and deliberately not a verb (a recorded ruling
# against one: it would reconstruct four things it cannot verify — worktree,
# ports, database, tab record — three of which `hw done` destroys on purpose).
# A recorded id plus the vendor's own resume is enough.
#
# ONE FIELD, THREE VENDORS. All three publish into
# `.result.agent.agent_session.value`, so this reads one place, not three:
#
#   claude    a UUID, source herdr:claude, present from `agent start`. It is
#             also the transcript filename:
#             ~/.claude/projects/<slug>/<uuid>.jsonl — verified for this run's
#             own id. `claude --resume <uuid>` reaches it.
#   opencode  ses_…, source herdr:opencode, and LAZY: a pane has no session
#             until its first turn opens. `_resolve_strong_sender` already
#             documents this — measured absent for 40s of polling on a fresh
#             pane, produced ~4s after the first prompt. `opencode --session
#             <id>` continues it; `opencode export <id>` reads it.
#   codex     a UUID thread id, published by bin/codex-channel-session-hook.sh
#             on UserPromptSubmit — so also only once a prompt has been sent.
#             `codex resume <uuid>`; the rollout is
#             ~/.codex/sessions/<Y>/<M>/<D>/rollout-*-<uuid>.jsonl.
#
# WHEN IT BECOMES KNOWABLE IS THEREFORE AFTER THE BRIEF, NOT AT DISPATCH — for
# two of the three vendors the message being delivered is what creates the
# thing being recorded. Recording an empty field at dispatch and calling it done
# would put the same shape of false fact in the receipt that this file exists to
# keep out. So the caller is `_send_brief`, after delivery, and this polls a
# short budget for the lazy vendors.
#
# AND AN ABSENCE IS RECORDED AS AN ABSENCE. A run where no session ever resolves
# gets `none — <why>`, never "" — an empty value reads as success to every
# consumer, and `jq` cannot tell "not measured" from "measured empty".
_receipt_session() {
  local pane="$1" drc="${2:-0}" waited=0 budget="${HW_SESSION_WAIT_MS:-15000}"
  local info sid vendor src resume
  [ -n "${WT:-}" ] && [ -n "${HW_RUN:-}" ] || return 0
  [ -n "$pane" ] || return 0
  src="herdr agent get $pane | jq -r .result.agent.agent_session.value"
  while :; do
    info="$(herdr agent get "$pane" 2>/dev/null || true)"
    sid="$(printf '%s' "$info" | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true)"
    vendor="$(printf '%s' "$info" | jq -r '.result.agent.agent_session.agent // .result.agent.agent // empty' 2>/dev/null || true)"
    [ -n "$sid" ] && break
    [ "$waited" -ge "$budget" ] && break
    sleep 1; waited=$((waited + 1000))
  done
  # THE DELIVERY ROUTE ALREADY READ THIS ID, so an absence here is no longer
  # automatically an absence. `opencode-tui` finds the session by asking the
  # endpoint which session the brief's own turn landed in; herdr's
  # `agent_session` is a second, slower publisher of the same fact. When herdr
  # has not caught up, the measured id is still a measured id — recorded as
  # what it is, with the route that read it named as its source.
  if [ -z "$sid" ] && [ -n "${HW_TUI_SESSION_ID:-}" ]; then
    sid="$HW_TUI_SESSION_ID"
    vendor=opencode
    src="channel-send opencode-tui: the session the brief's turn landed in, read from the executor's own endpoint (herdr published no agent_session within $((budget / 1000))s)"
  fi
  if [ -z "$sid" ]; then
    # NOT an empty string. This is the fact, and it is a real outcome: a brief
    # whose delivery failed never opened the turn that would have created the
    # session, and an opencode pane can sit `blocked` with agent_session null
    # (measured: w3Z:p1T, 2026-08-26).
    _receipt session_id \
      "none — ${vendor:-the agent} published no agent_session within $((budget / 1000))s after brief delivery (delivery exit $drc)" \
      "$src returned empty on every poll"
    warn "NO SESSION ID: this conversation is not addressable after the fact. If it needs recovering, nothing but its title identifies it."
    return 0
  fi
  _receipt session_id "$sid" "$src, ${waited}ms after brief delivery"
  _receipt session_vendor "${vendor:-unknown}" \
    "herdr agent get $pane | jq -r .result.agent.agent_session.agent"
  # The payoff, spelled out rather than left to be reconstructed. The cwd
  # matters: opencode resolves a session against the directory it ran in.
  case "$vendor" in
    claude)   resume="cd $WT && claude --resume $sid" ;;
    opencode) resume="cd $WT && opencode --session $sid   # read-only: opencode export $sid" ;;
    codex)    resume="cd $WT && codex resume $sid" ;;
    *)        resume="unknown vendor '${vendor:-}' — no resume command is claimed for it" ;;
  esac
  _receipt session_resume "$resume" \
    "the vendor's own documented resume for session_vendor=${vendor:-unknown}"
  info "session $sid recorded — this conversation stays addressable: hw receipt $PROJ $TASK"
}

# ── the model that RUNS, read from the session — not the one that was asked ──
#
# MEASURED 2026-09-28: three identical launches with `--model sonnet` (Claude
# Code 2.1.284, personal account) ran claude-sonnet-5 (15:39) and
# claude-sonnet-5-5 (15:51, 15:51) — the `"model":` of each session's jsonl.
# `hw` printed `model=sonnet (chosen)` for all three, and nobody knew until the
# statusline showed it. An alias is the vendor's to resolve; what hw wrote down
# was its own INTENT. This is the postcondition: the model the session's own
# record says answered, with the file it was read from as the source.
#
#   claude    the last non-synthetic assistant `message.model` in
#             <config dir>/projects/*/<session id>.jsonl (the id is the
#             filename; the project slug is not re-derived, because Claude
#             Code's slug rule is not ours to duplicate).
#   opencode  `opencode export <session>` -> assistant info providerID/modelID.
#             Written to a FILE first: piped, the export truncates a large
#             session mid-string (measured, 476 KB, 2026-09-28).
#
# WHEN: the first assistant turn exists only after the brief, so this follows
# `_receipt_session` and polls a short budget (HW_MODEL_WAIT_MS). A model that
# could not be read is recorded as `none — <why>`, never "" — an empty value
# reads as success — and said out loud as UNESTABLISHED.
#
# WHAT IT COMPARES: the id the vendor was handed (MODEL_PINNED, else MODEL).
#   full id / provider-model  must match EXACTLY
#   claude alias              cannot be checked beyond its family: an alias the
#                             lane does not pin is recorded with what it
#                             resolved to and said not to be a contract; a
#                             different family is a DIVERGENCE
#   nothing asked             recorded, nothing to compare
_receipt_model() {
  local pane="${1:-}" drc="${2:-0}" waited=0 budget="${HW_MODEL_WAIT_MS:-30000}"
  local sid asked running="" why="" cfg f verdict tmp src=""
  [ -n "${WT:-}" ] && [ -n "${HW_RUN:-}" ] || return 0
  [ "$drc" = 0 ] || budget=0
  asked="${MODEL_PINNED:-${MODEL:-}}"
  sid="$(_receipt_get session_id || true)"
  # A vendor with no reader (codex) is not a fault: nothing was measured and
  # nothing is claimed, so it neither warns nor spoils the launch verdict.
  case "${AGENT:-}" in
    claude|opencode) : ;;
    *)
      _receipt model_running "n/a — hw has no model reader for vendor ${AGENT:-unknown}" "_receipt_model: no reader for this vendor"
      _receipt model_verdict "n/a — nothing measured for vendor ${AGENT:-unknown}; asked: ${asked:-<agent default>}" "_receipt_model: no reader for this vendor"
      return 0 ;;
  esac
  case "$sid" in
    ''|none*) why="no session id was recorded, so there is no session to read the model from" ;;
    *)
      while :; do
        case "${AGENT:-}" in
          claude)
            cfg="${ACCOUNT_CONFIG_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}"
            f=""
            for f in "$cfg"/projects/*/"$sid".jsonl; do [ -r "$f" ] && break; f=""; done
            if [ -n "$f" ]; then
              running="$(jq -r 'select(.type=="assistant") | .message.model // empty | select(. != "<synthetic>")' "$f" 2>/dev/null | tail -1 || true)"
              src="the last assistant message.model in $f"
            else
              src="no $cfg/projects/*/$sid.jsonl"
            fi ;;
          opencode)
            tmp="$(mktemp "${TMPDIR:-/tmp}/hw-model.XXXXXX")"
            ( cd "$WT" 2>/dev/null; opencode export "$sid" > "$tmp" 2>/dev/null ) || true
            running="$(jq -r '[.messages[]?.info | select(.role=="assistant" and .modelID != null) | "\(.providerID)/\(.modelID)"] | last // empty' "$tmp" 2>/dev/null || true)"
            rm -f "$tmp"
            src="opencode export $sid, the last assistant providerID/modelID" ;;
          *) break ;;
        esac
        [ -n "$running" ] && break
        [ "$waited" -ge "$budget" ] && break
        sleep 1; waited=$((waited + 1000))
      done
      [ -n "$running" ] || why="${src:-nothing read} — no assistant turn carried a model within $((budget / 1000))s" ;;
  esac
  if [ -z "$running" ]; then
    _receipt model_running "none — $why" "${src:-_receipt_session recorded no session}"
    _receipt model_verdict "UNESTABLISHED — the model that runs could not be read ($why); asked: ${asked:-<agent default>}" "no session record to compare"
    warn "UNESTABLISHED  model: could not read the model this executor runs — asked ${asked:-<agent default>}. $why"
    return 0
  fi
  _receipt model_running "$running" "$src"
  if [ -z "$asked" ]; then
    verdict="recorded — no --model was given, so the vendor's default ran"
  else
    case "$asked" in
      fable|opus|sonnet|haiku)
        case "$running" in
          claude-"$asked"*) verdict="unpinned — the alias $asked resolved to $running; ${PROJ:-this lane} does not pin it (model_pins in projects.json), so the same command can run another model tomorrow"
            warn "model: alias $asked is not pinned by ${PROJ:-this lane} — it resolved to $running today, and nothing keeps it there" ;;
          *) verdict="DIVERGENCE — asked the alias $asked, the session runs $running" ;;
        esac ;;
      *)
        if [ "$running" = "$asked" ]; then verdict="match — asked $asked${MODEL_PINNED:+ (pinned from the alias ${MODEL})}, running $running"
        else verdict="DIVERGENCE — asked $asked${MODEL_PINNED:+ (pinned from the alias ${MODEL})}, the session runs $running"; fi ;;
    esac
  fi
  _receipt model_verdict "$verdict" "compared MODEL_PINNED/MODEL with model_running"
  case "$verdict" in
    DIVERGENCE*) warn "DIVERGENCE  model: ${verdict#DIVERGENCE — }" ;;
  esac
  return 0
}

# INTENDED vs MEASURED, printed at the end of a launch. Divergence here is not a
# warning about the future — it is a statement that the dispatch manifest, which
# has already been printed and toasted to the operator, is describing something other
# than what exists.
_receipt_verdict() {
  local diverged=0 unestablished=0 m
  # worktree: the axis said whether there should be one; git says whether there is
  m="$(_receipt_get worktree || true)"
  if [ "${WANT_WT:-1}" = 1 ] && [ -z "$m" ]; then
    warn "DIVERGENCE  worktree: the manifest said one would be created, and none was measured"; diverged=1
  elif [ "${WANT_WT:-1}" = 0 ] && [ -n "$m" ]; then
    warn "DIVERGENCE  worktree: the manifest said none, and $m exists"; diverged=1
  fi
  # database: same question, for the field that used to say `yes` everywhere
  if [ "${WANT_WT:-1}" = 1 ] && [ "${WANT_DB:-1}" = 1 ] && [ "$(lane_get "$PROJ" db_provisioned)" = 1 ]; then
    m="$(_receipt_get database || true)"
    [ -n "$m" ] || { warn "DIVERGENCE  database: the manifest said own-per-worktree, and none was measured"; diverged=1; }
  fi
  # the agent: `hw` used to report a launch as fine when the CLI never started
  m="$(_receipt_get agent_ready || true)"
  case "$m" in
    yes) ;;
    unknown*|unreadable) warn "UNESTABLISHED  agent: $AGENT ($m)"; unestablished=1 ;;
    "")  warn "DIVERGENCE  agent: nothing measured whether $AGENT ever became ready"; diverged=1 ;;
    *)   warn "DIVERGENCE  agent: $AGENT did not reach interactive_ready ($m)"; diverged=1 ;;
  esac
  # the model: what the session's own record says ran, against what was handed
  # to the vendor. Absent (an old run, or a vendor with no reader) is not a fault.
  m="$(_receipt_get model_verdict || true)"
  case "$m" in
    DIVERGENCE*)   warn "DIVERGENCE  model: ${m#DIVERGENCE — }"; diverged=1 ;;
    UNESTABLISHED*) warn "UNESTABLISHED  model: ${m#UNESTABLISHED — }"; unestablished=1 ;;
  esac
  # the effort: an opencode --effort is a claim until the live config says so
  if [ "$AGENT" = opencode ] && [ -n "${EFFORT:-}" ]; then
    m="$(_receipt_get effort_applied || true)"
    case "$m" in
      yes*) ;;
      no*) warn "DIVERGENCE  effort: the manifest carried $EFFORT and the live executor does not have it ($m)"; diverged=1 ;;
      *)   warn "UNESTABLISHED  effort: ${m:-never read back from the live executor}"; unestablished=1 ;;
    esac
  fi
  if [ "$diverged" = 0 ] && [ "$unestablished" = 0 ]; then
    ok "receipt: every measured value matches the dispatch manifest"
  elif [ "$diverged" != 0 ]; then
    warn "the dispatch manifest above describes something other than what exists"
    warn "read the measurements: hw receipt $PROJ $TASK"
  else
    warn "receipt: incomplete — runtime readiness was not established; no runtime rejection was observed by this check"
  fi
  info "receipt: $WT/.hw/$HW_RUN/receipt.jsonl"
}

# ── Launch rollback ─────────────────────────────────────────────────────────
#
# A launch that dies halfway used to leave everything it had already built. On
# 2026-08-24 an over-long task name built a worktree, installed 953 packages,
# allocated two ports and opened three panes before herdr rejected the agent
# name; the final `hw reap <lane>` found 17 worktrees and ZERO safe to remove.
# That failure mode is closed on argv (see `_check_task`), but any later step
# can still fail — and a DB that refuses to provision is now one of them.
#
# ONLY what THIS launch created. The flags are set at the point of creation and
# stay 0 on the reuse paths, because `git worktree remove` destroys gitignored
# content and `git status` reports a worktree holding ignored data as clean —
# the exact trap `hw done` was taught not to walk into. A worktree that existed
# before this command is never touched, whatever went wrong afterwards.
#
# Safe by construction on the paths where it DOES fire: the worktree is seconds
# old, so the only ignored content in it is what hw itself just copied.
LAUNCH_WT=""; LAUNCH_WT_CREATED=0
LAUNCH_BRANCH=""; LAUNCH_BRANCH_CREATED=0
_launch_rollback() {
  local main="$1" removed=0
  [ "$LAUNCH_WT_CREATED" = 1 ] || {
    [ -n "$LAUNCH_WT" ] && info "worktree $LAUNCH_WT existed before this command — left untouched"
    return 0
  }
  warn "rolling back what this launch created"
  if git -C "$main" worktree remove --force "$LAUNCH_WT" >/dev/null 2>&1; then
    ok "removed worktree $LAUNCH_WT"; removed=1
  else
    warn "could not remove $LAUNCH_WT — remove it by hand:"
    warn "  git -C $main worktree remove --force $LAUNCH_WT"
  fi
  if [ "$LAUNCH_BRANCH_CREATED" = 1 ] && [ -n "$LAUNCH_BRANCH" ]; then
    if [ "$removed" = 1 ] && git -C "$main" branch -D "$LAUNCH_BRANCH" >/dev/null 2>&1; then
      ok "deleted branch $LAUNCH_BRANCH"
    else
      warn "branch $LAUNCH_BRANCH was created by this launch and is still there:"
      warn "  git -C $main branch -D $LAUNCH_BRANCH"
    fi
  fi
  # Ports are picked, not held — nothing to free. No pane exists yet: every
  # caller of this function dies before step 6/7.
}

# ── Interactive mode ────────────────────────────────────────────────────────
# `hw` with no arguments. Lists every brief in brain/, plus an entry to author a
# new one. Chosen deliberately over a menu of projects-then-tasks: the brief IS
# the unit of work, so the brief list is the natural index.
_interactive() {
  command -v fzf >/dev/null 2>&1 || die "fzf not installed — brew install fzf"
  [ -d "$BRAIN" ] || die "no brain at $BRAIN"

  local rows="" proj f name first
  for proj in $HW_LANES; do
    [ -d "$BRAIN/$proj/briefs" ] || continue
    for f in "$BRAIN/$proj/briefs"/*.md; do
      [ -e "$f" ] || continue
      name="$(basename "$f" .md)"
      # First non-empty, non-heading-marker line, as a one-line summary.
      # `|| true`: grep exits 1 on an empty file, the assignment inherits it, and
      # set -e used to kill the picker before it ever drew — for every project,
      # because of one empty brief anywhere.
      first="$(grep -m1 -v '^[[:space:]]*$' "$f" 2>/dev/null | sed 's/^#* *//' | cut -c1-60 || true)"
      [ -n "$first" ] || first="(empty)"
      rows="$rows$proj\t$name\t$first\n"
    done
  done
  rows="$rows+ new brief\t\t(author one from BRIEF-TEMPLATE.md)\n"

  local pick
  pick="$(printf "$rows" | column -t -s "$(printf '\t')" \
          | fzf --height=40% --reverse --prompt='task > ' \
                --header='enter = launch    ctrl-c = cancel')" || exit 0
  [ -n "$pick" ] || exit 0

  if printf '%s' "$pick" | grep -q '^+ new brief'; then
    _new_brief
    return
  fi

  local sel_proj sel_task
  sel_proj="$(printf '%s' "$pick" | awk '{print $1}')"
  sel_task="$(printf '%s' "$pick" | awk '{print $2}')"
  [ -n "$sel_task" ] || die "could not parse the selection"
  info "launching $sel_proj / $sel_task"
  exec "$0" "$sel_proj" "$sel_task"
}

# Author a brief, then launch it. The file is created in brain/, never in a repo.
_new_brief() {
  local proj task file ed
  proj="$(printf '%s\n' $HW_LANES | fzf --height=20% --reverse --prompt='project > ')" || exit 0
  [ -n "$proj" ] || exit 0
  printf 'task name (kebab-case): '
  read -r task
  [ -n "$task" ] || die "no task name given"
  case "$task" in */*|"") die "task must be a bare name: $task" ;; esac

  file="$BRAIN/$proj/briefs/$task.md"
  if [ -e "$file" ]; then
    warn "brief already exists, opening it: $file"
  else
    mkdir -p "$(dirname "$file")"
    # A project may carry its own template; fall back to the shared one.
    tpl="$BRAIN/$proj/BRIEF-TEMPLATE.md"
    [ -f "$tpl" ] || tpl="$BRAIN/BRIEF-TEMPLATE.md"
    sed "s/<task-name>/$task/" "$tpl" > "$file"
    ok "created $file"
  fi

  ed="${VISUAL:-${EDITOR:-vi}}"
  "$ed" "$file"

  # An untouched template is a brief nobody wrote; launching on it would hand
  # the agent a page of angle brackets.
  if ! grep -qv -e '^[[:space:]]*$' -e '^#' -e '^<' -e '^- <' -e '^- \[ \] <' "$file"; then
    warn "brief still looks like the untouched template — launching anyway"
  fi
  exec "$0" "$proj" "$task" --brief "$file"
}

# The newest run's ownership record of the given kind (tab | workspace), or
# empty. Newest first, because a task re-dispatched after `hw done` leaves the
# older run's record behind and closing by the stale id would report success
# having closed nothing.
_latest_run_record() {
  local proj="$1" task="$2" kind="$3" base rundir val
  base="$(_lane_wt_dir "$proj" "$task")"
  [ -n "$base" ] || base="$WORK/$proj/$task"
  [ -d "$base/.hw" ] || return 0
  while IFS= read -r rundir; do
    [ -n "$rundir" ] || continue
    [ -r "$rundir/$kind" ] || continue
    val="$(tr -d '[:space:]' < "$rundir/$kind" 2>/dev/null || true)"
    if [ -n "$val" ]; then printf '%s' "$val"; return 0; fi
  done < <(fd -H -t d -d 1 '^2[0-9]{7}-[0-9]{6}-[0-9]+$' "$base/.hw" 2>/dev/null | sort -r)
  return 0
}

# ── done ────────────────────────────────────────────────────────────────────
# ── hw receipt ──────────────────────────────────────────────────────────────
#
# What was MEASURED for a task, newest run first, with the command that produced
# each fact. The dispatch manifest (`.hw/<run>/dispatch`) says what was asked
# for; this says what was found. When they disagree, the disagreement is the
# answer.
cmd_receipt() {
  local proj="$1" task="$2" wt runs r n=0
  lane_known "$proj" || die "unknown project: $proj (expected: $(lane_names_bar))"
  wt="$(_lane_wt_dir "$proj" "$task")"
  [ -n "$wt" ] || wt="$WORK/$proj/$task"
  # A --worktree none task in a repo lane lives in the repo-less work directory,
  # so look there too rather than reporting "no runs" for a task that ran.
  [ -d "$wt/.hw" ] || wt="$WORK/$proj/$task"
  [ -d "$wt/.hw" ] || die "no hw runs for $proj:$task (looked in $wt/.hw)"

  runs="$(ls -1t "$wt/.hw" 2>/dev/null || true)"
  [ -n "$runs" ] || die "no runs under $wt/.hw"
  printf '\n'
  for r in $runs; do
    [ -r "$wt/.hw/$r/receipt.jsonl" ] || continue
    # If this old executor still carries a report that landed at the wrong
    # brainer, reading the lane receipt saves it before rendering. The next read
    # works after that pane is gone.
    _snapshot_done_report "$wt/.hw/$r"
    n=$((n + 1))
    printf '  %s%s%s  %s\n' "$C_B" "$r" "$C_0" "$wt/.hw/$r/receipt.jsonl"
    jq -r '"    \(.key)\u0009\(.value)\n      \u001b[2mmeasured by: \(.source)\u001b[0m"' \
      "$wt/.hw/$r/receipt.jsonl" 2>/dev/null || true
    printf '\n'
    if [ -r "$wt/.hw/$r/dispatch" ]; then
      printf '    %sintended (from the dispatch manifest)%s\n' "$C_DIM" "$C_0"
      sed 's/^/      /' "$wt/.hw/$r/dispatch" | sed "s/^/$(printf '%s' "$C_DIM")/;s/$/$(printf '%s' "$C_0")/"
      printf '\n'
    fi
  done
  if [ "$n" = 0 ]; then
    warn "runs exist under $wt/.hw but none carries a receipt"
    info "receipts start with the run that introduced them; older runs only have .hw/<run>/dispatch"
  fi
  return 0
}

# ── hw log ──────────────────────────────────────────────────────────────────
#
# What was SAID between the executor and its brainer, from the run's own
# append-only `transcript.log` (asks, challenges, rulings, answers, reports —
# see transcript_append in state-witness.sh). Disk, not scrollback: it is still
# here after both panes are gone. Runs come oldest first so it reads as a story.
cmd_log() {
  local proj="$1" task="$2" wt runs r n=0
  lane_known "$proj" || die "unknown project: $proj (expected: $(lane_names_bar))"
  wt="$(_lane_wt_dir "$proj" "$task")"
  [ -n "$wt" ] || wt="$WORK/$proj/$task"
  [ -d "$wt/.hw" ] || wt="$WORK/$proj/$task"
  [ -d "$wt/.hw" ] || die "no hw runs for $proj:$task (looked in $wt/.hw)"
  runs="$(ls -1 "$wt/.hw" 2>/dev/null || true)"
  for r in $runs; do
    [ -s "$wt/.hw/$r/transcript.log" ] || continue
    n=$((n + 1))
    printf '%s%s%s  %s\n' "$C_B" "$r" "$C_0" "$wt/.hw/$r/transcript.log"
    cat "$wt/.hw/$r/transcript.log"
  done
  if [ "$n" = 0 ]; then
    warn "no transcript for $proj:$task — nothing was asked, ruled or reported through the invokers yet (runs from before this log existed have none)"
  fi
  return 0
}

# ── hw revive ───────────────────────────────────────────────────────────────
#
# REPEAT WHAT WAS RECORDED. NEVER REBUILD WHAT WAS NOT.
#
# A recorded ruling stood against an `hw resume` verb because it would have to
# reconstruct four things it cannot verify — worktree, ports, database, tab
# record — three of which `hw done` destroys on purpose. That ruling stands.
# What it missed is that the two-line substitute it prescribed had grown into
# pieces nobody had joined: the session id in the receipt, the vendor's exact
# resume command in `session_resume` (see _record_session), the environment
# persisted per run in `.hw/<run>/env`, and herdr's own `claude --resume` on
# restore. The operator once joined them by hand: six plumbing calls and a
# `tab create` with 19 `--env` flags parsed out of the env file with shell
# quoting tricks — "it would break on a value with `=` or spaces; it got away
# with it because all 19 are paths, ids and numbers."
#
# So this verb reads FOUR FACTS that are already on disk, each with its source,
# and repeats them:
#
#   1. the cwd         — from `session_resume`'s own `cd <dir> && …` prefix
#   2. the environment — from .hw/<run>/env, parsed by its fixed grammar
#   3. the resume      — `session_resume`, verbatim after the cd
#   4. the vendor      — `session_vendor`, which picks the `agent start` kind
#
# THE RULE THAT SEPARATES IT FROM WHAT THE EARLIER RULING FORBADE: a fact that
# is not recorded is a REFUSAL, never an inference. A cwd that no longer exists
# is the case that matters most — it is exactly what `git worktree remove`
# produces — and the answer is "the session survives, its directory does not",
# not a rebuilt worktree. A large share of setup's own receipts carry no
# session entry; those runs are not revivable and this says so instead of
# improvising.
#
# THE ENV GRAMMAR IS THE HEART OF IT, not a detail. `_write_run_env` pins one
# `KEY='value'` per line with an inner `'` written as `'\''`, and the two
# existing readers (shell/hw-restore-env.zsh, invoker_adopt_env_file) parse
# exactly that. This one does too, in python, with no eval: a value may hold
# `=`, spaces, quotes, or be empty, and it reaches `--env` byte-identical. A
# line outside the grammar makes the whole file unreadable here — a half-parsed
# environment is a reconstruction wearing a receipt's clothes.
#
# And it marks the run REOPENED (A3): a revived run had reported `done`, so
# without this its executor would need `--retask` and `hw status` would show a
# closed run with a live pane. `reopened` beside `done` means: the old report
# stands, a new one is owed, and done-invoker accepts it plainly.
_revive_die() { printf '%shw revive REFUSED:%s %s\n' "$C_ERR" "$C_0" "$*" >&2; exit 1; }

# Parse a run env file into NUL-separated KEY=value records, or fail. Same
# grammar as the writer; the decoder is the inverse of
# `value.replace("'", "'\\''")` and nothing else.
_run_env_records() {  # $1 = env file
  HW_ENV_IN="$1" python3 - <<'ENVPARSE'
import os, re, sys
path = os.environ["HW_ENV_IN"]
line_re = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)='(.*)'$")
out = []
with open(path, encoding="utf-8") as fh:
    for n, raw in enumerate(fh, 1):
        line = raw.rstrip("\n")
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        m = line_re.match(line)
        if not m:
            sys.stderr.write("line %d is not KEY='value': %r\n" % (n, line))
            sys.exit(2)
        key, enc = m.group(1), m.group(2)
        out.append("%s=%s" % (key, enc.replace("'\\''", "'")))
sys.stdout.write("\0".join(out) + ("\0" if out else ""))
ENVPARSE
}

cmd_revive() {
  local proj="$1" task="$2" dry="${3:-0}" wt rundir receipt
  lane_known "$proj" || die "unknown project: $proj (expected: $(lane_names_bar))"
  wt="$(_lane_wt_dir "$proj" "$task")"
  [ -n "$wt" ] || wt="$WORK/$proj/$task"
  # A --worktree none task in a repo lane recorded itself in the work directory.
  [ -d "$wt/.hw" ] || wt="$WORK/$proj/$task"
  [ -d "$wt/.hw" ] || _revive_die "no hw runs for $proj:$task (looked in $wt/.hw) — nothing recorded, nothing to repeat"
  rundir="$(_task_rundirs "$proj" "$task" | head -1)"; rundir="${rundir%/}"
  [ -n "$rundir" ] || _revive_die "no run directory under $wt/.hw"
  receipt="$rundir/receipt.jsonl"
  [ -r "$receipt" ] || _revive_die "the newest run $(basename "$rundir") has no receipt.jsonl, so no session was ever recorded for it. Receipts start with the run that introduced them."

  local sid vendor resume
  sid="$(jq -r 'select(.key=="session_id") | .value' "$receipt" 2>/dev/null | tail -1)"
  vendor="$(jq -r 'select(.key=="session_vendor") | .value' "$receipt" 2>/dev/null | tail -1)"
  resume="$(jq -r 'select(.key=="session_resume") | .value' "$receipt" 2>/dev/null | tail -1)"
  [ -n "$resume" ] \
    || _revive_die "run $(basename "$rundir") recorded no session_resume — its executor published no session id in time (see the session_id receipt line, if any), so the conversation is not addressable and hw will not guess at it by title. 58 of setup's 143 receipts are in this state; this is one of them."
  case "$vendor" in
    claude|opencode|codex) ;;
    *) _revive_die "session_vendor is '${vendor:-absent}', not one of claude|opencode|codex — no agent kind is claimed for it" ;;
  esac
  # Revival bypasses the normal launch router, so replay the recorded framework
  # contract before it can create a tab or start the recorded vendor.
  local framework
  framework="$(_run_dispatch_framework "$rundir")"
  _validate_sdd_vendor_pair "$vendor" "$framework" "$wt"
  # A root dispatch can predate an explicit re-task that changed this live
  # surface. Its recorded contract still guards historical invalid modes above;
  # measure separately so a recorded `none` cannot mask the revived pane's
  # incompatible effective framework.
  _validate_sdd_vendor_pair "$vendor" "" "$wt"

  # FACT 1 AND FACT 3 FROM ONE RECORD. _record_session writes exactly
  # `cd <dir> && <vendor> <args>[   # comment]`; anything else is not hw's shape
  # and is refused rather than interpreted.
  local cwd rest cmd_bin cmd_args
  case "$resume" in
    "cd "*" && "*) ;;
    *) _revive_die "session_resume is not in the shape hw writes (cd <dir> && <vendor> …): $resume" ;;
  esac
  rest="${resume#cd }"
  cwd="${rest%% && *}"
  rest="${rest#* && }"
  rest="${rest%%   \#*}"                 # the opencode line carries a read-only hint after three spaces
  cmd_bin="${rest%% *}"
  cmd_args="${rest#* }"
  [ "$cmd_bin" = "$vendor" ] \
    || _revive_die "session_resume runs '$cmd_bin' but session_vendor says '$vendor' — two recorded facts disagree, and hw will not pick one"
  [ "$cmd_args" != "$rest" ] || _revive_die "session_resume has no arguments after '$cmd_bin': $resume"
  [ -n "$cwd" ] || _revive_die "session_resume has an empty cd target: $resume"
  [ -d "$cwd" ] \
    || _revive_die "the session survives — $vendor keeps ${sid:-it} — but its directory does not: $cwd is gone. That is what \`git worktree remove\` produces, and hw revive does not rebuild a worktree: a rebuilt directory would give the session a tree it never worked in."

  # FACT 2. Refused when absent; refused when a line is outside the grammar.
  [ -r "$rundir/env" ] || _revive_die "no $rundir/env — this run's environment was never persisted, and hw will not reassemble one from flags"
  local -a env_args=() env_shown=()
  local rec env_err
  if ! env_err="$(_run_env_records "$rundir/env" 2>&1 >/dev/null)"; then
    _revive_die "$rundir/env is not in the grammar _write_run_env writes: $env_err"
  fi
  while IFS= read -r -d '' rec; do
    env_args+=(--env "$rec")
    env_shown+=("$rec")
  done < <(_run_env_records "$rundir/env" 2>/dev/null)
  [ "${#env_args[@]}" -gt 0 ] || _revive_die "$rundir/env holds no variables"
  # The env file's own idea of the work directory must be the receipt's cwd.
  local env_workdir=""
  for rec in "${env_shown[@]}"; do
    case "$rec" in HW_WORKDIR=*) env_workdir="${rec#HW_WORKDIR=}" ;; esac
  done
  if [ -n "$env_workdir" ] && [ "$env_workdir" != "$cwd" ]; then
    _revive_die "the env file says HW_WORKDIR=$env_workdir and the receipt's resume says cd $cwd — two recorded facts disagree, and hw will not pick one"
  fi

  printf '\n  %srevive %s:%s%s  run %s\n' "$C_B" "$proj" "$task" "$C_0" "$(basename "$rundir")"
  printf '    cwd      %s\n' "$cwd"
  printf '    vendor   %s\n' "$vendor"
  printf '    session  %s\n' "${sid:-<not in receipt>}"
  printf '    resume   %s %s\n' "$cmd_bin" "$cmd_args"
  printf '    env      %s variables from %s\n' "${#env_shown[@]}" "$rundir/env"
  for rec in "${env_shown[@]}"; do printf '      %s\n' "$rec"; done
  printf '\n'

  local marker; marker="$(_run_done_marker "$rundir")"
  if [ "$dry" = 1 ]; then
    if [ -f "$marker" ]; then info "would mark the run reopened ($(_run_reopened_marker "$rundir")): it reported done, so a revived executor reports again without --retask"
    else info "the run never reported, so nothing to reopen"; fi
    if [ "$vendor" = claude ]; then
      case " $cmd_args " in
        *" --dangerously-skip-permissions "*) info "the recorded resume already carries --dangerously-skip-permissions" ;;
        *) info "would inject --dangerously-skip-permissions (today's machine policy, not part of the recorded resume identity): $cmd_bin $cmd_args --dangerously-skip-permissions" ;;
      esac
    fi
    ok "dry run — nothing created, no agent started"
    return 0
  fi

  # One directory, one agent. A second executor in the same cwd is the shared-
  # tree collision the worktree model exists to prevent.
  #
  # AND AN UNREAD LIST IS NOT AN EMPTY ONE. This used to be
  # `herdr agent list 2>/dev/null | jq … || true`, so a herdr hiccup printed
  # nothing and the check read it as "nobody is there" — inferring, by
  # exclusion, in the direction that CREATES the collision. `_wt_occupants`
  # answers the same question with three values, so this asks it there.
  local live
  _wt_occupants "$cwd"; live="$WT_OCCUPANTS"
  [ "$WT_OCCUPANTS_OBSERVED" = 1 ] \
    || _revive_die "could not read who is already working in $cwd — $WT_OCCUPANTS_WHY. Refusing rather than reviving into a directory that may already have an agent: one directory with two agents is the shared-tree collision the worktree model exists to prevent, and it leaves no trace in any diff."
  [ -z "$live" ] || _revive_die "an agent is already running in $cwd ($(printf '%s' "$live" | tr '\n' ' ')) — revive would give one directory two agents"

  PROJ="$proj"; TASK="$task"; HW_WORKDIR="$cwd"
  # A run launched in the sandbox comes back in it. The record is keyed by
  # lane and task in the sandbox's state root, OUTSIDE the work directory: a
  # marker found through the run directories is one the executor can hide by
  # renaming them (Judgment Day, both judges). FAIL CLOSED: anything but a
  # clean "never armed" revives it armed.
  local _sbx_rc=0
  "$HW_BIN_DIR/hw-sandbox" armed "$proj" "$task" || _sbx_rc=$?
  if [ "$_sbx_rc" != 1 ]; then SANDBOX=1; _SANDBOX_RUNDIR="$rundir"; fi
  _project_workspace "$proj" || _revive_die "could not find or create the workspace for $proj"
  local raw tab pane
  raw="$(_capture herdr tab create --workspace "$PROJECT_WORKSPACE" --cwd "$cwd" --label "$proj:$task" --no-focus "${env_args[@]}")" \
    || _revive_die "herdr tab create failed: $(printf '%s' "$raw" | head -3)"
  tab="$(printf '%s' "$raw" | jq -r '.result.tab.tab_id // .result.root_pane.tab_id // .result.tab_id // empty' 2>/dev/null || true)"
  pane="$(printf '%s' "$raw" | jq -r '.result.root_pane.pane_id // .result.pane.pane_id // empty' 2>/dev/null || true)"
  [ -n "$tab" ] && [ -n "$pane" ] || _revive_die "herdr created no usable tab/pane: $(printf '%s' "$raw" | head -3)"
  # THE TAB RECORD IS REWRITTEN, not reconstructed: the old tab is the one `hw
  # done` closed, and this is the one it now owns. Same file, same licence.
  printf '%s\n' "$tab" > "$rundir/tab"
  _receipt_into "$rundir" revived_tab "$tab" "herdr tab create --cwd $cwd --label $proj:$task with ${#env_shown[@]} --env from $rundir/env"
  _receipt_into "$rundir" revived_pane "$pane" "herdr tab create reply .result.root_pane.pane_id"

  AGENT_ARGS="$cmd_args"
  # INJECTED, NOT REPLAYED. `session_resume` records IDENTITY of this run —
  # `--resume <sid>` and nothing else (see _receipt_session) — never the
  # machine's CURRENT policy. `--dangerously-skip-permissions` is policy: the
  # same reasoning that puts it on every fresh claude launch in
  # _build_agent_args applies here unchanged, and a revived pane that goes
  # without it sits on a permission modal nobody is watching (measured
  # 2026-09-03: w7H:p7Y, revived without the flag, blocked on a `cd`-with-write
  # modal that bypass mode skips). A literal replay of `cmd_args` would leave
  # every revived claude pane in manual mode regardless of when the original
  # run launched, because the resume command recorded here never carried it in
  # the first place.
  #
  # Checked before appending so a receipt that DOES already carry the token —
  # a hand-edited one, or a future recorder that changes shape — is not given
  # it twice; `case " $cmd_args "` needs the surrounding spaces so the check is
  # for the whole token, not a substring of some other flag.
  # The engram proxy is policy too, for codex as for claude below: its resume
  # records `resume <sid>` only, and `codex resume` takes -c.
  if [ "$vendor" = codex ]; then
    case " $AGENT_ARGS " in
      *" -c mcp_servers.engram."*) ;;
      *) local rev_cx="$AGENT_ARGS"
         AGENT_ARGS=""; PROJ="$proj" AGENT=codex _engram_proxy_args
         AGENT_ARGS="$rev_cx $AGENT_ARGS" ;;
    esac
  fi
  if [ "$vendor" = claude ]; then
    case " $cmd_args " in
      *" --dangerously-skip-permissions "*) ;;
      *) AGENT_ARGS="$cmd_args --dangerously-skip-permissions" ;;
    esac
    # Policy too, like the flag above: a revived product executor is guarded
    # exactly as its first launch was. (opencode's half comes back with the
    # recorded env, which carries OPENCODE_CONFIG.)
    if PROJ="$proj" _brain_guard_on; then
      case " $AGENT_ARGS " in
        *" --plugin-dir $(_brain_guard_claude_plugin) "*) ;;
        *) AGENT_ARGS="$AGENT_ARGS --plugin-dir $(_brain_guard_claude_plugin)" ;;
      esac
    fi
    # And its engram label proxy, the same way: policy, not identity.
    case " $AGENT_ARGS " in
      *" --mcp-config "*) ;;
      *) local rev_args="$AGENT_ARGS"
         AGENT_ARGS=""; PROJ="$proj" AGENT=claude _engram_proxy_args
         AGENT_ARGS="$rev_args $AGENT_ARGS" ;;
    esac
    # And its artifact tools, which the recorded `--resume` never carried. The
    # account is the one the revived pane will actually run under: the recorded
    # env's CLAUDE_CONFIG_DIR, read back through the same table. A directory no
    # account names is not guessed — the tools go.
    local rev_cfg rev_acct=default
    rev_cfg="$(_run_env_value "$rundir" CLAUDE_CONFIG_DIR || true)"
    if [ -n "$rev_cfg" ]; then
      if [ "$rev_cfg" = "$(account_config_dir personal)" ]; then rev_acct=personal; else rev_acct="unknown:$rev_cfg"; fi
    fi
    if [ "$(_artifacts_verdict "$proj" "$rev_acct")" != allow ]; then
      case " $AGENT_ARGS " in
        *" --disallowedTools $HW_ARTIFACT_TOOLS "*) ;;
        *) AGENT_ARGS="$AGENT_ARGS --disallowedTools $HW_ARTIFACT_TOOLS" ;;
      esac
    fi
  fi
  if ! _agent_start "$pane" "$task" "$vendor"; then
    # _agent_start giving up is not proof the pane is dead — it gave up on ITS
    # OWN retry budget, and herdr may still be finishing the same startup this
    # function was polling. Ask once more before recommending a close: a live
    # answer here means revive already worked and hw just did not wait long
    # enough to see it (measured 2026-09-18: the recorded session came up idle
    # ~20s after this exact refusal was about to fire).
    local recheck
    recheck="$(herdr agent get "$pane" 2>/dev/null || true)"
    if printf '%s' "$recheck" | jq -e --arg pane "$pane" --arg name "$task" --arg kind "$vendor" '
         .result.agent | .pane_id == $pane and .name == $name and .agent == $kind and
         .interactive_ready == true and (["idle", "done"] | index(.agent_status) != null)
       ' >/dev/null 2>&1; then
      _receipt_into "$rundir" revived_agent "yes (recovered after a startup-refusal recheck)" "herdr agent get $pane, interactive_ready=true"
      warn "hw's own start budget gave up, but $pane is alive and idle — continuing rather than closing a working pane"
    else
      _receipt_into "$rundir" revived_agent "failed" "herdr agent start $task --kind $vendor --pane $pane -- $AGENT_ARGS"
      _revive_die "tab $tab (pane $pane) exists with the recorded environment, but \`$vendor $AGENT_ARGS\` did not come up in it (rechecked with herdr agent get, still not ready). The tab is left for you to read; close it with: herdr tab close $tab"
    fi
  else
    _receipt_into "$rundir" revived_agent "yes" "herdr agent start $task --kind $vendor --pane $pane -- $AGENT_ARGS, interactive_ready=true"
  fi
  local got
  got="$(herdr agent get "$pane" 2>/dev/null | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true)"
  if [ -n "$sid" ] && [ -n "$got" ] && [ "$got" != "$sid" ]; then
    warn "the agent came up with session $got, not the recorded $sid — reattachment is NOT claimed; read the pane"
    _receipt_into "$rundir" revived_session "$got (recorded: $sid) — MISMATCH" "herdr agent get $pane | jq .result.agent.agent_session.value"
  elif [ -n "$got" ]; then
    _receipt_into "$rundir" revived_session "$got" "herdr agent get $pane | jq .result.agent.agent_session.value"
  fi

  if [ -f "$marker" ]; then
    : > "$(_run_reopened_marker "$rundir")"
    _receipt_into "$rundir" reopened "yes" "the run had $(basename "$marker") and hw revive gave it a live pane; cleared by the next done-invoker or hw done"
    ok "run marked reopened — its earlier report stands, a new done-invoker is expected (no --retask), and hw status shows it as reopened"
  fi
  ok "revived $proj:$task in tab $tab, pane $pane — $vendor $AGENT_ARGS in $cwd"
  info "nothing was rebuilt: worktree, ports and database are whatever the directory still holds"
  return 0
}

# ── hw reports ──────────────────────────────────────────────────────────────
#
# WHAT A LANE'S EXECUTORS ACTUALLY SAID, READ FROM DISK.
#
# The launch guard above stops the next report from leaving its lane. It cannot
# repair the ones that already did: the operator once asked a brainer about
# two of its own tasks and it knew nothing about either, because
# 79 runs had been dispatched with `invoker w4C:pT` — an unlabelled pane whose
# cwd was `~`. Their reports exist, in a stranger's context, and the brainer
# that owns the lane has nowhere to read them.
#
# `_snapshot_done_report` is the durable half and it already writes the content
# into `receipt.jsonl`. Nothing read it back: measured on this repo, the keys
# `report_summary`, `report_status`, `report_artifacts` and `report_engram` had
# exactly one writer and ZERO readers, and `hw status` derives its tick from
# `done_status` alone. A record nobody can read is not a record.
#
# AND IT MUST KILL ONE SPECIFIC MISREADING. `.hw/<run>/done` is written with
# `: > "$STATE_DIR/done"`: a zero-byte flag, by design, whose whole content is
# its own existence. A brainer once opened it, found it
# empty, and concluded the staging task had FAILED. It had not. So this never
# renders an empty field: where there is no content it says, in a sentence, that
# the marker is a flag and not a transcript, and where the substance is instead.
#
# BY DEFAULT THIS SUMMARISES. The full render was the only render, and that was
# the defect: measured 2026-08-31, `hw reports` with no filter emitted 91356
# bytes for setup and 63944 for a product lane, where 76 of a product lane's 94 runs said only
# that their report text is NOT ON DISK — each spending six lines to say it.
# A new brainer running this as orientation spent its first turn on it, and a
# brainer that cannot afford to read its own lane's reports has no reports.
#
# So the six-line explanation is a LEGEND, printed once per invocation, and the
# per-run detail is one line per TASK. The text itself is still one flag away:
# `--full`, or naming the task, which is already a request for one thing.
cmd_reports() {
  local proj="${1:-}" task="${2:-}" repair="${HW_REPORTS_REPAIR:-1}" full="${HW_REPORTS_FULL:-0}"
  local lanes lane base bases dir run rundir n=0 stranger=0 recovered=0 missing=0 unreported=0
  local panes="" expected verdict invoker status summary artifacts engram
  local tname t_runs t_text t_flag t_open t_str mark detail plural
  # Naming a task IS the filter. You asked for one thing, so you get all of it.
  [ -z "$task" ] || full=1
  if [ -n "$proj" ]; then
    lane_known "$proj" || die "unknown project: $proj (expected: $(lane_names_hint))"
    lanes="$proj"
  else
    lanes="$HW_LANES"
  fi
  # ONE herdr call for the whole render, not one per run. The routing verdict is
  # about identity, which does not change between two runs of the same listing,
  # and 208 receipts on this disk would otherwise be 208 round trips.
  panes="$(herdr pane list 2>/dev/null || true)"

  for lane in $lanes; do
    bases="$(lane_work_bases "$lane")"
    expected="$BRAIN/$lane"
    printf '\n%sreports%s  %s — read from disk, never from a brainer'"'"'s context\n' "$C_B" "$C_0" "$lane"
    local lane_rows=0
    for base in $bases; do
      [ -d "$base" ] || continue
      for dir in "$base"/*; do
        [ -d "$dir/.hw" ] || continue
        tname="$(basename "$dir")"
        [ -z "$task" ] || [ "$tname" = "$task" ] || continue
        t_runs=0; t_text=0; t_flag=0; t_open=0; t_str=0
        for rundir in $(fd -H -t d -d 1 '^2[0-9]{7}-[0-9]{6}-[0-9]+$' "$dir/.hw" 2>/dev/null | sort -r); do
          rundir="${rundir%/}"
          run="$(basename "$rundir")"
          [ -r "$rundir/receipt.jsonl" ] || [ -f "$rundir/done" ] || continue
          # READING REPAIRS. While the executor pane is still alive its tokens
          # are the only copy of a report that went to the wrong brainer, and
          # this is idempotent: it returns immediately once a summary exists.
          if [ "$repair" = 1 ]; then _snapshot_done_report "$rundir" || true; fi
          n=$((n + 1)); lane_rows=$((lane_rows + 1)); t_runs=$((t_runs + 1))

          status="$(jq -r 'select(.key=="report_status") | .value' "$rundir/receipt.jsonl" 2>/dev/null | tail -1 || true)"
          summary="$(jq -r 'select(.key=="report_summary") | .value' "$rundir/receipt.jsonl" 2>/dev/null | tail -1 || true)"
          artifacts="$(jq -r 'select(.key=="report_artifacts") | .value' "$rundir/receipt.jsonl" 2>/dev/null | tail -1 || true)"
          engram="$(jq -r 'select(.key=="report_engram") | .value' "$rundir/receipt.jsonl" 2>/dev/null | tail -1 || true)"
          invoker="$(run_invoker_pane "$rundir")"

          # The verdict is computed in BOTH modes: a report that left its lane
          # is the one thing a summary must never hide, and counting it only
          # while rendering detail is how it would have been hidden.
          verdict=""
          [ -z "$invoker" ] || verdict="$(printf '%s' "$panes" | lane_brainer_verdict "$invoker" "$expected")"
          case "$verdict" in
            mismatch*) stranger=$((stranger + 1)); t_str=$((t_str + 1)) ;;
          esac

          if [ -n "$summary" ]; then
            recovered=$((recovered + 1)); t_text=$((t_text + 1))
          elif [ -f "$rundir/done" ]; then
            missing=$((missing + 1)); t_flag=$((t_flag + 1))
          else
            unreported=$((unreported + 1)); t_open=$((t_open + 1))
          fi

          [ "$full" = 1 ] || continue

          printf '\n  %s%s:%s%s  %s%s%s\n' \
            "$C_B" "$lane" "$tname" "$C_0" "$C_DIM" "$run" "$C_0"

          if [ -n "$summary" ]; then
            printf '      report     %s\n' "$summary"
            printf '      status     %s · artifacts %s · engram %s\n' \
              "${status:-unknown}" "${artifacts:-unknown}" "${engram:-unknown}"
          else
            if [ -f "$rundir/done" ]; then
              # THE SENTENCE THAT REPLACES AN EMPTY FIELD. Never print nothing
              # here: nothing is what got read as failure.
              printf '      report     NOT ON DISK. This run has a `done` marker, and that marker is a\n'
              printf '                 ZERO-BYTE FLAG BY DESIGN (`: > .hw/%s/done`). It records THAT\n' "$run"
              printf '                 delivery was proved, never WHAT was said. Empty is not evidence\n'
              printf '                 of failure, of an empty report, or of a task that did nothing.\n'
              printf '      recover    the text is in the receiving session and in engram:\n'
              printf '                 engram search "%s" --project brain --all-projects\n' "$tname"
            else
              printf '      report     none — this run has no `done` marker either, so nothing here\n'
              printf '                 says it ever reported. That is an open task, not a failed one.\n'
            fi
          fi

          if [ -z "$invoker" ]; then
            printf '      routed to  no report channel was set for this run (--no-report, or unresolved)\n'
          else
            case "$verdict" in
              ok) printf '      routed to  %s — the %s brainer\n' "$invoker" "$lane" ;;
              mismatch*)
                printf '      routed to  %s — %sNOT the %s brainer%s (%s); expected label=brain cwd=%s\n' \
                  "$invoker" "$C_WARN" "$lane" "$C_0" "${verdict#*$'\t'}" "$expected"
                printf '                 the brainer that owns this lane never received this report\n' ;;
              *)
                printf '      routed to  %s — that pane is gone, so hw cannot prove now whether it was\n' "$invoker"
                printf '                 the %s brainer. If the report is not above, it left no copy here.\n' "$lane" ;;
            esac
          fi
        done

        # ONE LINE PER TASK, and it says which of the three things each run is.
        if [ "$full" != 1 ] && [ "$t_runs" != 0 ]; then
          detail=""
          [ "$t_text" = 0 ] || detail="$detail · $t_text with text"
          [ "$t_flag" = 0 ] || detail="$detail · $t_flag flag only"
          [ "$t_open" = 0 ] || detail="$detail · $t_open never reported"
          [ "$t_str" = 0 ]  || detail="$detail · ${C_WARN}$t_str outside lane${C_0}"
          if   [ "$t_str"  != 0 ];        then mark="${C_WARN}!${C_0}"
          elif [ "$t_text" = "$t_runs" ]; then mark="${C_OK}✓${C_0}"
          else                                 mark="${C_DIM}·${C_0}"
          fi
          plural=s; [ "$t_runs" != 1 ] || plural=""
          printf '  %b %-46s %s%d run%s%b%s\n' \
            "$mark" "$tname" "$C_DIM" "$t_runs" "$plural" "${detail}" "$C_0"
        fi
      done
    done
    [ "$lane_rows" != 0 ] || info "no runs on disk for $lane"
  done

  printf '\n'
  info "$n run(s) read · $recovered with the report text on disk · $missing delivered but text not on disk · $unreported never reported · $stranger routed outside their lane"
  if [ "$full" != 1 ]; then
    if [ "$missing" != 0 ]; then
      # THE LEGEND, ONCE. This used to be six lines per run, 76 times in one lane.
      printf '  %sflag only%s = the run has a `done` marker, and that marker is a ZERO-BYTE FLAG BY\n' "$C_DIM" "$C_0"
      printf '              DESIGN (`: > .hw/<run>/done`). It records THAT delivery was proved,\n'
      printf '              never WHAT was said. Empty is not evidence of failure, of an empty\n'
      printf '              report, or of a task that did nothing. The text is in the receiving\n'
      printf '              session and in engram:  engram search "<task>" --project brain --all-projects\n'
    fi
    info "one line per task. For the report text: hw reports ${proj:-<project>} <task>, or --full for the whole lane"
  fi
  [ "$repair" = 1 ] || info "--no-repair: nothing was re-read from live panes, so a still-live stranded report was not rescued"
  [ "$stranger" = 0 ] || warn "a report routed outside its lane is only in the receiving session; \`hw reports\` cannot invent it, and this is what the launch guard now refuses"
  return 0
}

# WHERE A RUN'S REPORT WAS SENT: `run_invoker_pane`, in bin/project-spaces.sh.

# ── the preview lease ───────────────────────────────────────────────────────
#
# R7: RESOURCE LIFETIME IS NOT OWNED.
#
# A task that has finished implementing usually is not finished being USEFUL:
# its preview is what the audit reads and what a human approves. `hw done`
# closes the tab, drops the database and takes the dev server with it — so an
# orchestrator that needs the preview to survive has exactly one move, which is
# to leave the whole executor alive holding it.
#
# That is what happened on 2026-08-25. Three opencode executors — bar, elegant
# and classic stage-impl — sat idle for hours, burning context, so that three
# dev servers would stay up. Asked why they were retained, the orchestrator said
# "gates"; asked why they were idle, it agreed they were waiting on it. The
# honest answer is that hw offered no way to keep a preview without keeping an
# agent.
#
# A lease is that way. `hw done --keep-preview` closes the AGENT and keeps the
# dev pane, the ports and the database, and writes down until when and why. The
# lease is the ownership record for a resource whose owner has gone: `hw status`
# shows it, `hw reap` refuses to touch a worktree under one, and it EXPIRES, so
# the failure mode is a preview that outlives its usefulness by hours rather
# than one that outlives it by days because nobody remembered.
_LEASE_MAX_H=24
_lease_seconds() {  # 90m | 2h | 4 -> seconds. Empty -> 4h.
  local v="${1:-4h}" n u
  case "$v" in
    *h) n="${v%h}"; u=3600 ;;
    *m) n="${v%m}"; u=60 ;;
    *)  n="$v";     u=3600 ;;
  esac
  case "$n" in ''|*[!0-9]*) die "--keep-preview takes a duration like 90m, 4h or a bare number of hours (got: $1)" ;; esac
  [ "$n" -gt 0 ] || die "--keep-preview needs a duration greater than zero"
  local secs=$(( n * u ))
  [ "$secs" -le $(( _LEASE_MAX_H * 3600 )) ] \
    || die "a preview lease may not exceed ${_LEASE_MAX_H}h (asked for $1). A preview nobody has looked at in a day is not being kept, it is being forgotten."
  printf '%s' "$secs"
}

_lease_path() { printf '%s/lease' "$1"; }

_lease_write() {  # $1=rundir $2=seconds $3=why
  local until; until=$(( $(date +%s) + $2 ))
  {
    printf 'until=%s\n' "$until"
    printf 'until_h=%s\n' "$(date -r "$until" '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || printf '%s' "$until")"
    printf 'why=%s\n' "$3"
    printf 'by=%s\n' "${HERDR_PANE_ID:-unknown}"
    printf 'at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } > "$(_lease_path "$1")"
}

# 0 = a lease file exists and has not expired. 1 = none. 2 = expired.
_lease_state() {
  local f; f="$(_lease_path "$1")"
  [ -r "$f" ] || return 1
  local until; until="$(sed -n 's/^until=//p' "$f" 2>/dev/null | head -1)"
  case "$until" in ''|*[!0-9]*) return 2 ;; esac
  [ "$(date +%s)" -lt "$until" ] || return 2
  return 0
}

_lease_field() { sed -n "s/^$2=//p" "$(_lease_path "$1")" 2>/dev/null | head -1; }

# ── chaining lease ──────────────────────────────────────────────────────────
# Created only after receiver-proved delivery and the current task's done marker.
_chaining_lease_path() { printf '%s/chaining-lease' "$1"; }
_chaining_lease_field() { sed -n "s/^$2=//p" "$(_chaining_lease_path "$1")" 2>/dev/null | tail -1; }
_chaining_lease_eligibility() { # $1=rundir $2=current task; prints live|consumed|expired|missing|mismatched
  local rundir="$1" seq="$2" lease state until token task
  lease="$(_chaining_lease_path "$rundir")"
  [ -r "$lease" ] || { printf missing; return 0; }
  token="$(_chaining_lease_field "$rundir" token)"
  task="$(_chaining_lease_field "$rundir" task)"
  state="$(_chaining_lease_field "$rundir" state)"
  until="$(_chaining_lease_field "$rundir" until)"
  [ -n "$token" ] || { printf mismatched; return 0; }
  # Consumption advances the task counter, so a correctly consumed lease is
  # expected to name the previous task. Classify that fact before task binding.
  case "$state" in
    consumed) printf consumed; return 0 ;;
    expired|expired-cleanup) printf expired; return 0 ;;
    live) ;;
    *) printf mismatched; return 0 ;;
  esac
  [ "$task" = "$seq" ] || { printf mismatched; return 0; }
  case "$until" in ''|*[!0-9]*) printf mismatched ;; *) [ "$(date +%s)" -lt "$until" ] && printf live || printf expired ;; esac
}
_chaining_lease_ineligible_message() { # $1=eligibility $2=task $3=rundir
  local state="$1" seq="$2" rundir="$3" until
  case "$state" in
    consumed) printf 'task %s chaining authority was spent by a prior successful hw next. NOTHING was sent or touched; the task counter did NOT move.' "$seq" ;;
    expired) until="$(_chaining_lease_field "$rundir" until_h)"; printf 'task %s chaining authority expired%s. NOTHING was sent or touched; the task counter did NOT move.' "$seq" "${until:+ at $until}" ;;
    missing) printf 'task %s has no chaining authority. NOTHING was sent or touched; the task counter did NOT move.' "$seq" ;;
    *) printf 'task %s chaining authority does not match its current task-bound lease. NOTHING was sent or touched; the task counter did NOT move.' "$seq" ;;
  esac
}
_chaining_lease_live() {
  [ "$(_chaining_lease_field "$1" state)" = live ] || return 1
  local until; until="$(_chaining_lease_field "$1" until)"
  case "$until" in ''|*[!0-9]*) return 1 ;; esac
  [ "$(date +%s)" -lt "$until" ]
}
_chaining_task_marker() { if [ "$2" -gt 1 ] 2>/dev/null; then printf '%s/t%s/done' "$1" "$2"; else printf '%s/done' "$1"; fi; }
_chaining_current_task() { local n=""; [ -r "$1/task" ] && n="$(tr -dc '0-9' < "$1/task" 2>/dev/null || true)"; case "$n" in ''|0) n=1 ;; esac; printf '%s' "$n"; }
_chaining_lock_path() { local key; key="$(basename "$1" | tr -c 'A-Za-z0-9_.-' '_')"; printf '%s/hw-invoker-%s.lock' "${TMPDIR:-/tmp}" "$key"; }
_chaining_lock_take() {
  local lock deadline stale
  lock="$(_chaining_lock_path "$1")"; deadline=$(( $(date +%s) + 120 ))
  while ! mkdir "$lock" 2>/dev/null; do
    stale="$(find "$lock" -maxdepth 0 -mmin +5 2>/dev/null || true)"
    [ -z "$stale" ] || { rmdir "$lock" 2>/dev/null || true; continue; }
    [ "$(date +%s)" -lt "$deadline" ] || return 1
    sleep 1
  done
  CHAINING_LOCK="$lock"
}
_chaining_lock_release() { [ -z "${CHAINING_LOCK:-}" ] || rmdir "$CHAINING_LOCK" 2>/dev/null || true; CHAINING_LOCK=""; }

cmd_chaining_lease_start() {
  local rundir seq seconds reason holder token now until lease pid
  rundir="${HW_WORKDIR:-}/.hw/${HW_RUN:-}"; seq="$(_chaining_current_task "$rundir")"
  seconds="${HW_CHAINING_LEASE_SECONDS:-}"; reason="${HW_CHAINING_LEASE_REASON:-}"; holder="${HW_CHAINING_LEASE_HOLDER:-${HW_INVOKER_PANE:-unknown}}"
  case "$seconds" in ''|*[!0-9]*) die "delivered, but chaining lease duration is absent or invalid" ;; esac
  [ -n "$reason" ] || die "delivered, but chaining lease reason is absent"
  [ -f "$(_chaining_task_marker "$rundir" "$seq")" ] || die "refusing to start a chaining lease before task $seq has a done marker"
  token="$(python3 -c 'import secrets; print(secrets.token_hex(16))')" || die "could not create chaining lease identity"
  now="$(date +%s)"; until=$((now + seconds)); lease="$(_chaining_lease_path "$rundir")"
  {
    printf 'token=%s\ntask=%s\nuntil=%s\nuntil_h=%s\nreason=%s\nholder=%s\nby=%s\ncreated=%s\nstate=live\n' \
      "$token" "$seq" "$until" "$(date -r "$until" '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || printf '%s' "$until")" \
      "$reason" "$holder" "${HERDR_PANE_ID:-unknown}" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } > "$lease" || die "could not write $lease"
  nohup bash -c 'sleep "$1"; exec "$2" chaining-lease-expire "$3" "$4" "$5"' _ \
    "$seconds" "$HW_BIN_DIR/hw" "$rundir" "$token" "$seq" \
    > "$rundir/chaining-lease-expiry.log" 2>&1 &
  pid=$!
  if ! kill -0 "$pid" 2>/dev/null; then rm -f "$lease"; die "could not schedule chaining lease expiry"
  fi
  printf 'scheduler_pid=%s\n' "$pid" >> "$lease" || { kill "$pid" 2>/dev/null || true; rm -f "$lease"; die "could not record chaining lease scheduler"; }
  ok "chaining lease active until $(_chaining_lease_field "$rundir" until_h) — holder $holder; expiry closes the owned pane"
}

cmd_chaining_lease_expire() {
  local rundir="$1" token="$2" seq="$3" lease kind id
  lease="$(_chaining_lease_path "$rundir")"
  _chaining_lock_take "$rundir" || die "could not acquire the run lock to expire $lease"
  if [ "$(_chaining_lease_field "$rundir" token)" != "$token" ] \
     || [ "$(_chaining_lease_field "$rundir" task)" != "$seq" ] \
     || [ "$(_chaining_current_task "$rundir")" != "$seq" ] \
     || [ ! -f "$(_chaining_task_marker "$rundir" "$seq")" ]; then
    _chaining_lock_release; exit 0
  fi
  printf 'state=expired-cleanup\nexpired_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$lease"
  if [ -r "$rundir/tab" ]; then kind=tab; id="$(tr -d '[:space:]' < "$rundir/tab")"
  elif [ -r "$rundir/workspace" ]; then kind=workspace; id="$(tr -d '[:space:]' < "$rundir/workspace")"
  else printf 'cleanup=no-owned-container\n' >> "$lease"; _chaining_lock_release; exit 0; fi
  if _close_herdr_object "$kind" "$id" "closed expired chaining $kind $id" "$kind $id already gone"; then
    printf 'cleanup=closed\n' >> "$lease"
    _chaining_lock_release; exit 0
  fi
  printf 'cleanup=failed\n' >> "$lease"; _chaining_lock_release; return 1
}

# The run directories of a task, newest first.
_task_rundirs() {
  local proj="$1" task="$2" base
  base="$(_lane_wt_dir "$proj" "$task")"
  [ -n "$base" ] || base="$WORK/$proj/$task"
  [ -d "$base/.hw" ] || return 0
  fd -H -t d -d 1 '^2[0-9]{7}-[0-9]{6}-[0-9]+$' "$base/.hw" 2>/dev/null | sort -r
}

# Any live lease on this worktree path, for reap and status. Prints the rundir.
_leased_rundir_for() {  # $1 = worktree path
  local r
  [ -d "$1/.hw" ] || return 1
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    if _lease_state "$r"; then printf '%s' "$r"; return 0; fi
  done < <(fd -H -t d -d 1 '^2[0-9]{7}-[0-9]{6}-[0-9]+$' "$1/.hw" 2>/dev/null | sort -r)
  return 1
}

# ── the verification hw runs itself ─────────────────────────────────────────
#
# THE REPORT STOPS BEING THE EVIDENCE.
#
# On 2026-08-25 three executors in a row delivered correct code and a false
# process, and all three reports had to be corrected by hand. One ran the
# pre-commit, saw it red, and pushed past it with `env -u ... git commit`. One
# reported "Post-fix inherited: 173 tests passed" — the suite failed in the
# direction it claimed to have run, and it had never been run that way. One
# called a port complete because the diff "was the whole fix"; it had a hole.
#
# The pattern is not the model. It is that a report is PROSE, and prose has no
# cost of lying: writing "173 tests passed" costs less than running it, and far
# less than running it in both directions. The only defence was a human
# re-measuring everything by hand, which is what cost that session.
#
# So hw runs it. The commands come from the brief, pinned at dispatch into
# `.hw/<run>/verify` before the agent existed; hw executes them here, in the
# task's own directory, and writes the exit code and a hash of the output to
# the receipt. The agent is not asked and its report is not read — an executor
# that types "all green" produces no line here, and a missing line is now the
# visible thing it always should have been.
#
# NOT A GATE. A failing verification is recorded and said out loud; it does not
# block the close, invent a lifecycle state, or hold the worktree. The human
# decides what a red means. hw's job is that the red exists at all.
#
# 900s FIXED AGAINST A SUITE THAT IS NOW TWO GATES, NOT ONE. `setup/test-hw`'s
# full run is ~1000s — already past this ceiling before anything else about the
# brief is wrong — while its fast gate (`HW_TEST_GATE=fast`) is the tens of
# seconds this timeout was actually sized for. This does not need raising: a
# brief whose verify line names the full suite was already the wrong line to
# write, now that setup/hooks/pre-commit pays for the fast gate and
# setup/hooks/pre-push pays for the full one — full-suite coverage is
# MANDATORY at push, not something a task's own verify step needs to reprove
# synchronously at `hw done`. See the warning `_verify_at_close` prints when a
# command looks like the full suite.
#
# Injectable for the same reason every other clock budget in this file is:
# `${HW_VERIFY_TIMEOUT_SECONDS:-900}` keeps 900 as the production default and
# lets a caller (a test, an unusual brief) override it without editing source.
# DOES A VERIFY COMMAND NAME THE FULL SUITE WITHOUT ITS FAST GATE?
#
# ONE PLACE, because the answer is needed at TWO moments and they are not the
# same moment at all. `_verify_at_close` asks it with the 900 seconds already
# spent and the work already done; `_dispatch_manifest` asks it before the
# executor exists, which is the only moment at which fixing the brief is free.
#
# MEASURED. A brief put `bash setup/test-hw` in its
# `## Verification` block. `hw done` hung past seven minutes and died
# `VERIFICATION FAILED exit 124` — the full suite is ~1000s against a 900s
# ceiling. hw DID name `HW_TEST_GATE=fast bash setup/test-hw` in that failure,
# so the advice was already right; what was wrong was WHEN. `--dry-run`
# confirmed it: the dispatch manifest printed the verification block and said
# nothing about the timeout or the gate, so the one reader who could still edit
# the brief for free was the one reader never told.
#
# 0 = yes, this command is the shape the close timeout cannot serve.
_verify_names_full_suite() {  # <command>
  case "$1" in
    *setup/test-hw*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    *HW_TEST_GATE=fast*) return 1 ;;
  esac
  return 0
}

_VERIFY_TIMEOUT="${HW_VERIFY_TIMEOUT_SECONDS:-900}"
_verify_at_close() {  # $1 = run directory, $2 = directory to run in, $3/$4 = project/task
  local rundir="$1" workdir="$2" vproj="${3:-}" vtask="${4:-}" pin n=0 rc out hash log to=""
  local verifydir="$workdir"
  # SETUP USED TO BE REDIRECTED TO THE MAIN CHECKOUT HERE, and that redirect
  # expired on 2026-09-16. It existed because a setup work directory held
  # artifacts and no code, so `bash setup/test-hw` had nothing to run; now that
  # directory IS a worktree of brain and running the pinned verification
  # anywhere else would measure a tree the task never touched — the exact
  # "green on the wrong base" failure the --base field was added to stop.
  #
  # The redirect survives for a setup task that is NOT a worktree: a
  # `--worktree none` dispatch, or one of the plain directories every setup task
  # before that date left behind. There the old reason still holds exactly.
  if lane_worktree_is_workdir "$vproj" && [ ! -e "$workdir/.git" ]; then
    verifydir="$(_lane_main_checkout "$vproj")"
    [ -n "$verifydir" ] || verifydir="${BRAIN:-${HW_BRAIN_ROOT:-}}"  # an extracted harness may not set BRAIN
  fi
  # `fd` hands back a trailing slash, which made every recorded log path read
  # `.hw/<run>//verify-1.log`. A path in a receipt is meant to be pasted.
  rundir="${rundir%/}"
  [ -n "$rundir" ] && [ -d "$rundir" ] || return 0
  # A CLOSE THAT NOBODY NEEDS VERIFIED SAYS SO, in the receipt. `--force` is what
  # a human reaches for when a close looks stuck, and paying the whole
  # verification again made it the slowest way out; a `--blocked` report has no
  # finished work to verify. Both are decided by the caller, not inferred here.
  if [ -n "${DONE_VERIFY_SKIP:-}" ]; then
    _receipt_into "$rundir" verify_run "skipped (${DONE_VERIFY_SKIP})" \
      "hw done $DONE_VERIFY_SKIP: the pinned verification was not run"
    info "verification skipped (${DONE_VERIFY_SKIP}) — nothing here claims this task was verified"
    return 0
  fi
  pin="$rundir/verify"
  # NO PIN AT ALL is a different fact from AN EMPTY PIN, and only the second is
  # worth a receipt: runs that predate this have no file, and inventing a
  # measurement for them would be the defect this function exists to remove.
  [ -f "$pin" ] || return 0
  if [ ! -s "$pin" ]; then
    _receipt_into "$rundir" verify_run \
      "none — the brief declared no runnable command" \
      "$pin, pinned from the brief at dispatch, is empty"
    warn "NOT VERIFIED: this task's brief declared no command hw could run"
    warn "nothing here says the work was checked — the report is the only claim there is"
    return 0
  fi
  [ -d "$verifydir" ] || {
    _receipt_into "$rundir" verify_run \
      "not run — $verifydir does not exist" "test -d $verifydir at hw done"
    warn "NOT VERIFIED: $verifydir is gone, so the pinned verification could not run"
    return 0
  }
  # `hw done` may be called by the brainer, not the executor. Reconstruct the
  # task-owned artifacts location from the same project/workdir rule used at
  # dispatch, so an unset (or stale) caller environment cannot become a false
  # verification failure. Verification commands currently pin no executor-only
  # HW_* inputs beyond this durable path.
  HW_ARTIFACTS="$(_artifacts_dir_for "$vproj" "$workdir")"
  export HW_ARTIFACTS
  # A verification that hangs would hang `hw done`, and hw done is how a task
  # leaves the board. Bounded, and the bound is stated in the source line.
  # `${_VERIFY_TIMEOUT:-900}`, not the bare variable: an empty duration makes
  # `timeout` exit 125 without ever running the command, and 125 would have been
  # recorded as the verification's own exit code — a measurement of nothing,
  # indistinguishable from a real failure. Caught by driving this function
  # outside bin/hw, which is how the suite drives everything.
  local secs="${_VERIFY_TIMEOUT:-900}"
  if command -v timeout >/dev/null 2>&1; then to="timeout $secs"
  elif command -v gtimeout >/dev/null 2>&1; then to="gtimeout $secs"; fi
  # ── AND IT RUNS BEHIND THE LANE'S SUITE LOCK, the same one `hw suite` takes ──
  #
  # MEASURED: it did not. `hw suite <lane> -- <cmd>`
  # existed, took a per-lane lock and reclaimed a dead holder's orphan, and the
  # close verification ran its pinned command raw beside it. The command a brief
  # pins is very often that lane's own suite — so two `hw done`s in one lane, or
  # one close while somebody runs the suite by hand, ran over each other, on a
  # lane where several executors share ONE tree and ONE index. A lock a human
  # gets and the tool does not is a lock with a hole in it.
  #
  # NOT A GATE, AND THE BUDGET SAYS SO. `_suite_lock_take` never dies; a lane
  # busy for the whole budget is recorded as NOT VERIFIED and the close
  # continues, because `hw done` is how a task leaves the board and a lock must
  # never be what keeps it on. The budget defaults to the verification's own
  # timeout — waiting longer for a turn than the command is allowed to take is
  # its own absurdity — and is injectable for the same reason every other clock
  # in this file is.
  #
  # WHAT MUST NOT BE BROKEN, because it is not obvious and it was measured:
  # a suite that has been orphaned (ppid=1) can still reach green and still have
  # its verdict recovered, because its output goes to a real file. So a lock
  # whose only question is "is a process alive" loses that case.
  # `_suite_holder_alive` already answers a narrower question — pid AND process
  # start time, with the claim window aged rather than assumed — and this reuses
  # it unchanged rather than inventing a second liveness rule here.
  #
  # A LOCK THAT CANNOT BE CREATED IS NOT CONTENTION, and the difference is the
  # whole point of this block. `_suite_lock_take` waits out its budget on ANY
  # `mkdir` failure, and an unwritable parent fails the same way a held lock
  # does — so without this branch a broken `$WORK` would be reported as
  # "somebody else is running the suite", which is a fact hw would be inventing.
  # Named, and the verification runs unlocked rather than not at all: an
  # unprovable lock is a reason to say so, not a reason to measure nothing.
  #
  # THE CEILING, STATED RATHER THAN IMPLIED. The comment above says this
  # function is bounded; with a lock in front of it the bound is now
  # `vwait` PLUS `secs` per pinned command, not `secs`. Default 900 + 900. That
  # is deliberate — a lane suite runs ~1000s, so a wait much shorter than one
  # run would mean a close almost never gets its turn — and it is not a silent
  # hang: `_suite_lock_take` announces the wait ONCE, names the holder and
  # prints the budget. `HW_VERIFY_SUITE_WAIT_MS` moves it.
  #
  # THE $WORK CHECK COMES FIRST, and the order is the whole point.
  # `_suite_lock_dir` dereferences `$WORK` bare, so resolving the path before
  # checking it would abort the process under `set -u` instead of reaching the
  # unserialised fallback this branch exists to provide. Raised by a blind
  # adversarial reviewer on this candidate; today `cmd_done` happens to
  # dereference `$WORK` earlier anyway, which makes it unreachable rather than
  # correct, and unreachable is not a property to build on.
  local vlock="" vheld=0 vwait vlock_prev="${HW_SUITE_LOCK_HELD:-}"
  vwait="${HW_VERIFY_SUITE_WAIT_MS:-$(( secs * 1000 ))}"
  # SAID BEFORE ANY WAIT, INCLUDING THE LOCK'S: this is the step that makes
  # `hw done` slow, and nothing has closed while it runs. A caller whose tool gives
  # up at 120s should know what it is waiting for, that the pane is still open,
  # and both bounds.
  info "hw done is now running this task's verification — the slow step; NOTHING is closed until it ends. Ceiling ${secs}s per command, plus up to $(( vwait / 1000 ))s first if another run holds the lane's suite lock."
  if _suite_lane_pooled "$vproj"; then
    info "the $vproj lane has no suite lock: its suite shares the machine's worker pool with every other suite and runs its timing subjects alone — see _suite_lane_pooled. This verification does not wait behind another suite."
  elif [ -z "${WORK:-}" ]; then
    warn "the $vproj suite lock could not be located — WORK is unset, so this verification runs UNSERIALISED"
    warn "if somebody else is running that lane's suite right now, these two are on the same tree"
  else
    vlock="$(_suite_lock_dir "$vproj")"
    if ! mkdir -p "$(dirname "$vlock")" 2>/dev/null; then
      warn "the $vproj suite lock could not be created under $WORK — this verification runs UNSERIALISED"
      warn "if somebody else is running that lane's suite right now, these two are on the same tree"
      vlock=""
    fi
  fi
  if [ -z "$vlock" ]; then
    :
  elif _suite_lock_held_by_ancestor "$vlock" "$vproj"; then
    # Already inside somebody's hold — see _suite_lock_held_by_ancestor.
    info "the $vproj suite lock is already held further up this process tree; this verification runs inside that hold"
    vlock=""
  elif _suite_lock_take "$vlock" "$vproj" "$vwait" "hw done verification of ${vtask:-<unnamed task>}"; then
    vheld=1
    # THE INT/TERM ARMS EXIT, and that is not decoration. A trap whose body
    # does not exit turns a delivered signal into "run this, then carry on
    # from where you were" — so Ctrl-C during a locked verification would
    # release the lock and let the close continue, which is the opposite of
    # what the person pressing it asked for. Raised by both blind reviewers on
    # this candidate. 130/143 are the conventional 128+signal codes.
    # shellcheck disable=SC2064
    trap "rm -rf '$vlock' 2>/dev/null || true" EXIT
    # shellcheck disable=SC2064
    trap "rm -rf '$vlock' 2>/dev/null || true; exit 130" INT
    # shellcheck disable=SC2064
    trap "rm -rf '$vlock' 2>/dev/null || true; exit 143" TERM
    # THE MARKER A NESTED `hw suite` READS, exported only while the lock is
    # really held. See _suite_lock_held_by_ancestor for why a pid rides along.
    export HW_SUITE_LOCK_HELD="$vproj:$SUITE_LOCK_TOKEN"
    ok "holding the $vproj suite lock for this close's verification (pid $$)"
  else
    _receipt_into "$rundir" verify_run \
      "not run — the $vproj suite lock was held by a live runner for the whole $(( vwait / 1000 ))s budget" \
      "hw done waited for $vlock and did not get it; $(_suite_holder_line "$vlock")"
    warn "NOT VERIFIED: the $vproj suite lock is held by a live runner — $(_suite_holder_line "$vlock")"
    warn "hw done will NOT run this task's verification over somebody else's suite. Nothing here says the work was checked."
    warn "when that runner is done: hw suite $vproj -- <the command in $pin>"
    info "measured: hw receipt $vproj $vtask"
    return 0
  fi
  while IFS= read -r cmd; do
    [ -n "$cmd" ] || continue
    n=$((n + 1))
    log="$rundir/verify-$n.log"
    # THE ONE COMMAND SHAPE THIS TIMEOUT CANNOT SERVE: the full suite, named
    # without the fast gate. `secs` above is sized for the fast gate (or a
    # brief's own quick check); the full suite is ~1000s of real work and
    # belongs to `setup/hooks/pre-push`, mandatorily, not to a synchronous
    # `hw done` step. Warn rather than refuse — a human may have a reason —
    # but say it where the mismatch is about to be paid for, not just in a
    # comment nobody reads until it times out.
    if _verify_names_full_suite "$cmd"; then
      warn "verify command names the full suite without HW_TEST_GATE=fast — that is ~1000s against a ${secs}s timeout, and it will read as a failed verification, not a slow one. Full-suite coverage is already mandatory at push (setup/hooks/pre-push); point this brief's verify at the fast gate instead: HW_TEST_GATE=fast bash setup/test-hw"
      warn "this was also said at dispatch, where the brief could still be edited for free"
    fi
    info "verifying: $cmd"
    rc=0
    out="$( cd "$verifydir" && $to bash -c "$cmd" 2>&1 )" || rc=$?
    printf '%s\n' "$out" > "$log" 2>/dev/null || true
    hash="$(printf '%s' "$out" | shasum -a 256 | cut -d' ' -f1)"
    _receipt_into "$rundir" verify_run \
      "exit $rc  sha256 $hash  $cmd" \
      "hw done ran: (cd $verifydir && $to bash -c '$cmd'); output in $log"
    if [ "$rc" = 0 ]; then
      ok "VERIFIED  exit 0  $cmd"
    else
      warn "VERIFICATION FAILED  exit $rc  $cmd"
      warn "the receipt records the failure; nothing here claims this task was verified"
      warn "the output is in $log"
    fi
  done < "$pin"
  if [ "$vheld" = 1 ]; then
    rm -rf "$vlock" 2>/dev/null || true
    trap - EXIT INT TERM
    # RESTORED, not merely cleared: hw done may itself have been launched from
    # inside somebody's hold, and dropping the marker would let the NEXT nested
    # call claim a lock its ancestor is holding.
    if [ -n "$vlock_prev" ]; then export HW_SUITE_LOCK_HELD="$vlock_prev"
    else unset HW_SUITE_LOCK_HELD; fi
    ok "released the $vproj suite lock"
  fi
  info "measured: hw receipt $vproj $vtask"
  return 0
}

# Persist the completion pointer before closing its executor pane. Tokens live
# on the sender, not the receiver, so this repairs reports sent by already-live
# runs whose baked HW_INVOKER_PANE still names the wrong brainer. `hw receipt`
# calls the same idempotent snapshot while a stranded pane remains readable.
_snapshot_done_report() { # run directory
  local rundir="$1" pane info tokens summary marker seq=1 token_run
  marker="$rundir/done"
  [ -d "$rundir" ] || return 0
  if [ -r "$rundir/receipt.jsonl" ] \
     && jq -e 'select(.key == "report_summary")' "$rundir/receipt.jsonl" >/dev/null 2>&1; then
    return 0
  fi
  # `|| true` IS LOAD-BEARING, and its absence was a live crash. Under
  # `set -euo pipefail` a jq that cannot open the file exits 2, pipefail hands
  # that to the pipeline, and the ASSIGNMENT then kills the calling shell before
  # the `[ -n "$pane" ]` on the next line ever runs. A run directory with no
  # receipt.jsonl is ordinary — 60 of the 208 on this disk have none — so
  # `hw reports` walked into it on its first real lane and exited 2 mid-render.
  pane="$(jq -r 'select(.key=="pane") | .value' "$rundir/receipt.jsonl" 2>/dev/null | tail -1 || true)"
  [ -n "$pane" ] || return 0
  info="$(herdr agent get "$pane" 2>/dev/null || true)"
  tokens="$(printf '%s' "$info" | jq -c '.result.agent.tokens // {}' 2>/dev/null || true)"
  [ -n "$tokens" ] || return 0
  [ "$(printf '%s' "$tokens" | jq -r '.done_status // empty')" != "" ] || return 0
  token_run="$(printf '%s' "$tokens" | jq -r '.hw_run // empty')"
  if [ "$token_run" != "$(basename "$rundir")" ]; then
    warn "report tokens on $pane belong to run ${token_run:-<unknown>}, not $(basename "$rundir"); receipt unchanged"
    return 0
  fi
  summary="$(printf '%s' "$tokens" | jq -r '[.sum,.sum2,.sum3,.sum4,.sum5,.sum6,.sum7] | map(select(. != null)) | join("")')"
  _receipt_into "$rundir" report_project "$(printf '%s' "$tokens" | jq -r '.hw_project // "unknown"')" "herdr agent get $pane token hw_project"
  _receipt_into "$rundir" report_task "$(printf '%s' "$tokens" | jq -r '.hw_task // "unknown"')" "herdr agent get $pane token hw_task"
  _receipt_into "$rundir" report_run "$token_run" "herdr agent get $pane token hw_run matched receipt run directory"
  _receipt_into "$rundir" report_summary "$summary" "herdr agent get $pane tokens sum/sum2/... before pane close"
  _receipt_into "$rundir" report_status "$(printf '%s' "$tokens" | jq -r '.done_status')" "herdr agent get $pane token done_status"
  _receipt_into "$rundir" report_state "$(printf '%s' "$tokens" | jq -r '.done_state // "unknown"')" "herdr agent get $pane token done_state"
  _receipt_into "$rundir" report_artifacts "$(printf '%s' "$tokens" | jq -r '.artifacts // "unknown"')" "herdr agent get $pane token artifacts"
  _receipt_into "$rundir" report_engram "$(printf '%s' "$tokens" | jq -r '.engram // "unknown"')" "herdr agent get $pane token engram"
  if [ -r "$rundir/task" ]; then
    seq="$(tr -cd '0-9' < "$rundir/task" 2>/dev/null || true)"; : "${seq:=1}"
    [ "$seq" = 1 ] || marker="$rundir/t$seq/done"
  fi
  if [ -f "$marker" ]; then
    _receipt_into "$rundir" completion_marker \
      "present — zero-byte flag means the receiver admitted the report (admission, not proof it was read); report content is in report_summary/status/artifacts/engram above" \
      "test -f $marker after done-invoker delivery accounting"
  else
    _receipt_into "$rundir" completion_marker \
      "absent — report recovered from pane tokens, but receiver admission is not established" \
      "test ! -f $marker while snapshotting completion tokens"
  fi
}

# ── a pane has an owner, and hw done must establish it before closing ───────
#
# THE INCIDENT. A brainer ran `hw done` on a
# pane THE OPERATOR WAS USING AT THAT MOMENT. The session went with it. It came back
# through `hw revive` — and nobody in the room knew that command existed until
# after the panic, which is the other half of the defect: an emergency exit
# announced after the fire is not an exit.
#
# WHAT hw KNEW AND DID NOT ASK. `hw done` closed the tab on the strength of a
# label matching `<proj>:<task>`. Whether anything was happening inside it was
# never a question — not whether the task had reported, not whether a turn was
# running, not whether turns had ended in there that hw never dispatched.
#
# THE ORIGINAL PRESCRIPTION FOR THIS GUARD WAS `turns`, AND IT DOES NOT WORK.
# Stated here because the next reader will reach for it too. `turns` counts
# turn-ENDS (`cmd_executor_turn_end`), not hw dispatches: the turn-end hook
# itself returns 8 and forces another one, so one brief routinely produces
# several. MEASURED over the 189 `.hw/<run>/turns` files under $WORK:
# 118 of them are at 2 or more with the task counter still at 1, the largest at
# 233. "turns hw did not dispatch" = turns − dispatches would have refused ~62%
# of every close ever made, and a guard that needs `--force` everywhere is a
# guard nobody reads. Worse, the counter FROZE at the report (that branch
# returned before incrementing), so the post-report window — the incident's own
# window — produced no turns at all. The counter was wrong in both directions.
#
# SO THE FACTS THIS READS ARE THE ONES THAT DISCRIMINATE, three of them, each
# named separately in the refusal because they mean different things:
#
#   · NO REPORT. Derived by `_report_evidence`, the same function `hw next`
#     uses — one derivation of "reported", two callers. A second answer to that
#     question is what produced the 2026-08-24 contradiction it was written for.
#   · agent_status=working. A turn is running RIGHT NOW and the close would cut
#     it mid-work. hw dispatched none of it: after a report `hw next` is the
#     only re-task route and it advances the task counter first.
#   · turns that ended AFTER the report. Counted since 2026-09-16 beside
#     `turns`, on disk at `.hw/<run>/turns-post-report` and republished as the
#     `turns_post_report` token. Disk first, token second — the same two-signal
#     discipline as the report evidence, because a token carries a TTL and a
#     file does not.
#
# `focused` IS EVIDENCE, NEVER A TRIGGER. It says a human is LOOKING at the
# pane, and exactly one pane on the machine can hold it. "Nobody is looking"
# is not "nobody is using it" — a human who switched tabs for thirty seconds
# would be silently overruled by a guard that keyed on it. So it is reported
# when true, and it never decides.
#
# `--force` is the one exit, and it is meant to cost a sentence of thought:
# every refusal below names it, and taking it says the closer established
# ownership some other way.
_done_pane_for_run() {  # $1=rundir
  [ -r "$1/receipt.jsonl" ] || return 0
  jq -r 'select(.key=="pane") | .value' "$1/receipt.jsonl" 2>/dev/null | tail -1 || true
}
_done_in_use_guard() {  # $1=project $2=task $3=rundir
  local proj="$1" task="$2" rundir="$3"
  local pane info status focus post ev seq reasons="" revive_note _has_agent=0
  if [ "${DONE_FORCE:-0}" = 1 ]; then
    warn "--force: closing $proj:$task WITHOUT establishing that its pane is free"
    return 0
  fi
  # Each of these is "hw has nothing to read", not "the pane is free", and they
  # are deliberately not refusals: hw done must still close a task whose run
  # record, pane receipt or pane itself is gone, which is most old tasks.
  [ -n "$rundir" ] || { info "no hw run record for $proj:$task, so there is no pane to establish ownership of"; return 0; }
  pane="$(_done_pane_for_run "$rundir")"
  [ -n "$pane" ] || { info "run $(basename "$rundir") recorded no pane receipt, so hw cannot tell whose pane this was"; return 0; }
  # A SELF-CLOSE IS NOT AN INTERRUPTION, AND THIS GUARD WOULD HAVE BROKEN EVERY
  # ONE OF THEM. MEASURED 2026-09-16, on the executor writing this: `done-invoker`
  # closes its own pane by calling `hw done <proj> <task>` from INSIDE it
  # (bin/done-invoker, both the lease-fallback and the ordinary close), and at
  # that instant herdr reports that pane `agent_status=working` — because the
  # turn running done-invoker IS a turn:
  #
  #     pane w7G:p9Y -> {"agent_status":"working","focused":true}
  #
  # So the `working` arm below would refuse every non-chained close, done-invoker
  # would take its delivered-but-not-closed exit, and delivered task tabs would
  # accumulate open forever — the exact failure that path exists to prevent,
  # reintroduced by the guard meant to protect panes.
  #
  # SO THE EXEMPTION IS SCOPED TO THE ARMS A SELF-CLOSE CAUSES, and only those:
  # `working` and the post-report turn count. It does NOT cover the unreported
  # arm.
  #
  # THE FIRST VERSION OF THIS FIX RETURNED UNCONDITIONALLY, and that was wrong.
  # Caught by a blind judge in the scoped re-judgment and reproduced before it
  # was accepted: `HERDR_PANE_ID` is baked into EVERY pane at spawn, so the
  # exemption keyed on "somebody is closing their own pane", not on
  # "done-invoker is closing after reporting". An agent abandoning its task and
  # running `hw done <proj> <task>` by hand, with no report ever written, closed
  # silently — while the identical close from any other pane was refused. That
  # defeats the guard's primary arm for the one caller most able to skip it.
  #
  # `done-invoker` is unaffected: it writes the done marker BEFORE it ever
  # reaches the close, so the unreported arm has nothing to fire on there.
  #
  # AND setup/tests/24-done-closes-delivered.sh DID NOT CATCH THE ORIGINAL
  # REGRESSION EITHER, which is the more useful half. Its herdr stub is
  # `exit 0` — it answers nothing, so the guard sees no agent object and
  # abstains, and the test passed for the wrong reason. setup/CLAUDE.md's own
  # rule: the stubbed path is not the path.
  local self_close=0
  if [ -n "${HERDR_PANE_ID:-}" ] && [ "$pane" = "$HERDR_PANE_ID" ]; then
    self_close=1
  fi
  # AND AN UNANSWERED HERDR IS SAID OUT LOUD, NOT SWALLOWED. Blind judge A: a
  # transient herdr failure while a human is working in the pane leaves `info`
  # empty, the guard abstained SILENTLY, and the close went through — the
  # incident's own failure mode reopened by a different trigger.
  #
  # It stays a WARNING and not a refusal, deliberately. `hw done` must keep
  # closing tasks whose pane is genuinely long gone, which is most old tasks,
  # and this call cannot tell "herdr did not answer" from "there is no such
  # agent". What is fixed is the SILENCE: a close that could not establish
  # ownership now says so, instead of reading like one that established it.
  # ASKED OF THE STRUCTURE, NOT OF THE TEXT. This was a substring match for
  # `"agent"` on the raw reply, which any unrelated JSON carrying that word
  # would satisfy and any reshaped herdr reply could break. Scoped re-judgment.
  info="$(herdr agent get "$pane" 2>/dev/null || true)"
  _has_agent=0
  printf '%s' "$info" | jq -e '.result.agent' >/dev/null 2>&1 && _has_agent=1
  if [ -z "$info" ] || [ "$_has_agent" = 0 ]; then
    warn "could NOT establish whether pane $pane is free: herdr returned nothing usable for it. It may be long gone, or herdr may simply not have answered — this close cannot tell those apart, and is proceeding WITHOUT the check."
    return 0
  fi

  seq="$(_chaining_current_task "$rundir")"
  ev="$(_report_evidence "$pane" "$rundir")"
  status="$(printf '%s' "$info" | jq -r '.result.agent.agent_status // empty' 2>/dev/null || true)"
  focus="$(printf '%s' "$info" | jq -r '.result.agent.focused // empty' 2>/dev/null || true)"
  # DISK FIRST. The file is written by the executor's own turn-end hook and
  # outlives the token, which carries a 24h TTL.
  # THE RECORD IS `<seq> <count>`, and the seq is load-bearing: a chained
  # session's task 2 must not be refused over task 1's post-report turns. A
  # record whose seq is not this task's says nothing about this task.
  # THE FILE IS AUTHORITATIVE WHEN IT EXISTS, and the token is only a fallback
  # for when the run directory is gone. That ordering is load-bearing: a
  # chained session's record reads `1 3` while task 2 is being closed, the seqs
  # do not match — and falling through to the token there would hand `hw done`
  # task 1's stale count and refuse task 2's ordinary close, which is the very
  # bug the seq exists to prevent, rebuilt one line lower.
  post=""
  if [ -r "$rundir/turns-post-report" ]; then
    local rec rec_seq
    rec="$(cat "$rundir/turns-post-report" 2>/dev/null || true)"
    rec_seq="${rec%% *}"
    [ "$rec_seq" = "$seq" ] && post="$(printf '%s' "${rec##* }" | tr -dc '0-9' || true)"
  else
    # Same `<seq> <count>` record, parsed the same way. One shape, two places.
    local tok tok_seq
    tok="$(printf '%s' "$info" | jq -r '.result.agent.tokens.turns_post_report // empty' 2>/dev/null || true)"
    tok_seq="${tok%% *}"
    [ -n "$tok" ] && [ "$tok_seq" = "$seq" ] && post="$(printf '%s' "${tok##* }" | tr -dc '0-9' || true)"
  fi
  case "$post" in ''|0) post="" ;; esac

  # `done_state=undelivered` IS A REPORT THAT NEVER REACHED THE BRAINER, NOT ONE
  # THAT DID. done-invoker publishes it before it tries to deliver and rewrites
  # it to `delivered` only after the receiver admitted the envelope, so the
  # token alone says "the executor finished", never "the brainer heard" — and
  # the pane is the only copy of the transport failure. Closing it here filed a
  # STRANDED report as reported. The marker still wins: `_report_evidence`
  # returns `marker` first, so a delivered report never lands in this arm.
  local stranded=0
  case "$ev" in
    "token "*" undelivered") stranded=1 ;;
  esac
  case "$ev" in
    none) reasons="${reasons}${reasons:+
}  · task $seq has NOT reported: no $(_run_done_marker "$rundir"), and $pane publishes no done token either. Closing it now files finished-or-unfinished work as neither." ;;
  esac
  if [ "$stranded" = 1 ]; then
    reasons="${reasons}${reasons:+
}  · task $seq is STRANDED: $pane published its report (done_state=undelivered) and the brainer never received it — no $(_run_done_marker "$rundir"). Closing the pane discards the only place that report can still be redelivered from." ;
  fi
  if [ "$status" = working ] && [ "$self_close" = 0 ]; then
    reasons="${reasons}${reasons:+
}  · $pane is WORKING right now — a turn is in progress and this close would cut it mid-turn. hw dispatched no turn into it: after a report, hw next is the only re-task route and it advances the task counter first." ;
  fi
  if [ -n "$post" ] && [ "$self_close" = 0 ]; then
    reasons="${reasons}${reasons:+
}  · $post turn(s) ended in $pane AFTER its report, and hw dispatched none of them. Somebody is talking to this pane." ;
  fi
  [ -n "$reasons" ] || return 0

  # REPORTED AND STILL WORKING, WITH NOBODY TALKING TO IT, IS A PANE FINISHING,
  # NOT A PANE IN USE. Measured 2026-09-28/29: right after `done-invoker` the
  # executor's pane still runs the turn that sent the report, herdr says
  # `working`, and `hw done` answered "nothing was closed. Establish who owns
  # that pane" — the wording for a stranger's session — to a brainer who only
  # needed to run the same command a few seconds later. The refusal stands (the
  # turn is real and the close would cut it); what changes is that it says which
  # of the two it is. Any other reason (no report, turns after the report)
  # keeps the ownership wording: those ARE somebody else's.
  local finishing=0
  if [ "$ev" != none ] && [ "$stranded" = 0 ] && [ "$status" = working ] && [ "$self_close" = 0 ] && [ -z "$post" ] && [ "$focus" != true ]; then
    finishing=1
  fi
  if [ "$finishing" = 1 ]; then
    warn "hw done REFUSED for $proj:$task — its pane has REPORTED and is STILL FINISHING its last turn:"
  else
    warn "hw done REFUSED for $proj:$task — this pane is in use:"
  fi
  printf '%s\n' "$reasons" | while IFS= read -r _r; do [ -z "$_r" ] || warn "$_r"; done
  _report_evidence_explain "$pane" "$ev" "$(_run_done_marker "$rundir")"
  if [ "$focus" = true ]; then
    warn "  · and it is FOCUSED: a human has this pane on screen right now. (Evidence only — an unfocused pane can be just as much in use, so this never decides on its own.)"
  fi
  # BEFORE THE CLOSE, NEVER AFTER. See the section comment: the recovery door is
  # worth nothing if it is announced once the session is already gone.
  revive_note="$(_done_revive_line "$proj" "$task" "$rundir")"
  [ -z "$revive_note" ] || info "$revive_note"
  if [ "$finishing" = 1 ]; then
    die "NOT CLOSED YET — nothing was closed: the report is in and hw sees no turn after it, so this is most likely the turn that sent it ending (if the pane is still working after a minute, somebody is talking to it — hw status). Run the same command again in a few seconds: hw done $proj $task   (--force would cut that turn)"
  fi
  if [ "$stranded" = 1 ]; then
    die "nothing was closed: the report is STRANDED. Redeliver it first (\`hw outbox flush $proj --to <brainer-pane>\`; do NOT re-run done-invoker if its exit was 5 — the report may already be there); close it deliberately, discarding the undelivered report, with: hw done $proj $task --force"
  fi
  die "nothing was closed. Establish who owns that pane — look at it — and then either let it finish, or close it deliberately with: hw done $proj $task --force"
}
# The recovery command, with the one precondition that decides whether it will
# work stated rather than implied. `cmd_revive` refuses a run whose receipt
# recorded no `session_resume` (58 of setup's 143 receipts are in that state),
# and a brainer reading `hw revive` as a promise in the moment of panic is
# exactly the wrong time to find that out.
_done_revive_line() {  # $1=project $2=task $3=rundir
  local rundir="$3"
  if [ -n "$rundir" ] && [ -r "$rundir/receipt.jsonl" ] \
     && grep -q '"key": *"session_resume"' "$rundir/receipt.jsonl" 2>/dev/null; then
    printf 'if this closes and you wanted it back: hw revive %s %s — run %s recorded a session_resume, so the conversation is addressable' \
      "$1" "$2" "$(basename "$rundir")"
    return 0
  fi
  printf 'NOTE: hw revive %s %s will NOT bring this back — %s recorded no session_resume, so the conversation is not addressable and closing is final for it' \
    "$1" "$2" "${rundir:+$(basename "$rundir")}"
}

# WHAT `hw done` SAYS ABOUT ITSELF: WHAT IT DID, AND WHERE THE SECONDS WENT.
# Measured 2026-09-28/29: the close itself is milliseconds (herdr answers in
# ~10ms, the brain-leak scan ~0.15s); the seconds are `_verify_at_close`, which
# runs the brief's own ## Verification command — the fast gate ~55s, a full
# suite up to 900s, plus up to 900s waiting for the lane's suite lock — BEFORE
# anything closes. A caller whose tool gives up at 120s could not tell that from
# a hang, and could not tell a close that happened from one that did not. So
# `_done_outcome` names one of three facts the moment the close is decided, and
# `cmd_done` ends with the clock split into the step that took it and the rest.
_DONE_VERIFY_SECONDS=0
_done_outcome() {  # $1=project $2=task $3=what herdr was asked to close, or "" when nothing was there
  case "${_HERDR_CLOSE_RESULT:-}" in
    closed) ok "CLOSED: $3 — this call closed it ($1:$2)" ;;
    absent) info "NOTHING TO CLOSE: $3 was already gone when hw asked — this call closed nothing, and that is not a failure ($1:$2)" ;;
    failed) warn "NOT CLOSED — FAILED: $3 may still be RUNNING; this call did not close it and exits non-zero ($1:$2). Look before anything else: hw status" ;;
    *)      info "NOTHING TO CLOSE: no open tab or space labelled $1:$2 — closed earlier or never opened, so this call closed nothing, and that is not a failure" ;;
  esac
}
# NO WRAPPER, ON PURPOSE. A function called on the left of `||` (or in an `if`)
# runs with errexit OFF for its whole body and everything it calls — a wrapper
# `_body || _rc=$?` silently turned every unguarded failure in here (a `local x=$(die…)`
# in the lease path, a failed `_lease_write`) into "carry on", one of which closes
# the pane. Found by both Judgment Day judges. So the clock is read at the top
# of cmd_done and printed by `_done_took` at each return.
_done_took() {
  local total=$(( $(date +%s) - ${_DONE_T0:-$(date +%s)} ))
  if [ "$total" -ge 5 ]; then
    info "hw done took ${total}s: verification ${_DONE_VERIFY_SECONDS}s, everything else $(( total - _DONE_VERIFY_SECONDS ))s"
  fi
}
cmd_done() {
  local proj="$1" task="$2" main wt branch close_failed=0
  _DONE_T0="$(date +%s)"; _DONE_VERIFY_SECONDS=0
  lane_known "$proj" || die "unknown project: $proj (expected: $(lane_names_bar))"
  main="$(_lane_main_checkout "$proj")"
  wt="$(_lane_wt_dir "$proj" "$task")"
  [ -n "$wt" ] || wt="$WORK/$proj/$task"
  branch="$(_lane_branch "$proj" "$task")"

  # Capture first: close verification can run for 900 seconds, and the live pane
  # is the only source for an old report that went to the wrong brainer.
  local done_rundir
  done_rundir="$(_task_rundirs "$proj" "$task" | head -1)"
  [ -z "$done_rundir" ] || _snapshot_done_report "$done_rundir"
  # BEFORE ANYTHING IS CLOSED OR CLEARED — before the reopened marker is
  # removed, before the 900s close verification, and long before a tab goes. A
  # refusal arriving after any of those has already spent what it exists to save.
  #
  # NOT "before anything is touched", which is what this said until the scoped
  # re-judgment called it: `_snapshot_done_report` above already ran, and it
  # appends to the run's receipt. That snapshot is idempotent and informational
  # and it deliberately stays first — the live pane is the only source for an
  # old report, and a 900s verification would lose it — but the claim was
  # wider than the code and is narrowed rather than left standing.
  _done_in_use_guard "$proj" "$task" "$done_rundir"
  # A run `hw revive` reopened leaves the board again when it is closed, whether
  # its executor reported a second time or a human closed it: the marker is a
  # statement that a live pane is expected, and after this there is none.
  if [ -n "$done_rundir" ] && [ -f "$(_run_reopened_marker "$done_rundir")" ]; then
    rm -f "$(_run_reopened_marker "$done_rundir")" 2>/dev/null || true
    info "run was reopened by hw revive; closing it clears that marker"
  fi

  # BEFORE ANYTHING IS CLOSED. The verification runs in the task's directory and
  # every close path below reaches an end — including `--keep-preview`, which
  # returns early. Running it first means the measurement exists whichever way
  # this task leaves.
  local _v0; _v0="$(date +%s)"
  _verify_at_close "$(_task_rundirs "$proj" "$task" | head -1)" "$wt" "$proj" "$task"
  _DONE_VERIFY_SECONDS=$(( $(date +%s) - _v0 ))
  # And before anything closes: a product task does not leave with a commit that
  # carries a brain path. The push guard sees the same scan, but a branch the
  # operator pushes or merges after this never passes through it.
  PROJ="$proj" _brain_leak_at_close "$proj" "$wt" "$branch"

  # TAB FIRST, AND A TAB RECORD CAN NEVER CLOSE A WORKSPACE. hw has closed other
  # people's agents before — a cleanup that worked by exclusion once
  # killed a live brainer's own executors — and the answer then was
  # that nothing is closed without an ownership record naming it. Tabs inherit
  # that rule exactly: `.hw/<run>/tab` licenses a `tab close` and nothing else,
  # `.hw/<run>/workspace` licenses a `workspace close` and nothing else. Runs that
  # predate tab mode have only the second, so this is compatible by construction.
  local rundir_tab="" tab="" ws=""
  rundir_tab="$(_latest_run_record "$proj" "$task" tab)"
  if [ -n "$rundir_tab" ]; then
    tab="$rundir_tab"
  else
    tab="$(_tab_id_by_label "$proj:$task")"
  fi
  # UNDER A LEASE, THE AGENT GOES AND THE PREVIEW STAYS. Closing the tab takes
  # the dev pane with it, which is exactly the coupling the lease exists to
  # break: the executor is finished, the preview is not.
  if [ "${KEEP_PREVIEW:-0}" = 1 ]; then
    local lease_run agent_pane secs
    lease_run="$(_task_rundirs "$proj" "$task" | head -1)"
    [ -n "$lease_run" ] || die "no hw run directory for $proj:$task, so there is nothing to write a lease against."
    secs="$(_lease_seconds "$KEEP_FOR")"
    agent_pane="$(jq -r 'select(.key=="pane") | .value' "$lease_run/receipt.jsonl" 2>/dev/null | tail -1)"
    if [ -n "$agent_pane" ]; then
      _close_herdr_object pane "$agent_pane" \
        "agent pane $agent_pane closed — the executor is released" \
        "agent pane $agent_pane is already gone" || return 1
    else
      warn "no pane receipt for this run, so the agent pane could not be identified; nothing was closed"
    fi
    _lease_write "$lease_run" "$secs" "$KEEP_WHY"
    ok "preview LEASED until $(_lease_field "$lease_run" until_h) — tab $tab, database and ports kept"
    info "why: $KEEP_WHY"
    [ -z "${HW_PORT_WEB:-}" ] || info "preview: http://127.0.0.1:$HW_PORT_WEB"
    info "release it with: hw preview release $proj $task   (then hw done $proj $task --drop-db)"
    info "hw reap will refuse this worktree while the lease holds, and hw status shows it expiring"
    _done_took
    return 0
  fi
  # THE EXIT IS ANNOUNCED BEFORE THE FIRE, NOT AFTER. On 2026-09-16 a close
  # that turned out to be a mistake was recoverable the whole time and nobody
  # in the room knew the command. It costs one line, and the only moment it is
  # useful is the moment before.
  _done_revive_pre="$(_done_revive_line "$proj" "$task" "$done_rundir")"
  [ -z "$_done_revive_pre" ] || info "$_done_revive_pre"
  _HERDR_CLOSE_RESULT=""
  if [ -n "$tab" ]; then
    _close_herdr_object tab "$tab" \
      "tab $tab closed ($proj:$task)" \
      "tab $tab is already gone" || close_failed=1
    _done_outcome "$proj" "$task" "tab $tab"
  else
    ws="$(_ws_id_by_label "$proj:$task")"
    if [ -n "$ws" ]; then
      _close_herdr_object workspace "$ws" \
        "space $ws closed" \
        "space $ws is already gone" || close_failed=1
      _done_outcome "$proj" "$task" "space $ws"
    else
      info "no open tab or space labelled $proj:$task"
      _done_outcome "$proj" "$task" ""
    fi
  fi

  # A repo-less task has no branch to merge and no ports to free. What it does
  # have is a directory of artifacts, which is the whole output — reported,
  # never removed.
  if _is_repoless "$proj"; then
    if [ -d "$wt" ]; then
      local n sz
      # Exclude .hw: those are hw's own control files, not the task's output.
      # Reporting them as artifacts made an empty task look like it produced two.
      n="$(find "$wt" -type f -not -path '*/.hw/*' 2>/dev/null | wc -l | tr -d ' ' || true)"; : "${n:=0}"
      sz="$(du -sh "$wt" 2>/dev/null | awk '{print $1}')"
      if [ "$n" = 0 ]; then
        info "no artifacts in $wt (correct when the output was a report)"
      else
        warn "artifacts KEPT in $wt ($n files, $sz) — hw never deletes them"
      fi
    else
      info "no work directory at $wt"
    fi
    printf "\n  ${C_B}Nothing to merge:${C_0} %s has no repository.\n  Move anything worth keeping out of %s yourself.\n\n" "$proj" "$wt"
    _done_took
    return "$close_failed"
  fi

  # Ports are freed by the dev servers dying with their panes; nothing to unbind.
  info "ports released with the panes"

  # The database outlives the space on purpose: it holds whatever state the task
  # produced. hw reports it and, only when asked, drops it — dropping by default
  # would silently destroy work whose only copy is in that database. Which lane
  # has one is the table's `db.provisioned`; every other lane gets the same
  # one line, spelled with its own name.
  if [ -n "$(lane_get "$proj" db_provisioned)" ]; then
    local db; db="$(basename "$wt" | tr '\-/' '__')"
    if psql -U "$(id -un)" -d postgres -Atc "select 1 from pg_database where datname = '$db'" 2>/dev/null | grep -q 1; then
      local size; size="$(psql -U "$(id -un)" -d postgres -Atc "select pg_size_pretty(pg_database_size('$db'))" 2>/dev/null)"
      if [ "$DROP_DB" = 1 ]; then
        if psql -U "$(id -un)" -d postgres -q -c "DROP DATABASE \"$db\"" 2>/dev/null; then
          ok "database $db dropped (was $size)"
        else
          warn "could not drop $db — open connections? try again once the panes are gone"
        fi
      else
        warn "database $db is STILL LIVE ($size) — drop it with: hw done $proj $task --drop-db"
      fi
    else
      info "no database named $db"
    fi
  else
    info "$proj has no per-worktree database to release"
  fi

  BASE_BRANCH="$(_lane_base "$proj")"; : "${BASE_BRANCH:=main}"

  # Printed, never run: deleting a worktree or a branch is the user's call.
  #
  # BUT NOT PRINTED BLINDLY ANY MORE. This block used to end with
  # `git worktree remove $wt` on every done, whatever the worktree held. For
  # a product lane's coords-reconcile that line destroys `_coords-export/` —
  # 588K of raw.json and four CSVs, the 754 rows that went to Mike — because the
  # directory is git-ignored and `git status` therefore says clean. A command
  # printed under the heading "clean up" is a command that gets pasted.
  # NOTHING TO MERGE IF NOTHING WAS BRANCHED. A `--worktree none` task runs in a
  # repo-less work directory and never creates `task/<name>`, and printing a
  # merge for a branch that does not exist is the same defect as printing
  # `git worktree remove` for a worktree that holds unreproducible data: a
  # command under a confident heading gets pasted. Asked of git, not inferred
  # from the flags — the run that created this task may not be the one closing it.
  # A BRANCH EXISTING IS NOT WORK BEING ON IT. The check above asked git whether
  # the ref exists and stopped there — so on 2026-08-25 `hw done <lane>
  # classic-stage-impl` printed a full merge recipe for `task/classic-stage-impl`
  # while that branch was at develop with ZERO commits and the entire day of work
  # sat as 39 uncommitted files in the worktree. Paste that recipe and it merges
  # nothing, cleanly, and you walk away believing the work landed. That is the
  # same defect the existence check was added to fix, one level down: a confident
  # heading over a command whose signal does not support it.
  # COUNT AGAINST origin/$BASE_BRANCH WHEN IT EXISTS, AND NAME WHICHEVER REF WAS
  # USED. This used to run "$BASE_BRANCH..$branch" against the LOCAL checkout
  # only — on a READ-ONLY task whose local main was six days stale, that
  # printed "11 commits — merge it" while origin/main..task/<x> was empty.
  # "11 commits" with no subject is an unverifiable claim; naming the ref is
  # the fix, not a flag to pick one.
  local ahead=0 ahead_ref="$BASE_BRANCH" ahead_note=""
  if git -C "$main" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
    if git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$BASE_BRANCH" 2>/dev/null; then
      ahead_ref="origin/$BASE_BRANCH"
      local fetch_head fetch_epoch
      # --git-path prints a path RELATIVE TO $main, not to this process's cwd
      # or an absolute path — unprefixed, `[ -f "$fetch_head" ]` checked the
      # wrong directory and silently found nothing.
      fetch_head="$(git -C "$main" rev-parse --git-path FETCH_HEAD 2>/dev/null || true)"
      [ -z "$fetch_head" ] || fetch_head="$main/$fetch_head"
      if [ -n "$fetch_head" ] && [ -f "$fetch_head" ]; then
        fetch_epoch="$(date -r "$fetch_head" +%s 2>/dev/null || echo 0)"
        if [ "$fetch_epoch" -gt 0 ]; then
          ahead_note=" (origin fetched $(( ($(date +%s) - fetch_epoch) / 3600 ))h ago)"
        fi
      fi
    else
      ahead_note=" (no origin/$BASE_BRANCH — counted against the local checkout, which may be behind origin)"
    fi
    ahead="$(git -C "$main" rev-list --count "$ahead_ref..$branch" 2>/dev/null || echo 0)"
    case "$ahead" in ''|*[!0-9]*) ahead=0 ;; esac
  fi
  local dirty=0
  # `grep -c` prints its count AND exits 1 when that count is zero, so
  # `|| echo 0` appended a second "0" and a CLEAN worktree made the test below
  # print `[: integer expression expected` — reproduced 2026-09-01 against an
  # empty repo with HEAD's line: dirty=$'0\n0'. The count is already there; only
  # the exit needs swallowing, and anything that is still not a number is 0.
  # THE EXIT CODE, NOT JUST THE COUNT. `git status | grep -c '^'` prints 0 for a
  # FAILED status exactly as for a clean tree, and `$dirty` decides whether the
  # "THE WORK IS NOT ON THE BRANCH" warning below is printed at all. A zero
  # nobody measured suppresses the warning that exists to stop work being lost.
  local dirty_rc=0
  if [ -d "$wt" ]; then
    dirty="$(git -C "$wt" status --porcelain 2>/dev/null)" || dirty_rc=$?
    if [ "$dirty_rc" -ne 0 ]; then
      dirty=unknown
    else
      dirty="$(printf '%s' "$dirty" | grep -c '^' || true)"
    fi
  fi
  case "$dirty" in unknown) ;; ''|*[!0-9]*) dirty=0 ;; esac
  # THE RECIPE NAMES ONLY REMOTES THE LANE ACTUALLY HAS.
  #
  # MEASURED 2026-09-16, on the first setup close that reached this block: brain
  # has NO `origin` — its remotes are `backup` (a local bare repo) and `github`
  # (the sanitized export) — and the recipe printed `git fetch origin` and
  # `git pull` under the heading "Merge it:". Pasted, that is
  # `fatal: 'origin' does not appear to be a git repository`, on the one command
  # a brainer runs to land a task's work. The block was unreachable for setup
  # until the lane left REPOLESS in this same change, so it is a defect this
  # change introduced rather than one it exposed.
  #
  # THE FACT IS ALREADY COMPUTED ten lines up: `$ahead_ref` is
  # `origin/$BASE_BRANCH` when that remote-tracking ref exists and the bare
  # local branch when it does not. Asking the same question a second way is how
  # two answers start to disagree.
  local sync_lines=""
  case "$ahead_ref" in
    origin/*) sync_lines="  git fetch origin"$'\n'"  git checkout $BASE_BRANCH"$'\n'"  git pull" ;;
    *)        sync_lines="  git checkout $BASE_BRANCH"$'\n'"  ${C_DIM}# no origin in $main — nothing to fetch or pull${C_0}" ;;
  esac
  if git -C "$main" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null && [ "$ahead" -gt 0 ]; then
    cat <<EOF

${C_B}Merge it:${C_0}

  cd $main
$sync_lines
  git merge --no-ff $branch          # $ahead commit(s) against $ahead_ref$ahead_note — or open a PR and squash-merge it

EOF
  elif git -C "$main" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
    printf '\n'
    warn "NOTHING TO MERGE: $branch exists but is level with $ahead_ref — 0 commits.$ahead_note"
    if [ "$dirty" = unknown ]; then
      warn "and whether the worktree holds uncommitted changes could NOT be read (git status failed). That is not the same as none — look before you remove anything."
    elif [ "$dirty" -gt 0 ]; then
      warn "and the worktree holds $dirty uncommitted change(s). THE WORK IS NOT ON THE BRANCH."
      warn "It exists in exactly one place: $wt"
      warn "Commit it there before anything else, or it is one \`git worktree remove\` from gone:"
      printf '\n  git -C %s add -A && git -C %s commit -m "<what this is>"\n\n' "$wt" "$wt"
      warn "\`hw reap\` already refuses this worktree while it is dirty, so nothing is lost right now."
    else
      info "the worktree is clean too, so this task produced no committed change"
    fi
  else
    printf '\n'
    info "no branch $branch in $main — nothing to merge"
    info "that is expected for a --worktree none task: it ran in a work directory, not a worktree"
  fi
  # ASK GIT WHERE IT IS, don't assume the canonical path. coords-reconcile still
  # lives at the pre-2026-08-22 root outside the repo, so the assumed path did not
  # exist and this printed "already gone" about a worktree holding 588K of export.
  # A wrong reassurance is worse than a wrong command.
  if [ ! -d "$wt" ] && [ -n "$branch" ]; then
    local found
    found="$(git -C "$main" worktree list --porcelain 2>/dev/null \
      | awk -v b="refs/heads/$branch" '/^worktree /{w=$2} /^branch /{if ($2==b) print w}' | head -1)"
    if [ -n "$found" ] && [ -d "$found" ]; then
      wt="$found"
      warn "its worktree is not at the canonical root: $wt"
    fi
  fi
  if [ ! -d "$wt" ]; then
    printf '  %sno worktree for %s — already removed, or it never had one%s\n\n' "$C_DIM" "$branch" "$C_0"
    _done_took
    return "$close_failed"
  fi
  _wt_disposition "$main" "$wt" "$branch" "${BASE_BRANCH:-main}"
  if [ "$WT_VERDICT" = safe ]; then
    # `safe` answers "does git need this directory". It does not answer "does a
    # recorded session need it": `hw revive` repeats the cwd from the receipt
    # and refuses when it is gone, so removing a safe worktree is also the one
    # act that makes its session unrevivable. Said on the line that gets pasted.
    local revive_note=""
    if [ -n "$done_rundir" ] && [ -r "$done_rundir/receipt.jsonl" ] \
       && [ -n "$(jq -r 'select(.key=="session_resume") | .value' "$done_rundir/receipt.jsonl" 2>/dev/null | tail -1)" ]; then
      revive_note="  ${C_DIM}# its session is still revivable with: hw revive $proj $task — removing the worktree closes that door${C_0}"$'\n'
    fi
    # Same rule as the merge recipe above: a lane with no `origin` is not told
    # to delete a branch from one.
    local push_line
    case "$ahead_ref" in
      # `$branch`, NOT `\$branch`. The value is built HERE and interpolated into
      # the heredoc below, and a heredoc expands what it is given exactly once —
      # it does not re-scan the substituted text. Escaped, the recipe printed the
      # seven literal characters `$branch` on every lane that HAS an origin,
      # which is the four product lanes: the everyday
      # case, not the no-origin lane this whole block was written for. The line
      # directly under it in the same heredoc, `git branch -d $branch`,
      # substitutes correctly — so the recipe contradicted itself two lines
      # apart. Caught by both Judgment Day judges and reproduced before fixing.
      origin/*) push_line="  git push origin --delete $branch   ${C_DIM}# only if it was pushed${C_0}"$'\n' ;;
      *)        push_line="  ${C_DIM}# no origin in $main — the branch exists only here${C_0}"$'\n' ;;
    esac
    cat <<EOF
${C_B}Then remove it — checked, and safe:${C_0}
  ${C_DIM}$WT_WHY${C_0}
$revive_note
  git worktree remove $wt
  git branch -d $branch
$push_line
EOF
  else
    printf '  %s%s DO NOT REMOVE THIS WORKTREE YET%s\n' "$C_WARN" "!" "$C_0"
    printf '      %s%s%s\n' "$C_DIM" "$WT_WHY" "$C_0"
    case "$WT_VERDICT" in
      irreplaceable)
        printf '      %sgit status reports this worktree clean and it is not — those paths are%s\n' "$C_DIM" "$C_0"
        printf '      %signored, so `git worktree remove` would delete them with no warning.%s\n' "$C_DIM" "$C_0"
        printf '      %sMove what you need out first, then re-run `hw done` or `hw reap`.%s\n' "$C_DIM" "$C_0" ;;
      unmerged)
        printf '      %sMerge it first (above), then `hw reap %s`.%s\n' "$C_DIM" "$proj" "$C_0" ;;
      dirty)
        printf '      %sCommit or discard those changes, then `hw reap %s`.%s\n' "$C_DIM" "$proj" "$C_0" ;;
      held)
        printf '      %sThat pane is still sitting in it. Nothing to do until it moves.%s\n' "$C_DIM" "$C_0" ;;
      not-a-worktree)
        printf '      %sNothing to remove and nothing to merge: no branch was ever created for it.%s\n' "$C_DIM" "$C_0"
        printf '      %sIts contents are the task output. Move what is worth keeping, then delete it by hand.%s\n' "$C_DIM" "$C_0" ;;
      undetermined)
        printf '      %sThis is NOT a verdict that the worktree is needed — it is the absence of one.%s\n' "$C_DIM" "$C_0"
        printf '      %sFix what could not be read, then re-run. Do not remove it on the strength of%s\n' "$C_DIM" "$C_0"
        printf '      %sa check that did not run: that is how 588K went once.%s\n' "$C_DIM" "$C_0" ;;
      leased)
        printf '      %sSomebody is still going to look at this preview. `hw preview` shows who and until when;%s\n' "$C_DIM" "$C_0"
        printf '      %s`hw preview release %s <task>` ends it early.%s\n' "$C_DIM" "$proj" "$C_0" ;;
    esac
    printf '      %sSurvey every worktree the same way: hw reap %s%s\n\n' "$C_DIM" "$proj" "$C_0"
  fi
  _done_took
  return "$close_failed"
}


# ── reap: the merge-and-remove half, but only where it is provably safe ─────
#
# `hw done` closes the space. This is the other half, and it stays a SEPARATE
# command on purpose: closing a space is reversible and per-task, removing a
# worktree and deleting a branch is neither and is worth looking at across a whole
# repo at once. Dry run by default; `--apply` touches only `safe`.
# ── hw preview ──────────────────────────────────────────────────────────────
#
# What is being held, by whom, until when, and for whose eyes. A lease that
# cannot be listed is just a file nobody reads.
cmd_preview() {
  local action="${1:-list}" proj task
  case "$action" in
    list)
      local found=0 lane t base r until_h why
      printf '\n'
      for lane in $HW_LANES; do
        base="$(_wt_canonical_root "$lane")" || base="$WORK/$lane"
        [ -d "$base" ] || continue
        while IFS= read -r t; do
          [ -n "$t" ] || continue
          r="$(_leased_rundir_for "$t" 2>/dev/null)" || {
            # expired leases are worth showing too: they are the ones to release
            local rr
            for rr in $(fd -H -t d -d 1 '^2[0-9]{7}-[0-9]{6}-[0-9]+$' "$t/.hw" 2>/dev/null | sort -r); do
              if [ -r "$(_lease_path "$rr")" ]; then
                found=1
                printf '  %s%-34s%s %sEXPIRED%s  %s\n' "$C_B" "$lane:$(basename "$t")" "$C_0" \
                  "$C_WARN" "$C_0" "$(_lease_field "$rr" why)"
                printf '      %sexpired %s · release: hw preview release %s %s%s\n' \
                  "$C_DIM" "$(_lease_field "$rr" until_h)" "$lane" "$(basename "$t")" "$C_0"
                break
              fi
            done
            continue
          }
          found=1
          printf '  %s%-34s%s %sheld%s     %s\n' "$C_B" "$lane:$(basename "$t")" "$C_0" \
            "$C_OK" "$C_0" "$(_lease_field "$r" why)"
          printf '      %suntil %s · by %s · release: hw preview release %s %s%s\n' \
            "$C_DIM" "$(_lease_field "$r" until_h)" "$(_lease_field "$r" by)" "$lane" "$(basename "$t")" "$C_0"
        done < <(fd -H -t d -d 1 . "$base" 2>/dev/null)
      done
      [ "$found" = 1 ] || info "no preview leases"
      printf '\n'
      ;;
    release)
      proj="$(_canon_project "${2:-}")"; task="${3:-}"
      [ -n "$task" ] || die "usage: hw preview release <project> <task>"
      local r n=0
      while IFS= read -r r; do
        [ -n "$r" ] || continue
        if [ -r "$(_lease_path "$r")" ]; then rm -f "$(_lease_path "$r")" && n=$((n + 1)); fi
      done < <(_task_rundirs "$proj" "$task")
      if [ "$n" = 0 ]; then
        info "no lease on $proj:$task — nothing to release"
      else
        ok "released $n lease(s) on $proj:$task"
        info "the preview is still RUNNING: this only removed the protection. Close it with: hw done $proj $task --drop-db"
      fi
      ;;
    *) die "usage: hw preview [list] | hw preview release <project> <task>" ;;
  esac
  return 0
}

cmd_reap() {
  local apply=0 proj_filter=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --apply) apply=1; shift ;;
      -h|--help) echo "usage: hw reap [<project>] [--apply] — surveys the lane's git worktrees AND the loose work dirs beside them ($WORK/<lane>), which git worktree list cannot see" >&2; return 0 ;;
      -*) die "unknown option: $1" ;;
      *) proj_filter="$(_canon_project "$1")"; shift ;;
    esac
  done

  local proj main base total_safe=0 total_kept=0
  while IFS= read -r proj; do
    [ -z "$proj_filter" ] || [ "$proj_filter" = "$proj" ] || continue
    main="$(_wt_main "$proj")" || continue
    [ -d "$main" ] || continue
    base="$(_lane_base "$proj")"
    : "${base:=main}"
    printf '\n  %s%s%s  (base %s)\n' "$C_B" "$proj" "$C_0" "$base"
    local seed_from
    seed_from="$(lane_get "$proj" reap_copies_from)" || seed_from=""
    if [ -n "$seed_from" ]; then
      _wt_seed_patterns "$main/$seed_from" >/dev/null 2>&1 || true
      info "$WT_SEED_NOTE"
    fi

    local wt branch
    while IFS= read -r wt; do
      [ -n "$wt" ] || continue
      [ "$wt" = "$main" ] && continue
      branch="$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null || echo detached)"
      _wt_disposition "$main" "$wt" "$branch" "$base"
      if [ "$WT_VERDICT" = safe ]; then
        total_safe=$((total_safe + 1))
        if [ "$apply" = 1 ]; then
          if git -C "$main" worktree remove "$wt" 2>/dev/null; then
            ok "removed $(basename "$wt")"
            if git -C "$main" branch -d "$branch" >/dev/null 2>&1; then
              info "deleted $branch"
            else
              warn "kept $branch — git refused a safe delete, so something is not merged after all"
            fi
          else
            warn "could not remove $wt — run it by hand and read what git says"
          fi
        else
          ok "$(basename "$wt")  ${C_DIM}$WT_WHY${C_0}"
          printf '      %sgit -C %s worktree remove %s && git -C %s branch -d %s%s\n' \
            "$C_DIM" "$main" "$wt" "$main" "$branch" "$C_0"
        fi
      else
        total_kept=$((total_kept + 1))
        printf '  %s!%s %-42s %s%s: %s%s\n' "$C_WARN" "$C_0" "$(basename "$wt")" \
          "$C_DIM" "$WT_VERDICT" "$WT_WHY" "$C_0"
      fi
    done < <(git -C "$main" worktree list --porcelain 2>/dev/null | rg '^worktree ' | sd '^worktree ' '')

    # ── second pass: the loose work dirs ──────────────────────────────────
    #
    # SEPARATE PASS, SEPARATE VOCABULARY, ON PURPOSE. It is not a widening of
    # the loop above: the loop above asks git what exists and this one asks the
    # filesystem, the two inventories overlap on the `setup` lane only (where
    # both live under $WORK/setup), and `_workdir_disposition` hands anything
    # git owns straight back with the verdict `worktree` rather than ruling on
    # it a second time. Nothing about how a WORKTREE is classified moves.
    #
    # $WORK/<lane> IS THE WHOLE TREE IT LOOKS AT — the `lane_work_bases` arm
    # that is not a repo's `.worktrees`, which is exactly where a `--here` or a
    # `--worktree none` task lands. No new root, no new lane.
    local wd wd_root="$WORK/$proj" loose_seen=0
    if [ -d "$wd_root" ]; then
      while IFS= read -r wd; do
        [ -n "$wd" ] || continue
        _workdir_disposition "$proj" "$wd"
        [ "$WD_VERDICT" = worktree ] && continue
        loose_seen=$((loose_seen + 1))
        if [ "$WD_VERDICT" = safe ]; then
          total_safe=$((total_safe + 1))
          if [ "$apply" = 1 ]; then
            if _reap_rm_workdir "$wd"; then
              ok "removed $(basename "$wd")  ${C_DIM}(loose work dir)${C_0}"
            else
              warn "could not remove $wd — it read as safe and the delete failed, which is the one outcome worse than keeping it. Run it by hand and read what rm says."
            fi
          else
            ok "$(basename "$wd")  ${C_DIM}loose work dir: $WD_WHY${C_0}"
            printf '      %srm -rf %s%s\n' "$C_DIM" "$wd" "$C_0"
          fi
        else
          total_kept=$((total_kept + 1))
          printf '  %s!%s %-42s %s%s: %s%s\n' "$C_WARN" "$C_0" "$(basename "$wd")" \
            "$C_DIM" "$WD_VERDICT" "$WD_WHY" "$C_0"
        fi
      done < <(fd -H -t d -d 1 . "$wd_root" 2>/dev/null | sd '/$' '' | sort)
    fi
    [ "$loose_seen" != 0 ] || info "no loose work dirs under $wd_root"
  done < <(_repo_lanes)

  # Leave the count where `hw status` can show it without repeating the survey.
  # See _reap_quiet: this whole scan is ~4s of git, which is fine for a command
  # you run on purpose and wrong for a glance you run at every session start.
  printf '%s %s\n' "$total_safe" "$(date +%s)" > "$BRAIN/.hw-reap-count" 2>/dev/null || true

  printf '\n'
  if [ "$apply" = 1 ]; then
    ok "$total_safe removed, $total_kept kept"
  else
    info "$total_safe safe to remove, $total_kept kept. Add --apply to remove the safe ones."
    [ "$total_kept" = 0 ] || info "nothing kept is ever removed by --apply, whatever the reason says"
    [ "$total_kept" = 0 ] || info "an ignored path that IS disposable here: HW_WT_REGENERABLE='<name> <name>' hw reap"
  fi
}

# ── sweep ───────────────────────────────────────────────────────────────────
#
# Close the spaces of runs that ALREADY REPORTED, and nothing else. This exists
# because the alternative people actually reach for is "close everything that is
# not my three live spaces", and on 2026-08-21 that killed three executors that
# were mid-task — reproducibly, a couple of minutes after each launch, in a way
# that read as a herdr fault. Exclusion cannot tell a stranger's space from a
# leftover; ownership can.
#
# Two conditions, both required, both read from disk:

# The done marker of a run's CURRENT task. A run is an EXECUTOR and `hw next`
# re-tasks a living one, so "did it report?" is a question about the newest task:
# task 1 keeps the run directory, t2/, t3/ … hold the ones after it.
# See invoker-common.sh for why the counter is a file and not an environment
# variable — the executor's HW_RUN is frozen in its process environment.
_run_done_marker() {
  local rundir="$1" seq=""
  # `[ -r ]` first — the redirect is the shell's, and task 1 has no counter file.
  [ -r "$rundir/task" ] && seq="$(tr -dc '0-9' < "$rundir/task" 2>/dev/null || true)"
  case "$seq" in
    ''|0|1) printf '%s/done' "$rundir" ;;
    *)      printf '%s/t%s/done' "$rundir" "$seq" ;;
  esac
}

# Beside the done marker, same task directory: written by `hw revive` when it
# brings back a run that had already reported, read by done-invoker (which then
# accepts a report without --retask), executor-turn-end, sweep and status.
_run_reopened_marker() {
  local m; m="$(_run_done_marker "$1")"
  printf '%s/reopened' "${m%/done}"
}

# ── hw worktrees: one location per repo, across every harness ───────────────
#
# THE PROBLEM THIS ANSWERS. hw puts a product-lane worktree in ONE place regardless of
# --agent: `<repo>/.worktrees/<task>`, the location scripts/new-worktree.sh
# already uses. Nothing in the launch path branches on the vendor, so hw itself
# is the same everywhere. The divergence comes from a harness used DIRECTLY: Codex's own
# worktree feature creates `~/.codex/worktrees/<hash>/<repo>` — outside the repo,
# under a hash nobody can read, and invisible to everything here. hw status walks
# the canonical roots, so a worktree outside them is not merely non-standard: it
# does not exist as far as this setup can tell.
#
# WHAT THIS DOES NOT DO. It does not move an occupied worktree. A live agent's
# cwd is the one thing `git worktree move` cannot fix up, and pulling the ground
# out from under a working session is how three executors died on 2026-08-21.
# Occupied strays are reported with the pane that holds them, and that is all.
#
# Worktrees inside `.git` are somebody else's mechanism — review tools have kept
# candidate views there — so they are reported as internal and never touched.
# DERIVED FROM _lane_wt_dir, NOT A FIFTH COPY OF IT. These two tables were
# hand-typed duplicates of tables that already existed 7000 lines up, and the
# duplication had a cost the day `setup` was added: reap surveyed the lane,
# found the canonical root unknown, and reported "0 safe to remove, 0 kept" over
# two real worktrees it could not see — a clean-looking answer about nothing.
# Measured on probe-wt-a/probe-wt-b, 2026-09-16, before this derivation.
#
# `setup` is also the lane that proves a literal would have been wrong here:
# its worktrees are NOT under `<main>/.worktrees` (see _lane_wt_dir for the
# measured reason), so the pattern the four other lanes share does not hold.
_wt_canonical_root() {
  local d; d="$(_lane_wt_dir "$1" __probe__)" || return 1
  [ -n "$d" ] || return 1
  printf '%s' "$(dirname "$d")"
}

_wt_main() {
  local m; m="$(_lane_main_checkout "$1")" || return 1
  [ -n "$m" ] || return 1
  printf '%s' "$m"
}

# Which panes are sitting in a given directory, or under it. Read from herdr, not
# inferred: a stray worktree is only safe to move when nothing is working in it.
#
# AND "NOT INFERRED" NOW SURVIVES A HERDR HICCUP. The comment above was true of
# the intent and false of the code: `herdr agent list 2>/dev/null | jq … || true`
# printed nothing when herdr was down, when the socket was gone, when jq choked
# — and nothing is exactly what "no occupants" looks like. That inference ran in
# the UNSAFE direction, on the FIRST gate of `_wt_disposition`, which is checked
# before dirty and before merged precisely so occupancy overrides everything;
# and the consumer of a `safe` verdict is `git worktree remove`, the command
# class that already destroyed 588K once. It is the same root cause as the
# 2026-08-21 incident these comments describe: a cleanup that worked by
# exclusion killed three executors.
#
# THE THREE STATES. Callers read `WT_OCCUPANTS_OBSERVED` alongside stdout:
#   1  observed. `WT_OCCUPANTS` lists them, and EMPTY genuinely means none.
#   0  NOT observed. `WT_OCCUPANTS` is empty and says nothing at all, and
#      `WT_OCCUPANTS_WHY` names what failed. Never read this as "no occupants".
#
# IT ANSWERS THROUGH VARIABLES, NOT STDOUT, and that is not a style choice. The
# caller wrote `occ="$(_wt_occupants "$wt")"`, and a command substitution is a
# SUBSHELL: every flag the function set died with it, so the caller read
# `WT_OCCUPANTS_OBSERVED` as its stale initial 0 forever. Caught 2026-09-07 by
# the test in `setup/tests/90-…` on the first run — a three-valued answer that
# cannot reach its caller is a two-valued answer with extra code.
WT_OCCUPANTS=""
WT_OCCUPANTS_OBSERVED=0
WT_OCCUPANTS_WHY=""
_wt_occupants() {
  local dir="$1" raw rc err
  WT_OCCUPANTS=""
  WT_OCCUPANTS_OBSERVED=0
  WT_OCCUPANTS_WHY=""
  # stderr is KEPT, not discarded: it is the only thing that says WHY, and the
  # diagnosis is the whole point of having a third value. It is folded in only
  # on the failure branch, so it can never be mistaken for an occupant.
  err="$(mktemp "${TMPDIR:-/tmp}/hw-occupants.XXXXXX")" || return 0
  raw="$(herdr agent list 2>"$err")" || {
    rc=$?
    WT_OCCUPANTS_WHY="herdr agent list exited $rc: $(tr '\n' ' ' < "$err" | cut -c1-200)"
    rm -f "$err"; return 0
  }
  # HERDR MUST SAY IT ANSWERED THIS QUESTION. A clean exit is not by itself an
  # answer — `herdr agent read <dead pane>` was measured on 2026-09-07 to exit 0
  # with an error object in stdout.
  #
  # The signal is `.result.type == "agent_list"`, measured on the live daemon
  # the same day, NOT `.result.agents | type == "array"`. Keying on the array
  # would have been the mirror of the bug being fixed: a Judgment Day judge
  # pointed out that nobody here has observed herdr's reply when there are ZERO
  # agents, so if it omits the key rather than sending `[]`, every worktree
  # would read `undetermined` forever — an unfalsifiable third value, which is
  # its own kind of useless. `type` is present in both worlds and says what the
  # reply IS; the agents list is then read with `[]?`, which tolerates absence.
  if ! printf '%s' "$raw" | jq -e '.result.type == "agent_list"' >/dev/null 2>&1; then
    WT_OCCUPANTS_WHY="herdr agent list exited 0 but its reply is not an agent_list: $(printf '%s' "$raw" | tr '\n' ' ' | cut -c1-200)"
    rm -f "$err"; return 0
  fi
  # ONE SPELLING. On native Windows herdr reports an agent cwd as a backslash drive path
  # and $dir is bash's /c/... or /tmp/...: compared as strings, a worktree with
  # a live agent in it reads as unoccupied, which is the dangerous answer. Both
  # sides go through the layer's realpath first; a failure there is no reading.
  local d="$dir"
  case "${OSTYPE:-}" in msys*|cygwin*)
    if ! raw="$(printf '%s' "$raw" | python3 -c 'import json, os, sys
r = json.load(sys.stdin)
for a in (r.get("result") or {}).get("agents") or []:
    if isinstance(a.get("cwd"), str) and a["cwd"]:
        a["cwd"] = os.path.realpath(a["cwd"])
json.dump(r, sys.stdout)' 2>"$err")" || ! d="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$dir" 2>>"$err")"; then
      WT_OCCUPANTS_WHY="could not put herdr's agent cwds and $dir in one spelling: $(tr '\n' ' ' < "$err" | cut -c1-200)"
      rm -f "$err"; return 0
    fi ;;
  esac
  WT_OCCUPANTS="$(printf '%s' "$raw" \
    | jq -r --arg d "$d" '
        .result.agents[]?
        | select((.cwd // "") == $d or ((.cwd // "") | startswith($d + "/")))
        | "\(.pane_id) (\(.agent // "?"), \(.agent_status // "?"))"' 2>"$err")" || {
    rc=$?
    WT_OCCUPANTS=""
    WT_OCCUPANTS_WHY="jq exited $rc reading herdr's agent list: $(tr '\n' ' ' < "$err" | cut -c1-200)"
    rm -f "$err"; return 0
  }
  rm -f "$err"
  WT_OCCUPANTS_OBSERVED=1
}

# ── is this worktree actually disposable? ───────────────────────────────────
#
# WHY THIS EXISTS. `hw done` printed `git worktree remove <wt>` unconditionally
# under the heading "Merge and clean up by hand". For a product lane's
# coords-reconcile that command destroys `_coords-export/` — 588K of raw.json
# plus four CSVs, the 754 rows that were sent to Mike — because the directory is
# GIT-IGNORED and `git status` therefore reports the worktree clean. hw was
# printing a data-loss command and calling it cleanup. Same class as every other
# defect this week: hw asserting something it had not checked.
#
# The hard part is that "has ignored content" cannot mean "keep". Every worktree
# here has ignored content: measured across the 12 product-lane worktrees,
# every one carries `.claude`, `.codex`, `.agents`, `AGENTS.md`, `opencode.json`
# and a `backend/.venv`, because `wt.sh` copies or links them per worktree. A
# check that refused all of those would refuse everything and be ignored.
#
# So: an ALLOWLIST of what is regenerable, and everything else is irreplaceable.
# Conservative in the safe direction — an unknown ignored path keeps the worktree
# alive, it never licenses a delete. Symlinks are always disposable: removing the
# link cannot lose the target.
#
# The census that produced this list also found `secrets/`, `tmp/`,
# `<carrier>.credentials`, `<pbx>.credentials`, `.env`, `qa-report/` and
# `specs/` sitting ignored in one worktree each. None are on the list, so none of
# them can be deleted by this tool. That is the point.
# Extend, don't edit: HW_WT_REGENERABLE adds path components that are disposable
# in YOUR setup. An identical reason on every row is a reason people stop reading,
# so this exists to let the list shrink to what is actually interesting.
#
# `backend/data/prod_snapshot.db` and `route_cache.db` used to need adding here
# by hand — four product-lane worktrees, reported 2026-08-25, kept for
# content `local/wt.sh` itself copies from main (`_link_data_fixtures`,
# wt.sh:202: `*.db|*.db-wal|*.db-shm) _copy_one …`). wt.sh already decided
# those are copies, not originals — reap hand-maintaining a second, narrower
# opinion about the same files is exactly the kind of list that drifts. See
# _wt_seed_patterns / _wt_copy_of_main below: the glob wt.sh copies with is read
# from wt.sh itself, and a path matching it is disposable only while main still
# holds the file it was copied from (same argument as the .env.local case,
# generalized instead of hardcoded).
WT_REGENERABLE='.agents .atl .claude .codex .opencode .hw .specify .venv .ruff_cache .pytest_cache .mypy_cache __pycache__ node_modules dist build .next .turbo .DS_Store AGENTS.md PROGRESS.md opencode.json local next-env.d.ts'
WT_REGENERABLE="$WT_REGENERABLE ${HW_WT_REGENERABLE:-}"

# Ignored top-level entries that are NOT on the allowlist and hold at least one
# file. Printed one per line, empty when there are none.
# MATCH BY PATH COMPONENT, not by the first segment. Collapsing to the top level
# read `backend/__pycache__/` as `backend` — a TRACKED source directory that is
# not on the allowlist — so every product-lane worktree came back
# "irreplaceable: backend frontend scripts". Wrong, and the wrong kind of wrong:
# a check that flags everything gets switched off. A path is regenerable when ANY
# of its components is, which is what makes `backend/.venv` disposable and
# `_coords-export/` not.
# A COPY WHOSE ORIGINAL STILL EXISTS IS NOT UNREPRODUCIBLE.
#
# hw copies `.env.local` into every product-lane worktree itself (`_link_or_copy …
# copy`, because it holds the per-worktree DB block and cannot be a symlink to
# main's). That copy then made the worktree `irreplaceable` at reap time — so hw
# was creating the reason it could never clean up after itself. Measured
# 2026-08-24: 8 of a product lane's 23 kept worktrees were kept for this and nothing
# else, while 11 were dirty with real work and correctly kept.
#
# CONDITIONAL, and the condition is checked, not assumed: the copy is disposable
# only while the main checkout still has the file it was copied from. If main's
# is gone, the worktree copy may be the last one and the worktree stays. Same
# argument as the symlink rule above — removing a copy cannot lose the target —
# with the target's existence verified instead of taken on faith.
# WT.SH IS THE AUTHORITY ON WHAT IT COPIES — read it, don't re-guess it. Its
# `_link_data_fixtures` case statement is the one place that decides "copy" vs.
# "symlink" for an untracked `backend/data/*` file, so its own glob is the
# correct list of what is a copy, not a hand-typed set of filenames one census
# happened to see. Sets WT_SEED_NOTE to say which: the line it read, or why it
# read nothing.
_wt_seed_patterns() {
  local wt_sh="$1" line lineno pat
  WT_SEED_NOTE=""
  if [ ! -r "$wt_sh" ]; then
    WT_SEED_NOTE="no $wt_sh — reap falls back to the hand-maintained allowlist"
    return 1
  fi
  # The case label immediately before the copy call, e.g.
  #   *.db|*.db-wal|*.db-shm) _copy_one "$wt" "$rel" "$dry" ;;
  line="$(rg -n '_copy_one "\$wt" "\$rel" "\$dry"' "$wt_sh" 2>/dev/null | head -1 || true)"
  if [ -z "$line" ]; then
    WT_SEED_NOTE="$wt_sh has no _copy_one case line at the shape reap expects — falling back to the hand-maintained allowlist"
    return 1
  fi
  lineno="${line%%:*}"
  pat="${line#*:}"
  pat="$(printf '%s' "$pat" | sd '^[[:space:]]*' '')"
  pat="${pat%%\)*}"
  if [ -z "$pat" ]; then
    WT_SEED_NOTE="could not parse the case pattern at $wt_sh:$lineno — falling back to the hand-maintained allowlist"
    return 1
  fi
  WT_SEED_NOTE="seeded from $wt_sh:$lineno ($pat)"
  printf '%s' "$pat" | tr '|' '\n'
}

# WHICH COPIES A LANE MAKES is the lane's (`reap` in projects.json): `copies`
# names them, and `copies_from` names the worktree script whose own copy glob
# extends that list. A lane with no `reap` makes no copy reap can excuse.
_wt_copy_of_main() {
  local wt="$1" rel="$2" main="" lane="" matched=0 pat c from
  for c in ${HW_LANES:-}; do
    [ -n "$(lane_get "$c" reap_copies)" ] || continue
    main="$(lane_checkout "$c")"
    [ -n "$main" ] || continue
    case "$wt" in "$main"/*) lane="$c"; break ;; esac
  done
  [ -n "$lane" ] || return 1
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    case "$rel" in $c) matched=1; break ;; esac
  done <<EOF
$(lane_get "$lane" reap_copies)
EOF
  from="$(lane_get "$lane" reap_copies_from)" || from=""
  if [ "$matched" = 0 ] && [ -n "$from" ]; then
    while IFS= read -r pat; do
      [ -n "$pat" ] || continue
      case "$rel" in $pat) matched=1; break ;; esac
    done < <(_wt_seed_patterns "$main/$from" 2>/dev/null || true)
  fi
  [ "$matched" = 1 ] || return 1
  [ -f "$main/$rel" ] || return 1
  return 0
}

_wt_irreplaceable() {
  local wt="$1" rel entry comp regen
  # THE LIST ITSELF HAS TO BE OBSERVED, and this is the fourth instance of the
  # shape in this file — three lines above the third, which was fixed first.
  # A judge found it on 2026-09-07 and was right: `git status --ignored
  # 2>/dev/null | rg … | sd …` yields an empty list when git fails, when the
  # index is corrupt, or when `rg`/`sd` is not installed, and an empty list here
  # means NOTHING IS IRREPLACEABLE — the verdict walks to `safe` and
  # `hw reap --apply` hands the worktree to `git worktree remove`.
  #
  # The inner `fd` gate below was the visible one because the lint rule can see
  # a substitution inside a test. This one is a plain pipeline, so no rule was
  # ever going to catch it; it needed reading.
  local ignored ignored_rc=0
  ignored="$(git -C "$wt" status --porcelain --ignored 2>/dev/null)" || ignored_rc=$?
  if [ "$ignored_rc" -ne 0 ]; then
    printf '<the ignored-file list could not be read — git status --ignored exited %s>\n' "$ignored_rc"
    return 0
  fi
  # AND THE REST OF THE PIPELINE IS ALSO A WAY TO COME BACK EMPTY. `rg` and `sd`
  # are not POSIX tools; on a machine without them this printed nothing and
  # every worktree read as holding nothing irreplaceable. The status is taken
  # from the whole pipeline, not just from git.
  local rows rows_rc=0
  rows="$(printf '%s\n' "$ignored" | rg '^!! ' | sd '^!! ' '' | sed 's:/$::' | sort -u)" || rows_rc=$?
  # `rg` exits 1 on NO MATCH, which is a real answer: no ignored files. Anything
  # else — 127 not-found, 2 a real error — is a failure to look.
  if [ "$rows_rc" -ne 0 ] && [ "$rows_rc" -ne 1 ]; then
    printf '<the ignored-file list could not be filtered — the rg/sd pipeline exited %s>\n' "$rows_rc"
    return 0
  fi
  printf '%s\n' "$rows" | while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      regen=0
      # shellcheck disable=SC2086
      for comp in $(printf '%s' "$rel" | tr '/' ' '); do
        case " $WT_REGENERABLE " in *" $comp "*) regen=1; break ;; esac
      done
      [ "$regen" = 1 ] && continue
      _wt_copy_of_main "$wt" "$rel" && continue
      entry="$wt/$rel"
      # A symlink loses nothing when removed, whatever it points at.
      [ -L "$entry" ] && continue
      if [ -d "$entry" ]; then
        # AN UNREADABLE DIRECTORY IS NOT AN EMPTY ONE, and this is the gate that
        # decides whether a git-ignored tree is IRREPLACEABLE. `fd` failing here
        # printed nothing, the entry dropped off the keep list, and
        # `_wt_disposition` walked on to `safe` — which `hw reap --apply` hands
        # to `git worktree remove`. Found 2026-09-07 by the `unmeasured` lint
        # rule, which is the third instance of this exact shape in this file and
        # the one the two hand fixes missed.
        _fd_out="$(fd -H -t f . "$entry" 2>/dev/null)" && _fd_rc=0 || _fd_rc=$?
        if [ "$_fd_rc" -ne 0 ]; then
          # Cannot tell. Report it as irreplaceable: keeping a worktree that
          # could have gone costs a `hw reap` re-run, and the other direction
          # deletes files git cannot rebuild.
          printf '%s (could not be read — fd exited %s)\n' "$rel" "$_fd_rc"
        elif [ -n "$_fd_out" ]; then
          printf '%s\n' "$rel"
        fi
      elif [ -e "$entry" ]; then
        printf '%s\n' "$rel"
      fi
    done
}

# Is the branch's work already in the integration branch? origin/<base> first,
# because that is where merges actually land here; local <base> as a fallback for
# a repo with no remote ref fetched.
# ANCESTRY IS NOT ENOUGH WHEN THE TEAM SQUASH-MERGES, which this one does through
# GitHub PRs. A squash lands the branch's work as ONE NEW commit, so the branch's
# own commits are never ancestors of main and `--is-ancestor` answers "not merged"
# forever. Measured 2026-08-24 on a product lane's nine branches: three were
# fully in main and reported unmerged — coords-reconcile among them, whose work is
# main's 7af350c (PR #343). `hw reap` would have refused those three for good.
#
# `git cherry` does not rescue it either: it compares patch-ids, and a squash of
# three commits matches none of them. Verified — it printed `+` for all three.
#
# So the second opinion is CONTENT. Take the paths the branch actually
# contributed (merge-base..branch) and ask whether main already holds them
# identically. Only those paths: a stale branch also differs from main by all of
# main's newer work, which says nothing about whether the branch was merged.
#
# `-z` and `xargs -0`, NOT a space-joined list. The first version of this
# measurement joined paths with spaces and `git diff` silently compared nothing,
# reporting every branch as fully merged — including ones with real differences.
# A check that passes without testing is worse than no check, and this one would
# have licensed deleting unmerged work.
_wt_branch_merged() {
  local main="$1" branch="$2" base="${3:-main}" ref mb changed
  git -C "$main" merge-base --is-ancestor "$branch" "origin/$base" 2>/dev/null && return 0
  git -C "$main" merge-base --is-ancestor "$branch" "$base" 2>/dev/null && return 0

  # Which integration ref exists to compare against.
  if git -C "$main" rev-parse --verify --quiet "origin/$base" >/dev/null 2>&1; then
    ref="origin/$base"
  elif git -C "$main" rev-parse --verify --quiet "$base" >/dev/null 2>&1; then
    ref="$base"
  else
    return 1
  fi
  mb="$(git -C "$main" merge-base "$ref" "$branch" 2>/dev/null || true)"
  [ -n "$mb" ] || return 1
  # A branch that changed nothing is not evidence of a merge.
  changed="$(git -C "$main" diff -z --name-only "$mb" "$branch" 2>/dev/null | tr -d '\0' | head -c1)"
  [ -n "$changed" ] || return 1
  if git -C "$main" diff -z --name-only "$mb" "$branch" 2>/dev/null \
     | xargs -0 git -C "$main" diff --quiet "$ref" "$branch" -- 2>/dev/null; then
    WT_MERGE_EVIDENCE="squash-merged: every path it contributed is already identical in $base"
    return 0
  fi
  return 1
}

# Sets WT_VERDICT and WT_WHY. Every verdict that is not `safe` is a reason to
# KEEP, and the caller prints WT_WHY.
#
#   safe | held | leased | detached | dirty | unmerged | irreplaceable
#   undetermined  — A GATE COULD NOT BE MEASURED. Not a synonym for any of the
#                   others and never folded into `safe`: "nothing is working in
#                   it" and "we could not find out whether anything is working
#                   in it" are different facts, and only the first is a reason
#                   to run `git worktree remove`.
_wt_disposition() {
  local main="$1" wt="$2" branch="$3" base="${4:-main}" occ keep n
  local status_out status_rc
  WT_VERDICT=""; WT_WHY=""; WT_MERGE_EVIDENCE=""

  _wt_occupants "$wt"; occ="$WT_OCCUPANTS"
  if [ "$WT_OCCUPANTS_OBSERVED" != 1 ]; then
    WT_VERDICT=undetermined
    WT_WHY="could not read who is working in it — $WT_OCCUPANTS_WHY. An unread occupant list is not an empty one, and occupancy is the gate that outranks every other here."
    return 0
  fi
  if [ -n "$occ" ]; then
    WT_VERDICT=held
    WT_WHY="held by $(printf '%s' "$occ" | tr '\n' ' ')"
    return 0
  fi
  # A LEASE IS AN OWNERSHIP RECORD FOR A RESOURCE WHOSE OWNER HAS GONE. The
  # occupant check above finds an agent; a leased preview has deliberately no
  # agent, and that is exactly what would make it look disposable. First verdict
  # after the occupants for that reason — before dirty, before unmerged, because
  # a lease says somebody is still going to LOOK at this, which no amount of git
  # cleanliness can tell you.
  local lr
  if lr="$(_leased_rundir_for "$wt" 2>/dev/null)"; then
    WT_VERDICT=leased
    WT_WHY="preview leased until $(_lease_field "$lr" until_h) — $(_lease_field "$lr" why)"
    return 0
  fi
  if [ -z "$branch" ] || [ "$branch" = detached ]; then
    WT_VERDICT=detached
    WT_WHY="no branch — a detached worktree is not something this tool decides about"
    return 0
  fi
  # THE EXIT CODE, NOT JUST THE BYTES. `$(git status --porcelain 2>/dev/null)`
  # threw the exit code away inside the command substitution and the diagnosis
  # with it, so a corrupted index, a missing gitdir or a permissions error
  # produced empty stdout — byte for byte what a clean tree produces — and the
  # verdict walked on toward `safe`, which `hw reap --apply` acts on with
  # `git worktree remove`.
  local status_err
  status_err="$(mktemp "${TMPDIR:-/tmp}/hw-wtstatus.XXXXXX")" || status_err=/dev/null
  status_out="$(git -C "$wt" status --porcelain 2>"$status_err")" && status_rc=0 || status_rc=$?
  if [ "$status_rc" -ne 0 ]; then
    # NEVER-A-WORKTREE IS ITS OWN ANSWER, not a failed reading of a worktree.
    #
    # MEASURED 2026-09-16: `hw done setup <legacy-task>` on one of the plain
    # directories every pre-worktree setup task left behind printed
    # "DO NOT REMOVE THIS WORKTREE YET … Fix what could not be read … that is
    # how 588K went once" — the corrupt-worktree diagnosis, aimed at a person,
    # about a directory that is correctly not a worktree and never was. Nothing
    # was at risk (the verdict still is not `safe`, which is the property that
    # matters), but a warning that names the wrong problem sends the reader to
    # repair something that is not broken. Raised by a Judgment Day judge on
    # this change and reproduced before this arm was written.
    # AND THE BRANCH DECIDES WHICH OF THE TWO IT IS. `rev-parse --git-dir`
    # failing says only "git cannot read this as a repository", and that is true
    # of BOTH a directory that never was a worktree AND a real one whose linked
    # `.git` file has been deleted or corrupted. Those need opposite answers:
    # the first has nothing to dispose of, the second is a worktree holding work
    # whose branch still exists, and telling an operator "no branch was ever
    # created for it — delete it by hand" about the second is a false statement
    # attached to a destructive instruction.
    #
    # MEASURED 2026-09-17, on a real worktree with its `.git` removed: without
    # this second test the verdict was `not-a-worktree` while
    # `refs/heads/task/real` was still there. Raised by one Judgment Day judge,
    # denied by the other, and settled by running it rather than by argument.
    #
    # `$branch` here is DERIVED FROM THE TASK NAME by the caller, not read from
    # the tree — which is exactly why it is still answerable when the tree is
    # unreadable, and why this test works at all.
    if ! git -C "$wt" rev-parse --git-dir >/dev/null 2>&1; then
      if [ -n "$branch" ] && git -C "$main" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
        WT_VERDICT=undetermined
        WT_WHY="$wt is not readable as a git worktree, but $branch EXISTS in $main — so this is a worktree whose .git was lost, not a directory that never was one. What it holds has not been measured and its branch has not been merged."
        rm -f "$status_err"; return 0
      fi
      WT_VERDICT=not-a-worktree
      WT_WHY="$wt is not a git worktree at all and no branch $branch exists — it is a plain directory, which is what a --worktree none task and every pre-2026-09-16 setup task leaves behind. There is nothing here for git to dispose of."
      rm -f "$status_err"; return 0
    fi
    WT_VERDICT=undetermined
    WT_WHY="git status exited $status_rc in $wt — $(tr '\n' ' ' < "$status_err" | cut -c1-200). Empty output from a FAILED status is the same bytes as a clean tree; it is not a clean tree."
    [ "$status_err" = /dev/null ] || rm -f "$status_err"
    return 0
  fi
  [ "$status_err" = /dev/null ] || rm -f "$status_err"
  if [ -n "$status_out" ]; then
    WT_VERDICT=dirty
    n="$(printf '%s\n' "$status_out" | wc -l | tr -d ' ')"
    WT_WHY="$n uncommitted tracked change(s)"
    return 0
  fi
  if ! _wt_branch_merged "$main" "$branch" "$base"; then
    n="$(git -C "$main" rev-list --count "origin/$base..$branch" 2>/dev/null \
         || git -C "$main" rev-list --count "$base..$branch" 2>/dev/null || echo '?')"
    WT_VERDICT=unmerged
    WT_WHY="$branch has $n commit(s) not in $base"
    return 0
  fi
  keep="$(_wt_irreplaceable "$wt")"
  if [ -n "$keep" ]; then
    WT_VERDICT=irreplaceable
    WT_WHY="git-ignored and unreproducible: $(printf '%s' "$keep" | tr '\n' ' ')"
    return 0
  fi
  WT_VERDICT=safe
  if [ -n "${WT_MERGE_EVIDENCE:-}" ]; then
    WT_WHY="$WT_MERGE_EVIDENCE; clean, nothing ignored that git cannot rebuild"
  else
    WT_WHY="merged into $base, clean, nothing ignored that git cannot rebuild"
  fi
  return 0
}

# ── the work dirs `git worktree list` cannot see ────────────────────────────
#
# THE DEFECT, MEASURED 2026-09-21. `$WORK/setup` held 283 directories
# and 3.5 GB. Twenty-four were git worktrees; the other 259 were LOOSE WORK DIRS
# — what a `--here` or a `--worktree none` task leaves behind — and
# `hw reap setup` reported "0 safe to remove, 28 kept" over them, truthfully.
# Its whole inventory is `git worktree list` (cmd_reap), and a loose directory
# is not in it. A survey that cannot see its subject reports the same words as a
# clean survey — the second time that sentence has had to be written in this
# file, and the first is eight lines into _repo_lanes.
#
# THE BIAS IS RETAIN, AND HARDER HERE THAN FOR A WORKTREE. `reap --apply`
# deletes. A worktree wrongly removed still has its branch and its shas; a loose
# work dir has neither, so what goes is gone. Every gate that cannot be MEASURED
# answers `undetermined`, never `safe`.
#
# THE FLOOR CAME FROM A HAND SWEEP over those 259 — no artifacts, not a git
# worktree, untouched for 24h — and it is a floor, not a ceiling. Three gates
# are here that the hand sweep did not have, each because it would have
# destroyed something on THIS disk:
#
#   * THE ARTIFACT STORE IS RESOLVED, NEVER SPELLED `.artifacts`. On the `setup`
#     lane a plain work directory's HW_ARTIFACTS is THE DIRECTORY ITSELF — see
#     _artifacts_dir_for, which carries the measured reason. The one loose dir
#     still standing on 2026-09-21, `work/setup/briefs-must-not-pre-answer`, has
#     no `.artifacts` at all and holds `REAL-EXECUTOR-PROOF.md` at its root:
#     under the literal spelling it reads `safe`, and `--apply` deletes the
#     proof the task was dispatched to produce. Asking _artifacts_dir_for keeps
#     it. This is the one gate whose absence is demonstrable rather than argued.
#   * `.hw` IS NOT AN ARTIFACT, even when it sits inside the artifact store.
#     Every dispatched directory has one, so counting it would retain all of
#     them and the whole pass would be decoration that deletes nothing.
#   * AN UNREADABLE DIRECTORY IS NOT AN EMPTY ONE. Eight of the 259 refused
#     `rm -rf` with Permission denied — mutation-testing candidates left
#     read-only — and the same permissions stop the artifact census. `fd`
#     failing there prints nothing, which is byte-for-byte what "no artifacts"
#     looks like, and the verdict would walk to `safe`. Same shape as the three
#     already fixed inside _wt_irreplaceable.
#
# Sets WD_VERDICT and WD_WHY. Only `safe` is a reason to remove. `worktree` is
# not a verdict about disposal at all: it means the directory belongs to the
# worktree pass, which has already ruled on it, and the caller prints nothing.
#
#   safe | worktree | inside-worktree | held | leased | artifacts | recent
#   undetermined  — A GATE COULD NOT BE MEASURED, exactly as in _wt_disposition.
WD_VERDICT=""
WD_WHY=""
_workdir_disposition() {  # <project> <dir>
  local proj="$1" dir="$2" top phys rc=0 occ adir files frc=0 n ref rrc=0 recent
  WD_VERDICT=""; WD_WHY=""

  if [ ! -d "$dir" ]; then
    WD_VERDICT=undetermined
    WD_WHY="$dir is not a directory"
    return 0
  fi

  # GIT FIRST, because anything git can see belongs to the pass above and must
  # not be ruled on twice — on the `setup` lane the worktrees and the loose
  # dirs share one parent ($WORK/setup, see _lane_wt_dir), so this is the only
  # thing separating them. `--show-toplevel` exits 128 for "not a repository",
  # which is the ONE failure that means loose; any other exit (git missing, a
  # broken objects dir) is a failure to look, and that is never a licence.
  phys="$(cd -P "$dir" 2>/dev/null && pwd -P)" || phys="$dir"
  top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || rc=$?
  if [ "$rc" = 0 ]; then
    if [ -e "$dir/.git" ] || [ "$top" = "$dir" ] || [ "$top" = "$phys" ]; then
      WD_VERDICT=worktree
      WD_WHY="a git worktree — the worktree pass owns it and this one does not reclassify it"
    else
      WD_VERDICT=inside-worktree
      WD_WHY="not a loose work dir: it sits inside the git worktree $top, and what happens to it is git's question, not this one's"
    fi
    return 0
  fi
  if [ "$rc" != 128 ]; then
    WD_VERDICT=undetermined
    WD_WHY="git rev-parse --show-toplevel exited $rc in $dir, so whether git owns this directory was never established — 128 is the only exit that means 'not a repository'"
    return 0
  fi

  # THE SAME THREE-VALUED OCCUPANCY GATE AS A WORKTREE'S, and first for the same
  # reason: a directory somebody is working in is not disposable whatever else
  # is true of it, and an unread occupant list is not an empty one.
  _wt_occupants "$dir"; occ="$WT_OCCUPANTS"
  if [ "$WT_OCCUPANTS_OBSERVED" != 1 ]; then
    WD_VERDICT=undetermined
    WD_WHY="could not read who is working in it — $WT_OCCUPANTS_WHY"
    return 0
  fi
  if [ -n "$occ" ]; then
    WD_VERDICT=held
    WD_WHY="held by $(printf '%s' "$occ" | tr '\n' ' ')"
    return 0
  fi
  if _leased_rundir_for "$dir" >/dev/null 2>&1; then
    local lr; lr="$(_leased_rundir_for "$dir")"
    WD_VERDICT=leased
    WD_WHY="preview leased until $(_lease_field "$lr" until_h) — $(_lease_field "$lr" why)"
    return 0
  fi

  # WHAT THE TASK PRODUCED, read from where the task was TOLD to put it.
  adir="$(_artifacts_dir_for "$proj" "$dir")"
  if [ -d "$adir" ]; then
    files="$(fd -H -t f . "$adir" 2>/dev/null)" || frc=$?
    # fd exits 0 with no output when nothing matches; 1 is tolerated for the
    # same reason rg's 1 is tolerated in _wt_irreplaceable. Anything else is a
    # failure to look at the gate that decides what is thrown away.
    if [ "$frc" -ne 0 ] && [ "$frc" -ne 1 ]; then
      WD_VERDICT=undetermined
      WD_WHY="could not read the artifact store $adir — fd exited $frc. An unreadable directory is not an empty one, and this is the gate that decides whether anything is being destroyed"
      return 0
    fi
    if [ "$adir" = "$dir" ]; then
      # In bash, not rg: under Git Bash a native rg gets a path-shaped pattern
      # converted to C:/..., matches nothing, and hw's own bookkeeping counts
      # as an artifact (setup/tests/18 on windows-latest).
      files="$(printf '%s\n' "$files" | while IFS= read -r _l; do case "$_l" in ("$dir/.hw/"*) ;; (*) printf '%s\n' "$_l" ;; esac; done)"
    fi
    n="$(printf '%s\n' "$files" | sd '^\s*$' '' | rg -c '\S' || true)"
    : "${n:=0}"
    if [ "$n" != 0 ]; then
      WD_VERDICT=artifacts
      WD_WHY="$n file(s) under its artifact store $adir — artifacts are the one thing a work dir exists to hold, and nothing here can rebuild them"
      return 0
    fi
  fi

  # STILL MOVING. A dispatch seconds old looks exactly like abandoned garbage
  # from the outside: no artifacts yet, no worktree, and the pane may not have
  # registered with herdr. 24h is the hand sweep's window, kept.
  ref="$(mktemp "${TMPDIR:-/tmp}/hw-reap-age.XXXXXX")" || ref=""
  # BSD date takes -v, GNU date takes -d; ask the platform, do not probe by failing.
  local ago_stamp
  if [ "$(uname -s)" = Darwin ]; then ago_stamp="$(date -v-24H +%Y%m%d%H%M.%S)"
  else ago_stamp="$(date -d '24 hours ago' +%Y%m%d%H%M.%S)"; fi
  if [ -n "$ref" ] && touch -t "$ago_stamp" "$ref" 2>/dev/null; then
    if [ "$dir" -nt "$ref" ]; then
      rm -f "$ref"
      WD_VERDICT=recent
      WD_WHY="modified within the last 24h — too young to call abandoned"
      return 0
    fi
    rm -f "$ref"
  else
    [ -z "$ref" ] || rm -f "$ref"
    WD_VERDICT=undetermined
    WD_WHY="could not build a 24h reference timestamp, so this directory's age was never measured"
    return 0
  fi
  # AND THE TREE, not just the root. Writing into a SUBdirectory — `.hw/<run>/turns`
  # on every executor turn — does not touch the root's mtime, so the test above
  # alone would call a live chained executor's directory old.
  recent="$(fd -H --changed-within 24h . "$dir" 2>/dev/null)" || rrc=$?
  if [ "$rrc" -ne 0 ] && [ "$rrc" -ne 1 ]; then
    WD_VERDICT=undetermined
    WD_WHY="could not read the directory's contents to date them — fd exited $rrc"
    return 0
  fi
  if [ -n "$(printf '%s' "$recent" | tr -d '[:space:]')" ]; then
    WD_VERDICT=recent
    WD_WHY="something under it was written within the last 24h — too young to call abandoned"
    return 0
  fi

  WD_VERDICT=safe
  WD_WHY="no artifacts, not a git worktree, nothing under it touched in 24h, nobody in it"
  return 0
}

# Remove a loose work dir, read-only candidates included.
#
# THE GOTCHA, MEASURED on the same 2026-09-21 sweep: eight of the 259 refused
# `rm -rf` with Permission denied. `setup/mutation-coverage` leaves its
# candidates mode 0444 and their directories without `u+w`, so the parent cannot
# unlink them. A verdict of `safe` that then fails to delete is worse than a
# retention: it is a promise the tool did not keep, and nothing tells the
# operator which of the two happened. So the chmod is part of the removal, and
# the removal still reports its own failure rather than assuming success.
_reap_rm_workdir() {  # <dir>
  local dir="$1"
  chmod -R u+w "$dir" >/dev/null 2>&1 || true
  rm -rf "$dir" 2>/dev/null || return 1
  [ ! -e "$dir" ] || return 1
  return 0
}

cmd_worktrees() {
  local migrate=0 quiet=0 proj_filter=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --migrate) migrate=1; shift ;;
      # `hw status` calls this: strays only, nothing when there are none. A gap
      # nobody is shown is a gap that comes back, and status is the surface
      # the operator actually reads.
      --quiet)   quiet=1; shift ;;
      -*) die "unknown option: $1 — usage: hw worktrees [<project>] [--migrate]" ;;
      *)  proj_filter="$(_canon_project "$1")"; shift ;;
    esac
  done

  local strays=0 moved=0 proj main root
  while IFS= read -r proj; do
    [ -z "$proj_filter" ] || [ "$proj_filter" = "$proj" ] || continue
    main="$(_wt_main "$proj")" || continue
    root="$(_wt_canonical_root "$proj")" || continue
    [ -d "$main" ] || { warn "$proj: no checkout at $main"; continue; }

    [ "$quiet" = 1 ] || printf '\n  %s%s%s  canonical: %s\n' "$C_B" "$proj" "$C_0" "$root"
    local line path
    while IFS= read -r line; do
      case "$line" in worktree\ *) path="${line#worktree }" ;; *) continue ;; esac
      [ "$path" = "$main" ] && continue                       # the checkout itself
      case "$path" in
        "$root"/*)
          [ "$quiet" = 1 ] || info "$(basename "$path") — in place"
          continue
          ;;
        "$main"/.git/*)
          # review-tool candidate views and anything else git-internal. Reported so
          # it is not mistaken for a stray, never touched: it is not ours.
          [ "$quiet" = 1 ] || info "$(basename "$(dirname "$path")")/$(basename "$path") — internal (.git), left alone"
          continue
          ;;
      esac

      strays=$((strays + 1))
      local occ dirty target
      # THE SAME THREE VALUES HERE. This decides whether a stray worktree is
      # safe to MOVE, and moving one out from under a working agent is the
      # 2026-08-21 incident verbatim. An unreadable list is reported as such,
      # never as "nobody is there".
      #
      # AND IT KEEPS ITS OWN BRANCH. Stuffing the failure into `$occ` and letting
      # the `[ -n "$occ" ]` test below print "held by UNREADABLE: …" would have
      # been the defect one level in: right behaviour, wrong assertion — "we
      # could not find out" rendered as "somebody is in it". Raised by a
      # Judgment Day judge on 2026-09-07.
      local occ_unreadable=0
      _wt_occupants "$path"
      occ="$WT_OCCUPANTS"
      [ "$WT_OCCUPANTS_OBSERVED" = 1 ] || occ_unreadable=1
      # The same three values for the dirty count. `$(… 2>/dev/null | wc -l)`
      # cannot fail: `wc -l` prints 0 for an empty pipe whether the tree is clean
      # or git died, so this said "0 uncommitted entries" about a worktree it
      # never read. It is only printed here, never acted on, but a number nobody
      # measured is still a number somebody will believe.
      local dirty_err
      dirty_err="$(mktemp "${TMPDIR:-/tmp}/hw-straydirty.XXXXXX")" || dirty_err=/dev/null
      if dirty="$(git -C "$path" status --short 2>"$dirty_err")"; then
        dirty="$(printf '%s' "$dirty" | grep -c . || true)"
      else
        dirty="unreadable ($(tr '\n' ' ' < "$dirty_err" | cut -c1-80))"
      fi
      [ "$dirty_err" = /dev/null ] || rm -f "$dirty_err"
      # NAME IT AFTER THE WORK, not after the repo. Codex names the directory
      # after the repository (`~/.codex/worktrees/<hash>/<repo>`), so moving it
      # by basename would land a worktree called `<repo>` inside a product lane's own
      # .worktrees — a name that says nothing about what is in it. The branch
      # does, so use its last segment when the basename is just the repo.
      local leaf branch
      leaf="$(basename "$path")"
      branch="$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
      if [ "$leaf" = "$(basename "$main")" ] && [ -n "$branch" ] && [ "$branch" != HEAD ]; then
        leaf="${branch##*/}"
      fi
      target="$root/$leaf"
      [ "$quiet" = 0 ] || printf '\n  %sworktrees%s\n' "$C_B" "$C_0"
      warn "OUTSIDE $proj's canonical root: $path"
      # if/else for the plural, not `$( [ … ] && … )`: that is the shape
      # bin/lint-shell exists to flag.
      local plural=ies
      [ "$dirty" = 1 ] && plural=y
      case "$dirty" in
        unreadable*)
          printf '      %sbranch %s · uncommitted entries %s%s\n' "$C_DIM" \
            "$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')" \
            "$dirty" "$C_0" ;;
        *)
          printf '      %sbranch %s · %s uncommitted entr%s%s\n' "$C_DIM" \
            "$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')" \
            "$dirty" "$plural" "$C_0" ;;
      esac

      if [ "$occ_unreadable" = 1 ]; then
        printf '      %sUNDETERMINED — could not read who is working in it: %s%s\n' \
          "$C_WARN" "$WT_OCCUPANTS_WHY" "$C_0"
        printf '      %sNOT moving it. This is not a verdict that somebody is in it;%s\n' "$C_DIM" "$C_0"
        printf '      %sit is the absence of one. Fix what could not be read, then re-run.%s\n' "$C_DIM" "$C_0"
        continue
      fi
      if [ -n "$occ" ]; then
        printf '      %sheld by %s — NOT moving it%s\n' "$C_DIM" \
          "$(printf '%s' "$occ" | tr '\n' ' ')" "$C_0"
        printf '      %smove it once that pane is free:%s\n' "$C_DIM" "$C_0"
        printf '      %sgit -C %s worktree move %s %s%s\n' "$C_DIM" "$main" "$path" "$target" "$C_0"
        continue
      fi
      if [ -e "$target" ]; then
        printf '      %s%s already exists — resolve by hand%s\n' "$C_DIM" "$target" "$C_0"
        continue
      fi
      if [ "$migrate" = 1 ]; then
        if git -C "$main" worktree move "$path" "$target" 2>/dev/null; then
          ok "moved into $target"
          moved=$((moved + 1))
        else
          warn "git worktree move failed — left where it is"
        fi
      else
        printf '      %swould move to %s (add --migrate)%s\n' "$C_DIM" "$target" "$C_0"
      fi
    done < <(git -C "$main" worktree list --porcelain 2>/dev/null || true)
  done < <(_repo_lanes)

  if [ "$quiet" = 1 ] && [ "$strays" = 0 ]; then return 0; fi
  printf '\n'
  if [ "$strays" = 0 ]; then
    ok "every worktree is under its repo's canonical root"
  elif [ "$migrate" = 1 ]; then
    ok "moved $moved of $strays"
  else
    info "$strays outside the canonical root. Add --migrate to move the free ones."
  fi
  return 0
}

# ── hw next: hand the next task to an executor that is already alive ────────
#
# THE LOOP THIS EXISTS FOR: the brainer dispatches, the executor reports done,
# and the brainer has another task for it. Before this, the only supported move
# was launching a new run — which throws away the one thing that made the
# session worth keeping, everything it already learned about the codebase, and
# pays the whole startup cost again. Worse, it was not merely unsupported: the
# ask cap and the once-only done marker were keyed on the RUN, so an executor
# handed a second task by hand could never report it. done-invoker refused as a
# duplicate, correctly, for a task it had never been told about.
#
# Three things have to happen together, and none of them is optional:
#
#   1. THE COUNTER ADVANCES ON DISK. That is what gives task N its own ask
#      budget and its own done marker. It cannot be an --env: the executor's
#      HW_RUN is fixed at launch and invoker_adopt_env_file only fills what is
#      unset, by design.
#   2. THE AGENT IS IDLE FIRST — and NOT because a mid-turn prompt is lost.
#      That was the stated reason (setup/decisions.md, 2026-08-21) and it is
#      false on claude 2.1.245: measured 2026-08-25 in a disposable pane, a
#      mid-turn prompt is always ACTED ON, either immediately as a new turn or
#      queued and submitted when the turn ends. The reason the gate belongs
#      HERE, before the counter moves, is ordering: task N+1 delivered while
#      the executor is still inside task N gets answered against task N's
#      state, and the counter would already say N+1. Nothing is dropped and
#      the wrong task is reported.
#   3. DELIVERY IS PROVEN BY THE RECEIVER, via channel-send, not by `herdr agent
#      prompt`'s exit status. `agent prompt` writes the terminal input buffer, a
#      display layer whose success means the text was drawn — never that a turn
#      opened on it.
#
# Vendor coverage is not special-cased here. channel-send already speaks
# claude/opencode/codex/herdr, and invoker_resolve_sender already derives a
# vendor's native address from the pane, so an executor gets its own harness's
# route and everything else falls back to herdr's gate.
_next_load_invoker_lib() {
  INVOKER_PROG=hw
  INVOKER_BIN_DIR="$HW_BIN_DIR"
  [ -r "$HW_BIN_DIR/invoker-common.sh" ] \
    || die "cannot find invoker-common.sh beside $HW_BIN_DIR — this brain/bin is incomplete"
  # shellcheck source=invoker-common.sh
  . "$HW_BIN_DIR/invoker-common.sh"
  _load_state_witness
}

# The cross-check every gate here now runs before it gives up. Separate from
# invoker-common.sh because `hw unstick` needs it without the invoker surface,
# and because a gate must be able to say "the cross-check was unavailable" —
# which means the load itself is a fact, not an assumption.
_load_state_witness() {
  WITNESS_RPC="$HW_BIN_DIR/herdr-rpc"
  [ -r "$HW_BIN_DIR/state-witness.sh" ] \
    || die "cannot find state-witness.sh beside $HW_BIN_DIR — this brain/bin is incomplete, and a gate with no cross-check would wait out its whole budget on a state that cannot change"
  # shellcheck source=state-witness.sh
  . "$HW_BIN_DIR/state-witness.sh"
}

# The run directory of a live executor, found from the cwd herdr reports for its
# pane. Newest first, and it walks up: an executor started in a worktree root
# may be sitting several directories deeper by the time it is re-tasked.
_next_run_dir() {
  local cwd="$1" hops=0 d
  d="$cwd"
  while [ "$hops" -lt 12 ] && [ -n "$d" ] && [ "$d" != / ]; do
    if [ -d "$d/.hw" ]; then
      local newest
      newest="$(fd -H -t d -d 1 '^2[0-9]{7}-[0-9]{6}-[0-9]+$' "$d/.hw" 2>/dev/null \
                 | sort -r | head -1 || true)"
      if [ -n "$newest" ]; then printf '%s' "${newest%/}"; return 0; fi
    fi
    d="$(dirname "$d")"
    hops=$((hops + 1))
  done
  return 1
}

# ── launch-time reuse check ──────────────────────────────────────────────────
#
# THE DEFECT, MEASURED TWICE THE SAME DAY IN TWO LANES. A brainer launches a
# new executor while one is already alive and re-taskeable in the same lane,
# paying full startup and discarding everything the live session had already
# learned about the repo.
#
#   a voice lane, 2026-09-03: `<task>` was launched while w3Z:p3E
#   sat idle with SSH already proved, container names known, code located.
#   The brainer's own explanation: "Asumi que done-invoker lo habia cerrado al
#   reportar. No lo cerro: lo lance con --here, que no crea tab propia, asi
#   que no habia nada que cerrar."
#
#   setup, the same day: a version-check task closed its tab on report
#   (no --keep-pane), and the work it unblocked needed a second executor with
#   full startup.
#
# Same root both times: THE EXISTENCE OF A PANE WAS DECIDED BY ASSUMPTION, NOT
# READ FROM DISK. `herdr agent list` publishes hw_project/hw_task/hw_run/
# turn_state on every token-carrying pane (_executor_turn_publish above), and
# `.hw/<run>/` on disk carries the rest: whether the task reported
# (_run_done_marker), whether a chaining lease is still live
# (_chaining_lease_live) and, via HW_LAUNCH_MODE in `.hw/<run>/env`, whether
# the run ever owned a tab a report would close.
#
# WHAT COUNTS AS REUSABLE, and why each shape landed where it did:
#   · reported + chaining lease still live         -> reusable, the clear case.
#   · reported + no lease, mode tab/space/legacy    -> NOT offered. That pane's
#     own owned tab closes on the proved report with no lease to hold it, so
#     offering it is a race against a close that may already have happened.
#   · reported + mode here (HW_LAUNCH_MODE=here)    -> reusable even with no
#     lease. A --here run never owned a tab, so nothing auto-closes it on
#     report — this is exactly the instance above, and the one shape a
#     missing lease must not disqualify.
#   · not reported yet                              -> NOT offered. Still
#     working; re-tasking it is `hw next`'s job once it reports, not this
#     check's to force.
#   · a pane from a different project's tokens      -> never a candidate.
#     hw_project is read from the pane's own published tokens; a cross-lane
#     `hw next` is not reuse, it is confusion.
#
# There ARE legitimate reasons to want a fresh session — contaminated context,
# a different vendor or model, deliberate concurrent work — so --fresh names
# and records that more expensive choice. The old --no-reuse-check spelling is
# retained as an exact compatibility alias: under reuse-by-default, "do not
# look for reuse" and "build a fresh session" are the same operation.
#
# Discovery and delivery stay separate. This function only establishes the
# candidate; the launch path hands it to cmd_next, so the existing gate,
# receiver-proved delivery, lease consumption and counter transaction remain
# the one implementation of re-tasking. A delivery refusal exits from cmd_next:
# it must never fall through into silently building the fresh executor that the
# caller did not request.
_REUSE_LINE="no live reusable executor found in this lane (default)"
_REUSE_PANE=""; _REUSE_RUNDIR=""; _REUSE_WHY=""; _REUSE_TASK=""; _REUSE_LEASE_REASON=""
# Every candidate this check LOOKED AT and refused, one line each, for the
# manifest. Reset per call so a second call in one process cannot report a
# discard twice.
_REUSE_DISCARDED=""
# The `reuse check` manifest field: the verdict, then every named discard under
# it. Kept here rather than inlined in the heredoc so the two callers of the
# manifest cannot drift into describing one discovery two ways.
_reuse_check_field() {
  printf '%s' "$_REUSE_LINE"
  [ -n "$_REUSE_DISCARDED" ] || return 0
  # `printf '%s\n'`, NOT `'%s'`: without the trailing newline `read` returns
  # non-zero on the final line and the loop body never runs for it — which,
  # with exactly one discard, is every line. Cost one measured empty field.
  printf '%s\n' "$_REUSE_DISCARDED" | while IFS= read -r _d; do
    [ -z "$_d" ] || printf '\n              %s' "$_d"
  done
}
_check_reusable_executor() {
  local proj="$1"
  _REUSE_DISCARDED=""
  if [ "${CHECK_REUSE:-1}" != 1 ]; then
    _REUSE_LINE="fresh session chosen by ${FRESH_SOURCE:---fresh}; reuse deliberately skipped"
    return 0
  fi
  local agents
  agents="$(herdr agent list 2>/dev/null)" || return 0
  [ -n "$agents" ] || return 0
  local candidates
  candidates="$(printf '%s' "$agents" | jq -r --arg proj "$proj" '
    (.result.agents // [])[]
    | select((.tokens.hw_project // "") == $proj)
    | [(.pane_id // empty), (.tokens.hw_task // empty)] | @tsv' 2>/dev/null || true)"
  [ -n "$candidates" ] || return 0

  local pane candidate_task
  while IFS=$'\t' read -r pane candidate_task; do
    [ -n "$pane" ] || continue
    local info cwd
    info="$(herdr agent get "$pane" 2>/dev/null || true)"
    [ -n "$info" ] || continue
    cwd="$(printf '%s' "$info" | jq -r '.result.agent.cwd // empty' 2>/dev/null || true)"
    [ -n "$cwd" ] || continue
    local rundir
    rundir="$(_next_run_dir "$cwd" 2>/dev/null || true)"
    [ -n "$rundir" ] || continue
    local marker
    marker="$(_run_done_marker "$rundir")"
    [ -f "$marker" ] || continue  # not reported yet — hw next's job, not this check's
    local mode=""
    [ -r "$rundir/env" ] && mode="$(sed -n "s/^HW_LAUNCH_MODE='\(.*\)'\$/\1/p" "$rundir/env" | head -1)"
    local why="" lease_live=0 prior_task="" lease_reason=""
    _chaining_lease_live "$rundir" && lease_live=1
    # A LIVE CHAINING LEASE, AND NOTHING ELSE. A reported `--here` run used to
    # be reusable with NO lease at all, reasoning that nothing auto-closes a
    # pane which never owned a tab. That reasoning is correct and
    # it answers the wrong question. "Nothing closed it" is not "it is free".
    #
    # MEASURED in one lane, twice in one afternoon and by
    # the same brainer: a dispatch landed on a pane that was mid-conversation
    # about an unrelated internal service, purely because it shared the lane
    # and looked idle. The
    # brainer saw the mistake, and then made it again — which is the signature
    # of a rule that reads as advisory rather than a check that holds.
    #
    # A PANE HAS AN OWNER. Either hw lent it out — and `--keep-pane <duration>
    # --why` is the brainer DECLARING, at launch, that it is coming back for
    # this pane — or there is a human in it. A human holds no lease and
    # publishes no token saying "I am here", so absence of evidence is the only
    # state a human ever produces. That is precisely why the lease has to be
    # the positive fact reuse requires: it is the one shape that can only exist
    # because somebody said so.
    #
    # A reported pane left open without a lease is an orphan (brain/CLAUDE.md,
    # "An orphan executor is yours"), and an orphan is the brainer's to close or
    # to justify — never an offer.
    if [ "$lease_live" = 1 ]; then
      why="reported, chaining lease live"
      lease_reason="$(_chaining_lease_field "$rundir" reason)"
    else
      # NAMED, NEVER DROPPED SILENTLY. A silent discard is the same defect with
      # better luck: the manifest would say `no live reusable executor found`,
      # the brainer could not tell that a pane WAS looked at and rejected, and
      # nothing would ever teach it that --keep-pane is the thing that would
      # have offered it.
      _REUSE_DISCARDED="${_REUSE_DISCARDED}${_REUSE_DISCARDED:+
}discarded pane $pane (prior task ${candidate_task:-unknown}, reported, launch mode ${mode:-unrecorded}): no live chaining lease, so nobody declared it re-taskable and it may have a human in it. --keep-pane <duration> --why \"<why you are coming back>\" at ITS launch is what makes a pane reusable."
      continue
    fi
    _REUSE_PANE="$pane"
    _REUSE_RUNDIR="$rundir"
    _REUSE_WHY="$why"
    # AND THE MANIFEST FIELD, WHICH USED TO CONTRADICT THE OUTCOME. `_REUSE_LINE`
    # was only ever written on the `--fresh` branch and on the no-candidate
    # default, so a dispatch that DID find a candidate still printed "no live
    # reusable executor found in this lane (default)" — a field stating the
    # opposite of what the same command was about to do. It was invisible while
    # the reuse route printed no manifest at all; printing one exposed it.
    _REUSE_LINE="pane $pane selected (prior task ${candidate_task:-unknown}; $why)"
    prior_task="$candidate_task"
    [ -n "$prior_task" ] || prior_task="$(printf '%s' "$info" | jq -r '.result.agent.tokens.hw_task // empty' 2>/dev/null || true)"
    [ -n "$prior_task" ] || prior_task="$(_run_env_value "$rundir" HW_TASK || true)"
    _REUSE_TASK="$prior_task"
    _REUSE_LEASE_REASON="$lease_reason"
    return 0
  done <<< "$candidates"
  return 0
}

# ── "has this task reported?", ONE derivation, two callers ──────────────────
#
# ONE DERIVATION OF "REPORTED", and it is not the marker alone. `hw status`
# reads the executor's pane tokens; `hw next`'s gate read `.hw/<run>/done`; and
# on 2026-08-24 a product-lane brainer got `reported-blocked` from one and
# `has not reported` from the other, for the same executor, and both were right.
# done-invoker publishes its tokens BEFORE attempting delivery and writes the
# marker only after the brainer proves it was told, so the tokens answer "the
# executor finished" and the file answers "the brainer heard".
#
# That gap nearly cost a `--force`, which ALSO covers "this executor will never
# report" and would have filed completed work as abandoned. Reading both signals
# means the dangerous override is no longer the remedy for the common case.
#
# LIFTED OUT OF cmd_next 2026-09-16 so `hw done` refuses on the same two signals
# instead of asking the same question a second way. A second derivation of
# "reported" is how the 2026-08-24 contradiction happened in the first place;
# adding one to fix a different defect would have been the same mistake.
#
# Prints exactly one of: `marker`, `token <status> <state>`, `none`.
_report_evidence() {  # $1=pane $2=rundir
  local marker tok state info_json
  marker="$(_run_done_marker "$2")"
  if [ -f "$marker" ]; then printf 'marker'; return 0; fi
  info_json="$(herdr agent get "$1" 2>/dev/null || true)"
  tok="$(printf '%s' "$info_json" | jq -r '.result.agent.tokens.done_status // empty' 2>/dev/null || true)"
  case "$tok" in
    done|blocked)
      state="$(printf '%s' "$info_json" | jq -r '.result.agent.tokens.done_state // "unknown"' 2>/dev/null || true)"
      printf 'token %s %s' "$tok" "${state:-unknown}"
      return 0
      ;;
  esac
  printf 'none'
}
# The two lines both callers owe a reader when the marker is missing and the
# tokens prove the report anyway: that gap is a TRANSPORT fact, not unfinished
# work, and reading it as unfinished is exactly what nearly cost a --force.
_report_evidence_explain() {  # $1=pane $2=verdict $3=marker-path
  case "$2" in
    token*) ;;
    *) return 0 ;;
  esac
  warn "no $3, but $1's own tokens say the executor reported: done_status=$(printf '%s' "$2" | awk '{print $2}'), done_state=$(printf '%s' "$2" | awk '{print $3}')"
  warn "the report was made and its delivery to you failed — that is a transport fact, not an unfinished task"
}

# ── the dry run's route, frozen ─────────────────────────────────────────────
#
# THE DEFECT. `--dry-run` printed `route  fresh executor` and then told the
# reader, in the same manifest, that the field was VOLATILE: a reusable pane
# could appear between the dry run and the launch, and the launch would take
# the other route without asking. A dry run exists so a brainer can DECIDE;
# a decision that does not bind is a description, and the brainer had no way
# to act on it other than by re-reading the manifest it had just read.
#
# MEASURED 2026-09-16 in one lane: a brief landed twice on a pane
# nobody meant to re-task. Discovery choosing a route hw never announced is the
# same class as the reuse criterion above — hw acting on a pane whose owner it
# never established.
#
# SO THE ROUTE FREEZES. The dry run records the route it printed; the next
# launch of the same project:task compares. Same route, the launch proceeds and
# says so. Different route, the launch REFUSES, names exactly what changed,
# builds nothing and sends nothing, and the brainer decides again against the
# new fact. hw never switches routes on its own in either direction.
#
# WHY A FILE, NOT A VARIABLE. The dry run and the launch are two separate
# invocations of the command — that is the real case, and no variable survives
# it. The record sits beside the chaining locks in TMPDIR — the same DIRECTORY
# as `_chaining_lock_path`, not the same mechanism: that one uses `mkdir`, which
# is atomic and symlink-resistant, while this is a guarded write (see
# `_route_forecast_write`). An earlier version of this comment claimed the two
# had "the same shape"; they share the directory, not the safety property, and
# both blind judges caught the overclaim. Never inside a repository or worktree.
#
# AND IT IS CONSUMED, NOT ACCUMULATED. The first launch that reads a forecast
# removes it, whatever the verdict: ONE dry run binds the NEXT launch, not
# every future launch of a task with that name. It also expires on its own, so
# a forecast nobody ever acted on cannot refuse a launch a week later — a stale
# read is not a decision, and treating it as one would make `--dry-run` a thing
# brainers avoid. HW_ROUTE_FORECAST_TTL is the window, in seconds.
HW_ROUTE_FORECAST_TTL="${HW_ROUTE_FORECAST_TTL:-3600}"
_route_forecast_path() {  # $1=project $2=task
  local key; key="$(printf '%s__%s' "$1" "$2" | tr -c 'A-Za-z0-9_.-' '_')"
  printf '%s/hw-route-forecast-%s' "${TMPDIR:-/tmp}" "$key"
}
# Written ONLY on a dry run that reached its own success line: a dry run that
# died on a later gate printed a route the brainer never got to act on, and
# binding the next launch to it would refuse for a reason nobody chose.
_route_forecast_write() {  # $1=project $2=task $3=route $4=detail
  local f; f="$(_route_forecast_path "$1" "$2")"
  # THE NAME IS PREDICTABLE, SO THE WRITE IS GUARDED. Both blind judges flagged
  # this: the path is derived from project+task alone, and a plain `>` follows a
  # symlink somebody else pre-placed. macOS gives each user a mode-0700 $TMPDIR,
  # which is why this is a hardening and not an incident — but `${TMPDIR:-/tmp}`
  # falls back to a shared directory, and `cmd_human_boundary` already sets
  # `umask 077` for a comparable per-run file.
  # `rm -f` THEN `>` IS TWO OPERATIONS, and a symlink re-planted between them
  # would still be followed — caught in the scoped re-judgment, and a fair
  # reading of the first hardening, which narrowed the window without closing
  # it. `set -C` (noclobber) closes it: `>` then REFUSES any path that already
  # exists, symlink included, so the race loses instead of winning. Fails
  # closed — a refused write warns and the dry run simply does not bind.
  rm -f "$f" 2>/dev/null || true
  ( set -C; umask 077
    { printf 'route=%s\n' "$3"
    printf 'at=%s\n' "$(date +%s)"
      printf 'detail=%s\n' "$(printf '%s' "$4" | tr '\n' ' ')"
    } > "$f" 2>/dev/null ) || { warn "could not record the route forecast at $f; this dry run does NOT bind the next launch"; return 0; }
  printf '%s' "$f"
}
_route_forecast_drop() {  # $1=project $2=task
  rm -f "$(_route_forecast_path "$1" "$2")" 2>/dev/null || true
}
# Compares this launch's resolved route against the forecast and CONSUMES it.
# Dies on a mismatch; returns 0 (having said what it did) on a match, on an
# expired forecast, and when there is no forecast at all.
_route_forecast_check() {  # $1=project $2=task $3=route-now $4=detail-now
  local f recorded rec_detail rec_at age
  f="$(_route_forecast_path "$1" "$2")"
  [ -r "$f" ] || return 0
  # `|| true` ON ALL THREE, and bin/lint-shell is what asked for it. Under this
  # file's `set -euo pipefail` a `sed | head` whose sed fails returns sed's
  # status through the pipe and the assignment carries it into `set -e` — hw
  # dies with NO output at all. The `[ -r "$f" ]` above is not the guarantee it
  # looks like: the file can go away, turn into a directory, or lose its
  # permissions between that test and these reads.
  #
  # This is not hypothetical in this codebase. The same shape in
  # `_chaining_lease_field` is what made the obvious mutation of the reuse
  # criterion VACUOUS while this very change was being written: the mutant died
  # silently before reaching the line under test.
  recorded="$(sed -n 's/^route=//p' "$f" 2>/dev/null | head -1 || true)"
  rec_detail="$(sed -n 's/^detail=//p' "$f" 2>/dev/null | head -1 || true)"
  rec_at="$(sed -n 's/^at=//p' "$f" 2>/dev/null | head -1 | tr -dc '0-9' || true)"
  rm -f "$f" 2>/dev/null || true
  case "$recorded" in fresh|reuse) ;; *) return 0 ;; esac
  # An unreadable or absent timestamp is not an age of zero. Refuse to age a
  # record whose age is not on disk: treat it as expired rather than as fresh.
  [ -n "$rec_at" ] || { info "a route forecast for $1:$2 had no readable timestamp; it was discarded rather than trusted"; return 0; }
  age=$(( $(date +%s) - rec_at ))
  # `-ge`, NOT `-gt`, so HW_ROUTE_FORECAST_TTL=0 means "binds nothing" rather
  # than "binds for one second". A knob whose zero does not turn the thing off
  # is a knob that gets misread, and the only cost at the other end is that a
  # forecast expires the instant it reaches its limit instead of just past it.
  if [ "$age" -ge "$HW_ROUTE_FORECAST_TTL" ]; then
    info "a route forecast for $1:$2 existed but is ${age}s old (limit ${HW_ROUTE_FORECAST_TTL}s); it was discarded, and this launch is not bound by it"
    return 0
  fi
  if [ "$recorded" = "$3" ]; then
    info "route matches the dry run ${age}s ago: $recorded"
    return 0
  fi
  warn "the dry run ${age}s ago resolved: route=$recorded — $rec_detail"
  warn "this launch resolves:            route=$3 — $4"
  if [ "$3" = reuse ]; then
    die "ROUTE CHANGED since your dry run. A reusable pane appeared in the meantime, so this launch would hand the brief to a LIVE pane instead of building the executor the dry run described. NOTHING was built and NOTHING was sent. Decide again: re-read it with --dry-run, or pass --fresh to bind the fresh route this command originally described."
  fi
  die "ROUTE CHANGED since your dry run. The pane the dry run would have reused is no longer reusable (its chaining lease expired, it closed, or it was re-tasked), so this launch would build a whole new executor instead. NOTHING was built and NOTHING was sent. Decide again: re-read it with --dry-run. There is no flag that forces the reuse route — a pane can only be re-tasked while its lease is live, and that is the fact that changed."
}

# A missing pane gets the chaining diagnosis only when disk proves the exact
# launch decision. This intentionally excludes old runs: absence of a key is
# not proof that the brainer chose automatic close.
#
# The default was a fourth hand-typed copy of "$WORK plus the repo-backed lane
# roots" until 2026-09-15 — missing two other lanes, same class of gap as
# INVOKER_ENV_ROOTS (bin/project-spaces.sh's all_lane_worktree_roots doc
# comment has the incident). Derives from that same function now, falling
# back to the old literal if it is unavailable for any reason.
# HW_NEXT_EVIDENCE_ROOTS still wins outright — setup/tests/12-hw-next.sh pins
# a missing root through it on purpose.
_next_autoclosed_run_for_pane() {
  local pane="$1" roots _default_roots _derived
  _default_roots="$WORK"
  if command -v all_lane_worktree_roots >/dev/null 2>&1; then
    _derived="$(all_lane_worktree_roots 2>/dev/null || true)"
    [ -n "$_derived" ] && _default_roots="$WORK
$_derived"
  fi
  roots="${HW_NEXT_EVIDENCE_ROOTS:-$_default_roots}"
  HW_NEXT_PANE="$pane" HW_NEXT_ROOTS="$roots" python3 - <<'PYEOF' 2>/dev/null || true
import json, os

pane = os.environ["HW_NEXT_PANE"]
roots = [r for r in os.environ.get("HW_NEXT_ROOTS", "").split("\n") if r]

def env_value(path, key):
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except OSError:
        return None
    for line in lines:
        if line.startswith(key + "="):
            value = line.split("=", 1)[1].strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
                value = value[1:-1]
            return value
    return None

def receipt_pane(path):
    found = None
    try:
        lines = open(path, encoding="utf-8")
    except OSError:
        return None
    with lines:
        for line in lines:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if rec.get("key") == "pane" and rec.get("value"):
                found = rec["value"]
    return found

for root in roots:
    if not os.path.isdir(root):
        continue
    for directory, dirs, files in os.walk(root):
        if "receipt.jsonl" not in files or os.path.basename(os.path.dirname(directory)) != ".hw":
            continue
        if receipt_pane(os.path.join(directory, "receipt.jsonl")) != pane:
            continue
        if env_value(os.path.join(directory, "env"), "HW_CHAINING_ENABLED") != "0":
            continue
        if not any(os.path.isfile(os.path.join(directory, k)) for k in ("tab", "workspace")):
            continue
        seq = "1"
        try:
            raw = open(os.path.join(directory, "task"), encoding="utf-8").read()
            digits = "".join(c for c in raw if c.isdigit())
            if digits and digits != "0":
                seq = digits
        except OSError:
            pass
        marker = (os.path.join(directory, "done") if seq == "1" else
                  os.path.join(directory, "t" + seq, "done"))
        if not os.path.isfile(marker):
            continue
        project = env_value(os.path.join(directory, "env"), "HW_PROJECT") or "unknown-project"
        task = env_value(os.path.join(directory, "env"), "HW_TASK") or "unknown-task"
        print("%s:%s (run %s, task %s)" % (project, task, os.path.basename(directory), seq))
        raise SystemExit(0)
PYEOF
}

_next_missing_pane_message() {
  local pane="$1" panes evidence
  panes="$(herdr pane list 2>/dev/null || true)"
  # If Herdr itself is unavailable or malformed, the durable record cannot prove
  # that this pane is absent now. Keep the generic two-cause diagnosis.
  printf '%s' "$panes" | jq -e '.result.panes | type == "array"' >/dev/null 2>&1 \
    || { printf 'herdr does not know pane %s (or herdr is unreachable on $HERDR_SOCKET_PATH)' "$pane"; return 0; }
  if printf '%s' "$panes" | jq -e --arg p "$pane" 'any(.result.panes[]?; .pane_id == $p)' >/dev/null 2>&1; then
    printf 'herdr pane %s exists but has no agent record, so hw cannot re-task it' "$pane"
    return 0
  fi
  evidence="$(_next_autoclosed_run_for_pane "$pane")"
  if [ -n "$evidence" ]; then
    printf 'pane %s belonged to completed %s and was launched with automatic close. Chaining is a launch-time decision: launch with `hw ... --keep-pane` when this executor must survive its report for `hw next`.' "$pane" "$evidence"
  else
    printf 'herdr does not know pane %s (or herdr is unreachable on $HERDR_SOCKET_PATH)' "$pane"
  fi
}

# _next_wait_from_run <rundir>
#
# A dispatch's environment is the durable bridge between the brainer that
# launched an executor and the brainer process that later calls `hw next`.
# Never source it: the format is deliberately narrow, and this reads only the
# decimal wait value we own.
_next_wait_from_run() {
  local rundir="$1" key value
  [ -r "$rundir/env" ] || return 1
  while IFS='=' read -r key value; do
    [ "$key" = HW_NEXT_WAIT_MS ] || continue
    value="${value#\'}"; value="${value%\'}"
    case "$value" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s' "$value"
    return 0
  done < "$rundir/env"
  return 1
}

_run_env_value() {
  local rundir="$1" want="$2" key value
  [ -r "$rundir/env" ] || return 1
  while IFS='=' read -r key value; do
    [ "$key" = "$want" ] || continue
    value="${value#\'}"; value="${value%\'}"; printf '%s' "$value"; return 0
  done < "$rundir/env"
  return 1
}

# _next_busy_message <pane> <wait_ms> <info_json>
#
# `hw next` gates on idle,done before it will move the counter. Rejected
# because a pane is `blocked` on its OWN unanswered ask (ask_state=delivered)
# is not the same rejection as a pane genuinely mid-turn: no wait budget ever
# reaches idle,done from there, because nothing is going to move until the ask
# is answered. Advising a retry with a bigger HW_NEXT_WAIT_MS in that case is
# advice that cannot work — measured 2026-08-25, w41:p37: 90s then
# 540s spent on a pane parked on its own ask #3/3 the whole time.
#
# So this names the open ask instead of the budget. A `blocked` pane with no
# ask_state=delivered (a tool-permission prompt, say) still gets today's
# message — this is not a general replacement for it.
#
# ASK TOKENS OUTLIVE THE TASK THAT OPENED THEM. `ask_state=delivered` is
# published by the pane and STAYS published after the task closes — a task
# that ends by reporting `done_status=blocked` (a DIFFERENT blocker than the
# ask) keeps its old `ask_state=delivered` sitting right there. Measured
# 2026-08-25, twice, against w41:p37: the executor had already closed
# with `done_status=blocked` and a distinct blocker, and both a brainer and
# this tool read the stale ask token as live and pointed at answering a
# question that no longer existed. So an ask is only live if the task has NOT
# reported done — check `done_status`/`done_state` before naming the ask, and
# say plainly that the task closed when it has.
_next_busy_message() {
  local pane="$1" wait_ms="$2" info="$3"
  local st ask_state ask_seq ask_at ask_text done_status done_state
  local blocked_reason blocked_scope
  st="$(printf '%s' "$info" | jq -r '.result.agent.agent_status // empty' 2>/dev/null || true)"
  blocked_reason="$(printf '%s' "$info" | jq -r '.result.agent.tokens.blocked_reason // empty' 2>/dev/null || true)"
  blocked_scope="$(printf '%s' "$info" | jq -r '.result.agent.tokens.blocked_scope // empty' 2>/dev/null || true)"
  ask_state="$(printf '%s' "$info" | jq -r '.result.agent.tokens.ask_state // empty' 2>/dev/null || true)"
  done_status="$(printf '%s' "$info" | jq -r '.result.agent.tokens.done_status // empty' 2>/dev/null || true)"
  done_state="$(printf '%s' "$info" | jq -r '.result.agent.tokens.done_state // empty' 2>/dev/null || true)"
  if [ "$st" = blocked ] && [ "$ask_state" = delivered ] && [ "$done_status" != done ] && [ "$done_status" != blocked ]; then
    ask_seq="$(printf '%s' "$info" | jq -r '.result.agent.tokens.ask_seq // "?"' 2>/dev/null || true)"
    ask_at="$(printf '%s' "$info" | jq -r '.result.agent.tokens.ask_at // "an unknown time"' 2>/dev/null || true)"
    ask_text="$(printf '%s' "$info" | jq -r \
      '[.result.agent.tokens | .ask, .ask2, .ask3, .ask4, .ask5, .ask6, .ask7, .ask8]
       | map(select(. != null)) | join("")' 2>/dev/null || true)"
    printf '%s is blocked on its own ask %s, delivered %s and still unanswered: "%s". Re-tasking cannot reach idle,done from here no matter how large a budget you pass — hw next gates on idle,done, and a pane parked on its own ask never gets there until the ask is answered. Answer it, then retry: herdr agent get %s' \
      "$pane" "$ask_seq" "$ask_at" "$ask_text" "$pane"
  elif [ "$st" = blocked ] && [ "$ask_state" = delivered ]; then
    printf '%s already reported done (done_status=%s, done_state=%s) — the ask token you see is stale, published before that report, and there is nothing left to answer. Do not answer it: read the actual report with `herdr agent get %s` and re-task from that, or override with --force if you are deliberately replacing it.' \
      "$pane" "$done_status" "${done_state:-unknown}" "$pane"
  elif [ "$st" = blocked ] && [ "$blocked_reason" = permission ]; then
    printf '%s is blocked on a PERMISSION prompt (%s session), not on a turn that will end. Nothing was sent and the counter did not move. hw will not dismiss it for you: dismissing a permission prompt means DENY, and that is a decision about what the executor may do, not a stuck pane to rescue. Answer it — `herdr agent get %s`, and for a child prompt press ctrl+x then down to reach it — then retry.' \
      "$pane" "${blocked_scope:-root}" "$pane"
  elif [ "$st" = blocked ] && [ "$blocked_reason" = stuck ] \
       && { [ "$done_status" = done ] || [ "$done_status" = blocked ]; }; then
    # THE GAP THE ask_state=delivered BRANCH ABOVE ALREADY CLOSED, missing HERE.
    # `blocked_reason=stuck` outlives the task the same way an ask token does
    # (see the comment atop this function) — measured live 2026-09-03,
    # w7G:p26: reported done_status=done/done_state=delivered, chaining lease
    # live, footer idle, no question or permission anywhere, and herdr still
    # published blocked_reason=stuck/scope=root. `hw unstick` would have
    # RESTARTED a finished, reusable session on the strength of that stale
    # token — its own guard (blocked_reason=stuck + a corroborating settled
    # witness) does not read done_status either, so it would not have refused.
    printf '%s already reported (done_status=%s, done_state=%s) — the blocked/stuck token you see is stale, published on a pane that has finished. Do not `hw unstick` it: that restarts OpenCode for nothing left to do. Read its report with `herdr agent get %s`, then `hw next %s "<next task>"` to reuse it or `hw done <project> <task>` to close it.' \
      "$pane" "$done_status" "${done_state:-unknown}" "$pane" "$pane"
  elif [ "$st" = blocked ] && [ "$blocked_reason" = stuck ]; then
    printf '%s is blocked with NOTHING LEFT TO ANSWER: every prompt it raised has been answered or dismissed (last one in its %s session) and herdr still reports blocked. Nothing was sent and the counter did not move. No budget reaches idle from here and there is no modal for a human to clear, so do not retry with a larger HW_NEXT_WAIT_MS. A deliberate in-place recovery is available: `hw unstick %s`; it first refuses any visible question/permission, then restarts only OpenCode in the same pane (the active conversation is replaced; tab, cwd and worktree stay). If that is not acceptable, close it with `hw done` and dispatch again.' \
      "$pane" "${blocked_scope:-root}" "$pane"
  elif [ "$st" = blocked ] && [ "$blocked_reason" = error ]; then
    printf '%s is blocked on a SESSION ERROR, not on input — there is no modal to dismiss and no budget that reaches idle. Nothing was sent and the counter did not move. Read what failed with `herdr agent get %s`; if that session is unrecoverable this is a relaunch, not a re-task.' \
      "$pane" "$pane"
  else
    printf '%s was still busy after %ds (agent_status=%s), so nothing was sent and the task counter did not move. A mid-turn prompt is NOT dropped — it is acted on — but task N+1 answered inside task N is answered against the wrong state, with the counter already advanced, which is what this gate is for. Retry, or raise the budget: HW_NEXT_WAIT_MS=540000 hw next …' \
      "$pane" "$((wait_ms / 1000))" "$st"
  fi
}

# _next_finished_stale_stuck <agent-info-json>
#
# `done-invoker` publishes done_status first as undelivered, and changes
# done_state to delivered only after the brainer-owned delivery is proved.  That
# pair is therefore stronger completion evidence than the lifecycle plugin's
# blocked/stuck classification, which can outlive the task that produced it.
# Keep this exception deliberately exact: permission, an unanswered ask, a
# genuine stuck pane without delivered done tokens, and a working pane must all
# continue through the normal idle/done gate.
_next_finished_stale_stuck() {
  printf '%s' "$1" | jq -e '
    .result.agent.agent_status == "blocked"
    and .result.agent.tokens.blocked_reason == "stuck"
    and ((.result.agent.tokens.done_status == "done") or (.result.agent.tokens.done_status == "blocked"))
    and .result.agent.tokens.done_state == "delivered"
  ' >/dev/null 2>&1
}

# Herdr can omit agent_session while an OpenCode pane is classified blocked.
# A stale-stuck completion still needs the native receiver-proved route: Herdr's
# fallback applies a second blocked-state gate and would reject it again.  The
# launch receipt already binds session identity to this exact pane and vendor;
# unlike endpoint recency, those three facts cannot select another conversation
# that happens to share the cwd.
_next_opencode_session_from_receipt() {
  local rundir="$1" pane="$2" sid vendor receipt_pane
  [ -r "$rundir/receipt.jsonl" ] || return 1
  sid="$(jq -sr '[.[] | select(.key == "session_id")][-1].value // empty' "$rundir/receipt.jsonl" 2>/dev/null || true)"
  vendor="$(jq -sr '[.[] | select(.key == "session_vendor")][-1].value // empty' "$rundir/receipt.jsonl" 2>/dev/null || true)"
  receipt_pane="$(jq -sr '[.[] | select(.key == "pane")][-1].value // empty' "$rundir/receipt.jsonl" 2>/dev/null || true)"
  if [[ "$sid" == ses_* ]] && [ "$vendor" = opencode ] && [ "$receipt_pane" = "$pane" ]; then
    printf '%s' "$sid"
    return 0
  fi
  return 1
}

# _next_settled_message <pane> <wait_ms> <info_json>
#
# The refusal for a gate that stopped early because the state was PROVED unable
# to change — not a timeout, and it must not read like one. The distinction is
# operational: a timeout means "retry, perhaps with a bigger budget"; this means
# "no budget will ever work, and the pane needs a decision".
#
# THE FOUR STATES STAY DISTINGUISHABLE. `blocked` once meant four things and
# collapsing any two is how this whole class started, so this branches on the
# reason token to say which of them was contradicted, and never rewrites one as
# another. What is new is only the LAST clause of each: the contradiction is
# now established, so the advice can be definite instead of "retry bigger".
_next_settled_message() {
  local pane="$1" wait_ms="$2" info="$3"
  local st reason scope done_status done_state
  st="$(printf '%s' "$info" | jq -r '.result.agent.agent_status // empty' 2>/dev/null || true)"
  reason="$(printf '%s' "$info" | jq -r '.result.agent.tokens.blocked_reason // empty' 2>/dev/null || true)"
  scope="$(printf '%s' "$info" | jq -r '.result.agent.tokens.blocked_scope // empty' 2>/dev/null || true)"
  done_status="$(printf '%s' "$info" | jq -r '.result.agent.tokens.done_status // empty' 2>/dev/null || true)"
  done_state="$(printf '%s' "$info" | jq -r '.result.agent.tokens.done_state // empty' 2>/dev/null || true)"

  printf '%s: NOTHING WAS SENT and the task counter did not move. ' "$pane"
  if [ "$st" = working ] && { [ "$done_status" = done ] || [ "$done_status" = blocked ]; }; then
    printf 'herdr calls it `working`, but it already reported (done_status=%s) and the cross-check above finds nothing running and no prompt outstanding. That `working` is STALE — the lifecycle producer never cleared it — so the state you are waiting on will not change, at any budget. This executor is finished: read its report with `herdr agent get %s` and either re-task with --force (which files the unreported task as abandoned — check first whether the report simply failed to reach you) or close it with `hw done`.' \
      "$done_status" "$pane"
  elif [ "$st" = working ]; then
    printf 'herdr calls it `working` and the cross-check above finds nothing running and no prompt outstanding, so that `working` is not a turn in progress. Do NOT raise HW_NEXT_WAIT_MS: the budget is not what is missing. Look at the pane, and if it has genuinely finished without reporting, close it with `hw done` or re-task with --force.' ''
  elif [ "$st" = blocked ] && [ "$reason" = permission ]; then
    printf 'herdr calls it blocked on a PERMISSION prompt (%s session), but its own endpoint reports no permission outstanding — that token is STALE, and there is no modal for anyone to answer. Do not go looking for a prompt to approve. `hw unstick` will not touch this either, because the signature is `permission`, not `stuck`. Read what it last did with `herdr agent get %s`, then close it with `hw done` and dispatch again.' \
      "${scope:-root}" "$pane"
  elif [ "$st" = blocked ] && [ "$reason" = question ]; then
    printf 'herdr calls it blocked on a QUESTION (%s session), but its own endpoint reports no question outstanding, and the dismissal attempt above found no modal on screen. That token is STALE. Read what it last did with `herdr agent get %s`, then close it with `hw done` and dispatch again.' \
      "${scope:-root}" "$pane"
  elif [ "$st" = blocked ] && [ "$reason" = error ]; then
    printf 'herdr calls it blocked on a SESSION ERROR and the cross-check confirms nothing is running and nothing is outstanding — so there is no modal, and no budget reaches idle. Read what failed with `herdr agent get %s`; an unrecoverable session is a relaunch, not a re-task.' \
      "$pane"
  elif [ "$st" = blocked ] && [ "$reason" = stuck ] \
       && { [ "$done_status" = done ] || [ "$done_status" = blocked ]; }; then
    # Same gap as the `working`+done_status branch above, on the OTHER token
    # that outlives its task. Measured live 2026-09-03, w7G:p26: settled
    # verdict, blocked_reason=stuck/scope=root, and done_status=done/
    # done_state=delivered — a finished, reusable executor, not a stuck one.
    # `hw unstick`'s own guard does not read done_status either, so pointing
    # here at it would have let it restart a session with nothing left to do.
    printf 'herdr calls it blocked/stuck, but it already reported (done_status=%s, done_state=%s) — that token is STALE, published on a pane that has finished, and the cross-check above only confirms nothing is CURRENTLY moving, not why. Do not `hw unstick` it. Read its report with `herdr agent get %s`, then `hw next %s "<next task>"` to reuse it or `hw done <project> <task>` to close it.' \
      "$done_status" "${done_state:-unknown}" "$pane" "$pane"
  elif [ "$st" = blocked ] && [ "$reason" = stuck ]; then
    printf 'herdr calls it blocked/stuck (%s session) and the cross-check CONFIRMS it: nothing is moving and nothing is outstanding. This is the one case `hw unstick %s` is for — it re-runs this same cross-check before it touches anything, and refuses if the pane turns out to be working. If an in-place restart is not acceptable, close it with `hw done` and dispatch again.' \
      "${scope:-root}" "$pane"
  else
    printf 'herdr calls it `%s`, and the cross-check above finds nothing moving and no prompt outstanding, so that state cannot change on its own. Raising the budget past %ds cannot help. Look at the pane and decide: `hw done` and dispatch again, or --force if you are deliberately replacing an executor that will never report.' \
      "${st:-unknown}" "$((wait_ms / 1000))"
  fi
}


# ── how much context the session on a pane has already burned ───────────────
#
# WHY THIS EXISTS. The operator's rule for re-tasking is a number — past
# roughly +300k tokens, do not `hw next`, launch fresh — and hw used to expose
# every other input to that decision (turns, artifacts, the report summary, the
# pane's state tokens) and not that one. So the brainer chose between `hw next`
# and a fresh launch without the figure the rule is written in, and the cost of
# the error is asymmetric: reusing a burned session starts the new task already
# compacted, which is worse than paying for a cold one.
#
# THE SOURCE, AND WHY NOT THE OTHER ONE. `~/.claude/usage-tracker/session_pct.sh`
# was named alongside this and is NOT an alternative: it shells
# out to `npx ccusage` and estimates the claude.ai FIVE-HOUR QUOTA for the whole
# machine against a hand-calibrated constant. That is a different quantity from
# "how full is this pane's context window", it is not per-pane at all, and it
# cannot answer the +300k rule. The statusline can: Claude Code renders
# `Ctx: <n> | Ctx Used: <p>%` and `herdr agent read <pane> --source visible`
# returns it.
#
# THE TRAP THIS FUNCTION IS SHAPED AROUND, and it is M07 again — collapsing "I
# could not measure" into a value. A pane that has no statusline, or whose
# statusline is scrolled out of the viewport, returns text with no `Ctx:` line
# at all, and a reader that defaults to 0 sees a FRESH SESSION: the one reading
# that makes a brainer re-task the very pane the rule exists to protect. So
# there are three outcomes and they are never conflated — measured, no
# statusline, unreadable — exactly as `_reuse_dispatch_absence_reason` does for
# its own question.
#
# AND THE SEPARATORS ARE NON-BREAKING SPACES. Measured 2026-09-14 by hexdump of
# a live pane: every space in that line is U+00A0 (`c2 a0`), not U+0020, so
# `Ctx: [0-9.]*` with an ordinary space matches NOTHING — and the miss is
# indistinguishable from "this pane has no statusline", which is the failure
# above arriving through the parser instead of through the pane. They are
# normalised to ordinary spaces before anything is read.
#
# Prints "<state>\t<tokens>\t<percent>" and always returns 0: this is
# information for a human decision, never a gate. `tokens` is absolute (the
# rule's unit); k/M suffixes are expanded.
_pane_context() {  # $1 = pane
  local pane="$1" out line
  out="$(herdr agent read "$pane" --source visible 2>/dev/null)" || {
    printf 'unreadable\t\t'; return 0
  }
  [ -n "$out" ] || { printf 'unreadable\t\t'; return 0; }
  # ONE PHYSICAL LINE, AND THAT IS A STATED LIMIT rather than an oversight.
  # Raised by a blind reviewer on this change: if the capture wraps so that
  # `Ctx:` and `Ctx Used:` land on different lines, this reports `no-statusline`
  # even though the percentage was there. That is the SAFE direction and it is
  # the one this function is for — a half-read statusline is not a measurement,
  # and "I could not measure" is exactly what the caller must be told rather
  # than a token count assembled from fragments. Widening it to stitch two lines
  # together would trade the contract for a figure whose provenance nobody can
  # check.
  line="$(printf '%s' "$out" | sed 's/\xc2\xa0/ /g' | grep -E 'Ctx Used:' | tail -1 || true)"
  [ -n "$line" ] || { printf 'no-statusline\t\t'; return 0; }
  printf '%s' "$line" | awk '
    {
      tok = ""; pct = ""
      if (match($0, /Ctx: *[0-9.]+[kKmM]?/)) {
        tok = substr($0, RSTART, RLENGTH); sub(/Ctx: */, "", tok)
      }
      if (match($0, /Ctx Used: *[0-9.]+/)) {
        pct = substr($0, RSTART, RLENGTH); sub(/Ctx Used: */, "", pct)
      }
      mult = 1
      if (tok ~ /[kK]$/) { mult = 1000 }
      else if (tok ~ /[mM]$/) { mult = 1000000 }
      sub(/[kKmM]$/, "", tok)
      if (tok == "" ) { printf "no-statusline\t\t"; exit }
      printf "measured\t%d\t%s", tok * mult + 0, pct
    }'
}

# The threshold the operator stated, in the unit the statusline reports. A warning,
# never a refusal: whether a burned session is still the right one to re-task is
# their call and the brainer's, and hw refusing it would take a judgment it is not
# holding the context for.
HW_NEXT_CTX_WARN_TOKENS="${HW_NEXT_CTX_WARN_TOKENS:-300000}"

# Says what was measured, or says plainly that it could not measure — and the
# second never looks like the first.
_report_pane_context() {  # $1 = pane
  local ctx state tok pct
  ctx="$(_pane_context "$1")"
  state="${ctx%%$(printf '\t')*}"; ctx="${ctx#*$(printf '\t')}"
  tok="${ctx%%$(printf '\t')*}";   pct="${ctx#*$(printf '\t')}"
  case "$state" in
    measured)
      if [ "${tok:-0}" -ge "$HW_NEXT_CTX_WARN_TOKENS" ]; then
        warn "this session has already burned ${tok} tokens of context (${pct}% of its window). ${HW_OPERATOR:-the operator}'s rule is not to re-task past ${HW_NEXT_CTX_WARN_TOKENS}: the next task would start compacted, which costs more than a fresh executor. Re-tasking anyway is a deliberate choice, not a default."
      else
        info "context: ${tok} tokens used (${pct}% of the window), under the ${HW_NEXT_CTX_WARN_TOKENS} re-task threshold"
      fi
      ;;
    no-statusline)
      warn "context: NOT MEASURED — the pane responded but rendered no \`Ctx Used:\` line (no statusline configured, or it is scrolled out of the viewport). This is not 'a fresh session'; it is no reading at all, and the +${HW_NEXT_CTX_WARN_TOKENS} rule cannot be applied to this pane from here."
      ;;
    *)
      warn "context: NOT MEASURED — \`herdr agent read $1 --source visible\` returned nothing readable. This is not 'a fresh session'; it is no reading at all."
      ;;
  esac
}


# ── the suite lock, per lane ────────────────────────────────────────────────
#
# WHY THIS EXISTS, and the operator asked for it by name. Nothing coordinated access
# to a lane's test suite. `bash setup/test-hw` takes ~20-23 minutes, there is
# one machine, and the repo-less lanes get no worktree — one tree, one index, several
# executors — so two agents running it at once is the DEFAULT case for those
# lanes, not the rare one. that fourth lane was a third until 2026-09-15 and `setup` a
# fourth until 2026-09-16; both now get a worktree per task, so their executors
# no longer share an index. The lock stays available to them — a shared suite is
# not the only reason to serialise, and the SETUP lane in particular still has
# live-state checks that no amount of tree isolation separates — but it is no
# longer the default case there.
#
# AND SETUP IS THE LANE THIS PARAGRAPH WAS WRITTEN ABOUT. It is the one that
# edits the file it is running: `hw` on PATH is a symlink to `brain/bin/hw`.
#
# What the absence cost, measured: every
# executor invented its own waiting loop (one `sleep 8` + `pgrep`, another with
# background waits, neither part of hw), and two of them reached for
# `pkill -f 'setup/test-hw'` to restart their OWN run. That pattern matches the
# suite of every lane and every agent. Three complete runs were destroyed, one
# of them at 1445 ok with no failures; another died with `printf: write error:
# Broken pipe`. So the missing lock did not merely serialise badly — it invited
# an instrument that silently destroys other people's work.
#
# THE ORPHAN IS THE PART THAT HAS TO BE RIGHT, and this toolchain already paid
# for getting it wrong once: channel-send's delivery lock recorded nothing but
# an mtime, an operator SIGKILLed its holders, and the next delivery sat in
# TOTAL SILENCE for eleven minutes behind a directory whose owner had been dead
# the whole time. A timer is the wrong instrument — how long a suite might run
# says nothing about whether its runner is alive. So the holder's pid AND its
# process start time go inside, a dead holder is reclaimed on the first pass,
# and a waiter is TOLD who it is waiting for, once, rather than waiting mutely.
#
# The start time is not decoration: pids are reused, and a lock left by a dead
# runner whose number a later process inherited would otherwise look held
# forever.
_suite_lock_dir() { printf '%s/.locks/suite-%s' "$WORK" "$1"; }

# A LANE WHOSE SUITE COORDINATES ITSELF TAKES NO LOCK, since 2026-09-28 — today
# that is setup, whose suite is `setup/test-hw`, which now coordinates itself
# per MACHINE: every job of every suite takes a worker slot from
# `$WORK/.locks/suite-pool`, and a subject that declares `# suite-lane:
# exclusive` runs with nothing beside it (setup/test-hw, "ONE MACHINE, ONE POOL
# OF WORKERS"). Holding this lane lock as well would put back the one-suite-at-a-
# time queue the pool replaced — 20-40 minutes per verify-for-push behind
# whoever was first — for no protection the pool does not already give, and
# every setup task runs in a worktree of its own, so no index is shared. So
# `hw suite setup` and a setup close verification run the command at once.
# The lock stays for every other lane, including those that share one tree.
# Declared per lane in projects.json as `"suite_lock": "none"`; absent or
# `"lane"` keeps the lock.
_suite_lane_pooled() { [ "$(lane_get "$1" suite_lock || true)" = none ]; }

# The identity of a running process, in a form that survives pid reuse. `ps -o
# lstart=` is what channel-send uses for the same question; keeping the same
# source means the two cannot disagree about whether a pid is the same process.
_suite_proc_start() { ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' || true; }

# 0 = the recorded holder is alive and is the SAME process; 1 = it is gone.
#
# THE CLAIM WINDOW, AND IT IS A RACE THAT DEFEATS THE WHOLE LOCK. `mkdir` is the
# atomic claim, but writing `owner.pid` is a separate syscall after it. A waiter
# arriving in between reads NO owner — and if that reads as "dead", the waiter
# deletes a live holder's lock, re-claims it, and both processes run the command
# believing they hold it exclusively. Two concurrent suites, which is exactly the
# incident this command exists to prevent.
#
# So an absent or unparseable owner is NOT evidence of death. It is either a
# holder mid-claim (a fraction of a second) or a lock from a writer that never
# recorded one, and only AGE separates them — the same rule, for the same
# reason, that channel-send's delivery lock already applies at bin/channel-send
# (see its "No owner recorded" branch). Under a minute: treat as LIVE and wait.
# That is the safe direction and the only one; waiting costs a bounded budget
# that already prints its own diagnosis, while reaping a lock we could not age
# lets two runners into the same tree.
_suite_holder_alive() {  # <lockdir>
  local lock="$1" owner start now
  owner="$(cat "$lock/owner.pid" 2>/dev/null || true)"
  case "$owner" in
    ''|*[!0-9]*)
      # lint-shell: measured-elsewhere — the discarded stderr is the POINT, and
      # the direction it fails in is the safe one. A `find` that failed prints
      # nothing, which is the same bytes as "this lock is not old yet", and both
      # land on `return 0` = treat as LIVE and wait. Waiting costs a bounded
      # budget that prints its own diagnosis; reaping a lock whose age could not
      # be read lets two runners into the same tree, which is the incident this
      # whole command exists to prevent. channel-send's delivery lock annotates
      # the identical construct for the identical reason.
      [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null || true)" ] || return 0  # lint-shell: measured-elsewhere
      return 1 ;;
  esac
  kill -0 "$owner" 2>/dev/null || return 1
  start="$(cat "$lock/owner.start" 2>/dev/null || true)"
  # No recorded start means an older writer, or a holder caught mid-claim.
  # `kill -0` alone is the weaker answer, and the weaker answer here is the
  # conservative one: treat it as alive rather than break a live run.
  [ -n "$start" ] || return 0
  now="$(_suite_proc_start "$owner")"
  [ "$now" = "$start" ]
}

_suite_holder_line() {  # <lockdir>
  local lock="$1" owner at task cmd age=""
  owner="$(cat "$lock/owner.pid" 2>/dev/null || true)"
  at="$(cat "$lock/owner.at" 2>/dev/null || true)"
  task="$(cat "$lock/owner.task" 2>/dev/null || true)"
  cmd="$(cat "$lock/owner.cmd" 2>/dev/null || true)"
  case "$at" in ''|*[!0-9]*) : ;; *) age="$(( $(date +%s) - at ))s" ;; esac
  printf 'pid %s%s%s%s' "${owner:-<none recorded>}" \
    "${task:+, task $task}" "${age:+, holding for $age}" "${cmd:+, running: $cmd}"
}

# IS THIS LANE'S LOCK ALREADY HELD FURTHER UP THIS PROCESS TREE?
#
# MEASURED 2026-09-15, and it is a defect this change itself created. Once
# `hw done`'s close verification holds the lane lock, a brief whose pinned
# command is `hw suite <same lane> -- <cmd>` waits behind its OWN parent: the
# parent is blocked on the child, the child sees a live holder and waits, and
# the close's `timeout` eventually kills it and records
# `VERIFICATION FAILED exit 124` for a command that was never allowed to run.
# Reproduced with the new binary (nested command never ran) and not with the
# old one (it ran, because nothing held a lock). Worse, the NOT-VERIFIED
# message this same change prints RECOMMENDS `hw suite <lane> -- <cmd>` — so
# the deadlock was one copy-paste away from any brief. Raised by a blind
# adversarial reviewer on this candidate.
#
# `HW_SUITE_LOCK_HELD` carries the LANE AND A ONE-TIME TOKEN, and A PID IS NOT
# ENOUGH — which was this function's first shape, and both blind reviewers of
# this candidate said so independently. A pid is guessable and reusable: a
# marker that outlived its holder (a pane whose environment kept it, a holder
# SIGKILLed with its lock left behind) would be believed the moment the OS
# handed that number to the real holder, and the caller would then run
# UNLOCKED — reintroducing exactly the concurrent-suite incident the lock
# exists to prevent, through the door built to prevent a
# deadlock.
#
# So the marker carries a token minted at acquire time and written into the
# lock directory, and the belief needs THREE things to agree: the lane, the
# token on disk, and `_suite_holder_alive` — the same liveness rule the rest of
# this lock already uses, pid AND process start time, rather than a second one
# invented here. A guessed pid gets nowhere without the token; a reused pid
# carries a different token; a dead holder fails liveness; a marker with no
# lock behind it finds no token at all.
#
# `${marker%%:*}` rather than a `"$lane:"*` prefix match: no lane today is a
# prefix of another, and building on that would be building on a coincidence.
_suite_lock_held_by_ancestor() {  # <lockdir> <lane>
  local lock="$1" lane="$2" marker="${HW_SUITE_LOCK_HELD:-}" tok
  [ -n "$marker" ] || return 1
  [ "${marker%%:*}" = "$lane" ] || return 1
  tok="$(cat "$lock/owner.token" 2>/dev/null || true)"
  [ -n "$tok" ] || return 1
  [ "$tok" = "${marker#*:}" ] || return 1
  _suite_holder_alive "$lock"
}

# The token a nested call proves itself with. Not secrecy — nobody is attacking
# this — but unguessability and non-reuse, which is what separates "I am inside
# that hold" from "I happen to know a number".
_suite_lock_token() { printf '%s-%s-%s-%s' "$$" "$(date +%s)" "${RANDOM:-0}" "${RANDOM:-0}"; }

# Declared at the top level so `set -u` cannot bite a caller that reads it after
# an acquire that never happened.
SUITE_LOCK_TOKEN=""

# THE ACQUIRE LOOP, FACTORED OUT OF `cmd_suite` — because `hw done` needs it too.
#
# MEASURED: `hw suite` takes a per-lane lock and
# reclaims an orphan, and the close verification did NOT use it — it ran the
# brief's pinned command raw. So two closes in the same lane, or one close while
# somebody runs the suite by hand, walked over each other with nothing recording
# that they had. The command a brief pins is very often the lane's own suite;
# serialising it when a human asks and not when hw asks is the same lock with a
# hole in it.
#
# IT NEVER DIES. `cmd_suite` turns a 1 into its own refusal, with its own
# wording; `_verify_at_close` must NOT turn a busy lane into a failed close —
# the close verification is explicitly not a gate, and killing `hw done` over a
# lock would be a far worse defect than the one this closes.
#
# 0 = the lock is held BY THIS PROCESS and the caller owns releasing it.
# 1 = the budget ran out behind a holder that is alive; nothing was claimed.
_suite_lock_take() {  # <lockdir> <lane> <wait_ms> <what is being run>
  local lock="$1" lane="$2" wait_ms="$3" what="$4"
  local deadline announced=0
  deadline=$(( $(date +%s) + wait_ms / 1000 ))
  while :; do
    if mkdir "$lock" 2>/dev/null; then
      printf '%s\n' "$$"                  > "$lock/owner.pid"   2>/dev/null || true
      _suite_proc_start "$$"              > "$lock/owner.start" 2>/dev/null || true
      date +%s                            > "$lock/owner.at"    2>/dev/null || true
      printf '%s\n' "${HW_TASK:-<not an hw task>}" > "$lock/owner.task" 2>/dev/null || true
      printf '%s\n' "$what"               > "$lock/owner.cmd"   2>/dev/null || true
      # LAST, and that ordering is deliberate: the token is what a nested call
      # proves itself with, so it must not become readable before the facts
      # `_suite_holder_alive` checks alongside it.
      SUITE_LOCK_TOKEN="$(_suite_lock_token)"
      printf '%s' "$SUITE_LOCK_TOKEN"      > "$lock/owner.token" 2>/dev/null || true
      return 0
    fi
    if ! _suite_holder_alive "$lock"; then
      # BROKEN ON THE FIRST PASS, AND SAID OUT LOUD. This is the eleven silent
      # minutes, refused: a waiter must never be unable to tell a dead holder
      # from a long one.
      warn "reclaiming an ORPHANED $lane suite lock — $(_suite_holder_line "$lock") is not running any more"
      rm -rf "$lock" 2>/dev/null || true
      continue
    fi
    if [ "$announced" = 0 ]; then
      # ONCE, not per iteration: a waiter that reprints every few seconds is
      # noise, and a waiter that prints nothing is the defect above.
      info "waiting for the $lane suite lock — $(_suite_holder_line "$lock"). Budget $((wait_ms / 1000))s. Nothing is being killed; this waits."
      announced=1
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
      return 1
    fi
    sleep 5
  done
}

cmd_suite() {
  local proj="" wait_ms="" dry=0 status=0
  proj="${1:-}"; shift || true
  [ -n "$proj" ] || die "usage: hw suite <project> [--wait-ms N] [--dry-run|--status] -- <command...>   Serialises one command per lane against that lane's suite lock, so two executors in a shared tree cannot run the suite over each other. --dry-run answers \"would this wait, and behind whom\" and spends nothing. NEVER kill a suite by command pattern: \`pkill -f setup/test-hw\` matches every lane's and every agent's."
  proj="$(_canon_project "$proj")"
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait-ms) _need_val "$@"; wait_ms="$2"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      --status)  status=1; shift ;;
      --) shift; break ;;
      *) die "hw suite: unknown flag $1 (the command to run goes after \`--\`)" ;;
    esac
  done
  lane_known "$proj" || die "unknown project: $proj (expected: $(lane_names_bar))"

  local lock; lock="$(_suite_lock_dir "$proj")"
  mkdir -p "$(dirname "$lock")"

  if _suite_lane_pooled "$proj"; then
    local pool="$WORK/.locks/suite-pool" busy=0 d
    for d in "$pool"/slot.*; do [ -e "$d" ] && busy=$((busy + 1)); done
    if [ "$status" = 1 ] || [ "$dry" = 1 ]; then
      ok "the $proj lane has no suite lock — this would run at once. Its suite takes worker slots from $pool, shared by every suite on this machine: $busy slot(s) held right now$( [ -d "$pool/exclusive" ] && printf ', and a timing subject has the machine (pid %s, %s)' "$(cat "$pool/exclusive/owner.pid" 2>/dev/null || true)" "$(cat "$pool/exclusive/owner.job" 2>/dev/null || true)")."
      return 0
    fi
    [ $# -gt 0 ] || die "hw suite: nothing to run. Put the command after \`--\`, e.g. hw suite $proj -- bash setup/test-hw"
    info "the $proj lane has no suite lock: setup/test-hw shares the machine's worker pool ($pool) with every other suite and runs its timing subjects alone. Running now."
    local prc=0
    set +e; "$@"; prc=$?; set -e
    return "$prc"
  fi

  # ── answering without acting ──────────────────────────────────────────────
  if [ "$status" = 1 ] || [ "$dry" = 1 ]; then
    if [ ! -d "$lock" ]; then
      ok "suite lock for $proj is FREE — this would acquire it immediately and wait for nothing"
      return 0
    fi
    if _suite_holder_alive "$lock"; then
      warn "suite lock for $proj is HELD by a live runner: $(_suite_holder_line "$lock")"
      info "this would WAIT for it. Do other work and come back — and never \`pkill -f\` the suite: that pattern matches every lane's run and every agent's, and it has already destroyed three complete runs."
    else
      warn "suite lock for $proj is an ORPHAN — $(_suite_holder_line "$lock") is no longer running, so this would reclaim it at once rather than wait behind a dead holder"
    fi
    return 0
  fi

  [ $# -gt 0 ] || die "hw suite: nothing to run. Put the command after \`--\`, e.g. hw suite setup -- bash setup/test-hw"

  # A DEFAULT LONG ENOUGH FOR THE THING IT WAITS ON. A suite run is ~20-23
  # minutes here, so a budget shorter than one full run guarantees a refusal
  # whenever the lock is doing its job. 45 minutes covers a run plus a slow
  # machine; past that, something is wrong and saying so beats waiting on.
  [ -n "$wait_ms" ] || wait_ms="${HW_SUITE_WAIT_MS:-2700000}"
  case "$wait_ms" in ''|*[!0-9]*) die "--wait-ms/HW_SUITE_WAIT_MS must be a positive integer in milliseconds (got: $wait_ms)" ;; esac

  # ALREADY INSIDE SOMEBODY'S HOLD? Then run, do not queue behind an ancestor
  # that is blocked waiting for this very command. See
  # _suite_lock_held_by_ancestor.
  #
  # WHAT THIS DOES NOT COVER, stated rather than left to be discovered: a
  # command running under an ancestor's hold holds nothing of its own, so if
  # that ancestor is INTERRUPTED its trap removes the lock while this command is
  # still going, and a third process could then take the lane. Closing it means
  # process-group ownership, which is a different change; the exposure is a
  # window inside an already-interrupted run, and the alternative — the nested
  # call queueing behind its own blocked parent — is a deadlock, which is worse
  # and was measured.
  if _suite_lock_held_by_ancestor "$lock" "$proj"; then
    info "the $proj suite lock is already held further up this process tree — running inside that hold rather than waiting behind it"
    local arc=0
    set +e; "$@"; arc=$?; set -e
    return "$arc"
  fi

  local held=0
  if _suite_lock_take "$lock" "$proj" "$wait_ms" "$*"; then
    held=1
  else
    die "the $proj suite lock did not free within $((wait_ms / 1000))s. It is held by a LIVE process — $(_suite_holder_line "$lock") — so this is not an orphan and reclaiming it would destroy a running suite. NOTHING was run. Look at that process and decide: wait longer with --wait-ms, or kill it BY PID if you know what it is. Never by command pattern."
  fi

  # RELEASED ON EVERY EXIT PATH THE SHELL CAN SEE. SIGKILL is the one it cannot,
  # which is exactly why the orphan branch above exists rather than being an
  # apology for this trap.
  # shellcheck disable=SC2064
  # THE INT/TERM ARMS EXIT. A trap body with no `exit` turns a delivered signal
  # into "run this, then carry on", so Ctrl-C would release the lock and let the
  # wrapped command's caller continue. Carried here from `_verify_at_close`,
  # where both blind reviewers of this candidate raised it; leaving the sibling
  # with the old shape would have been fixing a rule in one of its two homes.
  # shellcheck disable=SC2064
  trap "rm -rf '$lock' 2>/dev/null || true" EXIT
  # shellcheck disable=SC2064
  trap "rm -rf '$lock' 2>/dev/null || true; exit 130" INT
  # shellcheck disable=SC2064
  trap "rm -rf '$lock' 2>/dev/null || true; exit 143" TERM
  ok "holding the $proj suite lock (pid $$)"
  # The same marker the close verification exports, for the same reason: a
  # command run under this hold that reaches for the lock again must recognise
  # its own ancestor instead of waiting behind it.
  local marker_prev="${HW_SUITE_LOCK_HELD:-}"
  export HW_SUITE_LOCK_HELD="$proj:$SUITE_LOCK_TOKEN"
  local rc=0
  set +e; "$@"; rc=$?; set -e
  if [ -n "$marker_prev" ]; then export HW_SUITE_LOCK_HELD="$marker_prev"
  else unset HW_SUITE_LOCK_HELD; fi
  rm -rf "$lock" 2>/dev/null || true
  trap - EXIT INT TERM
  if [ "$held" = 1 ]; then ok "released the $proj suite lock"; fi
  return "$rc"
}

# _next_message <nextseq> <entry_line> <text> <rundir> <brief_path> <wtdir>
#
# THE RE-TASK CARRIES THE PREAMBLE TOO, and until 2026-09-21 it carried none of
# it. RE-MEASURED 2026-09-21 by the selector `_brief_preamble` names: 158
# re-task deliveries across 89 session transcripts, 0 of them carrying one byte
# of the preamble or the epistemic safeguard, and 8 arriving after a
# compaction boundary.
#
# WHAT IS *NOT* CARRIED, because `hw next` already owns it: the framework entry.
# $entry_line is this route's own answer to what the launch says with its
# "OUTSIDE THE FRAMEWORK FLOW" paragraph. Copying the launch MESSAGE would drag
# it in; this copies the fragments whose absence was measured, and nothing else.
#
# BUILT FROM THE RUN ENV, NEVER FROM THE BRAINER'S. `hw next` runs in the
# brainer's process, so $ENGRAM_PROJECT in this shell is the brainer's and would
# be a lie in the executor's prompt. The value the executor actually inherited
# was written once by `_write_run_env` at launch.
_next_message() {
  local nextseq="$1" entry_line="$2" text="$3" rundir="$4" brief_path="$5" wtdir="$6"
  local preamble epistemic
  preamble="$(
    BRIEF="$brief_path"
    HW_WORKDIR="$wtdir"
    ENGRAM_PROJECT="$(_run_env_value "$rundir" ENGRAM_PROJECT 2>/dev/null || printf brain)"
    # THE BASE, READ BACK RATHER THAN RECOMPUTED, for the reason the header of
    # this block already gives: `hw next` runs in the BRAINER process, where
    # neither PROJ nor a worktree path belongs to the executor. It is also the
    # correct value on a re-task — a merge-base does not move when task 1
    # commits, so task 2 is still reviewed from the same branch point, which is
    # the whole point of a boundary. ABSENT stays absent: a run hw could not
    # compute a base for gets no paragraph here either.
    #
    # NO APOSTROPHES IN THESE COMMENTS, and that is not style. This block is the
    # body of a `"$( ... )"` command substitution, and bash does NOT treat `#`
    # as starting a comment there: the first draft wrote "the BRAINER's process"
    # and the parser carried that quote forward until it died 60 lines later on
    # an unrelated `case`, naming a file and a construct with nothing wrong.
    HW_REVIEW_BASE_REF="$(_run_env_value "$rundir" HW_REVIEW_BASE_REF 2>/dev/null || true)"
    HW_REVIEW_BASE_BRANCH="$(_run_env_value "$rundir" HW_REVIEW_BASE_BRANCH 2>/dev/null || true)"
    HW_EXECUTOR_VENDOR="$(_run_env_value "$rundir" HW_EXECUTOR_VENDOR 2>/dev/null || true)"
    # THE LANE THIS RUN WAS ACTUALLY LAUNCHED FOR, read back the same way
    # ENGRAM_PROJECT is above — never the brainer's own $PROJ, which on a
    # --report-to re-task belongs to a different lane entirely. This is what
    # lets _brief_preamble's one-lane-only policy line survive a
    # `hw next` re-task instead of silently dropping it.
    PROJ="$(_run_env_value "$rundir" HW_PROJECT 2>/dev/null || true)"
    # The engram session registered at launch, read back from the receipt. A
    # value starting with none is a failed registration, and says nothing.
    HW_ENGRAM_SESSION="$(jq -r 'select(.key=="engram_session") | .value' "$rundir/receipt.jsonl" 2>/dev/null | tail -1 || true)"
    # An `if`, not a `case`: an unbalanced `)` inside this substitution breaks bash 3.2.
    if [ "${HW_ENGRAM_SESSION#none}" != "$HW_ENGRAM_SESSION" ]; then HW_ENGRAM_SESSION=""; fi
    _brief_preamble
  )"
  epistemic="$(_brief_epistemic)"
  # ONE printf, because `$( )` strips trailing newlines: a separator built at the
  # end of its own substitution vanishes and two blocks run together. Same
  # reason _send_brief keeps its separators inside the format string.
  printf 'NEXT TASK (task %s of this session — the previous one is closed and reported).\nYour ask budget and your done-invoker are reset for it: report this one with\ndone-invoker when it is finished, exactly as you did the last.\n\n%s---\n\n%s\n\n---\n\n%s\n\n---\n\n%s' \
    "$nextseq" "$entry_line" "$epistemic" "$preamble" "$text"
}

cmd_next() {
  local pane="" force=0 brief="" text="" dry=0 wait_ms=""
  # THE MODE MUST BE ABLE TO CROSS A RE-TASK. Hit twice on one lane: a
  # framework flow was re-tasked into a session hw had launched `--sdd none`, and it
  # worked only because the orchestrator still happened to hold the flow state.
  # `--dry-run` said nothing about it either. A per-task property that cannot be
  # set on the next task is not per-task.
  local next_sdd=""
  pane="${1:-}"; shift || true
  [ -n "$pane" ] || die "usage: hw next <executor-pane> [--sdd <mode>] [--force] [--dry-run] \"<next task>\" | --brief <path>  (flags may appear before or after the task text). Exit 0 means DELIVERED and the counter advanced; every refusal — a gate that would not open, an unknown pane, a task that has not reported — exits 1 and moves nothing."
  while [ $# -gt 0 ]; do
    case "$1" in
      --brief) _need_val "$@"; brief="$2"; shift 2 ;;
      --force) force=1; shift ;;
      # Everything except the send and the counter bump. Worth keeping past the
      # first test: re-tasking a live executor is the one operation here whose
      # mistakes cost somebody else's session.
      --dry-run) dry=1; shift ;;
      --wait-ms) _need_val "$@"; wait_ms="$2"; shift 2 ;;
      --sdd) _need_val "$@"; next_sdd="$2"; shift 2 ;;
      # Same override as the launch path's, reachable here too: `hw next`
      # hands a brief to an ALREADY-EXISTING worktree, which is exactly the
      # case _refuse_if_stale_hooks exists for. Forwarded by the automatic
      # reuse route below (`_reuse_args`) when the outer launch carried it.
      --allow-stale-hooks) ALLOW_STALE_HOOKS=1; shift ;;
      --) shift
          if [ $# -gt 0 ]; then
            if [ -n "$text" ]; then text="$text $*"; else text="$*"; fi
          fi
          break ;;
      -*) die "unknown option: $1" ;;
      # Accumulate and keep looping — a flag is valid in ANY position relative
      # to the task text, not just before it. `hw next <pane> "task" --dry-run`
      # used to swallow `--dry-run` into the text and dispatch for real.
      *)  if [ -n "$text" ]; then text="$text $1"; else text="$1"; fi
          shift ;;
    esac
  done

  if [ -n "$brief" ]; then
    [ -z "$text" ] || die "pass a brief or a task text, not both"
    [ -r "$brief" ] || die "cannot read brief: $brief"
    text="$(cat "$brief")"
  fi
  [ -n "$text" ] || die "the next task is empty — there is nothing to send"
  case "$next_sdd" in
    ""|speckit|none) ;;
    gentle) die "hw next --sdd gentle REFUSED: ODD enters Claude's system prompt at launch, and a re-task cannot add it to a live session. Nothing was sent. Launch it fresh: hw <project> <task> --sdd gentle --agent claude" ;;
    *) die "--sdd must be speckit or none (got: $next_sdd)" ;;
  esac

  _next_load_invoker_lib

  local info cwd vendor status
  info="$(herdr agent get "$pane" 2>/dev/null || true)"
  [ -n "$info" ] || die "$(_next_missing_pane_message "$pane")"
  cwd="$(printf '%s' "$info" | jq -r '.result.agent.cwd // empty' 2>/dev/null || true)"
  vendor="$(printf '%s' "$info" | jq -r '.result.agent.agent // empty' 2>/dev/null || true)"
  status="$(printf '%s' "$info" | jq -r '.result.agent.agent_status // empty' 2>/dev/null || true)"
  [ -n "$cwd" ] || die "herdr reports no cwd for $pane, so hw cannot find its run directory"

  local rundir
  rundir="$(_next_run_dir "$cwd")" \
    || die "no hw run directory at or above $cwd — that pane was not launched by hw, so it has no task state to advance"

  # Validate the effective framework against the measured alive pane before the
  # counter, task directory, surface, or delivery can move. Launch routing finds
  # reuse before validating a requested fresh vendor; that does not make an
  # incompatible framework safe to apply to the pane it actually selected.
  local next_wtdir prior_framework
  next_wtdir="$(dirname "$(dirname "$rundir")")"
  [ -d "$next_wtdir" ] || next_wtdir="$cwd"
  # A re-task hands a brief to a worktree that ALREADY EXISTS — the exact
  # shape of the branch-predates-the-cleanup problem this guards against — so
  # it is checked here too, not just at a fresh launch. No $MAIN/$BASE is
  # known in this call shape (`hw next <pane> "task"` names neither), so the
  # remedy text falls back to naming the mechanism generically rather than a
  # command this function cannot verify applies.
  _refuse_if_stale_hooks "$next_wtdir" "" ""
  # `_receipt` inside that call is a no-op here: $WT/$HW_RUN are the FRESH-
  # launch route's globals and are unset on this route. $rundir is this route's
  # own equivalent, so the override is recorded into it directly instead.
  [ -z "$STALE_HOOKS_ALLOWED_FILES" ] \
    || _receipt_into "$rundir" stale_hooks_allowed "$STALE_HOOKS_ALLOWED_FILES" "--allow-stale-hooks (hw next)"
  prior_framework="$(_run_dispatch_framework "$rundir")"
  _validate_sdd_vendor_pair "$vendor" "$next_sdd" "$next_wtdir" "$prior_framework"
  # A re-task cannot change the pane's model, so the launch record is the only
  # place the orchestrator's model exists by the time an SDD mode is applied to
  # it. A pane launched sonnet/none and later handed --sdd speckit is the same
  # inversion the launch gate refuses, arriving by the one door that has no
  # --model flag at all.
  _validate_sdd_model_pair "$(_next_dispatch_model "$rundir")" "this pane was launched with that model; hw next cannot change it"

  # BEFORE the gates that cost time, so `--dry-run` answers the question a
  # brainer actually has — "is this pane still worth reusing?" — without
  # sending anything.
  _report_pane_context "$pane"

  # Precedence is deliberate: an explicit call-site setting wins for an
  # exceptional handoff, then the target's launch contract, then 90s only for
  # legacy runs that predate the contract. HW_INVOKER_WAIT_MS is unrelated: it
  # gates executor -> brainer delivery and must not silently tune this gate.
  if [ -z "$wait_ms" ]; then
    wait_ms="${HW_NEXT_WAIT_MS:-}"
    [ -n "$wait_ms" ] || wait_ms="$(_next_wait_from_run "$rundir" || true)"
    [ -n "$wait_ms" ] || wait_ms=90000
  fi
  case "$wait_ms" in ''|*[!0-9]*) die "--wait-ms/HW_NEXT_WAIT_MS must be a positive integer in milliseconds (got: $wait_ms)" ;; esac

  local seq="" marker
  [ -r "$rundir/task" ] && seq="$(tr -dc '0-9' < "$rundir/task" 2>/dev/null || true)"
  case "$seq" in ''|0) seq=1 ;; esac
  marker="$(_run_done_marker "$rundir")"

  # An unreported task is not a finished one. Replacing it silently would file
  # its work as never-dispatched and leave the brainer believing both landed.
  #
  # THE DERIVATION MOVED to `_report_evidence` on 2026-09-16, unchanged, so
  # `hw done` could refuse an in-use pane on the SAME two signals rather than
  # inventing a second answer to the same question. Its comment carries the
  # incident this shape came from; only the refusal sentence is owned here,
  # because re-tasking and closing are different things to be stopped from.
  if [ ! -f "$marker" ] && [ "$force" != 1 ]; then
    _next_ev="$(_report_evidence "$pane" "$rundir")"
    case "$_next_ev" in
      token*)
        _report_evidence_explain "$pane" "$_next_ev" "$marker"
        info "proceeding without --force; read its report with: herdr agent get $pane"
        ;;
      *)
        die "task $seq of $(basename "$rundir") has not reported: no $marker, and $pane publishes no done token either — so there is no evidence it finished, from either source. Wait for its done-invoker, or override with --force if you are deliberately re-tasking an executor that will never report."
        ;;
    esac
  fi

  # channel-send, not `herdr agent prompt`: the receipt is the point. Resolved
  # BEFORE the gate, so a dry run proves the route too — which route an executor
  # gets is the part that differs per harness, so it is the part worth being
  # able to check without sending anything.
  local route target endpoint
  invoker_resolve_sender "$pane"
  if _next_finished_stale_stuck "$info" \
     && [ "$INVOKER_SENDER_VENDOR" = opencode ] \
     && [ -z "$INVOKER_SENDER_SESSION" ] \
     && [ -n "$INVOKER_SENDER_ENDPOINT" ]; then
    INVOKER_SENDER_SESSION="$(_next_opencode_session_from_receipt "$rundir" "$pane" || true)"
  fi
  if _vendor_has_native_transport "${INVOKER_SENDER_VENDOR:-}" \
     && [ -n "$INVOKER_SENDER_SESSION" ] \
     && [ -n "$INVOKER_SENDER_ENDPOINT" ]; then
    route="$INVOKER_SENDER_VENDOR"
    target="$INVOKER_SENDER_SESSION"
    endpoint="$INVOKER_SENDER_ENDPOINT"
  else
    route=herdr; target="$pane"; endpoint=-
  fi

  # A DRY RUN NEVER ENTERS THE DELIVERY GATE, and never touches the pane.
  #
  # It used to sit AFTER the wait, so `hw next <pane> --dry-run "…"` inherited
  # the full budget against a pane that would never change and printed nothing
  # for over three minutes before being killed — measured 2026-08-27 against
  # w4C:p9W, exit 144. A command whose entire purpose is to tell you what would
  # happen must not be the slowest way to find out, and "the gate would not
  # open" is the single most useful thing it can report.
  #
  # It also used to run AFTER invoker_clear_opencode_question, which DISMISSES A
  # MODAL. A dry run that answers a question on the executor's behalf is worse
  # than one that waits.
  #
  # So the gate is described, not entered: the witness reads the same facts the
  # gate would, read-only, and says which way it would go.
  if [ "$dry" = 1 ]; then
    local chaining_seconds_dry="" chaining_state_dry=""
    chaining_seconds_dry="$(_run_env_value "$rundir" HW_CHAINING_LEASE_SECONDS || true)"
    if [ -n "$chaining_seconds_dry" ]; then
      chaining_state_dry="$(_chaining_lease_eligibility "$rundir" "$seq")"
      if [ "$chaining_state_dry" != live ]; then
        die "$(_chaining_lease_ineligible_message "$chaining_state_dry" "$seq" "$rundir")"
      fi
    fi
    local nextseq_dry="$((seq + 1))"
    ok "dry run: $pane is reachable, on task $seq of $(basename "$rundir") — NOTHING was sent and the pane was not touched"
    info "route $route -> $target${endpoint:+ (endpoint $endpoint)}"
    info "would create $rundir/t$nextseq_dry and deliver $(printf '%s' "$(_next_message "$nextseq_dry" "" "$text" "$rundir" "$brief" "$next_wtdir")" | wc -c | tr -d ' ') bytes as task $nextseq_dry ($(printf '%s' "$text" | wc -c | tr -d ' ') of them the task text; the rest is the preamble hw prepends, minus any framework entry line)"
    if [ -n "$chaining_seconds_dry" ]; then
      info "this one use would be consumed only after successful delivery; dry-run lease state is volatile and was not touched"
    fi
    if _next_finished_stale_stuck "$info"; then
      ok "the delivery gate WOULD OPEN: $pane has authoritative delivered completion tokens; its blocked/stuck lifecycle token is stale (budget ${wait_ms}ms, unspent)"
    else
      case "$status" in
        idle|done)
          ok "the delivery gate WOULD OPEN: herdr reports $pane $status, so a prompt would be read now (budget ${wait_ms}ms, unspent)"
            ;;
          *)
            info "herdr reports $pane $status, so the gate would wait (budget ${wait_ms}ms). Cross-checking whether that state can still change — this does not send, dismiss or wait:"
            witness_state "$pane"
            case "$WITNESS_VERDICT" in
              live)
                info "gate verdict: WOULD WAIT, and correctly. $WITNESS_DETAIL"
                ;;
              awaiting-human)
                warn "gate verdict: WOULD NOT OPEN. $WITNESS_DETAIL"
                ;;
              settled)
                warn "gate verdict: WOULD NOT OPEN, and no budget would help. $WITNESS_DETAIL"
                warn "a real run would refuse here after confirming that twice, instead of spending ${wait_ms}ms on it"
                ;;
              *)
                info "gate verdict: UNDETERMINED. $WITNESS_DETAIL"
                ;;
            esac
            ;;
      esac
    fi
    if [ -n "$next_sdd" ]; then
      local dry_entry
      dry_entry="$(_framework_entry "$next_sdd")"
      info "would set SDD mode $next_sdd on the worktree, entry ${dry_entry:-<none for this mode>}"
    else
      info "SDD surface: unchanged — compatibility checked using the effective mode; live surface takes precedence, with the launch record as fallback when no live mode is obtained"
    fi
    return 0
  fi

  # Gate BEFORE the counter moves: a bump that is not followed by a delivered
  # prompt would leave the executor's invokers pointing at a task it was never
  # given, and its next done-invoker would write a marker for nothing.
  # BEFORE the wait, not after it. A pane reading `blocked` is never going to
  # reach idle on its own — that is the whole finding — so spending the budget
  # first only delays the rescue by however long the caller was willing to
  # wait. Measured: 94s to deliver with the attempt after the wait, ~4s with it
  # before. The helper re-checks `blocked` itself and returns immediately on
  # anything else, so calling it here costs one agent.get on the normal path.
  # witness_wait, not invoker_wait_for_brainer: same gate, same budget, same
  # `idle,done` condition, plus the one thing the raw wait cannot do — notice
  # that it is waiting on a state which has been PROVED unable to change, and
  # stop. Exit 5 is that, and only that. Exit 2 is still an ordinary timeout,
  # which is what an `unknown` cross-check must cost: nothing extra.
  local gate_rc=0
  if _next_finished_stale_stuck "$info"; then
    info "$pane already reported with delivered completion tokens; ignoring its stale blocked/stuck lifecycle token and re-tasking without --force."
  else
    if invoker_clear_opencode_question "$pane"; then
      info "$pane was blocked on its own opencode question modal; dismissed it (the executor sees question.rejected) and the pane reached idle. Re-tasking now."
    fi
    witness_wait "$pane" "$wait_ms" || gate_rc=$?
  fi
  if [ "$gate_rc" != 0 ]; then
    # One rescue before the die, and only one shape of rescue. An opencode
    # executor parked on its own `question` modal reads `blocked` and STAYS
    # there — the plugin has no event left to publish, so no budget and no
    # retry reaches idle. That is the dead end this whole gate used to have no
    # move for, and pressing one key is the move. `--force` is NOT: it files
    # the task as abandoned to get past a pane that is merely waiting.
    if invoker_clear_opencode_question "$pane"; then
      info "$pane was blocked on its own opencode question modal; dismissed it (the executor sees question.rejected) and the pane reached idle. Re-tasking now."
    else
      local busy_info
      busy_info="$(herdr agent get "$pane" 2>/dev/null || true)"
      # A GATE THAT GIVES UP SAYS WHICH FACT IT READ AND WHAT CONTRADICTED IT.
      # For eight hours this class of failure looked like "timed out" from
      # outside, which is why nobody could act on it. WITNESS_DETAIL names the
      # reader, the source and the disagreement; the existing message still
      # carries the state-specific advice, so both are printed.
      # A PANE WAITING FOR A PERSON IS NOT A BUSY PANE, and the advice is not
      # the same. Without this branch gate_rc 6 fell through to the generic
      # busy message, which tells the caller to wait or retry — for a state that
      # only a human answering a prompt can move. The witness has already read
      # that pane's own endpoint and had it CONFIRM an outstanding
      # /question or /permission, so say that, and say the one thing that is
      # never the answer here: --force files an unreported task as abandoned to
      # get past a pane that is merely waiting for someone to press a key.
      if _next_finished_stale_stuck "$busy_info"; then
        info "$pane reported while the gate was checking it; delivered completion tokens now prove blocked/stuck is stale. Re-tasking without --force."
        # Route selection happened before the wait. Re-resolve it from the
        # completion snapshot so an OpenCode session omitted while blocked can
        # use its exact launch-receipt binding instead of falling into Herdr's
        # second blocked-state gate.
        invoker_resolve_sender "$pane"
        if [ "$INVOKER_SENDER_VENDOR" = opencode ] \
           && [ -z "$INVOKER_SENDER_SESSION" ] \
           && [ -n "$INVOKER_SENDER_ENDPOINT" ]; then
          INVOKER_SENDER_SESSION="$(_next_opencode_session_from_receipt "$rundir" "$pane" || true)"
        fi
        if _vendor_has_native_transport "${INVOKER_SENDER_VENDOR:-}" \
           && [ -n "$INVOKER_SENDER_SESSION" ] \
           && [ -n "$INVOKER_SENDER_ENDPOINT" ]; then
          route="$INVOKER_SENDER_VENDOR"
          target="$INVOKER_SENDER_SESSION"
          endpoint="$INVOKER_SENDER_ENDPOINT"
        else
          route=herdr; target="$pane"; endpoint=-
        fi
      else
        if [ "$gate_rc" = 6 ]; then
          warn "$WITNESS_DETAIL"
          die "$pane is waiting for a PERSON, not for time: its own endpoint confirms a prompt is outstanding (see above). The task counter did NOT move and nothing was sent. Answer that prompt on the pane — or have ${HW_OPERATOR:-the operator} answer it — and re-run this identical hw next. Do not raise the budget and do not reach for --force: neither answers a question."
        fi
        if [ "$gate_rc" = 5 ]; then
          warn "$WITNESS_DETAIL"
          die "$(_next_settled_message "$pane" "$wait_ms" "$busy_info")"
        fi
        [ -z "${WITNESS_DETAIL:-}" ] || warn "cross-check: $WITNESS_DETAIL"
        die "$(_next_busy_message "$pane" "$wait_ms" "$busy_info")"
      fi
    fi
  fi

  local nextseq="$((seq + 1))"
  mkdir -p "$rundir/t$nextseq" || die "cannot create $rundir/t$nextseq"

  # The mode is set on the WORKTREE before the brief is sent, in that order: an
  # entry command that arrives before its framework is loaded is an instruction
  # the executor cannot follow.
  local entry_line=""
  if [ -n "$next_sdd" ]; then
    local entry
    entry="$(_framework_entry "$next_sdd")"
    _apply_sdd "$next_wtdir" "$next_sdd" \
      || die "--sdd $next_sdd has no speckit-* skill on disk for $next_wtdir, so nothing was sent and the task counter did not move. Install Spec Kit where it is used, or re-task with --sdd none."
    if [ -n "$entry" ]; then
      entry_line="$(printf 'FIRST ACTION, before anything else: run %s for this task. The framework mode\nfor it is %s and what follows is its input, not a licence to start editing.\n\n' "$entry" "$next_sdd")"
      # A plain assignment, not `$( )`: command substitution strips trailing
      # newlines, and _next_message prints this directly before its `---`.
      [ "$next_sdd" != speckit ] || entry_line="$entry_line"$'\n\n'"$(_speckit_phase_note)"$'\n\n'
    else
      entry_line="$(printf 'Framework mode for this task: %s. hw forces no entry command.\n\n' "$next_sdd")"
    fi
  fi

  # The executor is told its own bookkeeping changed, because its budgets did —
  # and, since 2026-09-21, it is told the rest of what a launch tells one.
  local msg
  msg="$(_next_message "$nextseq" "$entry_line" "$text" "$rundir" "$brief" "$next_wtdir")"

  # New bounded-chaining runs have a lease only after proved report delivery.
  # Hold the SAME per-run lock as done-invoker and the detached expiry action
  # across delivery, lease consumption, and counter advance. Expiry therefore
  # cannot close between those acts, and a failed send leaves the lease intact.
  local chaining_seconds="" chaining_locked=0
  chaining_seconds="$(_run_env_value "$rundir" HW_CHAINING_LEASE_SECONDS || true)"
  if [ -n "$chaining_seconds" ]; then
    _chaining_lock_take "$rundir" || die "could not acquire the run/task lock before consuming its chaining lease"
    chaining_locked=1
    local chaining_state
    chaining_state="$(_chaining_lease_eligibility "$rundir" "$seq")"
    if [ "$chaining_state" != live ]; then
      _chaining_lock_release
      die "$(_chaining_lease_ineligible_message "$chaining_state" "$seq" "$rundir")"
    fi
  fi

  local send_rc=0
  if [ "$route" = opencode ]; then
    "$HW_BIN_DIR/channel-send" --require processed --id "$(basename "$rundir"):t$nextseq" \
      "$route" "$target" "$endpoint" "$msg" >/dev/null || send_rc=$?
  else
    "$HW_BIN_DIR/channel-send" "$route" "$target" "$endpoint" "$msg" >/dev/null || send_rc=$?
  fi
  # EXIT 4 IS NOT A FAILED DELIVERY. channel-send returns it only after the
  # message is proven present in the receiver's session; what did not finish is
  # the TURN. Rolling the counter back there would be the worse of the two
  # errors: the executor holds task N+1 while its invokers still call it N, so
  # its report would be filed against the task it no longer has.
  #
  # This is the incident that made the distinction necessary. On 2026-08-25 the
  # old synchronous route returned `HTTP 500 UnknownError` re-tasking
  # a product-lane task; hw called it undelivered, rolled back, and
  # the orchestrator — reasonably, given what hw told it — concluded the
  # executor was unreachable and closed it. Nothing proved the message had NOT
  # landed. Now the two outcomes have different exit codes and different words.
  if [ "$send_rc" = 4 ] && [ "$route" = opencode ]; then
    warn "$pane ACCEPTED task $nextseq — it is in its session — but the turn it started did not complete (see the message above)."
    warn "that is a turn failure, not a delivery failure, so the counter advances: rolling it back would leave the executor holding a task its invokers do not know about."
    info "check what it did with: herdr agent read $pane --source recent-unwrapped"
  elif [ "$send_rc" != 0 ]; then
    rmdir "$rundir/t$nextseq" 2>/dev/null || true
    [ "$chaining_locked" = 0 ] || _chaining_lock_release
    die "delivery to $pane failed via $route (exit $send_rc). The task counter was NOT advanced, so the executor is still on task $seq and its next done-invoker still refers to the task it actually ran. The pane is untouched and still usable — a failed delivery is not a reason to close an executor; fix the transport and retry."
  fi

  # Only now. The counter is the executor's contract with its own invokers, and
  # advancing it before proven delivery is how a task gets a budget but no brief.
  if [ "$chaining_locked" = 1 ]; then
    printf 'state=consumed\nconsumed_at=%s\nconsumed_by=%s\n' \
      "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "${HERDR_PANE_ID:-unknown}" >> "$(_chaining_lease_path "$rundir")" \
      || { _chaining_lock_release; die "task delivered, but its chaining lease could not be marked consumed; refusing to advance the counter"; }
  fi
  # THE NEW TASK'S BOUNDARY, when its brief declares one — keyed by the task
  # number, so done-invoker holds task N+1 to its own brief and not to task 1's.
  # After proven delivery and with the counter, never before: a failed send
  # must not leave a gate for a task that never arrived.
  # The SAME gate _next_message's preamble ran — inherited TASK_KIND and all —
  # so the executor is never held to a judgment its prompt did not ask for (on
  # the reuse route a name-inferred or `asked: investigate` kind is in scope).
  if [ -n "$brief" ] && BRIEF="$brief" _design_gate_applies; then
    _receipt_into "$rundir" "design_boundary_t$nextseq" "$(_brief_boundary "$brief")" \
      "brief frontmatter boundary: in $brief at hw next — done-invoker requires an APPROVED design judgment"
  fi
  printf '%s\n' "$nextseq" > "$rundir/task" \
    || { [ "$chaining_locked" = 0 ] || _chaining_lock_release; die "delivered, but could not write $rundir/task — the executor is on task $nextseq and its invokers still think $seq. Write that file by hand before it reports."; }
  [ "$chaining_locked" = 0 ] || _chaining_lock_release
  ok "task $nextseq dispatched to $pane via $route (${vendor:-unknown} executor, $(printf '%s' "$msg" | wc -c | tr -d ' ') bytes)"
  info "state for it: $rundir/t$nextseq — fresh ask budget, no done marker"
  return 0
}

# ── hw wait ──────────────────────────────────────────────────────────────────
#
# WAITING HAD NO WITNESS, AND THAT IS WHY THIS EXISTS.
#
# Every gate in this toolchain cross-checks before it gives up — channel-send's
# two gates, `hw next`, `hw unstick`. None of that reaches the call a brainer
# actually makes when all it wants is "tell me when this executor is done":
#
#     herdr agent wait <pane> --until idle --timeout 1800000
#
# That is herdr's own binary. No fix of ours is inside it, it believes
# `agent_status`, and on this machine `agent_status` lies. Measured 2026-08-27,
# three brainer stalls in one day, all this shape: `w41:p6H` on a 1200000ms
# budget against a pane publishing `working` and `turn_state=ended_unreported`
# at the same time; `w41:p2` on 600000ms; `w41:p7B` on 1800000ms against a pane
# publishing `blocked/stuck:root` while its own screen was visibly moving.
#
# The gap was never a bug in a gate. It was that THERE WAS NO WITNESS-BACKED WAY
# TO WAIT, so the raw call was the only thing available and brainers kept using
# it. This is the missing surface, and it is the same witness `hw next` and
# `hw unstick` already run — one authority, not a second opinion.
#
# WHAT IT ADDS OVER THE RAW CALL, and nothing else:
#   • it returns on a VERDICT rather than on a budget;
#   • `live` keeps the full budget and SAYS SO each round, because a silent
#     30-minute wait and a hung process look identical from outside, and that
#     resemblance is part of why the raw call kept being trusted;
#   • `unknown` falls back to exactly the raw behaviour AND says the cross-check
#     was unavailable. That property is not a nicety: it is the only reason the
#     other three verdicts may be acted on at all.
#
# EXIT CODES ARE VERDICTS HERE, NOT REFUSALS. `hw`'s one-failure-code rule
# (1 = every refusal) is intact: a bad argument, an unknown pane and a missing
# library are all still 1. 2/5/6/7 are reports about the TARGET from a wait
# that ran to completion, and they are numbered to match witness_wait's own
# codes so the toolchain has one number space rather than two.
WAIT_PROGRESS_LAST_DETAIL=""
WAIT_PROGRESS_PANE=""
WAIT_PROGRESS_REASON_PRINTED=0
_wait_progress() {
  # $1 verdict  $2 detail  $3 elapsed_s  $4 remaining_s
  # The detail carries the evidence behind a verdict. Reprinting the same
  # paragraph every slice adds no evidence and consumed a brainer's context.
  if [ "$WAIT_PROGRESS_REASON_PRINTED" = 1 ]; then
    case "$1" in
      live) info "${WAIT_PROGRESS_PANE:-target}: still LIVE after ${3}s (${4}s left)" ;;
      settled) info "${WAIT_PROGRESS_PANE:-target}: still SETTLED after ${3}s; confirming" ;;
      awaiting-human) info "${WAIT_PROGRESS_PANE:-target}: still awaiting a PERSON after ${3}s; confirming" ;;
      unknown) info "${WAIT_PROGRESS_PANE:-target}: cross-check still unavailable after ${3}s (${4}s left)" ;;
    esac
    return 0
  fi
  WAIT_PROGRESS_LAST_DETAIL="$2"
  WAIT_PROGRESS_REASON_PRINTED=1
  case "$1" in
    live)   info "still LIVE after ${3}s (${4}s of budget left) — its screen moved between samples, so this is a real wait. $2" ;;
    # Announced on the FIRST sighting, not only when the streak completes.
    # witness_wait deliberately requires two confirmations a slice apart before
    # it acts, and a caller who is told nothing until then spends that span
    # unable to distinguish "about to stop" from "nothing happening".
    settled) info "cross-check says SETTLED after ${3}s; confirming once more before ending the wait. $2" ;;
    awaiting-human) info "cross-check says a PERSON is being waited on, after ${3}s; confirming once more. $2" ;;
    unknown) info "cross-check UNAVAILABLE after ${3}s (${4}s left) — keeping the ordinary budget. $2" ;;
  esac
}

_wait_timeout_summary() {
  local pane="$1" wait_ms="$2"
  # If the callback already printed this exact evidence, the final line names
  # the last verdict without copying the paragraph again. This is still a
  # truthful diagnosis: the full source-backed reason remains immediately above.
  if [ -n "$WITNESS_DETAIL" ] && [ "$WAIT_PROGRESS_REASON_PRINTED" = 1 ]; then
    case "$WITNESS_VERDICT" in
      live) printf 'budget of %ss spent and %s never reached idle/done. Last cross-check: LIVE — its screen was still moving; full witness reasoning is above.' "$((wait_ms / 1000))" "$pane" ;;
      unknown) printf 'budget of %ss spent and %s never reached idle/done. Last cross-check: UNAVAILABLE — a required reader still could not be trusted; full witness reasoning is above.' "$((wait_ms / 1000))" "$pane" ;;
      *) printf 'budget of %ss spent and %s never reached idle/done. Last cross-check: %s — full witness reasoning is above.' "$((wait_ms / 1000))" "$pane" "${WITNESS_VERDICT:-unknown}" ;;
    esac
    return 0
  fi
  printf 'budget of %ss spent and %s never reached idle/done.%s' \
    "$((wait_ms / 1000))" "$pane" "${WITNESS_DETAIL:+ Last cross-check: $WITNESS_DETAIL}"
}

# _wait_false_pair <agent-get-json>
#
# Prints a description when the pane carries BOTH halves of the named broken
# state, empty otherwise.
#
#   turn_state=ended_unreported   the turn-end adapter fired and the executor
#                                 had still not reported
#   done_state=undelivered        done-invoker published its tokens and the
#                                 delivery did NOT land (it rewrites this to
#                                 `delivered` only once the receiver proves it)
#
# EITHER ALONE IS ORDINARY. `ended_unreported` on its own is a turn that ended —
# a background-subagent notification opens a turn without a prompt, so a healthy
# executor publishes it routinely (measured on w30:p54, mid-work, turns=6).
# `undelivered` on its own is a delivery still in flight, which the executor's
# own retry may well complete.
#
# TOGETHER they are neither: the report exists, it did not arrive, and the turn
# that would have retried it is over. Nobody is going to fix that from inside
# the pane, so a wait against it cannot end well no matter how large the budget.
_wait_false_pair() {
  local info_json="$1" turn done_state done_status turn_at
  turn="$(printf '%s' "$info_json" | jq -r '.result.agent.tokens.turn_state // empty' 2>/dev/null || true)"
  done_state="$(printf '%s' "$info_json" | jq -r '.result.agent.tokens.done_state // empty' 2>/dev/null || true)"
  [ "$turn" = ended_unreported ] || return 0
  [ "$done_state" = undelivered ] || return 0
  done_status="$(printf '%s' "$info_json" | jq -r '.result.agent.tokens.done_status // empty' 2>/dev/null || true)"
  turn_at="$(printf '%s' "$info_json" | jq -r '.result.agent.tokens.turn_ended_at // empty' 2>/dev/null || true)"
  printf 'it published done_status=%s with done_state=undelivered — so the report exists and did NOT reach the brainer — and its turn-end adapter published turn_state=ended_unreported%s, so the turn that would have retried the delivery is over' \
    "${done_status:-absent}" "${turn_at:+ at $turn_at}"
}

# A SETTLED verdict answers "is anything moving" — it does not answer WHY, and
# `blocked_reason=stuck` outlives its task the same way an ask token does (see
# _next_busy_message above). Measured live 2026-09-03, w7G:p26: settled,
# blocked_reason=stuck, done_status=done/done_state=delivered — a finished,
# reusable executor, not a stuck one. `hw wait --dry-run`'s generic settled
# message is still true (nothing IS moving) but reads as an invitation to
# `hw unstick`, which would restart a session with nothing left to do. This
# adds the one fact the generic witness cannot see — the tokens already
# carried in `$info_json`, no extra herdr call — and says nothing when it does
# not apply.
_settled_already_reported_note() {
  local info_json="$1" done_status done_state
  done_status="$(printf '%s' "$info_json" | jq -r '.result.agent.tokens.done_status // empty' 2>/dev/null || true)"
  case "$done_status" in done|blocked) ;; *) return 0 ;; esac
  done_state="$(printf '%s' "$info_json" | jq -r '.result.agent.tokens.done_state // empty' 2>/dev/null || true)"
  warn "it already reported (done_status=$done_status, done_state=${done_state:-unknown}) — whatever blocked/stuck token herdr is still showing is stale, published on a pane that has finished. Do not \`hw unstick\` it. \`hw next\` to reuse it, or \`hw done\` to close it."
}

cmd_wait_one() {
  local pane="" wait_ms="${HW_WAIT_MS:-900000}" dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --timeout-ms) shift; [ $# -gt 0 ] || die "usage: hw wait <pane> [--timeout-ms <ms>] [--dry-run]"
                    wait_ms="$1"; shift ;;
      -*) die "unknown option: $1 (usage: hw wait <pane> [--timeout-ms <ms>] [--dry-run])" ;;
      *) [ -z "$pane" ] || die "usage: hw wait <pane> [--timeout-ms <ms>] [--dry-run] — one pane at a time"
         pane="$1"; shift ;;
    esac
  done
  [ -n "$pane" ] || die "usage: hw wait <pane> [--timeout-ms <ms>] [--dry-run] — the pane of the executor you are waiting on, e.g. \`hw wait w41:p7B\`"
  case "$wait_ms" in ''|*[!0-9]*) die "--timeout-ms must be a whole number of milliseconds, got: $wait_ms" ;; esac

  local info_json
  info_json="$(herdr agent get "$pane" 2>/dev/null || true)"
  # An unreadable pane is a REFUSAL, not a verdict: hw never waited, so it has
  # nothing to report about the target and must not occupy a verdict code that
  # a caller would read as a finding.
  printf '%s' "$info_json" | jq -e '.result.agent' >/dev/null 2>&1 \
    || die "$pane is not an agent pane herdr can read (herdr agent get returned nothing usable). Nothing was waited on. Check the id with \`herdr agent list\`."

  _load_state_witness

  local turn_state
  turn_state="$(printf '%s' "$info_json" | jq -r '.result.agent.tokens.turn_state // empty' 2>/dev/null || true)"
  if [ "$turn_state" = handback_refused ]; then
    warn "$pane ended a turn with no report, no delivered ask/challenge outstanding, and no named human-boundary exception."
    die_rc 8 "HAND-BACK REFUSED: no wait was started. The executor has every legal exit in front of it: continue working; report with \`done-invoker\`; report the blocking question with \`done-invoker --blocked \"<question and what would unblock it>\"\`; or, only for money/third-party/irreversible-outward/priority decisions, record \`hw human-boundary \"<specific boundary and why only ${HW_OPERATOR:-the operator} can decide>\"\` before ending the turn."
  fi

  # BEFORE ANY BUDGET IS SPENT. The pair below is the one state where waiting is
  # provably pointless and the whole point of this command is not to sit through
  # a budget to discover that.
  local pair
  pair="$(_wait_false_pair "$info_json")"
  if [ -n "$pair" ]; then
    warn "$pane ENDED AND NEVER REPORTED: $pair."
    die_rc 7 "no wait was started, because none can end well: nothing inside that pane is going to deliver the report. Read what it established with \`herdr agent get $pane\` (tokens sum/sum2/…) and its engram observations, then close it with \`hw done\`. Do NOT reach for a larger budget and do NOT hw unstick it — the work is finished, only the delivery failed."
  fi

  if [ "$dry" = 1 ]; then
    witness_state "$pane"
    case "$WITNESS_VERDICT" in
      live)  info "WOULD WAIT, and correctly. $WITNESS_DETAIL"; exit 0 ;;
      settled) warn "WOULD NOT WAIT: $WITNESS_DETAIL"
               _settled_already_reported_note "$info_json"
               exit 5 ;;
      awaiting-human) warn "WOULD NOT WAIT: $WITNESS_DETAIL"; exit 6 ;;
      *) info "UNDETERMINED, so a real \`hw wait\` would keep its ordinary ${wait_ms}ms budget and say the cross-check was unavailable. $WITNESS_DETAIL"; exit 2 ;;
    esac
  fi

  info "waiting on $pane for up to $((wait_ms / 1000))s, cross-checked every $((${WITNESS_SLICE_MS:-20000} / 1000))s. Ctrl-C is safe: nothing is sent to that pane, ever."
  local rc=0
  # Set and unset EXPLICITLY. A `VAR=x fn` prefix on a shell function is not
  # scoped the way it is on an external command: bash leaves the assignment in
  # place after the function returns, which would leak this progress printer
  # into every later witness_wait in the same process.
  WAIT_PROGRESS_LAST_DETAIL=""
  WAIT_PROGRESS_PANE="$pane"
  WAIT_PROGRESS_REASON_PRINTED=0
  WITNESS_ON_VERDICT=_wait_progress
  witness_wait "$pane" "$wait_ms" || rc=$?
  WITNESS_ON_VERDICT=""
  case "$rc" in
    0) ok "$pane reached idle/done. It is ready for \`hw next\`, or for you to read its report."; exit 0 ;;
    5) [ "$WAIT_PROGRESS_REASON_PRINTED" = 1 ] || warn "$WITNESS_DETAIL"
       warn "$pane is SETTLED: that state was proved unable to change, so the remaining budget would have bought nothing. Look at the pane and decide what it needs — \`hw done\` and dispatch again is usually it. A larger budget is never the answer here."
       _settled_already_reported_note "$info_json"
       exit 5 ;;
    6) [ "$WAIT_PROGRESS_REASON_PRINTED" = 1 ] || warn "$WITNESS_DETAIL"
       warn "$pane is waiting for a PERSON, not for time: its own endpoint confirms an outstanding prompt. Answer it on the pane — or have ${HW_OPERATOR:-the operator} answer it — and re-run this identical command. No budget answers a question."
       exit 6 ;;
    2) warn "$(_wait_timeout_summary "$pane" "$wait_ms")"
       exit 2 ;;
    # herdr-rpc's own transport codes, passed through exactly as the raw wait
    # would: 3 could not connect, 4 the RPC errored. These are facts about the
    # multiplexer, never about the pane, and dressing them up as a verdict about
    # the executor is the precise mistake this command exists to stop.
    *) warn "the wait itself failed (herdr-rpc exit $rc: 3 = could not connect, 4 = rpc error). That is a fact about herdr, NOT about $pane, and nothing was established about that executor."
       exit "$rc" ;;
  esac
}

# One target in the monitor tab. Each target gets its own process and witness
# cadence, so one verdict cannot discard the other N-1. Notifications are
# out-of-band facts, not prompts injected into the brainer's input queue.
_wait_monitor_one() {
  local pane="$1" wait_ms="$2" rc=0 label body
  "$HW_BIN_DIR/hw" wait-one "$pane" --timeout-ms "$wait_ms" || rc=$?
  case "$rc" in
    0) label=ready; body="reached idle/done" ;;
    2) label=timeout; body="spent its wait budget" ;;
    5) label=settled; body="proved unable to change" ;;
    6) label=awaiting-human; body="confirmed a person is required" ;;
    7) label=stranded; body="ended with an undelivered report" ;;
    8) label=handback-refused; body="ended without a legal handoff fact" ;;
    *) label="wait-error-$rc"; body="the monitor could not establish an executor verdict" ;;
  esac
  herdr notification show "wait $label · $pane" \
    --body "$body — monitor tab ${HERDR_TAB_ID:-unknown}" --sound done >/dev/null 2>&1 || true
  return "$rc"
}

cmd_wait_monitor() {
  local wait_ms="" pane rc=0 child_rc=0 pid
  local -a panes=() pids=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout-ms) shift; [ $# -gt 0 ] || die "usage: hw wait-monitor --timeout-ms <ms> <pane> [pane ...]"
                    wait_ms="$1"; shift ;;
      -*) die "unknown internal wait-monitor option: $1" ;;
      *) panes+=("$1"); shift ;;
    esac
  done
  [ -n "$wait_ms" ] && [ "${#panes[@]}" -gt 0 ] || die "usage: hw wait-monitor --timeout-ms <ms> <pane> [pane ...]"
  printf 'Monitoring %s executor(s) concurrently. This tab owns the waits; the brainer remains reachable.\n' "${#panes[@]}"
  for pane in "${panes[@]}"; do
    _wait_monitor_one "$pane" "$wait_ms" &
    pids+=("$!")
  done
  for pid in "${pids[@]}"; do
    child_rc=0; wait "$pid" || child_rc=$?
    [ "$child_rc" = 0 ] || rc="$child_rc"
  done
  printf 'Monitor complete: every target reached a verdict. Close this tab when you have read it.\n'
  return "$rc"
}

# Public wait launches a separate monitor and returns; it never puts a blocking
# wait inside the brainer's turn. `--dry-run` remains a synchronous one-shot
# diagnostic and creates no tab.
cmd_wait() {
  local wait_ms="${HW_WAIT_MS:-900000}" dry=0 pane raw tab monitor command q rc=0 one_rc=0
  local -a panes=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --timeout-ms) shift; [ $# -gt 0 ] || die "usage: hw wait <pane> [pane ...] [--timeout-ms <ms>] [--dry-run]"
                    wait_ms="$1"; shift ;;
      -*) die "unknown option: $1 (usage: hw wait <pane> [pane ...] [--timeout-ms <ms>] [--dry-run])" ;;
      *) panes+=("$1"); shift ;;
    esac
  done
  [ "${#panes[@]}" -gt 0 ] || die "usage: hw wait <pane> [pane ...] [--timeout-ms <ms>] [--dry-run]"
  case "$wait_ms" in ''|*[!0-9]*) die "--timeout-ms must be a whole number of milliseconds, got: $wait_ms" ;; esac

  if [ "$dry" = 1 ]; then
    for pane in "${panes[@]}"; do
      one_rc=0; "$HW_BIN_DIR/hw" wait-one "$pane" --timeout-ms "$wait_ms" --dry-run || one_rc=$?
      [ "$one_rc" = 0 ] || rc="$one_rc"
    done
    return "$rc"
  fi

  [ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_WORKSPACE_ID:-}" ] \
    || die "a non-blocking wait needs a Herdr-managed caller so hw can create a separate monitor tab. Run from the brainer pane, or use --dry-run for a synchronous one-shot verdict."
  # Validate the complete set first. A typo must not leave a monitor watching
  # N-1 targets while silently omitting the one the caller meant.
  for pane in "${panes[@]}"; do
    raw="$(herdr agent get "$pane" 2>/dev/null || true)"
    printf '%s' "$raw" | jq -e '.result.agent' >/dev/null 2>&1 \
      || die "$pane is not an agent pane herdr can read. No monitor tab was created; fix the set and retry."
  done

  raw="$(_capture herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$PWD" \
          --label "wait · ${#panes[@]} executors" --no-focus)" \
    || die "could not create the wait monitor tab: $(printf '%s' "$raw" | head -3)"
  tab="$(printf '%s' "$raw" | jq -r '.result.tab.tab_id // .result.tab_id // empty' 2>/dev/null || true)"
  monitor="$(printf '%s' "$raw" | jq -r '.result.root_pane.pane_id // .result.pane.pane_id // empty' 2>/dev/null || true)"
  [ -n "$tab" ] && [ -n "$monitor" ] \
    || die "Herdr created no usable monitor tab/pane: $(printf '%s' "$raw" | head -3)"

  # Do not `exec` the shell: the finished monitor output is evidence the caller
  # may need to read. Replacing the shell would make Herdr close the tab as soon
  # as the monitor returned, taking that evidence with it.
  printf -v command '%q wait-monitor --timeout-ms %q' "$HW_BIN_DIR/hw" "$wait_ms"
  for pane in "${panes[@]}"; do printf -v q ' %q' "$pane"; command="$command$q"; done
  if ! herdr pane run "$monitor" "$command" >/dev/null 2>&1; then
    herdr tab close "$tab" >/dev/null 2>&1 || true
    die "created monitor tab $tab but could not start its command, so hw closed the tab and started no wait"
  fi
  ok "monitoring ${#panes[@]} executor(s) in tab $tab (pane $monitor); this brainer is NOT waiting and remains reachable"
  info "targets: ${panes[*]}"
  info "the monitor prints each witness explanation once, then short heartbeats; each verdict also sends a system notification"
  return 0
}

# `hw unstick <pane>` is deliberately NOT part of `hw next`: this stops and
# replaces an OpenCode process, so it is an operator decision, never a retry
# side effect.  It exists for the narrow post-question state measured on
# OpenCode 1.18.23: the child and root sessions are idle, but Herdr remains
# blocked.  Restarting the process in the SAME pane returned the owned probe to
# idle.  That preserves the pane, cwd, work directory and tab, but starts a new
# OpenCode conversation only when the pane never published a session id. When
# an id exists, the restart selects that exact persisted session.
cmd_unstick() (
  # This runs in a subshell so the EXIT trap releases only this command's lock;
  # it never replaces traps installed by hw's caller.
  local pane="${1:-}" info state agent reason scope screen evidence args_json restart_name agents lock_hash lock_dir owner_file owner_pid owner_uid current_uid stale_file
  local -a args=() restart_args=()
  [ $# -eq 1 ] || die "usage: hw unstick <executor-pane> — deliberate recovery only for an OpenCode pane carrying blocked_reason=stuck and blocked_scope=root|child"
  [ -n "$pane" ] || die "usage: hw unstick <executor-pane>"

  info="$(herdr agent get "$pane" 2>/dev/null || true)"
  [ -n "$info" ] || die "herdr does not know pane $pane (or herdr is unreachable on \$HERDR_SOCKET_PATH)"
  state="$(printf '%s' "$info" | jq -r '.result.agent.agent_status // empty' 2>/dev/null || true)"
  agent="$(printf '%s' "$info" | jq -r '.result.agent.agent // empty' 2>/dev/null || true)"
  reason="$(printf '%s' "$info" | jq -r '.result.agent.tokens.blocked_reason // empty' 2>/dev/null || true)"
  scope="$(printf '%s' "$info" | jq -r '.result.agent.tokens.blocked_scope // empty' 2>/dev/null || true)"
  [ "$agent" = opencode ] || die "$pane is $agent, not OpenCode; hw unstick will not send control keys to another agent"
  [ "$state" = blocked ] || die "$pane is $state, not blocked; hw unstick refuses because agent_status alone is not the stuck condition"
  [ "$reason" = stuck ] || die "$pane is blocked_reason=${reason:-absent}, not stuck; hw unstick will not dismiss a real question, permission, or session error"
  case "$scope" in root|child) ;; *) die "$pane is blocked_reason=stuck but blocked_scope=${scope:-absent}; required scope metadata is missing or invalid, so hw unstick refuses" ;; esac

  # THE TOKEN SIGNATURE IS NOT THE STUCK CONDITION — A HEALTHY PANE CAN PUBLISH IT.
  #
  # Everything above this line reads the producer, and on this machine the
  # producer lies. Measured 2026-08-27: `w4C:pAH` was publishing exactly
  # `agent_status=blocked`, `blocked_reason=stuck`, `blocked_scope=child` — the
  # precise signature every check above accepts — while it was visibly running
  # a task, 22 minutes into real work it went on to finish. Its own endpoint
  # answered `/permission -> []` and `/question -> []` the whole time, so the
  # endpoint would not have saved it either. Only its screen, sampled over time,
  # said it was alive. `w4C:p9W` did the same thing three minutes after dispatch.
  #
  # So the recovery's trigger had become a signature a working pane emits, and
  # what it does with that trigger is kill an OpenCode process and replace a
  # live conversation. The signature is now a NECESSARY condition and no longer
  # a sufficient one: an independent witness must positively CONFIRM that
  # nothing is moving and nothing is outstanding.
  #
  # `settled` and nothing else. `live` and `awaiting-human` are refusals for
  # obvious reasons; `unknown` is a refusal too, and that is the deliberate
  # part — an unreachable authority is not evidence that a restart is safe, and
  # this command's mistake is unrecoverable. Fail closed, and say which reader
  # went quiet so the operator can fix that instead of guessing.
  #
  # Checked HERE, before the `ctrl+x down` below: a refusal that has already
  # sent keys to somebody's live session is not a refusal.
  _load_state_witness
  witness_state "$pane"
  case "$WITNESS_VERDICT" in
    settled) info "cross-check CONFIRMS stuck: $WITNESS_DETAIL" ;;
    live)
      die "$pane publishes blocked_reason=stuck, but it is WORKING: $WITNESS_DETAIL — hw unstick refuses. The token signature alone is not the stuck condition, because a healthy pane can publish it (measured 2026-08-27, w4C:pAH and w4C:p9W). Nothing was sent, nothing was restarted, and that session is intact. Let it finish."
      ;;
    awaiting-human)
      die "$pane publishes blocked_reason=stuck, but it is WAITING FOR A PERSON: $WITNESS_DETAIL — hw unstick refuses, because restarting the process would discard that prompt and the turn behind it. Answer it instead. Nothing was sent and nothing was restarted."
      ;;
    *)
      die "$pane publishes blocked_reason=stuck, but that could NOT be corroborated: $WITNESS_DETAIL — hw unstick refuses. It restarts a process and replaces a live conversation, so it needs positive evidence that nothing is running, not merely the absence of evidence that something is. Fix the reader named above, or close the pane with \`hw done\` and dispatch again. Nothing was sent and nothing was restarted."
      ;;
  esac

  # Kept inside cmd_unstick because its focused test extracts this function
  # alone. A question has the measured modal footer. A permission prompt needs
  # both sides of the choice; generic terminal text such as `enter submit` or a
  # lone `Deny` is not prompt evidence.
  prompt_evidence() {
    local visible="$1"
    case "$visible" in
      *"esc dismiss"*) printf '%s' 'question footer: esc dismiss'; return 0 ;;
    esac
    case "$visible" in
      *"Allow once"*"Deny"*|*"Deny"*"Allow once"*) printf '%s' 'permission choices: Allow once + Deny'; return 0 ;;
      *"Always allow"*"Deny"*|*"Deny"*"Always allow"*) printf '%s' 'permission choices: Always allow + Deny'; return 0 ;;
    esac
    return 1
  }

  # mkdir is atomic on macOS.  The lock is pane-specific and covers every
  # control action through state verification and metadata clearing.  A stale
  # lock is removed only when its owner is this uid and its pid is proven dead;
  # a reused pid or another user's lock stays a loud refusal, never a takeover.
  current_uid="$(id -u)"
  lock_hash="$(printf '%s' "$pane" | shasum -a 256 | cut -c1-24)"
  # TMPDIR is caller-controlled and may differ between terminals. /tmp is the
  # macOS per-host shared runtime namespace; UID keeps unrelated users apart.
  lock_dir="/tmp/hw-unstick-${current_uid}-${lock_hash}.lock"
  owner_file="$lock_dir/owner"
  if ! mkdir "$lock_dir" 2>/dev/null; then
    owner_pid="" owner_uid=""
    [ -r "$owner_file" ] && IFS=' ' read -r owner_pid owner_uid < "$owner_file" || true
    if [[ "$owner_pid" =~ ^[0-9]+$ && "$owner_uid" = "$current_uid" ]] && ! kill -0 "$owner_pid" 2>/dev/null; then
      # Claim the stale record first: another contender can only refuse while
      # it is absent, and cannot mistake this directory for an acquired lock.
      stale_file="$lock_dir/owner.stale.$$"
      if mv "$owner_file" "$stale_file" 2>/dev/null; then
        rm -f "$stale_file"
        rmdir "$lock_dir" 2>/dev/null || true
      fi
    fi
    mkdir "$lock_dir" 2>/dev/null || die "$pane already has an hw unstick recovery in progress (or an unproven stale lock at $lock_dir); refusing before any control key"
  fi
  printf '%s %s\n' "$$" "$current_uid" > "$owner_file" || { rmdir "$lock_dir" 2>/dev/null || true; die "could not record hw unstick lock ownership for $pane; refusing before any control key"; }
  # Expand fixed, hash-derived paths now: function locals are gone by EXIT time.
  trap "rm -f '$owner_file'; rmdir '$lock_dir' 2>/dev/null || true" EXIT

  # A stale `stuck` token must not turn a genuine child question into a process
  # restart.  Navigation is harmless and only happens after the strict token
  # check; Escape is intentionally never sent here.  For root scope, the modal
  # is already visible and the same read is enough.
  if [ "$scope" = child ]; then
    herdr agent send-keys "$pane" ctrl+x down >/dev/null 2>&1 \
      || die "$pane was verified stuck/child but Herdr could not open its subagent view; nothing was restarted"
    sleep "${HW_UNSTICK_VIEW_SETTLE_S:-2}"
  fi
  screen="$(herdr agent read "$pane" --source visible --lines 100 2>/dev/null)" \
    || die "$pane visible screen could not be read after the stuck metadata check; hw unstick fails closed before any restart"
  evidence="$(prompt_evidence "$screen" || true)"
  [ -z "$evidence" ] \
    || die "$pane shows live prompt evidence after the stuck metadata check ($evidence). hw unstick did NOT dismiss, restart, or answer it; handle that human prompt instead."

  # Only a direct OpenCode executable is supported. A wrapper can carry its
  # own state or positional contract; restarting it as OpenCode would guess.
  args_json="$(herdr pane process-info --pane "$pane" 2>/dev/null | jq -c '
    first(.result.process_info.foreground_processes[]?
      | select((.argv | type == "array") and (.argv | length > 0)
          and (.argv[0] | type == "string")
          and (.argv[0] == "opencode" or (.argv[0] | endswith("/opencode"))))
      | .argv[1:]) // empty
  ' 2>/dev/null || true)"
  [ -n "$args_json" ] || die "$pane is stuck, but its foreground process is not a direct opencode executable; hw refuses wrappers and will not guess how to restart it"
  while IFS= read -r -d '' arg; do args+=("$arg"); done < <(printf '%s' "$args_json" | jq -jr '.[] | . + "\u0000"' 2>/dev/null)
  [ "${#args[@]}" -gt 0 ] || :  # a direct `opencode` with no options is valid

  # Herdr enforces globally unique agent names. The opaque full pane id is
  # hashed, not suffix-truncated: `wA:p1` and `wB:p1` derive different names.
  # A 96-bit digest is still not mathematical proof, so check the live global
  # registry before stopping; a collision is a loud refusal, never a takeover.
  restart_name="unstick-$(printf '%s' "$pane" | shasum -a 256 | cut -c1-24)"
  agents="$(herdr agent list 2>/dev/null || true)"
  [ -n "$agents" ] || die "$pane is stuck, but Herdr's global agent registry could not be read; restart name was not reserved"
  printf '%s' "$agents" | jq -e '.result.agents | type == "array"' >/dev/null 2>&1 \
    || die "$pane is stuck, but Herdr's global agent registry was malformed; restart name was not reserved"
  if printf '%s' "$agents" | jq -e --arg n "$restart_name" --arg p "$pane" '
       any(.result.agents[]?; .name == $n and .pane_id != $p)
     ' >/dev/null 2>&1; then
    die "$pane is stuck, but restart name $restart_name is already owned by another pane; nothing was stopped"
  fi

  # Capture is not authority. Immediately before Ctrl-C, re-read every required
  # token AND the visible UI; no stale pre-capture state licenses termination.
  # A UI can still change between this read and key delivery, so this narrows
  # rather than mathematically eliminates the asynchronous race.
  info="$(herdr agent get "$pane" 2>/dev/null || true)"
  state="$(printf '%s' "$info" | jq -r '.result.agent.agent_status // empty' 2>/dev/null || true)"
  agent="$(printf '%s' "$info" | jq -r '.result.agent.agent // empty' 2>/dev/null || true)"
  reason="$(printf '%s' "$info" | jq -r '.result.agent.tokens.blocked_reason // empty' 2>/dev/null || true)"
  scope="$(printf '%s' "$info" | jq -r '.result.agent.tokens.blocked_scope // empty' 2>/dev/null || true)"
  [ "$agent:$state:$reason" = "opencode:blocked:stuck" ] || die "$pane changed after argv capture (agent=$agent status=$state blocked_reason=${reason:-absent}); nothing was restarted"
  case "$scope" in root|child) ;; *) die "$pane lost valid blocked_scope metadata after argv capture; nothing was restarted" ;; esac
  screen="$(herdr agent read "$pane" --source visible --lines 100 2>/dev/null)" \
    || die "$pane visible screen could not be read after argv capture; hw unstick fails closed before any restart"
  evidence="$(prompt_evidence "$screen" || true)"
  [ -z "$evidence" ] \
    || die "$pane shows live prompt evidence after argv capture ($evidence). hw unstick did NOT dismiss, restart, or answer it; handle that human prompt instead."

  # AND AGAIN, IMMEDIATELY BEFORE THE STOP. Capture is not authority — the same
  # rule the token re-read above already follows, applied to the witness. The
  # first check happened before the subagent navigation and the argv capture,
  # which is seconds ago and several keystrokes back; a pane that woke up in
  # between must not be killed on the strength of a stale reading.
  witness_state "$pane"
  case "$WITNESS_VERDICT" in
    settled) : ;;
    live)
      die "$pane started WORKING between the first cross-check and the restart: $WITNESS_DETAIL — nothing was stopped. That session is intact."
      ;;
    awaiting-human)
      die "$pane raised a prompt between the first cross-check and the restart: $WITNESS_DETAIL — nothing was stopped. Answer it instead."
      ;;
    *)
      die "$pane could no longer be corroborated as stuck immediately before the restart: $WITNESS_DETAIL — nothing was stopped. hw unstick fails closed here on purpose."
      ;;
  esac

  # IDENTIFY WHAT IS ABOUT TO BE DISCONNECTED, BEFORE DISCONNECTING IT.
  #
  # This message already said the active conversation "is replaced" and then
  # replaced it without naming it — so the one handle that reaches the
  # transcript afterwards died with the process that was holding it. It does not
  # need to: `opencode export <id>` returned the full transcript of
  # ses_fc0bac363ffeHqKj657cIJEair hours after that pane had been restarted
  # (measured 2026-08-26), including the `directory` it ran in. Replaced is not
  # deleted. Unaddressable was the whole of the loss.
  #
  # A stuck OpenCode pane can omit agent_session from `agent get` (measured on
  # the real path below). In that case the launch receipt is the fallback, but
  # only from the pane's exact hw_run and only when its pane and vendor fields
  # independently match. The operator's cwd is never part of that decision.
  local out_sid out_cwd out_run out_rundir arg selector_boundary=0 receipt_exact=0 i new_sid d hops
  local receipt_sid receipt_vendor receipt_pane sid_source
  out_sid="$(printf '%s' "$info" | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true)"
  out_cwd="$(printf '%s' "$info" | jq -r '.result.agent.cwd // empty' 2>/dev/null || true)"
  out_run="$(printf '%s' "$info" | jq -r '.result.agent.tokens.hw_run // empty' 2>/dev/null || true)"
  out_rundir=""
  if [ -n "$out_cwd" ] && [ -n "$out_run" ]; then
    d="$out_cwd" hops=0
    while [ "$hops" -lt 12 ] && [ -n "$d" ] && [ "$d" != / ]; do
      if [ -d "$d/.hw/$out_run" ]; then out_rundir="$d/.hw/$out_run"; receipt_exact=1; break; fi
      d="$(dirname "$d")"
      hops=$((hops + 1))
    done
  fi
  [ -n "$out_rundir" ] || { [ -n "$out_cwd" ] && out_rundir="$(_next_run_dir "$out_cwd" || true)"; }

  sid_source="herdr agent get $pane | jq -r .result.agent.agent_session.value, read immediately before ctrl+c"
  if [ -z "$out_sid" ] && [ "$receipt_exact" = 1 ] && [ -r "$out_rundir/receipt.jsonl" ]; then
    receipt_sid="$(jq -sr '[.[] | select(.key == "session_id")][-1].value // empty' "$out_rundir/receipt.jsonl" 2>/dev/null || true)"
    receipt_vendor="$(jq -sr '[.[] | select(.key == "session_vendor")][-1].value // empty' "$out_rundir/receipt.jsonl" 2>/dev/null || true)"
    receipt_pane="$(jq -sr '[.[] | select(.key == "pane")][-1].value // empty' "$out_rundir/receipt.jsonl" 2>/dev/null || true)"
    if [[ "$receipt_sid" == ses_* ]] && [ "$receipt_vendor" = opencode ] && [ "$receipt_pane" = "$pane" ]; then
      out_sid="$receipt_sid"
      sid_source="$out_rundir/receipt.jsonl session_id, accepted only after session_vendor=opencode and pane=$pane matched"
    fi
  fi
  if [ -n "$out_sid" ]; then
    [ -n "$out_rundir" ] && _receipt_into "$out_rundir" unstick_reattached_session "$out_sid" \
      "$sid_source"
    info "REATTACHING conversation $out_sid after the restart. Its persisted transcript stays readable with: cd ${out_cwd:-<the pane cwd>} && opencode export $out_sid"
    [ -n "$out_rundir" ] && info "recorded as unstick_reattached_session in $out_rundir/receipt.jsonl"
    [ -n "$out_rundir" ] || warn "no .hw run directory found above ${out_cwd:-the pane cwd}, so that id is in THIS output only — copy it now"

    # The captured id is authority. Normalize every active continuation
    # selector to one deterministic `--session <id>` while preserving all
    # unrelated argv bytes and their order. Arguments after `--` are positional
    # and must not be interpreted as selectors.
    for ((i = 0; i < ${#args[@]}; i++)); do
      arg="${args[$i]}"
      if [ "$selector_boundary" = 1 ]; then
        restart_args+=("$arg")
        continue
      fi
      case "$arg" in
        --)
          restart_args+=(--session "$out_sid" --)
          selector_boundary=1
          ;;
        --session|-s)
          i=$((i + 1))
          ;;
        --session=*|-s=*|--continue|-c)
          ;;
        *) restart_args+=("$arg") ;;
      esac
    done
    [ "$selector_boundary" = 1 ] || restart_args+=(--session "$out_sid")
  else
    # An opencode pane can be blocked with agent_session null (measured:
    # w3Z:p1T). Say so before the restart, not after, because after the restart
    # there is nothing left to read it from.
    warn "this pane published NO agent_session, so the conversation about to be replaced has no recoverable id — after the restart, only its title identifies it"
    [ -n "$out_rundir" ] && _receipt_into "$out_rundir" unstick_replaced_session \
      "none — the pane published no agent_session before the restart, so the replaced conversation is not addressable" \
      "herdr agent get $pane | jq -r .result.agent.agent_session.value returned empty before ctrl+c"
    restart_args=("${args[@]}")
  fi

  if [ -n "$out_sid" ]; then
    info "RECOVERY: $pane is stuck/$scope with no visible human prompt. Stopping only its OpenCode process; the pane, tab, cwd, work directory and exact session stay."
  else
    info "RECOVERY: $pane is stuck/$scope with no visible human prompt. Stopping only its OpenCode process; the pane, tab, cwd and work directory stay. Its unaddressable active conversation will be replaced."
  fi
  herdr agent send-keys "$pane" ctrl+c >/dev/null 2>&1 \
    || die "$pane was verified stuck but Herdr could not send Ctrl-C; no restart was attempted"
  local i process process_state has_opencode=1
  for i in $(seq 1 15); do
    process="$(herdr pane process-info --pane "$pane" 2>/dev/null)" \
      || die "$pane process exit is UNESTABLISHED: process-info failed after Ctrl-C; no second process was started"
    process_state="$(printf '%s' "$process" | jq -er '
      .result.process_info.foreground_processes as $ps |
      if .error != null or ($ps | type) != "array" then error("unreadable process list")
      elif all($ps[]; type == "object" and (.argv | type) == "array" and
          (.argv | length) > 0 and all(.argv[]; type == "string")) | not then error("unreadable argv")
      elif any($ps[]; any(.argv[]; (split("/") | last) == "opencode")) then "present"
      else "absent" end' 2>/dev/null)" \
      || die "$pane process exit is UNESTABLISHED: process-info returned an invalid observation after Ctrl-C; no second process was started"
    if [ "$process_state" = absent ]; then
      has_opencode=0; break
    fi
    sleep 1
  done
  [ "$has_opencode" = 0 ] || die "$pane did not leave its OpenCode process within 15s; no second process was started"

  herdr agent start "$restart_name" --kind opencode --pane "$pane" -- "${restart_args[@]}" >/dev/null 2>&1 \
    || die "$pane's stuck OpenCode process stopped, but its in-place restart failed. The pane/cwd/work directory remain; inspect the shell before starting anything else."
  info="$(herdr agent get "$pane" 2>/dev/null || true)"
  state="$(printf '%s' "$info" | jq -r '.result.agent.agent_status // empty' 2>/dev/null || true)"
  case "$state" in
    idle|working) ;;
    *) die "$pane's OpenCode process restarted but Herdr reports $state, not idle/working; recovery is NOT claimed" ;;
  esac
  if [ -n "$out_sid" ]; then
    new_sid="$(printf '%s' "$info" | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null || true)"
    [ "$new_sid" = "$out_sid" ] \
      || die "$pane restarted, but Herdr reports session ${new_sid:-absent}, not captured session $out_sid; stale stuck metadata was NOT cleared and session reattachment is NOT claimed"
  fi
  herdr pane report-metadata "$pane" --source hw:unstick --clear-token blocked_reason --clear-token blocked_scope >/dev/null 2>&1 \
    || die "$pane restarted to $state, but stale stuck metadata could not be cleared; recovery is NOT claimed"
  ok "RECOVERED: $pane restarted in place and Herdr now reports $state. Cleared only stale blocked_reason/blocked_scope metadata; no question or permission was dismissed."
  # Repeated after the restart on purpose: the line above scrolls past during a
  # 15s process wait.
  if [ -n "$out_sid" ]; then
    info "reattached conversation $out_sid — its existing history is active in this pane and remains exportable with: cd ${out_cwd:-<the pane cwd>} && opencode export $out_sid"
  fi
)

# Surfaced by `hw status` for the same reason worktree drift is: a decisions.md
# nobody can be told to read stops being read, and the instruction to read it
# stops being followed silently. `bin/decisions` exits 1 when a file is over the
# seek budget; only then does status say anything.
# The project workspaces and what is living in them. Only when tab mode is
# actually in use — a status that prints an empty section every time trains
# people to skip the whole block.
# The project space labels, as JSON, so `hw status` can pick them out of the
# workspace list. Derived from the shared table — never a second copy of it.
_known_space_labels_json() {
  local p out=""
  for p in $HW_LANES; do
    out="$out\"$(project_space_label "$p")\","
  done
  printf '[%s]' "${out%,}"
}

_tabs_quiet() {
  local rows
  rows="$(herdr tab list 2>/dev/null \
    | jq -r '.result.tabs[]
             | "\(.workspace_id)\t\(.tab_id)\t\(.label // "-")\t\(.agent_status // "-")\t\(.pane_count)"' 2>/dev/null || true)"
  local wss
  wss="$(herdr workspace list 2>/dev/null \
    | jq -r --argjson known "$(_known_space_labels_json)" \
        '.result.workspaces[] | select(.label != null and ([.label] | inside($known))) | "\(.workspace_id)\t\(.label)"' 2>/dev/null || true)"
  [ -n "$wss" ] || return 0
  printf '\n  %sproject workspaces%s\n' "$C_B" "$C_0"
  local wid wlabel
  while IFS="$(printf '\t')" read -r wid wlabel; do
    [ -n "$wid" ] || continue
    printf '  %s  %s\n' "$wlabel" "$wid"
    printf '%s\n' "$rows" | while IFS="$(printf '\t')" read -r rw rt rl rs rp; do
      [ "$rw" = "$wid" ] || continue
      printf '      %s%-28s %-8s %s pane(s)  %s%s\n' "$C_DIM" "$rl" "$rs" "$rp" "$rt" "$C_0"
    done
  done <<EOF
$wss
EOF
}

# Cleanup as a ROUTINE, not a thing you remember — but NOT by re-running the
# survey. `cmd_reap` is ~4s of git across 25 worktrees, and wiring it into
# `hw status` made a glance cost five seconds. A status that is slow is a status
# people stop running, which would cost more than it saves.
#
# So status reports the LAST survey's count and says how old it is. Honest about
# being stale, cheap, and it still nags. The number is seeded by any `hw reap`.
_reap_quiet() {
  local f n at age
  f="$BRAIN/.hw-reap-count"
  [ -r "$f" ] || return 0
  n="$(awk '{print $1}' "$f" 2>/dev/null || true)"
  at="$(awk '{print $2}' "$f" 2>/dev/null || true)"
  [ -n "$n" ] && [ "$n" -gt 0 ] 2>/dev/null || return 0
  age="unknown age"
  if [ -n "$at" ]; then
    local mins=$(( ( $(date +%s) - at ) / 60 ))
    if [ "$mins" -lt 60 ]; then age="${mins}m ago"; else age="$(( mins / 60 ))h ago"; fi
  fi
  printf '\n'
  warn "$n worktree(s) were disposable as of the last survey ($age) — hw reap --apply"
  info "re-survey with \`hw reap\`; nothing kept is ever removed"
}

# A paragraph copied into three or more project CLAUDE.md files gets corrected
# in some of them and left wrong in the rest. That is how `hw done is the
# operator's call` survived in two product lanes with different wording while
# being false in both. Three or more files means it belongs in CLAUDE.shared.md;
# two is left alone, since two lanes legitimately share a brainer voice.
#
# Restored 2026-08-24: commit 2603bad ("status stops re-running the reap
# survey") rewrote _reap_quiet's body ON TOP of this function's, deleting it
# while leaving BOTH call sites. Every `hw status` since then ended with
# `_rules_quiet: command not found`. The root argument was also `""`, so the
# scan only worked when cwd happened to be $BRAIN; it is passed explicitly now.
_rules_quiet() {
  local n
  # shellcheck disable=SC2086
  n="$(python3 - "$BRAIN" $HW_LANES <<'PYEOF' 2>/dev/null || true
import re, sys, os
root = sys.argv[1]
seen = {}
for p in sys.argv[2:]:
    f = os.path.join(root, p, "CLAUDE.md")
    if not os.path.exists(f):
        continue
    for b in re.split(r"\n\s*\n", open(f).read()):
        b = b.strip()
        if len(b) > 80:
            seen.setdefault(b, []).append(p)
print(sum(1 for v in seen.values() if len(v) >= 3))
PYEOF
)"
  : "${n:=0}"
  [ "$n" -gt 0 ] 2>/dev/null || return 0
  printf '\n'
  warn "$n paragraph(s) are copied into 3+ project CLAUDE.md files — they belong in CLAUDE.shared.md"
  info "a rule in four files gets corrected in two of them; that is how a stale rule survives"
}

_decisions_quiet() {
  # THE EXIT CODE SAYS WHICH PROBLEM IT IS, so this says which problem it is.
  # It used to print "past the seek budget" for ANY nonzero exit. Once
  # `decisions check` also started reporting headings it cannot read, a file
  # comfortably inside the budget with one undated heading was announced as over
  # it — every single `hw status`, with the wrong remedy attached. Found by
  # Judgment Day 2026-09-08.
  local out rc=0
  out="$("$HW_BIN_DIR/decisions" check 2>/dev/null)" || rc=$?
  [ "$rc" = 0 ] && return 0
  [ -n "$out" ] || return 0
  printf '\n'
  case "$rc" in
    1) warn "a decisions.md is past the seek budget — an agent told to read it will not:" ;;
    3) warn "a decisions.md directory holds staged temp files from a killed rotation — nothing reads them, and nothing else reports them:" ;;
    2) warn "a decisions.md has headings the tool cannot read — \`index\` cannot list them, so an agent seeking them will not find them:" ;;
    *) warn "\`decisions check\` exited $rc, which this function does not have words for — read its output rather than trusting a label:" ;;
  esac
  printf '%s\n' "$out" | sed 's/^/    /'
}

#   1. `.hw/<run>/workspace` names the space — so hw created it, not someone else
#   2. `.hw/<run>/done`      exists         — so the executor reported
#
# A run with no `done` is left alone even though hw owns it: an executor that has
# not reported is either working or has stopped without saying so, and neither is
# something a cleanup command gets to decide. `--dry-run` is the default.
cmd_sweep() {
  local apply=0 failed=0
  [ "${1:-}" = --apply ] && apply=1
  local found=0 closed=0
  # $WORK, then each lane's worktree root outside it, in survey order — except
  # a lane whose `sweep` is false in projects.json (see below).
  local _sweep_roots=("$WORK") _sl _sr
  while IFS= read -r _sl; do
    [ -n "$_sl" ] || continue
    [ "$(lane_get "$_sl" sweep)" != 0 ] || continue
    _sr="$(lane_path "$_sl" worktree_root)"
    case "$_sr" in ''|"$WORK"|"$WORK"/*) continue ;; esac
    _sweep_roots+=("$_sr")
  done <<EOF
$HW_LANES_SURVEY
EOF

  while IFS= read -r rundir; do
    [ -n "$rundir" ] || continue
    # KIND IS DECIDED BY WHICH RECORD EXISTS, and it decides which close runs.
    # A `tab` record never reaches `workspace close`: in tab mode the workspace
    # holds other agents' tabs, and closing it would be the 2026-08-21 incident
    # with a different verb.
    local id="" kind=""
    if [ -r "$rundir/tab" ]; then
      kind=tab;       id="$(tr -d '[:space:]' < "$rundir/tab" 2>/dev/null || true)"
    elif [ -r "$rundir/workspace" ]; then
      kind=workspace; id="$(tr -d '[:space:]' < "$rundir/workspace" 2>/dev/null || true)"
    fi
    [ -n "$kind" ] && [ -n "$id" ] || continue
    found=$((found + 1))
    if [ ! -f "$(_run_done_marker "$rundir")" ]; then
      info "keeping $kind $id — $(basename "$(dirname "$(dirname "$rundir")")") never reported"
      continue
    fi
    # Reported, then revived: the marker says a live pane is expected and the
    # task is open again. Sweeping it would close the executor hw revive just
    # started, on the strength of a report that predates it.
    if [ -f "$(_run_reopened_marker "$rundir")" ]; then
      info "keeping $kind $id — $(basename "$(dirname "$(dirname "$rundir")")") was reopened by hw revive and has not reported since"
      continue
    fi
    if _chaining_lease_live "$rundir"; then
      info "keeping $kind $id — chaining lease until $(_chaining_lease_field "$rundir" until_h), holder $(_chaining_lease_field "$rundir" holder): $(_chaining_lease_field "$rundir" reason)"
      continue
    fi
    if [ "$apply" = 1 ]; then
      if _close_herdr_object "$kind" "$id" \
          "closed $kind $id (reported done)" \
          "$kind $id is already gone"; then
        closed=$((closed + 1))
      else
        failed=$((failed + 1))
      fi
    else
      info "would close $kind $id (reported done)"
    fi
  # A regex on the run-directory NAME, not a path glob. `-p -g '*/.hw/*'` reads
  # like it should work and matches nothing, so the sweep reported success
  # having looked at zero runs — the same silent-success shape this codebase
  # keeps writing, this time in the cleanup command. Run ids are
  # YYYYMMDD-HHMMSS-PID, so the name alone identifies them.
  # The old route-opt root is still listed: `coords-reconcile` has not migrated
  # yet (its pane is live), and a run there must stay sweepable. Drop it once
  # `hw worktrees` reports everything in place.
  # A LANE'S WORKTREES CAN LIVE OUTSIDE $WORK, so without naming its root here
  # an orphaned tab of that lane could never be found by `hw sweep` — the lane
  # would be fully wired everywhere else and invisible to the one command that
  # closes what a previous session left. One lane's root is left out on purpose
  # (`sweep: false` in projects.json): that gap is older than the table and is
  # NOT widened by it, because surfacing every stale run of that lane is its own
  # piece of work with its own blast radius.
done < <(fd -H -t d '^2[0-9]{7}-[0-9]{6}-[0-9]+$' "${_sweep_roots[@]}" 2>/dev/null || true)

  if [ "$found" = 0 ]; then
    info "no run recorded a workspace id — nothing hw can prove it owns"
  elif [ "$apply" = 0 ]; then
    info "dry run. Add --apply to actually close them."
  else
    ok "closed $closed of $found"
  fi
  [ "$failed" = 0 ] || return 1
  return 0
}

# ── status ──────────────────────────────────────────────────────────────────
# What is actually running — asked of herdr, not inferred from directories.
#
# THE OLD VERSION GUESSED. "A space with this label exists" was read as running
# and "no space" as never-finished, so the one case that matters — an executor
# whose pane died mid-task — looked exactly like one that had never been closed.
#
# herdr can answer it. `events.subscribe` on `pane.exited` REPLAYS the session's
# event backlog on connect, so a one-shot connection sees every pane
# that has died in this server session. No daemon, no polling, no state file:
# this deliberately replaces the `.hw/pane` file an earlier proposal wanted,
# because herdr's copy of "is that pane alive" cannot go stale and ours could.
#
# TWO LIMITS THAT SHAPE THE OUTPUT. Both are herdr's, both are load-bearing, and
# neither is papered over:
#
#   1. `pane_exited` carries only `pane_id` and `workspace_id`. There is NO exit
#      code, and `pane get` on a dead pane returns null, so there is no
#      post-mortem either. "It died" is knowable; "it failed" is not. Nothing
#      below prints "failed", and the DIED row says why it cannot.
#   2. The backlog is PER SESSION. A task started before the current herdr
#      server came up left no event in it, so silence is not evidence of health.
#      hw therefore reads the server's own start time and, when a task predates
#      it, reports `no information` with that reason rather than a clean row.
#
# Correlation and printing are one python block on purpose. The shape is
# joins-and-fallbacks over four data sources plus a directory walk, which in
# shell is a field of `$(find …)` assignments — and this very function is one of
# the five places where that construct shipped as a silent `set -e` exit. There
# is no such construct here; the guards below are all that talk to herdr.
_herdr_server_started() {
  # macOS has no procfs (Linux has one, but this path serves both) and herdr's own API reports no session start time, so
  # the honest source is the process holding the socket. Best effort: a missing
  # answer downgrades a row to "no information", it never invents one.
  local pid
  [ -n "${HERDR_SOCKET_PATH:-}" ] || return 0
  if command -v lsof >/dev/null 2>&1; then
    pid="$(lsof -t "$HERDR_SOCKET_PATH" 2>/dev/null | head -1 || true)"
  else  # Linux without lsof: fuser (psmisc) names the owner of a socket path
    pid="$(fuser "$HERDR_SOCKET_PATH" 2>/dev/null | awk '{print $1}' || true)"
  fi
  [ -n "$pid" ] || return 0
  ps -o lstart= -p "$pid" 2>/dev/null | head -1 || true
  return 0
}

_status_inputs_source() {
  cat <<'HW_STATUS_PY'
import glob, json, os, re, time

# The shell decided whether colour is wanted (C_0 is empty when it is not): the
# same NO_COLOR / not-a-terminal rule as every other line hw prints.
if os.environ.get("HW_ST_COLOUR") == "1":
    OK, WARN, ERR, DIM, B, Z = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[1m", "\033[0m"
else:
    OK = WARN = ERR = DIM = B = Z = ""

def blob(name):
    try:
        return json.loads(os.environ.get(name) or "{}")
    except Exception:
        return {}

herdr_ok   = os.environ.get("HW_ST_OK") == "1"
workspaces = (blob("HW_ST_WS").get("result") or {}).get("workspaces") or []
panes      = (blob("HW_ST_PANES").get("result") or {}).get("panes") or []
agents     = (blob("HW_ST_AGENTS").get("result") or {}).get("agents") or []

# pane_exited events, from the replayed backlog. A pane that exited and then had
# its id reused by a later pane would show up here as alive, which is why the
# live-pane set below is subtracted rather than trusted on its own.
exited = {}
for line in (os.environ.get("HW_ST_EXITED") or "").splitlines():
    line = line.strip()
    if not line:
        continue
    try:
        data = json.loads(line).get("data") or {}
    except Exception:
        continue
    if data.get("pane_id"):
        exited[data["pane_id"]] = data.get("workspace_id")

live_panes = {p.get("pane_id") for p in panes}
dead_by_ws = {}
for pane_id, ws in exited.items():
    if pane_id in live_panes or not ws:
        continue
    dead_by_ws.setdefault(ws, []).append(pane_id)

ws_by_label = {w.get("label"): w.get("workspace_id") for w in workspaces if w.get("label")}

# hw's own spaces are labelled `<project>:<task>` with a project hw knows. Other
# labels in the same list are the operator's own long-lived sessions, and
# reading them as tasks put phantom rows in the table.
PROJECTS = set((os.environ.get("HW_ST_PROJECTS") or "").split())

def hw_label(label):
    return label.count(":") == 1 and label.split(":", 1)[0] in PROJECTS

session_start = None
raw = (os.environ.get("HW_ST_SERVER_STARTED") or "").strip()
if raw:
    try:  # ps -o lstart= → "Thu Aug 20 11:34:37 2026", padded on single digits
        session_start = time.mktime(time.strptime(" ".join(raw.split()), "%a %b %d %H:%M:%S %Y"))
    except Exception:
        session_start = None

# ── the task index ────────────────────────────────────────────────────────
# Directories first (they outlive every space), then anything herdr knows about
# that has no directory — a --here executor lives in someone else's workspace
# and has never had one, and used not to appear in `hw status` at all.
tasks = {}

def row(project, task):
    return tasks.setdefault(f"{project}:{task}",
                            {"project": project, "task": task, "workdir": None})

work = os.environ["HW_ST_WORK"]
for d in sorted(glob.glob(os.path.join(work, "*", "*"))):
    if os.path.isdir(d):
        project, task = os.path.basename(os.path.dirname(d)), os.path.basename(d)
        row(project, task)["workdir"] = d
for spec in (os.environ.get("HW_ST_ROOTS") or "").splitlines():
    if ":" not in spec:
        continue
    root, project = spec.rsplit(":", 1)
    for d in sorted(glob.glob(os.path.join(root, "*"))):
        if os.path.isdir(d):
            row(project, os.path.basename(d))["workdir"] = d

# Agent panes, attached to a task by our own metadata tokens when they carry
# them and by the workspace label otherwise. Tokens are the better key — they
# survive a workspace being renamed and they work for --here — but they are
# written by the invokers and carry a TTL, so their ABSENCE means nothing.
agents_by_task = {}
for a in agents:
    tok = a.get("tokens") or {}
    key = None
    if tok.get("hw_project") in PROJECTS and tok.get("hw_task"):
        key = f"{tok['hw_project']}:{tok['hw_task']}"
        row(tok["hw_project"], tok["hw_task"])
    else:
        for label, ws in ws_by_label.items():
            if ws == a.get("workspace_id") and hw_label(label):
                key = label
                row(*label.split(":"))
                break
    if key:
        agents_by_task.setdefault(key, []).append(a)
HW_STATUS_PY
}

_status_liveness_source() {
  cat <<'HW_STATUS_PY'
# ── liveness, by the pane's cwd rather than by our own tokens ──────────────
#
# THIS IS THE LOAD-BEARING PART OF THIS COMMAND. Everything above keys a live
# pane to a task through something WE wrote: metadata tokens (written by the
# invokers, so absent until an executor chooses to call one, and carrying a TTL)
# or a workspace label (which a --here executor does not have, because it lives
# in someone else's workspace). An executor that never called an invoker was
# therefore invisible here, and the branch below then reported it as closed —
# while `herdr pane list` showed the pane alive. Two sources of truth about
# whether an executor is running, and the more accessible one was wrong.
#
# A pane whose cwd IS, or is under, a task's work directory IS that task,
# whether or not it ever called an invoker. That is evidence herdr keeps for us
# and cannot be stale: it is the same `pane list` a human reads. Tokens are now
# an enrichment on top of it, never the basis.
#
# Two details that decide whether the comparison works at all:
#   · the cwd herdr persists and reports is the pane's LIVE cwd, not its launch
#     cwd, so match by PREFIX — a `cd sub/deeper` must still match.
#   · os.path.realpath() resolves symlinks but does NOT normalise case, while
#     os.getcwd() does. Comparing one against the other never matches on a
#     case-insensitive filesystem, which is exactly how the product-lane worktree root
#     stayed dead for a day. canon() casefolds both sides, the same way
#     bin/invoker-common.sh's canon() does — keep them consistent.


def canon(path):
    return os.path.realpath(path).rstrip("/").casefold()


# Longest work directory first, so a task nested inside another's directory
# claims its own panes rather than its parent's.
work_index = sorted(
    ((canon(t["workdir"]), k) for k, t in tasks.items() if t["workdir"]),
    key=lambda pair: len(pair[0]), reverse=True)
task_by_name = {t["task"]: k for k, t in tasks.items()}
agent_by_pane = {a.get("pane_id"): a for a in agents if a.get("pane_id")}

panes_by_task = {}
for p in panes:
    if not p.get("pane_id"):
        continue
    key = None
    # foreground_cwd as well as cwd: herdr reports both, and they differ while a
    # child process is running somewhere else.
    for candidate in (p.get("cwd"), p.get("foreground_cwd")):
        if not candidate:
            continue
        c = canon(candidate)
        for root, k in work_index:
            if c == root or c.startswith(root + "/"):
                key = k
                break
        if key:
            break
    if key is None:
        # The second handle on the same pane, for the one case cwd cannot cover:
        # an executor that cd'd out of its work directory. `_run_here` renames
        # the pane to the task name and `agent start` names the agent the same,
        # and `pane list` DOES report that label (it is `title` that stays null,
        # which is why `hw done` still cannot find a --here pane by name).
        # Ambiguous if two projects ever use the same task name — last one wins
        # in task_by_name. cwd is tried first and is unambiguous, so this only
        # decides for a pane that has left its work directory.
        label = p.get("label")
        if label and label in task_by_name:
            key = task_by_name[label]
    if key:
        panes_by_task.setdefault(key, []).append(p)
HW_STATUS_PY
}

_status_runs_source() {
  cat <<'HW_STATUS_PY'
def run_is_here(rundir):
    """Was this run `--here`, or did it get a space of its own?

    hw MUST know the shape, because a --here executor has no workspace BY
    DESIGN — `_run_here` splits the current pane and creates none — and the
    branch below used to read that absence as "the space is gone", reporting a
    live executor as closed without reporting. That is the bug this answers.

    `_write_run_env` states the shape outright as HW_LAUNCH_MODE=here|tab|space.
    It used to be INFERRED from the presence of HW_INVOKER_PANE, which was
    --here only — and that inference died the moment space mode started
    carrying the brainer pane too, so that the return channel would work in
    the default mode at all. An inferred discriminator that silently reads
    every space run as --here is worse than no discriminator, because the
    branch below then claims the opposite of the truth.

    No new file: this still lives in the env file that already exists, and it
    is a launch-time fact about a run that already happened, so it cannot go
    stale the way a copy of live state does (setup/decisions.md).

    True / False, or None when there is no readable env file at all (a run
    whose directory could not be written) — None means "do not claim".
    """
    try:
        with open(os.path.join(rundir, "env")) as fh:
            body = fh.read()
    except OSError:
        return None
    for line in body.split("\n"):
        if line.startswith("HW_LAUNCH_MODE="):
            return "here" in line
    # Runs written before HW_LAUNCH_MODE existed: back then HW_INVOKER_PANE was
    # --here only, so on those files the old inference is still exactly right —
    # including its False, which correctly reads a legacy space run.
    return any(line.startswith("HW_INVOKER_PANE=") for line in body.split("\n"))


def run_owns(rundir, kind):
    """The tab or workspace this run CREATED, from the ownership record `hw done`
    already relies on to decide what it is allowed to close. Placement is read
    from this and never from "it has no dedicated workspace" — a task tab has no
    workspace of its own BY DESIGN, and inferring `--here` from that absence is
    how a three-pane tab in workspace `<lane>` came to be printed as a split
    pane. It also works for runs written before HW_LAUNCH_MODE grew a `tab`
    value, which is every Grid Compact run."""
    try:
        with open(os.path.join(rundir, kind)) as fh:
            return fh.read().strip() or None
    except OSError:
        return None


def _placement_gone(here_run, own_tab, own_ws):
    """What closed, named from what the run owned. `space closed` was printed for
    every non---here task, including the tabs, which is the same false
    attribution one level down."""
    if own_tab:
        return f"tab {own_tab} closed"
    if own_ws:
        return f"workspace {own_ws} closed"
    if here_run:
        return "pane gone (--here)"
    return "its placement record is gone, so what closed is not recorded"


def run_mode_of(rundir):
    """`here`, `tab`, `space`, or None when the env file cannot be read or
    predates the field. Separate from run_is_here() because that answers a
    yes/no and the interesting distinction is now three-way.

    Reads through _env_field, which is defined further down beside
    invoker_pane_of instead of here. That placement is not taste: the test
    harness extracts these functions with `awk` ranges anchored on `^def <name>(`
    lines, and setup/tests/16-status.sh deliberately stops `run_owns ..
    run_mode_of` short of this function while `task_seq .. runs_of` carries
    invoker_pane_of. A helper both callers need has to land inside that second
    window or 16-status.sh dies with a NameError, so the forward reference is
    the price of not rewriting anchors that already work."""
    return _env_field(rundir, "HW_LAUNCH_MODE")


def task_seq(rundir):
    """Which task this executor is on. See invoker-common.sh: a run is an
    EXECUTOR, and the brainer re-tasks a living one with `hw next`, so the run
    directory holds task 1 and t2/, t3/ … hold the ones after it."""
    try:
        with open(os.path.join(rundir, "task")) as fh:
            n = int("".join(c for c in fh.read() if c.isdigit()) or 1)
    except (OSError, ValueError):
        return 1
    return n if n > 0 else 1


def task_state_dir(rundir):
    n = task_seq(rundir)
    return rundir if n == 1 else os.path.join(rundir, "t%d" % n)


def task_reopened(rundir):
    """`hw revive` brought this run back after it reported: `reopened` sits
    beside `done`, and until the revived executor reports again (which clears
    it) the task is OPEN, whatever the older marker says."""
    d = task_state_dir(rundir)
    return os.path.isfile(os.path.join(d, "done")) and os.path.isfile(os.path.join(d, "reopened"))


def task_done(rundir):
    """Did the CURRENT task report? Task 3 being open is not task 2's marker.
    A reopened run is not done: its report predates the pane hw revive gave it."""
    d = task_state_dir(rundir)
    return os.path.isfile(os.path.join(d, "done")) and not os.path.isfile(os.path.join(d, "reopened"))


def turns_of(rundir):
    """How many of this run's TURNS the harness watched end. Written by
    bin/hw-stop-hook.sh (claude, codex) and the opencode `hw-turn-ended` plugin at
    the end of every turn, before the agent chooses anything — so unlike the
    metadata tokens it does not depend on the executor cooperating, and unlike
    them it is a FILE, so it outlives the pane. Measured 2026-08-26: closing a
    workspace makes `pane.get` return pane_not_found and drops the agent from
    `agent list`, taking every token with it. This number is what is left.

    0 means NOTHING, and the orphan section below is built on that: either the
    run predates its vendor's adapter (claude 2026-08-20, opencode 08-22, codex
    08-23), or the executor died before finishing a turn, or nobody wired one.
    Absence of the file is never evidence that no turn ended."""
    try:
        with open(os.path.join(rundir, "turns")) as fh:
            n = int("".join(c for c in fh.read() if c.isdigit()) or 0)
    except (OSError, ValueError):
        return 0
    return n if n > 0 else 0


def turns_at(rundir):
    """When the last turn ended, as the mtime of the counter the hook rewrites
    each time. The token `turn_ended_at` carries the same fact and dies with the
    pane; this is the copy that survives it."""
    try:
        return os.path.getmtime(os.path.join(rundir, "turns"))
    except OSError:
        return None


def has_env(rundir):
    """Whether hw wrote a run env file at all. A run with none (hand-made probe,
    or a launch that died before _write_run_env) cannot be asked whether it had a
    return channel, and must not be reported as if it could."""
    return os.path.isfile(os.path.join(rundir, "env"))


def _env_field(rundir, key):
    """One `KEY='value'` line out of a run env file, unquoted, or None.

    THE SINGLE READER FOR BOTH FIELDS, and it is single because it was double.
    run_mode_of and invoker_pane_of carried this body byte-identical down to the
    `.strip("'\"")`, and only invoker_pane_of had a test behind it: measured
    2026-08-26, a mutant deleting run_mode_of's strip
    SURVIVED the entire suite. That is what a duplicated line buys: one
    test, two copies, and the mutant lives in the copy nobody asserted on. One
    line now, and one mutant kills both callers.

    `.strip()` runs before `.strip("'\"")` because hw writes `KEY='value'` but a
    hand-made or hand-edited run directory may carry trailing whitespace or no
    quotes at all. An empty value reads as None rather than "": to every caller
    here, "the key is absent" and "the key is empty" are the same fact, and
    returning "" would make `or`-chains downstream behave differently for two
    inputs that mean the same thing."""
    try:
        with open(os.path.join(rundir, "env")) as fh:
            body = fh.read()
    except OSError:
        return None
    for line in body.split("\n"):
        if line.startswith(key + "="):
            return line.split("=", 1)[1].strip().strip("'\"") or None
    return None


def invoker_pane_of(rundir):
    """The brainer pane this run was told to report to, from the env file hw
    wrote at dispatch. This is the whole reason the orphan section can say WHY a
    task never reported instead of only that it did not.

    None means the key is absent, and that is a HARD fact about the run, not a
    gap: `done-invoker` refuses at its `no HW_INVOKER_PANE` gate without it — before it
    publishes anything. Measured 2026-08-26 against a real herdr pane: the gate
    refusal leaves ZERO tokens, while a DELIVERY refusal (dead brainer pane,
    timeout) publishes done_status/done_state=undelivered/sum first. Two
    refusals, opposite evidence; only the second is readable off the pane, and
    only while that pane is alive."""
    return _env_field(rundir, "HW_INVOKER_PANE")


def receipt_pane(rundir):
    """The executor's OWN pane, as MEASURED at launch and recorded in
    receipt.jsonl — not the pane hw meant to use. If it is still open, the report
    a refused done-invoker printed into it is still there to read."""
    pane = None
    try:
        with open(os.path.join(rundir, "receipt.jsonl")) as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("key") == "pane" and rec.get("value"):
                    pane = rec["value"]
    except OSError:
        return None
    return pane


def receipt_value(rundir, key):
    """The last non-empty value receipt.jsonl recorded for `key`, or None."""
    found = None
    try:
        with open(os.path.join(rundir, "receipt.jsonl")) as fh:
            for line in fh:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("key") == key and rec.get("value"):
                    found = rec["value"]
    except OSError:
        return None
    return found

def chaining_lease_of(rundir):
    """Bounded retention record. Shape only; the detached action is authoritative."""
    path = os.path.join(rundir, "chaining-lease")
    vals = {}
    try:
        with open(path) as fh:
            for line in fh:
                if "=" in line:
                    k, v = line.rstrip("\n").split("=", 1); vals[k] = v
    except OSError:
        return None
    try: until = int(vals.get("until", ""))
    except ValueError: until = 0
    vals["live"] = vals.get("state") == "live" and time.time() < until
    vals["expired"] = vals.get("state") == "live" and time.time() >= until or vals.get("state") == "expired-cleanup"
    return vals


def runs_of(workdir):
    """Every .hw run directory, newest first, with its start time and markers."""
    out = []
    if not workdir:
        return out
    hw = os.path.join(workdir, ".hw")
    # `.hw/done` with no run directory is the pre-HW_RUN layout; still read it.
    if os.path.isfile(os.path.join(hw, "done")):
        out.append({"name": "(legacy)", "done": True, "task": 1,
                    "started": None, "here": None, "mode": None,
                    "own_tab": None, "own_ws": None})
    for d in sorted(glob.glob(os.path.join(hw, "*")), reverse=True):
        if not os.path.isdir(d):
            continue
        name = os.path.basename(d)
        started = None
        m = re.match(r"^(\d{8}-\d{6})", name)
        if m:
            try:
                started = time.mktime(time.strptime(m.group(1), "%Y%m%d-%H%M%S"))
            except Exception:
                started = None
        if started is None:
            try:
                started = os.path.getmtime(d)
            except OSError:
                started = None
        out.append({"name": name, "dir": d, "done": task_done(d), "task": task_seq(d),
                    "reopened": task_reopened(d),
                    "started": started, "here": run_is_here(d),
                    "mode": run_mode_of(d),
                    "turns": turns_of(d), "turns_at": turns_at(d),
                    "invoker": invoker_pane_of(d), "no_report": _env_field(d, "HW_NO_REPORT") == "1", "has_env": has_env(d),
                    "exec_pane": receipt_pane(d),
                    "model_running": receipt_value(d, "model_running"),
                    "model_verdict": receipt_value(d, "model_verdict"),
                    "chaining_lease": chaining_lease_of(d),
                    "own_tab": run_owns(d, "tab"),
                    "own_ws": run_owns(d, "workspace")})
    return out
HW_STATUS_PY
}

_status_recovery_source() {
  cat <<'HW_STATUS_PY'
# ── the queue that had no name: finished, and never reported ───────────────
#
# WHAT WAS MISSING. `hw status` had a word for an executor that reported
# (`reported-done`), for one that reported and could not deliver
# (`done-NOT-delivered`), for one sitting idle with its turn ended
# (`idle, silent`) and for one whose space is gone (`no information`). It had no
# word for the one that FINISHED, could not report, and whose agent then went
# away — and that is not a rare shape. Three executors hit it on 2026-08-26
# alone, and a sweep of all 83 work directories found nine.
#
# WHY THE EXISTING ROWS GET IT BACKWARDS, which is worse than silence. herdr
# drops the AGENT record when the agent process exits, but the PANE survives —
# the tab is still open holding a bare shell. All three of 2026-08-26 were in
# exactly that state, and `hw status` printed them `process-live`, "pane X live,
# no agent detected in it". Healthy-looking, and the opposite of true.
#
# So the discriminator is the AGENT, not the pane, and the evidence is on DISK,
# because every token died with the agent record (measured, see
# invoker_pane_of). Three signals, and all three have to agree:
#
#   1. no `done` marker for the run's CURRENT task seq — it never reported
#   2. `turns` >= 1 — the harness watched at least one turn of this run END
#   3. no live agent in the work directory — it is not running now
#
# THE `turns` GATE IS WHAT STOPS THIS CRYING WOLF, and it is deliberately a
# positive test. A work directory with no done marker is NOT an orphan: it may
# be running (1 and 3 exclude it), it may have been abandoned before it ever
# finished a turn, or it may predate the turn adapter entirely. Those come back
# None here and keep whatever the table already said. Verified over all 83
# directories: 9 orphans, 4 running, 7 unclassifiable, and ZERO tasks that had
# reported.
def orphan_of(newest, has_agent):
    """Did this task finish and never reach a brainer? A dict, or None.

    None is the honest answer for everything the three signals cannot settle,
    and it is the common one. `why` is the part a human acts on: it says whether
    reporting was even POSSIBLE, which is a fact about the dispatch rather than
    about the executor's diligence."""
    if newest is None or has_agent:
        return None
    if newest.get("done"):
        return None
    if newest.get("turns", 0) < 1:
        return None
    return {"run": newest.get("name"), "turns": newest["turns"],
            "at": newest.get("turns_at"), "invoker": newest.get("invoker"),
            "no_report": newest.get("no_report"),
            "has_env": newest.get("has_env"), "exec_pane": newest.get("exec_pane")}


def orphan_why(orph, live_pane_ids):
    """Why the report never landed, from the run's own dispatch record.

    Three answers, and they are not the same problem. The first is hw's or the
    brainer's, not the executor's: without HW_INVOKER_PANE `done-invoker` dies at
    its gate, so a perfectly diligent executor is refused and nothing is
    published. Seven of the nine found on 2026-08-26 were this."""
    if not orph["has_env"]:
        return ("no run env file, so hw cannot say whether it had a return "
                "channel at all")
    if orph.get("no_report"):
        return ("this dispatch deliberately used --no-report (fire-and-forget), so no "
                "brainer report was requested")
    if not orph["invoker"]:
        return ("no HW_INVOKER_PANE in its run env — done-invoker refuses at the "
                "gate (`no HW_INVOKER_PANE` in bin/done-invoker) and publishes nothing, so this was "
                "never the executor's to fix")
    if orph["invoker"] not in live_pane_ids:
        return ("its brainer's pane %s is gone, so done-invoker had nowhere to "
                "deliver" % orph["invoker"])
    return ("its brainer %s is still live, so nothing stopped it — done-invoker "
            "was simply never called" % orph["invoker"])


def cleanup_backlog_of(newest, has_agent, live_panes, own_tab, own_ws):
    """A reported task whose owned container still exists, or None.

    The current task must have a durable done marker, its agent must be gone,
    and an ownership record must name the tab or workspace still holding the
    shell. Those gates exclude every finished-unreported recovery pane by
    construction."""
    if newest is None or not newest.get("done") or has_agent or not live_panes:
        return None
    lease = newest.get("chaining_lease")
    if lease and lease.get("live"):
        return None
    if own_tab:
        return {"kind": "tab", "id": own_tab,
                "panes": [p.get("pane_id") for p in live_panes if p.get("pane_id")]}
    if own_ws:
        return {"kind": "workspace", "id": own_ws,
                "panes": [p.get("pane_id") for p in live_panes if p.get("pane_id")]}
    return None


SKIP_DIRS = {".hw", ".git", "node_modules", ".venv", ".next", "dist", "__pycache__"}

def shape_of(workdir):
    """One phrase describing what is on disk, and it is not the same phrase for
    both kinds of task. A repo-less work directory holds the task's OUTPUT, so
    the file count is the interesting number. A worktree holds a checkout, and
    counting it said `7191 artifacts` for a task that had produced none —
    a number that is both wrong and slow to compute."""
    if not workdir:
        return "no work directory"
    if os.path.exists(os.path.join(workdir, ".git")):
        return "worktree"
    n = 0
    for base, dirs, files in os.walk(workdir):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        n += len(files)
    return f"{n} artifact" + ("" if n == 1 else "s")


# ── a task that is `working` and has shown no sign of life ───────────────────
#
# herdr's `working` goes stale on this machine (state-witness.sh: one pane said
# `working` eight hours after it reported), so an executor that hangs, or that
# is waiting on something nobody will answer, read `working` forever. There is
# no daemon and no history to ask, so STALE is computed at read time from what
# the disk and the process table already hold: the last turn end, the newest
# mtime in the run's own state, the newest file in the work directory, and the
# newest process started with its cwd in it. If none is newer than the
# threshold, the row says so. It is a place to LOOK, not a verdict: what it
# cannot see (pane output; one child that has simply been running a long time)
# is named in the caveats.
def stale_minutes():
    try:
        m = float(os.environ.get("HW_STALE_MINUTES") or 30)
    except ValueError:
        return 30.0
    return m if m > 0 else 30.0


def status_now():
    try:
        return float(os.environ.get("HW_ST_NOW") or time.time())
    except ValueError:
        return time.time()


def run_state_activity(rundir):
    """Newest mtime among the run's own state files, and its t<N>/ directories'.
    Asks, rulings, transcript lines and turn counters all land here."""
    newest = None
    dirs = [rundir] + sorted(glob.glob(os.path.join(rundir, "t[0-9]*")))
    for d in dirs:
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for name in names:
            try:
                m = os.lstat(os.path.join(d, name)).st_mtime
            except OSError:
                continue
            if newest is None or m > newest:
                newest = m
    return newest


def tree_activity(workdir, cutoff):
    """Newest file mtime under the work directory (SKIP_DIRS pruned), returning
    as soon as one is newer than `cutoff`: the question is only whether anything
    moved inside the window, so an active tree costs a handful of stats."""
    newest = None
    for base, dirs, files in os.walk(workdir):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        for f in files:
            try:
                m = os.lstat(os.path.join(base, f)).st_mtime
            except OSError:
                continue
            if newest is None or m > newest:
                newest = m
                if newest >= cutoff:
                    return newest
    return newest


def process_activity(workdir, now):
    """When the newest process with its cwd under `workdir` was STARTED, or None.
    The agent and its MCP servers live there from the first minute, so only a
    START inside the window says anything: a test run, a build, a shell the
    executor opened. None also when ps/lsof cannot be asked."""
    import subprocess
    root = canon(workdir)
    try:
        out = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fpn"], capture_output=True,
                             text=True, timeout=10).stdout
        ps = subprocess.run(["ps", "-axo", "pid=,etime="], capture_output=True,
                            text=True, timeout=10).stdout
    except Exception:
        return None
    pids, pid = set(), None
    for line in out.splitlines():
        if line.startswith("p"):
            pid = line[1:]
        elif line.startswith("n") and pid:
            c = canon(line[1:])
            if c == root or c.startswith(root + "/"):
                pids.add(pid)
    newest = None
    for line in ps.splitlines():
        parts = line.split()
        if len(parts) != 2 or parts[0] not in pids:
            continue
        et, days = parts[1], 0
        if "-" in et:
            d, et = et.split("-", 1)
            days = int(d)
        try:
            sec = [int(x) for x in et.split(":")]
        except ValueError:
            continue
        while len(sec) < 3:
            sec.insert(0, 0)
        started = now - (days * 86400 + sec[0] * 3600 + sec[1] * 60 + sec[2])
        if newest is None or started > newest:
            newest = started
    return newest


def stale_of(newest, workdir, now, threshold_min):
    """None when the task is not stale or hw cannot tell; otherwise the quiet
    time in seconds and the last sign of life it found (when, what).

    Cheap signals first and the dearer ones only while every earlier one is
    still older than the window. No signal at all is None: hw does not claim
    what it cannot place in time."""
    if not newest or not newest.get("dir"):
        return None
    cutoff = now - threshold_min * 60
    signs = []

    def seen(ts, what):
        if ts is not None:
            signs.append((ts, what))
        return ts is not None and ts >= cutoff

    if seen(newest.get("started"), "its launch") \
       or seen(newest.get("turns_at"), "its last turn end") \
       or seen(run_state_activity(newest["dir"]), "its run state (asks, rulings, transcript)"):
        return None
    if workdir and os.path.isdir(workdir):
        if seen(tree_activity(workdir, cutoff), "a file in its work directory"):
            return None
        if seen(process_activity(workdir, now), "a process started in its work directory"):
            return None
    if not signs:
        return None
    ts, what = max(signs)
    return {"quiet": now - ts, "at": ts, "what": what}
HW_STATUS_PY
}

_status_report_spaces_source() {
  cat <<'HW_STATUS_PY'
def status_report_spaces(workspaces, herdr_ok):
    print(f"\n{B}spaces{Z}")
    if not workspaces:
        print(f"  {DIM}·{Z} none" if herdr_ok else f"  {DIM}·{Z} unknown — herdr unreachable")
    for w in workspaces:
        label = w.get("label") or "-"
        drift = (f"  {WARN}DRIFT{Z} — legacy per-task workspace; expected a tab "
                 "in the project's bare-label space") if ":" in label else ""
        print(f"  {w.get('workspace_id')}  {label}{drift}")
HW_STATUS_PY
