#!/usr/bin/env bash
# hw-reconcile — report finished hw work whose push delivery never reached home.
#
# This command is deliberately read-only. It reads run records and live pane state, prints a recovery queue, and exits 3 when that
# queue is non-empty. It never prompts, types into, closes, restarts, or otherwise changes a pane. No hw path calls it: it is the
# operator's detector (`hw-reconcile` by hand, or from a cron line).
#
# Since 2026-11-10 this is a shim: the detector is `hw-core hw-reconcile` (core/wrappers_reconcile.go, tests in
# core/wrappers_reconcile_test.go and setup/tests/50). It stays a file because the operator types this name. Unlike the bash it replaced, it
# needs hw-core: from a checkout that has not built one it says `hw-core is not built` and exits 1.

# ── the Go implementation: hw-core (core/wrappers_reconcile.go)
# The bash body is gone: this file keeps the name (the interface, setup/release-standard.md «Versioning») and execs
# `hw-core hw-reconcile` with the same argv, stdin and environment. It never had a bash switch, so nothing of ~/.config/hw/impl applies. hw-core is HW_CORE (a seam of the suite, never rebuilt), else beside this file, else core/dist/<os>-<arch>/
# (setup/build-core builds it); one not built or older than core/'s sources is rebuilt by bin/core-rebuild when a toolchain is on PATH.
set -euo pipefail
_t_src="${BASH_SOURCE[0]}"
while [ -L "$_t_src" ]; do
  _t_dir="$(cd -P "$(dirname "$_t_src")" && pwd)" || break
  _t_src="$(readlink "$_t_src")" || break
  case "$_t_src" in /*) ;; *) _t_src="$_t_dir/$_t_src" ;; esac
done
_t_bin="$(cd -P "$(dirname "$_t_src")" 2>/dev/null && pwd)"
_t_core=""
if [ -n "${HW_CORE:-}" ]; then
  [ ! -x "$HW_CORE" ] || _t_core="$HW_CORE"
else
  _t_os="$(uname -s | tr 'A-Z' 'a-z')"; _t_arch="$(uname -m)"
  case "$_t_arch" in x86_64) _t_arch=amd64 ;; aarch64|arm64) _t_arch=arm64 ;; esac
  for _t_c in "$_t_bin/hw-core" "$_t_bin/../core/dist/$_t_os-$_t_arch/hw-core"; do
    if [ -x "$_t_c" ]; then _t_core="$_t_c"; break; fi
  done
  if [ -n "$_t_core" ] && [ -d "$_t_bin/../core" ] \
     && [ -n "$(find "$_t_bin/../core" -path '*/dist' -prune -o \( -name '*.go' -o -name '*.txt' -o -name go.mod \) -newer "$_t_core" -print -quit 2>/dev/null)" ]; then
    _t_msg="$("$_t_bin/core-rebuild" "$_t_bin" "$_t_core" hw-reconcile 2>&1)" || :   # stale: rebuilt (bin/core-rebuild), or the old one runs with one line
    [ -z "$_t_msg" ] || printf 'hw-reconcile: %s\n' "$_t_msg" >&2
  fi
fi
if [ -n "$_t_core" ]; then
  HW_WRAPPER_ARGV0="$0" HW_CORE_BIN_DIR="$_t_bin" exec "$_t_core" hw-reconcile "$@"
fi
printf 'hw-reconcile: hw-core is not built: run setup/build-core --native (it needs Go 1.22 or newer, https://go.dev/dl)\n' >&2
exit 1
