#!/usr/bin/env bash
#
# hw-sandbox — run an executor inside a Seatbelt (sandbox-exec) profile, and
# carry its reports out of it.
#
#   hw-sandbox profile               print the hard profile for this dispatch
#   hw-sandbox statedir <rundir>     the run's private state dir (profile, shim, heartbeat)
#   hw-sandbox arm <rundir> <kind> [<lane> <task>]   rebuild it; record the task as armed
#   hw-sandbox armed <lane> <task>   exit 0 if that task was ever armed
#   hw-sandbox run <rundir> <exe> [args…]   (the shim's body) broker + sandbox
#   hw-sandbox broker <rundir> <owner-pid>   deliver <rundir>/outbox/*.req from outside
#   hw-sandbox request <invoker> [args…]    (inside) hand one invoker call out
#
# WHY, AND WHAT WAS CHOSEN. The setup lane's executor-isolation decision of
# 2026-09-30, on the executor-isolation-arch measurements: Seatbelt, opt-in per
# dispatch, macOS only, with the HARD profile — the base one escapes through
# the docker and herdr unix sockets (measured: `docker run -v $HOME` and
# `herdr pane run` both wrote to ~ from inside). The hard profile denies every
# outbound unix socket but mDNSResponder, and with it herdr — so done-invoker
# and ask-invoker cannot reach the brainer from inside. That is what the
# broker is for.
#
# THE BROKER IS PER DISPATCH, AND IT IS THE LAUNCH WRAPPER'S OWN CHILD. `run`
# starts it BEFORE it calls sandbox-exec, so it is outside the profile, and it
# dies when the agent exits. Chosen over the brainer's pane as broker because a
# brainer is a model turn: it cannot poll a directory, it may be closed (the
# outbox exists precisely because it may be), and a report would then wait on
# the next time a person opens the lane. A process the launch owns has none of
# that and needs no daemon, no lock and no registry.
#
# WHAT CROSSES, AND WHAT DOES NOT. Inside, an invoker writes only its ARGV —
# NUL-separated, never evaluated — as <rundir>/outbox/<id>.req. Outside, the
# broker runs the REAL invoker from the brain checkout that launched this
# dispatch, under the environment the pane had at launch: the run, the task and
# the brainer pane are the broker's, not the request's. So a sandboxed agent
# can do exactly what it could do before — report its own run, ask its own
# brainer — and nothing else: no other verb, no other run, no environment.
# The invoker's stdout, stderr and exit status come back as files and are
# replayed inside, so the caller sees the same invoker it always did. The
# answer to an ask comes back the way it always has: the brainer types it into
# this pane through herdr, from outside.
#
# WHAT THE PROFILE DOES NOT STOP is in setup/export/overlay/docs/THREAT-MODEL.md and
# docs/KNOWN-LIMITATIONS.md: TCP (engram, the network), a push over HTTPS, the run
# state under <workdir>/.hw, and anything Chrome needs --no-sandbox for.
set -euo pipefail

# ── the Go implementation: hw-core hw-sandbox (core/hw_sandbox*.go) ──
# 0.7.0 removed the bash body: this file keeps the name (the interface, setup/release-standard.md «Versioning») and execs
# `hw-core hw-sandbox` with the same argv, stdin and environment. A HW_IMPL_HW_SANDBOX or `hw-sandbox=bash` word is retired: bin/impl-retired.sh says so
# once and Go runs. hw-core is HW_CORE (a seam of the suite, never rebuilt), else beside this file, else core/dist/<os>-<arch>/
# (setup/build-core builds it); one not built or older than core/'s sources is rebuilt by bin/core-rebuild when a toolchain is on PATH.
set -euo pipefail
_t_src="${BASH_SOURCE[0]}"
while [ -L "$_t_src" ]; do
  _t_dir="$(cd -P "$(dirname "$_t_src")" && pwd)" || break
  _t_src="$(readlink "$_t_src")" || break
  case "$_t_src" in /*) ;; *) _t_src="$_t_dir/$_t_src" ;; esac
done
_t_bin="$(cd -P "$(dirname "$_t_src")" 2>/dev/null && pwd)"
[ ! -r "$_t_bin/impl-retired.sh" ] || { . "$_t_bin/impl-retired.sh"; impl_retired_warn hw-sandbox; }
_t_core=""
if [ -n "${HW_CORE:-}" ]; then
  [ ! -x "$HW_CORE" ] || _t_core="$HW_CORE"
else
  _t_os="$(uname -s | tr 'A-Z' 'a-z')"; _t_arch="$(uname -m)"
  case "$_t_arch" in x86_64) _t_arch=amd64 ;; aarch64|arm64) _t_arch=arm64 ;; esac
  for _t_c in "$_t_bin/hw-core" "$_t_bin/../core/dist/$_t_os-$_t_arch/hw-core"; do
    if [ -x "$_t_c" ]; then _t_core="$_t_c"; break; fi
  done
  if [ -n "$_t_core" ] && [ -d "$_t_bin/../core" ] \
     && [ -n "$(find "$_t_bin/../core" -path '*/dist' -prune -o \( -name '*.go' -o -name '*.txt' -o -name go.mod \) -newer "$_t_core" -print -quit 2>/dev/null)" ]; then
    _t_msg="$("$_t_bin/core-rebuild" "$_t_bin" "$_t_core" hw-sandbox 2>&1)" || :   # stale: rebuilt (bin/core-rebuild), or the old one runs with one line
    [ -z "$_t_msg" ] || printf 'hw-sandbox: %s\n' "$_t_msg" >&2
  fi
fi
if [ -n "$_t_core" ]; then
  HW_WRAPPER_ARGV0="$0" HW_CORE_BIN_DIR="$_t_bin" exec "$_t_core" hw-sandbox "$@"
fi
printf 'hw-sandbox: hw-core is not built: run setup/build-core --native (it needs Go 1.22 or newer, https://go.dev/dl)\n' >&2
exit 1
