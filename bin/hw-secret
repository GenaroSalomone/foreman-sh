#!/usr/bin/env bash
# hw-secret — the one path from Bitwarden to an executor, and it never prints.
#
#   hw secret run <item>[.<field>] --as VAR [--item … --as …] -- <cmd…>
#   hw secret check <item>[.<field>]…     present / absent, no value
#   <cmd that prints a value> | hw secret put <item>[.<field>] [--replace]
#                                         store the value read from a PIPE on stdin
#   hw secret status                      locked / unlocked until …
#   hw secret ensure                      unlocked, or one `secret-unlock --auto` try
#   secret-unlock [--hours N] | --lock    (bin/secret-unlock execs `hw-secret unlock`)
#   secret-unlock --setup                 once, a person: the master password into the Keychain
#   secret-unlock --auto                  a scheduled unlock (and `ensure`'s), no prompt
#
# WHY. A stored credential reached no executor: the Keychain read is refused by
# ~/.claude/hooks/block-keychain-secret-read.py. Bitwarden's CLI is the vault
# the operator keeps their credentials in. The master password is typed ONCE, by a
# person, in `secret-unlock --setup` (read -s, no echo) and kept in the login
# Keychain as the service hw-bw-master. A job you schedule (launchd: `--auto` needs the
# Keychain) runs `secret-unlock --auto` at load and every hour (a calendar slot, so a sleep does not skip it): it reads that item, runs
# `bw unlock --passwordenv` and writes the session token to ~/.cache/hw/bw-session
# (dir 0700, file 0600) with an expiry. `hw secret run` reads the session, fetches
# the value and puts it ONLY in the child's environment. A failed --auto leaves
# ~/.cache/hw/bw-unlock-status (a reason, never a secret) and a timestamped line in bw-unlock.log.
#
# PUT. The way in, for a credential an agent generates or fetches with one it already
# has (`hw secret run <src> --as T -- sh -c '<fetch using $T>' | hw secret put <dst>`). The
# value comes ONLY from a pipe on stdin (a TTY, a file, an argv value and empty input are
# refused; one trailing newline is stripped), travels to bw on ITS stdin (JSON -> base64 ->
# `bw create|edit item`, which reads its encoded JSON from stdin when argv has none) and
# never in argv or the environment (core/hw_secret.go, cmdPut).
# It creates the item in the folder `agents` (no field: the login password; a field: a
# hidden custom field), refuses a value that already exists, and overwrites one only with
# --replace, saying `replaced`. It prints `stored|replaced <spec>` or the reason and nothing
# else: bw's reply (the item's JSON, value included) goes to /dev/null, and nothing in put
# reads a value back.
#
# WHAT HOLDS THE LINE, and what does not:
#   · only items of the Bitwarden FOLDER `agents` resolve (personal vaults have
#     folders, not collections): the id comes from `bw list items --folderid`;
#   · the value is never printed, never written to disk, never in argv: it is
#     exported inside this process and `exec`ed over it; bw's stderr is dropped;
#   · the guard (setup/guards/deny-bitwarden-secrets.py) refuses `bw get|unlock|
#     export|list|serve|create|edit`, a read of the session file and BW_SESSION in an agent's
#     command, so this is the only path — a behavioural boundary, not a sandbox:
#     the token opens the WHOLE vault, and an executor holding a value can print it.
#
# Inputs this directory's tests own: HW_BW_BIN (the bw to run), HW_SECRET_DIR
# (where the session lives), HW_BW_KEYCHAIN (a keychain FILE to use instead of the
# login one: tests pass a throwaway).
#
# THE PASSWORD'S ROADS, and the one place it is visible. Stored through
# `security -i` reading its command from STDIN (never argv, so not in `ps`); read
# back with `security find-generic-password -w` into a variable, handed to bw in
# the ENVIRONMENT of that one process (`--passwordenv`), so it is visible only to
# the same user's `ps eww` for the instant bw runs. The Keychain item is readable by
# any process of the user that passes its ACL: the guard cuts AGENTS, not a process
# made on purpose (docs/KNOWN-LIMITATIONS L23).
set -euo pipefail

# ── the Go implementation: hw-core hw-secret (core/hw_secret*.go) ──
# 0.7.0 removed the bash body: this file keeps the name (the interface, setup/release-standard.md «Versioning») and execs
# `hw-core hw-secret` with the same argv, stdin and environment. A HW_IMPL_HW_SECRET or `hw-secret=bash` word is retired: bin/impl-retired.sh says so
# once and Go runs. hw-core is HW_CORE (a seam of the suite, never rebuilt), else beside this file, else core/dist/<os>-<arch>/
# (setup/build-core builds it); one not built or older than core/'s sources is rebuilt by bin/core-rebuild when a toolchain is on PATH.
set -euo pipefail
_t_src="${BASH_SOURCE[0]}"
while [ -L "$_t_src" ]; do
  _t_dir="$(cd -P "$(dirname "$_t_src")" && pwd)" || break
  _t_src="$(readlink "$_t_src")" || break
  case "$_t_src" in /*) ;; *) _t_src="$_t_dir/$_t_src" ;; esac
done
_t_bin="$(cd -P "$(dirname "$_t_src")" 2>/dev/null && pwd)"
[ ! -r "$_t_bin/impl-retired.sh" ] || { . "$_t_bin/impl-retired.sh"; impl_retired_warn hw-secret; }
_t_core=""
if [ -n "${HW_CORE:-}" ]; then
  [ ! -x "$HW_CORE" ] || _t_core="$HW_CORE"
else
  _t_os="$(uname -s | tr 'A-Z' 'a-z')"; _t_arch="$(uname -m)"
  case "$_t_arch" in x86_64) _t_arch=amd64 ;; aarch64|arm64) _t_arch=arm64 ;; esac
  for _t_c in "$_t_bin/hw-core" "$_t_bin/../core/dist/$_t_os-$_t_arch/hw-core"; do
    if [ -x "$_t_c" ]; then _t_core="$_t_c"; break; fi
  done
  if [ -n "$_t_core" ] && [ -d "$_t_bin/../core" ] \
     && [ -n "$(find "$_t_bin/../core" -path '*/dist' -prune -o \( -name '*.go' -o -name '*.txt' -o -name go.mod \) -newer "$_t_core" -print -quit 2>/dev/null)" ]; then
    _t_msg="$("$_t_bin/core-rebuild" "$_t_bin" "$_t_core" hw-secret 2>&1)" || :   # stale: rebuilt (bin/core-rebuild), or the old one runs with one line
    [ -z "$_t_msg" ] || printf 'hw-secret: %s\n' "$_t_msg" >&2
  fi
fi
if [ -n "$_t_core" ]; then
  HW_WRAPPER_ARGV0="$0" HW_CORE_BIN_DIR="$_t_bin" exec "$_t_core" hw-secret "$@"
fi
printf 'hw secret: hw-core is not built: run setup/build-core --native (it needs Go 1.22 or newer, https://go.dev/dl)\n' >&2
exit 1
