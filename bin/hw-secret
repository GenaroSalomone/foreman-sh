#!/usr/bin/env bash
# hw-secret — the one path from Bitwarden to an executor, and it never prints.
#
#   hw secret run <item>[.<field>] --as VAR [--item … --as …] -- <cmd…>
#   hw secret check <item>[.<field>]…     present / absent, no value
#   hw secret status                      locked / unlocked until …
#   hw secret ensure                      unlocked, or one `secret-unlock --auto` try
#   secret-unlock [--hours N] | --lock    (bin/secret-unlock execs `hw-secret unlock`)
#   secret-unlock --setup                 once, a person: the master password into the Keychain
#   secret-unlock --auto                  the LaunchAgent's (and `ensure`'s) unlock, no prompt
#
# WHY. A stored credential reached no executor: the Keychain read is refused by
# ~/.claude/hooks/block-keychain-secret-read.py. Bitwarden's CLI is the vault
# the operator keeps their credentials in. The master password is typed ONCE, by a
# person, in `secret-unlock --setup` (read -s, no echo) and kept in the login
# Keychain as the service hw-bw-master. A LaunchAgent (setup/install-bw-unlock-agent.sh)
# runs `secret-unlock --auto` at load and every 11 h: it reads that item, runs
# `bw unlock --passwordenv` and writes the session token to ~/.cache/hw/bw-session
# (dir 0700, file 0600) with an expiry. `hw secret run` reads the session, fetches
# the value and puts it ONLY in the child's environment. A failed --auto leaves
# ~/.cache/hw/bw-unlock-status (a reason, never a secret) and nothing else.
#
# WHAT HOLDS THE LINE, and what does not:
#   · only items of the Bitwarden FOLDER `agents` resolve (personal vaults have
#     folders, not collections): the id comes from `bw list items --folderid`;
#   · the value is never printed, never written to disk, never in argv: it is
#     exported inside this process and `exec`ed over it; bw's stderr is dropped;
#   · the guard (setup/guards/deny-bitwarden-secrets.py) refuses `bw get|unlock|
#     export|list|serve`, a read of the session file and BW_SESSION in an agent's
#     command, so this is the only path — a behavioural boundary, not a sandbox:
#     the token opens the WHOLE vault, and an executor holding a value can print it.
#
# Inputs this directory's tests own: HW_BW_BIN (the bw to run), HW_SECRET_DIR
# (where the session lives), HW_BW_KEYCHAIN (a keychain FILE to use instead of the
# login one: tests pass a throwaway).
#
# THE PASSWORD'S ROADS, and the one place it is visible. Stored through
# `security -i` reading its command from STDIN (never argv, so not in `ps`); read
# back with `security find-generic-password -w` into a variable, handed to bw in
# the ENVIRONMENT of that one process (`--passwordenv`), so it is visible only to
# the same user's `ps eww` for the instant bw runs. The Keychain item is readable by
# any process of the user that passes its ACL: the guard cuts AGENTS, not a process
# made on purpose (KNOWN-LIMITATIONS L23).
set -euo pipefail
umask 077

AGENTS_FOLDER=agents
SECRET_DIR="${HW_SECRET_DIR:-$HOME/.cache/hw}"
SESSION_FILE="$SECRET_DIR/bw-session"
HERE="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BW="${HW_BW_BIN:-}"
if [ -z "$BW" ]; then
  BW="$(command -v bw 2>/dev/null || true)"
  [ -n "$BW" ] || { [ -x "$HOME/.npm-global/bin/bw" ] && BW="$HOME/.npm-global/bin/bw"; } || true
fi

die()  { printf 'hw secret: %s\n' "$*" >&2; exit 1; }
note() { printf 'hw secret: %s\n' "$*" >&2; }
need_bw() { [ -n "$BW" ] && [ -x "$BW" ] || die "the bw CLI is not installed (npm i -g @bitwarden/cli)"; command -v jq >/dev/null 2>&1 || die "jq is required"; }

# ── the session ─────────────────────────────────────────────────────────────
# Whoever finds the file expired removes it and locks the vault.
_expire() { rm -f "$SESSION_FILE"; env -u BW_SESSION "$BW" lock >/dev/null 2>&1 || true; }

# 0 = a live session, exported as BW_SESSION; 1 = locked (the file, if any, is gone).
_session_load() {
  local exp="" tok="" st
  [ -f "$SESSION_FILE" ] || return 1
  { IFS= read -r exp || true; IFS= read -r tok || true; } < "$SESSION_FILE"
  exp="${exp#expires=}"
  case "$exp" in ''|*[!0-9]*) rm -f "$SESSION_FILE"; return 1 ;; esac
  [ -n "$tok" ] || { rm -f "$SESSION_FILE"; return 1; }
  if [ "$exp" -le "$(date +%s)" ]; then _expire; return 1; fi  # MUTATION-ANCHOR: 1009-M01
  # The token must still open the vault: someone may have run `bw lock` since.
  st="$(BW_SESSION="$tok" "$BW" status 2>/dev/null | jq -r '.status // empty' 2>/dev/null || true)"
  [ "$st" = unlocked ] || { rm -f "$SESSION_FILE"; return 1; }  # MUTATION-ANCHOR: 1009-M07
  BW_SESSION="$tok"; export BW_SESSION
}

_until() { date -r "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$1" '+%Y-%m-%d %H:%M' 2>/dev/null || printf 'epoch %s' "$1"; }

STATUS_FILE="$SECRET_DIR/bw-unlock-status"
MASTER_SERVICE=hw-bw-master
KEYCHAIN="${HW_BW_KEYCHAIN:-}"

# <token> <hours> → the session file, 0600 in a 0700 dir, with its expiry
_session_write() {
  local tok="$1" hours="$2" exp tmp
  mkdir -p "$SECRET_DIR"; chmod 700 "$SECRET_DIR"
  exp=$(( $(date +%s) + hours * 3600 ))
  tmp="$(mktemp "$SECRET_DIR/.bw-session.XXXXXX")"   # mktemp creates 0600
  printf 'expires=%s\n%s\n' "$exp" "$tok" > "$tmp"
  mv -f "$tmp" "$SESSION_FILE"  # MUTATION-ANCHOR: 1009-M06
  printf 'unlocked until %s (%s h); the session is in %s (0600), nothing secret was printed\n' "$(_until "$exp")" "$hours" "$SESSION_FILE"
}

_need_security() { command -v security >/dev/null 2>&1 || die "the master password lives in the macOS Keychain and there is no security(1) here: use plain secret-unlock"; }

# the state a failed --auto leaves, and the only thing it leaves: a reason, never a secret
_auto_status() {
  mkdir -p "$SECRET_DIR"; chmod 700 "$SECRET_DIR"
  printf '%s %s\n' "$1" "$(date '+%Y-%m-%d %H:%M:%S')${2:+ — $2}" > "$STATUS_FILE"
}
_auto_fail() { _auto_status failed "$1"; note "secret-unlock --auto failed: $1"; return 1; }  # MUTATION-ANCHOR: 1012-M02

# The password goes in on STDIN of `security -i`, as a quoted command: never in argv.
_master_store() {  # reads the password from stdin
  local pw esc kc=""
  IFS= read -r pw
  esc="$(printf '%s' "$pw" | sed 's/[\\"]/\\&/g')"
  [ -z "$KEYCHAIN" ] || kc=" \"$(printf '%s' "$KEYCHAIN" | sed 's/[\\"]/\\&/g')\""
  printf 'add-generic-password -U -s %s -a %s -w "%s"%s\n' "$MASTER_SERVICE" "${USER:-$(id -un)}" "$esc" "$kc" | security -i >/dev/null 2>&1  # MUTATION-ANCHOR: 1012-M05
  security find-generic-password -s "$MASTER_SERVICE" ${KEYCHAIN:+"$KEYCHAIN"} >/dev/null 2>&1   # metadata only
}
_master_read() { security find-generic-password -s "$MASTER_SERVICE" -w ${KEYCHAIN:+"$KEYCHAIN"} 2>/dev/null; }
_master_forget() { security delete-generic-password -s "$MASTER_SERVICE" ${KEYCHAIN:+"$KEYCHAIN"} >/dev/null 2>&1 || true; }

# secret-unlock --auto: the Keychain item → bw unlock --passwordenv → the session file
cmd_auto() {
  local hours="${1:-12}" pw tok st
  need_bw; _need_security
  st="$(env -u BW_SESSION "$BW" status 2>/dev/null | jq -r '.status // empty' 2>/dev/null || true)"
  [ "$st" != unauthenticated ] || { _auto_fail "bw is not logged in (bw login, once)"; return 1; }
  pw="$(_master_read)" || pw=""
  [ -n "$pw" ] || { _auto_fail "no $MASTER_SERVICE item in the Keychain (secret-unlock --setup, once)"; return 1; }
  tok="$(BW_HW_MASTER="$pw" env -u BW_SESSION "$BW" unlock --passwordenv BW_HW_MASTER --raw 2>/dev/null)" || tok=""  # MUTATION-ANCHOR: 1012-M01
  pw=""
  [ -n "$tok" ] || { _auto_fail "bw rejected the stored master password"; return 1; }
  _session_write "$tok" "$hours" >/dev/null
  _auto_status ok
  printf 'unlocked (auto)\n'
}

# secret-unlock --setup: once, a person, a plain terminal
cmd_setup() {
  local pw pw2
  need_bw; _need_security
  printf 'Bitwarden master password (not echoed): ' >&2; IFS= read -rs pw || true; printf '\n' >&2
  printf 'Again: ' >&2; IFS= read -rs pw2 || true; printf '\n' >&2
  [ -n "$pw" ] || die "an empty password was not stored"
  [ "$pw" = "$pw2" ] || die "the two entries differ: nothing was stored"  # MUTATION-ANCHOR: 1012-M04
  printf '%s\n' "$pw" | _master_store || die "the Keychain refused the item"
  pw=""; pw2=""
  if ! cmd_auto >/dev/null; then
    _master_forget  # MUTATION-ANCHOR: 1012-M03
    die "bw did not accept that password (or is not logged in): the Keychain item was removed. $(sed 's/^[a-z]* [0-9: -]*// ' "$STATUS_FILE" 2>/dev/null)"
  fi
  printf 'stored as the Keychain service %s and unlocked once; the LaunchAgent (setup/install-bw-unlock-agent.sh) keeps it unlocked\n' "$MASTER_SERVICE"
}

cmd_unlock() {
  local hours=12 mode=interactive st tok
  while [ $# -gt 0 ]; do
    case "$1" in
      --hours) [ $# -ge 2 ] || die "--hours takes a number"; hours="$2"; shift 2 ;;
      --lock) mode=lock; shift ;;
      --auto) mode=auto; shift ;;
      --setup) mode=setup; shift ;;
      -h|--help) printf 'usage: secret-unlock [--hours N]   unlock Bitwarden (bw prompts for the master password); default 12 h\n       secret-unlock --lock       lock the vault and drop the session file\n       secret-unlock --setup      ONCE, a person: store the master password in the Keychain (service %s)\n       secret-unlock --auto       unlock from that item, no prompt (the LaunchAgent runs this every 11 h)\n' "$MASTER_SERVICE"; return 0 ;;
      *) die "unknown option: $1 (secret-unlock --help)" ;;
    esac
  done
  need_bw
  if [ "$mode" = lock ]; then
    env -u BW_SESSION "$BW" lock >/dev/null 2>&1 || true
    rm -f "$SESSION_FILE"
    printf 'locked: vault locked, session file removed\n'; return 0
  fi
  case "$hours" in ''|*[!0-9]*|0) die "--hours takes a whole number of hours, 1 to 168 (got: $hours)" ;; esac
  [ "$hours" -le 168 ] || die "--hours takes a whole number of hours, 1 to 168 (got: $hours)"
  case "$mode" in
    auto)  cmd_auto "$hours"; return ;;
    setup) cmd_setup; return ;;
  esac
  st="$(env -u BW_SESSION "$BW" status 2>/dev/null | jq -r '.status // empty' 2>/dev/null || true)"
  [ "$st" != unauthenticated ] || die "bw is not logged in: run \`bw login\` once, then secret-unlock"
  # bw prompts for the master password on the terminal itself and, with --raw,
  # prints only the token on stdout: nothing here ever sees the password.
  tok="$(env -u BW_SESSION "$BW" unlock --raw)" || die "bw unlock failed (wrong master password?)"
  [ -n "$tok" ] || die "bw unlock returned no session"
  _session_write "$tok" "$hours"
}

# ── resolving an item inside the folder `agents` ────────────────────────────
# Both helpers need a live session. A value never leaves a pipe or a variable.
_folder_id() {
  "$BW" list folders --search "$AGENTS_FOLDER" 2>/dev/null \
    | jq -r --arg n "$AGENTS_FOLDER" '[.[]? | select(.name == $n) | .id][0] // empty' 2>/dev/null || true
}

# <name> -> prints the id; 0 found, 1 absent, 3 ambiguous (two items, one name)
_item_id() {
  local fid listing ids n
  fid="$(_folder_id)"; [ -n "$fid" ] || return 1
  listing="$("$BW" list items --folderid "$fid" --search "$1" 2>/dev/null || true)"  # MUTATION-ANCHOR: 1009-M02
  ids="$(printf '%s' "$listing" | jq -r --arg n "$1" '.[]? | select(.name == $n) | .id' 2>/dev/null || true)"
  [ -n "$ids" ] || return 1
  n="$(printf '%s\n' "$ids" | wc -l | tr -d ' ')"
  [ "$n" = 1 ] || return 3  # MUTATION-ANCHOR: 1009-M08
  printf '%s' "$ids"
}

# <spec> -> sets RES_ID, RES_FIELD, RES_NAME. The whole spec is tried as an item
# name first; failing that, the text after its LAST dot is the field.
_resolve() {
  local spec="$1" rc=0
  RES_ID=""; RES_FIELD=password; RES_NAME="$spec"
  RES_ID="$(_item_id "$spec")" || rc=$?
  if [ "$rc" = 1 ]; then
    case "$spec" in
      *.*)
        RES_NAME="${spec%.*}"; RES_FIELD="${spec##*.}"; rc=0
        [ -n "$RES_NAME" ] && [ -n "$RES_FIELD" ] || return 1
        RES_ID="$(_item_id "$RES_NAME")" || rc=$? ;;
    esac
  fi
  return "$rc"
}

# the jq program for one built-in field of `bw get item`; a custom field otherwise
_field_expr() {
  case "$1" in
    password) printf '.login.password' ;;
    username) printf '.login.username' ;;
    notes)    printf '.notes' ;;
    uri)      printf '.login.uris[0].uri' ;;
    *)        printf '([.fields[]? | select(.name == $f) | .value][0])' ;;
  esac
}

# <id> <field> -> prints the value (the only place one is printed, into a $( ))
_field_value() {
  if [ "$2" = totp ]; then "$BW" get totp "$1" 2>/dev/null; return; fi
  "$BW" get item "$1" 2>/dev/null | jq -r --arg f "$2" "($(_field_expr "$2")) // empty" 2>/dev/null
}

_valid_spec() { case "$1" in ''|-*|*$'\n'*) return 1 ;; esac; return 0; }

# ── hw secret check <item>… ─────────────────────────────────────────────────
cmd_check() {
  local spec rc=0 r
  [ $# -ge 1 ] || die "usage: hw secret check <item>[.<field>]…"
  need_bw
  _session_load || { note "the vault is LOCKED, so nothing can be checked: run secret-unlock in a terminal"; return 2; }
  for spec in "$@"; do
    _valid_spec "$spec" || die "not an item name: $spec"
    r=0; _resolve "$spec" || r=$?
    case "$r" in
      0)
        # presence of the item AND of the field, answered by jq's exit status alone
        if [ "$RES_FIELD" = totp ]; then
          "$BW" get totp "$RES_ID" >/dev/null 2>&1 && r=0 || r=1
        else
          "$BW" get item "$RES_ID" 2>/dev/null \
            | jq -e --arg f "$RES_FIELD" "(($(_field_expr "$RES_FIELD")) // \"\") | (tostring | length) > 0" >/dev/null 2>&1 && r=0 || r=1
        fi
        if [ "$r" = 0 ]; then printf '  ok  %s — present in %s\n' "$spec" "$AGENTS_FOLDER"
        else printf '  !!  %s — the item is there but its field "%s" is absent or empty\n' "$spec" "$RES_FIELD"; rc=1; fi ;;
      3) printf '  !!  %s — AMBIGUOUS: two items in %s carry that name\n' "$spec" "$AGENTS_FOLDER"; rc=1 ;;
      *) printf '  !!  %s — ABSENT from the Bitwarden folder %s\n' "$spec" "$AGENTS_FOLDER"; rc=1 ;;
    esac
  done
  [ "$rc" = 0 ] && printf '  only presence was checked — no value was read, printed or logged.\n'
  return "$rc"
}

# ── hw secret status ────────────────────────────────────────────────────────
cmd_status() {
  local exp=""
  need_bw
  if _session_load; then
    IFS= read -r exp < "$SESSION_FILE"; exp="${exp#expires=}"
    printf 'unlocked until %s\n' "$(_until "$exp")"
  else
    printf 'locked\n'; return 1
  fi
}

# ── hw secret ensure ────────────────────────────────────────────────────────
# Unlocked, or ONE `secret-unlock --auto` try (the Keychain's master password,
# no prompt) before refusing. The LaunchAgent normally keeps the vault unlocked;
# this is the same unlock for when it has not run yet or its session expired.
cmd_ensure() {
  need_bw
  _session_load && return 0
  note "the vault is locked: one secret-unlock --auto try (the master password comes from the Keychain)"
  cmd_auto >/dev/null 2>&1 || true  # MUTATION-ANCHOR: 1012-M06
  _session_load && return 0
  note "the vault is still locked ($(sed 's/^[a-z]* [0-9: -]*// ' "$STATUS_FILE" 2>/dev/null || printf 'no reason recorded')). A person, once: secret-unlock --setup"
  return 1
}

# ── hw secret run ───────────────────────────────────────────────────────────
_run_usage() { die "usage: hw secret run <item>[.<field>] --as VAR [--item <item> --as VAR …] -- <cmd…>"; }

cmd_run() {
  local pending="" var i j v
  local -a specs=() vars=() values=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; break ;;
      --item) [ $# -ge 2 ] || _run_usage; [ -z "$pending" ] || die "the item \"$pending\" has no --as"; pending="$2"; shift 2 ;;
      --as)   [ $# -ge 2 ] || _run_usage; [ -n "$pending" ] || die "--as $2 has no item before it"
              specs+=("$pending"); vars+=("$2"); pending=""; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *)  [ -z "$pending" ] && [ ${#specs[@]} -eq 0 ] || die "unexpected argument \"$1\": a second item is --item <item> --as VAR"; pending="$1"; shift ;;
    esac
  done
  [ -z "$pending" ] || die "the item \"$pending\" has no --as"
  [ ${#specs[@]} -ge 1 ] && [ $# -ge 1 ] || _run_usage
  i=0
  while [ "$i" -lt ${#specs[@]} ]; do
    v="${vars[$i]}"
    _valid_spec "${specs[$i]}" || die "not an item name: ${specs[$i]}"
    case "$v" in
      ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*) die "--as $v is not an environment variable name" ;;
      BW_*|PATH|HOME|IFS|ENV|BASH_ENV|SHELLOPTS|BASHOPTS|PS4|LD_*|DYLD_*) die "--as $v is refused: a secret may not replace that variable" ;;  # MUTATION-ANCHOR: 1009-M05
    esac
    j=0; while [ "$j" -lt "$i" ]; do [ "${vars[$j]}" != "$v" ] || die "--as $v is used twice"; j=$(( j + 1 )); done
    i=$(( i + 1 ))
  done
  need_bw
  _session_load || die "the vault is LOCKED or its session expired: the brainer unlocks it (secret-unlock); report this blocked"
  i=0
  while [ "$i" -lt ${#specs[@]} ]; do
    j=0; _resolve "${specs[$i]}" || j=$?
    case "$j" in
      0) ;;
      3) die "AMBIGUOUS: two items in the folder $AGENTS_FOLDER carry the name ${specs[$i]}" ;;
      *) die "${specs[$i]} is not in the Bitwarden folder $AGENTS_FOLDER" ;;
    esac
    v="$(_field_value "$RES_ID" "$RES_FIELD")" || v=""
    [ -n "$v" ] || die "${RES_NAME}.${RES_FIELD} is absent or empty"
    values+=("$v")  # MUTATION-ANCHOR: 1009-M04
    i=$(( i + 1 ))
  done
  # The child gets the values and NOT the vault: every BW_* goes first.
  for v in ${!BW_@}; do unset "$v"; done  # MUTATION-ANCHOR: 1009-M03
  i=0
  while [ "$i" -lt ${#specs[@]} ]; do export "${vars[$i]}=${values[$i]}"; i=$(( i + 1 )); done
  exec "$@"
}

case "${1:-}" in
  run)    shift; cmd_run "$@" ;;
  check)  shift; cmd_check "$@" ;;
  status) shift; cmd_status "$@" ;;
  ensure) shift; cmd_ensure "$@" ;;
  unlock) shift; cmd_unlock "$@" ;;
  ''|-h|--help|help)
    printf 'usage: hw secret run <item>[.<field>] --as VAR [--item … --as …] -- <cmd…>\n       hw secret check <item>[.<field>]…\n       hw secret status | ensure\n       secret-unlock [--hours N | --lock]   (a person, in a terminal, once a day)\n' ;;
  *) die "unknown verb: $1 (run, check, status, ensure)" ;;
esac
