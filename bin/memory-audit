#!/usr/bin/env python3
"""THE ALWAYS-LOADED MEMORY INDEXES, AUDITED. READ-ONLY, ONE LINE, OR NOTHING.

    memory-audit [--root DIR] [--config-dir DIR]... [--budget-bytes N]
                 [--engram BIN] [--engram-project LABEL]

Claude Code loads the whole MEMORY.md of a git root's auto-memory into every
session started under it, one copy per account config dir. Nothing else in the
harness keeps that index honest, so `hw status` runs this and prints its line.
It checks the harness roots (this brain and every lane `checkout` in
projects.json) under each account config dir, and says, in ONE line:

  - an index over the byte budget (HW_MEMORY_INDEX_BUDGET, default 15000:
    under the 16961 B the brain index measured before its 2026-10-02 cleanup);
  - a retired entry still listed: a retirement marker on the index line
    (OBSOLETA, REVERTIDA, SUPERSEDED, ...), a target file that opens with a
    superseded banner, or a target file that does not exist;
  - a `[[slug]]` cited in a live <lane>/decisions.md that resolves to no memory
    file in any audited store and no file in this repository;
  - a memory file with no `type:`, a `project` one with no `expires:` date, or
    one past it (a project fact is a loan, not a gift);
  - a memory file the index does not list (index and files are one-to-one: the
    reverse, a listed file that is missing, is the "retired" line above), or a
    store over HW_MEMORY_FILE_CAP files (default 60);
  - a memory whose description shares most of its key words with one
    decisions.md heading or CLAUDE.md line: two owners for one fact;
  - engram, read through its CLI only (`conflicts stats`, `export`): pending
    conflicts over HW_ENGRAM_PENDING_MAX (100) or observations without a
    `topic_key` over HW_ENGRAM_NOKEY_MAX percent (30). It names the
    `memory-retro` skill, which is the judgment this check cannot make. An
    engram that does not answer is one line saying so, never a failure.

Clean prints NOTHING and exits 0. A finding exits 3. It writes nothing, ever.
The owner of each kind of fact: docs/brief-and-memory.md § Memory.
"""
import datetime
import json
import os
import re
import subprocess
import sys
import tempfile

MARKER = re.compile(r"\b(OBSOLETA|OBSOLETO|OBSOLETE|REVERTIDA|REVERTIDO|REVERTED|"
                    r"SUPERSEDED|REEMPLAZADA|REEMPLAZADO|RETIRADA|RETIRADO)\b")
BANNER = re.compile(r"^\s*(\*\*)?(\[)?(Reemplazad[ao]|Superseded|SUPERSEDED|OBSOLET[AOE]|Revertid[ao]|REVERTID[AO])\b")
LINK = re.compile(r"\]\(([^)]+\.md)\)")
SLUG = re.compile(r"\[\[([a-z0-9][a-z0-9._-]*)\]\]")
CAP = 3
STOP = set("the and for with that this are its not does when what which how why then than but into out "
           "only never always must should can will would has have had been being was were more most less "
           "each per via about over under after before also still just from your their them they".split())
OVERLAP_MIN_SHARED, OVERLAP_MIN_RATIO = 4, 0.5


def store_key(path):
    # Claude Code names a project's store after its absolute path with every
    # character outside [A-Za-z0-9] turned into a hyphen.
    return re.sub(r"[^A-Za-z0-9]", "-", os.path.realpath(path))


def main_checkout(path):
    # A worktree's sessions load the store of the repository it belongs to
    # (measured 2026-10-02 from work/setup/<task>), so key on the common dir.
    try:
        out = subprocess.run(["git", "-C", path, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                             capture_output=True, text=True).stdout.strip()
    except OSError:
        out = ""
    return os.path.dirname(out) if out.endswith("/.git") else path


def harness_roots(root):
    roots = [main_checkout(root)]
    try:
        lanes = json.load(open(os.path.join(root, "projects.json"))).get("lanes", {})
    except (OSError, ValueError):
        lanes = {}
    for lane in (lanes.values() if isinstance(lanes, dict) else []):
        co = (lane.get("checkout") or "").strip() if isinstance(lane, dict) else ""
        if co:
            co = main_checkout(os.path.expanduser(co)) if os.path.isdir(os.path.expanduser(co)) else ""
            if co and co not in roots:
                roots.append(co)
    return roots


def first_body_line(path):
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    m = re.match(r"---\n.*?\n---\n", text, re.S)
    body = text[m.end():] if m else text
    for line in body.splitlines():
        if line.strip():
            return line
    return ""


def short(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path.startswith(home + os.sep) else path


def frontmatter(path):
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return ""
    m = re.match(r"---\n(.*?)\n---\n", text, re.S)
    return m.group(1) if m else ""


def words(text):
    return {w for w in re.findall(r"[a-záéíóúñ0-9][a-záéíóúñ0-9_-]{3,}", text.lower()) if w not in STOP}


def description(fm):
    m = re.search(r"^description:\s*(.*)$", fm, re.M)
    return m.group(1).strip().strip("\"'") if m else ""


def check_file(name, fm, today):
    """Why this memory file fails the type/expiry contract, or None."""
    typ = re.search(r"^\s*type:\s*(\S+)", fm, re.M)
    kind = typ.group(1).strip("\"'") if typ else ""
    if not kind:  # MUTATION-ANCHOR: 660-M06
        return "no type"
    if kind == "project":
        exp = re.search(r"^\s*expires:\s*(\d{4}-\d\d-\d\d)", fm, re.M)
        date = exp.group(1) if exp else ""
        if not date:  # MUTATION-ANCHOR: 660-M07
            return "project without expires"
        if date and date < today:  # MUTATION-ANCHOR: 660-M08
            return "expired " + date
    return None


def rule_lines(root):
    """(label, word set) of each live decisions.md heading and CLAUDE.md line."""
    out = []
    names = ["CLAUDE.md", "CLAUDE.shared.md"]
    for lane in sorted(os.listdir(root)):
        names += [os.path.join(lane, "CLAUDE.md"), os.path.join(lane, "decisions.md")]
    for rel in names:
        path = os.path.join(root, rel)
        if not os.path.isfile(path):
            continue
        for n, line in enumerate(open(path, encoding="utf-8", errors="replace"), 1):
            if rel.endswith("decisions.md") and not line.startswith("#"):
                continue
            w = words(line)
            if len(w) >= OVERLAP_MIN_SHARED:
                out.append(("%s:%d" % (rel, n), w))
    return out


def overlap(desc, lines):
    """The rule line a description repeats most, or None. The measure is the
    share of the SHORTER side's words found in the other, so a long heading
    that merely contains a memory's few words does not count."""
    d = words(desc)
    best, where = 0.0, None
    for label, w in lines:
        shared = len(d & w)
        ratio = shared / min(len(d), len(w)) if d and w else 0.0
        if shared >= OVERLAP_MIN_SHARED and ratio >= OVERLAP_MIN_RATIO and ratio > best:  # MUTATION-ANCHOR: 660-M09
            best, where = ratio, label
    return where


def engram_line(binary, label):
    """One part for the audit line, or None when engram is within its thresholds."""
    pending_max = int(os.environ.get("HW_ENGRAM_PENDING_MAX") or 100)
    nokey_max = int(os.environ.get("HW_ENGRAM_NOKEY_MAX") or 30)
    # the CLI creates its store when it finds none: a machine that never ran engram has nothing to audit, and an audit must not leave one
    data = os.environ.get("ENGRAM_DATA_DIR") or os.path.expanduser("~/.engram")
    if not os.path.exists(os.path.join(data, "engram.db")):  # MUTATION-ANCHOR: 660-M16
        return None
    try:
        st = subprocess.run([binary, "conflicts", "stats", "--project", label], capture_output=True, text=True,
                            timeout=30)
        m = re.search(r"judgment_status:.*?pending:\s*(\d+)", st.stdout, re.S)
        if st.returncode != 0 or not m:
            raise ValueError("conflicts stats gave no pending count")
        pending = int(m.group(1))
        with tempfile.TemporaryDirectory() as tmp:
            dump = os.path.join(tmp, "export.json")
            subprocess.run([binary, "export", dump, "--project", label], capture_output=True, text=True,
                           timeout=60, check=True)
            obs = [o for o in json.load(open(dump)).get("observations", []) if not o.get("deleted_at")]
    except FileNotFoundError:
        return None  # MUTATION-ANCHOR: 660-M15 — no engram on this machine is not an engram that failed to answer
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        return "engram did not answer (%s): conflicts and topic_key not audited" % (str(e).splitlines() or [type(e).__name__])[0][:60]  # MUTATION-ANCHOR: 660-M14
    nokey = sum(1 for o in obs if not o.get("topic_key"))
    pct = 100 * nokey // len(obs) if obs else 0
    bits = []
    if pending > pending_max:  # MUTATION-ANCHOR: 660-M10
        bits.append("%d pending conflicts (over %d)" % (pending, pending_max))
    if pct > nokey_max:  # MUTATION-ANCHOR: 660-M11
        bits.append("%d%% of %d observations without topic_key (over %d%%)" % (pct, len(obs), nokey_max))
    return "engram: %s — run the memory-retro skill" % ", ".join(bits) if bits else None


def main(argv):
    root = os.path.realpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
    try:
        budget = int(os.environ.get("HW_MEMORY_INDEX_BUDGET") or 15000)
    except ValueError:
        budget = 15000
    cfgs = []
    engram = os.environ.get("HW_ENGRAM_BIN") or "engram"
    engram_label = "brain"
    try:
        file_cap = int(os.environ.get("HW_MEMORY_FILE_CAP") or 60)
    except ValueError:
        file_cap = 60
    while argv:
        flag, argv = argv[0], argv[1:]
        if flag in ("--root", "--config-dir", "--budget-bytes", "--engram", "--engram-project") and argv:
            val, argv = argv[0], argv[1:]
            if flag == "--root":
                root = os.path.realpath(val)
            elif flag == "--config-dir":
                cfgs.append(os.path.expanduser(val))
            elif flag == "--engram":
                engram = val
            elif flag == "--engram-project":
                engram_label = val
            else:
                budget = int(val)
        else:
            sys.stderr.write("usage: memory-audit [--root DIR] [--config-dir DIR]... [--budget-bytes N] [--engram BIN] [--engram-project LABEL]\n")
            return 2
    if not cfgs:
        home = os.path.expanduser("~")
        # Every account, whichever one this process runs under: a brainer on
        # the personal account still owns the default account's stores.
        cfgs = [os.path.join(home, ".claude"), os.path.join(home, ".claude-personal")]
        if os.environ.get("CLAUDE_CONFIG_DIR"):
            cfgs.append(os.path.expanduser(os.environ["CLAUDE_CONFIG_DIR"]))
    cfgs = list(dict.fromkeys(os.path.realpath(c) for c in cfgs if os.path.isdir(c)))

    over, retired, stores = [], [], []
    today = datetime.date.today().isoformat()
    lines = rule_lines(root)
    badfile, orphans, crowded, dupes = [], [], [], []
    for cfg in cfgs:
        for r in harness_roots(root):
            mem = os.path.join(cfg, "projects", store_key(r), "memory")
            idx = os.path.join(mem, "MEMORY.md")
            if not os.path.isfile(idx) or os.path.realpath(mem) in [s for s, _ in stores]:
                continue
            stores.append((os.path.realpath(mem), idx))
            size = os.path.getsize(idx)
            if size > budget:  # MUTATION-ANCHOR: 660-M01
                over.append("%s %d B" % (short(idx), size))
            index_text = open(idx, encoding="utf-8", errors="replace").read()
            files = sorted(f for f in os.listdir(mem) if f.endswith(".md") and f != "MEMORY.md")
            if len(files) > file_cap:  # MUTATION-ANCHOR: 660-M12
                crowded.append("%s %d files" % (short(mem), len(files)))
            for f in files:
                if "(%s)" % f not in index_text:  # MUTATION-ANCHOR: 660-M13
                    orphans.append("%s:%s" % (short(idx), f[:-3]))
                fm = frontmatter(os.path.join(mem, f))
                why = check_file(f, fm, today)
                if why:
                    badfile.append("%s (%s)" % (f[:-3], why))
                twin = overlap(description(fm), lines)
                if twin:
                    dupes.append("%s ~ %s" % (f[:-3], twin))
            for line in index_text.splitlines():
                m = LINK.search(line)
                name = m.group(1) if m else ""
                why = None
                if MARKER.search(line):  # MUTATION-ANCHOR: 660-M02
                    why = "marked"
                elif name and not os.path.isabs(name):
                    first = first_body_line(os.path.join(mem, name))
                    if first is None:
                        why = "file missing"
                    elif BANNER.match(first):  # MUTATION-ANCHOR: 660-M03
                        why = "file says superseded"
                if why:
                    retired.append("%s:%s (%s)" % (short(idx), name[:-3] if name else line[:40], why))

    known = set()
    for mem, _ in stores:
        known.update(f[:-3] for f in os.listdir(mem) if f.endswith(".md"))
    try:
        tracked = subprocess.run(["git", "-C", root, "ls-files"], capture_output=True, text=True).stdout
    except OSError:
        tracked = ""
    for f in tracked.splitlines():
        base = os.path.basename(f)
        known.update((base, os.path.splitext(base)[0]))
    dangling = []
    for lane in sorted(os.listdir(root)):
        dec = os.path.join(root, lane, "decisions.md")
        if not os.path.isfile(dec):
            continue
        for n, line in enumerate(open(dec, encoding="utf-8", errors="replace"), 1):
            for slug in SLUG.findall(line):
                if slug not in known:  # MUTATION-ANCHOR: 660-M04
                    dangling.append("%s/decisions.md:%d [[%s]]" % (lane, n, slug))

    parts = []
    if over:
        parts.append("%d index(es) over %d B: %s" % (len(over), budget, ", ".join(over[:CAP])))
    if retired:
        more = " …+%d" % (len(retired) - CAP) if len(retired) > CAP else ""
        parts.append("%d retired entr%s still indexed: %s%s"
                     % (len(retired), "y" if len(retired) == 1 else "ies", ", ".join(retired[:CAP]), more))
    if dangling:
        more = " …+%d" % (len(dangling) - CAP) if len(dangling) > CAP else ""
        parts.append("%d [[slug]] in decisions.md resolve nowhere: %s%s"
                     % (len(dangling), ", ".join(dangling[:CAP]), more))
    if badfile:
        more = " …+%d" % (len(badfile) - CAP) if len(badfile) > CAP else ""
        parts.append("%d memory file(s) break the type/expires contract: %s%s" % (len(badfile), ", ".join(badfile[:CAP]), more))
    if orphans:
        more = " …+%d" % (len(orphans) - CAP) if len(orphans) > CAP else ""
        parts.append("%d memory file(s) not in the index: %s%s" % (len(orphans), ", ".join(orphans[:CAP]), more))
    if crowded:
        parts.append("over %d memory files: %s" % (file_cap, ", ".join(crowded[:CAP])))
    if dupes:
        more = " …+%d" % (len(dupes) - CAP) if len(dupes) > CAP else ""
        parts.append("%d memory file(s) repeat a rule that has an owner: %s%s" % (len(dupes), ", ".join(dupes[:CAP]), more))
    eng = engram_line(engram, engram_label)
    if eng:
        parts.append(eng)
    if not parts:
        return 0
    print("memory indexes  " + "; ".join(parts) + " — docs/brief-and-memory.md § Memory")
    return 3


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
