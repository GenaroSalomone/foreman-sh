#!/usr/bin/env python3
"""release-check — one line when a newer foreman-sh release exists, else nothing.

    release-check BRAIN

Reads the version `install.sh` recorded in BRAIN/.foreman/install.json and the
newest release's tag, and prints a single line when the release is newer. It
asks at most once a day: the answer (or the failure to get one) is cached in
BRAIN/.foreman/latest-release.json. Offline, unreadable or unwritable is
silence and exit 0 — `hw status` calls it and must never fail or wait on it.
A brain with no record (made before `upgrade` existed) is never asked about.
FOREMAN_SH_NO_UPDATE_CHECK=1 turns it off; FOREMAN_SH_LATEST_URL (JSON with
`tag_name`) overrides where the newest release is looked up; the record
install.sh wrote names the default (`latest_url`), so no repository is named here.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time

DAY = 24 * 3600
SEMVER = re.compile(r"^v?(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?$")


def key(v):
    m = SEMVER.match(v or "")
    if not m:
        return None
    pre = m.group(4)
    # a release outranks its own pre-releases; pre-release identifiers compare field by field
    ids = () if pre is None else tuple((0, int(p), "") if p.isdigit() else (1, 0, p) for p in pre.split("."))
    return (int(m.group(1)), int(m.group(2)), int(m.group(3)), pre is None, ids)


def load(path):
    try:
        with open(path) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def fetch(url):
    if not url:
        return ""
    try:
        out = subprocess.run(["curl", "-fsSL", "--max-time", "3", url], capture_output=True, timeout=5, check=True).stdout
        tag = json.loads(out)["tag_name"]
        return tag if SEMVER.match(tag) else ""
    except Exception:
        return ""


def how(brain):
    """The command that upgrades this install: foreman-sh only where Homebrew put it on PATH."""
    if shutil.which("foreman-sh"):
        return "foreman-sh"
    src = load(os.path.join(brain, ".brain-install.json")).get("installed_from") or ""
    if src.startswith(("http://", "https://")):
        return "curl -fsSL %s/raw/HEAD/install.sh | bash -s --" % src.rstrip("/")
    if src and os.path.isfile(os.path.join(src, "install.sh")):
        return os.path.join(src, "install.sh")
    return "install.sh"


def main(argv):
    if len(argv) != 2 or os.environ.get("FOREMAN_SH_NO_UPDATE_CHECK") == "1":
        return 0
    state = os.path.join(argv[1], ".foreman")
    record = load(os.path.join(state, "install.json"))
    have = record.get("version", "")
    if key(have) is None:
        return 0
    cache_path = os.path.join(state, "latest-release.json")
    cache = load(cache_path)
    now = time.time()
    checked = cache.get("checked_at")
    if isinstance(checked, (int, float)) and 0 <= now - checked < DAY:
        tag = cache.get("tag") or ""
    else:
        tag = fetch(os.environ.get("FOREMAN_SH_LATEST_URL") or record.get("latest_url"))
        try:
            with open(cache_path + ".tmp", "w") as f:
                json.dump({"checked_at": int(now), "tag": tag}, f)
            os.replace(cache_path + ".tmp", cache_path)
        except OSError:
            pass
    if tag and key(tag) > key(have):
        print("foreman-sh %s is out (this brain has %s): %s upgrade --brain %s" % (tag, have, how(argv[1]), argv[1]))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception:
        sys.exit(0)
