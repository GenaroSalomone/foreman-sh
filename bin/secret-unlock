#!/usr/bin/env bash
# secret-unlock — unlock Bitwarden once a day, in a plain terminal.
#
#   secret-unlock [--hours N]   bw prompts for the master password; the session
#                               token goes to ~/.cache/hw/bw-session (0600)
#   secret-unlock --lock        bw lock, and the session file is removed
#
# The logic lives in bin/hw-secret (one owner of the session file); this is its
# name for a person's hands. Nothing secret is printed.

# ── hw-core: this tool as a Go binary (core/wrappers*.go; the switch is bin/wrapper-go.sh). THE DEFAULT IS BASH: the bash below is the rollback ──
_wg_prog=secret-unlock; _wg_src="${BASH_SOURCE[0]}"
while [ -L "$_wg_src" ]; do _wg_d="$(cd -P "$(dirname "$_wg_src")" && pwd)"; _wg_src="$(readlink "$_wg_src")"; case "$_wg_src" in /*) ;; *) _wg_src="$_wg_d/$_wg_src" ;; esac; done
_wg_bin="$(cd -P "$(dirname "$_wg_src")" && pwd)"
[ ! -f "$_wg_bin/wrapper-go.sh" ] || . "$_wg_bin/wrapper-go.sh"
unset _wg_prog _wg_src _wg_d _wg_bin
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
exec "$(cd -P "$(dirname "$src")" && pwd)/hw-secret" unlock "$@"
