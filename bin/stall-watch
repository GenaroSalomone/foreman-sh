#!/usr/bin/env bash
# stall-watch <run-state-dir> <turn-count> <what-it-waits-on>
#
# THE TIMER FOR AN EXECUTOR THAT ENDED ITS TURN LEGALLY AND WENT QUIET: waiting on a background child, on a reply to its ask/challenge, or on
# a human-boundary. `hw executor-turn-end` (core/t3_turnend.go) starts one, detached, at each such turn end; nobody else wakes after N
# minutes, because nobody polls (2026-10-29: a product executor sat 17 h behind an orphaned hand-made lock, `hw status` said `working`).
#
# It sleeps HW_STALL_POLL (30 s) at a time and ends silently when the wait is over: a NEW turn (the `turns` count moved), the
# task reported (`done`), or the pane gone. Still the same turn after HW_STALL_MIN (20) minutes (HW_STALL_AFTER_SEC overrides, for
# the subject that holds this file, tests/1141): it writes `<run-state-dir>/stalled` (`<epoch> <turns>`: `hw status` shows
# `STALLED since HH:MM`; the next turn end removes it), one line in ~/.cache/hw/stall-alerts.log, and, with HW_INVOKER_PANE set,
# `channel-send --report`s the pane. ONE alert per stall: the marker names the turn it alerted for, and a later watcher of the
# same turn finds it and stays quiet. A long legitimate wait (a heavy run, an unanswered ask) alerts too: the message says to look, not that it is dead.
#
# Since 2026-11-10 this is a shim: the watcher is `hw-core stall-watch` (core/wrappers_stall_watch.go, tests in
# core/wrappers_stall_watch_test.go and setup/tests/1141). It stays a file because hw-core starts it by this path, so
# the same command works from a checkout that has not built hw-core yet, with the same message.
set -euo pipefail

# ── the Go implementation: hw-core (core/wrappers_stall_watch.go)
# The bash body is gone: this file keeps the name (the interface, setup/release-standard.md «Versioning») and execs
# `hw-core stall-watch` with the same argv, stdin and environment. A `stall-watch=bash` word in ~/.config/hw/impl is retired: bin/impl-retired.sh says so
# once and Go runs. hw-core is HW_CORE (a seam of the suite, never rebuilt), else beside this file, else core/dist/<os>-<arch>/
# (setup/build-core builds it); one not built or older than core/'s sources is rebuilt by bin/core-rebuild when a toolchain is on PATH.
set -euo pipefail
_t_src="${BASH_SOURCE[0]}"
while [ -L "$_t_src" ]; do
  _t_dir="$(cd -P "$(dirname "$_t_src")" && pwd)" || break
  _t_src="$(readlink "$_t_src")" || break
  case "$_t_src" in /*) ;; *) _t_src="$_t_dir/$_t_src" ;; esac
done
_t_bin="$(cd -P "$(dirname "$_t_src")" 2>/dev/null && pwd)"
[ ! -r "$_t_bin/impl-retired.sh" ] || { . "$_t_bin/impl-retired.sh"; impl_retired_warn stall-watch; }
_t_core=""
if [ -n "${HW_CORE:-}" ]; then
  [ ! -x "$HW_CORE" ] || _t_core="$HW_CORE"
else
  _t_os="$(uname -s | tr 'A-Z' 'a-z')"; _t_arch="$(uname -m)"
  case "$_t_arch" in x86_64) _t_arch=amd64 ;; aarch64|arm64) _t_arch=arm64 ;; esac
  for _t_c in "$_t_bin/hw-core" "$_t_bin/../core/dist/$_t_os-$_t_arch/hw-core"; do
    if [ -x "$_t_c" ]; then _t_core="$_t_c"; break; fi
  done
  if [ -n "$_t_core" ] && [ -d "$_t_bin/../core" ] \
     && [ -n "$(find "$_t_bin/../core" -path '*/dist' -prune -o \( -name '*.go' -o -name '*.txt' -o -name go.mod \) -newer "$_t_core" -print -quit 2>/dev/null)" ]; then
    _t_msg="$("$_t_bin/core-rebuild" "$_t_bin" "$_t_core" stall-watch 2>&1)" || :   # stale: rebuilt (bin/core-rebuild), or the old one runs with one line
    [ -z "$_t_msg" ] || printf 'stall-watch: %s\n' "$_t_msg" >&2
  fi
fi
if [ -n "$_t_core" ]; then
  HW_WRAPPER_ARGV0="$0" HW_CORE_BIN_DIR="$_t_bin" exec "$_t_core" stall-watch "$@"
fi
printf 'stall-watch: hw-core is not built: run setup/build-core --native (it needs Go 1.22 or newer, https://go.dev/dl)\n' >&2
exit 1
