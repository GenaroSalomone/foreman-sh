# ── the touched subjects of seconds run before the commit, and a red one refuses it ─────────────────────────────────────────────
# commit-tree runs no hook, so a commit that broke a subject learned it from a gate, late: 540 went red about 30 minutes after a commit, 1334 two
# hours after it first sat in the touched list, and 207 stayed red about 29 h after install.sh changed (retro-fixes-1111c). Same selector the
# executor's verify uses (setup/gate-select: the fast subjects that name a named path, and the slow ones `touched` lists), run over THIS commit's
# paths. A subject budgeted at 20 s or less runs here (cheapest first, up to 180 budgeted seconds), and a red one refuses the commit; the slower ones
# are LISTED, not run: they stay the batch gate's. The bytes are the working tree's, which for a named path are the ones being committed. A repo with
# no gate-select or budget table (a fixture) is not asked.
# A COMMIT MUST NEVER HANG ON THIS (brainer's ruling, same day): the memory guard SIGSTOPs a tree when free memory is under 26%, and a frozen
# subject made the first version of this check wait for minutes. Each subject therefore runs in its own session under a wall limit (its budget, at
# least 20 s), the whole check under a wall allowance (150 s), and a subject that times out is KILLED and listed as NOT RUN (frozen/timeout), never
# counted as red; after the first timeout the rest are not started (the machine is frozen or slow, and another try would only wait again).
# Subjects run from a scratch directory, so one that writes into its cwd leaves nothing in the worktree.
CT_SUBJECT_MAX_S=20     # a subject budgeted above this is listed, never run here
CT_SUBJECT_ALLOW_S=180  # budgeted seconds this check may spend in one commit
CT_SUBJECT_FLOOR_S="${COMMIT_TREE_SUBJECT_FLOOR_S:-20}"  # the wall limit of one subject is its budget, never less than this
CT_SUBJECT_WALL_S="${COMMIT_TREE_SUBJECT_WALL_S:-150}"   # the wall the whole check may take
ct_run_bounded() { # <limit s> <cwd> <subject file> <out file> → the subject's exit; 124 when the limit killed it (its whole session, stopped or not)
  python3 -I -c '
import os, signal, subprocess, sys
lim, cwd, subj, out = float(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
with open(out, "wb") as f:
    p = subprocess.Popen(["nice", "-n", "10", "bash", subj], cwd=cwd, stdin=subprocess.DEVNULL, stdout=f, stderr=subprocess.STDOUT, start_new_session=True)
    try:
        sys.exit(p.wait(timeout=lim))
    except subprocess.TimeoutExpired:
        for sig in (signal.SIGCONT, signal.SIGKILL):
            try: os.killpg(p.pid, sig)
            except OSError: pass
        p.wait()
        sys.exit(124)' "$1" "$2" "$3" "$4"
}
ct_subjects_check() {
  [ -f "$root/setup/gate-select" ] && [ -f "$root/setup/suite-data/test-budgets.json" ] && [ -f "$root/setup/hooks/suite-trigger-pattern.sh" ] || return 0
  local changed trigger names n secs plan run=() runsecs=() later=() red=() spent=0 out rc first i limit scratch t0 timedout=0 ran=0
  changed="$(mktemp "${TMPDIR:-/tmp}/commit-tree-changed.XXXXXX")" || return 0
  printf '%s\n' "${paths[@]}" > "$changed"
  trigger="$(bash -c '. "$1" && printf %s "$SUITE_TRIGGER_PATTERN"' _ "$root/setup/hooks/suite-trigger-pattern.sh" 2>/dev/null)" || trigger=""
  names="$( { env -u HW_TASK python3 -I "$root/setup/gate-select" "$root" "$changed" "$trigger" 2>/dev/null | awk '$1 == "subject" { print $2 }'
              env -u HW_TASK python3 -I "$root/setup/gate-select" "$root" "$changed" "$trigger" touched 2>/dev/null | awk '$1 == "touched" || $1 == "touched-skipped" { print $2 }'; } | sort -u)"
  rm -f "$changed"
  [ -n "$names" ] || return 0
  plan="$(printf '%s\n' "$names" | python3 -I -c '
import json, sys
b = json.load(open(sys.argv[1]))["files"]
for n in sorted((l.strip() for l in sys.stdin if l.strip()), key=lambda n: (b.get(n, {}).get("seconds", 1e9), n)):
    print("%s\t%s" % (n, b[n]["seconds"] if n in b else "?"))' "$root/setup/suite-data/test-budgets.json")" || return 0
  while IFS=$'\t' read -r n secs; do
    [ -f "$root/setup/tests/$n" ] || continue
    if [ "$secs" = "?" ] || ! awk -v s="$secs" -v m="$CT_SUBJECT_MAX_S" 'BEGIN { exit !(s + 0 <= m + 0) }'; then  # MUTATION-ANCHOR: 1354-M02
      later+=("$n (${secs} s)")
    elif ! awk -v t="$spent" -v s="$secs" -v m="$CT_SUBJECT_ALLOW_S" 'BEGIN { exit !(t + s <= m) }'; then
      later+=("$n (${secs} s, over this commit's ${CT_SUBJECT_ALLOW_S} s allowance)")
    else
      spent="$(awk -v t="$spent" -v s="$secs" 'BEGIN { print t + s }')"; run+=("$n"); runsecs+=("$secs")
    fi
  done <<< "$plan"
  scratch="$(mktemp -d "${TMPDIR:-/tmp}/commit-tree-subjects.XXXXXX")" || return 0
  t0="$(date +%s)"
  i=-1
  while [ $((i += 1)) -lt "${#run[@]}" ]; do
    n="${run[$i]}"
    if [ "$timedout" = 1 ]; then later+=("$n (${runsecs[$i]} s, not started: an earlier subject timed out, the machine is frozen or slow)"); continue; fi
    if [ $(( $(date +%s) - t0 )) -ge "$CT_SUBJECT_WALL_S" ]; then later+=("$n (${runsecs[$i]} s, not started: this check's ${CT_SUBJECT_WALL_S} s wall allowance is spent)"); continue; fi
    limit="$(awk -v s="${runsecs[$i]}" -v f="$CT_SUBJECT_FLOOR_S" 'BEGIN { printf "%d", (s + 0 > f + 0 ? s : f) + 0.999 }')"
    out="$scratch/out.$i"; mkdir -p "$scratch/cwd.$i"
    rc=0; ct_run_bounded "$limit" "$scratch/cwd.$i" "$root/setup/tests/$n" "$out" || rc=$?
    ran=$((ran + 1))
    if [ "$rc" -eq 124 ]; then  # MUTATION-ANCHOR: 1354-M03
      timedout=1; later+=("$n (${runsecs[$i]} s, FROZEN/TIMEOUT: killed after ${limit} s)"); ran=$((ran - 1))
    elif [ "$rc" -ne 0 ]; then  # MUTATION-ANCHOR: 1354-M01
      first="$(grep -m1 '^not ok' "$out" | cut -c1-200)"
      red+=("$n (exit $rc)${first:+: $first}")
    fi
  done
  rm -rf "$scratch"
  [ "$ran" -eq 0 ] || printf 'commit-tree: ran %s touched subject(s) of seconds%s\n' "$ran" "$([ "${#red[@]}" -eq 0 ] && printf ', all green')" >&2
  [ "${#later[@]}" -eq 0 ] || printf 'commit-tree: NOT RUN here (they stay the batch gate'"'"'s): %s\n' "$(printf '%s; ' "${later[@]}")" >&2
  [ "${#red[@]}" -eq 0 ] || ct_refuse "a subject this commit touches is red, so it would be red in the batch gate hours later. The ref was not moved.
$(printf '    %s\n' "${red[@]}")
Run it alone for the whole output: bash setup/tests/<n>-*.sh. Is the red the branch's or the base's: bash setup/test-hw --base \"\$(git merge-base HEAD main)\" setup/tests/<n>-*.sh"
}
ct_subjects_check

# ── a test number another branch already owns is WARNED, never refused ─────────────────────────────
# Same warning setup/hooks/pre-commit prints for `git commit`, which this tool never runs: three setup/tests/1262-* reached main
# because parallel branches each saw the number free. A NEW named setup/tests/N-*.sh is compared with main and every local task/*
# branch (the tree each one holds, not the working checkout); this branch's own ref is skipped.
ct_number_warn() {
  local p num ref clash
  for p in "${paths[@]}"; do
    case "$p" in setup/tests/[0-9]*-*.sh) ;; *) continue ;; esac
    git cat-file -e "$old:$p" 2>/dev/null && continue
    num="${p#setup/tests/}"; num="${num%%-*}"
    for ref in refs/heads/main $(git for-each-ref --format='%(refname)' refs/heads/task/ 2>/dev/null); do
      [ "$ref" = "$full" ] && continue
      git rev-parse --verify -q "$ref^{tree}" >/dev/null 2>&1 || continue
      clash="$(git ls-tree -r --name-only "$ref" -- setup/tests/ 2>/dev/null | grep -E "^setup/tests/${num}-[^/]*\.sh$" | grep -vxF "$p" | head -1 || true)"
      [ -z "$clash" ] || printf 'commit-tree: WARNING: %s takes test number %s, and %s already has %s under that number. Two subjects with one number collide at the merge; take the next free one. (A warning, not a refusal.)\n' "$p" "$num" "${ref#refs/heads/}" "$clash" >&2
    done
  done
}
ct_number_warn  # MUTATION-ANCHOR: 1270-M01

# ── the commit, then the guarded move of the ref ────────────────────────────
if [ -n "$msgfile" ]; then
  commit="$(git commit-tree "$tree" -p "$old" -F "$msgfile")" || ct_refuse "git commit-tree failed"
else
  commit="$(git commit-tree "$tree" -p "$old" -m "$msg")" || ct_refuse "git commit-tree failed"
fi

# update-ref's expected old value is the guard: it refuses if $full moved since
# the tree was read, so a second read-and-compare here would be dead code.
git update-ref -m "commit-tree" "$full" "$commit" "$old" \
  || ct_refuse "$full moved while the commit was being made ($old); the commit $commit was NOT written to it. The ref was not moved."

# ── the real index, for the named paths only ────────────────────────────────
# Only when the ref is the branch this worktree has checked out: resetting paths
# against any other branch would stage them relative to a tree they never came
# from. GIT_LITERAL_PATHSPECS keeps a name with glob characters literal.
if [ "$(git symbolic-ref -q HEAD)" = "$full" ]; then
  GIT_LITERAL_PATHSPECS=1 git reset -q -- "${paths[@]}" 2>/dev/null || true
fi

printf '%s\n' "$commit"
