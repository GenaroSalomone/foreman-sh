#!/usr/bin/env python3
"""gate-select — which fast-gate subjects a set of changed paths can reach.

    python3 setup/gate-select <root> <changed-paths-file> [<trigger-regex>]

<changed-paths-file> holds one repo-relative path per line (what pre-commit
stages). The answer is printed one fact per line, for setup/test-hw and
setup/hooks/pre-commit to read:

    all <why>              run the WHOLE fast gate (a path this cannot map)
    subject <name> <path>  a fast subject, and the first changed path reaching it
    core <name>            a subject that declares `# gate-core:` (always runs)
    guards <path>          run the guard drivers too (a guard changed)
    deferred <name>        a changed SLOW subject: not in the fast gate, as today

With `touched` as the fourth argument it answers instead which SLOW subjects
name a changed path — those that spell it whole first (narrowest path first), then bare-word, then closure; cheapest within —
cut at touched_budget_seconds:

    touched <name> <path>                  run it beside the fast gate
    touched-skipped <name> <secs> <path>   over the budget: left to the full run

    A subject of seconds (`touched_cheap_seconds`, default 15) is never cut, and the cap spends itself cheapest-first,
    so the subjects it cuts are the slowest.

    (`# gate-when-body: <regex>` selects a subject when a CHANGED SUBJECT's text matches: 1004, for every one that builds a mutant)

    reference <name> <path>  a SLOW subject that declares `# gate-reference:` and
                           names a changed path, or `# gate-when: <regex>` and
                           a changed path matches: it runs beside the selection

A subject that declares `# gate-reference:` compares against a reference output
(a golden, the previous installer) that goes stale whenever what it names
changes. Those are the reds a branch is likeliest to push and the full suite
likeliest to find: 174 and 491 three times in two days, 207 once. They are
expensive, so cheapest-first cut every one of them; a declared one that names a
changed path is now taken first and never cut.

WHY IT IS DERIVED AND NOT DECLARED. 104 subjects with a hand-kept `# covers:`
line each is 104 lists that go stale in silence, and a stale one
UNDER-selects: the only direction here that loses a red. What a subject
reaches is already written in it: the paths and command names it runs or
reads. So a subject is selected when its own text — plus the top of
tests/_common.sh, which every subject sources, plus the bodies of the
_common.sh helpers it calls — names a changed path or anything that reaches it.

"ANYTHING THAT REACHES IT" is a closure over the code: a changed
`bin/project-spaces.sh` is reached by every script whose text names
`project-spaces.sh`, and a subject that runs any of those is selected. Names
match as bare words (`hw status` counts, not only `bin/hw`), comments
excluded. Every imprecision in that rule over-selects, which costs seconds;
none of it under-selects a subject whose text names what it runs.

WHAT IT CANNOT SEE, AND THE ANSWER FOR IT: a path built at runtime
(`"$ROOT/bin/$tool"`) names nothing. So a TRIGGER path (the suite's own
pattern, setup/hooks/suite-trigger-pattern.sh) that reaches NO fast subject
is not "nothing to run": it is `all`, the whole fast gate of today. The
runner's own machinery (setup/test-hw and what it loads, and everything under
setup/tests/ that is not a subject) is `all` by rule.

A path OUTSIDE the trigger (a README, CLAUDE.md, an export overlay) never ran
the gate and never makes it `all`: it adds only the subjects that name it by
its exact repo-relative path — the ones that read that document.
"""
import fnmatch
import json
import os
import re
import sys

SUBJECT = re.compile(r"^setup/tests/[0-9][0-9]*-[^/]*\.sh$")
# The runner and everything it loads: a change here can move any verdict.
RUNNER = re.compile(
    r"^setup/(test-hw|test-hw-snapshot\.py|fast-gate-budget\.sh|suite-data/test-budgets\.json"
    r"|mutation/mutation-coverage|gate-select|suite-data/retired-subjects\.txt|go-test-core\.sh)$|^setup/tests/")
GUARD = re.compile(
    r"^setup/guards/|^([^/]+/)?\.claude/hooks/deny-repo-writes\.py$"
    r"|^([^/]+/)?\.opencode/plugin/deny-repo-writes\.js$")
# Where the code a subject can run lives: the closure is taken over these.
CODE_DIRS = ("bin", "lib", "setup", "lanes", "shell", ".claude", ".opencode")
CODE_SKIP = re.compile(
    r"^setup/(tests|decisions|briefs|evidence|baselines|plans|export/overlay)/"
    r"|\.(md|timeline|png|svg|jpg|gif|pdf)$|^setup/decisions\.md$")
ROOT_FILES = ("projects.json", "guards.json")
COMMENT = re.compile(r"^\s*(#(?!!)|//).*$", re.M)
# A TABLE a helper names for everyone: `mutate_anchor` (tests/_common.sh) reads the anchors registry, so every subject that builds a
# mutant "names" it through the helper body, and an edit to one row selected 12 slow subjects (2285 s, no red of the branch's,
# retro-fixes-1111b). 540 judges the table (each id once in its file, each marker registered, each id used); a subject answers for a
# table only when its OWN text spells it, never through a helper.
TABLES = ("setup/mutation/mutation-anchors.tsv",)


def own_names(root, pool, path):
    """The subjects of <pool> whose own text (no helper, no _common.sh top level) spells <path>."""
    tests = os.path.join(root, "setup", "tests")
    return [n for n in pool if path in COMMENT.sub("", read(os.path.join(tests, n)))]


def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def retired_globs(root):
    """The globs of setup/suite-data/retired-subjects.txt: subjects no gate runs (a missing file retires none).

    The same format setup/test-hw reads: the first word of a line is a shell glob over the subject's file
    name, the rest is why; blank and `#` lines are ignored."""
    globs = []
    for line in read(os.path.join(root, "setup", "suite-data", "retired-subjects.txt")).split("\n"):
        words = line.split()
        if words and not words[0].startswith("#"):
            globs.append(words[0])
    return globs


def is_retired(name, globs):
    return any(fnmatch.fnmatchcase(name, g) for g in globs)  # MUTATION-ANCHOR: 1013-M01


def code_text(path):
    return COMMENT.sub("", read(path))


def names(text, word):
    """<word> as a bare name: not glued to another name on either side."""
    return re.search(r"(?<![A-Za-z0-9_.-])" + re.escape(word)
                     + r"(?![A-Za-z0-9_-]|\.[A-Za-z0-9])", text) is not None


def nested_checkout(path):
    """<path> is another checkout (a worktree: `.git` file or dir), not this repo's code.

    Claude Code's agent worktrees live under .claude/worktrees/ in the main
    checkout: full copies of the repo, ~12,000 files. Walking them made every
    selection there read and scan them all (361, 510 and 680 hit their
    ceilings only from the main checkout), and a copy of bin/hw in one counted
    as a code file naming things. A registered worktree carries `.git`; a stale
    leftover dir under .claude/worktrees may not, so that path is skipped too."""
    return (os.path.lexists(os.path.join(path, ".git"))
            or (os.path.basename(path) == "worktrees"
                and os.path.basename(os.path.dirname(path)) == ".claude"))


def universe(root):
    files = {}
    for rel in ROOT_FILES:
        if os.path.isfile(os.path.join(root, rel)):
            files[rel] = code_text(os.path.join(root, rel))
    for top in CODE_DIRS:
        for dirpath, dirnames, filenames in os.walk(os.path.join(root, top)):
            dirnames[:] = [d for d in dirnames if d not in (".git", "node_modules", "__pycache__") and not nested_checkout(os.path.join(dirpath, d))]  # MUTATION-ANCHOR: 998-M01
            for fn in filenames:
                full = os.path.join(dirpath, fn)
                rel = os.path.relpath(full, root)
                if CODE_SKIP.search(rel):
                    continue
                try:
                    if os.path.getsize(full) > 2_000_000:
                        continue
                except OSError:
                    continue
                files[rel] = code_text(full)
    return files


def loads(text, base):
    """<text> SOURCES or IMPORTS a file named <base>: its code runs as part of it.

    <base> is the LAST component of the sourced path: `. "$LIB/hw/deps.sh"` sources deps.sh,
    not a file called hw (the `/` after the name is a directory, so it does not count)."""
    stem = re.escape(re.sub(r"\.(py|js|mjs|sh)$", "", base))
    b = re.escape(base)
    return re.search(
        r"(^|[;&|({\s])(\.|source)\s+[\"']?[^\s\"';]*" + b + r"(?![A-Za-z0-9_./-])"
        r"|\bimport\s+" + stem + r"\b|\bfrom\s+" + stem + r"\s+import\b"
        r"|(require\(|\bfrom\s+|import\()\s*[\"'][^\"']*" + stem + r"(\.m?js)?[\"']",
        text, re.M) is not None


def closure(start, code):
    """start plus every code file that SOURCES or IMPORTS a member, to a fixpoint.

    Only loading counts. A script that RUNS another (`"$BIN_DIR/hw" status`)
    is not in the closure: bin/ calls itself in a ring (hw, done-invoker,
    ask-invoker, brain, lint-shell, ...), and following those calls selected
    86 of 104 subjects for ANY path in bin/ — the gate of today, paid through a
    slower door. A caller's subject that exercises a callee without naming it
    is left to the full suite, the push floor, exactly as the 129 slow
    subjects already are.
    """
    seen = {start}
    todo = [start]
    while todo:
        cur = todo.pop()
        base = os.path.basename(cur)
        for rel, text in code.items():
            if rel not in seen and loads(text, base):
                seen.add(rel)
                todo.append(rel)
    return seen


def common_parts(path):
    """(top-level text, {helper: body}) of tests/_common.sh, comments out."""
    text = code_text(path)
    helpers = {}
    top = []
    lines = text.split("\n")
    i = 0
    while i < len(lines):
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\(\)\s*\{", lines[i])
        if m:
            body = [lines[i]]
            i += 1
            while i < len(lines) and lines[i] != "}":
                body.append(lines[i])
                i += 1
            helpers[m.group(1)] = "\n".join(body)
        else:
            top.append(lines[i])
        i += 1
    return "\n".join(top), helpers


def subject_text(text, top, helpers):
    """The subject, _common.sh's top level, and every helper it reaches."""
    parts = [text, top]
    todo = [h for h in helpers if names(text, h)]
    seen = set(todo)
    while todo:
        body = helpers[todo.pop()]
        parts.append(body)
        for h in helpers:
            if h not in seen and names(body, h):
                seen.add(h)
                todo.append(h)
    return "\n".join(parts)


def header_value(path, key):
    """The text after `# <key>:` in the comment block at the top of the file, or None."""
    for n, line in enumerate(read(path).split("\n")):
        if n == 0 and line.startswith("#!"):
            continue
        if line.startswith("#"):
            m = re.match(r"^# " + re.escape(key) + r":(.*)$", line)
            if m:
                return m.group(1).strip()
            continue
        if line.strip() == "":
            continue
        return None
    return None


def header_declares(path, key):
    """`# <key>:` in the comment block at the top of the file."""
    return header_value(path, key) is not None


def when_hits(root, changed):
    """-> {subject: first changed path matching its `# gate-when: <regex>`}, fast or slow.

    The regex is the header's first word. A subject that judges what OTHER
    files declare (540: every subject's mutation anchors) names none of them,
    so naming cannot select it; this says which paths do, and costs nothing
    when none changed."""
    tests = os.path.join(root, "setup", "tests")
    budgets = json.loads(read(os.path.join(root, "setup", "suite-data", "test-budgets.json")))
    hits = {}
    gone = retired_globs(root)
    for n in budgets["files"]:
        path = os.path.join(tests, n)
        if not os.path.isfile(path) or is_retired(n, gone):
            continue
        spec = (header_value(path, "gate-when") or "").split(None, 1)
        if spec:
            pat = re.compile(spec[0])
            for c in changed:
                if pat.search(c):
                    hits[n] = c
                    break
        # `# gate-when-body: <regex>`: a changed subject whose TEXT matches. 1004 judges every subject that
        # builds a mutant, and a new one (1200) went red only in the full suite; a path regex over every
        # subject would run its 60 s on each edit, the body regex only on the ones that build.
        body = (header_value(path, "gate-when-body") or "").split(None, 1)
        if body and n not in hits:
            pat = re.compile(body[0])
            for c in changed:
                if SUBJECT.match(c) and pat.search(read(os.path.join(root, c))):  # MUTATION-ANCHOR: 999-M04
                    hits[n] = c
                    break
    return hits


def slow_hits(root, changed, trigger):
    """-> ({slow subject: (rank 0 spelled whole / 1 bare word / 2 closure, first changed path naming it, width)}, {slow: seconds}, {those declaring gate-reference})."""
    tests = os.path.join(root, "setup", "tests")
    budgets = json.loads(read(os.path.join(root, "setup", "suite-data", "test-budgets.json")))
    threshold = budgets["fast_gate_threshold_seconds"]
    gone = retired_globs(root)
    slow = {n: v["seconds"] for n, v in budgets["files"].items()
            if v["seconds"] > threshold and os.path.isfile(os.path.join(tests, n)) and not is_retired(n, gone)}
    top, helpers = common_parts(os.path.join(tests, "_common.sh"))
    stext = {n: subject_text(COMMENT.sub("", read(os.path.join(tests, n))), top, helpers)
             for n in slow}
    code = None
    found = {}  # name -> (rank, path, width); width: see below
    spell = {}  # changed path -> the subjects that spell it whole
    for path in changed:
        if SUBJECT.match(path):
            name = os.path.basename(path)
            if name in slow:
                found[name] = (0, path)
                spell.setdefault(path, []).append(name)
            continue
        if path in TABLES:  # MUTATION-ANCHOR: 999-M09
            for n in own_names(root, stext, path):
                spell.setdefault(path, []).append(n)
                if found.get(n, (9,))[0] > 0:
                    found[n] = (0, path)
            continue
        if trigger is not None and trigger.search(path) is None:
            for n, t in stext.items():
                if names(t, path):
                    spell.setdefault(path, []).append(n)
                    if found.get(n, (9,))[0] > 0:
                        found[n] = (0, path)
            continue
        if code is None:
            code = universe(root)
        reach = closure(path, code)
        base = os.path.basename(path)
        for n, t in stext.items():
            # RANK: 0 the subject's text spells the changed path whole; 1 it only names its bare word (`heavy`, `hw`, and `out`
            # for the 311 subjects that read a golden `out` file); 2 it reaches it through the closure. `touched` lists by rank.
            rank = 0 if path in t else 1 if names(t, base) else None
            if rank == 0:
                spell.setdefault(path, []).append(n)
            if rank is not None and found.get(n, (9,))[0] > rank:
                found[n] = (rank, path)
                continue
            if n in found:
                continue
            if any(r in t or names(t, os.path.basename(r)) for r in reach):
                found[n] = (2, path)
    # WIDTH: how many subjects spell the narrowest changed path this one spells. A path 31 subjects spell (test-budgets.json) says
    # little about any one of them; one that 6 spell (setup/heavy) says a lot. A subject that is itself changed, or that a
    # `gate-when` selects, is width 0. `touched` lists by (rank, width, seconds).
    width = {}
    for path, who in spell.items():
        for n in who:
            width[n] = min(width.get(n, len(who)), len(who))
    for n in list(found):
        found[n] = found[n] + (width.get(n, 10 ** 6),)
    for n, (_r, path, _w) in list(found.items()):
        if path in changed and SUBJECT.match(path):
            found[n] = (0, path, 0)
    pinned = {n for n in found if header_declares(os.path.join(tests, n), "gate-reference")}
    for n, path in when_hits(root, changed).items():
        if n in slow:  # a fast one is taken by main(); a slow one runs beside the selection, never cut  # MUTATION-ANCHOR: 999-M01
            found[n] = (0, path, 0)
            pinned.add(n)
    return found, slow, pinned


def touched(root, changed, trigger):
    """The slow subjects that name a changed path: the cheap ones always, the rest cut SLOWEST FIRST.

    A subject that runs in seconds is never cut. Cutting it saves the budget nothing worth the red it prevents, and on
    2026-11-04 (vault-stays-unlocked) the cheapest-first cut took 1009-1012 and 1223 — each 3 to 13 s — while slower
    subjects ran: with the budget spent on cheap ones, the cut landed in name order, not on the expensive tail. Now:
    every subject at or under `touched_cheap_seconds` (default 15) runs whatever is left of the cap, and the cap is
    spent by considering the SLOWEST candidate first, so what gets cut is always the most expensive thing left."""
    budgets = json.loads(read(os.path.join(root, "setup", "suite-data", "test-budgets.json")))
    cap = budgets.get("touched_budget_seconds", 180)
    cheap = float(budgets.get("touched_cheap_seconds", 15))
    found, slow, pinned = slow_hits(root, changed, trigger)
    # INSIDE AN hw EXECUTOR (HW_TASK) THE CAP BINDS THE CHEAP TAIL TOO. The floor above is the brainer's: one shared file
    # (setup/mutation/mutation-anchors.tsv, or a test-budgets.json edit) names about 100 or 20 subjects of 15 s or less, and an
    # executor that ran them all paid a gate for a seconds-long edit (readme-perfect, 2026-11-10). The cheapest still go first.
    kept = {n for n in found if n in pinned or slow[n] <= cheap}  # MUTATION-ANCHOR: 510-T01
    if os.environ.get("HW_TASK"):  # MUTATION-ANCHOR: 510-T03
        kept = {n for n in kept if n in pinned}  # the cheap tail goes through the cap below, cheapest first
    spent = sum(slow[n] for n in kept)  # a pinned subject is never cut, and its cost is still what the run pays
    cut = set()
    # ASCENDING: the cheapest of what is left goes first, so the subjects that end up CUT are the ones that do not fit —
    # the slowest. (The 2026-11-04 defect was the other direction of the same fact: the pinned goldens spent the cap
    # before the 3-13 s subjects were even considered.)
    for n in sorted((n for n in found if n not in kept), key=lambda n: (slow[n], n)):  # MUTATION-ANCHOR: 510-T02
        if spent + slow[n] <= cap:
            spent += slow[n]
            kept.add(n)
        else:
            cut.add(n)
    # DIRECT FIRST. A subject whose own text spells a changed path whole (rank 0) comes before one that names only its bare word
    # (1) and one reached only through the closure (2): on a 236-subject range, 1131 (the subject of the most-edited file) was #230 and 1014 #229, so a reader who cut
    # the list at 60 ran neither, and both went red only in the one-hour gate (foreman-friction-1106, 2026-11-06). Within a
    # rank, the NARROWEST path first (width), then cheapest. Only the ORDER changes: what is kept and what is cut is decided above.
    for n in sorted(found, key=lambda n: (found[n][0], found[n][2], slow[n], n)):
        if n in cut:
            print("touched-skipped %s %s %s" % (n, slow[n], found[n][1]))
        else:
            print("touched %s %s" % (n, found[n][1]))
    return 0


def main(argv):
    if len(argv) < 3:
        print("usage: gate-select <root> <changed-paths-file> [<trigger-regex>]", file=sys.stderr)
        return 2
    root, changed_file = argv[1], argv[2]
    trigger = re.compile(argv[3]) if len(argv) > 3 and argv[3] else None
    changed = [l.strip() for l in read(changed_file).split("\n") if l.strip()]
    if len(argv) > 4 and argv[4] == "touched":
        return touched(root, changed, trigger)
    if not changed:
        print("all no changed paths were named")  # MUTATION-ANCHOR: 1014-M19
        return 0
    tests = os.path.join(root, "setup", "tests")
    budgets = json.loads(read(os.path.join(root, "setup", "suite-data", "test-budgets.json")))
    threshold = budgets["fast_gate_threshold_seconds"]
    gone = retired_globs(root)
    fast = sorted(n for n, v in budgets["files"].items()
                  if v["seconds"] <= threshold and os.path.isfile(os.path.join(tests, n)) and not is_retired(n, gone))
    top, helpers = common_parts(os.path.join(tests, "_common.sh"))
    stext = {n: subject_text(COMMENT.sub("", read(os.path.join(tests, n))), top, helpers)
             for n in fast}
    code = None
    chosen = {}
    guards = []
    all_why = None
    for path in changed:
        triggered = trigger is None or trigger.search(path) is not None
        if SUBJECT.match(path):
            name = os.path.basename(path)
            if is_retired(name, gone):
                continue  # retired: no gate runs it, and it is not "deferred" to a full run that skips it too
            if name in stext:
                chosen.setdefault(name, path)
            else:
                print("deferred %s" % name)
            continue
        if path in TABLES:  # MUTATION-ANCHOR: 999-M08
            for n in own_names(root, stext, path):
                chosen.setdefault(n, path)
            continue
        if RUNNER.search(path):
            all_why = "%s is the runner's own machinery" % path  # MUTATION-ANCHOR: 999-M05
            break
        if GUARD.search(path):
            guards.append(path)
        if not triggered:
            # A document: only the subjects that read it, by its exact path.
            for n, t in stext.items():
                if names(t, path):
                    chosen.setdefault(n, path)
            continue
        if code is None:
            code = universe(root)
        reach = closure(path, code)
        hit = False
        for n, t in stext.items():
            for r in reach:
                if r in t or names(t, os.path.basename(r)):
                    chosen.setdefault(n, path)
                    hit = True
                    break
        if not hit and path not in guards:
            all_why = "%s reaches no fast subject by name" % path
            break
    if all_why:
        # THE GATE-WHEN PASS RUNS BEFORE THE `all` ANSWER (L18). `all` is the whole FAST gate; a slow
        # subject that declares `# gate-when:` — 540, judging every marker in the tree — names no path any
        # other subject names, so this is the only arm that can select it. Returning before the pass meant a
        # `mutants-*`-only commit (a runner path) and a pre-commit `all` never ran 540 at all. slow_hits pins every
        # slow subject whose `# gate-when:` matches or whose `# gate-reference:` names a changed path, as the
        # selected arm below does: a `_common.sh` change carries eleven (seven by gate-reference), any `core/*.go`
        # change 1014 and 540.
        print("all %s" % all_why)
        _found, _slow, pinned = slow_hits(root, changed, trigger)
        for n in sorted(pinned):
            print("reference %s %s" % (n, _found[n][1]))  # MUTATION-ANCHOR: 999-M06
        return 0
    # A subject that declares `# gate-when: <regex>` runs when a changed path
    # matches it (a slow one is taken by slow_hits, as a pinned `reference`).
    for n, path in when_hits(root, changed).items():
        if n in stext:  # MUTATION-ANCHOR: 999-M02
            chosen.setdefault(n, path)
    # The core runs on EVERY selection, including one that reached nothing
    # else (a slow subject, a document nobody reads): whoever called the runner
    # asked for a gate, and the core is the floor of one. Whether to call it at
    # all for such a commit is the caller's (pre-commit asks for `subject` lines).
    for n in fast:
        if header_declares(os.path.join(tests, n), "gate-core"):
            print("core %s" % n)
            chosen.pop(n, None)
    for n in fast:
        if n in chosen:
            print("subject %s %s" % (n, chosen[n]))
    for g in guards:
        print("guards %s" % g)
    # A GOLDEN GOES STALE WHEN WHAT IT NAMES CHANGES, and a selected run is the
    # last gate before the commit: 174 and 491 drifted three times in two days
    # and only the full run, after the merge, saw it. A slow subject that declares
    # `# gate-reference:` and names a changed path runs with the selection, never
    # cut by a budget (the same subjects `touched` pins for the executor's verify).
    _found, _slow, pinned = slow_hits(root, changed, trigger)
    for n in sorted(pinned):
        print("reference %s %s" % (n, _found[n][1]))  # MUTATION-ANCHOR: 714-M01
    return 0


