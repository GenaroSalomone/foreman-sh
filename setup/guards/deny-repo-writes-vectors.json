  {"id": "escaped-backslash-before-newline-is-still-a-boundary", "command": "echo \\\\\nrm -rf {{repo}}/x", "cwd": "{{outside}}", "expect": "deny", "category": "mutator", "trigger": "names"},
  {"id": "comment-backslash-does-not-continue-the-line", "command": "echo hi # note \\\nrm -rf {{repo}}/x", "cwd": "{{outside}}", "expect": "deny", "category": "mutator", "trigger": "names"},
  {"id": "line-comment-backslash-does-not-continue-the-line", "command": "# note \\\nrm -rf {{repo}}/x", "cwd": "{{outside}}", "expect": "deny", "category": "mutator", "trigger": "names"},
  {"id": "single-quoted-backslash-newline-is-literal", "command": "echo 'a \\\n' && rm -rf {{repo}}/x", "cwd": "{{outside}}", "expect": "deny", "category": "mutator", "trigger": "names"},
  {"id": "ansi-c-escaped-quote-does-not-hide-a-continuation", "command": "echo $'\\''; find {{repo}} \\\n  -delete", "cwd": "{{outside}}", "expect": "deny", "category": "mutator", "trigger": "names"},
  {"id": "hash-glued-after-a-continuation-is-not-a-comment", "command": "find {{repo}} -name x\\\n#y \\\n  -delete", "cwd": "{{outside}}", "expect": "deny", "category": "mutator", "trigger": "names"},
  {"_comment": "── A QUOTE IN A COMMENT DOES NOT CROSS THE JOIN. Judgment Day round 2 of guarda-eval-y-find-multilinea, 2026-09-30: cc32609 masked the quote-aware and the quote-blind join in ONE pass, so the apostrophe of a comment in one copy paired with its twin in the other and blanked the `rm` between them — ALLOWED by every driver, DENIED at c0ea67c. Each copy is masked on its own now."},
  {"id": "comment-apostrophe-does-not-pair-across-the-join", "command": "echo hi # it's \\\nrm -rf {{repo}}/x", "cwd": "{{outside}}", "expect": "deny", "category": "mutator", "trigger": "names"},
