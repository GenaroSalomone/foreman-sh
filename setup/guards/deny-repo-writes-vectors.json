  {"id": "second-line-comment-quote-does-not-pair-across-the-join", "command": "echo a \\\n# it's \\\nrm -rf {{repo}}/x", "cwd": "{{outside}}", "expect": "deny", "category": "mutator", "trigger": "names"},
