#!/usr/bin/env bash
# setup/heavy [--tag T] -- <cmd…>   run <cmd> holding one heavy-run slot.   setup/heavy --status   who holds, who waits.
# setup/heavy --short [--max S] [--tag T] -- <cmd…>   the SHORT LANE: a job of seconds does not queue behind a run of hours.
#
# ONE HEAVY JOB PER SLOT, TWO SLOTS BY DEFAULT (HW_HEAVY_SLOTS=1 asks for one; a second slot only while memory is free: two
# heavy runs lagged the Mac on 2026-10-18, hence the memory gate, not one slot). A subject, the fast gate, `go test` of a
# package, a release cut: run it as `setup/heavy -- <cmd>`, never behind a hand-typed lock and never behind a
# `pgrep -f` count (that one matches the waiters' own `zsh -c until …` loops and every waiter waits on the others:
# measured 2026-10-18, four executors ~2h17).
#
#   slot 1   ~/.cache/hw/heavy.lock     (the lock the briefs already running take by hand: compatible)
#   slot 2   ~/.cache/hw/heavy.lock.2   only while >= HW_HEAVY_MIN_FREE (20) percent of memory is free
#            (macOS `memory_pressure`, Linux MemAvailable/MemTotal); HW_HEAVY_SLOTS (default 1; 2 opens slot 2) is how many slots exist
#   queue    ~/.cache/hw/heavy.queue/   one ticket per waiter, FIFO: the head takes the first slot it may use, and
#            only the head reclaims a slot whose owner pid is dead (so two reclaimers never race). A waiter behind a
#            head that CANNOT use a free slot (its ticket's third line names how many slots its run may use) takes
#            that slot itself: a free slot 2 behind a head launched with one slot is capacity nobody can reach.
#            A ticket whose pid is dead is dropped.
#   log      ~/.cache/hw/heavy.log      `start end wall rc load1=<at start>/<at end> tag cmd` per run: the measured durations a report quotes,
#            and the machine's 1-minute load average (`-` when it cannot be read) around them: a timing taken at load1 37 is not one
#            taken at 3 (retro suite-under-15, 2026-11-11). The reading is `uptime`'s.
#   quiet    `--quiet <max-load1>` (not with --short): holding its slot, the job does not start until load1 reads at or under <max-load1>;
#            it says once a minute what it reads. For a timing run: start at a known-quiet machine, run the control in the same hour.
#
# THE SHORT LANE (`--short [--max S]`, default and cap 120 s) runs BESIDE a holder of slot 1, never behind the slot queue:
# build-core takes 11 s and once waited ~6100 s behind a 14104 s release run . One short job at a time
# (lock ~/.cache/hw/heavy.short.lock, FIFO among shorts in ~/.cache/hw/heavy.short.queue), because a short job adds load
# to the heavy one beside it: the cap and the one-at-a-time are what bound it. A short job still running at its cap is
# sent TERM, then KILL after HW_HEAVY_SHORT_GRACE (5 s), and setup/heavy exits 124 saying so. heavy.log tags its line
# `short:<tag>`. Only a job that really is short belongs there: anything that can pass 120 s takes a slot.
# Every command setup/heavy runs sees HW_HEAVY_RUNNING=1, so a script that opts into the short lane on its own
# (setup/build-core) does not queue a second time when it is already inside a slot or a short job.
#
# LANE PRIORITY.
#   class     setup | product. HW_HEAVY_CLASS=setup|product is a caller's own declaration, cooperative and unverified; else
#             HW_PROJECT decides (the lane hw exports to every executor: `setup` is setup, any other lane is product); else a
#             shell standing in the setup lane's own tree (under HW_BRAIN_ROOT, which bin/brain exports to a brainer and hw
#             replaces with HW_PROJECT for an executor); else the tag prefix (`setup-…`). Anything else, an unknown lane or no
#             tag at all, is PRODUCT, so a missing tag starves nobody. The class is the ticket's fourth line and the lock's
#             `class` file; `--status` prints it on every holder and queued job.
#   order     a queued PRODUCT job is served before any queued SETUP job, whatever their arrival order; FIFO inside a class.
#   reserve   while a product job holds a slot or waits, setup holders together hold at most HW_HEAVY_SETUP_MAX slots (default:
#             slots - 1, minimum 1), so a slot is not all setup's; with no product job present and the variable unset, setup may
#             take every slot. A setup waiter over the cap is not eligible and does not hold the queue head. (The reserve is checked
#             under a short mutex, ~/.cache/hw/heavy.pick.) It bounds SETUP; it promises product no slot: the cap and the slot
#             scan both use the CALLER's HW_HEAVY_SLOTS, so a caller asking for fewer slots cannot reach one setup leaves free,
#             slot 2 needs HW_HEAVY_MIN_FREE memory free, and a product waiter takes whichever slot frees first.
#   starve    a setup job queued longer than HW_HEAVY_SETUP_STARVE_MIN minutes (default 60; fractions allowed) is served
#             ahead of product jobs, still inside the reserve.
#
# While it waits it says, once a minute on stderr, who holds each slot (tag, pid, elapsed) and your position.
# It releases on exit and on INT/TERM and exits with the command's own code (128+N for a signal). It removes only a lock whose
# owner file names its own pid. On INT/TERM the command's process group is TERMed and CONTinued (a TERM stays pending on a process the
# memory guard SIGSTOPped), then KILLed after HW_HEAVY_KILL_GRACE (3 s): nothing it started outlives it. When the command
# ends by itself, whatever it left in its group is KILLed too (a leftover the guard stops later would have no one to resume it).
#
# A run that cannot make progress says so (2026-10-20: a release cut sat frozen 15 h, SIGSTOPped by the
# machine's memory guard, and nobody was told). This file only READS that guard's published numbers; it never
# touches the guard or its thresholds.
#   preflight  as the command starts, free memory under HW_HEAVY_RESUME_FREE (26, the guard's resume line) prints one
#              warning and the 5 biggest processes by RSS, then starts anyway; HW_HEAVY_REQUIRE_FREE=1 refuses (exit 75)
#   watchdog   while the command runs, every HW_HEAVY_WATCH (60 s) its process tree is read; mostly state T for
#              HW_HEAVY_FROZEN_ALERT_MIN (20) minutes writes ONE line to ~/.cache/hw/heavy-alerts.log and, with
#              HW_INVOKER_PANE set, `channel-send --report`s it to that pane. One alert per frozen stretch; a thaw re-arms.
#              `--status` shows `FROZEN since HH:MM` on the holder as soon as the watchdog has seen it frozen.
#
# OPT-IN: NOTHING HEAVY RUNS WHILE THE MAC IS IN USE (`--when-idle`, or HW_HEAVY_WHEN_IDLE=1). Never the default: the cut and run-suite.sh run
# heavy work at background priority (taskpolicy -b; the FAST GATE at `nice -n 10` only: efficiency cores cost ~3.5x its CPU, measured on subject 103, 3.2 s vs 10.8 s, so its budgets read red under -b) and never pause it (2026-10-26: the Linux full suite froze the machine its user was working on;
# who vetoed pausing the work). macOS only: a host without ioreg reads as idle, so nothing pauses there. The console's idle time is `ioreg -c IOHIDSystem` HIDIdleTime (ns).
#   start      the command (and its place in the queue) waits until the console has been idle >= HW_HEAVY_IDLE_MIN (15) minutes
#   while it runs, every HW_HEAVY_IDLE_POLL (30 s): idle under HW_HEAVY_ACTIVE_SEC (60 s) -> the holder's whole process tree is
#              SIGSTOPped and every container labelled `hw-heavy=<this run>` (HW_HEAVY_RUN, exported: `docker run --label
#              hw-heavy=$HW_HEAVY_RUN`) is `docker pause`d; idle >= HW_HEAVY_IDLE_MIN again -> SIGCONT / `docker unpause`
#   `--status` shows `PAUSED (user active) since HH:MM`; the FROZEN alert never fires for a pause this made itself.
#   time not running (the wait to start, every pause) is written to HW_HEAVY_PAUSE_FILE as `<seconds> <since-epoch or 0>` when that is set:
#              the release cut's cap does not count it. No ioreg (a Linux host) reads as idle. HW_HEAVY_IOREG names another ioreg.
#   A heavy run started INSIDE another does not pause by itself: the outer holder governs (it exports HW_HEAVY_WHEN_IDLE_ACTIVE=1 when it does).
#
# HW_HEAVY_DIR (the directory above), HW_HEAVY_POLL (5 s), HW_HEAVY_REPORT (60 s) and HW_HEAVY_FREE (force the
# free-memory reading, in percent) exist for the subject that holds this file (tests/1040), and so do HW_HEAVY_CLOCK
# (a file holding the epoch the watchdog uses as "now") and HW_HEAVY_CHANNEL_SEND (the delivery command).
set -u

D="${HW_HEAVY_DIR:-$HOME/.cache/hw}"
Q="$D/heavy.queue"
LOG="$D/heavy.log"
SLOTS="${HW_HEAVY_SLOTS:-2}"   # two is the default: one run at a time lost a whole slot whenever a waiter was launched without the variable
MINFREE="${HW_HEAVY_MIN_FREE:-20}"
POLL="${HW_HEAVY_POLL:-5}"
REPORT="${HW_HEAVY_REPORT:-60}"
RESUME_FREE="${HW_HEAVY_RESUME_FREE:-26}"        # the memory guard resumes over this; a mirror of its number, not a control of it
WATCH="${HW_HEAVY_WATCH:-60}"
FROZEN_MIN="${HW_HEAVY_FROZEN_ALERT_MIN:-20}"
# A malformed bound falls back to its default rather than refusing a run.
_n="$SLOTS"; case "$_n" in ''|*[!0-9]*|0) _n=2 ;; esac   # a bad HW_HEAVY_SLOTS is refused below; --status never gets there
SETUP_MAX="${HW_HEAVY_SETUP_MAX:-$((_n - 1))}"
case "$SETUP_MAX" in ''|*[!0-9]*) SETUP_MAX=$((_n - 1)) ;; esac
[ "$SETUP_MAX" -ge 1 ] || SETUP_MAX=1
STARVE_S="$(awk -v m="${HW_HEAVY_SETUP_STARVE_MIN:-60}" 'BEGIN { if (m !~ /^[0-9]+(\.[0-9]+)?$/) m = 60; printf "%d", m * 60 }')"
ALERTS="$D/heavy-alerts.log"
PICK="$D/heavy.pick"
PICKED=0
SQ="$D/heavy.short.queue"
SL="$D/heavy.short.lock"
SHORT_CAP=120
GRACE="${HW_HEAVY_SHORT_GRACE:-5}"
KILL_GRACE="${HW_HEAVY_KILL_GRACE:-3}"
WHEN_IDLE=0; [ "${HW_HEAVY_WHEN_IDLE:-0}" != 1 ] || WHEN_IDLE=1
IDLE_MIN="${HW_HEAVY_IDLE_MIN:-15}"
IDLE_POLL="${HW_HEAVY_IDLE_POLL:-30}"
ACTIVE_S="${HW_HEAVY_ACTIVE_SEC:-60}"
IOREG="${HW_HEAVY_IOREG:-ioreg}"
PAUSE_FILE="${HW_HEAVY_PAUSE_FILE:-}"

usage() {
  cat >&2 <<'EOF'
usage: setup/heavy [--tag T] [--when-idle] [--quiet MAX_LOAD1] -- <cmd…>
                                          run <cmd> in a heavy slot (FIFO), keep its exit code; --when-idle starts it only after
                                          the console has been idle HW_HEAVY_IDLE_MIN (15) minutes and pauses it while the Mac is in use;
                                          --quiet starts it only once load1 is under MAX_LOAD1 (a timing run)
       setup/heavy --short [--max S] [--tag T] -- <cmd…>
                                          run <cmd> in the short lane beside the slot holder: one short job at a
                                          time, killed at S seconds (default and cap 120) with exit 124
       setup/heavy --status               print holders and queue once
EOF
  exit 2
}

lockdir() { if [ "$1" = 1 ]; then printf '%s' "$D/heavy.lock"; else printf '%s' "$D/heavy.lock.$1"; fi; }
# EVERY SLOT THAT EXISTS, not just the ones THIS caller may use. `--status` used to list only 1..HW_HEAVY_SLOTS of the caller,
# so a bare `--status` (SLOTS=1) showed slot 2 free while setup-effort-help held heavy.lock.2 (2026-11-04 11:51).
slot_dirs() {  # in numeric order, no repeats: 1..SLOTS first, then every heavy.lock[.N] on disk
  local k d n
  {
    for k in $(seq 1 "$SLOTS"); do printf '%s\n' "$k"; done
    for d in "$D"/heavy.lock "$D"/heavy.lock.*; do  # MUTATION-ANCHOR: 1040-H19
      [ -e "$d" ] || continue
      n="${d##*/heavy.lock}"; n="${n#.}"
      case "$n" in ''|*[!0-9]*) continue ;; esac   # heavy.lock and heavy.lock.<n> only; heavy.lock.stale.<pid> is not a slot
      printf '%s\n' "$n"
    done
  } | sort -n -u
}
ticket_slots() {  # <ticket path> → the slots the ticket's run may use; a ticket from before the third line keeps its old reach
  local f="$1" a="" b="" t=""
  [ -r "$f" ] || { printf '%s' "$SLOTS"; return; }
  { IFS= read -r a; IFS= read -r b; IFS= read -r t; } < "$f" 2>/dev/null || true
  case "$t" in ''|*[!0-9]*) printf '%s' "$SLOTS" ;; *) printf '%s' "$t" ;; esac
}
# A zombie answers `kill -0` and will never run again (2026-10-30: a queued run, a zombie under a stopped zsh, held the queue 35 min): it is dead.
alive() {
  local st
  case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$1" 2>/dev/null || return 1
  st="$(ps -o stat= -p "$1" 2>/dev/null)"; st="${st# }"
  case "$st" in Z*) return 1 ;; esac  # MUTATION-ANCHOR: 1040-H16
  return 0
}
now() { date +%s; }
mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }

elapsed() {  # seconds -> 4m02s
  local s="$1"
  case "$s" in ''|*[!0-9]*) printf '?'; return ;; esac
  if [ "$s" -ge 3600 ]; then printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
  else printf '%dm%02ds' $((s / 60)) $((s % 60)); fi
}

free_reading() {  # percent free, or nothing when this machine cannot say
  local v
  if [ -n "${HW_HEAVY_FREE:-}" ]; then printf '%s' "$HW_HEAVY_FREE"; return; fi
  if [ -r /proc/meminfo ]; then
    v="$(awk '/^MemTotal/{t=$2} /^MemAvailable/{a=$2} END{if (t>0) printf "%d", a*100/t}' /proc/meminfo)"
  else
    v="$(memory_pressure 2>/dev/null | awk '/free percentage/{print $NF+0}')"
  fi
  printf '%s' "$v"
}
free_pct() { local v; v="$(free_reading)"; printf '%s' "${v:-0}"; }

load1_reading() {  # the 1-minute load average from `uptime` (a subject stubs it on PATH); LC_ALL=C because a comma-decimal locale prints `3,49`, or `-` when this machine cannot say
  local v
  v="$(LC_ALL=C uptime 2>/dev/null | sed -n 's/.*load averages*: *\([0-9][0-9.]*\).*/\1/p')"
  case "$v" in ''|*.*.*) v="-" ;; esac
  printf '%s' "$v"
}

# The watchdog's "now" is a file when a subject stubs the clock, the real clock otherwise.
wnow() {
  local v
  if [ -n "${HW_HEAVY_CLOCK:-}" ] && read -r v < "$HW_HEAVY_CLOCK" 2>/dev/null && [ -n "$v" ]; then printf '%s' "$v"; else now; fi
}
hhmm() { date -r "$1" +%H:%M 2>/dev/null || date -d "@$1" +%H:%M 2>/dev/null || printf '?'; }  # BSD, then GNU

# An owner file is `tag pid start-epoch`; the interim helper wrote HH:MM, a brief's hand loop wrote no third field.
# Sets OTAG OPID OSTART; all empty when there is no owner file (a slot being taken, or taken by something older).
read_owner() {
  OTAG=""; OPID=""; OSTART=""
  [ -r "$1/owner" ] && read -r OTAG OPID OSTART < "$1/owner" 2>/dev/null
  return 0
}

holder_text() { holder_text_at "$(lockdir "$1")"; }
holder_text_at() {  # <lock dir> -> "tag pid N 4m02s" | "free" | "dead (tag pid N)" | "owner unknown"
  local L="$1" t
  [ -d "$L" ] || { printf 'free'; return; }
  read_owner "$L"
  if [ -z "$OPID" ]; then printf 'taken, owner not written yet'; return; fi
  if alive "$OPID"; then
    case "$OSTART" in ''|*[!0-9]*) t="since $OSTART" ;; *) t="$(elapsed $(($(now) - OSTART)))" ;; esac
    printf '%s pid %s %s' "$OTAG" "$OPID" "$t"
    if [ -s "$L/paused" ]; then read -r t < "$L/paused"; printf '  PAUSED (user active) since %s' "$(hhmm "$t")"; fi  # MUTATION-ANCHOR: 1131-H05
    if [ -s "$L/frozen" ]; then read -r t < "$L/frozen"; printf '  FROZEN since %s' "$(hhmm "$t")"; fi  # MUTATION-ANCHOR: 1040-H10
  else
    printf 'DEAD holder (%s pid %s)' "$OTAG" "$OPID"
  fi
}

# A holder or a waiter belongs to an hw run, named by its environment when it queued: `<workdir>/.hw/<run>`, kept in the ticket's
# second line and in the lock's `run` file (another process's environment cannot be read back on macOS). Once that run's current
# task has reported (the done marker `done-invoker` writes, as bin/hw's _run_reported reads it: not reopened, not blocked-waiting)
# nobody is left to read the result, so the run is reclaimed and its process tree ended instead of keeping the slot.
# ONLY A JOB THAT STARTED BEFORE THE REPORT: a job taken or queued after the done marker was written belongs to an executor that
# was reopened (a hand-written channel-send, no `hw revive` marker) and is working again, so the marker is not about it. Killing it
# cost two gh-attach gates (exit 143, 2026-11-05/06). `since` is the job's start: the owner file's epoch, or the ticket's mtime.
run_of_env() { [ -z "${HW_WORKDIR:-}" ] || [ -z "${HW_RUN:-}" ] || printf '%s/.hw/%s' "$HW_WORKDIR" "$HW_RUN"; }
run_reported() {  # <run dir> <since: epoch the job started>
  local rd="$1" since="${2:-0}" seq b
  [ -n "$rd" ] && [ -d "$rd" ] || return 1
  seq=""; [ ! -r "$rd/task" ] || seq="$(tr -dc '0-9' < "$rd/task")"
  case "$seq" in ''|0|1) b="$rd" ;; *) b="$rd/t$seq" ;; esac
  [ -f "$b/done" ] && [ ! -f "$b/reopened" ] && [ ! -f "$b/blocked-waiting" ] || return 1  # MUTATION-ANCHOR: 1040-H17
  case "$since" in ''|*[!0-9]*) return 0 ;; esac  # a start we cannot read keeps the old answer: the marker decides
  [ "$(mtime "$b/done")" -ge "$since" ]  # MUTATION-ANCHOR: 1040-H21
}
end_tree() {  # <root pid>: TERM and CONT (a TERM stays pending on a stopped process), KILL what outlives the grace
  local p n=0 pids; pids="$(tree_pids "$1")"
  for p in $pids; do kill -TERM "$p" 2>/dev/null || true; kill -CONT "$p" 2>/dev/null || true; done
  while [ "$n" -lt $((KILL_GRACE * 10)) ] && kill -0 "$1" 2>/dev/null; do sleep 0.1; n=$((n + 1)); done
  for p in $pids; do kill -KILL "$p" 2>/dev/null || true; done
}
reap_reported() {  # <pid> <tag> <run dir> <since>: end its tree and say so in heavy.log; never the caller itself or a caller of the same run
  [ "$1" != "$$" ] && [ "$3" != "$(run_of_env)" ] || return 1
  run_reported "$3" "${4:-0}" || return 1
  end_tree "$1"
  printf '%s %s 0 143 load1=-/- reclaimed:%s run %s had reported (pid %s)\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$(date +%Y-%m-%dT%H:%M:%S)" "$2" "$3" "$1" >> "$LOG"
  return 0
}

live_tickets() {  # [queue dir] live ticket names, oldest first; a ticket whose pid is dead, or whose run reported, is dropped
  local f n tag="" run="" q="${1:-$Q}"
  for f in "$q"/*; do
    [ -e "$f" ] || continue
    n="${f##*/}"
    tag=""; run=""; { IFS= read -r tag; IFS= read -r run; } < "$f" 2>/dev/null || true
    if [ -n "$run" ] && alive "${n#*.}" && reap_reported "${n#*.}" "$tag" "$run" "$(mtime "$f")"; then rm -f "$f"; continue; fi
    if alive "${n#*.}"; then printf '%s\n' "$n"; else rm -f "$f"; fi  # MUTATION-ANCHOR: 1040-H06
  done
}

lane_class() {  # setup | product: the override, else the lane hw exports, else the setup lane's tree, else the tag prefix
  local p r
  case "${HW_HEAVY_CLASS:-}" in setup|product) printf '%s' "$HW_HEAVY_CLASS"; return ;; esac
  if [ -n "${HW_PROJECT:-}" ]; then
    [ "$HW_PROJECT" != setup ] || { printf setup; return; }
    printf product; return
  fi
  # A BRAINER'S SHELL HAS NO HW_PROJECT (bin/brain exports HW_BRAIN_ROOT and nothing else): the brain root is the setup lane's
  # own tree, and so is its `setup/` brain directory. Every other lane there keeps falling to the tag.
  if [ -n "${HW_BRAIN_ROOT:-}" ]; then
    p="$(pwd -P 2>/dev/null || printf '%s' "$PWD")"
    r="$(cd "$HW_BRAIN_ROOT" 2>/dev/null && pwd -P)" || r="$HW_BRAIN_ROOT"   # bin/brain keeps the root's spelling; cwd is physical
    case "$p" in "$r"|"$r"/setup|"$r"/setup/*) printf setup; return ;; esac
  fi
  case "$TAG" in setup|setup-*|setup_*|setup.*) printf setup ;; *) printf product ;; esac
}
class_of_lock() {  # <lock dir> -> setup | product (a lock with no class file is a hand-typed or older one: product)
  local c=""
  [ -r "$1/class" ] && read -r c < "$1/class" 2>/dev/null
  [ "$c" = setup ] && printf setup || printf product
}
ticket_class() {  # <queue dir> <ticket name>
  local a="" b="" c="" cl=""
  { IFS= read -r a; IFS= read -r b; IFS= read -r c; IFS= read -r cl; } < "$1/$2" 2>/dev/null || true
  [ "$cl" = setup ] && printf setup || printf product
}
ticket_starved() {  # <ticket name>: queued at least STARVE_S seconds (the name is `<epoch ns>.<pid>`)
  local ts="${1%%.*}"
  ts="${ts%?????????}"
  case "$ts" in ''|*[!0-9]*) return 1 ;; esac
  [ $(($(now) - ts)) -ge "$STARVE_S" ]  # MUTATION-ANCHOR: 1040-H26
}
setup_held() {  # how many slots a live SETUP holder has (a dead owner does not count; one not written yet does)
  local k L n=0
  for k in $(slot_dirs); do
    L="$(lockdir "$k")"
    [ -d "$L" ] || continue
    [ "$(class_of_lock "$L")" = setup ] || continue
    read_owner "$L"
    [ -z "$OPID" ] || alive "$OPID" || continue
    n=$((n + 1))
  done
  printf '%s' "$n"
}
product_present() {  # a live PRODUCT holder, or a live PRODUCT ticket: the reserve is needed only then
  local k L n
  for k in $(slot_dirs); do
    L="$(lockdir "$k")"
    [ -d "$L" ] || continue
    [ "$(class_of_lock "$L")" = setup ] && continue
    read_owner "$L"
    [ -z "$OPID" ] || alive "$OPID" || continue
    return 0
  done
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    [ "$(ticket_class "$Q" "$n")" = setup ] || return 0
  done <<TICKETS
$(live_tickets)
TICKETS
  return 1
}
setup_cap() {  # how many slots setup may hold now: every slot while no product job holds or waits, else the reserve
  if [ -z "${HW_HEAVY_SETUP_MAX:-}" ] && ! product_present; then printf '%s' "$_n"; else printf '%s' "$SETUP_MAX"; fi
}
serve_order() {  # <live tickets, oldest first> -> the order they are served: starved setup, then product, then setup; FIFO in each
  local n starved="" prod="" setup=""
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    if [ "$(ticket_class "$Q" "$n")" != setup ]; then prod="$prod$n"$'\n'  # MUTATION-ANCHOR: 1040-H23
    elif ticket_starved "$n"; then starved="$starved$n"$'\n'
    else setup="$setup$n"$'\n'; fi
  done <<ORDER
$1
ORDER
  printf '%s%s%s' "$starved" "$prod" "$setup"
}
serve_head() {  # <live tickets> -> the first ticket in serve order that may take a slot (a setup one only under the reserve)
  local n held ord cap
  held="$(setup_held)"
  cap="$(setup_cap)"
  ord="$(serve_order "$1")"
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    if [ "$(ticket_class "$Q" "$n")" = setup ] && [ "$held" -ge "$cap" ]; then continue; fi  # MUTATION-ANCHOR: 1040-H24
    printf '%s' "$n"; return 0
  done <<HEADS
$ord
HEADS
}
pick_take() {  # the setup callers' short mutex: the reserve is counted and a slot taken as one step. A mutex older than 30 s is a dead one's.
  if mkdir "$PICK" 2>/dev/null; then PICKED=1; return 0; fi
  [ $(($(now) - $(mtime "$PICK"))) -le 30 ] || rm -rf "$PICK"
  return 1
}
pick_drop() { [ "$PICKED" = 1 ] || return 0; rmdir "$PICK" 2>/dev/null || true; PICKED=0; }

status_text() {  # <my ticket or ''>
  local k pos=0 i=0 t total free ord
  free="$(free_pct)"
  for k in $(slot_dirs); do
    printf 'heavy: slot %s: %s' "$k" "$(holder_text "$k")"
