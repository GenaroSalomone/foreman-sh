#!/usr/bin/env bash
#
# test-hw — the negative cases this toolchain keeps needing and kept losing.
#
# THIS IS THE ENTRY POINT AND THE RUNNER. The pre-commit hook, everyone's
# muscle memory and every brief call it by this name; the tests themselves live
# one directory down, one file per subject, in setup/tests/. Why they were
# split, and what every subject file may assume, is in setup/tests/_common.sh.
#
# It runs each subject file in order as its own bash process and sums the
# `ok -` lines. It does not source them: separate processes are what stop one
# subject's $TMP, fixtures and helper names from reaching another's.
#
# A failing subject file stops the run, exactly as a failing assertion always
# has, and its name is printed — that is the one thing the old single file
# could not tell you.
set -euo pipefail

# STRIP GIT'S AMBIENT ENVIRONMENT BEFORE ANYTHING ELSE.
#
# This is not hygiene, it is damage control, and it is here because it already
# happened. A git hook exports GIT_DIR and GIT_INDEX_FILE, and EVERY git command
# a hook-invoked child runs targets those — including `git init` inside an
# unrelated directory. The rollback fixture in 03-launch-rollback.sh does
# `( cd "$TMP/rb" && git init && git add -A && git commit )`, which reads as
# obviously scoped and is not: run from pre-commit, on 2026-08-24, it
# initialised brain's own repository, committed the fixture's two files over
# HEAD and left every real file untracked. Nothing was lost — the commit was
# never pushed and `git reset --mixed` restored it — but the working tree of a
# repo several agents write to was one `--hard` away from real damage.
#
# _common.sh unsets these again in every child, which is where it actually
# bites. Doing it here too costs nothing and covers this process as well.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX \
      2>/dev/null || true

# AND THE CONFIG-INJECTION FAMILY, which the list above missed until 2026-09-09.
#
# `git -c <key>=<value> …` does not keep that setting to itself: git serialises
# every `-c` into GIT_CONFIG_PARAMETERS (and accepts the same injection as
# GIT_CONFIG_COUNT / GIT_CONFIG_KEY_<n> / GIT_CONFIG_VALUE_<n>), exports it, and
# EVERY descendant git process applies it — at command-line precedence, which
# beats the repository's own config. A hook is a descendant, and so is every git
# command a hook-invoked test runs inside a throwaway fixture.
#
# MEASURED 2026-09-09. `git -c core.hooksPath=setup/hooks commit` — the way this
# repo's hook gets invoked when .git/hooks is not the source — leaked
# `core.hooksPath=setup/hooks` all the way down into
# tests/105-decisions-staged-budget.sh, whose fixtures install a pre-commit hook
# at <fixture>/.git/hooks/pre-commit and then commit deliberately corrupt
# rotations to prove the guard REFUSES them. In the leaked context git looked for
# the hook at <fixture>/setup/hooks/pre-commit — a directory the fixture creates
# for other reasons and never puts a hook in — found nothing, ran no guard, and
# accepted all eight corrupt commits. The guard was never wrong; it was never
# called. Standalone the same file passes, which is what made it look like the
# suite failed "only inside the hook".
#
# The prefix sweep covers GIT_CONFIG itself, GIT_CONFIG_GLOBAL/SYSTEM, and the
# numbered KEY/VALUE pairs a fixed list cannot name.
for _v in ${!GIT_CONFIG@}; do
  unset "$_v" 2>/dev/null || true
done
unset _v 2>/dev/null || true

# --keep-going, or HW_TEST_KEEP_GOING=1: a red job no longer stops the run.
# Every job runs, every `not ok` is listed at the end, and the exit is still
# non-zero with no number printed — so verify-for-push, pre-push and every
# other caller fail exactly as before; what changes is that ONE full run names
# every red instead of the first. It travels as the environment because the
# snapshot below re-executes this file without its arguments, and a nested
# runner never inherits it (tests/_common.sh sweeps HW_*).
for _a in "$@"; do
  case "$_a" in
    --keep-going) export HW_TEST_KEEP_GOING=1 ;;
    *) printf 'not ok - runner: unknown argument %s (the only one is --keep-going)\n' "$_a" >&2; exit 2 ;;
  esac
done
unset _a 2>/dev/null || true

HERE="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCE_ROOT="$(cd "$HERE/.." && pwd -P)"
# NATIVE WINDOWS (Git Bash): the runner's own python, ps and pgrep go through
# bin/msys-compat.sh, as every entry point's do. A fixture tree that carries
# only this runner has no bin/. Elsewhere OSTYPE never matches.
case "${OSTYPE:-}" in msys*|cygwin*)
  if [ -f "$SOURCE_ROOT/bin/msys-compat.sh" ]; then . "$SOURCE_ROOT/bin/msys-compat.sh"
  else export PYTHONUTF8=1; fi ;;
esac
# Capture ALL checkout bytes (including ignored/untracked subjects), plus the
# initial tracking classification, before executing anything. The private
# child is identified by its exact root, so nested fixture runners must capture
# their own candidates rather than inheriting a bypass from their parent.
# Compared physically on both sides: the snapshot's spelling comes from Python
# and SOURCE_ROOT from `pwd -P`, and under Git Bash those differ for one
# directory (/tmp/x against /c/Users/<u>/AppData/Local/Temp/x). A mismatch here
# re-snapshots forever, so the comparison must not depend on spelling.
_snap_phys=""; [ -z "${TEST_HW_SNAPSHOT_ROOT:-}" ] || _snap_phys="$(cd "$TEST_HW_SNAPSHOT_ROOT" 2>/dev/null && pwd -P || true)"
if [ "$_snap_phys" != "$SOURCE_ROOT" ]; then  # MUTATION-ANCHOR: 84-M01
  exec python3 "$HERE/test-hw-snapshot.py" "$SOURCE_ROOT"
fi
TESTS="$HERE/tests"
. "$HERE/fast-gate-budget.sh"
[ -d "$TESTS" ] || { printf 'not ok - runner: %s does not exist\n' "$TESTS" >&2; exit 1; }

# THE GLOB IS THE CONTRACT, SO PROVE NOTHING FELL OUTSIDE IT. A subject file
# named `browser.sh` instead of `13-browser.sh` is not matched, never runs, and
# takes its assertions with it — the suite stays green with less coverage,
# which is the exact failure this whole file exists to make impossible. So
# every *.sh in tests/ is either _common.sh or numbered, and anything else is a
# hard error rather than a silent skip.
#
# TWO DIGITS OR MORE, since 2026-09-08. The glob was exactly `[0-9][0-9]-` and
# the directory reached 99, so the next subject file — `100-decisions-…` — was
# in tests/ and outside the contract. The check above is what said so, which is
# the check working; widening it here is the fix rather than renaming the
# subject into a number that is already taken. Ordering is lexicographic either
# way, so `100-` now sorts before `11-`; the subjects are independent processes
# with their own $TMP, so nothing reads the order.
shopt -s nullglob
FILES=("$TESTS"/[0-9][0-9]*-*.sh)
ALL=("$TESTS"/*.sh)
shopt -u nullglob
[ "${#FILES[@]}" -gt 0 ] || { printf 'not ok - runner: no subject files in %s\n' "$TESTS" >&2; exit 1; }
if [ "${#ALL[@]}" -ne "$(( ${#FILES[@]} + 1 ))" ]; then
  for f in "${ALL[@]}"; do
    case "$(basename "$f")" in
      _common.sh|[0-9][0-9]*-*.sh) ;;
      *) printf 'not ok - runner: %s is in tests/ but the NN[N]-<subject>.sh glob does not match it, so it never runs\n' \
           "$(basename "$f")" >&2 ;;
    esac
  done
  exit 1
fi
[ -f "$TESTS/_common.sh" ] || { printf 'not ok - runner: tests/_common.sh is missing\n' >&2; exit 1; }

# ── THE FAST GATE, derived from measurement rather than a hand-kept list ────
#
# `HW_TEST_GATE=fast` is what pre-commit passes; unset (or `full`) is every
# other caller, including pre-push and a bare `bash setup/test-hw`. Default
# stays `full` so nothing that already depends on this runner's shape —
# tracked/untracked accounting, the mutation-coverage gate, the guard block —
# changes unless a caller opts in.
#
# THE CLASSIFICATION IS NOT A LIST SOMEONE MAINTAINS. `setup/test-budgets.json`
# holds a REAL measured duration per subject file (from `setup/measure-tests.sh`)
# and one owned threshold; "fast" is simply "measured at or under the
# threshold" — computed here, not authored. What IS committed is the
# measurement, because deriving it live on every run would mean running the
# full suite to decide whether to run the full suite.
#
# COMPLETENESS IS CHECKED EVERY FAST RUN, not just in a dedicated test: the
# budgets file's file list must equal the glob's file list EXACTLY. A file that
# is not in the manifest is not "probably fast" or "probably slow" — it is
# unclassified, and an unclassified file is refused rather than defaulted into
# either gate. That is what stops a new test from quietly entering neither gate,
# or entering the fast one without ever having been measured.
HW_TEST_GATE="${HW_TEST_GATE:-full}"
case "$HW_TEST_GATE" in
  full|fast) ;;
  *) printf 'not ok - runner: HW_TEST_GATE must be full or fast (got: %s)\n' "$HW_TEST_GATE" >&2; exit 1 ;;
esac
FAST_THRESHOLD_SECONDS=""
FG_FACTOR=1
if [ "$HW_TEST_GATE" = fast ]; then
  BUDGETS="$HERE/test-budgets.json"
  [ -f "$BUDGETS" ] || { printf 'not ok - runner: %s is missing — run setup/measure-tests.sh before the fast gate can run\n' "$BUDGETS" >&2; exit 1; }
  _gate_py_rc=0
  _gate_py_out="$(python3 - "$BUDGETS" "$TESTS" <<'PY'
import json, pathlib, sys
budgets = json.loads(pathlib.Path(sys.argv[1]).read_text())
tests_dir = pathlib.Path(sys.argv[2])
on_disk = sorted(p.name for p in tests_dir.glob("[0-9][0-9]*-*.sh"))
listed = sorted(budgets["files"].keys())
if on_disk != listed:
    missing = sorted(set(on_disk) - set(listed))
    extra = sorted(set(listed) - set(on_disk))
    print("MISMATCH")
    if missing:
        print("missing (on disk, unclassified): " + ", ".join(missing))
    if extra:
        print("extra (classified, gone from disk): " + ", ".join(extra))
    sys.exit(1)
# THE `exit` FIELD WAS WRITTEN AND NEVER READ, until 2026-09-11. measure-tests
# has always recorded a per-subject exit status beside the seconds, and nothing
# in this runner, in 117, or anywhere else ever looked at it. So a subject that
# FAILED while being measured was committed as its own budget, and the manifest
# carried "this file does not pass" as a fact no gate objected to. A number
# derived from a failed run is not a budget; it is the duration of whatever went
# wrong. That is how a 0.05s entry for a file that never ran reached a commit.
broken = sorted(n for n in on_disk if budgets["files"][n].get("exit", 0) != 0)
if broken:
    # THE FIRST LINE IS DROPPED BY THE CALLER, which slices it off so this block
    # can lead with a status word. So the content of a refusal starts on the
    # SECOND line; a message written on the first one is not a message.
    #
    # NO APOSTROPHES OR BACKTICKS IN THIS HEREDOC. It sits inside a $( )
    # substitution, and the shell still tracks quoting while it looks for the
    # matching paren even though the heredoc is <<'"'"'PY'"'"' quoted. One
    # possessive apostrophe in a python COMMENT here cost a parse error at the
    # top of the file on 2026-09-11.
    print("REFUSED")
    print("a budget measured from a FAILED run is not a budget: "
          + ", ".join("%s (exit %s, %ss)" % (n, budgets["files"][n]["exit"], budgets["files"][n]["seconds"])
                      for n in broken))
    print("fix the subject, then re-measure it: bash setup/measure-tests.sh " + " ".join(broken))
    sys.exit(1)
threshold = budgets["fast_gate_threshold_seconds"]
fast = [n for n in on_disk if budgets["files"][n]["seconds"] <= threshold]
print("OK")
print("threshold:%s" % threshold)
print("fast:" + ",".join(fast))
for n in on_disk:
    print("own:%s=%s" % (n, budgets["files"][n]["seconds"]))
PY
)" || _gate_py_rc=$?
  if [ "$_gate_py_rc" -ne 0 ]; then
    printf 'not ok - runner: setup/test-budgets.json does not match %s 1:1 — %s\nRegenerate with: bash setup/measure-tests.sh\n' \
      "$TESTS" "$(printf '%s\n' "$_gate_py_out" | tail -n +2 | tr '\n' '; ')" >&2
    exit 1
  fi
  FAST_THRESHOLD_SECONDS="$(printf '%s\n' "$_gate_py_out" | sed -n 's/^threshold://p')"
  FG_FACTOR="$(fg_ci_factor)"
  [ "$FG_FACTOR" = 1 ] || printf 'runner: every fast-gate time budget is x%s here (%s) — a shared CI runner cannot judge wall-clock; setup/fast-gate-budget.sh, point 6\n' \
    "$FG_FACTOR" "$([ -n "${HW_TEST_BUDGET_FACTOR:-}" ] && echo "HW_TEST_BUDGET_FACTOR" || echo "CI host")" >&2
  _fast_names="$(printf '%s\n' "$_gate_py_out" | sed -n 's/^fast://p')"
  _FG_OWN="$(printf '%s\n' "$_gate_py_out" | sed -n 's/^own://p')"
  _narrowed=()
  IFS=',' read -r -a _fast_arr <<< "$_fast_names"
  for f in "${FILES[@]}"; do
    bn="$(basename "$f")"
    for want in "${_fast_arr[@]}"; do
      if [ "$bn" = "$want" ]; then _narrowed+=("$f"); break; fi
    done
  done
  FILES=("${_narrowed[@]}")
  [ "${#FILES[@]}" -gt 0 ] || { printf 'not ok - runner: the fast gate classified zero files as fast — check fast_gate_threshold_seconds in %s\n' "$BUDGETS" >&2; exit 1; }
fi
FAST_TOTAL="${#FILES[@]}"

# ── THE FAST GATE BY SUBJECT: only what the changed paths reach ────────────
#
# 30 pre-commit fast gates cost 89 minutes on 2026-09-30, measured:
# 107-120s each alone, 234-636s under load, 61% of a setup task's wall clock.
# Each paid all 104 fast subjects for a commit that touched one file. So
# pre-commit now names the staged paths (HW_TEST_CHANGED=<file>, one path per
# line) and setup/gate-select answers which fast subjects they reach — by what
# each subject NAMES, derived, never a hand-kept list — plus the subjects that
# declare `# gate-core:` in their header, which run on every selection.
#
# FAILS TOWARD TODAY'S GATE. A trigger path gate-select cannot map, the
# runner's own machinery, a missing selector, an unreadable list or a selector
# that errors: each is the WHOLE fast gate, said once, never a smaller one.
#
# A SELECTED RUN IS NOT THE FAST GATE, so it caches no fast verdict: pre-push
# accepts `<tree>.fast` for task/* pushes, and that file has to mean all 104.
# Full runs ignore HW_TEST_CHANGED; the floor at push does not move.
GATE_SELECTED=0; GATE_GUARDS=0; GATE_CHANGED=""
if [ "$HW_TEST_GATE" = fast ] && [ -n "${HW_TEST_CHANGED:-}" ]; then
  _gs_why=""
  if [ ! -f "$HERE/gate-select" ]; then
    _gs_why="setup/gate-select is absent"
  elif [ ! -r "$HW_TEST_CHANGED" ]; then
    _gs_why="HW_TEST_CHANGED=$HW_TEST_CHANGED is not a readable file"
  else
    _gs_pat=""
    if [ -f "$HERE/hooks/suite-trigger-pattern.sh" ]; then
      _gs_pat="$(. "$HERE/hooks/suite-trigger-pattern.sh" && printf '%s' "${SUITE_TRIGGER_PATTERN:-}")" || _gs_pat=""
    fi
    _gs_rc=0
    _gs_out="$(python3 "$HERE/gate-select" "$SOURCE_ROOT" "$HW_TEST_CHANGED" "$_gs_pat" 2>&1)" || _gs_rc=$?
    if [ "$_gs_rc" -ne 0 ]; then
      _gs_why="setup/gate-select failed (exit $_gs_rc): $(printf '%s' "$_gs_out" | tail -1)"
    elif _gs_all="$(printf '%s\n' "$_gs_out" | sed -n 's/^all //p' | head -1)" && [ -n "$_gs_all" ]; then
      _gs_why="$_gs_all"
    fi
  fi
  if [ -n "$_gs_why" ]; then
    printf 'runner: the WHOLE fast gate — %s\n' "$_gs_why" >&2
  else
    GATE_SELECTED=1
    GATE_CHANGED="$HW_TEST_CHANGED"
    printf '%s\n' "$_gs_out" | grep -q '^guards ' && GATE_GUARDS=1
    _narrowed=()
    for f in "${FILES[@]}"; do
      bn="$(basename "$f")"
      if printf '%s\n' "$_gs_out" | grep -qE "^(core|subject) $(printf '%s' "$bn" | sed 's/[.[\*^$]/\\&/g')( |\$)"; then
        _narrowed+=("$f")
      fi
    done
    FILES=(${_narrowed[@]+"${_narrowed[@]}"})  # MUTATION-ANCHOR: 361-M01
    printf 'runner: SELECTED %s of %s fast subjects from the changed paths%s:\n' "${#FILES[@]}" "$FAST_TOTAL" \
      "$([ "$GATE_GUARDS" = 1 ] && printf ', plus the guard drivers')" >&2
    printf '%s\n' "$_gs_out" | sed -n 's/^core \(.*\)/    core     \1/p; s/^subject \([^ ]*\) \(.*\)/    \1  <- \2/p; s/^guards \(.*\)/    guards   <- \1/p; s/^deferred \(.*\)/    deferred \1 (slow: the full run at push, as always)/p' >&2
    if [ "${#FILES[@]}" -eq 0 ] && [ "$GATE_GUARDS" != 1 ]; then
      printf 'not ok - runner: the selection is EMPTY — no core subject declares `# gate-core:`, so nothing would run\n' >&2
      exit 1
    fi
    # THE OTHER HALF OF THE CORE: every changed program still has to PARSE,
    # whether or not a selected subject runs it. Milliseconds per file.
    while IFS= read -r _p || [ -n "$_p" ]; do
      [ -n "$_p" ] && [ -f "$SOURCE_ROOT/$_p" ] || continue
      _src="$SOURCE_ROOT/$_p"; _chk=""
      case "$_p" in
        *.sh) _chk=bash ;;
        *.py) _chk=python ;;
        *.js|*.mjs) _chk=node ;;
        *.md|*.json|*.txt) ;;
        *) case "$(head -1 "$_src" 2>/dev/null || true)" in
             '#!'*python*) _chk=python ;;
             '#!'*bash*|'#!'*/sh|'#!'*' sh') _chk=bash ;;
             '#!'*node*) _chk=node ;;
           esac ;;
      esac
      _syn_rc=0
      case "$_chk" in
        bash)   _syn="$(bash -n "$_src" 2>&1)" || _syn_rc=$? ;;
        python) _syn="$(python3 -c 'import ast, sys; ast.parse(open(sys.argv[1], encoding="utf-8").read(), sys.argv[1])' "$_src" 2>&1)" || _syn_rc=$? ;;
        node)   if command -v node >/dev/null 2>&1; then _syn="$(node --check "$_src" 2>&1)" || _syn_rc=$?; fi ;;
      esac
      if [ "$_syn_rc" -ne 0 ]; then
        printf 'not ok - runner: %s does not parse (%s):\n%s\n' "$_p" "$_chk" "$_syn" >&2
        exit 1
      fi
    done < "$GATE_CHANGED"
  fi
fi

# ── THE EXECUTOR'S VERIFY ALSO RUNS THE SLOW SUBJECTS THAT NAME WHAT IT CHANGED ─
#
# 142 of 254 subjects are slow, so only the full run (after the merge) ran them,
# and 0.1.3 fell twice there (195, 78) on subjects that named the very files the
# branch had touched. The executor's verify is `HW_TEST_GATE=fast bash
# setup/test-hw` with no HW_TEST_CHANGED, so it asks setup/gate-select `touched`
# about the branch's own diff against main and adds those subjects to the run,
# capped by `touched_budget_seconds` (the ones cut are printed, never silent).
#
# STILL NOT THE FULL SUITE, AND IT WRITES NO FULL VERDICT. The whole fast gate
# ran, so `<tree>.fast` keeps meaning exactly what it did (decisions.md:747,
# :785); the extra subjects only make a red visible a merge earlier. NOT run by
# pre-commit (it names HW_TEST_CHANGED), by a nested run (TEST_HW_NESTED: a
# subject that runs this runner must not recurse into the slow ones), nor with
# HW_TEST_NO_TOUCHED=1. No main to diff against, or a selector that errors, is
# said and runs nothing extra: the fast gate of before, never a red for it.
TOUCHED_RUN=0
if [ "$HW_TEST_GATE" = fast ] && [ -z "${HW_TEST_CHANGED:-}" ] && [ -z "${TEST_HW_NESTED:-}" ] \
   && [ -z "${HW_TEST_NO_TOUCHED:-}" ] && [ -f "$HERE/gate-select" ]; then
  _tc_live="${TEST_HW_LIVE_ROOT:-$SOURCE_ROOT}"   # the snapshot has no .git: the diff is the live checkout's
  _tc_base=""
  for _tc_ref in main origin/main; do
    _tc_base="$(git -C "$_tc_live" merge-base HEAD "$_tc_ref" 2>/dev/null)" && [ -n "$_tc_base" ] && break
    _tc_base=""
  done
  if [ -z "$_tc_base" ]; then
    printf 'runner: no main to diff against — the fast gate runs no touched slow subject\n' >&2
  else
    _tc_file="$(mktemp "${TMPDIR:-/tmp}/hw-touched.XXXXXX")"
    { git -C "$_tc_live" -c core.quotepath=off diff --name-only "$_tc_base"; git -C "$_tc_live" -c core.quotepath=off ls-files -o --exclude-standard; } \
      2>/dev/null | sort -u > "$_tc_file"
    _tc_pat=""
    if [ -f "$HERE/hooks/suite-trigger-pattern.sh" ]; then
      _tc_pat="$(. "$HERE/hooks/suite-trigger-pattern.sh" && printf '%s' "${SUITE_TRIGGER_PATTERN:-}")" || _tc_pat=""
    fi
    _tc_rc=0
    _tc_out="$(python3 "$HERE/gate-select" "$SOURCE_ROOT" "$_tc_file" "$_tc_pat" touched 2>&1)" || _tc_rc=$?
    rm -f "$_tc_file"
    if [ "$_tc_rc" -ne 0 ]; then
      printf 'runner: setup/gate-select touched failed (exit %s) — no touched slow subject runs: %s\n' "$_tc_rc" "$(printf '%s' "$_tc_out" | tail -1)" >&2
    else
      while read -r _tc_kind _tc_name _tc_rest; do
        [ "$_tc_kind" = touched ] && [ -f "$TESTS/$_tc_name" ] && FILES+=("$TESTS/$_tc_name") && TOUCHED_RUN=$((TOUCHED_RUN + 1))
      done <<< "$_tc_out"
      if [ -n "$_tc_out" ]; then
        printf 'runner: %s slow subject(s) name what this branch changed since %s and run with the fast gate:\n' "$TOUCHED_RUN" "$(printf '%s' "$_tc_base" | cut -c1-9)" >&2
        printf '%s\n' "$_tc_out" | sed -n 's/^touched \([^ ]*\) \(.*\)/    touched  \1  <- \2/p; s/^touched-skipped \([^ ]*\) \([^ ]*\) \(.*\)/    SKIPPED  \1 (\2s, over touched_budget_seconds)  <- \3: left to the full run/p' >&2
      fi
    fi
  fi
fi

# ── A GREEN FAST GATE LEAVES A VERDICT, MARKED gate=fast ────────────────────
#
# Each setup task paid TWO full suites (measured 2026-09-30: 965s alone,
# 1106-2316s contended): the executor's, because pre-push demanded a full
# verdict for every ref, `task/*` included, and the brainer's on the merge tree.
# The merge tree is the one that reaches main, so the executor's full run bought
# nothing the brainer's did not. pre-push now accepts, for `refs/heads/task/*`
# ONLY, a fast-gate verdict of the exact tree; main still needs a full one.
#
# SAME CACHE, OTHER NAME: `<tree>.fast`, never `<tree>`. Every full-verdict
# reader in pre-push reads `<tree>` or skips any name that is not 40 hex, so a
# fast verdict cannot be read as a full one by a reader that forgets the gate,
# and it cannot overwrite a full verdict of the same tree.
#
# DECIDED BEFORE THE RUN, on the live checkout, with verify-for-push's rule: the
# bytes under test must be HEAD's wherever SUITE_TRIGGER_PATTERN reaches. A
# pre-commit run tests staged bytes that are not HEAD's yet, so it caches
# nothing. A tree with no git or no pattern file (a fixture) caches nothing.
FAST_VERDICT_DIR=""; FAST_VERDICT_TREE=""; FAST_VERDICT_COMMIT=""; FAST_VERDICT_WHY=""
_fast_verdict_prepare() {
  local live="${TEST_HW_LIVE_ROOT:-}" dirty common
  [ -n "$live" ] || { FAST_VERDICT_WHY="no live checkout named"; return 0; }
  if [ ! -f "$SOURCE_ROOT/setup/hooks/suite-trigger-pattern.sh" ]; then
    FAST_VERDICT_WHY="setup/hooks/suite-trigger-pattern.sh is absent"; return 0
  fi
  . "$SOURCE_ROOT/setup/hooks/suite-trigger-pattern.sh"
  [ -n "${SUITE_TRIGGER_PATTERN:-}" ] || { FAST_VERDICT_WHY="SUITE_TRIGGER_PATTERN is empty"; return 0; }
  FAST_VERDICT_COMMIT="$(git -C "$live" rev-parse --verify -q HEAD 2>/dev/null)" \
    && FAST_VERDICT_TREE="$(git -C "$live" rev-parse --verify -q 'HEAD^{tree}' 2>/dev/null)" \
    && common="$(git -C "$live" rev-parse --git-common-dir 2>/dev/null)" \
    || { FAST_VERDICT_TREE=""; FAST_VERDICT_WHY="$live is not a git checkout with a HEAD"; return 0; }
  if ! dirty="$(git -C "$live" diff --name-only HEAD 2>/dev/null)"; then
    FAST_VERDICT_TREE=""; FAST_VERDICT_WHY="could not compute which tracked paths are dirty"; return 0
  fi
