# ── WHETHER A SUBJECT IS IN THE COMMIT, AND WHY THE TALLY NOW ASKS ──────────
#
# THE INSTRUMENT HAD THE DISEASE IT WAS MEASURING. Today this suite closed four
# instances of one failure — a green that only held for whoever measured it: an
# uncommitted `${AGENT:-}` fix, a leaked pane environment, fifteen mutation arms
# nothing evaluated, and an untracked file a tracked subject required. Then the
# result was reported as a single integer produced by THIS file, which globs
# `[0-9][0-9]*-*.sh` and never asks git anything. Measured 2026-09-02 by the
# second-vendor reviewer: `47-unattended-gate-stall.sh` and
# `48-plain-opencode-is-not-plain.sh` are UNTRACKED and absent from e8f7d23, and
# the 1187 everyone had been quoting silently included their 20 ok.
#
# A HEADLINE NUMBER'S JOB IS TO BE QUOTED, and that is the whole argument. Every
# failure above happened because a number travelled away from the context that
# qualified it. The tracked count is the only one a reader can RE-DERIVE FROM THE
# SHA; a mixed count becomes unverifiable the moment it leaves this terminal. So
# the headline is tracked-only.
#
# BUT A BARE TRACKED INTEGER IS ALSO UNSAFE, because it hides that untracked
# subjects ran at all. So the untracked line is MANDATORY — including when the
# count is zero, since a qualification that disappears when it is not needed is
# how the unqualified number comes back.
#
# UNTRACKED SUBJECTS STILL RUN, deliberately. They are how anyone writes a new
# one, and refusing them would push work-in-progress to a filename outside the
# glob — which is the silent-skip failure the glob contract above exists to make
# impossible. Run them, count them apart, name them.
#
# FAILURE SEMANTICS ARE DELIBERATELY UNCHANGED: a red subject still stops the
# run, tracked or not. An untracked red is still a red, and making it
# non-blocking would let a broken work-in-progress hide behind a green headline —
# a different instance of this very disease. If that trade is ever wanted it is
# its own decision, not a side effect of counting.
TRACKED_OK=0
UNTRACKED_OK=0
UNKNOWN_OK=0
UNTRACKED_NAMES=""
UNKNOWN_NAMES=""

# AN ABORTED RUN SAYS SO ON STDOUT, and this goes beyond the reported finding.
# On every abort the diagnosis is on stderr and the summary never prints, so
# there is no number to quote — the opus reviewer verified exactly that. What a
# `2>/dev/null | tail` reader still sees is a tail of `ok -` lines and nothing
# marking the end, which reads like a completed green run. Each of those lines is
# individually true, so this is not the same defect; it is one line of cheap
# insurance against the same misreading. It changes no exit code and prints no
# number.
abort_marker() { printf '\nRUN ABORTED — no number for this run. See stderr for the failure.\n'; }  # MUTATION-ANCHOR: 55-M06

# `unknown` IS A REAL ANSWER AND IS NEVER FOLDED INTO `tracked`. Outside a git
# work tree — an exported tarball, a copied directory — tracking cannot be
# established, and claiming it can is the same unverified-absence mistake this
# whole file is about. It is reported as its own bucket instead.
GIT_USABLE=0
if [ "$_snap_phys" = "$SOURCE_ROOT" ]; then
  GIT_USABLE="${TEST_HW_GIT_USABLE:?snapshot tracking classification missing}"
elif command -v git >/dev/null 2>&1 && git -C "$TESTS" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  GIT_USABLE=1
fi
tracking_of() { # <path> → tracked | untracked | unknown
  if [ "$GIT_USABLE" != 1 ]; then printf 'unknown'; return 0; fi  # MUTATION-ANCHOR: 55-M03
  if [ "$_snap_phys" = "$SOURCE_ROOT" ]; then
    python3 - "$TEST_HW_TRACKING_MANIFEST" "$SOURCE_ROOT" "$1" <<'PY'
import json, pathlib, sys
manifest = json.loads(pathlib.Path(sys.argv[1]).read_text())
name = str(pathlib.Path(sys.argv[3]).relative_to(sys.argv[2]))
print('tracked' if name in manifest['tracked'] else 'untracked', end='')
PY
    return
  fi
  if git -C "$TESTS" ls-files --error-unmatch -- "$1" >/dev/null 2>&1; then
    printf 'tracked'
  else
    printf 'untracked'
  fi
}
# count_into <path> <output file> — attribute a run's `ok -` lines to its bucket
count_into() {
  local _n
  _n="$(grep -c '^ok - ' "$2" 2>/dev/null || true)"
  case "${_n:-0}" in ''|*[!0-9]*) _n=0 ;; esac
  case "$(tracking_of "$1")" in
    tracked)   TRACKED_OK=$((TRACKED_OK + _n)) ;;
    untracked) UNTRACKED_OK=$((UNTRACKED_OK + _n))
               UNTRACKED_NAMES="$UNTRACKED_NAMES
      $(basename "$1")  ($_n ok)" ;;
    *)         UNKNOWN_OK=$((UNKNOWN_OK + _n))
               UNKNOWN_NAMES="$UNKNOWN_NAMES
      $(basename "$1")  ($_n ok)" ;;
  esac
}

# ── ONE MACHINE, ONE POOL OF WORKERS, AND THE SUBJECTS THAT RUN ALONE ───────
#
# TWO FULL RUNS AT ONCE WERE TWELVE WORKERS ON A MACHINE MEASURED FOR SIX. The
# per-run cap below (JOBS) says nothing about a SECOND run started from another
# worktree or by another agent. Measured 2026-09-22/23: five verify-for-push runs
# aborted on timing subjects, every one of them with another full suite running
# beside it, and every one green alone.
#
# THE FIRST ANSWER WAS ONE FULL SUITE PER MACHINE (a lock, 2026-09-23), and it
# made every verify-for-push wait 20-40 minutes behind whoever was first. What
# it protected was two things, and neither needs a whole suite to wait:
#
#   · THE MACHINE'S LOAD. So every job, of every suite, now takes a WORKER SLOT
#     from one pool per machine: `$WORK/.locks/suite-pool/slot.<k>`, k below
#     MACHINE_JOBS. Two suites share the slots; neither waits for the other to
#     finish, only for a slot to free.
#   · THE TIMING SUBJECTS. A subject that asserts inside a wall-clock budget it
#     did not set DECLARES it, in its own header:
#
#         # suite-lane: exclusive — <why, and what was measured>
#
#     and runs with NO OTHER JOB BESIDE IT, OF ANY SUITE. It holds
#     `$WORK/.locks/suite-pool/exclusive` and starts only when every slot on the
#     machine is empty. A runner that wants it leaves `wait.<pid>` first; while
#     any live waiter or holder exists, no runner starts a new pooled job — so
#     the machine drains and the waiter's turn comes. Pool jobs claim their slot
#     BEFORE they look for a waiter, and a waiter announces itself BEFORE it
#     looks at the slots, so one of the two always sees the other.
#
# AND WHAT THE LOCK WAS SAID TO PROTECT THAT IT DID NOT. setup/decisions
# (2026-09-16) credited it with keeping fixture tokens off live panes. The one
# time that happened (2026-09-15) it was a SINGLE run writing onto the pane of
# the agent running it — no lock between two suites could have stopped it. What
# stops it is tests/_common.sh (every HERDR_* swept, the socket pointed at a
# path that does not exist, a HOME of the run's own), pinned by tests/145, and
# the witness below, which every full run now carries.
#
# ALL OF IT IS ONE DIRECTORY UNDER $WORK, the same per-machine root the lock
# used. bin/hw is not involved: this file is the only thing that starts setup
# subjects in parallel, so it is the only thing that has to agree with itself.
#
# WHAT DOES NOT TAKE A SLOT, each on purpose:
#   · a subject run alone (`bash setup/tests/NN-*.sh`) — it never enters here.
#   · a NESTED runner (TEST_HW_NESTED): 55, 84, 117 and 131 drive copies of this
#     file from inside a job that already holds a slot — or the exclusive, which
#     a child waiting for a slot would deadlock against.
#
# AND THE FAST GATE DOES TAKE ONE, which the lock deliberately did not ("a commit
# must not queue behind a twenty-minute run"). The queue it can meet now is not a
# run but a job: at most one slot's worth of waiting, or — while another suite
# runs a timing subject alone — that subject plus the drain before it (the
# longest in-flight job, the guard arm's ~170s at worst). The trade is taken on
# purpose: "alone" has to mean alone from every suite, and a pre-commit fast
# gate beside a timing subject is exactly the neighbour its budget cannot
# afford. A subject run by hand, or a brief that pins one bare, takes no slot
# and is not coordinated — pin it through the runner if it must be.
#
# AND ONE RACE THAT IS STATED RATHER THAN CLOSED. Reclaiming an orphan is
# look-then-remove, so two runners that judge the same dead holder at the same
# moment can, in the window between, remove a slot a third runner has just
# claimed afresh — one job too many, for one job. It needs a SIGKILLed holder to
# exist at all; bin/hw's lane lock has had the same window since it was written.
#
# A HOLDER WHOSE PROCESS IS GONE IS RECLAIMED AT ONCE AND SAID OUT LOUD — pid
# AND process start time, the rule bin/hw's locks use. A wait always says who
# it is waiting for, once per change of who that is. Nothing is ever killed.
# WORK IS RESOLVED THE WAY bin/hw RESOLVES IT: the caller's WORK, else the
# lane table's `work` with a leading ~ as $HOME (bin/project-spaces.sh,
# lane_config_load). The same directory, or the pool is two pools. A tree with
# no readable table (a fixture runner) and no WORK takes no slot, and says so.
SUITE_WORK="${WORK:-}"
if [ -z "$SUITE_WORK" ]; then
  SUITE_WORK="$(jq -r '.work // empty' "$SOURCE_ROOT/projects.json" 2>/dev/null || true)"
  case "$SUITE_WORK" in
    "~") SUITE_WORK="$HOME" ;;
    "~/"*) SUITE_WORK="$HOME/${SUITE_WORK#"~/"}" ;;
  esac
fi
POOL_DIR="${SUITE_WORK:+$SUITE_WORK/.locks/suite-pool}"
POOL_ROOT="${TEST_HW_LIVE_ROOT:-$SOURCE_ROOT}"
POOL_ON=0
POOL_EXCL_MINE=0     # this runner holds $POOL_DIR/exclusive
POOL_WAITING=0       # this runner has $POOL_DIR/wait.$$ on disk
POOL_SAID=""         # the last wait announced, so it is said once per change
POOL_BACKOFF=0       # poll ticks to skip after a failed claim
if [ -z "${TEST_HW_NESTED:-}" ]; then
  if [ -z "$POOL_DIR" ]; then
    printf 'runner: no WORK and no `work` in %s — this run takes NO machine worker slots, so it is not coordinated with other suites\n' \
      "$SOURCE_ROOT/projects.json" >&2
  elif mkdir -p "$POOL_DIR" 2>/dev/null; then
    POOL_ON=1
  else
    printf 'runner: could not create %s — this run takes NO machine worker slots, so it is not coordinated with other suites\n' \
      "$POOL_DIR" >&2
  fi
fi

_pool_proc_start() { ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' || true; }
# 0 = the holder recorded in <dir> is alive and is the SAME process. An absent
# owner is a claim in progress until the directory is a minute old — reaping it
# earlier would let two runners into one slot.
_pool_dir_alive() { # <dir>
  local owner start
  owner="$(cat "$1/owner.pid" 2>/dev/null || true)"
  case "$owner" in
    ''|*[!0-9]*)
      # A failed `find` prints nothing, the same bytes as "not old yet", and
      # both land on LIVE-and-wait — the safe direction.
      [ -n "$(find "$1" -maxdepth 0 -mmin +1 2>/dev/null || true)" ] || return 0  # lint-shell: measured-elsewhere
      return 1 ;;
  esac
  kill -0 "$owner" 2>/dev/null || return 1
  start="$(cat "$1/owner.start" 2>/dev/null || true)"
  [ -n "$start" ] || return 0
  [ "$(_pool_proc_start "$owner")" = "$start" ]
}
_pool_mine() { [ "$(cat "$1/owner.pid" 2>/dev/null || true)" = "$$" ]; }  # lint-shell: measured-elsewhere
_pool_write_owner() { # <dir> <job>
  printf '%s\n' "$$"                  > "$1/owner.pid"   2>/dev/null || true
  _pool_proc_start "$$"               > "$1/owner.start" 2>/dev/null || true
  date +%s                            > "$1/owner.at"    2>/dev/null || true
  printf '%s\n' "$POOL_ROOT"          > "$1/owner.root"  2>/dev/null || true
  printf '%s\n' "${HW_TASK:-<not an hw task>}" > "$1/owner.task" 2>/dev/null || true
  printf '%s\n' "$2"                  > "$1/owner.job"   2>/dev/null || true
}
_pool_holder_line() { # <dir>
  local owner at root job age=""
  owner="$(cat "$1/owner.pid" 2>/dev/null || true)"
  at="$(cat "$1/owner.at" 2>/dev/null || true)"
  root="$(cat "$1/owner.root" 2>/dev/null || true)"
  job="$(cat "$1/owner.job" 2>/dev/null || true)"
  case "$at" in ''|*[!0-9]*) : ;; *) age="$(( $(date +%s) - at ))s" ;; esac
  printf 'pid %s, worktree %s%s%s' "${owner:-<none recorded>}" "${root:-<not recorded>}" \
    "${job:+, running $job}" "${age:+, for $age}"
}
# A waiter is ONE FILE, written aside and renamed in, so it is never read half
# written: its name carries the pid, its content the process start time.
_pool_waiter_alive() { # <file>
  local pid="${1##*.}" start
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  start="$(cat "$1" 2>/dev/null || true)"
  [ -n "$start" ] || return 0
  [ "$(_pool_proc_start "$pid")" = "$start" ]
}
_pool_say() { # <signature> <message> — once per change of who is being waited for
  [ "$1" != "$POOL_SAID" ] || return 0
  POOL_SAID="$1"
  printf 'runner: %s\n' "$2" >&2
}
_pool_reclaim() { # <dir> <what>
  printf 'runner: reclaiming an ORPHANED %s — %s is not running any more\n' "$2" "$(_pool_holder_line "$1")" >&2
  rm -rf "$1" 2>/dev/null || true
}
# 0 = somebody ELSE holds or is waiting for the exclusive, so no new pooled job
# may start on this machine. Dead holders and dead waiters are cleared here.
_pool_blocked() {
  local w
  if [ -d "$POOL_DIR/exclusive" ] && [ "$POOL_EXCL_MINE" != 1 ]; then
    if _pool_dir_alive "$POOL_DIR/exclusive"; then
      _pool_say "x:$(cat "$POOL_DIR/exclusive/owner.pid" 2>/dev/null || true):$(cat "$POOL_DIR/exclusive/owner.job" 2>/dev/null || true)" \
        "WAITING — a timing subject is running ALONE on this machine: $(_pool_holder_line "$POOL_DIR/exclusive"). Nothing is being killed."
      return 0
    fi
    _pool_reclaim "$POOL_DIR/exclusive" "exclusive slot"
  fi
  for w in "$POOL_DIR"/wait.*; do
    [ -e "$w" ] || continue
    [ "$w" != "$POOL_DIR/wait.$$" ] || continue
    case "$w" in *.part) continue ;; esac
    if _pool_waiter_alive "$w"; then
      _pool_say "w:${w##*.}" "WAITING — pid ${w##*.} is waiting to run a timing subject alone, so this run starts nothing new until it has. Nothing is being killed."
      return 0
    fi
    rm -f "$w" 2>/dev/null || true
  done
  return 1
}
# _pool_take_slot <idx> — 0 and JOB_SLOT[idx] set when a slot was claimed.
_pool_take_slot() {
  local idx="$1" k=0 d reclaimed=0
  _pool_blocked && return 1
  while [ "$k" -lt "$MACHINE_JOBS" ]; do  # MUTATION-ANCHOR: 176-M02
    d="$POOL_DIR/slot.$k"
    if mkdir "$d" 2>/dev/null; then
      _pool_write_owner "$d" "$(basename "${JOB_PATH[$idx]}")"
      # CLAIM, THEN LOOK. A waiter that arrived while this slot was being taken
      # has already written its wait file, or it will see this slot when it
      # looks — one of the two is always true, never neither.
      if _pool_blocked; then rm -rf "$d" 2>/dev/null || true; return 1; fi
      JOB_SLOT[$idx]="$d"
      POOL_SAID=""
      return 0
    fi
    if [ "$reclaimed" -lt "$MACHINE_JOBS" ] && ! _pool_dir_alive "$d"; then
      _pool_reclaim "$d" "worker slot"
      reclaimed=$((reclaimed + 1))
      continue
    fi
    k=$((k + 1))
  done
  _pool_say "full" "WAITING for a machine worker — all $MACHINE_JOBS are busy (e.g. $(_pool_holder_line "$POOL_DIR/slot.0")). Nothing is being killed."
  return 1
}
_pool_release_slot() { # <idx>
  local d="${JOB_SLOT[$1]:-}"
  [ -n "$d" ] || return 0
  if _pool_mine "$d"; then rm -rf "$d" 2>/dev/null || true; fi
  JOB_SLOT[$1]=""
}
# _pool_excl_step <idx> — 0 when the exclusive subject may start NOW: this
# runner holds the exclusive and every slot on the machine is empty.
_pool_excl_step() {
  local idx="$1" d busy=""
  if [ "$POOL_WAITING" != 1 ]; then
    _pool_proc_start "$$" > "$POOL_DIR/wait.$$.part" 2>/dev/null || true
    mv -f "$POOL_DIR/wait.$$.part" "$POOL_DIR/wait.$$" 2>/dev/null || true
    POOL_WAITING=1
  fi
  if [ "$POOL_EXCL_MINE" != 1 ]; then
    if mkdir "$POOL_DIR/exclusive" 2>/dev/null; then
      _pool_write_owner "$POOL_DIR/exclusive" "$(basename "${JOB_PATH[$idx]}") (waiting for the machine to drain)"
      POOL_EXCL_MINE=1
    elif ! _pool_dir_alive "$POOL_DIR/exclusive"; then
      _pool_reclaim "$POOL_DIR/exclusive" "exclusive slot"
      return 1
    else
      _pool_say "x:$(cat "$POOL_DIR/exclusive/owner.pid" 2>/dev/null || true):$(cat "$POOL_DIR/exclusive/owner.job" 2>/dev/null || true)" \
        "WAITING to run $(basename "${JOB_PATH[$idx]}") alone — another timing subject has the machine: $(_pool_holder_line "$POOL_DIR/exclusive"). Nothing is being killed."
      return 1
    fi
  fi
  for d in "$POOL_DIR"/slot.*; do
    [ -e "$d" ] || continue
    if _pool_dir_alive "$d"; then
      busy="$busy $(cat "$d/owner.pid" 2>/dev/null || true)"
    else
      _pool_reclaim "$d" "worker slot"
    fi
  done
  if [ -n "$busy" ]; then
    _pool_say "d:$busy" "WAITING to run $(basename "${JOB_PATH[$idx]}") alone — the machine is draining; still running: $(for d in "$POOL_DIR"/slot.*; do [ -e "$d" ] && printf '[%s] ' "$(_pool_holder_line "$d")"; done). No new job starts on this machine until it has run. Nothing is being killed."
    return 1
  fi
  printf '%s\n' "$(basename "${JOB_PATH[$idx]}")" > "$POOL_DIR/exclusive/owner.job" 2>/dev/null || true
  POOL_SAID=""
  return 0
}
_pool_excl_release() {
  if [ "$POOL_EXCL_MINE" = 1 ]; then
    if _pool_mine "$POOL_DIR/exclusive"; then rm -rf "$POOL_DIR/exclusive" 2>/dev/null || true; fi
    POOL_EXCL_MINE=0
  fi
  if [ "$POOL_WAITING" = 1 ]; then rm -f "$POOL_DIR/wait.$$" 2>/dev/null || true; POOL_WAITING=0; fi
}
# Everything this runner holds, on every exit the shell can see. SIGKILL is the
# one it cannot, which is what the orphan reclaim above is for.
_pool_release_all() {
  local i=0
  [ "$POOL_ON" = 1 ] || return 0
  while [ "$i" -lt "${#JOB_SLOT[@]}" ]; do _pool_release_slot "$i"; i=$((i + 1)); done
  _pool_excl_release
}
JOB_SLOT=(); JOB_SLOT_SEEN=()

TALLY="$(mktemp "${TMPDIR:-/tmp}/hw-test-tally.XXXXXX")"
trap 'rm -f "$TALLY" "$TALLY.subject"; _pool_release_all; _queue_release' EXIT

# ── ONE FULL SUITE PER MACHINE AT A TIME, IN ARRIVAL ORDER (2026-09-30) ─────
#
# THE LOCK OF 2026-09-23 IS BACK, AS A QUEUE, BECAUSE THE SUITE GOT SHORT. It
# was removed because waiting behind another full run cost 20-40 minutes; the
# pool above replaced it. Then the pool's own answer was measured
# on 2026-09-30: full suites side by side still turn timing subjects red — rc.4's
# cut went red three times on load flakes (64 min), return-channel lost ~72
# min, observabilidad ~31, ~170 min in one day — and each red is a whole re-run.
# The full suite is ~495s now, so the worst wait behind one other is ~8
# minutes, cheaper than the re-run it prevents.
#
# SO A FULL, TOP-LEVEL RUN TAKES A TICKET and starts only when it is the oldest
# live ticket on the machine AND holds `running` (mkdir, so two runners that
# both think they are first cannot both start). A second run WAITS — it does
# not fail — and says whom it waits for and since when, once per change.
# verify-for-push and release/cut are full runs of this file, so they queue
# too. A ticket or a `running` whose process is gone (pid AND start time, as
# the pool judges) is reclaimed at once and said out loud.
#
# WHAT DOES NOT QUEUE: the fast gate (a commit must not wait ~8 minutes; its
# timing subjects still wait for the pool beside a full run, as before), a
# nested runner (its parent holds the turn), a run with no WORK (no pool
# either, and it says so above), and a fixture that sets
# TEST_HW_SUITE_QUEUE=off to race two full runners on purpose (tests/176,
# which is about the pool, not about this queue). Not an HW_* name, so
# tests/_common.sh does not sweep it out of the subject that sets it.
QUEUE_DIR="${SUITE_WORK:+$SUITE_WORK/.locks/suite-queue}"
QUEUE_TICKET=""; QUEUE_RUNNING_MINE=0
_queue_release() {
  if [ "$QUEUE_RUNNING_MINE" = 1 ]; then
    if _pool_mine "$QUEUE_DIR/running"; then rm -rf "$QUEUE_DIR/running" 2>/dev/null || true; fi
    QUEUE_RUNNING_MINE=0
  fi
  if [ -n "$QUEUE_TICKET" ]; then rm -rf "$QUEUE_TICKET" 2>/dev/null || true; QUEUE_TICKET=""; fi
}
_queue_line() { # <dir> — who, where, for which task, since when
  local task
  task="$(cat "$1/owner.task" 2>/dev/null || true)"
  printf '%s%s' "$(_pool_holder_line "$1")" "${task:+, task $task}"
}
if [ "$HW_TEST_GATE" = full ] && [ "$POOL_ON" = 1 ] && [ -z "${TEST_HW_NESTED:-}" ] \
   && [ "${TEST_HW_SUITE_QUEUE:-on}" != off ] && mkdir -p "$QUEUE_DIR" 2>/dev/null; then  # MUTATION-ANCHOR: 360-M01
  trap '_queue_release; exit 130' INT
  trap '_queue_release; exit 143' TERM
  _q_now="$(python3 -c 'import time; print("%020d" % time.time_ns())')"
  QUEUE_TICKET="$QUEUE_DIR/t.$_q_now.$$"
  mkdir "$QUEUE_TICKET"
  _pool_write_owner "$QUEUE_TICKET" "a full suite (queued)"
  _q_t0="$(date +%s)"; _q_said=""
  while :; do
    _q_ahead=""; _q_pos=1
    for _t in "$QUEUE_DIR"/t.*; do
      [ -d "$_t" ] || continue
      [ "$_t" != "$QUEUE_TICKET" ] || break      # the glob sorts: the rest arrived later
      if _pool_dir_alive "$_t"; then
        [ -n "$_q_ahead" ] || _q_ahead="$_t"
        _q_pos=$((_q_pos + 1))
      else
        _pool_reclaim "$_t" "full-suite queue ticket"
      fi
    done
    _q_hold=""
    if [ -d "$QUEUE_DIR/running" ]; then
      if _pool_dir_alive "$QUEUE_DIR/running"; then _q_hold="$QUEUE_DIR/running"
      else _pool_reclaim "$QUEUE_DIR/running" "full-suite turn"; fi
    fi
    if [ -z "$_q_ahead" ] && [ -z "$_q_hold" ] && mkdir "$QUEUE_DIR/running" 2>/dev/null; then
      _pool_write_owner "$QUEUE_DIR/running" "a full suite"
      QUEUE_RUNNING_MINE=1
      _q_waited=$(( $(date +%s) - _q_t0 ))
      [ "$_q_waited" -eq 0 ] || printf 'runner: the full-suite turn is ours after waiting %ss in the queue\n' "$_q_waited" >&2
      break
    fi
    _q_who="${_q_hold:-$_q_ahead}"
    if [ -n "$_q_who" ] && [ "$_q_said" != "$(cat "$_q_who/owner.pid" 2>/dev/null || true):$_q_pos" ]; then
      _q_said="$(cat "$_q_who/owner.pid" 2>/dev/null || true):$_q_pos"
      printf 'runner: WAITING for the machine'"'"'s full-suite turn (queued at %s, position %s): %s %s. Only one full suite runs per machine; this run starts when it is first. Nothing is being killed.\n' \
        "$(date -r "$_q_t0" +%H:%M:%S 2>/dev/null || date -d "@$_q_t0" +%H:%M:%S 2>/dev/null || printf '%ss ago' "$(( $(date +%s) - _q_t0 ))")" "$_q_pos" \
        "$([ -n "$_q_hold" ] && printf 'running now —' || printf 'next in line —')" "$(_queue_line "$_q_who")" >&2
    fi
    sleep 1
  done
  trap - INT TERM
fi

# A MUTATION ARM NOBODY RUNS IS NOT COVERAGE, and this is where that is caught.
#
# Measured 2026-08-28: a delivered task reported "killed 18 committed-byte
# mutants". All 18 existed and all 18 died — and none of them ran. Seven subject
# files had wrapped their arms in `if [ "${<SUBJECT>_MUTATION_TEST:-0}" = 1 ]`,
# a variable this runner never set, so a 909-ok / 0-not-ok run printed zero
# mutant lines and read as fully covered.
#
# The check belongs HERE and not inside a subject file: the runner already
# captures every subject's output, so asking "did it exercise what it declares"
# costs nothing, and it covers every subject rather than the ones someone
# remembered to list. It reads what a subject PRINTED, never how its source is
# written — an earlier source-shape scan flagged four innocents, and a check that
# cries wolf is ignored within a day. The predicate is `setup/mutation-coverage`,
# one copy, driven against fixtures with its own mutants by tests/46.
COVERAGE="$HERE/mutation-coverage"
[ -x "$COVERAGE" ] || { printf 'not ok - runner: %s is missing or not executable, so mutation coverage is unchecked\n' "$COVERAGE" >&2; exit 1; }

# ── HOW MANY AT ONCE, AND THE THREE THINGS THAT STAY ONE AT A TIME ──────────
#
# THE SUITE HAD TO FIT IN THE CLOSE BUDGET. `hw` gives a close verification 900s
# (`_VERIFY_TIMEOUT`, bin/hw) and the subjects measure 1119s of work between them
# (setup/test-budgets.json, 2026-09-16) — so no brief in this lane could name
# `bash setup/test-hw` in its own `## Verification` without the timeout killing
# the close at exit 124 over work that was fine. Raising the clock hides that;
# running the subjects at the same time is what actually shortens it.
#
# IT BUYS NO NEW ISOLATION AND NEEDS NONE. Every subject is ALREADY its own bash
# process with its own $TMP, its own trap and its own helper names — that is what
# "it runs each subject file as its own bash process; it does not source them"
# has always bought. Running several at once is the same isolation with the
# waiting taken out; it is not a new claim about hermeticity, and where a subject
# turns out to share state with another the answer is to name it and give it the
# serial lane below, never to widen what the runner promises.
#
# WHAT IS NOT PARALLEL, each for its own reason:
#
#   · THE FAST GATE, because its budget check times each subject ON THE RUN THAT
#     IS PAYING FOR IT (below). A duration measured against thirteen neighbours
#     is not that subject's duration, and a gate that refuses a file because the
#     machine was busy is a gate nobody can act on.
#   · (NOT the guards, since 2026-09-30.) Their lane held one job at a time on
#     the belief that `setup/guards/test-deny-repo-writes.mjs` WRITES
#     `/tmp/deny-repo-writes-out`; read on 2026-09-23, it only renders that path
#     into the command strings the guard judges, and every guard driver mkdtemps
#     its own sandbox — the mutation arm has run four decision drivers at once
#     ever since. Kept one at a time, the lane was a chain on the critical path:
#     the arm, then the ~75s decision driver, then the other three, in series,
#     while the pool had free workers. They are pooled jobs like any other now;
#     `guards` still names their HOME and artifacts (below), not a queue.
#   · A NESTED RUNNER. tests/55, 84, 117 and 131 each drive a real copy of THIS
#     FILE over fixture subjects. A fan-out inside a fan-out multiplies, so
#     TEST_HW_NESTED pins every runner this one starts to one at a time. It is
#     deliberately NOT an `HW_*` name: tests/_common.sh sweeps that whole prefix
#     out of every subject's environment, which is exactly where this has to
#     survive to reach the runner the subject then starts.
#
# AND THE OUTPUT IS BUFFERED PER JOB AND EMITTED IN GLOB ORDER. Interleaved
# `ok -` lines from fourteen subjects are not a report. Each job's stdout is
# collected to its own file and replayed when its turn comes, so two runs of the
# same tree print the same lines in the same order whatever the machine was
# doing — which is what makes `diff` between a sequential run and a parallel one
# a comparison rather than a shuffle. Its stderr is buffered the same way and
# replayed on stderr immediately after, which is where a `fail` already was.
#
# AND THE DEFAULT IS HALF THE CORES, CAPPED AT SIX — MEASURED, NOT CHOSEN.
# Every subject was run twice over the same tree on a 14-core machine, once with
# fourteen at a time and once with six, and every verdict compared (2026-09-16):
#
#   at 14 — 33-killed-sender, 40-nonblocking-set-wait, 43-executor-turn-end,
#           54-the-suite-is-environment-independent and
#           99-unverified-publication-through-callers all FLIPPED to red, plus
#           117 and 131 inside the runner. Every one of them asserts something
#           inside a wall-clock budget it did not set: a 2s wait that must settle,
#           a sender that must die at 143 rather than time out first, a 10s
#           subprocess cap, two runs that must be byte-identical. A busy machine
#           is not a property of the tree, so those reds were about nothing.
#   at  6 — none of them flipped.
#
# AND IT COSTS NOTHING. The longest single subject is 227s
# (111-refuse-the-unwinnable-wait.sh) and the whole suite is 1119s, so six
# workers finish the other 150 in ~190s — under the floor 111 sets on its own.
# Fourteen workers cannot beat 227s either. The cap buys the honest verdicts for
# free, which is why it is a cap and not a tuning knob someone should raise.
# HW_TEST_JOBS overrides it; above six, expect the subjects named above to go red
# for reasons that have nothing to do with the tree.
_test_hw_default_jobs() {
  local n=""
  if command -v sysctl >/dev/null 2>&1; then n="$(sysctl -n hw.ncpu 2>/dev/null || true)"; fi
  if [ -z "$n" ] && command -v getconf >/dev/null 2>&1; then n="$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)"; fi
  case "${n:-}" in ''|*[!0-9]*) n=4 ;; esac
  n=$((n / 2))
  [ "$n" -ge 2 ] || n=2
  [ "$n" -le 6 ] || n=6
  printf '%s' "$n"
}
JOBS="${HW_TEST_JOBS:-}"
if [ -n "$JOBS" ]; then
  case "$JOBS" in
    ''|*[!0-9]*|0) printf 'not ok - runner: HW_TEST_JOBS must be a positive integer (got: %s)\n' "$JOBS" >&2; exit 1 ;;
  esac
fi
[ -n "$JOBS" ] || JOBS="$(_test_hw_default_jobs)"
if [ -n "${TEST_HW_NESTED:-}" ]; then
  JOBS=1
elif [ "$HW_TEST_GATE" = fast ] && [ "$JOBS" != 1 ]; then
  if [ -n "${HW_TEST_JOBS:-}" ]; then
    printf 'runner: HW_TEST_JOBS=%s ignored in the fast gate — its per-subject budget check only means something on an uncontended run\n' \
      "$HW_TEST_JOBS" >&2
  fi
  JOBS=1
fi
# THE MACHINE'S CAP, shared by every suite running on it (see the pool above).
# JOBS stays what ONE run may use; MACHINE_JOBS is what all of them together may.
#
# THE SAME NUMBER AS ONE RUN'S DEFAULT, AND THAT IS MEASURED, NOT MODEST. Six at
# once on this 14-core machine is the load at which no timing subject flipped
# (2026-09-16, above). A first cut of this pool let the machine take three
# quarters of its cores (10), and two suites filling it turned 22-hw-unstick
# and 37-chaining-lease red at a load average of 150-200 (2026-09-28) — both
# green alone, on the same tree, minutes later. So two suites now share the six
# a single one was measured safe at; what they gain is each other's idle slots
# (the drained tail, the exclusive lane, the stretches a run spends blocked on
# its own print order), not a bigger machine.
_test_hw_default_machine_jobs() { _test_hw_default_jobs; }
MACHINE_JOBS="${HW_TEST_MACHINE_JOBS:-}"
if [ -n "$MACHINE_JOBS" ]; then
  case "$MACHINE_JOBS" in
    ''|*[!0-9]*|0) printf 'not ok - runner: HW_TEST_MACHINE_JOBS must be a positive integer (got: %s)\n' "$MACHINE_JOBS" >&2; exit 1 ;;
  esac
fi
[ -n "$MACHINE_JOBS" ] || MACHINE_JOBS="$(_test_hw_default_machine_jobs)"
# THE DEFAULT FOLLOWS THE POOL, decided once, at start (2026-09-30). Briefs used
# to pin HW_TEST_JOBS=2 by hand for fear of a neighbour. Now, with no
# HW_TEST_JOBS: a machine where no other suite holds or waits for a slot gives
# this run every slot of the pool (MACHINE_JOBS); a machine where one does gives
# it 2, as the briefs did. The pool still caps the sum either way; this only
# decides how much of it one run reaches for. The idle number is the six measured
# safe alone on 2026-09-16 (above); the 2/4/6 re-measurement asked on 2026-09-30
# was not taken (the machine was at load 110), so it is not claimed here.
# setup/tests/251 holds the rule.
# AND A RUN THAT HOLDS THE FULL-SUITE TURN (the queue below) skips the check:
# no other full suite can be on the machine, only fast gates at one slot each,
# which the pool's cap already accounts for — dropping to 2 for them would
# halve the one full run the queue exists to keep fast.
if [ -z "${HW_TEST_JOBS:-}" ] && [ -z "${TEST_HW_NESTED:-}" ] && [ "$HW_TEST_GATE" = full ] && [ "$POOL_ON" = 1 ] \
   && [ "$QUEUE_RUNNING_MINE" = 1 ]; then
  # The turn's holder takes every slot of the pool. Skipping the block left it
  # at the cpu default instead, which is cpus/2: 2 on a 4-cpu runner, where P01
  # of tests/251 peaked at 2 of 4 (windows.yml 37032884829, wsl).
  JOBS="$MACHINE_JOBS"
elif [ -z "${HW_TEST_JOBS:-}" ] && [ -z "${TEST_HW_NESTED:-}" ] && [ "$HW_TEST_GATE" = full ] && [ "$POOL_ON" = 1 ]; then
  _pool_busy=""
  for _d in "$POOL_DIR"/slot.* "$POOL_DIR/exclusive"; do
    [ -e "$_d" ] || continue
    if _pool_dir_alive "$_d"; then _pool_busy="$_d"; break; fi
  done
  if [ -z "$_pool_busy" ]; then
    for _w in "$POOL_DIR"/wait.*; do
      case "$_w" in *.part) continue ;; esac
      [ -e "$_w" ] || continue
      if _pool_waiter_alive "$_w"; then _pool_busy="$_w"; break; fi
    done
  fi
  if [ -n "$_pool_busy" ]; then  # MUTATION-ANCHOR: 251-M01
    JOBS=2
    printf 'runner: another suite is on this machine (%s) — this run takes 2 jobs at once, not %s (HW_TEST_JOBS overrides)\n' \
      "$(basename "$_pool_busy")" "$MACHINE_JOBS" >&2
  else
    JOBS="$MACHINE_JOBS"
  fi
fi
export TEST_HW_NESTED=1

# ── THE JOB TABLE: every subject, then every guard, in the order they PRINT ──
#
# ONE LIST, because the guards are work like any other and the only thing that
# made them a separate block was that they ran after everything. They are still
# REPORTED after — this list is the print order — but a 140s arm that starts last
# is 140s added to the run, and started first it is free.
#
# AND THE SUBJECTS THAT RUN ALONE DECLARE IT THEMSELVES. A subject whose
# verdict depends on a wall-clock budget it did not set carries, in the comment
# block at the top of its own file (before its first command):
#
#     # suite-lane: exclusive — <why, and what was measured>
#
# and runs with no other job beside it, from this suite or any other (the pool
# above). THE DECLARATION LIVES IN THE SUBJECT, not in a list here, so the
# reason sits next to the budget that needs it and a subject that stops needing
# it loses it in the same commit that removed the budget. Only the header block
# is read: a subject that QUOTES the line — a fixture heredoc, an assertion —
# is not declaring it. tests/176 is what fails if a declared subject ever runs
# beside another job.
_lane_of() { # <subject path> → pool | exclusive
  awk 'NR == 1 && /^#!/ { next }
       /^#/ { if ($0 ~ /^# suite-lane: exclusive([^A-Za-z0-9_-]|$)/) { print "exclusive"; found = 1; exit } next }
       /^[[:space:]]*$/ { next }
       { exit }
       END { if (!found) print "pool" }' "$1" 2>/dev/null || printf 'pool'
}
# A SUBJECT WHOSE VERDICT DEPENDS ON THE CLOCK MAY DECLARE ITSELF RETRYABLE, in
# the same header block and with the same reading rules as the lane above:
#
#     # suite-timing: retry-once — <why, and what was measured>
#
# A declared subject that fails is run ONE more time (the subject by itself, not the suite; it still shares the machine with the other jobs) before the job is
# called red. The second run decides: green is green (the runner prints
# `RETRIED <subject>: <first failure>` and counts it in the summary), red is red.
# A subject that does NOT declare it is never retried — a red of logic stays red
# on the first run. Only the header is read, so quoting the line is not declaring.
_timing_of() { # <subject path> → retry | no
  awk 'NR == 1 && /^#!/ { next }
       /^#/ { if ($0 ~ /^# suite-timing: retry-once([^A-Za-z0-9_-]|$)/) { print "retry"; found = 1; exit } next }
       /^[[:space:]]*$/ { next }
       { exit }
       END { if (!found) print "no" }' "$1" 2>/dev/null || printf 'no'
}
JOB_PATH=(); JOB_KIND=(); JOB_LANE=(); JOB_HINT=()
for f in ${FILES[@]+"${FILES[@]}"}; do
  JOB_PATH+=("$f"); JOB_KIND+=("subject"); JOB_LANE+=("$(_lane_of "$f")"); JOB_HINT+=("")
done
# THE GUARD JOBS ARE FULL-GATE ONLY. `setup/guards/*` are not `setup/tests/*.sh`
# subjects, so the fast/slow split's completeness rule (every FILE in tests/ is
# in exactly one gate) does not apply to them directly — but the read-only
# guard is the rule CLAUDE.md calls the one that outranks the others, and its
# mutation arm is deliberately ~140s, which alone would blow past anything the
# fast gate could stay under. It still runs on every `full` invocation — every
# bare `bash setup/test-hw` and every mandatory pre-push — so it is never
# skipped, only deferred to the gate that already has the time budget for it.
# AND A SELECTED FAST GATE THAT TOUCHED A GUARD RUNS THE DRIVERS (not the
# mutation arm, which stays the full gate's): the brief's "los guards si se
# tocan guards" — the old fast gate ran no guard at all, even for a guard commit.
if [ "$HW_TEST_GATE" = full ] || [ "$GATE_GUARDS" = 1 ]; then
  # The read-only guard is ONE implementation behind eight lane shims (it was
  # eight independent copies until 2026-09-06, and they had drifted 11.5 KB
  # apart). Keep its shared vectors outside tests/ so concurrent subject work
  # cannot silently omit them.
  # THE GUARDS ARE CLASSIFIED THE SAME WAY, not assumed tracked. They are tracked
  # today; assuming it is how the subject glob came to assume it too.
  for _g in test-deny-repo-writes.mjs test-deny-repo-writes-filesystem.mjs \
            test-opencode-hw-blocked-reason.mjs test-herdr-opencode-background-state.mjs; do
    # THE HINT IS MEASURED, like the arm's: the decision driver is ~5500
    # python3 spawns, 71s alone on 2026-09-30; the other three are seconds.
    _h=5; [ "$_g" != test-deny-repo-writes.mjs ] || _h=75
    JOB_PATH+=("$HERE/guards/$_g"); JOB_KIND+=("guard-node"); JOB_LANE+=("guards"); JOB_HINT+=("$_h")
  done
fi
if [ "$HW_TEST_GATE" = full ]; then
  # AND THE MUTATION ARMS FOR THAT GUARD, which until 2026-09-02 nothing ran.
  #
  # `mutate-deny-repo-writes.sh` existed and worked; it was simply not wired to
  # anything, so its arms were a file someone had to remember. That is the
  # "a mutation arm nobody runs is not coverage" failure the per-subject
  # `mutation-coverage` check below exists to catch — and it could not catch this
  # one, because it only reads `setup/tests/*.sh` subjects and this is a guard.
  #
  # IT IS SLOW ON PURPOSE AND IT IS WORTH IT: ~140s, because each arm re-runs
  # both drivers against a mutated copy, across all six lanes. This guard is
  # the enforcement point for the rule CLAUDE.md calls the one that outranks
  # the others, and every arm here is a hole that was live in some copy at some
  # point. The hint below is what makes the pool start it first rather than let
  # it cost 140s at the end.
  JOB_PATH+=("$HERE/guards/mutate-deny-repo-writes.sh"); JOB_KIND+=("guard-mutate")
  # 270: 159-167s under the runner on 2026-09-23; the vectors then grew to ~5500
  # and it reached 1949s (2026-09-30, a full decision driver per mutant). Its
  # mutants now stop at their first failing assertion — the only line a kill is
  # judged on — and it measured 267s alone the same day. Still the longest job,
  # so still started first.
  JOB_LANE+=("guards"); JOB_HINT+=("270")
fi
# THE GUARD JOBS' HOME IS THE GUARD'S, NOT THE CALLER'S (since 2026-09-22).
# The subjects run under a HOME of their own (tests/_common.sh); the guard jobs
# are not subjects and never source it. They need HOME to be one specific value:
# the guard's protected roots come from `guards.json` at brain's root, where a
# leading `~` is the password-database home, and a vector that redirects into
# `$HOME/<a protected repo>/...` only names a protected root when $HOME expands
# to the home those roots live under. Measured the same day:
# `HOME=$(mktemp -d) bash setup/test-hw` failed 32
# `redirect-message-states-the-resolved-destination` vectors as ALLOWED. So the
# home is the one the guard itself expands `~` with (`_policy_home`), read only
# once `load_policy` has accepted `guards.json` — a fact of the code under test,
# not a path this runner names — and nothing under it is read or written.
#
# ONLY WHEN A GUARD JOB IS QUEUED, which is the full gate. The fast gate queues
# none, and a fixture tree that copies `setup/` alone (131's) has no
# `guards.json`: the guard module refuses to import there, by design, and there
# is no guard job for the value to reach. A tree with no guard module at all
# (117's fixture runners, whose guard jobs are stubs) keeps the caller's HOME:
# there is nothing there for the value to be read from. A tree that has the
# module, queues guard jobs and cannot read its policy stops here, naming the
# file.
GUARD_HOME="$HOME"
_guard_jobs=0
for _l in ${JOB_LANE[@]+"${JOB_LANE[@]}"}; do [ "$_l" = guards ] && _guard_jobs=1; done
if [ "$_guard_jobs" = 1 ] && [ -f "$HERE/guards/deny_repo_writes.py" ]; then
  GUARD_HOME="$(PYTHONDONTWRITEBYTECODE=1 python3 - "$HERE/guards" "$(dirname "$HERE")/guards.json" <<'PY'
import sys
sys.path.insert(0, sys.argv[1])
import deny_repo_writes as g
g.load_policy(sys.argv[2])
print(g._policy_home())
PY
)" || GUARD_HOME=""
  [ -n "$GUARD_HOME" ] || { printf 'not ok - runner: could not read the guard home from %s product_repos (guards/deny_repo_writes.py load_policy)\n' "$(dirname "$HERE")/guards.json" >&2; exit 1; }
fi
JOB_TOTAL="${#JOB_PATH[@]}"

JOBDIR="$(mktemp -d "${TMPDIR:-/tmp}/hw-test-jobs.XXXXXX")"

# ── WHERE THE WALL CLOCK WENT: HW_TEST_TIMINGS=<file> ───────────────────────
#
# A full run on 5bab697 took 1795s under verify-for-push and ~745s run file by
# file with `xargs -P 4`, while the comment on the default job count promised
# ~190s plus the longest subject. Nothing here said where the other ~1000s went:
# a job's own seconds were measured and thrown away at emit, and a wait for the
# machine's pool was said once on stderr and never summed. So a run given a
# file writes one TSV row per job, in print order, and a last `#run` row:
#
#   job kind lane slot launched started ended run_s rc cpu_s   (times: seconds after
#   the run's own start; `launched` is when it got a worker, `started` when the
#   subject's clock began, after its parse check; cpu_s is the subject's own
#   user+sys, blank for a guard job — run_s far above cpu_s is a job WAITING)
#   #run wall_s jobs machine_jobs excl_phase pool_wait_s excl_wait_s busy_s load
#
# pool_wait_s is time this run had a free worker of its own and the MACHINE'S
# pool refused it one; excl_wait_s is time spent draining the machine for the
# subjects that run alone. busy_s is the sum of every job's run_s, so
# busy_s / (wall_s * jobs) is how full this run kept its workers. Opt-in, and
# only at the top: a nested runner never sees it (tests/_common.sh sweeps HW_*).
TIMINGS="${HW_TEST_TIMINGS:-}"
RUN_T0="$(date +%s)"
TM_POOL_WAIT=0; TM_POOL_SINCE=""; TM_EXCL_WAIT=0; TM_EXCL_SINCE=""; TM_BUSY=0
JOB_LAUNCH_AT=()
if [ -n "$TIMINGS" ]; then
  printf 'job\tkind\tlane\tslot\tlaunched\tstarted\tended\trun_s\trc\tcpu_s\n' > "$TIMINGS" 2>/dev/null \
    || { printf 'runner: cannot write HW_TEST_TIMINGS=%s — this run records no timings\n' "$TIMINGS" >&2; TIMINGS=""; }
fi
_tm_wait() { # <pool|excl> <begin|end>
  [ -n "$TIMINGS" ] || return 0
  local now
  case "$1:$2" in
    pool:begin) [ -n "$TM_POOL_SINCE" ] || TM_POOL_SINCE="$(date +%s)" ;;
    excl:begin) [ -n "$TM_EXCL_SINCE" ] || TM_EXCL_SINCE="$(date +%s)" ;;
    pool:end) [ -z "$TM_POOL_SINCE" ] || { now="$(date +%s)"; TM_POOL_WAIT=$((TM_POOL_WAIT + now - TM_POOL_SINCE)); TM_POOL_SINCE=""; } ;;
    excl:end) [ -z "$TM_EXCL_SINCE" ] || { now="$(date +%s)"; TM_EXCL_WAIT=$((TM_EXCL_WAIT + now - TM_EXCL_SINCE)); TM_EXCL_SINCE=""; } ;;
  esac
}
_tm_row() { # <idx> — after its status was sourced
  [ -n "$TIMINGS" ] || return 0
  local idx="$1" rel=0 st=0 en=0 run=0 cpu=""
  [ "${JOB_KIND[$idx]}" != subject ] || [ "${cpu_ms:-0}" -le 0 ] || cpu="$(( cpu_ms / 1000 ))"
  [ -z "${JOB_LAUNCH_AT[$idx]:-}" ] || rel=$(( JOB_LAUNCH_AT[$idx] - RUN_T0 ))
  if [ "${started_at:-0}" -gt 0 ]; then st=$(( started_at - RUN_T0 )); en=$(( ended_at - RUN_T0 )); run=$(( ended_at - started_at )); fi
  TM_BUSY=$((TM_BUSY + run))
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(basename "${JOB_PATH[$idx]}")" "${JOB_KIND[$idx]}" "${JOB_LANE[$idx]}" \
    "$(basename "${JOB_SLOT_SEEN[$idx]:-none}")" "$rel" "$st" "$en" "$run" "${rc:-?}" "$cpu" >> "$TIMINGS" 2>/dev/null || true
}
_tm_run() {
  [ -n "$TIMINGS" ] || return 0
  _tm_wait pool end; _tm_wait excl end
  local wall=$(( $(date +%s) - RUN_T0 ))
  printf '#run\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$wall" "$JOBS" "$MACHINE_JOBS" "$EXCL_PHASE" \
    "$TM_POOL_WAIT" "$TM_EXCL_WAIT" "$TM_BUSY" "$(uptime | sed 's/.*load averages*: *//' | tr ' ' ',')" >> "$TIMINGS" 2>/dev/null || true
  printf 'runner: timings in %s — wall %ss, %s jobs, pool wait %ss, exclusive drain %ss, busy %ss\n' \
    "$TIMINGS" "$wall" "$JOBS" "$TM_POOL_WAIT" "$TM_EXCL_WAIT" "$TM_BUSY" >&2
}
WITNESS_PID=""
trap 'rm -f "$TALLY" "$TALLY.subject"; [ -z "$WITNESS_PID" ] || kill "$WITNESS_PID" 2>/dev/null || true; rm -rf "$JOBDIR"; _pool_release_all; _queue_release' EXIT

# ── THE PANE A FULL RUN IS STARTED FROM IS A WITNESS, NOT A TARGET ──────────
#
# MEASURED 2026-09-15: a single run of this suite wrote seven
# `pane.report_metadata` calls carrying fixture tokens onto the LIVE pane of the
# agent running it, and six more subjects read the live daemon. tests/_common.sh
# now sweeps every HERDR_* and points the socket at a path that does not exist,
# and tests/145 pins the write path — but _common.sh itself says the reads were
# a measurement, not a standing assertion, and the guard jobs never source it:
# they inherit this runner's environment as it is, and in an executor's pane
# that environment names the live socket.
#
# SO EVERY FULL RUN REPLACES THE PANE IT WAS STARTED FROM WITH A RECORDER. Every
# job — subject, guard, mutation arm — inherits HERDR_ENV=1, a pane id that names
# no pane, and HERDR_SOCKET_PATH pointing at a socket this runner listens on and
# answers nothing. A job that reaches it has reached the one address its
# environment gave it, which on a live pane is a live session; the run is RED
# and names what was sent. A job that dials the real socket by a path it built
# itself is not caught here — the subjects' HOME is their own (_common.sh), so a
# path built from HOME lands in the run's temp, and bin/ carries no machine
# literal (tests/173).
#
# FULL AND NOT NESTED: a nested runner is inside a subject that already swept
# this away, and the fast gate is pre-commit's, where seconds matter and whose
# subjects are the same files the full run witnesses.
if [ "$HW_TEST_GATE" = full ] && [ "$POOL_ON" = 1 ]; then
  WITNESS_SOCK="$JOBDIR/herdr-witness.sock"
  WITNESS_LOG="$JOBDIR/herdr-witness.log"
  : > "$WITNESS_LOG"
  # Started from JOBDIR, not the candidate: on Windows a process's working
  # directory cannot be deleted, and the snapshot's cleanup then died on
  # WinError 32 over hw-source-*/brain (windows.yml 37016917284, subject 251).
  # exec keeps $! the witness's own pid.
  ( cd "$JOBDIR" && exec python3 -c '
import os, sys, json
sys.path.insert(0, os.path.join(sys.argv[3], "tests"))
try:
    from _herdr_endpoint import listen   # a unix socket, or the named pipe on Windows
except ImportError:                      # a fixture tree that carries only this runner
    import socket
    def listen(p, n):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.bind(p); s.listen(n); return s
path, log = sys.argv[1], sys.argv[2]
s = listen(path, 64)
while True:
    c, _ = s.accept()
    c.settimeout(1.0)
    data = b""
    try:
        while len(data) < 65536:
            chunk = c.recv(4096)
            if not chunk:
                break
            data += chunk
            if b"\n" in chunk:
                break
    except Exception:
        pass
    with open(log, "a") as f:
        f.write(json.dumps(data.decode("utf-8", "replace")[:400]) + "\n")
    c.close()
' "$WITNESS_SOCK" "$WITNESS_LOG" "$HERE" < /dev/null > /dev/null 2>&1 ) &
  WITNESS_PID=$!
  _w=0
  while [ ! -e "$WITNESS_SOCK" ] && [ "$_w" -lt 50 ]; do sleep 0.1; _w=$((_w + 1)); done
  if [ -e "$WITNESS_SOCK" ]; then
    # MUTATION-ANCHOR: 176-M03
    export HERDR_ENV=1 HERDR_SOCKET_PATH="$WITNESS_SOCK" HERDR_PANE_ID="wWITNESS:pWITNESS" \
           HERDR_TAB_ID="wWITNESS:tWITNESS" HERDR_WORKSPACE_ID="wWITNESS"
    # MUTATION-ANCHOR-END: 176-M03
  else
    printf 'runner: the herdr witness did not start — this run does NOT check that no job reaches the pane it was started from\n' >&2
    kill "$WITNESS_PID" 2>/dev/null || true
    WITNESS_PID=""
  fi
fi

# ── THE ORDER THEY START IN IS NOT THE ORDER THEY PRINT IN ──────────────────
#
# LONGEST FIRST, or the run is as long as whatever happens to start last.
# `111-refuse-the-unwinnable-wait.sh` is 227s of the 1119s total; started late it
# is a tail nobody else is filling. The durations are the ones
# `setup/measure-tests.sh` already committed in setup/test-budgets.json for the
# fast gate, read here as a SCHEDULING HINT and nothing else. A stale, missing or
# unparseable hint costs wall clock and cannot change a verdict, because the
# print order below is the glob order either way — which is why every failure
# path here ends in the file order rather than in a refusal.
SCHED_ORDER=""
if [ "$JOBS" -gt 1 ]; then
  _i=0
  while [ "$_i" -lt "$JOB_TOTAL" ]; do
    printf '%s\t%s\t%s\n' "$_i" "$(basename "${JOB_PATH[$_i]}")" "${JOB_HINT[$_i]}"
    _i=$((_i + 1))
  done > "$JOBDIR/schedule.in"
  # THE JOB LIST ARRIVES AS A FILE, NOT ON STDIN. `python3 -` already reads its
  # program from stdin, and the heredoc IS that stdin — a pipe into it is
  # swallowed and `sys.stdin.read()` returns the empty string, which here would
  # silently mean "no schedule" and cost the whole point of this block.
  SCHED_ORDER="$(python3 - "$HERE/test-budgets.json" "$JOBDIR/schedule.in" <<'PY' || true
import json, pathlib, sys
try:
    budgets = json.loads(pathlib.Path(sys.argv[1]).read_text())["files"]
except Exception:
    budgets = {}
rows = []
for line in pathlib.Path(sys.argv[2]).read_text().splitlines():
    if not line:
        continue
    index, name, hint = line.split("\t")
    if hint:
        seconds = float(hint)
    else:
        try:
            seconds = float(budgets[name]["seconds"])
        except Exception:
            seconds = 0.0
    rows.append((-seconds, int(index)))
print(" ".join(str(index) for _, index in sorted(rows)))
PY
)"
fi
if [ -z "$SCHED_ORDER" ]; then
  _i=0
  while [ "$_i" -lt "$JOB_TOTAL" ]; do SCHED_ORDER="$SCHED_ORDER $_i"; _i=$((_i + 1)); done
fi

# _run_job <index> — runs one job into its own files and says so by writing
# <index>.status LAST. Nothing else writes that file: its appearance is the only
# completion signal the loop below has, and it is moved into place rather than
# written in place so a half-written status can never be read as a verdict.
#
# `set +e` FIRST. This body runs as a background subshell under the runner's
# `set -euo pipefail`, and a non-zero exit is the NORMAL case here — it is the
# thing being measured. Without this the subshell dies at the failing command,
# the status file is never written, and the loop below waits forever for a job
# that is already gone.
_run_job() {
  local idx="$1" f="${JOB_PATH[$1]}" kind="${JOB_KIND[$1]}"
  local rc=0 cov_rc=0 parse_rc=0 started ended wall_ms=0 cpu_ms=0 first_ms=0 rerun_rc=0 retried=0 first_rc=0
  set +e
  started=""; ended=""
  if [ "$kind" = subject ]; then
    # A SUBJECT THAT DOES NOT PARSE IS NOT A SUBJECT THAT PASSED, and until
    # 2026-09-11 this runner could not tell the difference. bash reads a script
    # INCREMENTALLY: it executes every complete command it has parsed so far, and
    # only reports the syntax error when it reaches the end. A file broken near
    # its end therefore prints its whole run of `ok -` lines, dies at EOF, and can
    # still exit 0 -- measured that day on 124, which went from 2.08s to 0.05s
    # with `exit=0` recorded in setup/test-budgets.json. The duration collapse was
    # the only signal and nothing read it.
    #
    # BEFORE, NOT AFTER. `bash -n` is the whole file's verdict in one pass and
    # costs milliseconds; running first and judging the exit code afterwards is
    # exactly the reckoning that failed.
    bash -n "$f" > "$JOBDIR/$idx.parse" 2>&1
    parse_rc=$?
    if [ "$parse_rc" -eq 0 ]; then
      # STDIN IS /dev/null, not the terminal. A background job that reads the
      # terminal in a shell with job control off hangs the whole run against a
      # prompt nobody can see; the subjects are non-interactive by contract, so
      # this only makes that contract enforceable.
      # THE CLOCK STARTS AND STOPS AROUND THE SUBJECT, AND NOTHING ELSE. The
      # fast gate refuses a subject that overran its OWN budget, so `bash -n`
      # before it and `mutation-coverage` after it belong outside the window:
      # neither is the subject's work, and charging them to it would refuse a
      # file for the runner's own overhead. The old sequential loop bracketed
      # exactly this, and the bracket is the assertion.
      started="$(date +%s)"
      fg_time_cmd "$JOBDIR/$idx.out" "$JOBDIR/$idx.err" fg_capped "$HERE/test-budgets.json" "$(basename "$f")" "$JOBDIR/$idx.timeout" bash "$f"
      rc=$?
      # A TIMING SUBJECT THAT FAILED IS RUN ONCE MORE (the subject by itself, not the suite), and only one that
      # declared it (_timing_of). The first run's output is kept aside, so the
      # tally counts the run that decided and the first failure can be named.
      if [ "$rc" -ne 0 ] && [ "$(_timing_of "$f")" = retry ]; then
        retried=1; first_rc="$rc"
        mv -f "$JOBDIR/$idx.out" "$JOBDIR/$idx.first.out"
        mv -f "$JOBDIR/$idx.err" "$JOBDIR/$idx.first.err"
        fg_time_cmd "$JOBDIR/$idx.out" "$JOBDIR/$idx.err" fg_capped "$HERE/test-budgets.json" "$(basename "$f")" "$JOBDIR/$idx.timeout" bash "$f"
        rc=$?
      fi
      ended="$(date +%s)"
      wall_ms="$FG_WALL_MS"; cpu_ms="$FG_CPU_MS"; first_ms="$wall_ms"; rerun_rc=0
      # THE FAST GATE'S RE-RUNS LIVE IN THE JOB, not in the loop that reads it: the
      # loop has already let the next subject start, and a re-run beside it would
      # time both against each other. The minimum of up to three runs is what
      # the loop judges (setup/fast-gate-budget.sh).
      if [ "$rc" -eq 0 ] && [ "${HW_TEST_GATE:-}" = fast ] && [ -n "${FAST_THRESHOLD_SECONDS:-}" ] && [ "$kind" = subject ]; then
        _b_ms="$(fg_budget_ms "$FAST_THRESHOLD_SECONDS" "$(printf '%s\n' "$_FG_OWN" | sed -n "s/^$(basename "$f")=//p")" "$FG_FACTOR")"
        _try=0
        while [ "$wall_ms" -gt "$_b_ms" ] && [ "$_try" -lt 2 ]; do
          _try=$((_try + 1))
          fg_time_cmd "$JOBDIR/$idx.rerun.out" "$JOBDIR/$idx.rerun.err" fg_capped "$HERE/test-budgets.json" "$(basename "$f")" "$JOBDIR/$idx.timeout" bash "$f" || { rerun_rc=$?; break; }
          [ "$FG_WALL_MS" -ge "$wall_ms" ] || wall_ms="$FG_WALL_MS"
          if [ "$cpu_ms" -le 0 ] || { [ "$FG_CPU_MS" -gt 0 ] && [ "$FG_CPU_MS" -lt "$cpu_ms" ]; }; then cpu_ms="$FG_CPU_MS"; fi
        done
      fi
      # A subject that declares no arm is silent here; only a broken promise
      # speaks. It reads what the subject PRINTED, which is why it comes after.
      if [ "$rc" -eq 0 ]; then
        "$COVERAGE" "$f" "$JOBDIR/$idx.out" > "$JOBDIR/$idx.cov" 2>&1
        cov_rc=$?
      fi
    fi
  else
    started="$(date +%s)"
    "${_JOB_RUNNER[@]}" "$f" > "$JOBDIR/$idx.out" 2> "$JOBDIR/$idx.err" < /dev/null
    rc=$?
    ended="$(date +%s)"
  fi
  # A subject that never ran because it did not parse timed nothing, and 0 is
  # the honest answer there rather than the duration of the parse check.
  if [ -z "$started" ] || [ -z "$ended" ]; then started=0; ended=0; fi
  printf 'parse_rc=%s\nrc=%s\ncov_rc=%s\nelapsed=%s\nwall_ms=%s\ncpu_ms=%s\nfirst_ms=%s\nrerun_rc=%s\nretried=%s\nfirst_rc=%s\nstarted_at=%s\nended_at=%s\n' \
    "$parse_rc" "$rc" "$cov_rc" "$((ended - started))" "$wall_ms" "$cpu_ms" "$first_ms" "$rerun_rc" "$retried" "$first_rc" "$started" "$ended" > "$JOBDIR/$idx.status.part"
  mv -f "$JOBDIR/$idx.status.part" "$JOBDIR/$idx.status"
}

# _kill_tree <pid> — a failing subject stops the run, and "stops" has to reach
# the other thirteen too. Killing the background subshell alone would orphan the
# `bash <subject>` underneath it, which would keep burning a machine whose whole
# problem was contention, for minutes after the run said it was over.
_kill_tree() {
  local pid="$1" child
  for child in $(pgrep -P "$pid" 2>/dev/null || true); do _kill_tree "$child"; done
  kill -TERM "$pid" 2>/dev/null || true
}

ACTIVE=""; RUNNING=0; ABORTED=0; NEXT_EMIT=0
# THE EXCLUSIVE JOBS ARE COUNTED, not searched for on every top-up: while any of
# them is still owed, NOTHING else may start, so this counter is the gate.
EXCLUSIVE_OWED=0
_i=0
while [ "$_i" -lt "$JOB_TOTAL" ]; do
  if [ "${JOB_LANE[$_i]}" = exclusive ]; then EXCLUSIVE_OWED=$((EXCLUSIVE_OWED + 1)); fi
  _i=$((_i + 1))
done
JOB_PID=(); JOB_LAUNCHED=()
_i=0; while [ "$_i" -lt "$JOB_TOTAL" ]; do JOB_PID+=("0"); JOB_LAUNCHED+=("0"); JOB_SLOT+=(""); _i=$((_i + 1)); done
# EVERY JOB THAT IS NOT EXCLUSIVE, still to be started. The exclusive ones wait
# for it to reach zero when they run LAST (below).
NONEXCL_LEFT=$((JOB_TOTAL - EXCLUSIVE_OWED))

# FIRST OR LAST, decided once, from what the machine is doing when this run
# starts. On an idle machine the subjects that run alone go FIRST, as they
# always have: nothing has to drain for them. On a machine where other suites
# are already mid-run, going first would stop every one of them from starting
# anything new until their longest job ended — the guard mutation arm is ~170s —
# so this run does its pooled work beside them and asks for the machine at its
# END instead, when they are likelier to be done.
EXCL_PHASE=first
if [ "$POOL_ON" = 1 ] && [ "$EXCLUSIVE_OWED" -gt 0 ]; then
  for _d in "$POOL_DIR"/slot.*; do
    [ -e "$_d" ] || continue
    if _pool_dir_alive "$_d"; then EXCL_PHASE=last; break; fi
  done
  if [ "$EXCL_PHASE" = last ]; then
    printf 'runner: other suites are mid-run on this machine, so this run'"'"'s %s timing subject(s) will run alone at its end, not its start\n' \
      "$EXCLUSIVE_OWED" >&2
  fi
fi

_launch_job() {
  local idx="$1"
  if [ "${JOB_KIND[$idx]}" = guard-node ]; then _JOB_RUNNER=(node); else _JOB_RUNNER=(bash); fi
  # The guard jobs run with the home the guard DECLARES, not this shell's.
  if [ "${JOB_LANE[$idx]}" = guards ]; then
    # AND WITH AN ARTIFACTS DIRECTORY OF THEIR OWN, never the caller's. The
    # guard jobs are not subjects, so nothing sweeps HW_* for them, and
    # mutate-deny-repo-writes.sh writes its mutants under $HW_ARTIFACTS when
    # it is set. Measured 2026-09-28: two suites started from one executor
    # shared that directory, and both died on `rm: .../mutants: Directory not
    # empty`. The lock kept two suites apart; the pool does not, so the
    # directory is this run's, per job.
    mkdir -p "$JOBDIR/artifacts.$idx"
    _JOB_RUNNER=(env HOME="$GUARD_HOME" HW_ARTIFACTS="$JOBDIR/artifacts.$idx" "${_JOB_RUNNER[@]}")
  fi
  [ -z "$TIMINGS" ] || JOB_LAUNCH_AT[$idx]="$(date +%s)"
  JOB_SLOT_SEEN[$idx]="${JOB_SLOT[$idx]:-}"
  _run_job "$idx" &
  JOB_PID[$idx]=$!
  JOB_LAUNCHED[$idx]=1
  if [ "${JOB_LANE[$idx]}" != exclusive ]; then NONEXCL_LEFT=$((NONEXCL_LEFT - 1)); fi
  ACTIVE="$ACTIVE $idx"
  RUNNING=$((RUNNING + 1))
}

# _try_launch <idx> — start a pooled job if this machine has a worker for it.
# 1 when it has none yet: the caller stops filling for this tick, and the next
# attempt waits POOL_BACKOFF ticks — each attempt reads the holders' pids, and
# a runner polling ten times a second would otherwise spend a process per slot
# per tick just asking.
_try_launch() {
  if [ "$POOL_ON" = 1 ]; then
    if [ "$POOL_BACKOFF" -gt 0 ]; then POOL_BACKOFF=$((POOL_BACKOFF - 1)); return 1; fi
    if ! _pool_take_slot "$1"; then POOL_BACKOFF=5; _tm_wait pool begin; return 1; fi
  fi
  _tm_wait pool end
  _launch_job "$1"
}

# _reap — true when at least one job finished since the last call. `wait` is
# per pid rather than `wait -n`, which bash 3.2 does not have and this file has
# to run under: the same bash every bin/ script runs under (tests/_common.sh).
_reap() {
  local idx rest="" any=1
  for idx in $ACTIVE; do
    if [ -f "$JOBDIR/$idx.status" ]; then
      wait "${JOB_PID[$idx]}" 2>/dev/null || true
      RUNNING=$((RUNNING - 1))
      if [ "${JOB_LANE[$idx]}" = exclusive ]; then
        EXCLUSIVE_OWED=$((EXCLUSIVE_OWED - 1))
        # The machine is handed back once this run's LAST timing subject is
        # done; between two of them it is kept, so they run back to back.
        if [ "$POOL_ON" = 1 ] && [ "$EXCLUSIVE_OWED" -eq 0 ]; then _pool_excl_release; fi
      fi
      if [ "$POOL_ON" = 1 ]; then _pool_release_slot "$idx"; fi
      any=0
    else
      rest="$rest $idx"
    fi
  done
  ACTIVE="$rest"
  return "$any"
}

# _top_up — fill every free slot, and give ONE of them to the job whose turn it
# is to print.
#
# LONGEST FIRST IS RIGHT FOR THE CLOCK AND WRONG FOR THE READER. Ordered purely
# by duration, `01-task-names-and-models.sh` (0.5s) is the LAST thing to start,
# so a reader watching a five-minute run sees nothing at all until the short
# subjects finally run in the last wave, and then the whole suite at once.
# NEXT_EMIT is the frontier the loop below is blocked on; launching it ahead of
# the schedule costs at most one slot out of fourteen and is what keeps the
# report moving while the long tail runs.
_top_up() {
  local idx
  [ "$ABORTED" -eq 0 ] || return 0
  # ALONE MEANS ALONE, and it means first. Anything still running would make the
  # exclusive job's own timing readings wrong, which is the only reason it is in
  # this lane; anything started after it would be measuring a machine it shares.
  if [ "$EXCLUSIVE_OWED" -gt 0 ] && { [ "$EXCL_PHASE" = first ] || [ "$NONEXCL_LEFT" -eq 0 ]; }; then
    if [ "$RUNNING" -eq 0 ]; then
      for idx in $SCHED_ORDER; do
        if [ "${JOB_LANE[$idx]}" = exclusive ] && [ "${JOB_LAUNCHED[$idx]}" = 0 ]; then
          # ALONE ON THE MACHINE, not just in this run: see the pool.
          if [ "$POOL_ON" = 1 ]; then
            if [ "$POOL_BACKOFF" -gt 0 ]; then POOL_BACKOFF=$((POOL_BACKOFF - 1)); break; fi
            if ! _pool_excl_step "$idx"; then POOL_BACKOFF=5; _tm_wait excl begin; break; fi  # MUTATION-ANCHOR: 176-M01
          fi
          _tm_wait excl end
          _launch_job "$idx"; break
        fi
      done
    fi
    return 0
  fi
  if [ "$RUNNING" -lt "$JOBS" ] && [ "${NEXT_EMIT:-0}" -lt "$JOB_TOTAL" ] \
     && [ "${JOB_LAUNCHED[${NEXT_EMIT:-0}]}" = 0 ]; then
    idx="${NEXT_EMIT:-0}"
    if [ "${JOB_LANE[$idx]}" != exclusive ]; then
      _try_launch "$idx" || return 0
    fi
  fi
  for idx in $SCHED_ORDER; do
    [ "$RUNNING" -lt "$JOBS" ] || break
    if [ "${JOB_LAUNCHED[$idx]}" = 0 ]; then
      if [ "${JOB_LANE[$idx]}" = exclusive ]; then continue; fi
      _try_launch "$idx" || break
    fi
  done
  return 0
}

_stop_everything() {
  local idx
  ABORTED=1
  for idx in $ACTIVE; do _kill_tree "${JOB_PID[$idx]}"; done
  for idx in $ACTIVE; do wait "${JOB_PID[$idx]}" 2>/dev/null || true; done
  ACTIVE=""
  _pool_release_all
}

# A KILLED RUNNER MUST KILL ITS RUN. A background job in a shell with job control
# off does not receive the terminal's interrupt, and a close verification that
# overruns is killed by signal — so without these the runner would die and leave
# its subjects running behind it, on a machine whose whole problem was contention.
trap '_stop_everything; exit 130' INT
trap '_stop_everything; exit 143' TERM

# _job_red <exit> <line> — a red job. Stops the run as it always has, or under
# keep-going records the line and returns 1 so the loop moves to the next job.
RETRIED_COUNT=0; RETRIED_LINES=""
KEEP_GOING=0
case "${HW_TEST_KEEP_GOING:-}" in 1|yes|true) KEEP_GOING=1 ;; esac
RED_LINES=""; RED_RC=0; RED_COUNT=0
_job_red() {
  if [ "$KEEP_GOING" != 1 ]; then _stop_everything; _tm_run; abort_marker; exit "$1"; fi
  RED_COUNT=$((RED_COUNT + 1))
  [ "$RED_RC" != 0 ] || RED_RC="$1"
  RED_LINES="$RED_LINES
  not ok - $2"
  return 1
}

_top_up
_i=0
NEXT_EMIT=0
while [ "$_i" -lt "$JOB_TOTAL" ]; do
  # WAIT FOR THE ONE WHOSE TURN IT IS TO PRINT, not for whichever finished
  # first. Everything else keeps running while this blocks; the only thing
  # serialised here is the reporting.
  # AND IT TOPS UP ON EVERY TICK, not only after a job ends: a job refused a
  # machine worker has nothing of its own to wait on, and the tick is what asks
  # again.
  while [ ! -f "$JOBDIR/$_i.status" ]; do
    if _reap; then _top_up; else _top_up; sleep 0.1; fi
  done
  _reap || true
  _top_up
  f="${JOB_PATH[$_i]}"
  parse_rc=0; rc=0; cov_rc=0; elapsed=0; wall_ms=0; cpu_ms=0; first_ms=0; rerun_rc=0; retried=0; first_rc=0; started_at=0; ended_at=0
  . "$JOBDIR/$_i.status"
  _tm_row "$_i"
  if [ "$parse_rc" -ne 0 ]; then
    printf '\nnot ok - suite: setup/tests/%s does not parse, so it was never run — its assertions are NOT evidence for anything:\n%s\n' \
      "$(basename "$f")" "$(cat "$JOBDIR/$_i.parse" 2>/dev/null)" >&2
    _job_red 1 "setup/tests/$(basename "$f") does not parse" || { _i=$((_i + 1)); NEXT_EMIT="$_i"; continue; }
  fi
  if [ "$retried" = 1 ]; then
    # THE FIRST FAILURE IS NAMED, not lost: its first `not ok` line, else its exit.
    _first_fail="$(grep -m1 '^not ok' "$JOBDIR/$_i.first.out" "$JOBDIR/$_i.first.err" 2>/dev/null | sed 's/^[^:]*:not ok - //; s/^not ok - //' || true)"
    [ -n "$_first_fail" ] || _first_fail="exit $first_rc"
    if [ "$rc" -eq 0 ]; then
      RETRIED_COUNT=$((RETRIED_COUNT + 1))
      RETRIED_LINES="$RETRIED_LINES
  RETRIED $(basename "$f"): $_first_fail"
      printf 'RETRIED %s: %s\n' "$(basename "$f")" "$_first_fail"
    else
      printf 'runner: %s failed its retry as well; first failure: %s\n' "$(basename "$f")" "$_first_fail" >&2
    fi
    rm -f "$JOBDIR/$_i.first.out" "$JOBDIR/$_i.first.err"
  fi
  cat "$JOBDIR/$_i.out"
  cat "$JOBDIR/$_i.out" >> "$TALLY"
  [ ! -s "$JOBDIR/$_i.err" ] || cat "$JOBDIR/$_i.err" >&2
  if [ "$rc" -ne 0 ]; then
    # A SUBJECT CUT BY ITS CEILING IS NAMED, with the time it had and the ceiling
    # (setup/fast-gate-budget.sh, "THE PER-TEST CEILING"). Nothing else is
    # killed: the other subjects ran on.
    if [ -s "$JOBDIR/$_i.timeout" ]; then
      read -r _to_el _to_cap < "$JOBDIR/$_i.timeout"
      printf '\nnot ok - runner: setup/tests/%s TIMED OUT after %ss, over its %ss ceiling (budget x HW_TEST_TIMEOUT_FACTOR=%s, floor HW_TEST_TIMEOUT_FLOOR=%s, spent in loaded seconds: up to HW_TEST_TIMEOUT_LOAD_MAX=%s times the wall on a busy machine) — its process group was killed, nothing else\n' \
        "$(basename "$f")" "$_to_el" "$_to_cap" "${HW_TEST_TIMEOUT_FACTOR:-5}" "${HW_TEST_TIMEOUT_FLOOR:-60}" "${HW_TEST_TIMEOUT_LOAD_MAX:-4}" >&2
    fi
    _stops="the run stops here"; [ "$KEEP_GOING" != 1 ] || _stops="continuing (--keep-going)"
    case "${JOB_KIND[$_i]}" in
      subject)
        printf '\nnot ok - suite: setup/tests/%s failed (exit %s) — %s\n' \
          "$(basename "$f")" "$rc" "$_stops" >&2 ;;
      guard-mutate)
        printf '\nnot ok - suite: setup/guards/%s failed (exit %s) — a surviving mutant means the read-only guard has a hole its own suite cannot see\n' \
          "$(basename "$f")" "$rc" >&2 ;;
      *)
        printf '\nnot ok - suite: setup/guards/%s failed (exit %s) — %s\n' \
          "$(basename "$f")" "$rc" "$_stops" >&2 ;;
    esac
    # Its `ok` lines are already in the tally, so they are counted here too, or
    # the tracked/untracked split below would not add up.
    [ "$KEEP_GOING" != 1 ] || count_into "$f" "$JOBDIR/$_i.out"
    _job_red "$rc" "$(basename "$f") failed (exit $rc)" || { _i=$((_i + 1)); NEXT_EMIT="$_i"; continue; }
  fi
  count_into "$f" "$JOBDIR/$_i.out"
  # THE FAST GATE'S OWN TIMING IS THE ENFORCEMENT, not the committed manifest.
  # A file that drifted slow since it was last measured — new fixtures, a
  # widened vector table, a machine having a bad day — is caught HERE, on the
  # run that is actually paying for it, rather than trusted from a JSON file
  # that can go stale the moment it is written. This is what makes "a file that
  # runs slow cannot quietly stay in the fast gate" true on every commit, not
  # just on whichever day someone remembers to re-measure. It is also the whole
  # reason the fast gate stays one at a time: this number has to be the
  # subject's own, not a reading of how busy the machine was around it.
  if [ "$HW_TEST_GATE" = fast ] && [ -n "$FAST_THRESHOLD_SECONDS" ] && [ "${JOB_KIND[$_i]}" = subject ]; then
    _fg_own="$(printf '%s\n' "$_FG_OWN" | sed -n "s/^$(basename "$f")=//p")"
    _fg_budget_ms="$(fg_budget_ms "$FAST_THRESHOLD_SECONDS" "$_fg_own" "$FG_FACTOR")"
    _fg_own_ms="$(fg_ms "$_fg_own")"
    _fg_wall="$wall_ms"; _fg_cpu="$cpu_ms"; _fg_first="$first_ms"
    if [ "$rerun_rc" -ne 0 ]; then
      printf '\nnot ok - runner: setup/tests/%s failed (exit %s) on a timing re-run after passing once — a subject that passes once and fails once is not in the fast gate; its output is %s.rerun.err in the run directory\n' \
        "$(basename "$f")" "$rerun_rc" "$_i" >&2
      { cat "$JOBDIR/$_i.rerun.out" "$JOBDIR/$_i.rerun.err" 2>/dev/null | tail -n 40; } >&2
      _job_red 1 "setup/tests/$(basename "$f") failed on a fast-gate timing re-run (exit $rerun_rc)" || { _i=$((_i + 1)); NEXT_EMIT="$_i"; continue; }
    fi
    read -r _fg_load _fg_ncpu <<< "$(fg_load_ncpu)"
    read -r _fg_res _fg_mode _fg_why <<< "$(fg_decide "$_fg_wall" "$_fg_cpu" "$_fg_budget_ms" "${_fg_load:-}" "${_fg_ncpu:-}")"
    _fg_ldesc="load1=$(( ${_fg_load:-0} / 100 )).$(printf '%02d' $(( ${_fg_load:-0} % 100 ))) on ${_fg_ncpu:-?} cpus"
    [ -z "${HW_TEST_LOAD1:-}" ] || _fg_ldesc="$_fg_ldesc [SIMULATED by HW_TEST_LOAD1/HW_TEST_NCPU]"
    if [ "$_fg_wall" -gt "$_fg_budget_ms" ] || [ "${_fg_first:-0}" -gt "$_fg_budget_ms" ]; then
      case "$_fg_res $_fg_mode" in
        "pass wall") printf 'runner: setup/tests/%s read %sms on the first run, over the %sms budget, and %sms at best on re-run — within budget (%s): the first reading was the machine\n' \
                       "$(basename "$f")" "${_fg_first:-$wall_ms}" "$_fg_budget_ms" "$_fg_wall" "$_fg_ldesc" >&2 ;;
        "pass cpu")  printf 'runner: setup/tests/%s BUDGET APPLIED TO CPU, NOT WALL: wall %sms (best of re-runs) is over the %sms budget but the machine is saturated (%s); CPU user+sys %sms is within twice that budget\n' \
                       "$(basename "$f")" "$_fg_wall" "$_fg_budget_ms" "$_fg_ldesc" "$_fg_cpu" >&2 ;;
      esac
    fi
    # BETWEEN 1.5x AND 2x ITS OWN NUMBER a subject that only passes because its
    # ceiling is relative (setup/fast-gate-budget.sh) is WARNED about, per subject.
    if [ "$_fg_res" = pass ] && fg_drift_warn "$_fg_wall" "$_fg_own_ms" "$FAST_THRESHOLD_SECONDS"; then
      printf 'runner: setup/tests/%s DRIFT WARNING (not a failure): %sms is %s%% of its own %sms in test-budgets.json, and it is only inside the gate because its ceiling is twice that number (%s) — re-measure it with setup/measure-tests.sh when the machine is quiet\n' \
        "$(basename "$f")" "$_fg_wall" "$(( _fg_wall * 100 / _fg_own_ms ))" "$_fg_own_ms" "$_fg_ldesc" >&2
    fi
    case "$_fg_res" in
      refuse)
        printf '\nnot ok - runner: setup/tests/%s took %sms (best of up to 3 runs, CPU %sms) in the fast gate, over the %sms budget in setup/test-budgets.json — judged on %s (%s; %s) — re-measure with setup/measure-tests.sh and, if it is really this slow, its classification belongs in the slow set\n' \
          "$(basename "$f")" "$_fg_wall" "$_fg_cpu" "$_fg_budget_ms" "$_fg_mode" "$_fg_why" "$_fg_ldesc" >&2
        _job_red 1 "setup/tests/$(basename "$f") over its fast-gate budget (${_fg_wall}ms > ${_fg_budget_ms}ms)" || { _i=$((_i + 1)); NEXT_EMIT="$_i"; continue; } ;;
    esac
  fi
  # THE BURN-DOWN LIST IS GONE, BECAUSE IT IS EMPTY. It was introduced on
  # 2026-09-01 naming the ten subjects that certified a mutant kill from a `*)`
  # catch-all: they were green while carrying the shape, so refusing them
  # immediately would have turned a known debt into a red suite nobody could act
  # on. They warned, by name, and the note said to delete the list once the last
  # name left it. All ten were made positive on 2026-09-02 — each arm now matches
  # text the MUTANT ITSELF produces, with a third branch naming the absence
  # VACUOUS — so exit 3 is unconditional again. Do not reintroduce the list to
  # get past a red run: the whole point of exit 3 is that the arm proves nothing,
  # and a warning nobody has to act on is how it stayed unproven for a day.
  if [ "$cov_rc" -ne 0 ]; then
    printf '\nnot ok - suite: setup/tests/%s failed mutation coverage (exit %s) — a mutant nothing runs, or one nothing can see fail, is not coverage: %s\n' \
      "$(basename "$f")" "$cov_rc" "$(cat "$JOBDIR/$_i.cov" 2>/dev/null || printf 'mutation-coverage printed no reason')" >&2
    _job_red 1 "setup/tests/$(basename "$f") failed mutation coverage (exit $cov_rc)" || { _i=$((_i + 1)); NEXT_EMIT="$_i"; continue; }
  fi
  rm -f "$JOBDIR/$_i.out" "$JOBDIR/$_i.err" "$JOBDIR/$_i.cov" "$JOBDIR/$_i.parse"
  _i=$((_i + 1))
  NEXT_EMIT="$_i"
done
rm -f "$TALLY.subject"
_tm_run

# THE WITNESS IS READ LAST, once every job is done: see above.
if [ -n "$WITNESS_PID" ]; then
  # A native Windows python is not reliably ended by msys kill: by its winpid too.
  case "${OSTYPE:-}" in msys*|cygwin*)
    [ -r "/proc/$WITNESS_PID/winpid" ] && taskkill //F //T //PID "$(cat "/proc/$WITNESS_PID/winpid")" >/dev/null 2>&1 || true ;;
  esac
  kill "$WITNESS_PID" 2>/dev/null || true
  wait "$WITNESS_PID" 2>/dev/null || true
  WITNESS_PID=""
  if [ -s "$WITNESS_LOG" ]; then
    printf '\nnot ok - runner: %s connection(s) reached the herdr WITNESS socket that stood where the live pane'"'"'s address was — some job addressed the pane it was started from, which on a live pane is a write onto somebody'"'"'s session. First request: %s\n' \
      "$(grep -c . "$WITNESS_LOG")" "$(head -1 "$WITNESS_LOG")" >&2
    [ "$KEEP_GOING" = 1 ] || { abort_marker; exit 1; }
    RED_COUNT=$((RED_COUNT + 1)); [ "$RED_RC" != 0 ] || RED_RC=1
    RED_LINES="$RED_LINES
  not ok - runner: a job reached the herdr witness socket"
  fi
fi

# EVERY RED OF A --keep-going RUN, together, and still no number. The exit is
# the first red job's, so a caller that tested `$? -ne 0` reads the same verdict
# a stopped run gave it.
if [ "$RED_COUNT" -gt 0 ]; then
  printf '\nnot ok - suite: %s red job(s) in this --keep-going run, in print order:%s\n' "$RED_COUNT" "$RED_LINES" >&2
  printf '\nKEEP-GOING RUN FAILED — %s red job(s):%s\n' "$RED_COUNT" "$RED_LINES"
  abort_marker; exit "$RED_RC"
fi

# THE SUM IS CHECKED AGAINST THE TALLY, because a split that does not add up is
# worse than no split: it would put a confident wrong number in the headline.
TOTAL_OK="$(grep -c '^ok - ' "$TALLY" || true)"
case "$TOTAL_OK" in ''|*[!0-9]*) TOTAL_OK=0 ;; esac
if [ "$((TRACKED_OK + UNTRACKED_OK + UNKNOWN_OK))" -ne "$TOTAL_OK" ]; then  # MUTATION-ANCHOR: 55-M04
  printf '\nnot ok - runner: the tracked/untracked split does not add up (%s + %s + %s != %s total ok). The headline below cannot be trusted; fix the attribution before quoting any number.\n' \
    "$TRACKED_OK" "$UNTRACKED_OK" "$UNKNOWN_OK" "$TOTAL_OK" >&2
  abort_marker; exit 1
fi

# THE QUALIFICATION TRAVELS ON THE SAME STREAM AS THE CLAIM. THAT IS THE RULE.
#
# Found 2026-09-02 by the opus reviewer, in the commit whose whole thesis is that
# a number must say what it measured. Outside a git work tree this printed
# `0 tests passed (TRACKED only …)` and `no untracked subjects ran, so this is
# the whole suite` on STDOUT, and put `neither number above is complete` on
# STDERR. So `./test-hw 2>/dev/null | tail` showed a confident, complete-sounding
# number — and it was not merely unqualified but FALSE: two subjects had run and
# passed, the count said 0, and "whole suite" was asserted while nothing had been
# classified at all.
#
# IT IS THE SAME DEFECT AS 04efe7c, this session's first commit: a caller pipes,
# the qualification goes to a stream it dropped, and what survives reads as
# authoritative. Twice in one day, in two different tools, the second time inside
# the fix for the first. That is not coincidence, it is the shape — a claim and
# its caveat written to two streams WILL be separated, because separating them is
# what pipelines are for.
#
# So the invariant is structural rather than remembered: every summary line goes
# to stdout, and where the claim cannot be made honestly there is NO NUMBER ON
# STDOUT TO QUOTE. Moving the caveat to stdout alone would not have been enough —
# `0 tests passed` had to stop being printed, because a reader who sees a number
# quotes the number and not the sentence under it.
# AND WHAT THE NUMBER STILL DOES NOT CLAIM, written down 2026-09-09 because a
# run of it was quoted as a guarantee it does not carry.
#
# The number counts `ok -` lines. An `ok -` line says a subject's own check
# concluded; it does not say the check exercised its subject. That gap is not
# theoretical: on 2026-09-09 a leaked `core.hooksPath` redirected the fixture
# hooks in tests/105 to a directory with no hook in it, and two `ok -` lines were
# counted for cases that certified a guard which had not executed. The suite said
# 2309 in the context it was measured in, and some of those assertions were
# vacuous in another. Nothing in this headline could have shown that.
#
# So the honest reading of the number is CONTEXT-SCOPED: "this many checks
# concluded, in the environment this run had". Non-vacuity is not the runner's to
# assert and cannot be — `setup/mutation-coverage` establishes it for declared
# mutation arms only, and every other assertion is as good as the subject that
# wrote it. The remedy is per subject and it is the shape tests/105 now uses:
# make the probe emit proof it ran, and fail when the proof is missing. Do not
# add a global claim here that this runner cannot support.
# A FLAKE THAT KEEPS BEING ABSORBED MUST STAY VISIBLE: the count is on stdout,
# beside the headline it qualifies, and silent when nothing was retried.
if [ "$RETRIED_COUNT" -gt 0 ]; then
  printf '\nRETRIED: %s timing subject(s) failed once and passed on their single retry:%s\n' "$RETRIED_COUNT" "$RETRIED_LINES"
fi
if [ -n "$UNKNOWN_NAMES" ]; then
  # NO HEADLINE AT ALL. "tracked" was never established here, so any integer
  # under that label is a count of nothing. The total IS printed, because it is
  # true and useful — but labelled as unclassified, which is not a release number
  # and does not read like one.
  printf '\nNO TRACKED NUMBER — tracking could not be established here (no usable git work tree), so nothing can be attributed to a commit.\n'  # MUTATION-ANCHOR: 55-M05
  printf '  %s ok ran in total; %s of it is UNCLASSIFIED and none of it is quotable as a release number:%s\n' \
    "$TOTAL_OK" "$UNKNOWN_OK" "$UNKNOWN_NAMES"
  if [ "$TRACKED_OK" != 0 ] || [ "$UNTRACKED_OK" != 0 ]; then
    # Belt and braces: `unknown` is all-or-nothing today because GIT_USABLE is
    # decided once per run. If that ever stops being true, the partial split is
    # stated rather than silently folded into the sentence above.
    printf '  (partial split, itself incomplete: %s tracked, %s untracked)\n' "$TRACKED_OK" "$UNTRACKED_OK"
  fi
  printf '  Run the suite inside the git work tree to get a number that means something.\n'
else
  if [ "$GATE_SELECTED" = 1 ]; then
    printf '\nFAST GATE (SELECTED): %s tests passed  (TRACKED only — %s of the %s fast subject files, chosen from the changed paths; the rest are deferred to the mandatory full run at pre-push, NOT skipped)\n' \
      "$TRACKED_OK" "${#FILES[@]}" "$FAST_TOTAL"
  elif [ "$HW_TEST_GATE" = fast ]; then
    printf '\nFAST GATE: %s tests passed  (TRACKED only — %s of %s subject files, %s of them slow subjects that name what this branch changed; the rest are deferred to the mandatory full run at pre-push, NOT skipped)\n' \
      "$TRACKED_OK" "${#FILES[@]}" "$(printf '%s\n' "$TESTS"/[0-9][0-9]*-*.sh | grep -c .)" "$TOUCHED_RUN"
  else
    printf '\n%s tests passed  (TRACKED only — the number this commit can reproduce)\n' "$TRACKED_OK"  # MUTATION-ANCHOR: 55-M01
  fi
  if [ -n "$UNTRACKED_NAMES" ]; then
    # MUTATION-ANCHOR: 55-M02
    printf '  + %s ok from UNTRACKED subjects, absent from the commit and NOT in the number above:%s\n' \
      "$UNTRACKED_OK" "$UNTRACKED_NAMES"
    # MUTATION-ANCHOR-END: 55-M02
    printf '  Quote the tracked number for a release; quote both, labelled, for a working tree.\n'
  elif [ "$HW_TEST_GATE" = fast ]; then
    printf '  no untracked subjects ran; this is the fast gate only, never the whole suite — see above\n'
  else
    # SAID EVEN WHEN THERE IS NOTHING TO SAY. The qualification vanishing when it
    # is not needed is how an unqualified number comes back.
    printf '  no untracked subjects ran, so this is the whole suite\n'
  fi
  if [ "$GATE_SELECTED" = 1 ]; then
    printf 'runner: no fast-gate verdict cached — a SELECTED run is not the whole fast gate\n' >&2
  elif [ "$HW_TEST_GATE" = fast ]; then
    _fast_verdict_write "FAST GATE: $TRACKED_OK tests passed"
  fi
fi
