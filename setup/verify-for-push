#!/usr/bin/env bash
# Runs the FULL suite against HEAD and, on green, caches the verdict keyed by
# HEAD's exact tree — the only thing `setup/hooks/pre-push` checks before
# letting a push through.
#
# WHY VERIFICATION LIVES HERE AND NOT INSIDE THE HOOK. Measured 2026-09-10,
# pushing for real: `git push backup` (a local remote) entered fine three
# times with the full suite running INSIDE pre-push, ~1120-1150s each. The
# same commit pushed to `github` (SSH) died every time with `Connection to
# github.com closed by remote host`, then `exit 141` (SIGPIPE) on retry. git's
# own protocol contacts the remote FIRST — it needs the ref list to hand the
# pre-push hook over stdin — and only transfers objects AFTER the hook
# returns. An SSH connection sitting idle for ~19 minutes while a hook runs is
# not something GitHub keeps open for you; the suite passing does not matter
# if the transport is already gone by the time it finishes. `git push
# --no-verify github main` entered in 3 seconds — the transport was never the
# problem.
#
# So the rule this script exists to satisfy: nothing that holds a remote
# socket open may take minutes. The hook must stay a fast, local file check;
# the ~1000s of real work happens HERE, run by a human or an executor before
# they push, never by git's own transport handshake.
#
# Run it yourself:
#     bash setup/verify-for-push
set -euo pipefail
ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# THE ONE WRITER OF A `gate=full` VERDICT. verify-for-push writes it after its
# own green run, and setup/release/cut writes it (`--write-verdict`, below) after
# the green full run IT paid for: the ~20 minutes of a cut are the same suite on
# the same bytes, and a push of that tree right after used to pay them again.
# Two writers would drift in fields or in atomicity, so there is this one.
#
# WRITE THEN RENAME, NOT A DIRECT >. `pre-push` reads this file for existence
# AND content (its own comment says why); a direct redirect truncates the
# target to zero bytes before writing a single line, so a reader racing the
# write could see a file that exists but is momentarily empty — passing the
# existence half of the check on content that was never actually verified.
# `mv` within the same directory is atomic on every filesystem this runs on.
# write_verdict <commit> <tree> <elapsed-seconds> <headline> [<base_tree> <jobs_rerun>]
# — the last two make it an incremental verdict, one hop off a recorded full run.
write_verdict() {
  local commit="$1" tree="$2" elapsed="$3" headline="$4" base_tree="${5:-}" jobs="${6:-}"
  local dir cache_file tmp_cache_file
  dir="$(git rev-parse --git-common-dir)/hw-push-verified"
  mkdir -p "$dir"
  cache_file="$dir/$tree"
  tmp_cache_file="$cache_file.tmp.$$"
  {
    echo "commit=$commit"
    echo "tree=$tree"
    echo "gate=full"
    echo "verified_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "elapsed_seconds=$elapsed"
    echo "headline=$headline"
    echo "host=$(hostname)"
    if [ -n "$base_tree" ]; then
      # A full verdict that names the full run it stands on, one hop away.
      # setup/release/cut accepts it only while `chain` still proves that.
      echo "incremental=1"
      echo "base_tree=$base_tree"
      echo "chain_depth=1"
      echo "jobs_rerun=$jobs"
    fi
  } > "$tmp_cache_file"
  mv -f "$tmp_cache_file" "$cache_file"
}

# --write-verdict <commit> <tree> <elapsed> <headline>: record a full verdict for
# a run somebody else already paid for, and run nothing. Used by setup/release/cut
# once its candidate gate has proved the checkout IS that tree and its full suite
# ended green with a TRACKED only count.
if [ "${1:-}" = "--write-verdict" ]; then
  [ $# -eq 5 ] || { echo "verify-for-push: --write-verdict takes <commit> <tree> <elapsed> <headline>" >&2; exit 2; }
  # the tree is a file name and the verdict's whole claim: 40 hex, and the tree OF that commit
  case "$2:$3" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]:[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
    *) echo "verify-for-push: --write-verdict wants 40-hex commit and tree ids" >&2; exit 2 ;;
  esac
  [ "$(git rev-parse --verify -q "$2^{tree}" 2>/dev/null)" = "$3" ] \
    || { echo "verify-for-push: --write-verdict: $3 is not the tree of commit $2" >&2; exit 2; }
  case "$4" in ''|*[!0-9]*) echo "verify-for-push: --write-verdict elapsed must be whole seconds" >&2; exit 2 ;; esac
  case "$5" in [0-9]*" tests passed  (TRACKED only"*) ;; *) echo "verify-for-push: --write-verdict refuses a headline that is not a TRACKED only count" >&2; exit 2 ;; esac
  write_verdict "$2" "$3" "$4" "$5"
  echo "verify-for-push: recorded a full verdict for tree $3 (no suite run here)." >&2
  exit 0
fi

# --full: run every job even when a recorded full run could answer for most of
# them (setup/verdict-incremental). The default asks it, and falls back to a
# full run by itself whenever it cannot vouch for the diff.
full_flag=""
for _a in "$@"; do
  case "$_a" in
    --full) full_flag="--full" ;;
    *) echo "verify-for-push: unknown argument $_a (the only one is --full)" >&2; exit 2 ;;
  esac
done
unset _a

# A DIRTY WORKING TREE CANNOT BE VERIFIED, on purpose. The cache is keyed by
# an exact tree — HEAD's — and that identity is only meaningful if the
# checkout actually IS that tree. Anything uncommitted in a TRACKED file
# means the bytes that just ran are not the bytes any commit will carry, so
# there is nothing honest to cache them against.
#
# UNTRACKED FILES ARE NOT PART OF THIS CHECK. `--untracked-files=no`, not a
# bare `git status --porcelain`. This repo is shared by several concurrent
# agents (setup/CLAUDE.md) and its working tree carries other agents'
# in-progress briefs and files at almost every moment — a bare
# `git status --porcelain` is realistically NEVER empty here, which would
# make this refuse always, not just when it should. Untracked content plays
# no part in `git rev-parse HEAD^{tree}` and none in what the suite is
# actually testing (the suite already has its own tracked/untracked
# accounting for exactly this kind of file — see setup/test-hw). What must
# be clean is TRACKED content: staged or unstaged changes to a file git
# already knows about, because those are what would make HEAD's tree not
# match what is actually on disk.
dirty="$(git status --porcelain --untracked-files=no)"
if [ -n "$dirty" ]; then
  # NOT EVERY DIRTY TRACKED FILE BLOCKS THIS. The same sharing that makes
  # `--untracked-files=no` necessary also dirties TRACKED files this suite
  # does not test: setup/decisions.md is tracked, and five lanes append to it
  # constantly. Measured 2026-09-10: this refused verify-for-push mid-task,
  # a step from the end, for a dirty decisions.md nobody's suite run reads.
  #
  # The cache is honest as long as everything that could make the suite
  # BEHAVE differently — everything matching SUITE_TRIGGER_PATTERN, the same
  # one file setup/hooks/pre-push and pre-commit both source — is exactly
  # HEAD's bytes. A dirty file OUTSIDE that pattern changes nothing the
  # suite reads, so a verdict cached against HEAD's tree stays honest
  # regardless of it. So the SCOPE of this check narrows to only those
  # paths; the check itself — dirty tracked content aborts a run — does not
  # go away.
  . "$ROOT/setup/hooks/suite-trigger-pattern.sh"
  [ -n "${SUITE_TRIGGER_PATTERN:-}" ] || {
    echo "verify-for-push: setup/hooks/suite-trigger-pattern.sh did not define SUITE_TRIGGER_PATTERN — refusing to guess what can invalidate the suite." >&2
    exit 1
  }
  # ANY GIT FAILURE HERE MEANS "TREAT AS DIRTY-AND-TRIGGERING" — same
  # fail-toward-refusing rule setup/hooks/pre-push uses for its own git
  # calls: a computation this script could not trust must never be read as
  # "nothing relevant changed".
  if ! dirty_paths="$(git diff --name-only HEAD 2>&1)"; then
    {
      echo "verify-for-push: could not compute which tracked paths are dirty — refusing rather than guessing."
      printf '%s\n' "$dirty_paths" | sed 's/^/    /'
    } >&2
    exit 1
  fi
  if printf '%s\n' "$dirty_paths" | grep -qE "$SUITE_TRIGGER_PATTERN"; then
    {
      echo "verify-for-push: the working tree has uncommitted changes to a path that can invalidate the suite (matches SUITE_TRIGGER_PATTERN), so there is no single commit whose tree this run would verify."
      echo "$dirty" | sed 's/^/    /'
      echo "Commit or stash first, then re-run this."
    } >&2
    exit 1
  fi
  echo "verify-for-push: the working tree has uncommitted tracked changes, but none of them match SUITE_TRIGGER_PATTERN (nothing here can invalidate the suite) — verifying HEAD's tree anyway." >&2
  echo "$dirty" | sed 's/^/    /' >&2
fi

commit="$(git rev-parse HEAD)"
tree="$(git rev-parse HEAD^{tree})"
cache_dir="$(git rev-parse --git-common-dir)/hw-push-verified"
mkdir -p "$cache_dir"
cache_file="$cache_dir/$tree"

# A TREE THAT ALREADY HAS ITS FULL VERDICT IS NOT MEASURED AGAIN. The verdict
# names the exact tree and its bytes are all the suite reads, so a second run
# could only agree; the one that wrote it may be the full run of this script or
# the green full run of a release cut (--write-verdict above). `--full` asks for
# the run anyway.
has_verdict=0
if [ -z "$full_flag" ] && grep -qxF "tree=$tree" "$cache_file" 2>/dev/null \
   && grep -qxF "gate=full" "$cache_file" 2>/dev/null \
   && grep -q '^headline=[0-9][0-9]* tests passed  (TRACKED only' "$cache_file" 2>/dev/null; then
  has_verdict=1
fi
if [ "$has_verdict" = 1 ]; then  # MUTATION-ANCHOR: 850-M02
  echo "verify-for-push: tree $tree already has a full verdict ($cache_file) — nothing to run; --full measures it again." >&2
  exit 0
fi

# AFTER A RED FULL RUN THE FIX COSTS MINUTES, NOT A SUITE (setup/verdict-incremental).
# The 0.3.7 train paid this script six times in ~5 hours, one whole suite per
# fix. A full run leaves a per-job record (below); the next run on a nearby
# tree reruns only the jobs red then plus the ones the diff can reach, and a
# green caches a full verdict that NAMES the run it stands on. Anything the
# planner cannot vouch for — the runner changed, too big a diff, no record, a
# gate-select `all` — is the full run of before, with the reason printed. A
# fixture tree with no planner is that too.
vi="$ROOT/setup/verdict-incremental"
only_file=""
base_tree=""
plan_why="no planner here"
if [ -f "$vi" ]; then
  only_file="$(mktemp "${TMPDIR:-/tmp}/verify-for-push-only.XXXXXX")"
  plan_rc=0
  plan_out="$(python3 "$vi" plan "$ROOT" $full_flag --tree "$tree" --out "$only_file" 2>&1)" || plan_rc=$?
  plan_head="${plan_out%%$'\n'*}"   # not `| head -1`: under pipefail a long plan SIGPIPEs the printf and set -e ends this script silently
  case "$plan_rc:$plan_head" in
    0:incremental\ *)
      base_tree="$(printf '%s' "$plan_head" | sed -n 's/.*base_tree=\([0-9a-f]*\).*/\1/p')"
      plan_why="$plan_head"
      echo "verify-for-push: INCREMENTAL — $plan_head" >&2
      printf '%s\n' "$plan_out" | sed -n 's/^run /    run /p' >&2 ;;
    0:full\ *)
      plan_why="${plan_head#full }"
      echo "verify-for-push: full run — ${plan_head#full }" >&2 ;;
    *)
      plan_why="the planner failed (exit $plan_rc): $plan_head"
      echo "verify-for-push: full run — $plan_why" >&2 ;;
  esac
  [ -n "$base_tree" ] || { rm -f "$only_file"; only_file=""; }
fi

if [ -n "$only_file" ]; then
  echo "verify-for-push: running the jobs a recorded full run cannot vouch for against $commit (tree $tree)." >&2
else
  echo "verify-for-push: running the full suite against $commit (tree $tree) — this is the ~1000s cost, run here, never inside pre-push." >&2
fi
started="$(date +%s)"
rc=0
# STREAMED, NOT CAPTURED THEN PRINTED. setup/test-hw waits for the machine's
# suite lock when another full run holds it, and says who holds it; captured
# with $( ), that notice sat invisible until the run ended — a silent wait of
# twenty minutes. `tee` shows it live and still keeps the bytes for the
# headline below; pipefail makes the status test-hw's, not tee's.
log="$(mktemp "${TMPDIR:-/tmp}/verify-for-push.XXXXXX")"
results="$(mktemp "${TMPDIR:-/tmp}/verify-for-push-results.XXXXXX")"
trap 'rm -f "$log" "$results" "$only_file"' EXIT
# HW_TEST_GATE IS PINNED, NOT INHERITED. An ambient `HW_TEST_GATE=fast` used to
# reach the runner from here, and its green was cached as a FULL verdict — the
# one thing main must never accept (2026-09-30, tests/250). The same goes for
# HW_TEST_ONLY and HW_TEST_RESULTS: an ambient list would narrow a run this
# script then caches as a whole one, so both are set here and nowhere else.
# AND IT KEEPS ITS OWN TIMINGS, one row per job (setup/test-hw, HW_TEST_TIMINGS):
# a slow verify is the one run whose shape nobody saw, and the file is what
# says whether the seconds went to subjects, to the machine's pool or to the
# drain before the subjects that run alone.
timings="${HW_TEST_TIMINGS:-${TMPDIR:-/tmp}/verify-for-push-timings.$tree.tsv}"
# AND IT KEEPS GOING PAST A RED (--keep-going, setup/test-hw): the run that
# stopped at its first red cost one ~13-minute run per red — 0.3.0-rc.1 needed
# three in a row, each showing one problem. Every job runs, every red is listed
# at the end, and the exit is still red, so nothing is cached below.
HW_TEST_ONLY="$only_file" HW_TEST_RESULTS="$results" HW_TEST_TIMINGS="$timings" HW_TEST_GATE=full bash setup/test-hw --keep-going 2>&1 | tee "$log" || rc=$?
out="$(cat "$log")"
elapsed=$(( $(date +%s) - started ))
# A FULL RUN LEAVES ITS PER-JOB RECORD WHETHER IT WAS GREEN OR RED: it is what
# the next, nearby tree starts from. An incremental run leaves none — a base is
# always a REAL full run, never a hop off another incremental one.
if [ -z "$only_file" ] && [ -f "$vi" ] && [ -s "$results" ]; then
  python3 "$vi" record "$ROOT" --results "$results" --rc "$rc" --elapsed "$elapsed" --tree "$tree" --commit "$commit" >&2 \
    || echo "verify-for-push: could not record this run's per-job results — the next run on a nearby tree will be a full one" >&2
fi
if [ "$rc" -ne 0 ]; then
  echo "verify-for-push: FAILED after ${elapsed}s — no verdict cached; setup/hooks/pre-push will refuse this tree." >&2
  exit 1
fi
if [ -n "$only_file" ]; then
  # The runner's own line says what it counted and that it is not the whole
  # suite; the verdict keeps that sentence, in the shape every reader of
  # `headline=` already parses, and names the run it stands on.
  _n="$(printf '%s\n' "$out" | sed -n 's/^INCREMENTAL: \([0-9][0-9]*\) tests passed.*/\1/p' | tail -1)"
  _jobs="$(grep -c . "$only_file" || true)"
  headline="${_n:-0} tests passed  (TRACKED only — INCREMENTAL: the $_jobs jobs a recorded full run (tree $base_tree) cannot vouch for; the rest are that run's)"
else
  headline="$(printf '%s\n' "$out" | grep -E '^[0-9]+ tests passed' | tail -1 || true)"
fi
write_verdict "$commit" "$tree" "$elapsed" "$headline" "$base_tree" "${_jobs:-}"
echo "verify-for-push: PASSED${only_file:+ (INCREMENTAL on $base_tree)} in ${elapsed}s — cached for tree $tree. setup/hooks/pre-push will now let this exact tree through instantly." >&2
